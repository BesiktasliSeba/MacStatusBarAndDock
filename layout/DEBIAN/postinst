#!/bin/sh
# MacStatusBar&Dock postinst: move the settings over from the old separate packages (once), keep a line switched off in iCleaner Pro off after an
# update, then (re)start the root helper. First of all, it decides whether this is a first install (the one-time welcome alert).
L=/var/jb/usr/bin/launchctl
H=/var/jb/usr/libexec/sshtoggled
if [ "$1" = "configure" ]; then
    # iPad only: on an iPhone (even one made to look like an iPad) nothing is changed and the helper is not started. The helper answers 0 on an
    # iPad and 2 on anything else; any other answer means it could not run (a crash, a failed start): that is no reason to skip the setup, so it
    # is said and the normal path goes on.
    if [ -x "$H" ]; then
        "$H" --is-ipad; rc=$?
        if [ "$rc" = 2 ]; then
            echo "MacStatusBar&Dock is made for iPad. It does nothing on this device; you can remove it."
            exit 0
        elif [ "$rc" != 0 ]; then
            echo "MacStatusBar&Dock: the iPad check could not run (code $rc); setting up as on an iPad." >&2
        fi
    fi
    # the old packages' helper, if its package did not stop it (it is the same program under its old name)
    OLD=/var/jb/Library/LaunchDaemons/com.kaan.sshtoggled.plist
    [ -f "$OLD" ] && $L unload "$OLD" 2>/dev/null
    $L remove com.kaan.sshtoggled 2>/dev/null
    [ -x "$H" ] && "$H" --welcome-check "$2"   # (first: before anything of ours is written; $2 = the version upgraded from, empty on a first install)
    [ -x "$H" ] && "$H" --defaults-check "$2"   # (new defaults for new installs only: decided now, before anything of ours is written ...)
    [ -x "$H" ] && "$H" --migrate
    [ -x "$H" ] && "$H" --freeze-defaults   # (... and an update keeps the old defaults of untouched settings, after the move from the old packages)
    [ -x "$H" ] && "$H" --after-install
    # iPadOS 17 and newer (untested): our own Settings rows may not find their place in Settings' main list there, so the Status Bar and Dock
    # pages are also listed the ordinary way, with the other tweaks (PreferenceLoader); the rows hide these entries when they do show. On 15/16
    # nothing is added (and any left from an earlier install on a newer iPadOS goes).
    PL=/var/jb/Library/PreferenceLoader/Preferences
    OSMAJ=$([ -x "$H" ] && "$H" --os-major 2>/dev/null)
    if [ -n "$OSMAJ" ] && [ "$OSMAJ" -ge 17 ] 2>/dev/null && [ -d "$PL" ]; then
        for e in "MacStatusBarPrefs MSBRootListController Status_Bar" "DockMagnificationPrefs DMRootListController Dock"; do
            bundle=${e%% *}; rest=${e#* }; detail=${rest%% *}; label=$(echo "${rest#* }" | tr '_' ' ')   # (named variables: the script's own $1 and $2 stay intact)
            cat > "$PL/MacStatusBarAndDock-$bundle.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict><key>entry</key><dict>
<key>bundle</key><string>$bundle</string><key>cell</key><string>PSLinkCell</string><key>detail</key><string>$detail</string>
<key>icon</key><string>icon.png</string><key>id</key><string>MSBD_PL_$bundle</string><key>isController</key><true/><key>label</key><string>$label</string>
</dict></dict></plist>
PLIST
            chmod 644 "$PL/MacStatusBarAndDock-$bundle.plist"
        done
    else
        rm -f "$PL/MacStatusBarAndDock-MacStatusBarPrefs.plist" "$PL/MacStatusBarAndDock-DockMagnificationPrefs.plist"
    fi
    $L unload /var/jb/Library/LaunchDaemons/com.besiktasliseba.sshtoggled.plist 2>/dev/null
    $L load /var/jb/Library/LaunchDaemons/com.besiktasliseba.sshtoggled.plist 2>/dev/null
    # the system pointer process keeps the Mac pointer code it loaded at start, and a respring does not restart it on iPadOS 16: it is stopped
    # here (launchd starts it again at once) so an install or update reaches the pointer without a reboot. A plain kill is ignored: -9.
    /var/jb/usr/bin/killall -9 pointeruid 2>/dev/null
    # the prewarm scheduler (dasd) likewise keeps whatever it loaded at start, and a respring does not restart it: it is stopped at the end of this
    # step when it does not have the prewarm block just installed, so the block loads (or updates) without a reboot. The part's own crash-loop
    # switch-off is cleared, so a dasd started again starts it fresh. launchd starts dasd again at once.
    rm -f /var/jb/var/mobile/Library/Preferences/MacStatusBarAndDock-PrewarmBlockOff.txt /var/jb/var/mobile/Library/Preferences/MacStatusBarAndDock-PrewarmBlockStarts.txt
    # the quit set's file for dasd (common/PrewarmQuitSet.h): SpringBoard writes it only once it starts with this version, which can be long after
    # this (a respring left for later), so on the first update to a version that has it, it starts as the set SpringBoard keeps -- cfprefsd's file
    # of it has the same contents (the set under quitSet), which dasd reads as well. Since 1.7.1 the file is also the block's switch, so it is made
    # only when SpringBoard keeps a set (the helper answers from Mac Status Bar's old on/off, Use Stock Status Bar and the version gate, as SpringBoard
    # decides at its start), and one there for a SpringBoard that keeps none goes now (1.7.0 left it with the old on/off switched off): the dasd
    # started below refused those apps until that SpringBoard's start removed it (code review, 30 Oct). A helper that cannot answer: as it is.
    QS=/var/jb/var/mobile/Library/Preferences/MacStatusBarAndDock-PrewarmQuitSet.plist; QP=/var/jb/var/mobile/Library/Preferences/com.besiktasliseba.macstatusbar.prewarm.plist
    kept=2; [ -x "$H" ] && { "$H" --quit-set-kept; kept=$?; }
    if [ "$kept" = 0 ]; then
        if [ ! -e "$QS" ] && [ -f "$QP" ]; then cp "$QP" "$QS" && chmod 644 "$QS"; chown 501:501 "$QS" 2>/dev/null; fi
    elif [ "$kept" = 1 ]; then rm -f "$QS"; fi
    # Only when it lacks the block just installed (common/PrewarmPartID.h, 1.7.2): the block in dasd writes a start stamp (dasd's pid and start
    # time, the block's build ID), and the helper answers 0 only when that stamp is the running dasd's and names the build ID of the part installed
    # now. A dasd started again works 10 to 26 minutes of CPU before it settles (M1, 1.7.1), and most updates do not change the block: a dasd
    # that has it keeps it, refusing the quit set's apps from its file without a gap. No stamp, another build or no answer: restarted as before.
    if [ -x "$H" ] && "$H" --dasd-part-current; then :; else /var/jb/usr/bin/killall -9 dasd 2>/dev/null; fi
elif [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-remove" ] || [ "$1" = "abort-deconfigure" ]; then
    # an upgrade or removal failed after the prerm stopped the helper (dpkg calls this on the version that stays): it is started again, so SSH
    # toggling, engine exclusivity and the switch-off watcher do not stay dead until the next reboot
    P=/var/jb/Library/LaunchDaemons/com.besiktasliseba.sshtoggled.plist
    [ -f "$P" ] && $L load "$P" 2>/dev/null
fi
exit 0
