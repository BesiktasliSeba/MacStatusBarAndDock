#!/bin/sh
# MacStatusBar&Dock postrm: after removal, the helper's markers go (the record of the one-time move from the old packages stays unless purged).
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    S=/var/jb/var/lib/sshtoggled-engines
    rm -f "$S/msb-off-restored" "$S/msb-off-alert" "$S/msb-config"
    rm -f /var/jb/var/mobile/Library/Preferences/MacStatusBarAndDock-CrashGuard.txt /var/jb/var/mobile/Library/Preferences/MacStatusBarAndDock-RecentlyOn.txt   # (crash guard)
    P=/var/jb/var/mobile/Library/Preferences
    rm -f "$P/MacStatusBarAndDock-CrashRecord.txt" "$P/MacStatusBarAndDock-CrashTweakName.txt" "$P/MacStatusBarAndDock-CrashVerdicts.txt" "$P/MacStatusBarAndDock-CrashStep.txt"   # (its record, the other-tweak note's name, the verdicts, step 1b's skip list)
    # what the helper and the Settings pages left behind (the prerm's --uninstall has already given everything back from them): the copy of Choicy's
    # settings from before our first change (only ever used to rebuild our change record: stale once we are gone), the helper's log, its SSH state
    # (also the old copy in mobile's folder), the landscape icon-layout cache. The helper's folder goes if nothing else is left in it (a "renamed"
    # record that could not be given back stays, so the next install can still give those engines back).
    rm -f "$P/MacStatusBar-ChoicyBackup.plist" /var/jb/var/log/sshtoggled-engines.log /var/jb/var/log/sshtoggled-engines.log.old
    rm -f "$S/ssh-state" "$S"/.ssh-state.* /var/jb/var/mobile/.sshtoggle-state
    rm -f "$S/eject-answer" "$S"/.eject-answer.* "$S/eject-dryrun"   # (a drive's eject for Finder: the last answer, and the debug test switch)
    rm -f "$S/tailspin.plist"   # (Keep Tailspin Off's state for Settings: the prerm's helper has taken our false out of com.apple.da)
    rm -f "$S/sleepguard.plist" /var/jb/var/log/msbd-sleepguard.log /var/jb/var/log/msbd-sleepguard.log.old   # (Sleep Guard's state and log: since 1.7.8 the folder stayed for them)
    rm -f /var/mobile/Library/Caches/com.besiktasliseba.macsettings.landscapeicons.plist
    rmdir "$S" 2>/dev/null
    [ "$1" = "purge" ] && rm -rf /var/jb/var/lib/macstatusbaranddock
    rm -f "$P/MacStatusBarAndDock-Diag-Hooks.txt" "$P/MacStatusBarAndDock-Diag-Dock.txt"   # (untested-iPadOS diagnostics, common/Diag.h)
    rm -f /var/mobile/Library/ControlCenter/MacStatusBarAndDock-ControlsIconState.plist /var/mobile/Library/ControlCenter/MacStatusBarAndDock-ControlsDesiredIconState.plist   # (18: the Mac panel's own layout of tiles, common/CC18MacLayout.h; iPadOS's own was never touched)
    rm -f "$P/MacStatusBarAndDock-CCTile.plist" "$P/MacStatusBarAndDock-CCTile-SSH.plist"   # (18: where RAM & CPU's and SSH's tiles were in Control Center, common/CCTileKeep.h -- a reinstall starts afresh; the prerm's helper took both controls out of the 15-17 lists)
    rm -f /var/jb/Library/PreferenceLoader/Preferences/MacStatusBarAndDock-MacStatusBarPrefs.plist /var/jb/Library/PreferenceLoader/Preferences/MacStatusBarAndDock-DockMagnificationPrefs.plist   # (the iPadOS 17+ entries, postinst)
    # the list of names our Spotlight sections read (statusbar/SpotlightBridge.h; normally gone a few seconds after Spotlight read it) and its folder
    rm -f /var/jb/var/mobile/Library/Caches/com.besiktasliseba.macstatusbar/Spotlight.plist
    rmdir /var/jb/var/mobile/Library/Caches/com.besiktasliseba.macstatusbar 2>/dev/null
    # the prewarm quit set (and the debug-only diagnostic domain), its file for dasd (common/PrewarmQuitSet.h), the prewarm block's crash-loop markers
    # (postinst), and the prewarm scheduler restarted so our code leaves it (see postinst). The two domains are cfprefsd's: the prerm's helper has
    # emptied them through it already (1.7.8, common/PrefsForget.h -- an rm alone left cfprefsd's copy for a reinstall to read back), which leaves at
    # most an empty file (iPadOS's cfprefsd writes one); their files are removed here, with nothing cached behind them.
    rm -f "$P/com.besiktasliseba.macstatusbar.prewarm.plist" "$P/com.besiktasliseba.macstatusbar.prewarm.diag.plist" "$P/MacStatusBarAndDock-PrewarmQuitSet.plist" "$P/MacStatusBarAndDock-PrewarmBlockOff.txt" "$P/MacStatusBarAndDock-PrewarmBlockStarts.txt"
    rm -f "$P/MacStatusBarAndDock-PrewarmBlockLoaded.txt" "$P/MacStatusBarAndDock-PrewarmBlockLoaded.txt.new"   # (the block's start stamp, common/PrewarmPartID.h)
    rm -f "$P/MacStatusBarAndDock-PrewarmBlockArmed.txt" "$P/MacStatusBarAndDock-PrewarmBlockArmed.txt.new" "$P/MacStatusBarAndDock-NoPrewarmBlock.txt"   # (whether it armed, common/PrewarmArmed.h; a debug build's test switch)
    # the system pointer process would keep running the removed Mac pointer code until a reboot: restarted (see the postinst)
    /var/jb/usr/bin/killall -9 pointeruid 2>/dev/null
    /var/jb/usr/bin/killall -9 dasd 2>/dev/null
fi
exit 0
