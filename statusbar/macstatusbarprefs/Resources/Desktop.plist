<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>A picture behind the first page of the Home Screen, where the desktop is. The other pages keep your iPadOS wallpaper.</string>
			<key>id</key>
			<string>DESKTOP_PICTURE_GROUP</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSLinkCell</string>
			<key>detail</key>
			<string>MSBWallpaperController</string>
			<key>id</key>
			<string>DESKTOP_PICTURE</string>
			<key>label</key>
			<string>Desktop Picture</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>footerText</key>
			<string>Desktop icons show the files and folders in On My iPad &gt; Desktop on the first page of the Home Screen. They are separate from your app icons, which stay as they are.</string>
			<key>id</key>
			<string>DESKTOP_GROUP</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.besiktasliseba.macstatusbar.finder.pref</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.besiktasliseba.macstatusbar</string>
			<key>id</key>
			<string>DESKTOP_ICONS</string>
			<key>key</key>
			<string>desktopIcons</string>
			<key>label</key>
			<string>Show Desktop Icons</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.besiktasliseba.macstatusbar.finder.pref</string>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<false/>
			<key>defaults</key>
			<string>com.besiktasliseba.macstatusbar</string>
			<key>id</key>
			<string>DESKTOP_HIDE_NAMES</string>
			<key>key</key>
			<string>desktopHideNames</string>
			<key>label</key>
			<string>Hide Desktop Icon Names</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>id</key>
			<string>DESKTOP_SIZE_GROUP</string>
			<key>label</key>
			<string>Icon Size</string>
			<key>footerText</key>
			<string>Changes the size of desktop icons only. App icons on the Home Screen are not affected.</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.besiktasliseba.macstatusbar.finder.pref</string>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>default</key>
			<real>64</real>
			<key>defaults</key>
			<string>com.besiktasliseba.macstatusbar</string>
			<key>id</key>
			<string>DESKTOP_ICON_SIZE</string>
			<key>key</key>
			<string>desktopIconSize</string>
			<key>max</key>
			<real>96</real>
			<key>min</key>
			<real>40</real>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>id</key>
			<string>DESKTOP_CORNER_GROUP</string>
			<key>label</key>
			<string>App Icon Corner Radius</string>
			<key>footerText</key>
			<string>Changes the corners of app icons on the desktop only. Folders, files and Home Screen icons are not affected. Until you move the slider, desktop app icons match your Home Screen app icons, icon theme included. Match Home Screen Icons brings that back.</string>
		</dict>
		<dict>
			<key>PostNotification</key>
			<string>com.besiktasliseba.macstatusbar.finder.pref</string>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>default</key>
			<real>0.225</real>
			<key>defaults</key>
			<string>com.besiktasliseba.macstatusbar</string>
			<key>id</key>
			<string>DESKTOP_APP_CORNER</string>
			<key>key</key>
			<string>desktopAppIconCorner</string>
			<key>max</key>
			<real>0.5</real>
			<key>min</key>
			<real>0</real>
		</dict>
		<dict>
			<key>action</key>
			<string>msb_matchHomeScreenCorners:</string>
