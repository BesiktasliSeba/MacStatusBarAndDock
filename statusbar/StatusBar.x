        // for the OTHER orientation than the live one, then calls the exact same check the 0.2 s ticker calls, to confirm it actually closes the menu. Only ever
        // touches its own tracking variable (gMenuRotatorBuiltForOrientation) and the same DMCloseOverlay() every normal close already uses.
        long live = DMRealInterfaceOrientation();
        long fake = (live == 3) ? 4 : 3;
