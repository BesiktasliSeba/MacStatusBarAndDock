#import <mach-o/loader.h>
// MacStatusBar -- STAGE 2: a static Apple logo at the far left of the
// status bar, with the time and date pushed right to make room.
//
// Findings from the probe (see probe-findings/): SpringBoard hosts the status bar
// in UIStatusBarWindow > UIStatusBar_Modern > _UIStatusBar > _UIStatusBarForegroundView.
// The foreground view holds plain UIView containers for the leading region (time
// and date _UIStatusBarStringViews) and the trailing region. Layout is Auto Layout
// (constraints, not frames), which writes centre/bounds but never `transform`, so
// shifting the leading container with a transform survives layout passes.

// The development aid that dismisses the lock screen after a respring (the iPad is left unlocked for automated testing) is NOT part of a normal build:
// it is only compiled in with -DDM_LOCK_BYPASS=1.
#ifndef DM_LOCK_BYPASS
#define DM_LOCK_BYPASS 0
#endif
