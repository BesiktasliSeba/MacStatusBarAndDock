    if (obs) return;
    obs = CFRunLoopObserverCreateWithHandler(kCFAllocatorDefault, kCFRunLoopBeforeWaiting | kCFRunLoopExit, true, 1999000, ^(CFRunLoopObserverRef o, CFRunLoopActivity a) {
        @try { DMZetsuPreCommitPass(@"before the run loop waits"); } @catch (NSException *e) { static int told = 0; if (told++ < 3) DMLog([NSString stringWithFormat:@"[zflex] pre-commit pass: exception %@", e.reason]); }
