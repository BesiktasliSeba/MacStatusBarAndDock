static int gDMTouchWatchArm = 5;   // (debug touchwatch: the next touch sequences traced -- the first ones after SpringBoard starts and after each unlock)
static NSString *gDMTouchWatchWhy = @"SpringBoard start";
static void DMWatchLock(void) {
    static BOOL wasLocked = NO, seenFirst = NO;
    id mgr = DMSBManager("SBLockScreenManager");
    SEL sel = NSSelectorFromString(@"isUILocked");
    if (![mgr respondsToSelector:sel]) return;
    BOOL locked = ((BOOL (*)(id, SEL))objc_msgSend)(mgr, sel);
    DMSkipLockAfterRespring(mgr, locked);
    {   // (the first minute after SpringBoard starts and 2-10 s after each unlock, every 2 s while unlocked)
        static CFTimeInterval firstSeen = 0, unlockedAt = 0, lastSettle = 0;
        CFTimeInterval now = CACurrentMediaTime();
        if (!firstSeen) firstSeen = now;
        if (locked) unlockedAt = 0; else if (!unlockedAt) unlockedAt = now;
        if (!locked && now - lastSettle > 2.0 && (now - firstSeen < 60.0 || (now - unlockedAt > 2.0 && now - unlockedAt < 10.0))) { lastSettle = now; DMSettleLockScreenClock(); }
    }
    {   // the Cover Sheet coming down or going up while unlocked: the status bars lay out again (only the Apple menu while it is down)
        static BOOL wasCover = NO;
        BOOL cover = DMCoverSheetShown();
        if (cover != wasCover) {
            wasCover = cover;
            if (cover) DMHideAppBarItemsNow(); else for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout]; });
        }
    }
    if (!seenFirst) { seenFirst = YES; wasLocked = locked; return; }
    if (locked == wasLocked) return;
    wasLocked = locked;
    DMLog([NSString stringWithFormat:@"[lock] screen %@", locked ? @"locked" : @"unlocked"]);
    if (!locked) { gDMTouchWatchArm = 3; gDMTouchWatchWhy = @"unlock"; }
    // every status bar copy lays out again: locked, only the Apple menu (no traffic lights, no menu titles); unlocked, everything back
    if (locked) DMHideAppBarItemsNow(); else for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];
    if (!locked) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout]; });
    if (gStockBar) return;   // (stock status bar: the engine's windows are its own business)
    if (!locked) { extern void DMZetsuAfterUnlock(void); dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMZetsuAfterUnlock(); }); }
    if (!locked) for (NSNumber *ms in @[@600, @1600]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms.intValue * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMWakeAllStages([NSString stringWithFormat:@"%d ms after unlock", ms.intValue]); });
}
static const void *kFitSizeKey = &kFitSizeKey;      // the content size the app was last laid out for
static const void *kFitPendingKey = &kFitPendingKey;
static void DMFitWindowContent(UIView *window, BOOL swapForLandscape);
static void DMSettleWindowContent(UIView *window);
static void DMShowMilkyWayVeil(UIView *window);
// Called from the window's layout: when the content area is a new size, make the app re-lay out for it (after a short pause, so a
// drag or an animation sends a handful of updates rather than one per frame).
static void DMFitIfNeeded(UIView *window) {
    if (!gFlexResize) return;
    UIView *main = nil; @try { main = [window valueForKey:@"mainView"]; } @catch (id e) {}
    if (![main isKindOfClass:[UIView class]]) return;
    // LIVE-CONFIRMED BUG (2026-09-23, seen on Settings under MilkyWay: over 1000 repeated [fit] sends across more than two
    // minutes, never settling): this used to estimate the content size as "the window's own bounds minus a hardcoded 24 pt
    // bar", while DMFitWindowContent (below) records and re-checks against mainView's ACTUAL bounds — DMKeepFit sets
    // mainView's height from the title bar's REAL measured height, which is not always exactly 24.0, so the two numbers
    // differed by a small, non-converging amount and the "did it change" check below never matched, re-triggering a scene
    // resize forever. Comparing the exact same value (mainView's own bounds) that gets stored as kFitSizeKey fixes it.
    // SECOND LIVE-CONFIRMED BUG, same session (seen with two windows tiled, e.g. Safari): even after the fix above, mainView's
    // own measured height itself was seen oscillating by a fraction of a point between successive layout passes (714.825 vs
    // exactly 715 — DMKeepFit's title bar height fallback flips depending on exactly when it is read relative to MilkyWay's own
    // layout), which an EXACT CGSizeEqualToSize comparison can never absorb: any repeatable sub-point jitter, from whatever
    // deeper cause, re-triggers this forever. Rounding to the nearest whole point before comparing (and before storing, in
    // DMFitWindowContent below) makes the gate robust to that jitter without weakening it against any real resize, which is
    // always many points, never a fraction of one.
    CGSize contentSize = CGSizeMake(round(main.bounds.size.width), round(main.bounds.size.height));
    if (contentSize.width < 80.0 || contentSize.height < 80.0) return;
    NSValue *last = objc_getAssociatedObject(window, kFitSizeKey);
    if (last && CGSizeEqualToSize(last.CGSizeValue, contentSize)) return;
    static int checks = 0;
    if (checks++ < 40 && DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[fitcheck] content %@ last %@ pending %d", NSStringFromCGSize(main.bounds.size), last ? NSStringFromCGSize(last.CGSizeValue) : @"-", [objc_getAssociatedObject(window, kFitPendingKey) boolValue]]);
    if ([objc_getAssociatedObject(window, kFitPendingKey) boolValue]) return;
    objc_setAssociatedObject(window, kFitPendingKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        objc_setAssociatedObject(window, kFitPendingKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!window.superview) return;
        DMFitWindowContent(window, YES);
        DMFitIfNeeded(window);   // it changed again meanwhile
    });
}
// MilkyWay's layout puts its own scale transform back on the picture; once an app is fitted, keep the picture at 1:1.
static void DMKeepFit(UIView *window) {
    if (!gFlexResize || !objc_getAssociatedObject(window, kFitSizeKey)) return;
    @try {
        UIView *main = [window valueForKey:@"mainView"], *content = [window valueForKey:@"contentView"];
        UIView *bar = [window valueForKey:@"titleBar"], *handle = [window valueForKey:@"sizeChanger"];
        if (![main isKindOfClass:[UIView class]] || ![content isKindOfClass:[UIView class]]) return;
        // MilkyWay only lays out its inner views for some window sizes (a short window left them at the old size): keep them in step.
        CGFloat barH = [bar isKindOfClass:[UIView class]] && bar.bounds.size.height > 4.0 ? bar.bounds.size.height : 24.0;
        CGRect size = window.bounds;
        CGRect wantMain = CGRectMake(0, barH, size.size.width, MAX(0.0, size.size.height - barH));
        if (!CGRectEqualToRect(main.frame, wantMain)) main.frame = wantMain;
        if ([bar isKindOfClass:[UIView class]] && (bar.frame.size.width != size.size.width || bar.frame.origin.y != 0)) bar.frame = CGRectMake(0, 0, size.size.width, barH);
        if ([handle isKindOfClass:[UIView class]] && handle.frame.origin.x != size.size.width - handle.frame.size.width) handle.frame = CGRectMake(size.size.width - handle.frame.size.width, 0, handle.frame.size.width, handle.frame.size.height);
        CGRect want = CGRectMake(0, 0, main.bounds.size.width, main.bounds.size.height);
        if (!CGAffineTransformIsIdentity(content.transform)) content.transform = CGAffineTransformIdentity;
        if (!CGRectEqualToRect(content.frame, want)) content.frame = want;
    } @catch (id e) {}
}
// A closed window (or an app leaving its window for full screen) must give the app back the whole screen: SpringBoard does not do that by
// itself after we resized the scene, so the app would stay at its last window size.
static void DMResetSceneFrame(UIView *window) {
    if (!gFlexResize || !objc_getAssociatedObject(window, kFitSizeKey)) return;
    @try {
        id scene = [window valueForKey:@"scene"];
        CGSize screen = [UIScreen mainScreen].bounds.size;
        CGRect full = CGRectMake(0, 0, MIN(screen.width, screen.height), MAX(screen.width, screen.height));   // the scene's own portrait coordinates
        NSString *windowedID = [(AXWindowView *)window bundleIdentifier];
        Class layerClass = objc_getClass("AXPassthroughWindow");
        BOOL toggled = windowedID.length && [layerClass respondsToSelector:NSSelectorFromString(@"removeWindowedId:")] && [layerClass respondsToSelector:NSSelectorFromString(@"addWindowedId:")];
        if (toggled) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"removeWindowedId:"), windowedID);
        BOOL ok = scene ? DMSetSceneFrame(scene, full) : NO;
        if (toggled) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"addWindowedId:"), windowedID);
        objc_setAssociatedObject(window, kFitSizeKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMLog([NSString stringWithFormat:@"[fit] %@ given the full screen back %@ (%@)", windowedID, NSStringFromCGRect(full), ok ? @"sent" : @"FAILED"]);
    } @catch (id e) {}
}
static void DMFitWindowContent(UIView *window, BOOL swapForLandscape) {
    @try {
        UIView *main = [window valueForKey:@"mainView"], *content = [window valueForKey:@"contentView"];
        id scene = [window valueForKey:@"scene"];
        if (![main isKindOfClass:[UIView class]] || ![content isKindOfClass:[UIView class]] || !scene) return;
        CGSize c = main.bounds.size;
        if (c.width < 80.0 || c.height < 80.0) return;
        NSNumber *orientation = [window valueForKey:@"contentViewOrientation"];
        BOOL landscape = orientation.integerValue == 3 || orientation.integerValue == 4;
        CGPoint origin = [main.superview convertPoint:main.frame.origin toView:nil];   // on-screen position of the content area
        CGRect sceneFrame = (landscape && swapForLandscape) ? CGRectMake(origin.x, origin.y, c.height, c.width) : CGRectMake(origin.x, origin.y, c.width, c.height);   // Aerial: (x, y, height, width) for landscape
        // MilkyWay treats scenes of "windowed" apps specially (its hook on updateSettings:withTransitionContext: is what keeps them at the
        // full-screen size). Take the app off its windowed list just for this update, so the change goes through like on a normal scene.
        NSString *windowedID = [(AXWindowView *)window bundleIdentifier];
        Class layerClass = objc_getClass("AXPassthroughWindow");
        BOOL toggled = windowedID.length && [layerClass respondsToSelector:NSSelectorFromString(@"removeWindowedId:")] && [layerClass respondsToSelector:NSSelectorFromString(@"addWindowedId:")];
        if (toggled) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"removeWindowedId:"), windowedID);
        BOOL ok = DMSetSceneFrame(scene, sceneFrame);
        if (toggled) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"addWindowedId:"), windowedID);
        content.transform = CGAffineTransformIdentity;
        content.frame = CGRectMake(0, 0, c.width, c.height);
        // Stored rounded (see DMFitIfNeeded's own matching rounding) so the "did it change" gate compares apples to apples
        // against a mainView bounds that can itself jitter by a sub-point fraction between layout passes.
        objc_setAssociatedObject(window, kFitSizeKey, [NSValue valueWithCGSize:CGSizeMake(round(c.width), round(c.height))], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMLog([NSString stringWithFormat:@"[fit] %@ content %@ scene frame %@ (orientation %@, swap %d) -> %@", [(AXWindowView *)window bundleIdentifier], NSStringFromCGSize(c), NSStringFromCGRect(sceneFrame), orientation, swapForLandscape, ok ? @"sent" : @"FAILED"]);
        DMSettleWindowContent(window);
    } @catch (id e) { DMLog(@"[fit] failed"); }
}
// Aerial's own cold-launch fix (DMRefitStageScene) found that some apps keep a slightly-too-small layout unless the scene
// is nudged with a genuinely DIFFERENT frame before the exact one lands — a repeat of the very same frame value can be a
// no-op for an app's own size-class machinery (this matters most for split-view apps like Settings, whose sidebar/detail
// collapse is driven by crossing a size-class boundary, not just "did the number change"). MilkyWay's bolt-on flex-resize
// never had this follow-up: a single commit was sent and whatever the app did with it was final. This sends the same
// target frame again, 1 pt narrower first and then exact 80 ms later, purely at the FBScene level (no view is touched,
// so there is no visible jump) — the same two-step shape as Aerial's fix, applied through this project's own already
// engine-neutral DMSetSceneFrame instead of an Aerial-only selector. A generation token cancels a stale nudge if the
// window is resized again before it fires, so a live drag never fights itself.
static const void *kSettleGenKey = &kSettleGenKey;
static void DMSettleWindowContent(UIView *window) {
    NSInteger gen = [objc_getAssociatedObject(window, kSettleGenKey) integerValue] + 1;
    objc_setAssociatedObject(window, kSettleGenKey, @(gen), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    __weak UIView *weakWindow = window;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *w = weakWindow;
        if (!w || !w.superview || [objc_getAssociatedObject(w, kSettleGenKey) integerValue] != gen) return;   // superseded by a newer resize
        @try {
            UIView *main = [w valueForKey:@"mainView"];
            id scene = [w valueForKey:@"scene"];
            if (![main isKindOfClass:[UIView class]] || !scene) return;
            CGSize c = main.bounds.size;
            if (c.width < 80.0 || c.height < 80.0) return;
            NSNumber *orientation = [w valueForKey:@"contentViewOrientation"];
            BOOL landscape = orientation.integerValue == 3 || orientation.integerValue == 4;
            CGPoint origin = [main.superview convertPoint:main.frame.origin toView:nil];
            CGRect near = landscape ? CGRectMake(origin.x, origin.y, c.height - 1.0, c.width) : CGRectMake(origin.x, origin.y, c.width - 1.0, c.height);
            CGRect exact = landscape ? CGRectMake(origin.x, origin.y, c.height, c.width) : CGRectMake(origin.x, origin.y, c.width, c.height);
            NSString *windowedID = [(AXWindowView *)w bundleIdentifier];
            Class layerClass = objc_getClass("AXPassthroughWindow");
            BOOL toggled = windowedID.length && [layerClass respondsToSelector:NSSelectorFromString(@"removeWindowedId:")] && [layerClass respondsToSelector:NSSelectorFromString(@"addWindowedId:")];
            if (toggled) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"removeWindowedId:"), windowedID);
            DMSetSceneFrame(scene, near);
            if (toggled) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"addWindowedId:"), windowedID);
            __weak UIView *weakWindow2 = w;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIView *w2 = weakWindow2;
                if (!w2 || !w2.superview || [objc_getAssociatedObject(w2, kSettleGenKey) integerValue] != gen) return;
                BOOL toggled2 = windowedID.length && [layerClass respondsToSelector:NSSelectorFromString(@"removeWindowedId:")] && [layerClass respondsToSelector:NSSelectorFromString(@"addWindowedId:")];
                if (toggled2) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"removeWindowedId:"), windowedID);
                DMSetSceneFrame(scene, exact);
                if (toggled2) ((void (*)(id, SEL, id))objc_msgSend)((id)layerClass, NSSelectorFromString(@"addWindowedId:"), windowedID);
                DMLog([NSString stringWithFormat:@"[fit] %@ settle nudge re-committed %@", windowedID, NSStringFromCGRect(exact)]);
            });
        } @catch (id e) {}
    });
}
// MilkyWay windows have no equivalent to Aerial's entrance veil (DMStyleStage / DMVeilCheck): a freshly created or
// freshly resized window shows whatever the app's content looks like mid re-layout — the picture has not caught up
// with the new frame yet — instead of a steady fill, which is the "temporary grey bars" seen applying a Window menu
// layout or drag-resizing. A plain system-background veil, a SIBLING of the content view placed above it (never
// underneath: MilkyWay re-hosts by adding new views on top of whatever is already there, same lesson Aerial's own
// veil learned), covers the content area until the app's scene has stopped sending updates for a moment, then fades —
// the same shape as Aerial's veil, driven by the same gSceneUpdateTime bookkeeping (already engine-neutral: every
// FBScene update is logged there regardless of which engine owns the scene).
static const void *kMWVeilViewKey = &kMWVeilViewKey;
// BUG FOUND LIVE (2026-09-23, animation-sweep testing): Window menu Fill on a window that was part of a tiled grid (a LARGE jump, e.g.
// grid-cell 592x340 growing to a fill of 1194x715, more than doubling each dimension) left a persistent grey gap for well over a second --
// not a brief flash, genuinely visible in a screenshot taken 1.2s after the log already said "layout done". Root-caused with a live view-
// tree dump (`wintree_AXPassthroughWindow`): the WINDOW's own frame and its `contentView` container resize immediately and correctly, but
// the actual rendering surfaces UIKit uses to host the app's scene content (`_UIContextLayerHostView`, found one level deeper) can stay
// pinned at the OLD size for well over a second on a big jump -- confirmed they DO eventually catch up on their own, just much slower than
// this check's old signal (no NEW scene-frame-push message for 0.12s) accounted for: the app can send one frame-update message and then
// spend a long time actually re-rendering at the new size without sending anything further, which this check misread as "settled".
// Fix: check the REAL content geometry directly instead of trusting message quietness as a proxy for it, with a longer (but still bounded,
// so a frozen veil is never left behind if a window genuinely never catches up) safety net now that there is a real positive signal to wait for.
static void DMCollectContextLayerHosts(UIView *v, NSMutableArray *out) {
    if ([NSStringFromClass([v class]) isEqualToString:@"_UIContextLayerHostView"]) { [out addObject:v]; return; }
    for (UIView *s in v.subviews) DMCollectContextLayerHosts(s, out);
}
static BOOL DMMilkyWayContentCaughtUp(UIView *window) {
    UIView *content = nil;
    @try { content = [window valueForKey:@"contentView"]; } @catch (id e) {}
    if (![content isKindOfClass:[UIView class]]) return YES;   // can't inspect it -- don't block fading on a check that can't run
    CGSize want = content.bounds.size;
    if (want.width < 1.0 || want.height < 1.0) return YES;
    NSMutableArray *hosts = [NSMutableArray array];
    DMCollectContextLayerHosts(content, hosts);
    if (!hosts.count) return YES;   // nothing found to compare -- same reasoning
    for (UIView *h in hosts) if (fabs(h.bounds.size.width - want.width) > 2.0 || fabs(h.bounds.size.height - want.height) > 2.0) return NO;
    return YES;
}
static void DMMilkyWayVeilCheck(UIView *window, UIView *veil, CFTimeInterval born) {
    if (!veil.superview) return;
    CFTimeInterval now = CACurrentMediaTime(), last = 0;
    NSString *bundleID = DMStageBundle(window);
    for (NSString *sid in gSceneUpdateTime) if (bundleID.length && [sid containsString:bundleID]) last = MAX(last, gSceneUpdateTime[sid].doubleValue);
    BOOL held = now - born >= 0.12;
    BOOL quiet = now - last >= 0.12;
    BOOL contentReady = DMMilkyWayContentCaughtUp(window);
    if ((held && quiet && contentReady) || now - born > 4.0) {   // never leave a frozen veil behind, whatever else goes wrong
        if (!contentReady && now - born > 4.0) DMLog([NSString stringWithFormat:@"[mw-veil] %@: content STILL not caught up after 4s -- fading anyway, this app may not resize like a normal window", bundleID]);
        DMLog([NSString stringWithFormat:@"[mw-veil] %@: fading (age %.2f s)", bundleID, now - born]);
        [UIView animateWithDuration:0.18 delay:0 options:UIViewAnimationOptionCurveEaseOut animations:^{ veil.alpha = 0.0; }
                         completion:^(BOOL finished) { [veil removeFromSuperview]; }];
        return;
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMMilkyWayVeilCheck(window, veil, born); });
}
static void DMShowMilkyWayVeil(UIView *window) {
    if (!gFlexResize) return;   // MilkyWay's own stock behaviour (scaling a full-screen picture) has no re-layout lag to hide
    UIView *existing = objc_getAssociatedObject(window, kMWVeilViewKey);
    if (existing.superview) return;   // already covered — let its own check keep running rather than stacking a second one
    UIView *main = nil, *content = nil;
    @try { main = [window valueForKey:@"mainView"]; content = [window valueForKey:@"contentView"]; } @catch (id e) {}
    if (![main isKindOfClass:[UIView class]] || main.bounds.size.width < 80.0 || main.bounds.size.height < 80.0) return;
    UIView *veil = [[UIView alloc] initWithFrame:main.bounds];
    veil.accessibilityIdentifier = @"MSBVeil-mw";
    veil.backgroundColor = [UIColor systemBackgroundColor];
    veil.userInteractionEnabled = NO;
    veil.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    if ([content isKindOfClass:[UIView class]]) [main insertSubview:veil aboveSubview:content]; else [main addSubview:veil];
    objc_setAssociatedObject(window, kMWVeilViewKey, veil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    DMMilkyWayVeilCheck(window, veil, CACurrentMediaTime());
    DMLog([NSString stringWithFormat:@"[mw-veil] %@: covering while it settles", DMStageBundle(window)]);
}

// ==== the Aerial window engine (Aerial 2.2.4; its stages are AerialStage views inside its AerialWindow) ====
static UIWindow *DMAerialWindow(void) {
    for (UIWindow *w in DMAllWindows())
        if ([NSStringFromClass([w class]) isEqualToString:@"AerialWindow"]) return w;
    return nil;
}
static void DMCollectStages(UIView *v, int depth, NSMutableArray *out) {
    if ([NSStringFromClass([v class]) isEqualToString:@"AerialStage"]) { [out addObject:v]; return; }
    if (depth < 4) for (UIView *s in v.subviews) DMCollectStages(s, depth + 1, out);
}
// back to front (the last one is topmost)
static NSArray<UIWindow *> *DMZetsuOrdered(void);
// ---- one snapshot of the windows and stages per tick (watcher plan step 5) ----
// Inside a tick scope (DMSnapBegin/End around the 0.2 s watcher and DMTick) SpringBoard's window list and our stage list are built once and shared.
// Only WHICH windows/stages exist and their order are cached; every property is still read live. Outside a scope everything behaves as before.
// The stage list checks itself on every use: the subview arrays of the stages' parents must be exactly as when it was built (a stage raised,
// added or removed -- by us or an engine -- rebuilds it); the window list is dropped by DMSnapInvalidate where our own code makes a window.
static int gDMSnapDepth = 0;
static NSArray<UIWindow *> *gDMSnapWindows = nil;
static NSArray<UIView *> *gDMSnapStages = nil;
static NSArray<NSArray *> *gDMSnapStageParents = nil;   // [parent, its subviews then]
static void DMSnapForgetSMFront(void);
static void DMSnapInvalidate(void) { gDMSnapWindows = nil; gDMSnapStages = nil; gDMSnapStageParents = nil; DMSnapForgetSMFront(); }
static void DMSnapBegin(void) { gDMSnapDepth++; }
static void DMSnapEnd(void) { if (--gDMSnapDepth <= 0) { gDMSnapDepth = 0; DMSnapInvalidate(); } }
static NSArray<UIWindow *> *DMAllWindows(void) {
    if (gDMSnapDepth && gDMSnapWindows) { gDMSnapWinHits++; return gDMSnapWindows; }
    gDMSnapWinMisses++;
    NSArray *w = [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:NO];
    if (gDMSnapDepth) gDMSnapWindows = w;
    return w;
}
static NSArray<UIView *> *DMSnapStagesIfValid(void) {
    if (!gDMSnapDepth || !gDMSnapStages) return nil;
    for (NSArray *pair in gDMSnapStageParents) {
        UIView *parent = pair[0];
        if (![parent.subviews isEqualToArray:pair[1]]) { gDMSnapStages = nil; gDMSnapStageParents = nil; return nil; }
    }
    return gDMSnapStages;
}
static void DMSnapStoreStages(NSArray<UIView *> *stages) {
    if (!gDMSnapDepth) return;
    NSMutableArray *parents = [NSMutableArray array]; NSMutableSet *seen = [NSMutableSet set];
    for (UIView *st in stages) {
        UIView *p = st.superview; if (!p) continue;
        NSValue *k = [NSValue valueWithNonretainedObject:p];
        if ([seen containsObject:k]) continue;
        [seen addObject:k]; [parents addObject:@[p, [p.subviews copy]]];
    }
    gDMSnapStages = [stages copy]; gDMSnapStageParents = parents;
}
static NSArray<UIView *> *DMAerialStages(void) {
    NSMutableArray *stages = [NSMutableArray array];
    if (DMActiveEngine() == DMEngineZetsu) return DMZetsuOrdered();   // Zetsu: every ZetsuWindow (each is a UIWindow of its own), back to front
    if (DMActiveEngine() == DMEngineNone) return stages;   // no engine of ours (e.g. an unsupported Aerial build): its windows are left entirely alone
    NSArray *cached = DMSnapStagesIfValid();
    if (cached) { gDMSnapHits++; return cached; }
    gDMSnapMisses++;
    if (DMActiveEngine() == DMEngineMilkyWay) {   // MilkyWay: its windows (back to front)
        Class windowClass = objc_getClass("AXWindowView");
        UIView *layer = DMMilkyWayLayer();
        for (UIView *v in layer.subviews) if (windowClass && [v isKindOfClass:windowClass]) [stages addObject:v];
        if (gDMSnapDepth && layer) { gDMSnapStages = [stages copy]; gDMSnapStageParents = @[@[layer, [layer.subviews copy]]]; }   // (validated by the layer's own list, also when empty)
        return stages;
    }
    UIWindow *w = DMAerialWindow();
    if (w) DMCollectStages(w, 0, stages);
    if (stages.count) { DMSnapStoreStages(stages); if (!gAerialSeenWindow) DMAerialMarkWorking(); }   // (an empty list is not cached; any window at all proves Aerial works)
    return stages;
}
// ---- no windows, no window work (2026-09-25) ----
// While no window exists -- windowing off, no engine of ours, or simply none open -- the watchers' window-only steps are skipped, so full-screen apps
// do not pay for them. YES while a window (any engine, minimized ones too) exists, and for 3 s after the last one went, so every step still sees the
// last window go (saved state, published sizes, focus listeners, background scenes). A new window is seen by the very next watcher tick, the same
// tick that would have handled it before. Asked once per 50 ms (both watchers share the answer).
static BOOL DMWindowWorkNeeded(void) {
    static CFTimeInterval checkedAt = -1, lastWindowAt = -100; static BOOL answer = YES;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - checkedAt < 0.05) return answer;
    checkedAt = now;
    if (DMActiveEngine() != DMEngineNone && DMAerialStages().count) lastWindowAt = now;
    answer = now - lastWindowAt < 3.0 || DMTestFlag("/tmp/msb-nowindowgate");   // (debug: the flag runs every step as before)
    return answer;
}
static id DMStageValue(UIView *stage, NSArray<NSString *> *keys) {
    for (NSString *k in keys) { @try { id v = [stage valueForKey:k]; if (v) return v; } @catch (id e) {} }
    return nil;
}
static NSString *DMStageBundle(UIView *stage) {
    Class windowClass = objc_getClass("AXWindowView");
    if (windowClass && [stage isKindOfClass:windowClass]) return [(AXWindowView *)stage bundleIdentifier];
    Class zetsuClass = objc_getClass("ZetsuWindow");
    if (zetsuClass && [stage isKindOfClass:zetsuClass]) return DMZetsuWindowBundle((UIWindow *)stage);
    // (perf step 6: a stage's app never changes, so the answer is kept on the stage; an empty answer is not kept, so a stage that is not
    // ready yet is asked again)
    static const void *kStageBundleCacheKey = &kStageBundleCacheKey;
    NSString *c = objc_getAssociatedObject(stage, kStageBundleCacheKey);
    if (c) return c;
    id v = DMStageValue(stage, @[@"bundleID", @"_bundleID", @"bundleIdentifier"]);
    NSString *b = [v isKindOfClass:[NSString class]] ? v : nil;
    if (b.length) objc_setAssociatedObject(stage, kStageBundleCacheKey, b, OBJC_ASSOCIATION_COPY_NONATOMIC);
    return b;
}
// A BOOL instance variable read directly (perf step 6: no KVC, no exception path), with the Ivar looked up once per class; NO if the class
// has no such BOOL ivar (then *found is NO and the caller falls back to KVC).
static BOOL DMBoolIvar(id obj, const char *name, BOOL *found) {
    static struct { Class cls; const char *name; Ivar iv; } memo[8]; static int used = 0;   // (name = a string literal: compared by pointer)
    if (found) *found = NO;
    if (!obj) return NO;
    Class cls = object_getClass(obj);
    Ivar iv = NULL; int i = 0;
    for (; i < used; i++) if (memo[i].cls == cls && memo[i].name == name) { iv = memo[i].iv; break; }
    if (i == used) {
        iv = class_getInstanceVariable(cls, name);
        const char *type = iv ? ivar_getTypeEncoding(iv) : NULL;
        if (!(type && (type[0] == 'c' || type[0] == 'B'))) iv = NULL;
        if (used < 8) { memo[used].cls = cls; memo[used].name = name; memo[used].iv = iv; used++; }
    }
    if (!iv) return NO;
    if (found) *found = YES;
    return *(BOOL *)((uint8_t *)(__bridge void *)obj + ivar_getOffset(iv)) != 0;
}

static BOOL DMStageMinimized(UIView *stage) {
    Class windowClass = objc_getClass("AXWindowView");
    if (windowClass && [stage isKindOfClass:windowClass]) return DMWindowMinimized(stage);
    Class zetsuClass = objc_getClass("ZetsuWindow");
    if (zetsuClass && [stage isKindOfClass:zetsuClass]) {   // ours (hidden like an Aerial stage), or Zetsu's own title-bar pill (_isReduction)
        BOOL found = NO, reduced = DMBoolIvar(stage, "_isReduction", &found);
        if (!found) @try { reduced = [[stage valueForKey:@"_isReduction"] boolValue]; } @catch (id e) {}
        return [objc_getAssociatedObject(stage, kStageHiddenKey) boolValue] || reduced;
    }
    if ([objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) return YES;
    BOOL found = NO, minimized = DMBoolIvar(stage, "_isMinimized", &found);
    return found ? minimized : [DMStageValue(stage, @[@"_isMinimized"]) boolValue];
}   // Aerial shows a minimized stage as an app-icon chip
static const void *kStageClosingKey;   // (defined below)
static UIView *DMTopStage(void) {   // the frontmost Aerial stage that is showing (not one that is on its way out to full screen)
    UIView *top = nil;
    for (UIView *s in DMAerialStages()) if (!s.hidden && s.alpha > 0.05 && !DMStageMinimized(s) && DMStageBundle(s).length && ![objc_getAssociatedObject(s, kStageClosingKey) boolValue]) top = s;
    return top;
}
static UIView *DMStageForBundle(NSString *bundleID) {
    for (UIView *s in DMAerialStages()) if ([DMStageBundle(s) isEqualToString:bundleID]) return s;
    return nil;
}
// Whether a window counts for Fit to Window: it is there and showing -- not minimized, hidden or on its way out.
// "No Fit" in the side question (the owner, 27 Sep): that window opens untiled in the middle and stays free -- Fit to Window leaves it out (later apps
// tile around the tiled ones and ask again), until it closes or Fit to Window is switched off and on.
static NSMutableSet<NSString *> *gFreeWindows;
static BOOL DMStageTakesPartInFit(UIView *s) {
    if (gFreeWindows.count) { NSString *b = s ? DMStageBundle(s) : nil; if (b.length && [gFreeWindows containsObject:b]) return NO; }
    return s && !s.hidden && !DMStageMinimized(s) && ![objc_getAssociatedObject(s, kStageClosingKey) boolValue];
}
static void DMMarkFreeWindow(NSString *bundleID);
// Moves an Aerial stage smoothly. Aerial itself re-lays the app out for the stage's new inner size as the layout changes.
BOOL gMoveKeepsOrderFlag(void);
static BOOL gMoveKeepsOrder = NO;   // moving windows around (a turn of the screen) must not reshuffle which one is in front
static void DMZetsuMove(UIWindow *w, CGRect target, BOOL animated, void (^done)(void));
// Aerial 5.0 remembers one frame per screen shape for every window (its ivars _landscapeFrame/_hasLandscapeState and _portraitFrame/_hasPortraitState)
// and, after a turn, keeps snapping the window back to it from a block it queues whenever the frame changes (live on iPad 2, iOS 16: after a turn to
// landscape the windows came back stacked in the middle, 335 x 620 at x 344 = Aerial's remembered frame, and every move of ours was undone ~25 ms later;
// with the remembered frame written first the same move stayed). So wherever we place a window, Aerial's memory for the current shape is set to the
// same frame. Plain ivar writes found by name with their type checked -- nothing of Aerial's is hooked or called.
static void DMAerial5SyncState(UIView *stage, CGRect frame) {
    if (gAerialFlavor != 5 || !stage || frame.size.width < 150.0 || frame.size.height < 150.0) return;
    CGSize sc = [UIScreen mainScreen].bounds.size;
    BOOL land = sc.width > sc.height;
    Class c = [stage class];
    Ivar fr = class_getInstanceVariable(c, land ? "_landscapeFrame" : "_portraitFrame");
    Ivar tr = class_getInstanceVariable(c, land ? "_landscapeTransform" : "_portraitTransform");
    Ivar has = class_getInstanceVariable(c, land ? "_hasLandscapeState" : "_hasPortraitState");
    if (!fr || !tr || !has) return;
    const char *tf = ivar_getTypeEncoding(fr), *tt = ivar_getTypeEncoding(tr), *th = ivar_getTypeEncoding(has);
    if (!tf || strncmp(tf, "{CGRect=", 8) || !tt || strncmp(tt, "{CGAffineTransform=", 19) || !th || (th[0] != 'B' && th[0] != 'c')) return;
    uint8_t *base = (uint8_t *)(__bridge void *)stage;
    CGRect *slot = (CGRect *)(base + ivar_getOffset(fr));
    CGAffineTransform *tslot = (CGAffineTransform *)(base + ivar_getOffset(tr));
    // The remembered state is a frame AND a transform, applied together (transform = identity, frame, then the transform). Setting only the
    // frame + "has state" left the never-saved transform at all zeros, and Aerial then shrank the window to nothing on the next turn (iPad 2 log:
    // transform a=b=c=d=0 set from Aerial right after the turn). So the transform is written too: identity, how our windows always stand.
    if (CGRectEqualToRect(*slot, frame) && CGAffineTransformIsIdentity(*tslot) && base[ivar_getOffset(has)]) return;
    *slot = frame;
    *tslot = CGAffineTransformIdentity;
    base[ivar_getOffset(has)] = 1;
}
// A stage whose transform has collapsed (a, b, c, d all ~0: drawn as nothing, and Aerial then sizes the app's scene to nothing) gets an identity
// transform back. Never seen after the fix above, kept as a guard; logged when it acts.
static void DMRepairCollapsedStage(UIView *stage) {
    CGAffineTransform t = stage.transform;
    if (fabs(t.a) > 0.001 || fabs(t.b) > 0.001 || fabs(t.c) > 0.001 || fabs(t.d) > 0.001) return;
    if (stage.hidden || [objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) return;
    for (NSString *busy in @[@"_isMinimized", @"_isClosing", @"_isRemovingStage"]) {   // Aerial's own minimize / close animations: not ours to touch
        Ivar iv = class_getInstanceVariable([stage class], busy.UTF8String);
        const char *t = iv ? ivar_getTypeEncoding(iv) : NULL;
        if (t && (t[0] == 'B' || t[0] == 'c') && *((uint8_t *)(__bridge void *)stage + ivar_getOffset(iv))) return;
    }
    stage.transform = CGAffineTransformIdentity;
    DMLog([NSString stringWithFormat:@"[aerial5] %@: its transform had collapsed to zero -- set back to identity (frame now %@)", DMStageBundle(stage), NSStringFromCGRect(stage.frame)]);
}
// Puts a window at a frame whatever transform it has right now. Setting .frame on a view with a transform makes its size frame / scale: Aerial 5.0
// opens a window from a Dock icon at ~0.3x and zooms it up, and a frame set then gave it a ~3.3x size (2026-09-26, M1: Twitter came up tiny
// and distorted, told a 3139 x 2207 size). Size and centre do not depend on the transform.
// Only while that opening zoom runs, though (a window first seen under 2 s ago and still zooming): a window that keeps a scale once settled gets the
// frame's size on screen, its bounds divided by the scale (iPad 2, 27 Sep: YouTube's window was left at 0.85 and every Fill / Fit / tile then came
// out at 85% of its place, and was remembered that way).
static BOOL DMStageStillZooming(UIView *stage);
static const void *kA5BornKey;   // (defined below)
static void DMSetStageFrameSafe(UIView *stage, CGRect f) {
    CGAffineTransform t = stage.transform;
    if (CGAffineTransformIsIdentity(t)) { stage.frame = f; return; }
    CGFloat sx = hypot(t.a, t.b), sy = hypot(t.c, t.d);
    NSNumber *born = objc_getAssociatedObject(stage, kA5BornKey);
    BOOL opening = born && CACurrentMediaTime() - born.doubleValue < 2.0 && DMStageStillZooming(stage);
    CGSize size = f.size;
    if (!opening && sx > 0.01 && sy > 0.01) size = CGSizeMake(f.size.width / sx, f.size.height / sy);
    stage.bounds = CGRectMake(stage.bounds.origin.x, stage.bounds.origin.y, size.width, size.height);
    stage.center = CGPointMake(CGRectGetMidX(f), CGRectGetMidY(f));
}
static const void *kA5EntranceTargetKey, *kA5EntranceUntilKey;   // (defined with DMA5HoldEntranceFrame)
static void DMA5HoldStageAt(UIView *stage, CGRect target, CFTimeInterval until);   // (defined with DMA5HoldEntranceFrame)
// Aerial 5.0 (iPad 2, iOS 16, landscape orientation 4 -- also 1.0.7, not orientation 3 or portrait): after EVERY change of a window's frame it puts
// back its remembered frame for the orientation (_landscapeFrame), fitted into the screen inset by 20 pt (shrunk to scale, centred on the screen:
// Fill 1036 x 645 became 984 x 613). A hold then fought it on every frame (129 put-backs and 317 scene updates in 2 s, logic test 1.0.8) and lost
// when it ended. Once that is seen in an orientation (DMA5HoldEntranceFrame), our frames there stay inside what Aerial keeps.
static uint8_t gA5FitsInOrientation = 0;   // bit o: Aerial fits every window into the screen inset by 20 pt in interface orientation o
static BOOL DMA5AerialFitsHere(void) { long o = DMRealInterfaceOrientation(); return o >= 1 && o <= 4 && (gA5FitsInOrientation & (1 << o)); }
static BOOL DMA5RectsClose(CGRect a, CGRect b) { return fabs(a.origin.x - b.origin.x) < 1.0 && fabs(a.origin.y - b.origin.y) < 1.0 && fabs(a.size.width - b.size.width) < 1.0 && fabs(a.size.height - b.size.height) < 1.0; }
static CGRect DMA5AerialFit(CGRect f) {   // what Aerial makes of a frame then: too big for the screen inset by 20 -> shrunk to scale, centred on the screen
    CGSize sc = [UIScreen mainScreen].bounds.size;
    CGFloat W = sc.width - 40.0, H = sc.height - 40.0;
    if (f.size.width <= W + 0.5 && f.size.height <= H + 0.5) return f;
    CGFloat k = MIN(W / f.size.width, H / f.size.height);
    return CGRectMake((sc.width - f.size.width * k) / 2.0, (sc.height - f.size.height * k) / 2.0, f.size.width * k, f.size.height * k);
}
static CGRect DMA5KeepableFrame(CGRect f) {   // in such an orientation: the frame no bigger than the screen inset by 20, the rest of the place kept
    if (gAerialFlavor != 5 || !DMA5AerialFitsHere() || CGRectIsNull(f)) return f;
    CGSize sc = [UIScreen mainScreen].bounds.size;
    CGFloat W = sc.width - 40.0, H = sc.height - 40.0;
    if (f.size.width > W) { f.origin.x = MIN(MAX(20.0, CGRectGetMidX(f) - W / 2.0), sc.width - 20.0 - W); f.size.width = W; }
    if (f.size.height > H) { f.origin.y = MIN(MAX(20.0, f.origin.y), sc.height - 20.0 - H); f.size.height = H; }
    return f;
}
static void DMAerialMoveStage(UIView *stage, CGRect target, void (^done)(void)) {
    // A window opened in the last 2 s that we place (the cascade's default place, its Fit to Window tile, the tile it rejoins): Aerial 5.0 applies
    // its own remembered frame for the app ~0.1 s after the window appears (seen: Notes put back to {0, 23, 391, 926.6}, its size from an earlier
    // session, right after it was tiled), which the cascade's check only undid ~2 s later with a visible second move. Held like the entrance: put
    // back before it is drawn. Any other move of ours ends a hold.
    if (gAerialFlavor == 5) target = DMA5KeepableFrame(target);   // (see DMA5AerialFitsHere: what Aerial would not keep there is not asked for)
    NSNumber *born = objc_getAssociatedObject(stage, kA5BornKey);
    CFTimeInterval now = CACurrentMediaTime();
    if (gAerialFlavor == 5 && born && now - born.doubleValue < 2.0 && !DMTestFlag("/tmp/msb-a5-nohold")) DMA5HoldStageAt(stage, target, MAX(born.doubleValue + 2.0, now + 0.6));
    else if (objc_getAssociatedObject(stage, kA5EntranceTargetKey)) {
        DMLog([NSString stringWithFormat:@"[aerial5] %@: placement hold ends (a move of ours to %@)", DMStageBundle(stage), NSStringFromCGRect(target)]);
        objc_setAssociatedObject(stage, kA5EntranceTargetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    DMAerial5SyncState(stage, target);   // before moving: Aerial would otherwise pull it back to its own remembered frame
    Class zetsuClass = objc_getClass("ZetsuWindow");
    if (zetsuClass && [stage isKindOfClass:zetsuClass]) { DMZetsuMove((UIWindow *)stage, target, YES, done); return; }
    if (DMActiveEngine() == DMEngineMilkyWay) {   // a MilkyWay window: its frame is animated, MilkyWay lays the app out for the new size
        if (!gMoveKeepsOrder) [stage.superview bringSubviewToFront:stage];
        DMShowMilkyWayVeil(stage);   // the content re-layout that follows lags the frame change — hide the gap instead of showing it as a grey bar
        MSBAnimate(0.36, 0, 1.0, UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction, ^{
            DMSetStageFrameSafe(stage, target);
            [stage layoutIfNeeded];
        }, ^(BOOL finished) { DMRememberStageFrame(stage); if (done) done(); });
        return;
    }
    SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded"), scale = DMAerialSel(@"adjustContentScaleToHost");
    if (!gMoveKeepsOrder && [stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front);
    MSBAnimate(0.36, 0, 1.0, UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction, ^{
        DMSetStageFrameSafe(stage, target);
        [stage layoutIfNeeded];
        if ([stage respondsToSelector:scale]) ((void (*)(id, SEL))objc_msgSend)(stage, scale);
    }, ^(BOOL finished) { DMRememberStageFrame(stage); if (done) done(); });
}
BOOL gMoveKeepsOrderFlag(void) { return gMoveKeepsOrder; }
void DMSetMoveKeepsOrder(BOOL keep) { gMoveKeepsOrder = keep; }
// A tap or click anywhere on a window brings it to the front (so it becomes the active app); MilkyWay does not always reorder.
@interface DMWindowFocus : NSObject <UIGestureRecognizerDelegate>
+ (instancetype)shared;
- (void)touched:(UILongPressGestureRecognizer *)g;
@end
@implementation DMWindowFocus
+ (instancetype)shared { static DMWindowFocus *f; static dispatch_once_t once; dispatch_once(&once, ^{ f = [DMWindowFocus new]; }); return f; }
- (void)touched:(UILongPressGestureRecognizer *)g {
    if (g.state != UIGestureRecognizerStateBegan) return;
    UIView *window = g.view;
    if (window.superview.subviews.lastObject != window) {
        [window.superview bringSubviewToFront:window];
        DMLog([NSString stringWithFormat:@"[window] %@ brought to the front", [(AXWindowView *)window bundleIdentifier]]);
    }
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b { return YES; }
@end
static const void *kFocusGestureKey = &kFocusGestureKey;
static void DMAttachWindowFocus(UIView *window) {
    if (objc_getAssociatedObject(window, kFocusGestureKey)) return;
    UILongPressGestureRecognizer *g = [[UILongPressGestureRecognizer alloc] initWithTarget:[DMWindowFocus shared] action:@selector(touched:)];
    g.minimumPressDuration = 0.0;
    g.allowableMovement = CGFLOAT_MAX;
    g.cancelsTouchesInView = NO;
    g.delaysTouchesBegan = NO;
    g.delaysTouchesEnded = NO;
    g.delegate = [DMWindowFocus shared];
    [window addGestureRecognizer:g];
    objc_setAssociatedObject(window, kFocusGestureKey, g, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

// ---- Window menu: sizes and places of the active app's window --------------------------------------------------------
// The area windows may use: below the status bar, above the Dock, with a small margin.
// ---- Aerial 5.0 in the Aerial 3.0 look: where the window really is --------------------------------------------------------------------------
// Aerial 5.0 lays the app out inside its stage with fixed margins of its own (measured live on the iPad 2: 6 pt left/right, a 13 pt strip on top,
// 20 pt below for its bottom handle) and puts it back there on every layout pass, so the app cannot be moved inside the stage (writing the holder's
// frame is undone at once and re-sends the app a scene size). Instead the WINDOW that is drawn (our chrome: the 24 pt title bar right above the app,
// the app edge to edge below it, 12 pt corners, the hairline) is the app's rect grown by the title bar, exactly Aerial 3.0's shape; the rest of the
// stage (the side and bottom margins) stays invisible. Every place a window is put (layouts, tiles, the centre, full screen) therefore asks for the
// WINDOW rect and turns it into the stage frame that gives it: stage = window grown by the margins and moved down by (24 - top strip).
static UIEdgeInsets gA5Insets = {13.0, 6.0, 20.0, 6.0};   // top, left, bottom, right: the app's holder inside an Aerial 5.0 stage (re-measured live)
static BOOL gA5ThemeOff = NO;   // debug: /tmp/msb-a5-notheme (Aerial 5.0 keeps its own look and geometry)
static BOOL DMA5MacGeometry(void) { return gAerialFlavor == 5 && DMActiveEngine() == DMEngineAerial && !gA5ThemeOff; }
// The title bar is taller than Aerial's strip (24 vs 13 pt), so it would reach 11 pt above the stage -- and a touch there is outside the stage: it
// went to whatever lies behind (another window, a Home Screen icon). So the stage is made 11 pt taller at the top instead and draws everything in
// it 11 pt lower (its layer's sublayerTransform: Aerial lays out as always, our views keep their frames, the app is drawn -- and touched, the render
// server hit-tests the drawn layers -- where it appears). The stage then starts exactly at the window's top edge, so the whole bar is touchable.
static CGFloat DMA5StageShift(void) { return MAX(0.0, 24.0 - gA5Insets.top); }   // (24 = the title bar, kStageBarHeight)
static CGRect DMA5StageFromWindow(CGRect r) {
    if (!DMA5MacGeometry() || CGRectIsNull(r)) return r;
    UIEdgeInsets i = gA5Insets;
    return CGRectMake(r.origin.x - i.left, r.origin.y + 24.0 - i.top - DMA5StageShift(), r.size.width + i.left + i.right, r.size.height - 24.0 + i.top + i.bottom);
}
static CGRect DMA5WindowFromStage(CGRect f) {
    if (!DMA5MacGeometry() || CGRectIsNull(f)) return f;
    UIEdgeInsets i = gA5Insets;
    return CGRectMake(f.origin.x + i.left, f.origin.y - 24.0 + i.top + DMA5StageShift(), f.size.width - i.left - i.right, f.size.height + 24.0 - i.top - i.bottom);
}
// The Dock's height from the bottom edge to its top, as SpringBoard lays everything out with it (Stage Manager's stage area uses it too: 117 pt on the
// iPad 2 with Stage Manager, where the Dock is taller than our old 84 pt guess). Known even while the Dock waits below the screen.
// The live SBFloatingDockController: SBIconController's accessor, else its ivar read directly (never key-value coding: an unknown key throws in
// SpringBoard -- the "dockctrlstate" trigger took SpringBoard down that way on iOS 16, 28 Sep).
// (iOS 16: not on SBIconController; it is the delegate of the Dock window's root view controller.) Found once, then kept (weakly).
static id DMFloatingDockController(void) {
    static __weak id cached;
    id found = cached;
    if (found) return found;
    Class dc = objc_getClass("SBFloatingDockController");
    if (!dc) return nil;
    id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
    SEL acc = NSSelectorFromString(@"floatingDockController");
    if ([ic respondsToSelector:acc]) found = ((id (*)(id, SEL))objc_msgSend)(ic, acc);
    if (![found isKindOfClass:dc] && ic) {
        Ivar iv = class_getInstanceVariable([ic class], "_floatingDockController");
        found = iv ? object_getIvar(ic, iv) : nil;
    }
    if (![found isKindOfClass:dc]) {
        found = nil;
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) continue;
            id root = w.rootViewController;
            id d = [root respondsToSelector:@selector(delegate)] ? ((id (*)(id, SEL))objc_msgSend)(root, @selector(delegate)) : nil;
            if ([d isKindOfClass:dc]) { found = d; break; }
        }
    }
    cached = found;
    return found;
}
static CGFloat DMSpringBoardDockHeight(void) {
    id ctrl = DMFloatingDockController();
    SEL sel = NSSelectorFromString(@"floatingDockHeight");
    if (![ctrl respondsToSelector:sel]) return 0;
    return ((double (*)(id, SEL))objc_msgSend)(ctrl, sel);
}
// The Dock changed for good (not its recents coming and going): its own apps were added or removed, or its size or gap setting changed. The
// usable area forgets the Dock height it kept (DMUsableArea), and once the Dock has settled at its new size the Fit to Window tiles are laid out
// again, so the windows reach the new Dock line without a respring.
// Stage Manager engine: which layout each window of the desktop is in now (fill, a half, a quarter...), measured against the usable area as it is
// before the Dock changes, so each can be put back into the same layout against the new one -- a lone window filling the desktop too, which
// Fit to Window (two or more windows) never re-tiles.
static NSDictionary<NSString *, NSString *> *DMSMLayoutsNow(void) {
    NSMutableDictionary *out = [NSMutableDictionary dictionary];
    NSDictionary<NSString *, NSValue *> *frames = DMSMOpenWindowFrames();
    if (!frames.count) return out;
    // (the nine layouts are worked out once per call, from ONE measurement of the usable area: DMLayoutFrame measures it again each time, walking
    //  the Dock's views, and DMSMWatchTurn asks for these layouts every second -- 0.78 ms per 0.2 s tick with one window open, iPad 2, S-1)
    NSArray<NSString *> *names = @[@"fill", @"left", @"right", @"top", @"bottom", @"topleft", @"topright", @"bottomleft", @"bottomright"];
    CGRect u = DMUsableArea(); CGSize scr = [UIScreen mainScreen].bounds.size;
    CGRect targets[9];
    for (NSUInteger i = 0; i < 9; i++) targets[i] = DMA5KeepableFrame(DMA5StageFromWindow(DMLayoutFrameInArea(names[i], u, scr)));   // (= DMLayoutFrame)
    for (NSString *b in frames) {
        CGRect f = frames[b].CGRectValue;
        for (NSUInteger i = 0; i < 9; i++) {
            NSString *name = names[i]; CGRect t = targets[i];
            if (CGRectIsNull(t)) continue;
            if (fabs(t.origin.x - f.origin.x) < 6.0 && fabs(t.origin.y - f.origin.y) < 6.0 && fabs(t.size.width - f.size.width) < 6.0 && fabs(t.size.height - f.size.height) < 6.0) { out[b] = name; break; }
        }
    }
    return out;
}
static void DMDockChangedRelayout(NSString *why) {
    NSDictionary *layouts = DMSMEngine() ? DMSMLayoutsNow() : nil;   // (before the usable area forgets the old Dock)
    gDMDockGen++;
    DM_FEATURE_MARK("dock-change-relayout");
    DMLog([NSString stringWithFormat:@"[usable] the Dock changed (%@): its height is measured again; windows in a layout follow it %@", why, layouts]);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{   // (after the Dock's own resize animation)
        (void)DMUsableArea();   // (a first measurement of the new Dock; it counts once seen again 0.3 s later)
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            (void)DMUsableArea();
            if (DMSMEngine()) { if (layouts.count) DMSMApplyLayouts(layouts); }
            else if (DMFitEnabled()) DMApplyGroupSlots(nil);
        });
    });
}
// The iPad turned (Stage Manager engine): Stage Manager keeps each window's size in proportion to the old shape, so a window in the right half of
// portrait (917 pt tall) stood 274 pt taller than landscape's desktop, its title bar above the screen, out of reach (iPad 2, 29 Sep). Fit to Window
// only re-tiles two or more windows. Now each window goes back into the layout it was in (the layouts as they were, taken while the iPad was
// still), and any other window is made to fit inside the new desktop.
static void DMSMWatchTurn(void) {
    static CGSize lastScreen; static NSDictionary *lastLayouts; static CFTimeInterval lastSnap = 0;
    if (!DMSMEngine()) { lastScreen = CGSizeZero; lastLayouts = nil; return; }
    CGSize scr = [UIScreen mainScreen].bounds.size;
    CFTimeInterval now = CACurrentMediaTime();
    if (CGSizeEqualToSize(scr, lastScreen)) {
        if (now - lastSnap >= 1.0 && !(gSidePromptCtx && ![gSidePromptCtx[@"decided"] boolValue])) { lastSnap = now; lastLayouts = DMSMLayoutsNow(); }
        return;
    }
    BOOL first = CGSizeEqualToSize(lastScreen, CGSizeZero);
    lastScreen = scr;
    NSDictionary *layouts = lastLayouts; lastLayouts = nil; lastSnap = now + 1.5;   // (no new snapshot until the turn has settled)
    if (first) return;
    DM_FEATURE_MARK("sm-turn-relayout");
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.9 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{   // (after the turn and the Dock have settled)
        if (!DMSMEngine() || !CGSizeEqualToSize([UIScreen mainScreen].bounds.size, scr)) return;
        (void)DMUsableArea();
        NSMutableDictionary *put = [NSMutableDictionary dictionary];
        NSUInteger tiled = 0; for (NSString *b in gSMFitSlots) if (![gSMFreeWindows containsObject:b]) tiled++;
        BOOL fitRetiles = DMFitEnabled() && tiled >= 2;   // (Fit to Window lays its tiles out again itself, DMSMFitTick)
        for (NSString *b in layouts) if (!(fitRetiles && gSMFitSlots[b])) put[b] = layouts[b];
        if (put.count) DMSMApplyLayouts(put);
        CGRect area = DMSMUsableAreaForIdentity(nil, NULL);   // (the iPad's desktop as Stage Manager's stage area has it: under the menu bar at 24)
        NSDictionary<NSString *, NSValue *> *frames = DMSMOpenWindowFrames();
        for (NSString *b in frames) {
            if (layouts[b]) continue;
            CGRect f = frames[b].CGRectValue;   // (the whole window: our title bar and the card below it)
            if (CGRectEqualToRect(CGRectIntegral(f), CGRectIntegral(CGRectMake(0, -kSMBarH, scr.width, scr.height + kSMBarH)))) continue;   // (full screen)
            if (CGRectContainsRect(CGRectInset(area, -1.0, -1.0), f)) continue;
            CGFloat w = MIN(f.size.width, area.size.width), h = MIN(f.size.height, area.size.height);
            CGFloat x = MIN(MAX(f.origin.x, CGRectGetMinX(area)), CGRectGetMaxX(area) - w), y = MIN(MAX(f.origin.y, CGRectGetMinY(area)), CGRectGetMaxY(area) - h);
            CGRect card = CGRectMake(x, y + kSMBarH, w, h - kSMBarH);
            DMSMSetWindowGeometry(b, CGPointMake(CGRectGetMidX(card) / scr.width, CGRectGetMidY(card) / scr.height), CGSizeMake(card.size.width / scr.width, card.size.height / scr.height));
        }
        DMLog([NSString stringWithFormat:@"[sm] the iPad turned: windows back in their layouts %@, the others kept inside the desktop", put]);
        DMSMFitHiddenStages(frames.count ? DMSMWorkingStage() : nil);   // (and every stage not on screen, in the model)
    });
}
static void DMWatchDockChanges(void) {
    static BOOL registered = NO;
    if (!registered) {   // (the Dock's size and gap settings: Dock.x posts this on every change)
        registered = YES;
        int token;
        notify_register_dispatch("com.besiktasliseba.dockmagnification/prefsChanged", &token, dispatch_get_main_queue(), ^(int t) { DMDockChangedRelayout(@"Dock settings"); });
    }
    static NSInteger lastCount = -1;
    id mgr = DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager");
    id root = DMCall(DMCall(mgr, @"iconModel"), @"rootFolder");
    id dock = [root respondsToSelector:NSSelectorFromString(@"dock")] ? DMCall(root, @"dock") : nil;
    NSArray *icons = [dock respondsToSelector:NSSelectorFromString(@"icons")] ? DMCall(dock, @"icons") : nil;
    if (![icons isKindOfClass:[NSArray class]]) return;
    NSInteger n = (NSInteger)icons.count;
    if (lastCount >= 0 && n != lastCount) DMDockChangedRelayout([NSString stringWithFormat:@"%ld -> %ld apps", (long)lastCount, (long)n]);
    lastCount = n;
}
static CGRect DMUsableArea(void) {
    CGSize screen = [UIScreen mainScreen].bounds.size;
    // Landscape assumes the Dock's top is at most 84 pt above the bottom edge (and moves up if it is higher). In portrait the Dock is
    // shorter than that, which left a strip of unused screen above it: there the Dock's real top is used.
    BOOL portrait = screen.width < screen.height;
    CGFloat dockTop = portrait ? screen.height : screen.height - 84.0;
    BOOL foundDock = NO;
    for (UIWindow *w in DMAllWindows()) {
        if (![NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) continue;
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            [stack addObjectsFromArray:v.subviews];
            if ([NSStringFromClass([v class]) isEqualToString:@"SBFloatingDockPlatterView"] && !v.hidden) {
                CGRect r = [v.superview convertRect:v.frame toView:w];
                // the Dock's real top (not a guess): tiles end right above it. While a full-screen app is in front the Dock waits BELOW the screen
                // (y ~1035 in portrait): that is not where it will be, so then the last top it had on the screen in this shape is used (before, a
                // re-tile behind a full-screen app made the tiles reach the bottom edge of the screen, under the Dock).
                // (a Dock drawn scaled -- magnified, or mid-animation -- is not its real size: not measured)
                // (and laid out for this screen shape: right after a turn the platter can still have the other shape's frame -- 939 pt wide, its top at 699
                //  in a 768 x 1024 portrait screen, iPad 2 4 Oct 11:48 -- and that top was learnt as portrait's tallest Dock: the Fit tiles stopped 270 pt
                //  above the real Dock until a respring; 1.3.5 logic test M2)
                BOOL thisShape = r.size.width <= screen.width + 0.5 && CGRectGetMinX(r) >= -0.5 && CGRectGetMaxX(r) <= screen.width + 0.5 && fabs(w.bounds.size.width - screen.width) < 0.5 && fabs(w.bounds.size.height - screen.height) < 0.5;
                if (thisShape && r.size.width > 100.0 && r.origin.y > screen.height * 0.6 && r.origin.y < screen.height - 10.0 && CGAffineTransformIsIdentity(v.transform) && r.size.height < screen.height * 0.14) {
                    dockTop = r.origin.y; foundDock = YES;
                    static CGFloat loggedTop = -1;
                    if (fabs(loggedTop - dockTop) > 0.25 && DMTestFlag("/tmp/macstatusbar-debug")) {   // (debug: what the Dock measured as)
                        loggedTop = dockTop;
                        CALayer *pl = v.layer.presentationLayer;
                        DMLog([NSString stringWithFormat:@"[usable] Dock top %.2f: platter frame %@ in window, own frame %@ transform %@ (presentation %@), window %@ transform %@ alpha %.2f hidden %d",
                               dockTop, NSStringFromCGRect(r), NSStringFromCGRect(v.frame), NSStringFromCGAffineTransform(v.transform), pl ? NSStringFromCGRect(pl.frame) : @"-",
                               NSStringFromCGRect(w.frame), NSStringFromCGAffineTransform(w.transform), w.alpha, w.hidden]);
                    }
                }
            }
        }
    }
    static CGFloat lastDockTopP = 0, lastDockTopL = 0;
    // The Dock's height changes with the number of icons it shows (its recents: each app opened as a window can add one; iPad 2 portrait 73.8 or
    // 66.4 pt), so the usable area measured a moment apart gave two heights (tiles 919.2 / 926.6 tall): a window was placed with one and its
    // place checked with the other ("put back" moves, a tile 7 pt shorter than its neighbour). The tallest Dock seen in this screen shape is used, so
    // every layout agrees and no window ever reaches under the Dock.
    // (A top is only taken as the standard once it is measured again 0.3 s or more later with the screen unchanged: a Dock measured right at a turn
    //  -- iPad 2, 23:57:42: 96.9 pt tall, top 650.6 instead of 661.5 -- was kept until the next respring and every landscape layout ended 11 pt above
    //  the Dock, logic test 1.0.8. Until then the Dock as measured now is used, so no window reaches under it.)
    static CGFloat tallestTopP = 0, tallestTopL = 0, candTop = -1; static CFTimeInterval candAt = 0; static CGSize candScreen = {0, 0};
    // (the tallest Dock is only kept while the Dock is the same Dock: adding or removing its own apps, or changing its size or gap, makes it a new
    //  height for good -- iPad 2, 29 Sep: apps added to the Dock made it smaller, and the windows kept ending above the old, taller Dock until a respring)
    static unsigned seenGen = 0;
    if (seenGen != gDMDockGen) { seenGen = gDMDockGen; tallestTopP = tallestTopL = 0; candTop = -1; lastDockTopP = lastDockTopL = 0; }
    if (foundDock) {
        CGFloat *tallest = portrait ? &tallestTopP : &tallestTopL;
        CFTimeInterval tnow = CACurrentMediaTime();
        if (*tallest <= 0 || dockTop < *tallest - 0.25) {
            if (fabs(candTop - dockTop) <= 0.25 && CGSizeEqualToSize(candScreen, screen) && tnow - candAt >= 0.3) {
                if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[usable] %@: Dock top %.2f (was %.2f) seen again: the layouts end above it from now on", portrait ? @"portrait" : @"landscape", dockTop, *tallest]);
                *tallest = dockTop; candTop = -1;
            } else if (fabs(candTop - dockTop) > 0.25 || !CGSizeEqualToSize(candScreen, screen)) { candTop = dockTop; candAt = tnow; candScreen = screen; }
        }
        if (*tallest > 0) dockTop = MIN(dockTop, *tallest);
    }
    if (foundDock) { if (portrait) lastDockTopP = dockTop; else lastDockTopL = dockTop; }
    else if (portrait ? lastDockTopP > 0 : lastDockTopL > 0) dockTop = portrait ? lastDockTopP : lastDockTopL;   // (the Dock is away: where it last was)
    else if (DMSpringBoardDockHeight() > 20.0) dockTop = screen.height - DMSpringBoardDockHeight();   // not measured yet: SpringBoard's own figure (valid while the Dock is away)
    else if (portrait) dockTop = screen.height - 84.0;   // no figure at all: the old guess
    CGFloat top = DMTopLimit(), side = 0.0, gapToDock = 2.0;   // tiled windows touch the outer side edges of the screen, start flush under the status bar (24 pt; 0 while it hides itself) and end just above the Dock
    return CGRectMake(side, top, screen.width - 2.0 * side, MAX(200.0, dockTop - gapToDock - top));
}
// Is the floating Dock on the screen now? (Behind a full-screen app it waits below the bottom edge.)
static BOOL DMDockOnScreen(void) {
    CGSize screen = [UIScreen mainScreen].bounds.size;
    for (UIWindow *w in DMAllWindows()) {
        if (w.hidden || w.alpha < 0.01 || ![NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) continue;
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            [stack addObjectsFromArray:v.subviews];
            if (![NSStringFromClass([v class]) isEqualToString:@"SBFloatingDockPlatterView"] || v.hidden || v.alpha < 0.01) continue;
            CGRect r = [v.superview convertRect:v.frame toView:w];
            if (r.size.width > screen.width + 0.5 || CGRectGetMaxX(r) > screen.width + 0.5) continue;   // (the other screen shape's frame, mid-turn: DMUsableArea)
            if (r.size.width > 100.0 && r.origin.y > screen.height * 0.6 && r.origin.y < screen.height - 10.0) return YES;
        }
    }
    return NO;
}
static CGFloat DMDockCenterX(void) {   // where the middle of the Dock is (the screen's middle when it cannot be measured)
    CGFloat centre = [UIScreen mainScreen].bounds.size.width / 2.0;
    for (UIWindow *w in DMAllWindows()) {
        if (![NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) continue;
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            [stack addObjectsFromArray:v.subviews];
            if ([NSStringFromClass([v class]) isEqualToString:@"SBFloatingDockPlatterView"] && !v.hidden) {
                CGRect r = [v.superview convertRect:v.frame toView:w];
                if (r.size.width > 100.0) centre = CGRectGetMidX(r);
            }
        }
    }
    return centre;
}
static CGRect DMLayoutFrameWindow(NSString *name);
static CGRect DMLayoutFrame(NSString *name) { return DMA5KeepableFrame(DMA5StageFromWindow(DMLayoutFrameWindow(name))); }   // (Aerial 5.0: the stage that draws that window; inside what Aerial keeps, see DMA5AerialFitsHere)
static CGRect DMLayoutFrameInArea(NSString *name, CGRect u, CGSize screen);
static CGRect DMLayoutFrameWindow(NSString *name) { return DMLayoutFrameInArea(name, DMUsableArea(), [UIScreen mainScreen].bounds.size); }
static CGRect DMLayoutFrameInArea(NSString *name, CGRect u, CGSize screen) {   // (u: the usable desktop of that screen -- the iPad's, or the TV's)
    CGFloat g = 10.0;   // the space between tiled windows
    CGFloat halfW = floor((u.size.width - g) / 2.0), halfH = floor((u.size.height - g) / 2.0);
    CGFloat rightX = u.origin.x + u.size.width - halfW, bottomY = u.origin.y + u.size.height - halfH;
    if ([name isEqualToString:@"fill"]) return u;
    if ([name isEqualToString:@"center"]) return CGRectMake(round(screen.width * 0.11), 36.0, round(screen.width * 0.78), MIN(round(screen.height * 0.80), CGRectGetMaxY(u) - 36.0));
    if ([name isEqualToString:@"left"]) return CGRectMake(u.origin.x, u.origin.y, halfW, u.size.height);
    if ([name isEqualToString:@"right"]) return CGRectMake(rightX, u.origin.y, halfW, u.size.height);
    if ([name isEqualToString:@"top"]) return CGRectMake(u.origin.x, u.origin.y, u.size.width, halfH);
    if ([name isEqualToString:@"bottom"]) return CGRectMake(u.origin.x, bottomY, u.size.width, halfH);
    if ([name isEqualToString:@"topleft"]) return CGRectMake(u.origin.x, u.origin.y, halfW, halfH);
    if ([name isEqualToString:@"topright"]) return CGRectMake(rightX, u.origin.y, halfW, halfH);
    if ([name isEqualToString:@"bottomleft"]) return CGRectMake(u.origin.x, bottomY, halfW, halfH);
    if ([name isEqualToString:@"bottomright"]) return CGRectMake(rightX, bottomY, halfW, halfH);
    CGFloat fw = 0.0, fh = 0.0;   // sizes: centred, as a share of the usable area
    if ([name isEqualToString:@"small"]) { fw = 0.50; fh = 0.58; }
    else if ([name isEqualToString:@"medium"]) { fw = 0.66; fh = 0.74; }
    else if ([name isEqualToString:@"large"]) { fw = 0.86; fh = 0.92; }
    if (fw > 0.0) {
        CGFloat w = round(u.size.width * fw), h = round(u.size.height * fh);
        return CGRectMake(round(u.origin.x + (u.size.width - w) / 2.0), round(u.origin.y + (u.size.height - h) / 2.0), w, h);
    }
    return CGRectNull;
}
// Puts the active app's window at a layout, smoothly. A window slides and resizes there; a full-screen app is first turned into
// a window (the usual green-button transition) that opens straight at that place and size.
static NSMutableArray<NSString *> *gFitGroup = nil;   // apps whose windows Fit to Window tiles, newest first (at most four)
static NSMutableDictionary<NSString *, NSString *> *gFitSlots = nil;   // bundle id -> the slot (layout name) of its tile
static void DMFitGroupForget(NSString *bundleID) { if (bundleID.length) { [gFitGroup removeObject:bundleID]; [gFitSlots removeObjectForKey:bundleID]; } }
// The default slots for n windows, newest first: two are the halves, three are a left half with the right half split, four are the quarters.
static NSArray<NSString *> *DMDefaultSlotNames(NSUInteger n) {
    return n == 2 ? @[@"left", @"right"] : (n == 3 ? @[@"left", @"topright", @"bottomright"] : @[@"topleft", @"topright", @"bottomleft", @"bottomright"]);
}
static void DMAssignDefaultSlots(void) {
    gFitSlots = [NSMutableDictionary dictionary];
    NSArray *names = DMDefaultSlotNames(gFitGroup.count);
    for (NSUInteger i = 0; i < gFitGroup.count && i < names.count; i++) gFitSlots[gFitGroup[i]] = names[i];
}
static CGRect DMSlotFrame(NSString *bundleID) {
    NSString *slot = gFitSlots[bundleID];
    return slot ? DMLayoutFrame(slot) : CGRectNull;
}
// Which slot a window is in (by its frame), or nil when it is not in one.
static NSString *DMSlotNameForFrame(CGRect f) {
    for (NSString *name in @[@"left", @"right", @"top", @"bottom", @"topleft", @"topright", @"bottomleft", @"bottomright"]) {
        CGRect t = DMLayoutFrame(name);
        if (CGRectIsNull(t)) continue;
        if (fabs(t.origin.x - f.origin.x) < 16.0 && fabs(t.origin.y - f.origin.y) < 16.0 && fabs(t.size.width - f.size.width) < 16.0 && fabs(t.size.height - f.size.height) < 16.0) return name;
    }
    return nil;
}
static NSString *DMMirrorSlot(NSString *slot, BOOL horizontal) {
    static NSDictionary *h, *v;
    if (!h) {
        h = @{@"left": @"right", @"right": @"left", @"topleft": @"topright", @"topright": @"topleft", @"bottomleft": @"bottomright", @"bottomright": @"bottomleft"};
        v = @{@"top": @"bottom", @"bottom": @"top", @"topleft": @"bottomleft", @"bottomleft": @"topleft", @"topright": @"bottomright", @"bottomright": @"topright"};
    }
    return (horizontal ? h : v)[slot] ?: slot;
}
static NSMutableDictionary<NSString *, NSValue *> *gLastWindowFrames;   // app -> where its window last was (until the app quits)
static BOOL gPreferRememberedFrame = NO;                                       // the status bar's green light: back to where the window was
// Aerial 5.0, a full-screen app turned into a window from the Window menu (or the green light): the frame asked for. The fly-in entrance lands
// there and holds it while Aerial's own fit-to-screen pass (a dispatched block ~0.15 s after the window appears) shrinks any window reaching past
// the screen's edges -- Fill Screen does on purpose, by its invisible 6 pt side margins (DMAerial5BeginEntrance, DMA5HoldEntranceFrame).
static NSString *gA5EntranceBundle = nil;
static CGRect gA5EntranceFrame = {{0, 0}, {0, 0}};
static CFTimeInterval gA5EntranceAt = 0;
static NSString *DMCurrentLayoutName(void);   // defined with the Window menu
static void DMFitRejoinAfterFullScreen(NSString *bundleID);
static void DMFitForgetFullScreenTile(NSString *bundleID);
static void DMWindowLayout(NSString *name) {
    CGRect target = DMLayoutFrame(name);
    SBApplication *app = DMActiveApp();
    NSString *bundleID = [app bundleIdentifier];
    if (CGRectIsNull(target) || !bundleID.length) return;
    if (DMAppNeedsFullScreen(bundleID) && [[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) {   // (it stays full screen: no hop home and back)
        DMLog([NSString stringWithFormat:@"[fullscreenonly] %@ cannot live in a window: layout %@ ignored, it stays full screen", bundleID, name]);
        return;
    }
    if (DMSMEngine()) {   // Stage Manager: the window's place in the stage (the frame is the whole window; the card is below our title bar)
        CGSize scr = CGSizeZero;
        CGRect w = DMLayoutFrameInArea(name, DMSMUsableAreaForStage(DMSMStageOf(bundleID), &scr), scr);   // (on the screen its stage is on: the iPad or the TV)
        if (CGRectIsNull(w) || scr.width < 1.0 || scr.height < 1.0) return;
        CGRect c = CGRectMake(w.origin.x, w.origin.y + kSMBarH, w.size.width, w.size.height - kSMBarH);
        BOOL ok = DMSMSetWindowGeometry(bundleID, CGPointMake(CGRectGetMidX(c) / scr.width, CGRectGetMidY(c) / scr.height), CGSizeMake(c.size.width / scr.width, c.size.height / scr.height));
        DMLog([NSString stringWithFormat:@"[sm] layout %@ for %@ -> window %@ (%@)", name, bundleID, NSStringFromCGRect(w), ok ? @"done" : @"not in the stage"]);
        return;
    }
    DMFitGroupForget(bundleID);   // placed by a layout of its own: no longer part of the tiling
    // A layout picked from the Window menu is where the user wants it: an app in full screen does not take back the tile it had before (Fill Screen
    // on a full-screen Reddit came out as a big window and was put back into its half 0.1 s later, M1 27 Sep). Only the green light's "back to the
    // window" (gPreferRememberedFrame) returns it to its tile.
    if (!gPreferRememberedFrame) DMFitForgetFullScreenTile(bundleID);
    if (gPreferRememberedFrame && gLastWindowFrames[bundleID]) target = gLastWindowFrames[bundleID].CGRectValue;
    if (DMActiveEngine() == DMEngineZetsu) {   // a Zetsu window slides there; a full-screen app is turned into a window that opens there
        UIWindow *zw = DMZetsuWindowFor(bundleID);
        DMLog([NSString stringWithFormat:@"[window] Zetsu layout %@ for %@ -> %@ (%@)", name, bundleID, NSStringFromCGRect(target), zw ? @"moving its window" : @"opening a window"]);
        if (zw && !DMStageMinimized(zw)) {
            if (DMFrontApp()) { gWindowsPinnedForward = YES; DMApplyWindowLevel(); }
            DMZetsuMove(zw, target, YES, ^{ DMLog([NSString stringWithFormat:@"[window] Zetsu layout done, window %@", NSStringFromCGRect(zw.frame)]); });
        } else if ([[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) {
            gPendingWindowFrame = target;
            DMSendToWindow(bundleID);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMFitRejoinAfterFullScreen(bundleID); });
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(4.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ gPendingWindowFrame = CGRectNull; });
        }
        return;
    }
    if (DMActiveEngine() == DMEngineAerial) {
        UIView *stage = DMStageForBundle(bundleID);
        DMLog([NSString stringWithFormat:@"[window] Aerial layout %@ for %@ -> %@ (%@)", name, bundleID, NSStringFromCGRect(target), stage ? @"moving its stage" : @"opening a stage"]);
        if (stage) {
            DMAerialMoveStage(stage, target, ^{ DMLog([NSString stringWithFormat:@"[window] Aerial layout done, stage %@", NSStringFromCGRect(stage.frame)]); });
            // (held like the fly-in: Aerial's own late re-placement of a window reaching past the screen's edges is undone before it is drawn)
            if (gAerialFlavor == 5 && !DMTestFlag("/tmp/msb-a5-nohold")) DMA5HoldStageAt(stage, DMA5KeepableFrame(target), CACurrentMediaTime() + 1.5);
        }
        else if ([[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) {
            DMStageCoverPrepare(YES);
            // Aerial sends the app home itself and then waits a fixed half second. The Home Screen hop is hidden behind the cover, so do
            // it here and hand over the moment the app is gone (Aerial then opens the window at once).
            void (^open)(void) = ^{
                gA5EntranceBundle = [bundleID copy]; gA5EntranceFrame = target; gA5EntranceAt = CACurrentMediaTime();
                DMAerialTrigger(bundleID, target);
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    UIView *settled = DMStageForBundle(bundleID);
                    DMLog([NSString stringWithFormat:@"[window] full-screen->window: settled stage frame %@ (requested %@), current layout name %@",
                           settled ? NSStringFromCGRect(settled.frame) : @"(no stage)", NSStringFromCGRect(target), DMCurrentLayoutName()]);
                    DMFitRejoinAfterFullScreen(bundleID);
                });
            };
            SEL goHome = NSSelectorFromString(@"_returnToHomeScreenWithCompletion:");
            UIApplication *ui = [UIApplication sharedApplication];
            if ([ui respondsToSelector:goHome]) {
                CFTimeInterval began = CACurrentMediaTime();
                ((void (*)(id, SEL, id))objc_msgSend)(ui, goHome, ^{});
                __block void (^poll)(void) = nil;
                poll = ^{
                    CFTimeInterval waited = CACurrentMediaTime() - began;
                    BOOL gone = ![[DMFrontApp() bundleIdentifier] isEqualToString:bundleID];
                    if ((gone && waited >= 0.28) || waited > 1.2) { DMLog([NSString stringWithFormat:@"[window] app left after %.2f s, opening the window", waited]); open(); poll = nil; return; }
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.02 * NSEC_PER_SEC)), dispatch_get_main_queue(), poll);
                };
                poll();
            } else open();
        }
        return;
    }
    UIView *window = DMFindMilkyWayWindow(bundleID);
    DMLog([NSString stringWithFormat:@"[window] layout %@ for %@ -> %@ (%@)", name, bundleID, NSStringFromCGRect(target), window ? @"already a window" : @"full screen"]);
    if (window && !DMWindowMinimized(window)) {
        [window.superview bringSubviewToFront:window];
        if (DMFrontApp()) { gWindowsPinnedForward = YES; DMApplyWindowLevel(); }
        DMShowMilkyWayVeil(window);   // Window menu layouts (Fill/Center/halves/...) are exactly the "grey bars" case: cover the content while it catches up
        MSBAnimate(0.36, 0, 1.0, UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction, ^{
            window.frame = target;
            [window layoutIfNeeded];
        }, ^(BOOL finished) {
            DMLog([NSString stringWithFormat:@"[window] layout done, frame %@", NSStringFromCGRect(window.frame)]);
        });
    } else if ([[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) {
        gPendingWindowFrame = target;
        DMSendToWindow(bundleID);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(4.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ gPendingWindowFrame = CGRectNull; });
    }
}

static void DMSendToWindow(NSString *bundleID) {
    if (!bundleID.length) return;
    if (DMAppNeedsFullScreen(bundleID)) { DMLog([NSString stringWithFormat:@"[fullscreenonly] %@ cannot live in a window: it stays full screen", bundleID]); return; }
    if (DMActiveEngine() == DMEngineZetsu) {   // same transition as MilkyWay's: cover, the app goes home, the Zetsu window opens, the cover shrinks into it
        DMCoverShow();
        DMMinimize();
        if (CGRectIsNull(gPendingWindowFrame)) { gPendingWindowFrame = gLastWindowFrames[bundleID] ? gLastWindowFrames[bundleID].CGRectValue : DMLayoutFrame(@"center"); dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(4.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ gPendingWindowFrame = CGRectNull; }); }
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            // Zetsu may have opened the window itself in the meantime (a launch it was still repeating, taken up as the app went home): asking again
            // made Zetsu put it back at its own default spot, which then counted as a move by hand (iPad 2, Safari, first-frame start after 0.13 s).
            UIWindow *already = DMZetsuWindowFor(bundleID);
            if (already) { DMLog([NSString stringWithFormat:@"[zetsu] %@: Zetsu already opened its window, not asked again", bundleID]); if (DMStageMinimized(already)) DMZetsuSurface(already); }
            else DMZetsuLaunch(bundleID);
            CFTimeInterval launched = CACurrentMediaTime();
            DMWaitFor(^BOOL{ UIWindow *w = DMZetsuWindowFor(bundleID); return w && [objc_getAssociatedObject(w, kZetsuAdoptedKey) boolValue]; }, 40, ^(BOOL ok) {
                UIWindow *found = ok ? DMZetsuWindowFor(bundleID) : nil;
                DMLog([NSString stringWithFormat:@"[zetsu] window for %@ %@ after %.2f s, frame %@", bundleID, ok ? @"found" : @"NOT found", CACurrentMediaTime() - launched, found ? NSStringFromCGRect(found.frame) : @"-"]);
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMShrinkCoverInto(found); });
            });
        });
        return;
    }
    DMCoverShow();
    DMMinimize();
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        DMLaunchAsWindow(bundleID);
        CFTimeInterval launched = CACurrentMediaTime();
        DMWaitFor(^BOOL{ return DMFindMilkyWayWindow(bundleID) != nil; }, 40, ^(BOOL ok) {
            UIView *found = ok ? DMFindMilkyWayWindow(bundleID) : nil;
            id orientation = nil; @try { orientation = [found valueForKey:@"contentViewOrientation"]; } @catch (id e) {}
            DMLog([NSString stringWithFormat:@"[lights] window for %@ %@ after %.2f s, frame %@, contentViewOrientation %@", bundleID, ok ? @"found" : @"NOT found", CACurrentMediaTime() - launched, found ? NSStringFromCGRect(found.frame) : @"-", orientation]);
            BOOL resized = DMEnlargeNewWindow(found);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((resized ? 0.30 : 0.10) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMShrinkCoverInto(found); });
        });
    });
}


static void DMOpenFullScreen(NSString *bundleID) {
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    gForceFullScreenLaunch = YES;
    BOOL ok = [sb respondsToSelector:@selector(launchApplicationWithIdentifier:suspended:)] && [sb launchApplicationWithIdentifier:bundleID suspended:NO];
    gForceFullScreenLaunch = NO;
    DMLog([NSString stringWithFormat:@"[lights] open %@ full screen -> %d", bundleID, ok]);
}

static SBApplication *DMActiveApp(void);
// (a native window that is active is the active window: every app window's lights go grey -- two windows showed colored lights, iPad 2 30 Sep)
static NSString *DMNativeLightsToken(void);   // (NativeWindow.h)
static NSString *DMActiveBundleForLights(void) { return DMNativeLightsToken() ?: [DMActiveApp() bundleIdentifier]; }
static BOOL DMSMWindowAction(NSString *bundleID, NSString *name);   // (Stage Manager engine, below)
static BOOL DMSMToggleZoom(NSString *bundle);
static void DMLightAction(NSInteger which) {
    SBApplication *app = DMActiveApp() ?: DMFrontApp();
    NSString *bundleID = [app bundleIdentifier];
    DMLog([NSString stringWithFormat:@"[lights] tap %ld, front app %@", (long)which, bundleID]);
    if (!bundleID.length) return;
    // Stage Manager as the engine: the window's own actions (its "..." menu): red Close, yellow Minimize, green Enter Full Screen
    if (DMSMEngine() && (which == 2 ? DMSMToggleZoom(bundleID) : DMSMWindowAction(bundleID, which == 0 ? @"close" : @"removeFromSet"))) return;
    if (which == 0) DMForceQuit(app);
    else if (which == 1) DMMinimize();
    else if (DMAppNeedsFullScreen(bundleID)) DMLog([NSString stringWithFormat:@"[fullscreenonly] green on %@: it cannot live in a window (the button is greyed out)", bundleID]);
    else if (DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu) { gPreferRememberedFrame = YES; DMWindowLayout(@"center"); gPreferRememberedFrame = NO; }
    else DMSendToWindow(bundleID);
}

// On a MilkyWay window's own title bar the green button should mean "full screen": close the window (the app keeps
// running) and open the app natively. MilkyWay's stock green only maximizes the window inside MilkyWay. The hook is
// installed at runtime, once MilkyWay's class exists (it loads after this tweak).
// Restyles MilkyWay's red / yellow / green window buttons to look like the status bar lights: the button itself becomes
// transparent, a 12 pt dot with its symbol is drawn inside it. The buttons are only moved when they still sit where
// MilkyWay's default theme puts them (x 4 / 28 / 52, 16 pt wide), so states where MilkyWay moves them are left alone.
static const void *kMWDotKey = &kMWDotKey, *kMWRedKey = &kMWRedKey;

// ---- resize-corner grip: a small, non-interactive hint that a window's corner can be dragged to resize it ----
// Apple's closest touch-screen precedent is iPadOS Stage Manager's own hairline-subtle affordances, but the clearest single
// shape already in Apple's own vocabulary for "grab here" is the small rounded pill iOS uses for a sheet's drag grabber. This
// borrows that idea at a fraction of the size, tilted along the corner's diagonal so it reads as a resize cue rather than a
// drag-down one. It is a plain UIView (never a private class), added once and then only repositioned/recolored, and it is
// always userInteractionEnabled = NO so it can never steal the touch meant for the real (invisible) handle underneath it.
static const CGFloat kResizeGripLength = 13.0, kResizeGripThickness = 2.5;
static UIView *DMMakeResizeGrip(void) {
    UIView *grip = [[UIView alloc] initWithFrame:CGRectMake(0, 0, kResizeGripLength, kResizeGripThickness)];
    grip.layer.cornerRadius = kResizeGripThickness / 2.0;
    grip.userInteractionEnabled = NO;
    return grip;
}
static UIColor *DMResizeGripColor(BOOL dark) {
    return [UIColor colorWithWhite:(dark ? 1.0 : 0.0) alpha:(dark ? 0.30 : 0.24)];
}
// The main colour of an app's icon (Tint Resize Handles, for apps whose buttons are white, black or grey): the average of its clearly coloured pixels,
// nil when too few of them are coloured (a black-and-white icon like X's). Worked out once per app, from a 24 x 24 copy of the icon.
UIColor *DMIconAccent(NSString *bundleID) {
    static NSMutableDictionary<NSString *, id> *cache;
    if (!cache) cache = [NSMutableDictionary dictionary];
    id hit = cache[bundleID]; if (hit) return hit == [NSNull null] ? nil : hit;
    // The icon as it is shown (a themed icon from SnowBoard and the like counts): the app's icon view in the Dock or on the Home Screen, drawn small;
    // the app's own icon image when it is not on screen anywhere.
    UIView *shown = nil;
    for (UIWindow *w in DMAllWindows()) {
        NSString *wc = NSStringFromClass([w class]);
        if (![wc isEqualToString:@"SBFloatingDockWindow"] && ![wc isEqualToString:@"SBHomeScreenWindow"]) continue;
        NSMutableArray<UIView *> *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count && !shown) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            if ([NSStringFromClass([v class]) isEqualToString:@"SBIconView"]) {
                NSString *b = nil; @try { b = [[v valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {}
                if ([b isEqualToString:bundleID]) { UIView *iv = nil; @try { iv = [v valueForKey:@"_iconImageView"]; } @catch (id e) {} shown = [iv isKindOfClass:[UIView class]] && iv.bounds.size.width > 4.0 ? iv : nil; }
                continue;
            }
            [stack addObjectsFromArray:v.subviews];
        }
        if (shown) break;
    }
    UIImage *icon = nil;
    if (!shown) {
        SEL s = NSSelectorFromString(@"_applicationIconImageForBundleIdentifier:format:scale:");
        if ([UIImage respondsToSelector:s]) icon = ((id (*)(id, SEL, id, int, CGFloat))objc_msgSend)([UIImage class], s, bundleID, 2, 1.0);
    }
    UIColor *result = nil;
    if (shown || icon.CGImage) {
        const int n = 24; uint8_t px[n * n * 4]; memset(px, 0, sizeof px);
        CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
        CGContextRef ctx = CGBitmapContextCreate(px, n, n, 8, n * 4, cs, kCGImageAlphaPremultipliedLast);
        CGColorSpaceRelease(cs);
        if (ctx) {
            if (shown) {   // (drawn into the small bitmap, flipped to UIKit's top-left origin)
                CGContextTranslateCTM(ctx, 0, n); CGContextScaleCTM(ctx, n / shown.bounds.size.width, -n / shown.bounds.size.height);
                [shown.layer renderInContext:ctx];
            } else CGContextDrawImage(ctx, CGRectMake(0, 0, n, n), icon.CGImage);
            CGContextRelease(ctx);
            double sr = 0, sg = 0, sb = 0; int count = 0;
            for (int i = 0; i < n * n; i++) {
                double a = px[i * 4 + 3] / 255.0; if (a < 0.5) continue;
                double r = px[i * 4] / 255.0 / a, g = px[i * 4 + 1] / 255.0 / a, b = px[i * 4 + 2] / 255.0 / a;
                double mx = MAX(r, MAX(g, b)), mn = MIN(r, MIN(g, b));
                if (mx < 0.25 || (mx - mn) / mx < 0.35) continue;   // (dark or washed out: not the icon's colour)
                sr += r; sg += g; sb += b; count++;
            }
            if (count >= n * n * 0.08) result = [UIColor colorWithRed:sr / count green:sg / count blue:sb / count alpha:1.0];
        }
    }
    cache[bundleID] = result ?: (id)[NSNull null];
    DMLog([NSString stringWithFormat:@"[tint] %@: icon colour %@ (from the %@)", bundleID, result ?: @"none (black and white)", shown ? @"icon as shown" : @"app's own icon"]);
    return result;
}
// Tint Resize Handles (Settings > Status Bar > Windows, on by default; the owner, 27 Sep): a window's resize grips take its app's accent colour (the tint
// of its back buttons and links: Notes yellow, Settings blue, Spotify green), held back so it stays a hint. MacAppBridge publishes the app's tint as
// notify state "com.besiktasliseba.appbridge.tint.<hash>" (bit 32 set = valid, then 8-bit R, G, B, A). An app with no tint yet, or a white, black or
// grey one (X), keeps the neutral grip.
static BOOL gTintGrips = YES;
static BOOL gSMAppleHandles = NO;   // (Stage Manager engine: Settings > Resize Handles = Stage Manager)
static UIColor *DMResizeGripColorFor(NSString *bundleID, BOOL dark) {
    if (!gTintGrips || !bundleID.length) return DMResizeGripColor(dark);
    static NSMutableDictionary<NSString *, NSNumber *> *tokens;
    if (!tokens) tokens = [NSMutableDictionary dictionary];
    NSNumber *tok = tokens[bundleID];
    if (!tok) {
        uint32_t hash = 2166136261u;
        for (const char *c = bundleID.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
        char name[80]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.tint.%08x", hash);
        int t = 0; if (notify_register_check(name, &t) != NOTIFY_STATUS_OK) t = -1;
        tok = @(t); tokens[bundleID] = tok;
    }
    uint64_t st = 0;
    if (tok.intValue < 0 || notify_get_state(tok.intValue, &st) != NOTIFY_STATUS_OK || !(st & (1ULL << 32))) {   // (no tint reported -- Spotify never does: its icon's colour)
        extern UIColor *DMIconAccent(NSString *bundleID);
        UIColor *ic = DMIconAccent(bundleID);
        return ic ? [ic colorWithAlphaComponent:(dark ? 0.62 : 0.55)] : DMResizeGripColor(dark);
    }
    CGFloat r = ((st >> 24) & 0xff) / 255.0, g = ((st >> 16) & 0xff) / 255.0, b = ((st >> 8) & 0xff) / 255.0;
    CGFloat mx = MAX(r, MAX(g, b)), mn = MIN(r, MIN(g, b));
    if (mx - mn < 0.15) {   // (white, black or grey buttons -- WhatsApp, Spotify: the main colour of the app's icon instead, if it has one)
        extern UIColor *DMIconAccent(NSString *bundleID);
        UIColor *ic = DMIconAccent(bundleID);
        return ic ? [ic colorWithAlphaComponent:(dark ? 0.62 : 0.55)] : DMResizeGripColor(dark);
    }
    return [UIColor colorWithRed:r green:g blue:b alpha:(dark ? 0.62 : 0.55)];   // (held back: a hint of the app's colour)
}
static const void *kMWGripKey = &kMWGripKey;

// MilkyWay4's resize handle lags the finger by its recogniser's start threshold (~11 pt), like Aerial 5.0's (see DMA5GripBox -resizeCatchUp:).
// A recogniser of ours notes where the finger went down on the handle; our target on MilkyWay's recogniser then adds the missed distance.
@interface DMMWResizeCatchUp : NSObject <UIGestureRecognizerDelegate>
+ (instancetype)shared;
@end
static char kMWDownKey, kMWWatchedKey, kMWOffsetKey;
@implementation DMMWResizeCatchUp
+ (instancetype)shared { static DMMWResizeCatchUp *c; static dispatch_once_t once; dispatch_once(&once, ^{ c = [DMMWResizeCatchUp new]; }); return c; }
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)touch {
    UIView *win = g.view.superview;
    if (win.superview) objc_setAssociatedObject(g.view, &kMWDownKey, [NSValue valueWithCGPoint:[touch locationInView:win.superview]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (DMTestFlag("/tmp/msb-a5-dragtrace")) DMLog([NSString stringWithFormat:@"[mwresize] touch down on %@ at %@", NSStringFromClass([g.view class]), NSStringFromCGPoint([touch locationInView:g.view])]);
    return NO;
}
- (void)resized:(UIPanGestureRecognizer *)g {
    UIView *handle = g.view, *win = handle.superview;
    if (!win.superview) return;
    if (g.state == UIGestureRecognizerStateBegan) {
        NSValue *down = objc_getAssociatedObject(handle, &kMWDownKey);
        CGPoint now = [g locationInView:win.superview];
        CGPoint d = down ? CGPointMake(now.x - down.CGPointValue.x, now.y - down.CGPointValue.y) : CGPointZero;
        objc_setAssociatedObject(g, &kMWOffsetKey, (hypot(d.x, d.y) >= 0.5 && hypot(d.x, d.y) <= 40) ? [NSValue valueWithCGPoint:d] : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    NSValue *dv = objc_getAssociatedObject(g, &kMWOffsetKey);
    if (DMTestFlag("/tmp/msb-a5-dragtrace")) DMLog([NSString stringWithFormat:@"[mwresize] state %ld location %@ window %@ catch-up %@", (long)g.state, NSStringFromCGPoint([g locationInView:win.superview]), NSStringFromCGRect(win.frame), dv ? NSStringFromCGPoint(dv.CGPointValue) : @"-"]);
    if (!dv || g.state == UIGestureRecognizerStateBegan) return;
    if (g.state == UIGestureRecognizerStateChanged || g.state == UIGestureRecognizerStateEnded) {   // (MilkyWay sizes from where its recogniser started)
        CGRect f = win.frame; f.size.width += dv.CGPointValue.x; f.size.height += dv.CGPointValue.y;
        if (f.size.width >= 200 && f.size.height >= 150) win.frame = f;
    }
    if (g.state != UIGestureRecognizerStateChanged) objc_setAssociatedObject(g, &kMWOffsetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
// Title-bar drags: the same catch-up (MilkyWay moves the window from where its recogniser started), and the window's top is kept below our
// status bar like a macOS window below the menu bar (MilkyWay4 let a window go up under the status bar, out of reach: measured y = -2).
- (void)dragged:(UIPanGestureRecognizer *)g {
    UIView *bar = g.view, *win = bar; while (win && ![NSStringFromClass([win class]) isEqualToString:@"AXWindowView"]) win = win.superview;
    if (!win.superview) return;
    if (g.state == UIGestureRecognizerStateBegan) {
        NSValue *down = objc_getAssociatedObject(bar, &kMWDownKey);
        CGPoint now = [g locationInView:win.superview];
        CGPoint d = down ? CGPointMake(now.x - down.CGPointValue.x, now.y - down.CGPointValue.y) : CGPointZero;
        objc_setAssociatedObject(g, &kMWOffsetKey, (hypot(d.x, d.y) >= 0.5 && hypot(d.x, d.y) <= 40) ? [NSValue valueWithCGPoint:d] : [NSValue valueWithCGPoint:CGPointZero], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    NSValue *dv = objc_getAssociatedObject(g, &kMWOffsetKey);
    if (DMTestFlag("/tmp/msb-a5-dragtrace")) DMLog([NSString stringWithFormat:@"[mwdrag] state %ld location %@ window %@ catch-up %@", (long)g.state, NSStringFromCGPoint([g locationInView:win.superview]), NSStringFromCGRect(win.frame), dv ? NSStringFromCGPoint(dv.CGPointValue) : @"-"]);
    if (g.state == UIGestureRecognizerStateChanged || g.state == UIGestureRecognizerStateEnded) {
        CGRect f = win.frame; CGPoint d = dv.CGPointValue;
        f.origin.x += d.x; f.origin.y += d.y;
        if (f.origin.y < DMTopLimit()) f.origin.y = DMTopLimit();
        if (!CGRectEqualToRect(f, win.frame)) win.frame = f;
    }
    if (g.state != UIGestureRecognizerStateChanged && g.state != UIGestureRecognizerStateBegan) objc_setAssociatedObject(g, &kMWOffsetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
+ (void)watchTitleBar:(UIView *)bar {
    if (!bar || objc_getAssociatedObject(bar, &kMWWatchedKey)) return;
    objc_setAssociatedObject(bar, &kMWWatchedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSUInteger n = 0;
    for (UIGestureRecognizer *g in bar.gestureRecognizers) if ([g isKindOfClass:[UIPanGestureRecognizer class]]) { [g addTarget:[self shared] action:@selector(dragged:)]; n++; }
    UIGestureRecognizer *note = [[UIGestureRecognizer alloc] initWithTarget:nil action:NULL];
    note.cancelsTouchesInView = NO; note.delaysTouchesBegan = NO; note.delaysTouchesEnded = NO; note.delegate = [self shared];
    [bar addGestureRecognizer:note];
    DMLog([NSString stringWithFormat:@"[mwdrag] title bar watched (%lu drag recognisers of MilkyWay's on it)", (unsigned long)n]);
}
+ (void)watch:(UIView *)handle {
    if (!handle || objc_getAssociatedObject(handle, &kMWWatchedKey)) return;
    objc_setAssociatedObject(handle, &kMWWatchedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    for (UIGestureRecognizer *g in handle.gestureRecognizers) if ([g isKindOfClass:[UIPanGestureRecognizer class]]) [g addTarget:[self shared] action:@selector(resized:)];
    UIGestureRecognizer *note = [[UIGestureRecognizer alloc] initWithTarget:nil action:NULL];
    note.cancelsTouchesInView = NO; note.delaysTouchesBegan = NO; note.delaysTouchesEnded = NO; note.delegate = [self shared];
    [handle addGestureRecognizer:note];
}
@end
static void DMRestyleWindowButtons(AXWindowView *w) {
    // Like a macOS window: no app name in the title bar, and a darker title bar (light or dark with the system appearance).
    // macOS-style rounded corners on all four sides (the bottom used to be square), and a hairline edge for definition.
    BOOL darkStyle = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
    w.clipsToBounds = YES;
    w.layer.cornerRadius = kMilkyWayCorner;
    w.layer.cornerCurve = kCACornerCurveContinuous;
    w.layer.borderWidth = 0.5;
    w.layer.borderColor = (darkStyle ? [UIColor colorWithWhite:1.0 alpha:0.16] : [UIColor colorWithWhite:0.0 alpha:0.14]).CGColor;
    @try {
        UIView *bar = [w valueForKey:@"titleBar"];
        UIView *label = [w valueForKey:@"titleLabel"];
        BOOL dark = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
        if ([bar isKindOfClass:[UIView class]]) bar.backgroundColor = dark ? [UIColor colorWithWhite:0.19 alpha:1.0] : [UIColor colorWithWhite:0.91 alpha:1.0];
        if ([bar isKindOfClass:[UIView class]]) [DMMWResizeCatchUp watchTitleBar:bar];
        if ([label isKindOfClass:[UIView class]]) { label.hidden = YES; label.alpha = 0.0; }
    } @catch (id e) {}
    NSArray *names = @[@"closeButton", @"minButton", @"maxButton"];
    NSMutableArray *mwButtons = [NSMutableArray array], *mwDots = [NSMutableArray array];
    for (int i = 0; i < 3; i++) {
        UIButton *b = nil;
        @try { b = [w valueForKey:names[i]]; } @catch (id e) {}
        if (![b isKindOfClass:[UIButton class]]) continue;
        UIView *dot = objc_getAssociatedObject(b, kMWDotKey);
        if (!dot) {
            dot = DMMakeLightDot(i, NO, NULL);
            [b addSubview:dot];
            objc_setAssociatedObject(b, kMWDotKey, dot, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (i == 0 && !objc_getAssociatedObject(b, kMWRedKey)) {   // red is a force quit, like on the status bar
            objc_setAssociatedObject(b, kMWRedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [b removeTarget:nil action:NULL forControlEvents:UIControlEventTouchUpInside];
            __weak AXWindowView *weakWindow = w;
            [b addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { NSString *bid = [weakWindow bundleIdentifier]; if (bid.length) DMForceQuitBundle(bid); }] forControlEvents:UIControlEventTouchUpInside];
        }
        b.backgroundColor = [UIColor clearColor];
        b.layer.cornerRadius = 0.0;
        CGFloat barHeight = b.superview.bounds.size.height;
        BOOL atDefault = fabs(b.frame.size.width - 16.0) < 0.5 && (fabs(b.frame.origin.x - (4.0 + 24.0 * i)) < 0.5);
        if (atDefault && barHeight > 8.0) b.frame = CGRectMake(4.0 + kLightCell * i, 0, kLightCell, barHeight);
        dot.center = CGPointMake(b.bounds.size.width / 2.0, b.bounds.size.height / 2.0);
        [b bringSubviewToFront:dot];
        [mwButtons addObject:b]; [mwDots addObject:dot];
    }
    if (mwButtons.count) {   // (grey on an inactive window, symbols on hover or press)
        __weak AXWindowView *weakW = w;
        DMLightGroupAttach(((UIView *)mwButtons.firstObject).superview, mwButtons, mwDots, ^NSString *{ return [weakW bundleIdentifier]; });
    }
    // MilkyWay resizes a window from a single named handle, "sizeChanger" (confirmed by reading it live via valueForKey: —
    // this project already drives it in DMFakeResize/DMKeepFit, so its existence and name are established fact, not a guess).
    // The grip is added as ITS subview, in the corner of the handle's OWN bounds nearest the window's bottom-right, so it
    // lands correctly whether "sizeChanger" turns out to be a small corner box or a full-height edge strip — either way its
    // own bottom-right corner sits at the window's bottom-right resize corner.
    @try {
        UIView *sizeChanger = [w valueForKey:@"sizeChanger"];
        if ([sizeChanger isKindOfClass:[UIView class]] && sizeChanger.bounds.size.width > 1.0 && sizeChanger.bounds.size.height > 1.0) {
            UIView *grip = objc_getAssociatedObject(sizeChanger, kMWGripKey);
            if (!grip) {
                grip = DMMakeResizeGrip();
                [sizeChanger addSubview:grip];
                objc_setAssociatedObject(sizeChanger, kMWGripKey, grip, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            // MilkyWay4 puts its resize handle as a grey button at the RIGHT END OF THE TITLE BAR, though it resizes like a bottom-right corner
            // (width follows the finger's x, height its y; measured live, M1 pipeline task 5). For the same look as our Aerial 3.0 theme it is
            // moved to the window's bottom-right corner as a 32 pt clear box with our grip 12 pt in from the corner -- where a macOS window is
            // resized -- and kept there after MilkyWay's own layout passes (this runs after each of them).
            if (sizeChanger.superview != w) { [sizeChanger removeFromSuperview]; [w addSubview:sizeChanger]; }
            CGRect cf = CGRectMake(w.bounds.size.width - 32.0, w.bounds.size.height - 32.0, 32.0, 32.0);
            if (!CGRectEqualToRect(sizeChanger.frame, cf)) sizeChanger.frame = cf;
            sizeChanger.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleTopMargin;
            if (sizeChanger.backgroundColor && ![sizeChanger.backgroundColor isEqual:[UIColor clearColor]]) sizeChanger.backgroundColor = [UIColor clearColor];
            for (UIView *sub in sizeChanger.subviews) if (sub != grip && !sub.hidden) sub.hidden = YES;   // (MilkyWay's own diagonal bar)
            [w bringSubviewToFront:sizeChanger];
            // The box is clear, and the render server sends a touch on a clear layer to whatever is drawn under it: the app's own
            // content. Only the drawn grip and the window's rounded corner reached SpringBoard, so a drag started 18-22 pt in (between
            // them, right where the grip is drawn) went to the app and did nothing (M1, injected drags). Opaque for hit-testing, the
            // whole box takes the touch; nothing is drawn.
            SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
            if ([sizeChanger.layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(sizeChanger.layer, opaque, YES);
            [DMMWResizeCatchUp watch:sizeChanger];
            grip.hidden = sizeChanger.hidden;
            grip.backgroundColor = DMResizeGripColorFor([w bundleIdentifier], darkStyle);
            grip.transform = CGAffineTransformMakeRotation(M_PI_4);   // "\" — points into the bottom-right corner
            grip.center = CGPointMake(32.0 - kMilkyWayCorner, 32.0 - kMilkyWayCorner);   // 12 pt in from the corner, like Aerial 3.0
            [sizeChanger bringSubviewToFront:grip];
        }
    } @catch (id e) {}
}

// ==== Zetsu window styling: the same macOS-window look as MilkyWay's, ported over ====
// Zetsu's own title bar (ZetsuMenu) and bottom bar (ZetsuToolbar) come tinted per app (blue for some apps, cream for others -- seen live,
// not a guess) instead of a plain dark/light system bar, and its 4 buttons (close/mini/rotate/kill, confirmed via classearch on a live
// instance) are plain icon buttons, not traffic lights. This gives it the same rounded window, hairline border, neutral title-bar colour and
// red/yellow dots that MilkyWay's own windows already have (DMRestyleWindowButtons above). Zetsu's 4 actions do not map onto exactly 3
// lights the way MilkyWay's close/min/max do: close_menu and mini_menu are the two that read as "close" and "minimize", so those get the red
// and yellow dots (the same colours/behaviour as everywhere else in this file); rotate_menu and killapp_menu are left as plain buttons --
// forcing a fake green "maximize" onto an action that does not mean that would be more confusing than leaving it alone, not less. Purely
// cosmetic + one behaviour change (red re-targeted to our own force quit, matching MilkyWay's own red button): no alloc/init of anything
// Zetsu owns, only styling and retargeting buttons it already created.
static const void *kZetsuDotKey = &kZetsuDotKey, *kZetsuRedKey = &kZetsuRedKey;
static void DMRestyleZetsuWindow(UIWindow *w) {
    BOOL darkStyle = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
    UIColor *barColor = darkStyle ? [UIColor colorWithWhite:0.19 alpha:1.0] : [UIColor colorWithWhite:0.91 alpha:1.0];
    w.layer.cornerRadius = kMilkyWayCorner;
    w.layer.cornerCurve = kCACornerCurveContinuous;
    w.layer.masksToBounds = YES;
    w.layer.borderWidth = 0.5;
    w.layer.borderColor = (darkStyle ? [UIColor colorWithWhite:1.0 alpha:0.16] : [UIColor colorWithWhite:0.0 alpha:0.14]).CGColor;
    id appCtl = nil; @try { appCtl = [w valueForKey:@"ZetsuApp"]; } @catch (id e) {}
    UIView *menu = nil, *toolbar = nil;
    @try { menu = [appCtl valueForKey:@"menu"]; toolbar = [appCtl valueForKey:@"toolbar"]; } @catch (id e) {}
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[zetsu-style] restyle: window %@ appCtl %@ menu %@ toolbar %@", w, appCtl, menu, toolbar]);
    if ([menu isKindOfClass:[UIView class]]) menu.backgroundColor = barColor;
    // Zetsu's own long-press menu on its title bar ("Options": Split Mode, a scale slider) is taken off. It duplicates or fights our window controls
    // (Fit, sizes, the Window menu), and it cannot be made safe from outside: when Zetsu closes a window (its app quit or crashed, or its own close)
    // with that menu up, it takes the menu's views out of the window BEFORE replacing the window's root view controller, so UIKit's dismissal found
    // no window (the iPad 2 00:50 Safe Mode; reproduced 2026-09-25 02:56 by quitting Safari with the menu up -- only PreviewTargetGuard saved it).
    // Only the interaction object is removed from Zetsu's view (nothing of Zetsu's is hooked or called); the title bar's tap still works.
    if ([menu isKindOfClass:[UIView class]] && !DMTestFlag("/tmp/msb-zetsu-keepmenu")) {
        for (id<UIInteraction> i in [menu.interactions copy]) {
            if (![(NSObject *)i isKindOfClass:[UIContextMenuInteraction class]]) continue;
            [menu removeInteraction:i];
            static int told = 0; if (told++ < 10) DMLog([NSString stringWithFormat:@"[zetsu-style] %@: Zetsu's title-bar long-press menu taken off", DMZetsuWindowBundle(w)]);
        }
    }
    if (![toolbar isKindOfClass:[UIView class]]) return;
    toolbar.backgroundColor = barColor;
    NSString *bundleID = nil;
    @try { bundleID = [w valueForKey:@"_app_id"]; } @catch (id e) {}
    NSArray *names = @[@"close_menu", @"mini_menu"];
    NSMutableArray *zButtons = [NSMutableArray array], *zDots = [NSMutableArray array];
    for (int i = 0; i < 2; i++) {
        UIButton *b = nil;
        @try { b = [toolbar valueForKey:names[i]]; } @catch (id e) {}
        if (![b isKindOfClass:[UIButton class]]) continue;
        UIImageView *existingGlyph = nil;
        for (UIView *sub in b.subviews) if ([sub isKindOfClass:[UIImageView class]]) existingGlyph = (UIImageView *)sub;
        if (existingGlyph) existingGlyph.hidden = YES;   // Zetsu's own glyph stays in the view (in case restyling is ever turned off), just hidden under our dot
        UIView *dot = objc_getAssociatedObject(b, kZetsuDotKey);
        if (!dot) {
            dot = DMMakeLightDot(i, NO, NULL);
            dot.userInteractionEnabled = NO;
            [b addSubview:dot];
            objc_setAssociatedObject(b, kZetsuDotKey, dot, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (i == 0 && !objc_getAssociatedObject(b, kZetsuRedKey) && bundleID.length) {   // red = force quit, same convention as MilkyWay's red button
            objc_setAssociatedObject(b, kZetsuRedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [b removeTarget:nil action:NULL forControlEvents:UIControlEventTouchUpInside];
            NSString *bid = bundleID;
            [b addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMForceQuitBundle(bid); }] forControlEvents:UIControlEventTouchUpInside];
        }
        dot.center = CGPointMake(b.bounds.size.width / 2.0, b.bounds.size.height / 2.0);
        [b bringSubviewToFront:dot];
        [zButtons addObject:b]; [zDots addObject:dot];
    }
    if (zButtons.count) {   // (grey on an inactive window, symbols on hover or press)
        NSString *zBid = bundleID;
        DMLightGroupAttach(((UIView *)zButtons.firstObject).superview, zButtons, zDots, zBid.length ? ^NSString *{ return zBid; } : nil);
    }
}
// Applies the restyle whenever a Zetsu window is created or its content updates (both real, existing ZetsuAppController methods, confirmed
// via methsearch on a live instance) -- runs on the window the controller already owns, never alloc/inits anything of Zetsu's.
// Same lazy-class problem as MilkyWay/Aerial (see DMTryHookMilkyWay below, and EthernetFix.x's own writeup of the identical issue):
// ZetsuAppController is not necessarily registered yet at THIS dylib's %ctor time (Zetsu's own dylib may still be loading), so a plain
// %hook here would %init against a class that does not exist yet and silently hook nothing, forever. Fixed with the same named-group +
// poll pattern as MilkyWay's own hook (DMTryHookZetsu below installs it once the class exists) -- confirmed the group itself now installs
// correctly (logged live). What did NOT work, tried first: hooking ZetsuAppController's own -viewDidLoad/-update -- neither ever fired
// even after a real window opened and the group was confirmed installed, meaning Zetsu's real window-creation path does not go through
// the standard UIViewController -loadView/-viewDidLoad machinery at all (its content is built and assigned directly, self.view is
// apparently never actually touched by Zetsu's own code). Switched to the same technique already proven for AerialStage elsewhere in
// this file: -didAddSubview: on the WINDOW itself, a plain UIView/UIWindow method guaranteed to fire whenever ANY subview is added by
// anyone, Zetsu's own internal construction included -- does not depend on Zetsu using any particular lifecycle convention.
%group ZetsuStyle
@interface ZetsuWindow : UIWindow
@end
%hook ZetsuWindow
- (void)didAddSubview:(UIView *)subview {
    %orig;
    // Only a DIRECT subview of the window triggers this (its own root content view, added once) -- the menu/toolbar this actually styles
    // are nested deeper (window > root view > stack view > menu/host/toolbar) and may not be wired up on the window's own `ZetsuApp` ivar
    // yet at this exact moment, so one immediate try plus a couple of short delayed retries (same shape as DMEnlargeNewWindow's own
    // retry below, for the identical "the real content isn't fully assembled the instant a window/subview first appears" reason).
    __weak UIWindow *weakSelf = (UIWindow *)self;
    DMRestyleZetsuWindow((UIWindow *)self);
    DMZetsuAdopt((UIWindow *)self);   // Zetsu is the window engine: size, place and front order right away, before its default size is ever seen
    for (NSNumber *ms in @[@100, @300, @700]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms.intValue * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ UIWindow *w = weakSelf; if (w) { DMRestyleZetsuWindow(w); DMZetsuAdopt(w); } });
}
%end
%end   // ZetsuStyle group
static BOOL gZetsuHooked = NO;
// Zetsu's own items in the app icons' Haptic Touch menus ("Window" and "Split View") are taken out while Zetsu is our engine: opening an app in a
// window is ours (Open Apps as Windows, the Window menu, the Dock), and it goes through Zetsu's in-process "ZetsuSwitcher" notification
// (DMZetsuLaunch), never through these items. Zetsu puts them straight into the menu (they are UIActions, not shortcut items), so they are
// recognised by where their handler's code lives (Zetsu.dylib; checked live with iconmenu_ on the iPad 2), which works in every language.
// The menu's action provider is wrapped, on SpringBoard's own configuration object. This hook is installed only after Zetsu's (Zetsu.dylib
// loads after ours), so it wraps Zetsu's. With another engine nothing is removed.
// For a full-screen-only app (DMAppNeedsFullScreen), the window items the other engines put there (their handlers live in Aerial's or MilkyWay's
// dylib) are shown greyed out instead: that app never opens in a window.
static const char *DMMenuActionImage(UIMenuElement *el) {   // the file name of the image the action's handler code lives in ("Zetsu.dylib"), or NULL
    if (![el isKindOfClass:[UIAction class]]) return NULL;
    id h = nil; @try { h = [el valueForKey:@"handler"]; } @catch (id e) {}
    if (!h) return NULL;
    struct { void *isa; int flags; int reserved; void *invoke; } *blk = (__bridge void *)h;
    Dl_info di;
    if (!blk->invoke || !dladdr(blk->invoke, &di) || !di.dli_fname) return NULL;
    const char *slash = strrchr(di.dli_fname, '/');
    return slash ? slash + 1 : di.dli_fname;
}
static UIMenu *DMMenuEngineItems(UIMenu *m, BOOL dropZetsu, BOOL greyEngines) {
    NSMutableArray<UIMenuElement *> *kept = [NSMutableArray array];
    BOOL changed = NO;
    for (UIMenuElement *el in m.children) {
        if ([el isKindOfClass:[UIMenu class]]) {
            UIMenu *sub = DMMenuEngineItems((UIMenu *)el, dropZetsu, greyEngines);
            if (sub != el) changed = YES;
            if (sub.children.count || !((UIMenu *)el).children.count) [kept addObject:sub]; else changed = YES;   // (a group left empty goes)
            continue;
        }
        const char *img = DMMenuActionImage(el);
        BOOL zetsu = img && strcmp(img, "Zetsu.dylib") == 0;
        BOOL engine = img && (zetsu || strncmp(img, "Aerial", 6) == 0 || strncmp(img, "MilkyWay", 8) == 0);
        if (zetsu && dropZetsu) { changed = YES; continue; }
        if (engine && greyEngines && !(((UIAction *)el).attributes & UIMenuElementAttributesDisabled)) {
            UIAction *a = [(UIAction *)el copy];
            a.attributes |= UIMenuElementAttributesDisabled;
            [kept addObject:a]; changed = YES; continue;
        }
        [kept addObject:el];
    }
    return changed ? [m menuByReplacingChildren:kept] : m;
}
static const void *kZetsuMenuWrappedKey = &kZetsuMenuWrappedKey;
static CFTimeInterval gCtxAskedAt = 0;   // (debug: when the last icon menu was asked for, for [ctxperf])
%group ZetsuIconItems
%hook SBIconView
- (id)contextMenuInteraction:(id)interaction configurationForMenuAtLocation:(CGPoint)location {
    CFTimeInterval t0 = CACurrentMediaTime();
    id cfg = %orig;
    if (DMTestFlag("/tmp/macstatusbar-debug")) { gCtxAskedAt = t0; DMLog([NSString stringWithFormat:@"[ctxperf] menu asked (the configuration took %.0f ms)", (CACurrentMediaTime() - t0) * 1000.0]); }
    BOOL dropZetsu = DMActiveEngine() == DMEngineZetsu && !DMTestFlag("/tmp/msb-zetsu-keepitems");
    NSString *bid = nil; @try { bid = [[self valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {}
    BOOL greyEngines = [bid isKindOfClass:[NSString class]] && DMAppNeedsFullScreen(bid);
    if (!cfg || (!dropZetsu && !greyEngines) || objc_getAssociatedObject(cfg, kZetsuMenuWrappedKey)) return cfg;
    UIContextMenuActionProvider provider = nil; @try { provider = [cfg valueForKey:@"actionProvider"]; } @catch (id e) {}
    if (!provider) return cfg;
    UIContextMenuActionProvider wrapped = ^UIMenu *(NSArray<UIMenuElement *> *suggested) {
        UIMenu *m = provider(suggested);
        return m ? DMMenuEngineItems(m, dropZetsu, greyEngines) : m;
    };
    @try { [cfg setValue:wrapped forKey:@"actionProvider"]; objc_setAssociatedObject(cfg, kZetsuMenuWrappedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); } @catch (id e) {}
    return cfg;
}
%end
%end
static void DMInstallIconMenuFilter(void) {   // (3 s after SpringBoard starts, so it wraps the engines' own hooks of this method)
    static BOOL done; if (done) return; done = YES;
    %init(ZetsuIconItems);
}
// The Settings shrink (see DMZetsuFixBeforeCommit): Zetsu re-scales a window's app picture from a tight loop -- after a touch in the window it asks
// SpringBoard to launch the app every ~15 ms for about a quarter of a second, and each round sends the full-screen frame and sets the picture's view
// (a plain UIView under ZetsuHost, sometimes a new one) back to 768 x 1024 scaled into the window. SpringBoard's own scene updates in that loop commit
// Core Animation transactions of their own, so a fix made at the next commit could come one commit too late. So the picture's view is given a
// subclass (no ivars: only these setters) the moment it is added under a ZetsuHost, and while its window is flexed a scale or a full-screen size
// is simply not taken: the view keeps the window's size, 1:1. Unflexed windows (and every other view) behave exactly as before.
// Kill switch: /tmp/msb-zetsu-nocontentlock.
@interface DMZetsuContentView : UIView
@end
static BOOL DMZetsuContentFlexed(UIView *v, CGSize *hostSize) {
    UIView *host = v.superview;
    UIWindow *w = host.window;
    if (!host || !w || host.subviews.firstObject != v) return NO;
    NSString *b = DMZetsuWindowBundle(w);
    if (!b.length || !gZetsuFlexFrames[b] || DMStageMinimized(w) || [objc_getAssociatedObject(w, kStageClosingKey) boolValue]) return NO;
    if (DMTestFlag("/tmp/msb-zetsu-nocontentlock")) return NO;
    CGSize hs = host.bounds.size;
    if (hs.width < 20.0 || hs.height < 20.0) return NO;
    if (hostSize) *hostSize = hs;
    return YES;
}
static void DMZetsuContentRefused(UIView *v, NSString *what) {
    static CFTimeInterval lastLog = 0; static int n = 0;
    n++;
    if (CACurrentMediaTime() - lastLog > 10.0 || DMTestFlag("/tmp/msb-zflexlog")) {
        lastLog = CACurrentMediaTime();
        DMLog([NSString stringWithFormat:@"[zflex] %@: Zetsu's %@ of the app picture not taken (the window is flexed; %d so far)", DMZetsuWindowBundle(v.window), what, n]);
    }
}
@implementation DMZetsuContentView
- (void)setTransform:(CGAffineTransform)t {
    if (!CGAffineTransformIsIdentity(t) && DMZetsuContentFlexed(self, NULL)) { DMZetsuContentRefused(self, @"scale"); t = CGAffineTransformIdentity; }
    [super setTransform:t];
}
- (void)setBounds:(CGRect)b {
    CGSize hs;
    if (DMZetsuContentFlexed(self, &hs) && (fabs(b.size.width - hs.width) > 0.5 || fabs(b.size.height - hs.height) > 0.5)) { DMZetsuContentRefused(self, @"full-screen size"); b = CGRectMake(b.origin.x, b.origin.y, hs.width, hs.height); }
    [super setBounds:b];
}
- (void)setCenter:(CGPoint)c {
    CGSize hs;
    if (DMZetsuContentFlexed(self, &hs) && (fabs(c.x - hs.width / 2.0) > 0.5 || fabs(c.y - hs.height / 2.0) > 0.5)) c = CGPointMake(hs.width / 2.0, hs.height / 2.0);
    [super setCenter:c];
}
@end
static void DMZetsuAdoptContent(UIView *host, UIView *v) {
    if (!v || object_getClass(v) != [UIView class] || DMTestFlag("/tmp/msb-zetsu-nocontentlock")) return;   // (only Zetsu's plain picture view; never a view of another class)
    object_setClass(v, [DMZetsuContentView class]);
    CGSize hs;
    if (DMZetsuContentFlexed(v, &hs) && (!CGAffineTransformIsIdentity(v.transform) || fabs(v.bounds.size.width - hs.width) > 0.5 || fabs(v.bounds.size.height - hs.height) > 0.5)) {
        [UIView performWithoutAnimation:^{ v.transform = CGAffineTransformIdentity; v.bounds = CGRectMake(0, 0, hs.width, hs.height); v.center = CGPointMake(hs.width / 2.0, hs.height / 2.0); }];
        DMZetsuContentRefused(v, @"scale (as it was added)");
    }
    if (DMZetsuContentFlexed(v, NULL)) DMZetsuFitLayerHosts(v);
}
%group ZetsuHostContent
@interface ZetsuHost : UIView
@end
%hook ZetsuHost
- (void)didAddSubview:(UIView *)subview {
    %orig;
    @try { DMZetsuAdoptContent((UIView *)self, subview); } @catch (NSException *e) { static int told = 0; if (told++ < 3) DMLog([NSString stringWithFormat:@"[zflex] adopting the app picture view: exception %@", e.reason]); }
}
%end
%end
// The on-screen keyboard in a Zetsu window, moved out the moment Zetsu puts it in (hand test, iPad 2, 2026-09-26: typing in Notes, the
// keyboard kept shrinking, vanishing and coming back, most in portrait). Every touch in a Zetsu window makes Zetsu lay it out again, and each
// time it makes a NEW keyboard host inside the window (clipped to the window: the "shrink"); the 0.2 s tick then moved it out -- up to 0.2 s
// of a cut or missing keyboard per keystroke. Now the host is moved out as soon as it arrives in a ZetsuWindow, before it is drawn; the tick
// stays as the backstop. Same kill switch as the tick (/tmp/msb-zkb-off, inside DMZetsuKeyboardOut).
%group ZetsuKeyboardHost
%hook _UIKeyboardLayerHostView
- (void)didMoveToWindow {
    %orig;
    static BOOL busy = NO;   // (moving it calls this again, for the keyboard window)
    UIWindow *w = ((UIView *)self).window;
    if (busy || !w || ![NSStringFromClass([w class]) isEqualToString:@"ZetsuWindow"]) return;
    busy = YES;
    DMZetsuKeyboardOut(@"at once");
    busy = NO;
}
%end
%end
static void DMTryHookZetsu(int attempt) {
    if (gZetsuHooked) return;
    if (objc_getClass("ZetsuWindow")) {
        gZetsuHooked = YES;
        %init(ZetsuStyle);
        DMLog(@"[zetsu-style] ZetsuWindow hook installed");
        if (objc_getClass("_UIKeyboardLayerHostView")) { %init(ZetsuKeyboardHost); DMLog(@"[zetsu] keyboard host hook installed (moved out at once)"); }
        if (objc_getClass("ZetsuHost") && class_getInstanceMethod(objc_getClass("ZetsuHost"), @selector(didAddSubview:))) { %init(ZetsuHostContent); DMLog(@"[zflex] ZetsuHost hook installed (the app picture keeps the window's size)"); }
        return;
    }
    if (attempt < 15) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMTryHookZetsu(attempt + 1); });
}

// ==== Aerial stage styling: the same look as our MilkyWay windows ====
// A rounded window with a hairline border, a title bar (dark or light with the system appearance) holding the traffic lights and Aerial's
// "..." menu, and the app filling the rest edge to edge. Aerial re-lays out its stage views itself, so this runs after every one of its
// layouts. The app's size is committed with Aerial's own scene-frame call whenever the visible content area changes size.
static const CGFloat kStageBarHeight = 24.0;
static const void *kStageBarKey = &kStageBarKey;
static const void *kStageLightsKey = &kStageLightsKey;
static const void *kStageCommitKey = &kStageCommitKey;
static const void *kStageGripBLKey = &kStageGripBLKey;
static const void *kStageGripBRKey = &kStageGripBRKey;
static void DMAerialToFullScreen(UIView *stage);
static UIView *DMStageInnerView(UIView *stage);
@interface DMStageRecorder : NSObject
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval start, until;
@property (nonatomic, strong) NSMutableDictionary *last;
@end
@implementation DMStageRecorder
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval now = CACurrentMediaTime();
    if (now > self.until) { [l invalidate]; DMLog(@"[rec] done"); return; }
    for (UIView *s in DMAerialStages()) {
        CALayer *pl = s.layer.presentationLayer ?: s.layer;
        UIView *in = DMStageInnerView(s);
        CALayer *il = in.layer.presentationLayer ?: in.layer;
        NSString *line = [NSString stringWithFormat:@"%@ frame %@ inner %@ alpha %.2f hidden %d radius %.1f level %.1f", DMStageBundle(s), NSStringFromCGRect(pl.frame), NSStringFromCGRect(il.frame), pl.opacity, s.hidden, pl.cornerRadius, DMAerialWindow().windowLevel];
        NSString *key = DMStageBundle(s) ?: @"?";
        if (![self.last[key] isEqualToString:line]) { self.last[key] = line; DMLog([NSString stringWithFormat:@"[rec %4.0f ms] %@", (now - self.start) * 1000.0, line]); }
    }
}
@end
@interface DMBrightnessWatcher : NSObject
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval start, until;
@end
@implementation DMBrightnessWatcher
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval now = CACurrentMediaTime();
    if (now > self.until) { [l invalidate]; DMLog(@"[flash] done"); return; }
    UIView *snap = [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO];
    UIWindow *host = DMStatusBarWindow();
    if (!snap || !host) return;
    [host addSubview:snap];
    const int W = 12, H = 9;
    uint8_t buf[W * H * 4]; memset(buf, 0, sizeof buf);
    CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
    CGContextRef ctx = CGBitmapContextCreate(buf, W, H, 8, W * 4, cs, kCGImageAlphaPremultipliedLast);
    CGContextScaleCTM(ctx, (CGFloat)W / snap.bounds.size.width, (CGFloat)H / snap.bounds.size.height);
    CGContextTranslateCTM(ctx, 0, snap.bounds.size.height); CGContextScaleCTM(ctx, 1, -1);
    UIGraphicsPushContext(ctx);
    [snap drawViewHierarchyInRect:snap.bounds afterScreenUpdates:YES];
    UIGraphicsPopContext();
    CGContextRelease(ctx); CGColorSpaceRelease(cs);
    [snap removeFromSuperview];
    double sum = 0; NSMutableString *grid = [NSMutableString string];
    for (int y = 0; y < H; y++) for (int x = 0; x < W; x++) {
        uint8_t *px = buf + (y * W + x) * 4; double lum = (px[0] + px[1] + px[2]) / 3.0; sum += lum;
        if (y % 3 == 1 && x % 3 == 1) [grid appendFormat:@" %3.0f", lum];
    }
    DMLog([NSString stringWithFormat:@"[flash %4.0f ms] mean %5.1f  grid%@", (now - self.start) * 1000.0, sum / (W * H), grid]);
}
@end
static DMBrightnessWatcher *gBrightness;
static void DMWatchBrightness(double seconds) {
    gBrightness = [DMBrightnessWatcher new];
    gBrightness.start = CACurrentMediaTime(); gBrightness.until = gBrightness.start + seconds;
    gBrightness.link = [CADisplayLink displayLinkWithTarget:gBrightness selector:@selector(tick:)];
    gBrightness.link.preferredFramesPerSecond = 30;
    [gBrightness.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[flash] start");
}
static DMStageRecorder *gRecorder;
static void DMRecordStages(double seconds) {
    gRecorder = [DMStageRecorder new];
    gRecorder.start = CACurrentMediaTime(); gRecorder.until = gRecorder.start + seconds; gRecorder.last = [NSMutableDictionary dictionary];
    gRecorder.link = [CADisplayLink displayLinkWithTarget:gRecorder selector:@selector(tick:)];
    [gRecorder.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[rec] start");
}
// Debug (dockrec_<seconds>): on every display frame, what the Dock's recents section (SBDockSuggestionsIconListView) shows -- each icon view's app,
// its on-screen opacity (presentation layer) and hidden flag, and the list model's icon count -- logged whenever it changes.
@interface DMDockRecentsRecorder : NSObject
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval start, until;
@property (nonatomic, copy) NSString *last;
@end
static DMDockRecentsRecorder *gDockRecRecorder;
@implementation DMDockRecentsRecorder
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval t = CACurrentMediaTime();
    if (t > self.until) { [l invalidate]; gDockRecRecorder = nil; DMLog(@"[dockrec] done"); return; }
    NSMutableArray *todo = [NSMutableArray array];
    for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:NO]) if ([NSStringFromClass([w class]) containsString:@"FloatingDock"]) [todo addObject:w];
    NSMutableString *s = [NSMutableString string];
    while (todo.count) {
        UIView *v = todo.lastObject; [todo removeLastObject];
        if ([NSStringFromClass([v class]) isEqualToString:@"SBDockSuggestionsIconListView"]) {
            NSString *cnt = @"?"; @try { cnt = [[[v valueForKey:@"model"] valueForKey:@"numberOfIcons"] description]; } @catch (id e) {}
            [s appendFormat:@"list %p model %@ alpha %.2f:", v, cnt, v.layer.presentationLayer ? v.layer.presentationLayer.opacity : v.alpha];
            NSArray *subs = [v.subviews sortedArrayUsingComparator:^NSComparisonResult(UIView *a, UIView *b) { return a.frame.origin.x < b.frame.origin.x ? NSOrderedAscending : (a.frame.origin.x > b.frame.origin.x ? NSOrderedDescending : NSOrderedSame); }];
            for (UIView *iv in subs) {
                if (![NSStringFromClass([iv class]) containsString:@"IconView"]) continue;
                NSString *b = nil; @try { id icon = [iv valueForKey:@"icon"]; b = [icon respondsToSelector:NSSelectorFromString(@"applicationBundleID")] ? [icon valueForKey:@"applicationBundleID"] : NSStringFromClass([icon class]); } @catch (id e) {}
                CALayer *p = iv.layer.presentationLayer ?: iv.layer;
                [s appendFormat:@" [%@ x%.0f op %.2f%@]", [b componentsSeparatedByString:@"."].lastObject ?: @"?", p.frame.origin.x, p.opacity, iv.hidden ? @" HIDDEN" : @""];
            }
            // the suggestions model behind it (found through the list's view controller): the recents it shows, SpringBoard's recents list, the suggestion
            id model = nil, vc = nil;
            for (UIResponder *r = v.nextResponder; r && !model; r = r.nextResponder) if ([r respondsToSelector:NSSelectorFromString(@"suggestionsModel")]) { vc = r; model = [r valueForKey:@"suggestionsModel"]; }
            @try {
                SEL onHome = NSSelectorFromString(@"_onHomescreen");
                [s appendFormat:@" || vc deferred %lu onHome %d visible %@ mode %@", (unsigned long)[[vc valueForKey:@"deferredIconUpdates"] count],
                    [vc respondsToSelector:onHome] ? ((BOOL (*)(id, SEL))objc_msgSend)(vc, onHome) : -1, [vc valueForKey:@"visible"], [vc valueForKey:@"effectiveEnvironmentMode"]];
            } @catch (NSException *e) { [s appendFormat:@" || vc %@", e.reason]; }
            NSString *(^ids)(id) = ^NSString *(id items) {
                NSMutableArray *o = [NSMutableArray array];
                for (id it in items) { NSString *b = [it respondsToSelector:NSSelectorFromString(@"bundleIdentifier")] ? [it valueForKey:@"bundleIdentifier"] : [it description]; [o addObject:[b componentsSeparatedByString:@"."].lastObject ?: @"?"]; }
                return [o componentsJoinedByString:@","];
            };
            @try {
                [s appendFormat:@" || model max %@ shown(%@) recents(%@) all(%@) sugg %@", [model valueForKey:@"maxSuggestions"], ids([model valueForKey:@"currentDisplayItems"]), ids([model valueForKey:@"currentRecentDisplayItems"]),
                    ids([model valueForKeyPath:@"recentsController.recentDisplayItems"]), [[[[model valueForKey:@"currentAppSuggestion"] description] componentsSeparatedByString:@"\n"] firstObject] ?: @"-"];
            } @catch (NSException *e) { [s appendFormat:@" || model %@: %@", model ? NSStringFromClass([model class]) : @"not found", e.reason]; }
            [s appendString:@" |"];
            continue;
        }
        [todo addObjectsFromArray:v.subviews];
    }
    if (![s isEqualToString:self.last]) { self.last = s; DMLog([NSString stringWithFormat:@"[dockrec %5.0f ms] %@", (t - self.start) * 1000.0, s]); }
}
@end
static void DMRecordDockRecents(double seconds) {
    gDockRecRecorder = [DMDockRecentsRecorder new];
    gDockRecRecorder.start = CACurrentMediaTime(); gDockRecRecorder.until = gDockRecRecorder.start + seconds;
    gDockRecRecorder.link = [CADisplayLink displayLinkWithTarget:gDockRecRecorder selector:@selector(tick:)];
    [gDockRecRecorder.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[dockrec] start");
}
// Debug: on every display frame, every big light-coloured view on the screen (in any window) that is showing; logged when it appears and when it goes,
// so a white flash during a window transition can be told apart (which view, how long).
@interface DMWhiteWatcher : NSObject
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval start, until;
@property (nonatomic, strong) NSMutableDictionary<NSString *, NSString *> *present;
@end
@implementation DMWhiteWatcher
- (void)walk:(UIView *)v window:(UIWindow *)w depth:(int)d into:(NSMutableDictionary *)now {
    if (v.hidden || v.alpha < 0.3 || d > 9) return;
    CGSize sz = v.bounds.size;
    if (sz.width * sz.height >= 30000.0) {
        CGFloat r = 0, g = 0, b = 0, a = 0; UIColor *bg = v.backgroundColor ?: (v.layer.backgroundColor ? [UIColor colorWithCGColor:v.layer.backgroundColor] : nil);
        if (bg && [bg getRed:&r green:&g blue:&b alpha:&a] && a > 0.5 && (r + g + b) / 3.0 > 0.85)
            now[[NSString stringWithFormat:@"%p", v]] = [NSString stringWithFormat:@"%@ (level %.0f) > %@ frame %@ alpha %.2f bg %.2f/%.2f/%.2f", NSStringFromClass([w class]), w.windowLevel, NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.alpha, r, g, b];
    }
    for (UIView *sub in v.subviews) [self walk:sub window:w depth:d + 1 into:now];
}
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval t = CACurrentMediaTime();
    if (t > self.until) { [l invalidate]; DMLog(@"[whitew] done"); return; }
    NSMutableDictionary *now = [NSMutableDictionary dictionary];
    for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES]) [self walk:w window:w depth:0 into:now];
    for (NSString *k in now) if (!self.present[k]) DMLog([NSString stringWithFormat:@"[whitew %4.0f ms] appears: %@", (t - self.start) * 1000.0, now[k]]);
    for (NSString *k in self.present) if (!now[k]) DMLog([NSString stringWithFormat:@"[whitew %4.0f ms] gone: %@", (t - self.start) * 1000.0, self.present[k]]);
    self.present = now;
}
@end
static DMWhiteWatcher *gWhiteWatcher;
static void DMWatchWhite(double seconds) {
    gWhiteWatcher = [DMWhiteWatcher new];
    gWhiteWatcher.start = CACurrentMediaTime(); gWhiteWatcher.until = gWhiteWatcher.start + seconds; gWhiteWatcher.present = [NSMutableDictionary dictionary];
    gWhiteWatcher.link = [CADisplayLink displayLinkWithTarget:gWhiteWatcher selector:@selector(tick:)];
    [gWhiteWatcher.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[whitew] start");
}
static const void *kStageClosingKey = &kStageClosingKey;   // the stage is on its way out: no more styling or size commits
// Gives an app the whole screen back. When a stage closes (any way) SpringBoard does not do this itself, so the app would stay at the
// stage's size (a small layout in the corner) even when opened full screen.
static void DMResetSceneFrameForBundle(NSString *bundleID) {
    if (!bundleID.length) return;
    id scene = nil;
    scene = DMSceneForBundle(bundleID);
    if (!scene) { DMLog([NSString stringWithFormat:@"[aerial] no scene known for %@, cannot give the screen back", bundleID]); return; }
    CGSize screen = [UIScreen mainScreen].bounds.size;
    CGRect before = CGRectZero; @try { before = ((CGRect (*)(id, SEL))objc_msgSend)([scene valueForKey:@"settings"], NSSelectorFromString(@"frame")); } @catch (id e) {}
    BOOL ok = DMSetSceneFrame(scene, CGRectMake(0, 0, MIN(screen.width, screen.height), MAX(screen.width, screen.height)));
    CGRect after = CGRectZero; @try { after = ((CGRect (*)(id, SEL))objc_msgSend)([scene valueForKey:@"settings"], NSSelectorFromString(@"frame")); } @catch (id e) {}
    DMLog([NSString stringWithFormat:@"[aerial] reset: scene frame %@ -> %@", NSStringFromCGRect(before), NSStringFromCGRect(after)]);
    DMLog([NSString stringWithFormat:@"[aerial] %@ given the full screen back (%@)", bundleID, ok ? @"sent" : @"FAILED"]);
}
// Green on a tiled window (Fit to Window) and back: the tiling it left is remembered, and when the app comes back as a window it takes its old tile
// again and the others go back to theirs (before, it came back on top of the window that had grown into its space: iPad 2, Aerial 3.0 and 5.0).
static void DMApplyGroupSlots(UIView *fresh);
static const void *kStageEnteringKey;
static NSString *gFSFitBundle; static NSArray<NSString *> *gFSFitGroup; static NSDictionary<NSString *, NSString *> *gFSFitSlots;
static void DMRememberFitForFullScreen(NSString *bundleID) {
    BOOL tiled = bundleID.length && [gFitGroup containsObject:bundleID];
    gFSFitBundle = tiled ? [bundleID copy] : nil; gFSFitGroup = tiled ? [gFitGroup copy] : nil; gFSFitSlots = tiled ? [gFitSlots copy] : nil;
}
static void DMFitForgetFullScreenTile(NSString *bundleID) {
    if (!bundleID.length || ![gFSFitBundle isEqualToString:bundleID]) return;
    gFSFitBundle = nil; gFSFitGroup = nil; gFSFitSlots = nil;
    DMLog([NSString stringWithFormat:@"[fit] %@ placed from the Window menu: it does not take back its tile from before full screen", bundleID]);
}
static void DMFitRejoinAfterFullScreen(NSString *bundleID) {
    if (!bundleID.length || ![gFSFitBundle isEqualToString:bundleID]) return;
    NSArray *old = gFSFitGroup; NSDictionary *oldSlots = gFSFitSlots;
    gFSFitBundle = nil; gFSFitGroup = nil; gFSFitSlots = nil;
    if (!DMFitEnabled()) return;
    NSMutableArray<NSString *> *g = [NSMutableArray array];
    for (NSString *b in old) if (DMStageTakesPartInFit(DMStageForBundle(b))) [g addObject:b];
    if (g.count < 2 || ![g containsObject:bundleID]) return;
    gFitGroup = g;
    if (g.count == old.count) gFitSlots = [oldSlots mutableCopy]; else DMAssignDefaultSlots();
    gMoveKeepsOrder = YES;
    UIView *back = DMStageForBundle(bundleID);
    BOOL flying = back && [objc_getAssociatedObject(back, kStageEnteringKey) boolValue];
    for (NSString *b in g) {   // the others move back into their tiles (the returning window is already flying into its own)
        UIView *st = DMStageForBundle(b); CGRect f = DMSlotFrame(b);
        if (!st || CGRectIsNull(f) || (flying && st == back)) continue;
        DMAerialMoveStage(st, f, nil);
    }
    gMoveKeepsOrder = NO;
    if (flying) {   // it was flying to where it was remembered; if that was not its tile (SofaScore's full-screen relaunch forgets it), it goes there now
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *st = DMStageForBundle(bundleID); CGRect f = DMSlotFrame(bundleID);
            if (!st || CGRectIsNull(f) || ![gFitGroup containsObject:bundleID]) return;
            if (fabs(f.origin.x - st.frame.origin.x) <= 1.0 && fabs(f.origin.y - st.frame.origin.y) <= 1.0 && fabs(f.size.width - st.frame.size.width) <= 1.0) return;
            DMLog([NSString stringWithFormat:@"[fit] %@ landed at %@, not in its tile: moved into it", bundleID, NSStringFromCGRect(st.frame)]);
            gMoveKeepsOrder = YES; DMAerialMoveStage(st, f, nil); gMoveKeepsOrder = NO;
        });
    }
    DMLog([NSString stringWithFormat:@"[fit] %@ is back from full screen: it takes its tile again (%lu windows tiled)", bundleID, (unsigned long)g.count]);
}
static void DMStageLightAction(UIView *stage, NSInteger which) {
    NSString *bundleID = DMStageBundle(stage);
    DMLog([NSString stringWithFormat:@"[aerial] stage light %ld for %@", (long)which, bundleID]);
    Class core = objc_getClass("AerialCore");
    if (which == 0) {   // red: a proper force quit (the window closes and the app is terminated)
        (void)core;
        DMForceQuitBundle(bundleID);
    } else if (which == 1) {
        DMMinimizeStage(stage);
    } else {
        DMRememberFitForFullScreen(bundleID);
        if (DMIsZetsuWindow(stage)) DMZetsuToFullScreen((UIWindow *)stage);
        else DMAerialToFullScreen(stage);
    }
}
@interface DMStageLights : UIView
@property (nonatomic, weak) UIView *stage;
@end
@implementation DMStageLights

- (instancetype)initWithStage:(UIView *)stage {
    if (!(self = [super initWithFrame:CGRectMake(0, 0, 3 * kLightCell, kStageBarHeight)])) return nil;
    self.stage = stage;
    for (NSInteger i = 0; i < 3; i++) {
        UIButton *b = [UIButton buttonWithType:UIButtonTypeCustom];
        b.tag = i;
        b.frame = CGRectMake(i * kLightCell, 0, kLightCell, kStageBarHeight);
        UIView *dot = DMMakeLightDot(i, NO, NULL);
        dot.center = CGPointMake(kLightCell / 2.0, kStageBarHeight / 2.0);
        [b addSubview:dot];
        b.pointerInteractionEnabled = YES;
        [b addTarget:self action:@selector(tapped:) forControlEvents:UIControlEventTouchUpInside];
        [self addSubview:b];
    }
    NSMutableArray *dots = [NSMutableArray array];
    for (UIButton *b in self.subviews) [dots addObject:b.subviews.firstObject];
    __weak UIView *weakStage = stage;   // (grey on an inactive window, symbols on hover or press)
    DMLightGroupAttach(self, self.subviews, dots, ^NSString *{ UIView *st = weakStage; return st ? DMStageBundle(st) : nil; });
    return self;
}
- (void)tapped:(UIButton *)b { if (self.stage) DMStageLightAction(self.stage, b.tag); }
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event { UIView *v = [super hitTest:point withEvent:event]; return v == self ? nil : v; }   // only the dots take touches
@end
static UIView *DMMakeStageLightsFor(UIView *stage) { return [[DMStageLights alloc] initWithStage:stage]; }
static UIView *DMStageInnerView(UIView *stage) {   // the clipped view holding the scene's layer host
    for (UIView *v in stage.subviews) {
        if (![NSStringFromClass([v class]) isEqualToString:@"UIView"]) continue;
        for (UIView *s in v.subviews) if ([NSStringFromClass([s class]) containsString:@"SceneLayerHost"]) return v;
    }
    return nil;
}
static const void *kStageVeilKey = &kStageVeilKey;
static const void *kStageInnerRetryKey = &kStageInnerRetryKey;
static const void *kStageVeilViewKey = &kStageVeilViewKey;
static const void *kStageIntentKey = &kStageIntentKey;
static const void *kStageEnteringKey = &kStageEnteringKey;   // the window is flying in from full screen: Aerial's own fade / scale-in is switched off
static BOOL gStageFrameBypass = NO;                          // our own frame changes pass the setFrame: guard
static const void *kStageDropKey = &kStageDropKey;
static BOOL gShowWindowButtons;   // the preference itself is set further down
// Where the status bar's traffic lights were last drawn (screen coordinates; the bar is upright), for the drop into a new window.
static CGRect gStatusLightsFrame = {{0, 0}, {0, 0}};
static CGFloat gStatusLightsDotY = 12.0;
static CFTimeInterval gStatusLightsTime = 0;
// A full-screen app becomes a window: the status bar's lights lift off from the bar and drop into the new window's title bar, where the
// window's own lights take over. A soft capsule behind them fades in on the way down and out on arrival.
static void DMDropLights(UIView *stage, UIView *realLights) {
    UIWindow *win = DMAerialWindow();
    if (!win || !gShowWindowButtons || gStatusLightsFrame.size.width < 1.0) { realLights.alpha = 1.0; return; }
    if (MSBReduceMotion()) {   // Reduce Motion: no flight from the status bar; the window's own lights fade in where they are
        [UIView animateWithDuration:kMSBRMDuration delay:0 options:UIViewAnimationOptionCurveEaseInOut animations:^{ realLights.alpha = 1.0; } completion:nil];
        return;
    }
    BOOL dark = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
    CGFloat w = 3 * kLightCell;
    CGRect from = CGRectMake(gStatusLightsFrame.origin.x, gStatusLightsDotY - kStageBarHeight / 2.0, w, kStageBarHeight);
    CGRect to = [stage convertRect:(realLights.superview == stage ? realLights.frame : CGRectMake(4.0, 0, w, kStageBarHeight)) toView:win];   // (where the window's own lights are)
    UIView *floater = [[UIView alloc] initWithFrame:from];
    floater.userInteractionEnabled = NO;
    UIView *capsule = [[UIView alloc] initWithFrame:CGRectMake(2.0, 2.0, w - 4.0, kStageBarHeight - 4.0)];
    capsule.layer.cornerRadius = (kStageBarHeight - 4.0) / 2.0;
    capsule.backgroundColor = dark ? [UIColor colorWithWhite:0.26 alpha:1.0] : [UIColor colorWithWhite:0.98 alpha:1.0];
    capsule.layer.shadowColor = [UIColor blackColor].CGColor;
    capsule.layer.shadowOpacity = 0.35; capsule.layer.shadowRadius = 5.0; capsule.layer.shadowOffset = CGSizeMake(0, 2);
    capsule.alpha = 0.0;
    [floater addSubview:capsule];
    for (NSInteger i = 0; i < 3; i++) {
        UIView *dot = DMMakeLightDot(i, YES, NULL);
        dot.center = CGPointMake(i * kLightCell + kLightCell / 2.0, kStageBarHeight / 2.0);
        [floater addSubview:dot];
    }
    [win addSubview:floater];
    DMLog(@"[aerial] traffic lights dropping from the status bar into the new window");
    [UIView animateWithDuration:0.5 delay:0 options:UIViewAnimationOptionCurveEaseOut animations:^{ capsule.alpha = 1.0; } completion:nil];
    [UIView animateWithDuration:0.62 delay:0 usingSpringWithDamping:0.7 initialSpringVelocity:0.0 options:0 animations:^{
        floater.frame = to;
    } completion:^(BOOL finished) {
        realLights.alpha = 1.0;
        [UIView animateWithDuration:0.18 delay:0 options:UIViewAnimationOptionCurveEaseOut animations:^{ floater.alpha = 0.0; }
                         completion:^(BOOL f) { [floater removeFromSuperview]; }];
    }];
}
// Turning a full-screen app into a window makes Aerial send the app's scene to the background and back (foreground NO, then YES); for a
// moment the app draws a blank white frame in its window. The veil hides the window's content until no scene updates have come in for
// a little while, then fades away.
static const void *kVeilRefitKey = &kVeilRefitKey;
static const void *kVeilQuickKey = &kVeilQuickKey;   // a window opened the ordinary way (not out of a full-screen app): the veil is short
// A cold-launching app may take the window's final size while its scene is still in the background and keep a slightly smaller layout,
// which leaves a white strip along the right and bottom edges. Once it has settled (the veil still covers the window) the size is sent
// again in two quick steps, 1 pt narrower and then exact, so the app always does one last layout at the true size.
static void DMRefitStageScene(UIView *stage) {
    // Apps that mishandle this quick size change: Reddit's Home pager lays its pages out for the SCREEN size on any size transition (it was told
    // 1193 x 834 while its window was 591 x 355, M1 27 Sep: the Home feed came up skewed, 592 x 592 at x -119.5 with no posts). Its window has the
    // right size from the start (the size is sent before the launch), so for these the re-send is left out.
    static NSSet<NSString *> *noRefit; if (!noRefit) noRefit = [NSSet setWithObjects:@"com.reddit.Reddit", nil];
    if ([noRefit containsObject:DMStageBundle(stage)] || DMTestFlag("/tmp/msb-norefit")) { DMLog([NSString stringWithFormat:@"[aerial] %@: re-fit left out", DMStageBundle(stage)]); return; }
    UIView *in = DMStageInnerView(stage);
    NSString *bundleID = DMStageBundle(stage);
    if (!in || !bundleID.length) return;
    CGRect r = [in convertRect:in.bounds toView:nil];
    Class core = objc_getClass("AerialCore");
    SEL apply = DMAerialSel(@"applySceneFrameForBundle:frame:");
    ((void (*)(id, SEL, id, CGRect))objc_msgSend)((id)core, apply, bundleID, CGRectMake(r.origin.x, r.origin.y, r.size.width - 1.0, r.size.height));
    __weak UIView *weakStage = stage;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *s = weakStage, *inner = s ? DMStageInnerView(s) : nil;
        if (!inner) return;
        CGRect exact = [inner convertRect:inner.bounds toView:nil];
        ((void (*)(id, SEL, id, CGRect))objc_msgSend)((id)core, apply, bundleID, exact);
        SEL fit = DMAerialSel(@"adjustContentScaleToHost");
        if ([s respondsToSelector:fit]) ((void (*)(id, SEL))objc_msgSend)(s, fit);
        DMLog([NSString stringWithFormat:@"[aerial] %@ re-fitted to %@ once settled", bundleID, NSStringFromCGRect(exact)]);
    });
}
static void DMVeilCheck(UIView *stage, UIView *veil, CFTimeInterval born) {
    if (!veil.superview) return;
    CFTimeInterval now = CACurrentMediaTime(), last = 0;
    NSString *bundleID = DMStageBundle(stage);
    for (NSString *sid in gSceneUpdateTime) if (bundleID.length && [sid containsString:bundleID]) last = MAX(last, gSceneUpdateTime[sid].doubleValue);
    BOOL quick = [objc_getAssociatedObject(veil, kVeilQuickKey) boolValue];
    NSNumber *refitAt = objc_getAssociatedObject(veil, kVeilRefitKey);
    // The last layout at the true size runs WHILE the veil waits (not after it), so it costs no extra time.
    if (!refitAt && now - born >= 0.18) {
        refitAt = @(now);
        objc_setAssociatedObject(veil, kVeilRefitKey, refitAt, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMRefitStageScene(stage);
    }
    BOOL held = now - born >= (quick ? 0.28 : 0.5);                       // the shortest a veil stays (covers the app's background/foreground flip)
    BOOL quiet = now - last >= (quick ? 0.14 : 0.2);                       // the app has stopped changing
    BOOL refitted = refitAt && now - refitAt.doubleValue >= 0.1;           // the size re-send has been laid out
    if ((held && quiet && refitted) || now - born > 1.2) {
        DMLog([NSString stringWithFormat:@"[veil] %@: fading (age %.2f s)", bundleID, now - born]);
        [UIView animateWithDuration:0.2 delay:0 options:UIViewAnimationOptionCurveEaseOut animations:^{ veil.alpha = 0.0; }
                         completion:^(BOOL finished) { [veil removeFromSuperview]; }];
        return;
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMVeilCheck(stage, veil, born); });
}
static void DMVeilCheck(UIView *stage, UIView *veil, CFTimeInterval born);
static void DMBeginStageEntrance(UIView *stage, UIView *inner);
// A new Aerial window fades in BEFORE its app's content is attached, and until then it shows its own light blur / backing over the Home
// Screen: a whitish flash on the whole window area. The window's base is the plain system background from the start instead.
static void DMDarkenStageBase(UIView *stage) {
    UIColor *base = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark ? [UIColor blackColor] : [UIColor whiteColor];
    stage.backgroundColor = base;
    UIView *inner = DMStageInnerView(stage);   // the view that really holds the app (nil until the app's scene is attached)
    for (UIView *v in stage.subviews) {
        if ([v isKindOfClass:[UIVisualEffectView class]]) { v.hidden = YES; continue; }
        if (![NSStringFromClass([v class]) isEqualToString:@"UIView"] || v.bounds.size.width <= 300.0 || v.bounds.size.height <= 100.0) continue;
        if ([v.accessibilityIdentifier hasPrefix:@"MSBVeil"]) continue;   // our own veils are handled by their owner
        if (inner && v != inner && v.subviews.count == 0 && v.backgroundColor) {
            // When Aerial re-hosts an app it builds a fresh content view and leaves its old, empty one layered above it: a solid
            // rectangle over the whole app (white before, black now). Nothing lives in it; hide it.
            if (!v.hidden) DMLog([NSString stringWithFormat:@"[aerial] %@: an empty leftover content view (%@) hidden", DMStageBundle(stage), NSStringFromCGRect(v.frame)]);
            v.hidden = YES; v.userInteractionEnabled = NO;
        } else if (!v.hidden && v.backgroundColor) v.backgroundColor = base;   // the holder waiting for the app: system colour, not white
    }
}
// A new window must never sit over another one so that they look like a single window with one hidden behind the other.
// Windows placed by a layout (Left Half, ...) are never touched: this is only for a window that opens in its default place.
//
// "Fit to Window" (Aerial's Control Center toggle, also in the Window menu) tiles up to four windows: the first opens as usual; a new one
// takes the first slot and the open ones slide along - two windows are left and right halves, three are a left half with the right half
// split in two, four are the four quarters. A fifth window opens as a regular window over them and the four keep their layout.
// With Fit to Window off, and for windows beyond four, windows open like on a Mac: nudged down and right so each shows its own title bar.
static CGFloat DMOverlapFraction(CGRect a, CGRect b) {
    CGRect i = CGRectIntersection(a, b);
    if (CGRectIsNull(i)) return 0.0;
    CGFloat smaller = MIN(a.size.width * a.size.height, b.size.width * b.size.height);
    return smaller > 0.0 ? (i.size.width * i.size.height) / smaller : 0.0;
}
static void DMPromptForSide(UIView *stage, NSString *newBundle, NSString *leftBundle, NSString *rightBundle);
static void DMPromptBeforeLaunch(NSString *newBundle, NSString *leftBundle, NSString *rightBundle, void (^launch)(CGRect frame));
static NSString *gPreSideBundle, *gPreSide;   // a side picked before the app was launched: applied when its window appears ("" = default)
static CFTimeInterval gPreSideUntil;
// Moves every window of the group into its slot. `fresh` (the window that has just opened) appears in its slot; the others slide.
static void DMAutoHideBeforeRetile(void);
static void DMAutoHideAfterRetile(void);
static void DMSetStageIntent(UIView *stage, CGRect frame);
static void DMApplyGroupSlots(UIView *fresh) {
    DMAutoHideBeforeRetile();
    for (NSString *b in [gFitGroup copy]) {
        UIView *s = DMStageForBundle(b);
        CGRect f = DMSlotFrame(b);
        if (!s || CGRectIsNull(f)) continue;
        if (s == fresh && DMIsZetsuWindow(s)) DMZetsuMove((UIWindow *)s, f, NO, nil);
        else if (s == fresh) {
            gStageFrameBypass = YES;
            [UIView performWithoutAnimation:^{ DMSetStageFrameSafe(s, f); [s layoutIfNeeded]; }];
            gStageFrameBypass = NO;
            // (and remembered as its place, Aerial 5.0's own remembered state included: a window opened from its Dock icon is zoomed out to
            // that state afterwards, so the tile was lost and the window came up at the default place, 2026-09-26 M1, Settings next to Twitter)
            DMSetStageIntent(s, f);
        } else {
            // (its tile is its intended place from the start of the slide, not only once the 0.36 s slide has ended: the check made when a new
            // window's app attaches (DMCascadeStage) found a third window "moved" from the default place mid-slide and put it back there -- a side
            // picked ~1 s after the prompt opened left the window in the middle, M1 and iPad 2, logic test 1.0.6)
            if (!DMIsZetsuWindow(s)) DMSetStageIntent(s, f);
            DMAerialMoveStage(s, f, nil);
        }
    }
    DMAutoHideAfterRetile();
}
// The answer to "which side?" for a third window: the chosen side is split in two (the new window on top, the window that was there below); the other
// side keeps its window at full height. side nil = the default arrangement.
static void DMSetSideChoiceGroup(NSString *newBundle, NSString *leftBundle, NSString *rightBundle, NSString *side) {
    gFitGroup = [NSMutableArray arrayWithObjects:newBundle, nil];
    if ([side isEqualToString:@"left"]) {
        [gFitGroup addObjectsFromArray:@[leftBundle, rightBundle]];
        gFitSlots = [@{newBundle: @"topleft", leftBundle: @"bottomleft", rightBundle: @"right"} mutableCopy];
    } else if ([side isEqualToString:@"right"]) {
        [gFitGroup addObjectsFromArray:@[rightBundle, leftBundle]];
        gFitSlots = [@{newBundle: @"topright", rightBundle: @"bottomright", leftBundle: @"left"} mutableCopy];
    } else {
        [gFitGroup addObjectsFromArray:@[leftBundle, rightBundle]];
        DMAssignDefaultSlots();
    }
}
// Where the new (third) window's tile will be for a side choice, without changing the tiling that is in force.
// No Fit's window: the standard window size, made smaller if needed to fit the free area (below the status bar, above the Dock) with a margin, and
// centred in that area (the standard "center" place is top-aligned and reached into the Dock on the iPad 2 in landscape).
static CGRect DMNoFitFrame(void) {
    CGRect usable = DMLayoutFrame(@"fill"), c = DMLayoutFrame(@"center");
    if (CGRectIsNull(usable) || CGRectIsNull(c)) return c;
    CGFloat w = MIN(c.size.width, usable.size.width - 48.0), h = MIN(c.size.height, usable.size.height - 48.0);
    return CGRectIntegral(CGRectMake(CGRectGetMidX(usable) - w / 2.0, CGRectGetMidY(usable) - h / 2.0, w, h));
}
static CGRect DMSideChoiceFrame(NSString *newBundle, NSString *leftBundle, NSString *rightBundle, NSString *side) {
    if ([side isEqualToString:@"none"]) return DMNoFitFrame();
    NSMutableArray *g = gFitGroup; NSMutableDictionary *sl = gFitSlots;
    DMSetSideChoiceGroup(newBundle, leftBundle, rightBundle, side);
    CGRect f = DMSlotFrame(newBundle);
    gFitGroup = g; gFitSlots = sl;
    return f;
}
static void DMMarkFreeWindow(NSString *bundleID) {
    if (!bundleID.length) return;
    if (!gFreeWindows) gFreeWindows = [NSMutableSet set];
    [gFreeWindows addObject:bundleID];
    [gFitGroup removeObject:bundleID]; [gFitSlots removeObjectForKey:bundleID];
    DMLog([NSString stringWithFormat:@"[fit] %@ opens free (No Fit): Fit to Window leaves it out", bundleID]);
}
static void DMApplySideChoice(UIView *stage, NSString *newBundle, NSString *leftBundle, NSString *rightBundle, NSString *side) {
    if ([side isEqualToString:@"none"]) {   // No Fit: the window goes to the middle, the two tiles stay
        DMMarkFreeWindow(newBundle);
        CGRect c = DMNoFitFrame();
        if (stage && !CGRectIsNull(c)) { DMSetStageIntent(stage, c); DMAerialMoveStage(stage, c, nil); }
        return;
    }
    DMSetSideChoiceGroup(newBundle, leftBundle, rightBundle, side);
    DMApplyGroupSlots(nil);
    SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (DMIsZetsuWindow(stage)) DMZetsuRaise((UIWindow *)stage); else if ([stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front); });
    DMLog([NSString stringWithFormat:@"[aerial] third window %@ placed on the %@ side", newBundle, side ?: @"default"]);
}
// Fit to Window has just been switched on: the windows that are open (up to four, the front ones) are tiled into their places.
static void DMTileOpenWindows(void) {
    [gFreeWindows removeAllObjects];   // (Fit to Window switched on again: every window takes part, No Fit ones too)
    NSMutableArray<UIView *> *open = [NSMutableArray array];
    for (UIView *s in DMAerialStages()) if (!s.hidden && !DMStageMinimized(s) && DMStageBundle(s).length) [open addObject:s];
    if (open.count < 2) return;
    NSArray<UIView *> *front = [[open reverseObjectEnumerator] allObjects];   // front first
    if (front.count > 4) front = [front subarrayWithRange:NSMakeRange(0, 4)];
    gFitGroup = [NSMutableArray array];
    for (UIView *s in front) [gFitGroup addObject:DMStageBundle(s)];
    DMAssignDefaultSlots();
    gMoveKeepsOrder = YES;
    DMApplyGroupSlots(nil);
    gMoveKeepsOrder = NO;
    DMLog([NSString stringWithFormat:@"[aerial] Fit to Window on: %lu open windows tiled", (unsigned long)front.count]);
}
static CGRect DMFitInto(CGRect f, CGRect usable);
static void DMSetStageIntent(UIView *stage, CGRect frame);
// A new window is placed (tiled, cascaded) as soon as it is first seen, while it is still fading in, so it opens right in its place: before, it was
// placed only once the app had attached (~1.2 s later) and visibly jumped from the middle of the screen into its tile (measured on the iPad 2 with
// Aerial 3.0: 599 -> 379 pt wide from one frame to the next). The later call (when the app has attached) then only puts it back where we put it,
// in case the engine moved it meanwhile -- it does not tile again (that would ask "which side?" a second time).
// A window still in its opening zoom (Aerial 5.0 opens a window from a Dock icon small at the icon, with the app's holder scaled, and zooms it up):
// its sizes then read ~3x too big (2026-09-26, M1: Twitter was told 3139 x 2207 and laid itself out for that, then squeezed into its 943 x 676
// window, distorted with its traffic lights until full screen and back). Such a window is left alone until it has settled.
static BOOL DMStageStillZooming(UIView *stage) {
    if (!stage) return NO;
    CGAffineTransform t = stage.transform;   // (the zoom starts at ~0.3x; a window Aerial keeps scaled a few percent for good is settled: M1's StageStates has one at 1.03)
    NSNumber *born = objc_getAssociatedObject(stage, kA5BornKey);   // (an Aerial 5.0 window seen over 3 s ago has finished its zoom: a scale it still has is kept for good,
    BOOL old = born && CACurrentMediaTime() - born.doubleValue > 3.0;   //  iPad 2: YouTube left at 0.85 counted as opening forever, and its settled size never went out)
    if (!old && !CGAffineTransformIsIdentity(t) && (fabs(t.b) > 0.001 || fabs(t.c) > 0.001 || MIN(fabs(t.a), fabs(t.d)) < 0.9)) return YES;
    UIView *in = DMStageInnerView(stage);   // (its own transform is not a sign: Aerial keeps apps it does not resize scaled for good)
    CGSize screen = [UIScreen mainScreen].bounds.size;
    CGFloat big = MAX(screen.width, screen.height) * 1.02;
    CGFloat k = old ? MIN(hypot(t.a, t.b), hypot(t.c, t.d)) : 1.0;   // (a settled scale counts: its content is seen at that size)
    if (k < 0.01) k = 1.0;
    return in && (in.bounds.size.width * k > big || in.bounds.size.height * k > big);   // (bigger than the screen: not a settled window)
}
static const void *kStageCascadedKey = &kStageCascadedKey;
static void DMCascadeStage(UIView *stage) {
    extern BOOL gRestoringWindowsFlag(void);
    if (gRestoringWindowsFlag()) return;   // windows being brought back after a respring are put where they were, not tiled or cascaded
    extern BOOL DMSofaRelaunchKeepsFrame(NSString *bundleID);
    if (DMSofaRelaunchKeepsFrame(DMStageBundle(stage))) {   // SofaScore's quick relaunch reopens it exactly where it was (no remembered frame, no tiling)
        extern CGRect DMSofaRelaunchPlaced(UIView *stage);
        CGRect f = DMSofaRelaunchPlaced(stage), cur = stage.frame;
        objc_setAssociatedObject(stage, kStageCascadedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMSetStageIntent(stage, f);
        if (fabs(f.origin.x - cur.origin.x) > 1.0 || fabs(f.origin.y - cur.origin.y) > 1.0 || fabs(f.size.width - cur.size.width) > 1.0 || fabs(f.size.height - cur.size.height) > 1.0) {
            DMLog([NSString stringWithFormat:@"[sofa] relaunch: the engine reopened it at %@, put back at %@", NSStringFromCGRect(cur), NSStringFromCGRect(f)]);
            gMoveKeepsOrder = YES; DMAerialMoveStage(stage, f, nil); gMoveKeepsOrder = NO;
        }
        return;
    }
    if ([objc_getAssociatedObject(stage, kStageCascadedKey) boolValue]) {
        extern void DMA5HoldEntranceFrameNow(UIView *stage);
        if (objc_getAssociatedObject(stage, kA5EntranceTargetKey)) {   // (just flown in from full screen: put back at once, no move animation)
            DMA5HoldEntranceFrameNow(stage);
            if (objc_getAssociatedObject(stage, kA5EntranceTargetKey)) return;   // (still held; a hold that has just ended falls through to the check below)
        }
        NSValue *intent = objc_getAssociatedObject(stage, kStageIntentKey);
        CGRect want = intent ? intent.CGRectValue : CGRectNull, f = stage.frame;
        if (!CGRectIsNull(want) && !DMStageMinimized(stage) && !DMIsZetsuWindow(stage) && !DMStageStillZooming(stage)
            && (fabs(want.origin.x - f.origin.x) > 1.0 || fabs(want.origin.y - f.origin.y) > 1.0 || fabs(want.size.width - f.size.width) > 1.0 || fabs(want.size.height - f.size.height) > 1.0)) {
            DMLog([NSString stringWithFormat:@"[cascade] %@: moved from where it was placed (%@ -> %@): put back", DMStageBundle(stage), NSStringFromCGRect(want), NSStringFromCGRect(f)]);
            DMAerialMoveStage(stage, want, nil);
        }
        return;
    }
    objc_setAssociatedObject(stage, kStageCascadedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UIWindow *win = [stage isKindOfClass:[UIWindow class]] ? (UIWindow *)stage : (stage.window ?: DMWindowLayer());   // (a Zetsu window IS a UIWindow)
    NSMutableArray<UIView *> *others = [NSMutableArray array];
    for (UIView *s in DMAerialStages()) if (s != stage && !s.hidden && !DMStageMinimized(s) && DMStageBundle(s).length) [others addObject:s];
    NSString *me = DMStageBundle(stage);
    CGRect base = stage.frame, usable = DMLayoutFrame(@"fill");
    BOOL fitOn = DMFitEnabled();
    DMLog([NSString stringWithFormat:@"[cascade] %@ frame %@, %lu other windows, fit to window %d", me, NSStringFromCGRect(base), (unsigned long)others.count, fitOn]);
    if (!win || !me.length || CGRectIsNull(usable) || CGRectIsEmpty(base)) { DMLog([NSString stringWithFormat:@"[cascade] %@: nothing to do (window %d, usable %@)", me, win != nil, NSStringFromCGRect(usable)]); return; }
    // Aerial 5.0 remembers every app's last window frame itself and reopens the app there (requested: Settings, opened as the only window with Fit to
    // Window off, came back at the half-screen size it last had while tiled -- log: our size 841x607 sent, then Aerial's own 481x559). On 3.0 a
    // hook kept Aerial from doing that; on 5.0 nothing of Aerial's may be hooked, so the new window is moved here instead: to where we last had
    // it (kept until the app quits, like on 3.0), or else to our default place. Fit to Window and the overlap nudge below then work from that.
    // (launched straight into its place after the side question: its frame is already the one we asked for -- the tile, or No Fit's centred
    //  frame -- so Aerial 5.0's remembered frame is not "corrected" to the default place / an old tile; logic test 1.0.7)
    BOOL preLaunched = [gPreSideBundle isEqualToString:me] && CACurrentMediaTime() < gPreSideUntil;
    if (gAerialFlavor == 5 && !preLaunched) {
        NSValue *remembered = gLastWindowFrames[me];
        CGRect want = remembered ? DMFitInto(remembered.CGRectValue, usable) : DMLayoutFrame(@"center");
        if (!CGRectIsNull(want) && (fabs(want.size.width - base.size.width) > 4.0 || fabs(want.size.height - base.size.height) > 4.0 || fabs(want.origin.x - base.origin.x) > 4.0 || fabs(want.origin.y - base.origin.y) > 4.0)) {
            DMLog([NSString stringWithFormat:@"[cascade] %@: Aerial 5.0 reopened it at its own remembered frame %@, moved to %@ %@", me, NSStringFromCGRect(base), remembered ? @"where we last had it" : @"the default place", NSStringFromCGRect(want)]);
            gStageFrameBypass = YES;
            [UIView performWithoutAnimation:^{ DMSetStageFrameSafe(stage, want); [stage layoutIfNeeded]; }];
            gStageFrameBypass = NO;
            DMSetStageIntent(stage, want);
            base = want;
        }
    }

    if (fitOn && [gFreeWindows containsObject:me]) goto regularWindow;   // (a free window, No Fit)
    if (fitOn) {
        if (!gFitGroup) gFitGroup = [NSMutableArray array];
        // Windows that have gone, and windows that are minimized, hidden or closing: they are not on screen, so they don't take a tile. (Bug, the owner:
        // with one app minimized, every app opened on its own was still squeezed into half the screen -- log: "0 other windows" then "2 windows
        // tiled" -- because a minimized window still has its stage, so the old "has it gone?" test kept it in the group.)
        for (NSString *b in [gFitGroup copy]) if (!DMStageTakesPartInFit(DMStageForBundle(b))) [gFitGroup removeObject:b];
        // Requirement: with four windows already tiled into the quarters, a fifth (and every one after it) opens as a regular window over them and the four
        // keep their places. Before, the "every open window takes part" step below pulled the extra windows into the group and trimmed it back to
        // three plus the new one, so the newest window replaced a tile.
        // (also counted from the windows actually open: after a respring the restored windows are put back where they were but are not in
        // gFitGroup yet, and a fifth window then joined the tiling and took the top-left quarter from one of the four -- Phase 2b, M1)
        if (gFitGroup.count >= 4 || others.count >= 4) {
            DMLog([NSString stringWithFormat:@"[aerial] Fit to Window: four windows are already tiled, %@ opens as a regular window over them", me]);
            goto regularWindow;
        }
        // Every window that is open takes part, also one that was dragged, resized or given a layout by hand (those are taken out of the group
        // when that happens, so a moved first window used to make the next launch open untiled), or that was open before Fit to Window went on.
        for (UIView *o in others) { NSString *b = DMStageBundle(o); if (b.length && ![b isEqualToString:me] && ![gFitGroup containsObject:b] && ![gFreeWindows containsObject:b]) [gFitGroup addObject:b]; }
        [gFitGroup removeObject:me];
        if (gFitGroup.count > 3) [gFitGroup removeObjectsInRange:NSMakeRange(3, gFitGroup.count - 3)];   // this window and three others make four
        // Two windows each cover a side and a third opens: ask on which side it goes.
        if (gFitGroup.count == 2) {
            UIView *a = DMStageForBundle(gFitGroup[0]), *b = DMStageForBundle(gFitGroup[1]);
            NSString *sa = a ? DMSlotNameForFrame(a.frame) : nil, *sb = b ? DMSlotNameForFrame(b.frame) : nil;
            NSString *leftBundle = [sa isEqualToString:@"left"] ? gFitGroup[0] : ([sb isEqualToString:@"left"] ? gFitGroup[1] : nil);
            NSString *rightBundle = [sa isEqualToString:@"right"] ? gFitGroup[0] : ([sb isEqualToString:@"right"] ? gFitGroup[1] : nil);
            if (leftBundle && rightBundle) {
                if ([gPreSideBundle isEqualToString:me] && CACurrentMediaTime() < gPreSideUntil) {   // (asked before the launch: the choice is applied, not asked again)
                    NSString *side = gPreSide.length ? gPreSide : nil; gPreSideBundle = nil;
                    if ([side isEqualToString:@"none"]) { DMMarkFreeWindow(me); if (!DMIsZetsuWindow(stage)) DMSetStageIntent(stage, base); goto regularWindow; }   // (No Fit: an ordinary window in the middle)
                    DMApplySideChoice(stage, me, leftBundle, rightBundle, side);
                    return;
                }
                DMPromptForSide(stage, me, leftBundle, rightBundle); return;
            }
        }
        if (gFitGroup.count < 4) {
            [gFitGroup insertObject:me atIndex:0];
            if (gFitGroup.count >= 2) {
                DMAssignDefaultSlots();
                DMApplyGroupSlots(stage);
                SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (DMIsZetsuWindow(stage)) DMZetsuRaise((UIWindow *)stage); else if ([stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front); });
                DMLog([NSString stringWithFormat:@"[aerial] Fit to Window: %lu windows tiled (%@ first)", (unsigned long)gFitGroup.count, me]);
                return;
            }
            // the first window: opens as usual (below, it is only kept off any other window)
        } else {
            DMLog(@"[aerial] Fit to Window: four windows are already tiled, this one opens as a regular window");
        }
    } else {
        gFitGroup = nil; gFitSlots = nil;   // Fit to Window is off: nothing is tiled any more
    }
regularWindow:;
    if ([gFreeWindows containsObject:me]) return;   // (No Fit: it stays in the middle, where it was opened, even over the tiles)

    BOOL overlaps = NO;
    for (UIView *o in others) if (DMOverlapFraction(base, o.frame) > 0.45) overlaps = YES;
    if (!overlaps) return;
    CGRect pick = base;
    const CGFloat stepX = 50.0, stepY = 44.0, near = 34.0;
    BOOL found = NO;
    for (int k = 1; k <= 8 && !found; k++) {
        for (int sign = 1; sign >= -1 && !found; sign -= 2) {
            CGRect f = CGRectOffset(base, sign * k * stepX, sign * k * stepY);
            f.origin.x = MAX(usable.origin.x, MIN(f.origin.x, CGRectGetMaxX(usable) - f.size.width));   // stays on the screen
            f.origin.y = MAX(usable.origin.y, MIN(f.origin.y, CGRectGetMaxY(usable) + 30.0 - f.size.height));
            BOOL clear = YES;
            for (UIView *o in others) if (fabs(o.frame.origin.x - f.origin.x) < near && fabs(o.frame.origin.y - f.origin.y) < near) clear = NO;
            if (clear) { pick = f; found = YES; }
        }
    }
    if (!found || CGRectEqualToRect(pick, base)) return;
    DMLog([NSString stringWithFormat:@"[aerial] new window of %@ placed at %@ (was %@) so it does not sit over another window", me, NSStringFromCGRect(pick), NSStringFromCGRect(base)]);
    if (DMIsZetsuWindow(stage)) { DMZetsuMove((UIWindow *)stage, pick, NO, nil); return; }
    gStageFrameBypass = YES;
    [UIView performWithoutAnimation:^{ DMSetStageFrameSafe(stage, pick); [stage layoutIfNeeded]; }];
    gStageFrameBypass = NO;
    // (an intended place set above (Aerial 5.0: the default place) follows the nudge: the check when the app attaches otherwise put the window
    // back over the other one, M1 logic test 1.0.6, Twitter with Fit to Window off)
    if (objc_getAssociatedObject(stage, kStageIntentKey)) DMSetStageIntent(stage, pick);
}
static void DMStyleStage(UIView *stage) {
    if (!gStyleMilkyWay) return;
    DMDarkenStageBase(stage);
    CGFloat W = stage.bounds.size.width, H = stage.bounds.size.height;
    if (W < 120.0 || H < 120.0) return;
    if ([objc_getAssociatedObject(stage, kStageClosingKey) boolValue]) return;   // leaving: the swap to the real full-screen app is being set up
    BOOL dark = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
    BOOL entering = [objc_getAssociatedObject(stage, kStageEnteringKey) boolValue];
    if (!entering && !objc_getAssociatedObject(stage, kStageCascadedKey) && !(gVeilColor && gVeilSnap && gStageCover && CACurrentMediaTime() - gVeilColorTime < 6.0)) {
        __weak UIView *ws = stage;   // a new window: placed right away, while it fades in (see DMCascadeStage); not from inside this layout pass
        objc_setAssociatedObject(stage, kStageCascadedKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        dispatch_async(dispatch_get_main_queue(), ^{ UIView *st = ws; if (st && !st.hidden && ![objc_getAssociatedObject(st, kStageCascadedKey) boolValue]) DMCascadeStage(st); });
    }
    stage.clipsToBounds = YES;
    if (!entering) stage.layer.cornerRadius = kMilkyWayCorner;   // while the window flies in, the entrance animation owns the radius
    stage.layer.cornerCurve = kCACornerCurveContinuous;
    stage.layer.borderWidth = 0.5;
    stage.layer.borderColor = (dark ? [UIColor colorWithWhite:1.0 alpha:0.16] : [UIColor colorWithWhite:0.0 alpha:0.14]).CGColor;

    UIView *inner = DMStageInnerView(stage);
    if (inner) {
        inner.frame = CGRectMake(0, kStageBarHeight, W, H - kStageBarHeight);
        inner.layer.cornerRadius = 0.0;
    }
    if (!inner) {   // the app's scene is not attached yet (a cold launch): look again shortly, this layout pass is not repeated by itself
        NSNumber *tries = objc_getAssociatedObject(stage, kStageInnerRetryKey);
        if (tries.intValue < 80) {
            objc_setAssociatedObject(stage, kStageInnerRetryKey, @(tries.intValue + 1), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            __weak UIView *weakStage = stage;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ [weakStage setNeedsLayout]; });
        }
    }
    if (inner && !objc_getAssociatedObject(stage, kStageVeilKey)) {
        BOOL fromFullScreen = gVeilColor && gVeilSnap && gStageCover && CACurrentMediaTime() - gVeilColorTime < 6.0;
        objc_setAssociatedObject(stage, kStageVeilKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!fromFullScreen) {   // opened some other way (Aerial's toggle, a Home Screen launch): its first settled place is the one to keep
            __weak UIView *weakStage = stage;
            // While the app loads it may show a blank white screen; the window shows the system background colour until the app has settled.
            UIView *veil = [[UIView alloc] initWithFrame:inner.frame];
            veil.accessibilityIdentifier = @"MSBVeil-new";
            veil.backgroundColor = [UIColor systemBackgroundColor];
            veil.userInteractionEnabled = NO;
            [stage insertSubview:veil aboveSubview:inner];
            objc_setAssociatedObject(stage, kStageVeilViewKey, veil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(veil, kVeilQuickKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMVeilCheck(stage, veil, CACurrentMediaTime());
            dispatch_async(dispatch_get_main_queue(), ^{ UIView *s = weakStage; if (s) DMCascadeStage(s); });
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIView *s = weakStage;
                if (s && !objc_getAssociatedObject(s, kStageIntentKey)) DMRememberStageFrame(s);
            });
        }
        if (fromFullScreen) {
            objc_setAssociatedObject(stage, kStageEnteringKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // Aerial's own fade / scale-in stops right now
            dispatch_async(dispatch_get_main_queue(), ^{ DMBeginStageEntrance(stage, inner); });   // not from inside the layout pass itself
        }
    }
    UIView *veilView = objc_getAssociatedObject(stage, kStageVeilViewKey);
    if (veilView.superview == stage && inner) veilView.frame = inner.frame;   // the veil always covers exactly the content area
    UIView *bar = objc_getAssociatedObject(stage, kStageBarKey);
    if (!bar) {
        bar = [[UIView alloc] init];
        bar.userInteractionEnabled = NO;
        objc_setAssociatedObject(stage, kStageBarKey, bar, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (inner) [stage insertSubview:bar aboveSubview:inner]; else [stage addSubview:bar];
    }
    bar.frame = CGRectMake(0, 0, W, kStageBarHeight);
    bar.backgroundColor = dark ? [UIColor colorWithWhite:0.19 alpha:1.0] : [UIColor colorWithWhite:0.91 alpha:1.0];
    UIView *drag = DMStageValue(stage, @[@"_dragAreaView"]);
    if ([drag isKindOfClass:[UIView class]]) drag.frame = CGRectMake(0, 0, W, kStageBarHeight);   // Aerial's move strip is the title bar
    // Aerial's white resize handles (the corner marks and the bottom pill) stay where they are and keep working, but cannot be seen.
    for (NSString *key in @[@"_handleBL", @"_handleBR", @"_handleTL", @"_handleTR", @"_minusHandle"]) {
        UIView *h = DMStageValue(stage, @[key]);
        if ([h isKindOfClass:[UIView class]] && !h.hidden) h.alpha = 0.011;   // just above the 0.01 a view needs to be touchable
    }
    // A small diagonal grip at each BOTTOM corner — the two that actually resize the window (Aerial's own -handleResizeBL:/
    // -handleResizeBR:; the top corners only trim the content inset, confirmed live via methsearch_AerialStage). Purely
    // decorative: a plain, non-interactive subview placed where the real (invisible, alpha 0.011 above) handle already is,
    // so it only shows when dragging that spot would actually resize the window — hidden the moment Aerial itself hides that
    // handle (a locked window, mid-trim, etc.), and while the window is flying in (kStageEnteringKey), same as the rest of
    // this function's chrome not being drawn yet.
    if (inner && !entering) {
        for (int side = 0; side < 2; side++) {   // 0 = bottom-left, 1 = bottom-right
            NSString *handleKey = side == 0 ? @"_handleBL" : @"_handleBR";
            const void *gripKey = side == 0 ? kStageGripBLKey : kStageGripBRKey;
            UIView *handle = DMStageValue(stage, @[handleKey]);
            UIView *grip = objc_getAssociatedObject(stage, gripKey);
            if (!grip) {
                grip = DMMakeResizeGrip();
                objc_setAssociatedObject(stage, gripKey, grip, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                [stage insertSubview:grip aboveSubview:inner];
            }
            BOOL handleLive = [handle isKindOfClass:[UIView class]] && !handle.hidden;
            grip.hidden = !handleLive;
            if (handleLive) {
                grip.backgroundColor = DMResizeGripColorFor(DMStageBundle(stage), dark);
                grip.transform = CGAffineTransformMakeRotation(side == 0 ? -M_PI_4 : M_PI_4);   // "/" bottom-left, "\" bottom-right
                grip.center = CGPointMake(side == 0 ? kMilkyWayCorner : (W - kMilkyWayCorner), H - kMilkyWayCorner);
            }
        }
    }
    UIView *menu = DMStageValue(stage, @[@"_menuButton", @"menuButton"]);
    if ([menu isKindOfClass:[UIView class]]) { menu.hidden = YES; menu.alpha = 0.0; menu.userInteractionEnabled = NO; }   // Aerial's "···" controls menu is not wanted; the Window menu does its job
    DMStageLights *lights = objc_getAssociatedObject(stage, kStageLightsKey);
    if (!lights) {
        lights = [[DMStageLights alloc] initWithStage:stage];
        objc_setAssociatedObject(stage, kStageLightsKey, lights, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [stage addSubview:lights];
    }
    lights.frame = CGRectMake(4.0, 0, 3 * kLightCell, kStageBarHeight);
    [stage bringSubviewToFront:lights];
    if ([objc_getAssociatedObject(stage, kStageDropKey) boolValue]) {   // the lights arrive from the status bar
        objc_setAssociatedObject(stage, kStageDropKey, @NO, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        lights.alpha = 0.0;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMDropLights(stage, lights); });
    }

    // tell the app its size now that the content area is ours
    if (inner) {
        CGSize size = inner.bounds.size;
        NSValue *committed = objc_getAssociatedObject(stage, kStageCommitKey);
        if ((!committed || !CGSizeEqualToSize(committed.CGSizeValue, size)) && !(entering && committed)) {
            objc_setAssociatedObject(stage, kStageCommitKey, [NSValue valueWithCGSize:size], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            __weak UIView *weakStage = stage;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.04 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIView *s = weakStage, *in = s ? DMStageInnerView(s) : nil;
                NSString *bundleID = s ? DMStageBundle(s) : nil;
                if (!in || !bundleID.length || [objc_getAssociatedObject(s, kStageClosingKey) boolValue]) return;
                CGRect screen = [in convertRect:in.bounds toView:nil];
                ((void (*)(id, SEL, id, CGRect))objc_msgSend)((id)objc_getClass("AerialCore"), DMAerialSel(@"applySceneFrameForBundle:frame:"), bundleID, screen);
                DMLog([NSString stringWithFormat:@"[aerial] committed %@ scene frame %@", bundleID, NSStringFromCGRect(screen)]);
            });
        }
    }
}
// The window comes out of the full-screen app: it starts as the full screen (showing the frozen picture of the app, so the cover can go without
// anything moving), then springs into its place while the picture eases into the smaller content area. Aerial's own entrance (a fade with a
// small scale-up) is switched off for the moment, and the picture stays over the app until the app has settled in its new size.
static void DMBeginStageEntrance(UIView *stage, UIView *inner) {
    UIWindow *host = DMStatusBarWindow();
    UIView *snap = gVeilSnap;
    if (!host || !snap || !gStageCover) { objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); return; }
    CGRect target = stage.frame;
    CGSize sc = host.bounds.size, ss = snap.bounds.size;
    objc_setAssociatedObject(stage, kStageEnteringKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kStageDropKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    UIView *veil = [[UIView alloc] initWithFrame:CGRectMake(0, kStageBarHeight, sc.width, sc.height)];
    veil.accessibilityIdentifier = @"MSBVeil-entrance";
    veil.backgroundColor = gVeilColor;
    veil.clipsToBounds = YES;
    veil.userInteractionEnabled = NO;
    snap.layer.anchorPoint = CGPointZero;
    snap.frame = CGRectMake(0, 0, ss.width, ss.height);
    snap.transform = CGAffineTransformIdentity;
    [veil addSubview:snap];
    [stage insertSubview:veil aboveSubview:inner];   // above the WHOLE content area: a re-hosted (blank) app view can never show over it
    objc_setAssociatedObject(stage, kStageVeilViewKey, veil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    if (MSBReduceMotion()) {
        // Reduce Motion: no flight out of the full screen. The window is put straight into its final state (the state the spring below ends
        // in: its frame, corners, the picture scaled into the content area) and fades in while the full-screen picture under it fades out.
        CGFloat rx = target.size.width / ss.width, ry = (target.size.height - kStageBarHeight) / (ss.height - kStageBarHeight);
        SEL rmScale = DMAerialSel(@"adjustContentScaleToHost");
        UIView *cover = gStageCover;
        gStageFrameBypass = YES;
        [UIView performWithoutAnimation:^{
            [stage.layer removeAllAnimations];   // (Aerial's own fade / scale-in)
            stage.transform = CGAffineTransformIdentity;
            stage.frame = target;
            stage.layer.cornerRadius = kMilkyWayCorner;
            snap.transform = CGAffineTransformMake(rx, 0, 0, ry, 0, -kStageBarHeight * ry);
            [stage layoutIfNeeded];
            if ([stage respondsToSelector:rmScale]) ((void (*)(id, SEL))objc_msgSend)(stage, rmScale);
            stage.alpha = 0.0;
        }];
        gStageFrameBypass = NO;
        [UIView animateWithDuration:kMSBRMDuration delay:0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionAllowUserInteraction
                         animations:^{ stage.alpha = 1.0; cover.alpha = 0.0; }
                         completion:^(BOOL finished) {
            if (cover && gStageCover == cover) DMStageCoverRemove();
            objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMRememberStageFrame(stage);
            [stage setNeedsLayout];
        }];
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // safety
        });
        gVeilSnap = nil;
        DMLog(@"[aerial] window fading in from full screen (Reduce Motion); content held back until the app has settled");
        DMVeilCheck(stage, veil, CACurrentMediaTime());
        return;
    }
    CGRect full = CGRectMake(0, -kStageBarHeight, sc.width, sc.height + kStageBarHeight);
    gStageFrameBypass = YES;
    [UIView performWithoutAnimation:^{
        [stage.layer removeAllAnimations];
        stage.transform = CGAffineTransformIdentity;
        stage.alpha = 1.0;
        stage.frame = full;
        stage.layer.cornerRadius = 0.0;
    }];
    gStageFrameBypass = NO;
    DMStageCoverRemove();   // the window now shows exactly what the cover showed

    CGFloat ex = target.size.width / ss.width, ey = (target.size.height - kStageBarHeight) / (ss.height - kStageBarHeight);
    SEL scaleSel = DMAerialSel(@"adjustContentScaleToHost");
    [UIView animateWithDuration:0.46 delay:0 usingSpringWithDamping:0.86 initialSpringVelocity:0
                        options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction animations:^{
        gStageFrameBypass = YES;
        stage.frame = target;
        gStageFrameBypass = NO;
        stage.layer.cornerRadius = kMilkyWayCorner;
        snap.transform = CGAffineTransformMake(ex, 0, 0, ey, 0, -kStageBarHeight * ey);
        [stage layoutIfNeeded];
        if ([stage respondsToSelector:scaleSel]) ((void (*)(id, SEL))objc_msgSend)(stage, scaleSel);
    } completion:^(BOOL finished) {
        objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMRememberStageFrame(stage);
        [stage setNeedsLayout];
    }];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // safety
    });
    gVeilSnap = nil;
    DMLog(@"[aerial] window flying in from full screen; content held back until the app has settled");
    DMVeilCheck(stage, veil, CACurrentMediaTime());
}
// Green: the stage grows until its content area is exactly the screen (the title bar slides off the top and the corners square off), then
// the stage is closed, the app gets the whole screen back, and it opens full screen for real. Because the picture underneath already is
// the full-screen app at full size, the swap is invisible.
static void DMAerialToFullScreen(UIView *stage) {
    NSString *bundleID = DMStageBundle(stage);
    if (!bundleID.length) return;
    if (DMWaitForContextMenu([NSString stringWithFormat:@"full screen %p", stage], ^{ DMAerialToFullScreen(stage); })) return;
    objc_setAssociatedObject(stage, kStageClosingKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); { extern BOOL gFitClosureCheckDue; gFitClosureCheckDue = YES; }
    CGSize screen = [UIScreen mainScreen].bounds.size;
    DMLog([NSString stringWithFormat:@"[aerial] %@ to full screen", bundleID]);
    // (Reduce Motion: the window does not grow. The frozen picture of the screen is taken now, with the window as it is (the cover sits under
    // the windows); the window goes transparent over its own picture, is closed without animation, and once the app is up full screen the
    // picture cross-fades away: the window's look fades into the full-screen app.)
    BOOL rm = MSBReduceMotion();
    if (rm) { DMStageCoverPrepare(NO); if (gStageCover) stage.alpha = 0.0; else rm = NO; }
    // the app is laid out for the full screen while the stage grows (its inner area ends at exactly 0,0 - screen size)
    ((void (*)(id, SEL, id, CGRect))objc_msgSend)((id)objc_getClass("AerialCore"), DMAerialSel(@"applySceneFrameForBundle:frame:"), bundleID, CGRectMake(0, 0, screen.width, screen.height));
    SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
    if ([stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front);
    UIView *inner = DMStageInnerView(stage);
    [UIView animateWithDuration:rm ? 0.0 : 0.28 delay:0 usingSpringWithDamping:1.0 initialSpringVelocity:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{
        if (rm) return;
        stage.frame = DMA5StageFromWindow(CGRectMake(0, -kStageBarHeight, screen.width, screen.height + kStageBarHeight));
        if (gAerialFlavor != 5) {
            stage.layer.cornerRadius = 0.0;
            stage.layer.borderWidth = 0.0;
        }
        [stage layoutIfNeeded];
        if (inner && gAerialFlavor != 5) inner.frame = CGRectMake(0, kStageBarHeight, screen.width, screen.height);   // (5.0 lays its holder out itself)
    } completion:^(BOOL finished) {
        // A frozen picture of the full-size window goes over the screen before the window is closed and the app opened full screen: the
        // app's own launch animation (which looked like the app launching a second time) plays underneath it, out of sight.
        if (!rm) DMStageCoverPrepare(NO);
        UIView *cover = gStageCover;
        gPendingFrontBundle = [bundleID copy]; gPendingFrontUntil = CACurrentMediaTime() + 3.0;
        DMResetSceneFrameForBundle(bundleID);
        DMAerialClose(bundleID);
        DMOpenFullScreen(bundleID);
        DMWaitFor(^BOOL{ return [[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]; }, 60, ^(BOOL ok) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((ok ? 0.35 : 0.1) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                if (!cover || gStageCover != cover) return;
                [UIView animateWithDuration:rm ? kMSBRMDuration : 0.22 delay:0 options:rm ? UIViewAnimationOptionCurveEaseInOut : UIViewAnimationOptionCurveEaseOut animations:^{ cover.alpha = 0.0; }
                                 completion:^(BOOL f) { if (gStageCover == cover) DMStageCoverRemove(); }];
            });
        });
    }];
}
// ---- remembered window positions ------------------------------------------------------------------------------------------
// Every window remembers where its owner (a layout from the Window menu, or a drag / resize by hand) last put it. Aerial's own "fit to
// screen" logic can move windows around when the screen briefly changes (the Cover Sheet coming down, rotation); whenever that happens the
// window goes straight back, and a window that comes back from being minimized always returns to its remembered place.
static CFTimeInterval gLockingUntil = 0;   // the screen is being locked until then: Aerial's minimize-all is ignored
static const void *kStageGestureKey = &kStageGestureKey;   // a drag / resize by hand is in progress
static const void *kStageIntentSizeKey = &kStageIntentSizeKey;    // the screen size the remembered frame belongs to
static const void *kStageByOrientKey = &kStageByOrientKey;        // {"L": frame, "P": frame}: where the window is in each orientation
static NSString *DMOrientKey(void) { CGSize s = [UIScreen mainScreen].bounds.size; return s.width > s.height ? @"L" : @"P"; }
static void DMSetStageIntent(UIView *stage, CGRect frame) {
    // (a window opened in the last 2 s: the place we give it is held against Aerial's own late re-placements, see DMAerialMoveStage)
    NSNumber *born = objc_getAssociatedObject(stage, kA5BornKey);
    CFTimeInterval now = CACurrentMediaTime();
    if (gAerialFlavor == 5 && born && now - born.doubleValue < 2.0 && !DMTestFlag("/tmp/msb-a5-nohold")) DMA5HoldStageAt(stage, frame, MAX(born.doubleValue + 2.0, now + 0.6));
    DMAerial5SyncState(stage, frame);
    objc_setAssociatedObject(stage, kStageIntentKey, [NSValue valueWithCGRect:frame], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kStageIntentSizeKey, [NSValue valueWithCGSize:[UIScreen mainScreen].bounds.size], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSMutableDictionary *by = objc_getAssociatedObject(stage, kStageByOrientKey);
    if (!by) { by = [NSMutableDictionary dictionary]; objc_setAssociatedObject(stage, kStageByOrientKey, by, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    by[DMOrientKey()] = [NSValue valueWithCGRect:frame];
}
static void DMRememberStageFrame(UIView *stage) {
    if (!stage || [objc_getAssociatedObject(stage, kStageEnteringKey) boolValue] || DMStageMinimized(stage)) return;
    if (stage.frame.size.width < 150.0 || stage.frame.size.height < 150.0) return;
    CGRect own = stage.frame; own.origin.y -= DMAutoHideShiftOf(stage);   // (a window the auto-hiding status bar has moved down for a moment: its own place)
    NSValue *hold = objc_getAssociatedObject(stage, kA5EntranceTargetKey);
    if (hold) own = hold.CGRectValue;   // (just flown in from full screen: where it landed, not a fit-to-screen frame Aerial set in between)
    DMSetStageIntent(stage, own);
    NSString *bundleID = DMStageBundle(stage);
    if (bundleID.length) { if (!gLastWindowFrames) gLastWindowFrames = [NSMutableDictionary dictionary]; gLastWindowFrames[bundleID] = [NSValue valueWithCGRect:own]; }
}
static void DMEnforceStageFrame(UIView *stage, NSString *why) {
    NSValue *intent = objc_getAssociatedObject(stage, kStageIntentKey);
    if (!intent || [objc_getAssociatedObject(stage, kStageEnteringKey) boolValue] || [objc_getAssociatedObject(stage, kStageGestureKey) boolValue]) return;
    NSValue *forSize = objc_getAssociatedObject(stage, kStageIntentSizeKey);
    if (forSize && !CGSizeEqualToSize(forSize.CGSizeValue, [UIScreen mainScreen].bounds.size)) return;   // the screen has turned: this frame is for the other shape
    if ([objc_getAssociatedObject(stage, kStageClosingKey) boolValue] || DMStageMinimized(stage)) return;   // leaving (full screen) or hidden: nothing to keep
    CGRect want = intent.CGRectValue;
    CGFloat shift = DMAutoHideShiftOf(stage);   // (moved down by the auto-hiding status bar: compared and put back at its own place, the move kept)
    CGRect cur = stage.frame; cur.origin.y -= shift;
    if (fabs(cur.origin.x - want.origin.x) < 0.01 && fabs(cur.origin.y - want.origin.y) < 0.01 && fabs(cur.size.width - want.size.width) < 0.01 && fabs(cur.size.height - want.size.height) < 0.01) return;   // (float rounding only)
    DMLog([NSString stringWithFormat:@"[aerial] %@ moved %@ -> %@ by %@: put back", DMStageBundle(stage), NSStringFromCGRect(want), NSStringFromCGRect(cur), why]);
    CGRect vis = want; vis.origin.y += shift;
    gStageFrameBypass = YES;
    [UIView performWithoutAnimation:^{ stage.frame = vis; [stage layoutIfNeeded]; }];
    gStageFrameBypass = NO;
    if (shift) DMAutoHideNoteFrame(stage);
}
// ---- the screen turns (portrait <-> landscape) ----
// Windows are laid out for one screen shape. When it changes: Fit to Window windows are tiled again for the new shape; every other window
// goes to where it was the last time the screen had that shape, or else to the same relative place and size; frames that no longer fit
// are pulled back inside the screen. Nothing changes which window is in front.
static CGSize gLaidOutScreen = {0, 0};
static CGRect DMFitInto(CGRect f, CGRect usable) {
    f.size.width = MIN(f.size.width, usable.size.width);
    f.size.height = MIN(f.size.height, usable.size.height);
    f.origin.x = MAX(usable.origin.x, MIN(f.origin.x, CGRectGetMaxX(usable) - f.size.width));
    f.origin.y = MAX(usable.origin.y, MIN(f.origin.y, CGRectGetMaxY(usable) - f.size.height));
    return f;
}
static CGRect DMScaleFrame(CGRect f, CGSize from, CGSize to) {
    CGFloat sx = to.width / from.width, sy = to.height / from.height;
    CGRect w = DMA5WindowFromStage(f);   // (Aerial 5.0: the drawn window is what keeps its proportions, not the bigger stage)
    return DMA5StageFromWindow(CGRectMake(w.origin.x * sx, w.origin.y * sy, w.size.width * sx, w.size.height * sy));
}
// Requirement: when a window of a Fit to Window tiling is closed, the others should grow into the space, like the layout was made for them alone. Watched
// from the 0.2 s tick against the group as it was on the previous tick (the app's exit no longer takes it out of the group, see _didExitWithContext:),
// and a window taken out by being dragged or given a layout by hand still has its
// stage, so it is not mistaken for a close. Minimizing is not a close: a minimized window keeps its place and the others don't move.
// Two or more left: they are tiled again for their number (halves, a half and two quarters). One left: it fills the usable area.
// Keyboard Phase (iPad 2, Aerial 5.0): the tiling can end up with slots that overlap -- seen: 4 windows with Settings = "left" (a half) and Safari =
// "topleft" (a quarter) after Settings came back from full screen with the green light while Safari opened, and the state was saved and restored
// like that after a respring (Safari hidden under Settings; fitcheck said ok because each window was exactly in its own slot). When two slots of the
// group overlap for 2 ticks, the group gets the standard slots for its size again, in the windows' order on the screen (left first, then top).
static void DMFitRepairOverlappingSlots(void) {
    static int badTicks = 0;
    if (gFitGroup.count < 2 || gFitSlots.count != gFitGroup.count || !DMFitEnabled()) { badTicks = 0; return; }   // (the cheap checks first)
    BOOL bad = NO;
    NSArray *g = [gFitGroup copy];
    // (perf: the answer depends only on the slot names and the usable area, so it is worked out again only when the slots or the screen change,
    // and at least once a second; the "2 bad ticks in a row" rule below is unchanged)
    static NSDictionary *lastSlots = nil; static CGSize lastScreen; static CFTimeInterval lastAt = 0; static BOOL lastBad = NO, lastNull = NO;
    CFTimeInterval now = CACurrentMediaTime(); CGSize screen = [UIScreen mainScreen].bounds.size;
    if ([lastSlots isEqualToDictionary:gFitSlots] && CGSizeEqualToSize(screen, lastScreen) && now - lastAt < 1.0) {
        if (lastNull) { badTicks = 0; return; }
        bad = lastBad;
    } else {
        BOOL null = NO;
        NSMutableArray<NSValue *> *frames = [NSMutableArray arrayWithCapacity:g.count];   // (each slot frame once, not once per pair)
        for (NSString *b in g) { CGRect f = DMSlotFrame(b); if (CGRectIsNull(f)) { null = YES; break; } [frames addObject:[NSValue valueWithCGRect:f]]; }
        for (NSUInteger i = 0; !null && i < g.count && !bad; i++) for (NSUInteger j = i + 1; j < g.count && !bad; j++) {
            CGRect a = frames[i].CGRectValue, b = frames[j].CGRectValue;
            CGRect x = CGRectIntersection(a, b);
            if (!CGRectIsNull(x) && x.size.width * x.size.height > 0.1 * MIN(a.size.width * a.size.height, b.size.width * b.size.height)) bad = YES;
        }
        lastSlots = [gFitSlots copy]; lastScreen = screen; lastAt = now; lastBad = bad; lastNull = null;
        if (null) { badTicks = 0; return; }
    }
    if (!bad) { badTicks = 0; return; }
    if (++badTicks < 2) return;
    badTicks = 0;
    BOOL (^before)(CGRect, CGRect) = ^BOOL(CGRect a, CGRect b) { return fabs(a.origin.x - b.origin.x) > 16.0 ? a.origin.x < b.origin.x : a.origin.y < b.origin.y; };
    NSArray *members = [g sortedArrayUsingComparator:^NSComparisonResult(NSString *a, NSString *b) {
        CGRect fa = DMStageForBundle(a).frame, fb = DMStageForBundle(b).frame;
        return before(fa, fb) ? NSOrderedAscending : (before(fb, fa) ? NSOrderedDescending : NSOrderedSame);
    }];
    NSArray *names = DMDefaultSlotNames(g.count);
    NSArray *slots = [[names subarrayWithRange:NSMakeRange(0, MIN(names.count, g.count))] sortedArrayUsingComparator:^NSComparisonResult(NSString *a, NSString *b) {
        CGRect fa = DMLayoutFrame(a), fb = DMLayoutFrame(b);
        return before(fa, fb) ? NSOrderedAscending : (before(fb, fa) ? NSOrderedDescending : NSOrderedSame);
    }];
    NSDictionary *old = [gFitSlots copy];
    gFitSlots = [NSMutableDictionary dictionary];
    for (NSUInteger i = 0; i < members.count && i < slots.count; i++) gFitSlots[members[i]] = slots[i];
    DMLog([NSString stringWithFormat:@"[fit] overlapping tiles %@ repaired: %@", old, gFitSlots]);
    gMoveKeepsOrder = YES;
    DMApplyGroupSlots(nil);
    gMoveKeepsOrder = NO;
}
BOOL gFitClosureCheckDue = NO;   // set where a window is marked as closing (and when an app exits): the next tick checks for closed tiles
static void DMWatchFitClosures(void) {
    DM_PERF("fitrepair", DMFitRepairOverlappingSlots());
    for (NSString *b in [gFreeWindows allObjects]) if (!DMStageForBundle(b)) { [gFreeWindows removeObject:b]; DMLog([NSString stringWithFormat:@"[fit] %@ (No Fit) closed: tiled again next time", b]); }
    static NSArray<NSString *> *previous = nil;
    NSArray<NSString *> *now = gFitGroup ? [gFitGroup copy] : @[];
    NSArray<NSString *> *before = previous;
    previous = now;
    if (!before.count || !DMFitEnabled()) return;
    // (perf: the per-tile check runs when something happened -- the stage list changed (a window came or went, by us or the engine), the group
    // changed, a window was marked as closing or an app exited, or a tile was held for SofaScore's relaunch last time -- and at least once a
    // second as a safety net; otherwise nothing can have closed. Before, it ran on every 0.2 s tick.)
    static NSArray *lastStages = nil; static CFTimeInterval lastFull = 0; static BOOL heldForSofa = NO;
    NSArray *stagesNow = DMAerialStages();
    CFTimeInterval t = CACurrentMediaTime();
    BOOL due = gFitClosureCheckDue || heldForSofa || t - lastFull >= 1.0 || ![before isEqualToArray:now] || !lastStages || ![lastStages isEqualToArray:stagesNow];
    lastStages = [stagesNow copy];
    if (!due) return;
    gFitClosureCheckDue = NO; lastFull = t; heldForSofa = NO;
    NSMutableArray<NSString *> *closed = [NSMutableArray array];
    extern BOOL DMSofaRelaunchKeepsFrame(NSString *bundleID);
    for (NSString *b in before) {
        UIView *st = DMStageForBundle(b);
        if (DMSofaRelaunchKeepsFrame(b)) { heldForSofa = YES; continue; }   // SofaScore's quick relaunch is not a close: it keeps its tile and the others stay put
        if (!st || [objc_getAssociatedObject(st, kStageClosingKey) boolValue]) [closed addObject:b];
    }
    if (!closed.count) return;
    for (NSString *b in closed) DMFitGroupForget(b);
    NSMutableArray<NSString *> *left = [NSMutableArray array];
    for (NSString *b in before) if (![closed containsObject:b] && [gFitGroup containsObject:b] && DMStageTakesPartInFit(DMStageForBundle(b))) [left addObject:b];
    if (!left.count) { previous = gFitGroup ? [gFitGroup copy] : @[]; return; }
    gFitGroup = left;
    if (left.count >= 2) DMAssignDefaultSlots();
    else gFitSlots = [@{ left[0]: @"fill" } mutableCopy];
    DMLog([NSString stringWithFormat:@"[fit] %@ closed: %lu window(s) left, re-tiled to fill the space", [closed componentsJoinedByString:@", "], (unsigned long)left.count]);
    gMoveKeepsOrder = YES;
    DMApplyGroupSlots(nil);
    gMoveKeepsOrder = NO;
    previous = [gFitGroup copy];
}
// A window still flying in from full screen (kStageEnteringKey) when the screen turns is left to land, then placed for the new shape (layering audit
// F6: the turn's move interrupted the fly-in, which showed as a jump). Its landing frame belongs to the old shape, so it is scaled from there (or
// its Fit tile is used); the frame it remembered on landing is corrected by the move itself (DMAerialMoveStage remembers the new one).
static void DMRelayoutStageWhenLanded(UIView *stage, CGSize oldSize, CGSize newSize, int attempt) {
    if (!stage || !stage.window || !CGSizeEqualToSize([UIScreen mainScreen].bounds.size, newSize)) return;   // (gone, or turned again: that turn handles it)
    if ([objc_getAssociatedObject(stage, kStageEnteringKey) boolValue] && attempt < 20) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRelayoutStageWhenLanded(stage, oldSize, newSize, attempt + 1); });
        return;
    }
    if (stage.hidden || DMStageMinimized(stage) || [objc_getAssociatedObject(stage, kStageClosingKey) boolValue]) return;
    NSString *b = DMStageBundle(stage);
    CGRect usable = DMLayoutFrame(@"fill");
    if (!b.length || CGRectIsNull(usable)) return;
    CGRect f;
    if ([gFitGroup containsObject:b]) f = DMSlotFrame(b);
    else {   // (layering audit #8: the frame it had in this orientation before, as the normal turn uses; else the landing frame scaled with ONE factor
             //  around its centre -- scaling each axis on its own stretched a landscape frame to 455 x 1093 in portrait on the M1)
        NSValue *saved = [objc_getAssociatedObject(stage, kStageByOrientKey) objectForKey:DMOrientKey()];
        if (saved) f = DMFitInto(saved.CGRectValue, usable);
        else {
            CGRect from = DMA5WindowFromStage(stage.frame);   // (Aerial 5.0: the drawn window keeps its proportions, as in DMScaleFrame)
            CGFloat sx = oldSize.width > 0 ? newSize.width / oldSize.width : 1.0, sy = oldSize.height > 0 ? newSize.height / oldSize.height : 1.0, k = MIN(sx, sy);
            CGSize size = CGSizeMake(from.size.width * k, from.size.height * k);
            CGPoint centre = CGPointMake(CGRectGetMidX(from) * sx, CGRectGetMidY(from) * sy);
            f = DMFitInto(DMA5StageFromWindow(CGRectMake(centre.x - size.width / 2.0, centre.y - size.height / 2.0, size.width, size.height)), usable);
        }
    }
    if (CGRectIsNull(f)) return;
    DMLog([NSString stringWithFormat:@"[orient] %@ landed after the turn: placed for the new shape at %@", b, NSStringFromCGRect(f)]);
    gMoveKeepsOrder = YES; DMAerialMoveStage(stage, f, nil); gMoveKeepsOrder = NO;
}
static void DMRelayoutForOrientation(CGSize oldSize, CGSize newSize) {
    if (!CGSizeEqualToSize([UIScreen mainScreen].bounds.size, newSize)) return;   // it turned again meanwhile: the next change handles it
    NSString *newKey = DMOrientKey();
    CGRect usable = DMLayoutFrame(@"fill");
    if (CGRectIsNull(usable)) return;
    DMLog([NSString stringWithFormat:@"[orient] screen %@ -> %@ (%@): arranging %lu windows", NSStringFromCGSize(oldSize), NSStringFromCGSize(newSize), newKey, (unsigned long)DMAerialStages().count]);
    gDMTouchWatchArm = 2; gDMTouchWatchWhy = @"a turn";   // (debug touchwatch: two corner "touches" were seen right after turns)
    NSMutableSet<NSString *> *done = [NSMutableSet set];
    NSMutableDictionary<NSString *, NSValue *> *targets = [NSMutableDictionary dictionary];   // where each shown window was put (checked again below)
    gMoveKeepsOrder = YES;
    // Fit to Window: tiled again for the new shape
    for (NSString *b in [gFitGroup copy]) if (!DMStageTakesPartInFit(DMStageForBundle(b))) [gFitGroup removeObject:b];
    BOOL tiled = gFitGroup.count >= 2;
    if (tiled && gFitSlots.count != gFitGroup.count) {
        // A window left the group (minimized or closed) since the last tiling: the others are tiled again, but they keep their order on the screen
        // (left stays left, top stays top). Before, the default "newest first" order was used, which swapped Notes and Settings after Clock was
        // minimized and the iPad turned (iPad 2, raw captures).
        NSArray *names = DMDefaultSlotNames(gFitGroup.count);
        BOOL (^before)(CGRect, CGRect) = ^BOOL(CGRect a, CGRect b) { return fabs(a.origin.x - b.origin.x) > 16.0 ? a.origin.x < b.origin.x : a.origin.y < b.origin.y; };
        BOOL allKnown = names.count >= gFitGroup.count;
        for (NSString *b in gFitGroup) if (!gFitSlots[b] || CGRectIsNull(DMLayoutFrame(gFitSlots[b]))) allKnown = NO;
        if (allKnown) {
            NSArray *members = [gFitGroup sortedArrayUsingComparator:^NSComparisonResult(NSString *a, NSString *b) {
                CGRect fa = DMLayoutFrame(gFitSlots[a]), fb = DMLayoutFrame(gFitSlots[b]);
                return before(fa, fb) ? NSOrderedAscending : (before(fb, fa) ? NSOrderedDescending : NSOrderedSame);
            }];
            NSArray *slots = [[names subarrayWithRange:NSMakeRange(0, gFitGroup.count)] sortedArrayUsingComparator:^NSComparisonResult(NSString *a, NSString *b) {
                CGRect fa = DMLayoutFrame(a), fb = DMLayoutFrame(b);
                return before(fa, fb) ? NSOrderedAscending : (before(fb, fa) ? NSOrderedDescending : NSOrderedSame);
            }];
            gFitSlots = [NSMutableDictionary dictionary];
            for (NSUInteger i = 0; i < members.count; i++) gFitSlots[members[i]] = slots[i];
            DMLog([NSString stringWithFormat:@"[orient] Fit to Window: %lu windows tiled again in their order on the screen: %@", (unsigned long)members.count, gFitSlots]);
        } else DMAssignDefaultSlots();
    }
    if (tiled) for (NSUInteger i = 0; i < gFitGroup.count; i++) {
        UIView *s = DMStageForBundle(gFitGroup[i]);
        if (!s) continue;
        [done addObject:gFitGroup[i]];
        if ([objc_getAssociatedObject(s, kStageEnteringKey) boolValue]) { DMRelayoutStageWhenLanded(s, oldSize, newSize, 0); continue; }   // (flying in: placed once landed)
        CGRect f = DMSlotFrame(gFitGroup[i]);
        if (CGRectIsNull(f)) continue;
        if (s.hidden || DMStageMinimized(s)) { gStageFrameBypass = YES; s.frame = f; gStageFrameBypass = NO; DMSetStageIntent(s, f); }
        else { DMAerialMoveStage(s, f, nil); targets[gFitGroup[i]] = [NSValue valueWithCGRect:f]; }
    }
    // The Dock is still settling into the new shape while this runs, so the tiles' bottom edge (measured from the Dock's top) can be off by a few
    // points (iPad 2, Zetsu: 903.9 instead of 898.9 tall after turning back to portrait). Once it has settled the tiles are checked again.
    if (tiled) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!CGSizeEqualToSize([UIScreen mainScreen].bounds.size, newSize)) return;
        gMoveKeepsOrder = YES;
        for (NSString *b in [gFitGroup copy]) {
            UIView *st = DMStageForBundle(b); CGRect f = DMSlotFrame(b), cur = st.frame;
            if (!st || CGRectIsNull(f) || st.hidden || DMStageMinimized(st) || [objc_getAssociatedObject(st, kStageGestureKey) boolValue]) continue;
            if (fabs(f.origin.x - cur.origin.x) <= 1.0 && fabs(f.origin.y - cur.origin.y) <= 1.0 && fabs(f.size.width - cur.size.width) <= 1.0 && fabs(f.size.height - cur.size.height) <= 1.0) continue;
            DMLog([NSString stringWithFormat:@"[orient] %@: its tile after the Dock settled is %@ (was %@): moved", b, NSStringFromCGRect(f), NSStringFromCGRect(cur)]);
            DMAerialMoveStage(st, f, nil);
        }
        gMoveKeepsOrder = NO;
    });
    // every other window
    for (UIView *s in DMAerialStages()) {
        NSString *b = DMStageBundle(s);
        if (!b.length || [done containsObject:b]) continue;
        if ([objc_getAssociatedObject(s, kStageClosingKey) boolValue]) continue;   // (going full screen or closing: it is leaving, a move now only jumps it)
        if ([objc_getAssociatedObject(s, kStageEnteringKey) boolValue]) { DMRelayoutStageWhenLanded(s, oldSize, newSize, 0); continue; }   // (flying in: placed once landed)
        NSValue *saved = [objc_getAssociatedObject(s, kStageByOrientKey) objectForKey:newKey];
        NSValue *was = objc_getAssociatedObject(s, kStageIntentKey);
        CGRect from = was ? was.CGRectValue : s.frame;
        NSValue *fromSize = objc_getAssociatedObject(s, kStageIntentSizeKey);
        CGSize fromScreen = fromSize ? fromSize.CGSizeValue : oldSize;
        CGRect f = DMFitInto(saved ? saved.CGRectValue : DMScaleFrame(from, fromScreen, newSize), usable);
        if (s.hidden || DMStageMinimized(s)) { gStageFrameBypass = YES; s.frame = f; gStageFrameBypass = NO; DMSetStageIntent(s, f); }
        else { DMAerialMoveStage(s, f, nil); targets[b] = [NSValue valueWithCGRect:f]; }
    }
    gMoveKeepsOrder = NO;
    // Aerial 3.0 (M1, iOS 15, full-screen app in front) keeps a frame per orientation of its own: right after our arrangement its layout pass put every
    // window back to that remembered frame -- once squeezed (its _adjustStageToFitScreenIfNeeded shrinks a portrait-tall window to fit a landscape
    // screen, keeping the shape: 293 x 794, centred, all windows on top of each other), squeezed again in that orientation until it learns our frame
    // (it does after one correction). Checked 0.2 s and 0.7 s later: a window that is not where we put it is put there again (no back-and-forth).
    if (targets.count && DMActiveEngine() == DMEngineAerial) for (NSNumber *delay in @[@0.2, @0.7]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!CGSizeEqualToSize([UIScreen mainScreen].bounds.size, newSize)) return;
        for (NSString *b in targets) {
            UIView *s = DMStageForBundle(b);
            CGRect want = targets[b].CGRectValue, now = s.frame;
            if (!s || s.hidden || DMStageMinimized(s)) continue;
            if (fabs(now.origin.x - want.origin.x) < 4 && fabs(now.origin.y - want.origin.y) < 4 && fabs(now.size.width - want.size.width) < 4 && fabs(now.size.height - want.size.height) < 4) continue;
            DMLog([NSString stringWithFormat:@"[orient] %@ was moved to %@ after our arrangement (Aerial's remembered frame for this orientation): put back to %@", b, NSStringFromCGRect(now), NSStringFromCGRect(want)]);
            gMoveKeepsOrder = YES; DMAerialMoveStage(s, want, nil); gMoveKeepsOrder = NO;
        }
    });
    for (NSString *b in [gLastWindowFrames allKeys]) {   // the places remembered for the green button
        CGRect f = gLastWindowFrames[b].CGRectValue;
        gLastWindowFrames[b] = [NSValue valueWithCGRect:DMFitInto(DMScaleFrame(f, oldSize, newSize), usable)];
    }
    // the saved window state follows the turn (it kept the old shape's frames: after a respring in the other shape the tiles came back scaled)
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSaveWindowState(); });
}
// Is a hardware keyboard (Magic Keyboard, Smart Keyboard, Bluetooth or wired) attached right now? This is the same flag UIKit itself uses to decide
// between the on-screen keyboard and the shortcut bar / pill. Without one, nothing in this tweak may touch the keyboard or its pill.
static BOOL gPretendNoHardwareKeyboard = NO;   // debug (trigger hwkb_0 / hwkb_1): SpringBoard behaves as if the hardware keyboard were gone
static BOOL DMHardwareKeyboardAttached(void) {
    if (gPretendNoHardwareKeyboard) return NO;
    static BOOL (*attached)(void) = NULL; static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *gs = dlopen("/System/Library/PrivateFrameworks/GraphicsServices.framework/GraphicsServices", RTLD_LAZY);
        if (gs) attached = (BOOL (*)(void))dlsym(gs, "GSEventIsHardwareKeyboardAttached");
    });
    return attached ? attached() : YES;   // if the flag cannot be read, behave as before
}
// ---- the keyboard / microphone pill ----
// With a hardware keyboard attached, iPadOS shows a small pill (keyboard + microphone) in the bottom right corner while you type; it sat on
// top of the Dock's last icon. It is drawn in SpringBoard's hosted-keyboard window (SBMedusaHostedKeyboardWindow, a portrait-sized window
// whatever the orientation), so its own buttons cannot be replaced, but the whole window can be scaled and moved. While the pill is alone
// (no on-screen keyboard up) that window is scaled down to about status bar height and moved just left of the Control Center icons; it
// only shows while it is active anyway. The mapping between the window's own (portrait) space and the screen depends on the orientation.
static CGPoint DMScreenToNative(CGPoint s, long orientation, CGSize native) {
    switch (orientation) {
        case 3:  return CGPointMake(native.width - s.y, s.x);                       // landscape, home button right
        case 4:  return CGPointMake(s.y, native.height - s.x);                      // landscape, home button left
        case 2:  return CGPointMake(native.width - s.x, native.height - s.y);       // upside down
        default: return s;                                                          // portrait
    }
}
// The pill's picture is run through a colour filter so it looks like the other status bar items: the dark capsule becomes transparent and
// the glyphs are drawn in the status bar's text colour.
typedef struct { float m11, m12, m13, m14, m15, m21, m22, m23, m24, m25, m31, m32, m33, m34, m35, m41, m42, m43, m44, m45; } DMColorMatrix;
static id DMPillFilter(UIColor *color) {
    Class filterClass = objc_getClass("CAFilter");
    if (!filterClass) return nil;
    CGFloat r = 1, g = 1, b = 1, a = 1;
    [color getRed:&r green:&g blue:&b alpha:&a];
    const float w = 14.0f, thr = 0.37f;   // alpha follows the brightness: glyphs (grey) opaque, the dark capsule gone
    DMColorMatrix m = { 0,0,0,0,(float)r,  0,0,0,0,(float)g,  0,0,0,0,(float)b,  w/3.0f,w/3.0f,w/3.0f,0,-w*thr };
    id f = ((id (*)(id, SEL, id))objc_msgSend)((id)filterClass, NSSelectorFromString(@"filterWithType:"), @"colorMatrix");
    [f setValue:[NSValue valueWithBytes:&m objCType:"{CAColorMatrix=ffffffffffffffffffff}"] forKey:@"inputColorMatrix"];   // Core Animation wants this exact type name
    return f;
}
// The pill is drawn in one of two windows: the system's hosted-keyboard window (full-screen apps; portrait-sized in every orientation) or, while an
// app is in an Aerial window, Aerial's own keyboard window (screen-sized, its hosted keyboard scene turned inside it). Both are handled the same way;
// only where the window's own space lies differs (the Aerial one is in screen space).
static const void *kPillMovedKey = &kPillMovedKey;
static CFTimeInterval gPillMovedAt = -100.0;   // when DMPlaceKeyboardPillIn last kept a pill moved (DMPlaceKeyboardPill)
static void DMPlaceKeyboardPillIn(UIView *pillWindow, BOOL screenSpace, BOOL hardwareKeyboard, CGFloat keyboardH) {
    BOOL wasMoved = [objc_getAssociatedObject(pillWindow, kPillMovedKey) boolValue];
    if (!hardwareKeyboard && !wasMoved) return;   // no hardware keyboard: this window is not ours to touch (it can hold the on-screen keyboard itself)
    long orientation = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"));
    CGSize screen = [UIScreen mainScreen].bounds.size;
    CGSize native = CGSizeMake(MIN(screen.width, screen.height), MAX(screen.width, screen.height));   // the hosted scene's own space is always portrait
    CGSize space = screenSpace ? screen : native;   // the space the window itself is laid out in
    BOOL move = hardwareKeyboard && gTidyKeyboardPill && [NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 && keyboardH < 1.0 && gStatusIconsLeft > 100.0 && !pillWindow.hidden;   // (iPadOS 16 draws it differently: see the notes)
    CGAffineTransform want = CGAffineTransformIdentity;
    if (move) {
        const CGFloat scale = 0.52, pillW = 125.0;
        CGPoint pill = CGPointMake(screen.width - 67.0, screen.height - 38.0);                 // the pill's centre on the screen, stock place
        CGPoint target = CGPointMake(gStatusIconsLeft + 11.0 - pillW * scale / 2.0 - ((gSSHActive || gMuteIconShown) ? 5.0 : 0.0), 12.0);   // just left of the status icons (the capsule around the glyphs is invisible now, so its padding is subtracted)
        CGPoint C = CGPointMake(space.width / 2.0, space.height / 2.0);
        CGPoint n0 = screenSpace ? pill : DMScreenToNative(pill, orientation, native), nt = screenSpace ? target : DMScreenToNative(target, orientation, native);
        want = CGAffineTransformMake(scale, 0, 0, scale, nt.x - C.x - scale * (n0.x - C.x), nt.y - C.y - scale * (n0.y - C.y));
    } else if (!wasMoved) return;
    if (!CGAffineTransformEqualToTransform(pillWindow.transform, want))
        [UIView animateWithDuration:0.18 delay:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{ pillWindow.transform = want; } completion:nil];
    // The picture's colour filter and glyph mask. Not only when the pill switches on: the hosted scene of the Aerial keyboard window is built later (the first
    // time an app asks for the keyboard), so whichever views are there and not styled yet (or styled and no longer wanted) are brought in line on every pass.
    NSMutableArray<UIView *> *targets = [NSMutableArray array];
    {
        NSMutableArray *stack = [NSMutableArray arrayWithObject:pillWindow];
        while (stack.count) {   // the views that hold the hosted keyboard picture
            UIView *v = stack.lastObject; [stack removeLastObject];
            NSString *cn = NSStringFromClass([v class]);
            if ([cn isEqualToString:@"_UIScenePresentationView"] || [cn isEqualToString:@"_UISceneLayerHostContainerView"]) { [targets addObject:v]; continue; }
            [stack addObjectsFromArray:v.subviews];
        }
    }
    BOOL restyle = NO;
    for (UIView *v in targets) if (move != (v.layer.mask != nil)) restyle = YES;
    if (restyle) {
        id filter = move ? DMPillFilter(gStatusTextColor ?: [UIColor whiteColor]) : nil;
        // Only the two glyphs may show: a mask leaves small areas around the keyboard and the microphone (the picture is in the scene's own
        // portrait space, so their places are converted from the pill's stock place on the screen). The capsule, its edge and its blur never appear.
        CGPathRef maskPath = NULL;
        if (move) {
            const CGSize glyphs[2] = { {50.0, 32.0}, {32.0, 32.0} };       // the areas around the keyboard glyph and the microphone glyph
            const CGFloat centreDX[2] = { -30.0, 19.0 };                     // their centres, left / right of the pill's centre on the screen
            CGPoint pill = CGPointMake(screen.width - 67.0, screen.height - 38.0);
            CGMutablePathRef path = CGPathCreateMutable();
            for (int i = 0; i < 2; i++) {
                CGPoint c = DMScreenToNative(CGPointMake(pill.x + centreDX[i], pill.y), orientation, native);
                BOOL turned = (orientation == 3 || orientation == 4);
                CGSize sz = turned ? CGSizeMake(glyphs[i].height, glyphs[i].width) : glyphs[i];
                CGPathAddRoundedRect(path, NULL, CGRectMake(c.x - sz.width / 2.0, c.y - sz.height / 2.0, sz.width, sz.height), 8.0, 8.0);
            }
            maskPath = path;   // released below
        }
        for (UIView *v in targets) {
            v.layer.filters = filter ? @[filter] : nil;
            if (maskPath) { CAShapeLayer *mask = [CAShapeLayer layer]; mask.frame = CGRectMake(0, 0, native.width, native.height); mask.path = maskPath; v.layer.mask = mask; }
            else v.layer.mask = nil;
        }
        if (maskPath) CGPathRelease(maskPath);
        DMLog([NSString stringWithFormat:@"[pill] %@ colour filter %@ on %lu views (text colour %@)", NSStringFromClass([pillWindow class]), filter ? @"on" : @"off", (unsigned long)targets.count, gStatusTextColor]);
    }
    objc_setAssociatedObject(pillWindow, kPillMovedKey, @(move), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (move || wasMoved) gPillMovedAt = CACurrentMediaTime();
}
// Debug timeline (only while the debug flag exists): every window that holds a keyboard host view or a hosted scene, with the geometry, logged whenever
// something changes (a Bluetooth keyboard coming or going, Spotlight opening, the screen turning).
static BOOL gKbLogAgain = NO;   // debug: log the keyboard state once more even if nothing changed (trigger kbstate)
static void DMKeyboardTimeline(void) {
    if (!DMTestFlag("/tmp/msb-kbtimeline")) return;   // (its own flag: it walks every view of every window, ~each tick -- no longer on with the debug flag)
    static NSString *last = nil;
    if (gKbLogAgain) last = nil;
    NSMutableString *st = [NSMutableString string];
    for (UIWindow *w in DMAllWindows()) {
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        NSMutableString *inner = [NSMutableString string];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
            NSString *cn = NSStringFromClass([v class]);
            if ([cn isEqualToString:@"_UIKeyboardLayerHostView"] || [cn isEqualToString:@"_UIScenePresentationView"]) {
                NSString *ident = nil; long o = -1; CGRect f = CGRectZero;
                if ([cn isEqualToString:@"_UIScenePresentationView"]) {
                    id scene = nil; @try { scene = [v valueForKey:@"scene"]; } @catch (id e) {}
                    ident = [scene respondsToSelector:NSSelectorFromString(@"identifier")] ? [scene valueForKey:@"identifier"] : nil;
                    if (![ident containsString:@"keyboard"]) continue;
                    id settings = [scene valueForKey:@"settings"];
                    o = [settings respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientation")) : -1;
                    f = [settings respondsToSelector:NSSelectorFromString(@"frame")] ? ((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame")) : CGRectZero;
                }
                [inner appendFormat:@"\n    %@ frame %@ bounds %@ tf %@ hidden %d alpha %.2f", cn, NSStringFromCGRect(v.frame), NSStringFromCGRect(v.bounds), NSStringFromCGAffineTransform(v.transform), v.hidden, v.alpha];
                if (ident) [inner appendFormat:@" scene %@ orientation %ld frame %@", ident, o, NSStringFromCGRect(f)];
            }
        }
        if (inner.length) [st appendFormat:@"\n  %@ level %.1f hidden %d alpha %.2f frame %@ tf %@%@", NSStringFromClass([w class]), w.windowLevel, w.hidden, w.alpha, NSStringFromCGRect(w.frame), NSStringFromCGAffineTransform(w.transform), inner];
    }
    for (UIView *stage in DMAerialStages()) {   // the app scenes of the windows: the keyboard picture is laid out by the focused app
        NSString *b = DMStageBundle(stage); id scene = DMSceneForBundle(b); id settings = nil;
        @try { settings = [scene valueForKey:@"settings"]; } @catch (id e) {}
        long so = [settings respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientation")) : -1;
        long sm = [settings respondsToSelector:NSSelectorFromString(@"interfaceOrientationMode")] ? (long)((long long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientationMode")) : -1;
        CGRect sf = [settings respondsToSelector:NSSelectorFromString(@"frame")] ? ((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame")) : CGRectZero;
        [st appendFormat:@"\n  app scene %@: orientation %ld mode %ld frame %@ foreground %d, window %@", b, so, sm, NSStringFromCGRect(sf), DMSettingsForeground(settings), NSStringFromCGRect(stage.frame)];
    }
    long o = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"));
    NSString *state = [NSString stringWithFormat:@"orientation %ld screen %@ hardware keyboard %d%@", o, NSStringFromCGSize([UIScreen mainScreen].bounds.size), DMHardwareKeyboardAttached(), st];
    if (![state isEqualToString:last]) { last = state; DMLog([NSString stringWithFormat:@"[kbtimeline] %@", state]); }
}
// iPadOS 16 keyboard in a window, turned screen: the keyboard scene is drawn as if for a portrait screen (768 wide, its keys at the bottom of a picture
// that is 1024 tall), so in a landscape screen the keys end up below the bottom edge and only the bar above them shows. Aerial's keyboard window is not
// turned like SpringBoard's own keyboard windows are. The picture is upright in that window already, so it only has to be lifted by the difference in
// height (its bottom edge onto the screen's) and stretched sideways to the screen's width. The keyboard scene itself is NOT touched: it is one scene that
// SpringBoard's own keyboard windows (Spotlight, the pill) share, and changing its orientation or size there turned their keyboard sideways.
// Portrait is left alone, except for the bar: with a hardware keyboard the keyboard scene shows only the app's own input bar (language button,
// suggestions, dictation, the app's buttons) at the very bottom, over the Dock. It is lifted so its bottom edge sits just above the Dock.
// iPadOS 15: Aerial sets the keyboard host up (portrait canvas turned by a quarter for a landscape scene, plain for a portrait one) only when the keyboard
// scene is laid out, not when the iPad is turned, so after a rotation the host kept the geometry of the other orientation (sideways, zoomed, or nowhere). The
// host is set from the front window's scene orientation (which is kept in line with the screen, see DMPortraitWindowSettings) whenever it differs.
static void DMFixKeyboardHostIOS15(void) {
    UIView *top = DMTopStage(); NSString *bundle = top ? DMStageBundle(top) : nil; id scene = bundle.length ? DMSceneForBundle(bundle) : nil; id settings = nil;
    @try { settings = [scene valueForKey:@"settings"]; } @catch (id e) {}
    if (![settings respondsToSelector:NSSelectorFromString(@"interfaceOrientation")]) return;
    long so = ((long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientation"));
    CGSize screen = [UIScreen mainScreen].bounds.size;
    BOOL landscapeScreen = screen.width > screen.height;
    for (UIWindow *w in DMAllWindows()) {
        if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
        UIView *host = nil;
        for (UIView *v in w.subviews) if ([NSStringFromClass([v class]) isEqualToString:@"_UIKeyboardLayerHostView"]) host = v;
        if (!host) continue;
        CGPoint centre = CGPointMake(w.bounds.size.width / 2.0, w.bounds.size.height / 2.0);
        CGSize bounds; CGAffineTransform t;
        if (landscapeScreen && (so == 3 || so == 4)) { bounds = CGSizeMake(MIN(screen.width, screen.height), MAX(screen.width, screen.height)); t = CGAffineTransformMakeRotation(so == 3 ? -M_PI_2 : M_PI_2); }
        else if (!landscapeScreen && so == 1) { bounds = w.bounds.size; t = CGAffineTransformIdentity; }
        else continue;   // scene and screen do not agree yet (a moment after a turn): nothing to set
        if (CGSizeEqualToSize(host.bounds.size, bounds) && CGAffineTransformEqualToTransform(host.transform, t) && fabs(host.center.x - centre.x) < 0.5 && fabs(host.center.y - centre.y) < 0.5) continue;
        host.transform = CGAffineTransformIdentity;
        host.bounds = CGRectMake(0, 0, bounds.width, bounds.height);
        host.center = centre;
        host.transform = t;
        DMLog([NSString stringWithFormat:@"[kbfix] iPadOS 15: keyboard host set for scene orientation %ld on a %@ screen (bounds %@)", so, landscapeScreen ? @"landscape" : @"portrait", NSStringFromCGSize(bounds)]);
    }
}
static void DMFixKeyboardOrientation(BOOL barOnly) {
    DMKeyboardTimeline();
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16) { DMFixKeyboardHostIOS15(); return; }
    long o = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"));
    CGSize screen = [UIScreen mainScreen].bounds.size;
    // SpringBoard's own idea of the interface orientation follows whichever app is in front and can say "portrait" on a landscape screen (a window whose app
    // scene is portrait), so the screen's shape decides, and the device's orientation says which way it is turned.
    if (screen.width > screen.height && o != 3 && o != 4) {
        long l = DMLandscapeSide();   // (see DMLandscapeSide: the old device mapping here was the wrong way round)
        o = l ? l : gLastConfidentLandscapeOrientation;
    }
    BOOL landscape = (o == 3 || o == 4) && screen.width > screen.height;
    CGSize portrait = CGSizeMake(MIN(screen.width, screen.height), MAX(screen.width, screen.height));
    CGFloat stretch = screen.width / portrait.width;
    for (UIWindow *w in DMAllWindows()) {
        if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
        UIView *host = nil;
        for (UIView *v in w.subviews) if ([NSStringFromClass([v class]) isEqualToString:@"_UIKeyboardLayerHostView"]) host = v;
        if (!host) continue;
        // Aerial 5.0 puts its keyboard host back to an identity transform (and its own frame) right after any change (read back 2 s later on iPad 2):
        // our transform on the host was undone every time, the two fought every 0.2 s and no keyboard showed at all in a window. The view inside it
        // (_UIScenePresentationView, the keyboard picture itself) is not touched by Aerial, so on 5.0 the same lift / stretch goes there (verified with
        // a raw capture: full-width upright keyboard at the bottom). Its own centre is the pivot instead of the window's.
        if (gAerialFlavor == 5) {
            UIView *picture = nil;
            for (UIView *c in host.subviews) if ([NSStringFromClass([c class]) isEqualToString:@"_UIScenePresentationView"]) picture = c;
            if (picture) host = picture;
        }
        CGPoint pivot = CGPointMake(host.bounds.size.width / 2.0, host.bounds.size.height / 2.0);   // a view's transform turns about its own centre
        CGFloat aboveDock = 0.0;   // how far the bar has to go up to clear the Dock
        if (barOnly && DMDockOnScreen()) {   // (Keyboard Phase: only while the Dock is really on the screen -- behind a full-screen app it waits below the
            // screen, and the bar then floated ~90 pt up over the windows with nothing under it; now it sits at the bottom edge like the stock bar)
            CGRect usable = DMUsableArea();
            if (!CGRectIsEmpty(usable)) aboveDock = MAX(0.0, screen.height - (CGRectGetMaxY(usable) + 2.0) + 4.0);
        }
        CGAffineTransform want = CGAffineTransformMake(1, 0, 0, 1, 0, -aboveDock);
        if (landscape && barOnly) {
            // the bar as a small pill: scaled down (like the pill of iPadOS 15), in the middle of the Dock and its bottom edge just above the Dock.
            // Where the bar's middle and bottom edge are in the picture (768 x 1024) was measured (middle 314, bottom 1019).
            const CGFloat scale = 0.62, barMiddle = 314.25, barBottom = 1019.0;
            CGPoint centre = gAerialFlavor == 5 ? pivot : CGPointMake(w.bounds.size.width / 2.0, w.bounds.size.height / 2.0);
            want = CGAffineTransformMake(scale, 0, 0, scale, DMDockCenterX() - centre.x - scale * (barMiddle - centre.x), screen.height - MAX(aboveDock, 6.0) - centre.y - scale * (barBottom - centre.y));   // (6 pt off the bottom edge when there is no Dock under it)
        } else if (landscape) want = CGAffineTransformMake(stretch, 0, 0, 1, (gAerialFlavor == 5 ? pivot.x : w.bounds.size.width / 2.0) * (stretch - 1.0), -(portrait.height - screen.height) - aboveDock);   // stretched from the left edge, lifted
        if (DMTestFlag("/tmp/msb-kbfix-off")) want = CGAffineTransformIdentity;   // debug: see Aerial's own keyboard placement
        if (!CGAffineTransformEqualToTransform(host.transform, want)) {
            static BOOL wasBar = NO;
            if (barOnly != wasBar) [UIView animateWithDuration:0.2 delay:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{ host.transform = want; } completion:nil];   // the bar comes and goes smoothly
            else host.transform = want;
            wasBar = barOnly;
            DMLog([NSString stringWithFormat:@"[kbfix] keyboard host %@ (orientation %ld, bar only %d, above the Dock by %.0f, host bounds %@)", landscape ? @"lifted and stretched" : @"back to normal", o, barOnly, aboveDock, NSStringFromCGSize(host.bounds.size)]);
        }
    }
}
// Idle trim (2026-09-25): the keyboard walk below (every view of the keyboard windows, 5x a second) is only needed by the Keyboard Button (the
// pill in the status bar) and by keyboards of apps in windows (gSoftKeyboardH / gKbBarOnly, the window keyboard's lift and turn, Aerial's keyboard
// window). With the Keyboard Button off and no window (DMWindowWorkNeeded: none for 3 s), nothing reads its results, so it rests; the next watcher
// pass after a window appears (or the button is switched on) runs it again before anything else asks. It also runs for 5 s after the pill was last
// moved, so switching the button off still puts the pill back. /tmp/msb-kbcheck-always: the old behaviour (A/B).
static void DMPlaceKeyboardPill(void) {
    if (!gTidyKeyboardPill && CACurrentMediaTime() - gPillMovedAt > 5.0 && !DMWindowWorkNeeded() && !DMTestFlag("/tmp/msb-kbcheck-always")) return;
    BOOL hardwareKeyboard = DMHardwareKeyboardAttached();
    CGFloat keyboardH = 0.0;
    NSString *hostDebug = @"-";
    UIWindow *medusa = nil, *aerialKeyboard = nil;
    UIView *milkyWayKeyboard = nil;   // MilkyWay's keyboard window is turned as a whole, so its hosted keyboard view (in the scene's own portrait space) is what moves
    for (UIWindow *w in DMAllWindows()) {
        NSString *wc = NSStringFromClass([w class]);
        if ([wc isEqualToString:@"AXPassthroughWindow"]) { for (UIView *v in w.subviews) if ([NSStringFromClass([v class]) isEqualToString:@"_UIKeyboardLayerHostView"]) milkyWayKeyboard = v; continue; }
        if ([wc isEqualToString:@"SBMedusaHostedKeyboardWindow"]) { medusa = w; continue; }
        if ([wc isEqualToString:@"AerialKeyboardWindow"]) { aerialKeyboard = w; continue; }
        if (![wc isEqualToString:@"UITextEffectsWindow"]) continue;
        if (w.hidden) continue;   // (a hidden one always counts 0 below: its views are not walked)
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            if ([NSStringFromClass([v class]) isEqualToString:@"UIInputSetHostView"]) {
                // How much of the screen the keyboard's host really covers: a keyboard that has been put away (a hardware keyboard came) can keep its height while
                // it sits below the screen, and that must not count as "a software keyboard is up".
                CGRect onScreen = CGRectIntersection([v.superview convertRect:v.frame toCoordinateSpace:[UIScreen mainScreen].coordinateSpace], [UIScreen mainScreen].bounds);
                CGFloat shown = (v.hidden || v.alpha < 0.01 || w.hidden || CGRectIsNull(onScreen)) ? 0.0 : MIN(onScreen.size.height, v.frame.size.height);
                keyboardH = MAX(keyboardH, shown);
                if (DMTestFlag("/tmp/macstatusbar-debug")) hostDebug = [NSString stringWithFormat:@"host frame %@ on screen %@ hidden %d alpha %.2f", NSStringFromCGRect(v.frame), NSStringFromCGRect(onScreen), v.hidden, v.alpha];
            }
            [stack addObjectsFromArray:v.subviews];
        }
    }
    if (DMTestFlag("/tmp/macstatusbar-debug")) {
        static NSString *lastIn = nil;
        if (gKbLogAgain) lastIn = nil;
        NSString *in = [NSString stringWithFormat:@"[pillstate] hardware %d keyboardH %.0f icons start %.1f tidy %d medusa %@ (hidden %d) aerial %@ (hidden %d, tf %@) milkyway %d, %@", hardwareKeyboard, keyboardH, gStatusIconsLeft, gTidyKeyboardPill, medusa ? @"yes" : @"no", medusa.hidden, aerialKeyboard ? @"yes" : @"no", aerialKeyboard.hidden, aerialKeyboard ? NSStringFromCGAffineTransform(aerialKeyboard.transform) : @"-", milkyWayKeyboard != nil, hostDebug];
        if (![in isEqualToString:lastIn]) { lastIn = in; DMLog(in); }
    }
    gSoftKeyboardH = hardwareKeyboard ? 0.0 : keyboardH;
    gKbBarOnly = hardwareKeyboard && keyboardH < 100.0;
    DMFixKeyboardOrientation(hardwareKeyboard && keyboardH < 100.0);
    gKbLogAgain = NO;   // (with a hardware keyboard the keyboard scene is only the input bar: about 55 pt tall)
    if (medusa) DMPlaceKeyboardPillIn(medusa, NO, hardwareKeyboard, keyboardH);
    if (aerialKeyboard) DMPlaceKeyboardPillIn(aerialKeyboard, YES, hardwareKeyboard, keyboardH);
    if (milkyWayKeyboard) DMPlaceKeyboardPillIn(milkyWayKeyboard, NO, hardwareKeyboard, keyboardH);
    // Keyboard Phase (iPad 2, iOS 16): Aerial's keyboard window (level 1052) is above the Cover Sheet (1050), so with a hardware keyboard the window
    // app's input bar (EN / dictation pill) stayed on top of Notification Center and the Lock Screen (globe+N, a pull-down, locking). While the
    // Cover Sheet is showing, that window is faded out; it comes back as soon as the Cover Sheet is gone. (Only its alpha is touched, and only by us.)
    if (aerialKeyboard) {
        static BOOL faded = NO;
        id csm = DMSBManager("SBCoverSheetPresentationManager");
        SEL vis = NSSelectorFromString(@"isVisible"), pres = NSSelectorFromString(@"isPresented");
        BOOL cover = [csm respondsToSelector:vis] ? ((BOOL (*)(id, SEL))objc_msgSend)(csm, vis) : ([csm respondsToSelector:pres] ? ((BOOL (*)(id, SEL))objc_msgSend)(csm, pres) : NO);
        if (cover && !faded) { faded = YES; aerialKeyboard.alpha = 0.0; DMLog(@"[kbfix] Cover Sheet showing: Aerial's keyboard window faded out"); }
        else if (!cover && faded) { faded = NO; aerialKeyboard.alpha = 1.0; DMLog(@"[kbfix] Cover Sheet gone: Aerial's keyboard window back"); }
    }
}
// Fit to Window switched off: the tiled windows go back to a normal size and are spread as far apart as the screen allows (along the diagonal from
// the top left to the bottom right, oldest first), so every one shows its own title bar. Windows that were never tiled are left where they are.
static void DMSpreadFitGroup(void) {
    NSArray<NSString *> *group = [gFitGroup copy];
    gFitGroup = nil; gFitSlots = nil;
    NSMutableArray<UIView *> *stages = [NSMutableArray array];
    for (NSString *b in [group reverseObjectEnumerator]) {   // the group is newest first
        UIView *s = DMStageForBundle(b);
        if (s && !s.hidden && !DMStageMinimized(s)) [stages addObject:s];
    }
    if (stages.count < 2) return;
    CGRect u = DMLayoutFrame(@"fill"), size = DMLayoutFrame(@"medium");   // (both as stage frames)
    if (CGRectIsNull(size) || CGRectIsEmpty(u)) return;
    CGFloat dx = MAX(0.0, u.size.width - size.size.width), dy = MAX(0.0, u.size.height - size.size.height);
    for (NSUInteger i = 0; i < stages.count; i++) {
        CGFloat t = (CGFloat)i / (CGFloat)(stages.count - 1);
        CGRect f = CGRectMake(round(u.origin.x + dx * t), round(u.origin.y + dy * t), size.size.width, size.size.height);
        DMAerialMoveStage(stages[i], f, nil);
    }
    // stacked like a Mac cascade: the oldest at the back, the newest in front, so each older window shows its own title bar above the next one
    SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
    for (NSUInteger i = 0; i < stages.count; i++) {
        UIView *st = stages[i];
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((0.06 + 0.04 * i) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if ([st respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(st, front); });
    }
    DMLog([NSString stringWithFormat:@"[aerial] Fit to Window off: %lu windows back to a normal size, spread apart", (unsigned long)stages.count]);
}
// ---- click a window to bring it to the front (like on a Mac) ----------------------------------------------------------------------------------
// Aerial only raises a window when its title bar is touched. A touch inside an app goes straight to the app (SpringBoard never sees it), so every
// window that is NOT in front gets a see-through sheet over its content (a nearly invisible colour, which is still hit by touches, like Aerial's own
// resize handles); the first touch on it raises the window, and the sheet goes away because that window is now in front. The corners and edges are
// left free for the resize handles.
// A tap outside the windows makes the windowed apps give up their typing (like clicking the desktop on a Mac takes the cursor out of a text field), with or without
// a hardware keyboard: the on-screen keyboard goes away, and with a hardware keyboard the text field stops taking the keys. The
// keyboard belongs to the app, so the app is told to give up its typing (MacAppBridge, running in every app, listens for the notification of its bundle id).
static void DMResignWindowedKeyboards(NSString *exceptBundle) {
    for (UIView *st in DMAerialStages()) {
        NSString *b = DMStageBundle(st);
        if (!b.length || [b isEqualToString:exceptBundle]) continue;
        uint32_t hash = 2166136261u;
        for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
        char name[64]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.resign.%08x", hash);
        notify_post(name);
    }
}
@interface DMOutsideTap : NSObject <UIGestureRecognizerDelegate>
@end
static void DMSMDeskOutsideTouch(void);   // (Stage Manager engine, SMDesktop.h)
#if DEBUG
static void DMSMDeskDebugFloor(void);     // (debug trigger smfloor, SMDesktop.h)
#endif
void DMOutsideTouch(void) {   // a touch on the Home Screen or the Dock (outside every window); also run by the debug trigger outsidetap
    if (DMSMEngine()) { DMSMDeskOutsideTouch(); return; }   // (Stage Manager: its windows over the Home Screen, the same rule)
    if (DMActiveEngine() != DMEngineAerial) return;
    // (also with a hardware keyboard, where no on-screen keyboard is up: the text field's cursor stops and it stops taking the keys, like a Mac, the owner, 27 Sep)
    DMLog([NSString stringWithFormat:@"[focus] a touch outside the windows: the windowed apps are told to put their keyboard away (hardware keyboard %d)", DMHardwareKeyboardAttached()]);
    DMResignWindowedKeyboards(nil);
}
// (A keyboard avoidance that moved/shrank the front window above the on-screen keyboard used to be here. The owner didn't like it and asked for the
// Aerial 3.0 behaviour: the keyboard simply covers a window when it has to. Aerial 5.0's own per-app keyboard avoidance stays neutralised too, so
// nothing moves windows for the keyboard.)
@implementation DMOutsideTap
- (void)tapped:(UILongPressGestureRecognizer *)g {
    if (g.state == UIGestureRecognizerStateBegan && DMTestFlag("/tmp/macstatusbar-debug"))
        DMLog([NSString stringWithFormat:@"[focus] outside touch at %@ in %@ (touches %lu, screen %@)", NSStringFromCGPoint([g locationInView:g.view]), NSStringFromClass([g.view class]), (unsigned long)g.numberOfTouches, NSStringFromCGPoint([g.view convertPoint:[g locationInView:g.view] toCoordinateSpace:[UIScreen mainScreen].coordinateSpace])]);
    if (g.state != UIGestureRecognizerStateBegan) return;
    DMOutsideTouch();
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b { return YES; }
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)touch { return YES; }
@end
static const void *kOutsideTapKey = &kOutsideTapKey;
static void DMAttachOutsideTaps(void) {   // the Home Screen and the Dock: everything that is not a window (they are all under the windows, so a touch here is outside them)
    static DMOutsideTap *handler; if (!handler) handler = [DMOutsideTap new];
    for (UIWindow *w in DMAllWindows()) {
        NSString *cn = NSStringFromClass([w class]);
        if (!([cn isEqualToString:@"SBHomeScreenWindow"] || [cn isEqualToString:@"SBFloatingDockWindow"]) || objc_getAssociatedObject(w, kOutsideTapKey)) continue;
        UILongPressGestureRecognizer *g = [[UILongPressGestureRecognizer alloc] initWithTarget:handler action:@selector(tapped:)];
        g.minimumPressDuration = 0.0; g.allowableMovement = CGFLOAT_MAX; g.cancelsTouchesInView = NO; g.delaysTouchesBegan = NO; g.delaysTouchesEnded = NO; g.delegate = handler;
        [w addGestureRecognizer:g];
        objc_setAssociatedObject(w, kOutsideTapKey, g, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMLog([NSString stringWithFormat:@"[focus] watching touches outside the windows in %@", cn]);
    }
}
static const void *kFocusCatcherKey = &kFocusCatcherKey;
@interface DMFocusCatcher : UIView
@property (nonatomic, weak) UIView *stage;
@end
@implementation DMFocusCatcher
- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
    UIView *stage = self.stage;
    SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
    if (stage && [stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front);
    DMLog([NSString stringWithFormat:@"[focus] a touch on the window of %@ brought it to the front", stage ? DMStageBundle(stage) : @"?"]);
    if (stage) DMResignWindowedKeyboards(DMStageBundle(stage));   // the window that had the keyboard gives it up (a hardware keyboard's cursor too)
    self.hidden = YES;   // (the next pass puts the sheets on the windows that are behind now)
}
@end
// A window is raised when its app was tapped or clicked (a trackpad click, a finger tap that did not move). The app itself reports that (MacAppBridge, running in
// every app, posts "com.besiktasliseba.appbridge.touched.<hash>"), so touches, clicks and scrolling all reach the app as they are: a window in the back can be scrolled by
// trackpad or finger without being raised first, and only a click or a tap brings it forward. Scrolling never raises a window.
static void DMRaiseStageForBundle(NSString *bundle) {
    UIView *stage = DMStageForBundle(bundle);
    if (stage && !stage.hidden && !DMStageMinimized(stage) && ![objc_getAssociatedObject(stage, kStageClosingKey) boolValue]) {
        gFullScreenActivatedBundle = nil;   // a window was tapped: the status bar goes back to following windows, whatever last reclaimed it
        if (DMActiveEngine() == DMEngineZetsu) return;   // (Zetsu raises its own windows on a tap)
        if (DMTopStage() == stage) return;   // already in front
        SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
        if ([stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front);
        DMLog([NSString stringWithFormat:@"[focus] a tap or click in the window of %@ brought it to the front", bundle]);
        DMResignWindowedKeyboards(bundle);   // the window that had the keyboard gives it up (with a hardware keyboard too: only the front window keeps a cursor)
        return;
    }
    // No stage: this is the current full-screen app, tapped through the part of it that shows around the windows in front of it. It has no window to
    // raise, so nothing moves — only the status bar's name and traffic lights come back to it, the same as clicking a visible sliver of a covered
    // window on a Mac.
    if (![bundle isEqualToString:[DMFrontApp() bundleIdentifier]]) return;
    if ([gFullScreenActivatedBundle isEqualToString:bundle]) return;   // already reclaimed
    gFullScreenActivatedBundle = [bundle copy];
    DMLog([NSString stringWithFormat:@"[focus] a tap on the full-screen app %@ (showing around the windows in front of it) reclaimed the status bar", bundle]);
    for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout];
}
static void DMRegisterTouchListeners(void) {
    static NSMutableDictionary<NSString *, NSNumber *> *tokens; if (!tokens) tokens = [NSMutableDictionary dictionary];
    NSMutableSet<NSString *> *wanted = [NSMutableSet set];
    for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length) [wanted addObject:b]; }
    NSString *front = [DMFrontApp() bundleIdentifier];
    if (front.length) [wanted addObject:front];   // the full-screen app too, so tapping through to it can reclaim the status bar (see DMRaiseStageForBundle)
    for (NSString *b in [tokens allKeys]) {   // (an app that is neither a window nor in front any more: its listener goes)
        if ([wanted containsObject:b]) continue;
        notify_cancel(tokens[b].intValue);
        [tokens removeObjectForKey:b];
    }
    for (NSString *b in wanted) {
        if (tokens[b]) continue;
        uint32_t hash = 2166136261u;
        for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
        char name[64]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.touched.%08x", hash);
        int token = 0; NSString *bundle = [b copy];
        notify_register_dispatch(name, &token, dispatch_get_main_queue(), ^(int t) { DMRaiseStageForBundle(bundle); });
        tokens[b] = @(token);
    }
}

// Posts "com.besiktasliseba.appbridge.<action>.<hash>", the same darwin-notification bridge MacAppBridge already listens on in every app (touched, wsize, ...):
// used for "Print…"/"Share…" in the app name menu, each app finding and activating its own Share/Print button when asked.
static void DMPostAppBridgeAction(NSString *bundleID, NSString *action) {
    if (!bundleID.length) return;
    uint32_t hash = 2166136261u; for (const char *c = bundleID.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
    char name[96]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.%s.%08x", action.UTF8String, hash);
    notify_post(name);
    DMLog([NSString stringWithFormat:@"[appbridge] %@ asked of %@", action, bundleID]);
}
static NSMutableDictionary<NSString *, NSValue *> *gPublishedWindowSizes;   // bundle -> the size last sent to it (a size of {0,0} means "full screen": not sent)
static void DMSendWindowSize(NSString *bundleID, CGSize size) {
    uint32_t hash = 2166136261u; for (const char *c = bundleID.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
    char name[64]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.wsize.%08x", hash);
    // The token is kept (one per app, never cancelled): notifyd forgets a name's state once nobody is registered for it, and MacAppBridge
    // reads this state synchronously when the app starts (SofaScore picks its phone or iPad layout from it), before it could register itself.
    static NSMutableDictionary<NSString *, NSNumber *> *tokens; if (!tokens) tokens = [NSMutableDictionary dictionary];
    int token = tokens[bundleID].intValue;
    if (!token) { notify_register_check(name, &token); if (token) tokens[bundleID] = @(token); }
    if (token) { notify_set_state(token, ((uint64_t)(uint32_t)round(size.width) << 32) | (uint32_t)round(MAX(0, size.height))); notify_post(name); }
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[wsize] %@ -> %@ (token %d)", bundleID, NSStringFromCGSize(size), token]);
}
static void DMPublishWindowSizes(void) {
    if (!gPublishedWindowSizes) gPublishedWindowSizes = [NSMutableDictionary dictionary];
    NSMutableDictionary<NSString *, NSValue *> *current = [NSMutableDictionary dictionary];
    if (DMActiveEngine() == DMEngineAerial) {
        for (UIView *st in DMAerialStages()) {
            NSString *b = DMStageBundle(st);
            if (!b.length || st.hidden || DMStageMinimized(st) || [objc_getAssociatedObject(st, kStageClosingKey) boolValue]) continue;
            if (DMStageStillZooming(st)) {   // (still opening: keep whatever was sent before; the settled size goes out on a later pass)
                if (gPublishedWindowSizes[b]) current[b] = gPublishedWindowSizes[b];
                continue;
            }
            CGSize content = CGSizeMake(st.bounds.size.width, MAX(0, st.bounds.size.height - kStageBarHeight));   // the app's own scene sits below the title bar
            if (gAerialFlavor == 5) {   // 5.0 keeps its own frame around the app (6 pt sides, 13 top, 20 bottom): the app's real area
                UIView *in = DMStageInnerView(st);
                content = in ? in.bounds.size : CGSizeMake(MAX(0, st.bounds.size.width - 12.0), MAX(0, st.bounds.size.height - 33.0));
            }
            current[b] = [NSValue valueWithCGSize:content];
        }
    }
    for (NSString *b in current) {
        CGSize want = current[b].CGSizeValue;
        if (CGSizeEqualToSize(want, gPublishedWindowSizes[b].CGSizeValue)) continue;
        DMSendWindowSize(b, want);
    }
    for (NSString *b in gPublishedWindowSizes.allKeys) {
        if (current[b]) continue;
        DMSendWindowSize(b, CGSizeZero);   // no longer a window: back to full screen
    }
    gPublishedWindowSizes = current;
}

// ---- SofaScore quick relaunch (SofaScore only) --------------------------------------------------------------------------
// SofaScore builds either its phone layout or its iPad split layout ONCE, at launch (MacAppBridge picks it from the window width: phone
// below 700 pt), and cannot switch later (a collapsed iPad split cannot open matches). So when the user resizes a SofaScore window across
// that line and lets go, it is relaunched quickly at the same frame, behind a snapshot of the window, and comes back in the matching
// layout. The layout the running process was built with is read from MacAppBridge's notify state "com.besiktasliseba.appbridge.sofalayout"
// (1 phone, 2 iPad, 0 = not running / unknown). Never for full-screen SofaScore, a minimized or closing window, or more than once per
// crossing. Engines: Aerial 3.0/5.0, MilkyWay, Zetsu (Zetsu: no snapshot veil, its windows are separate UIWindows).
static NSString *const kSofaBundle = @"com.SofaScore.iOS";
static UIView *DMSofaWindow(CGFloat *contentWidth) {   // SofaScore's visible window (any engine) and the app's own width inside it
    DMEngine e = DMActiveEngine();
    if (e == DMEngineAerial) {
        UIView *st = DMStageForBundle(kSofaBundle);
        if (!st || st.hidden || DMStageMinimized(st) || [objc_getAssociatedObject(st, kStageClosingKey) boolValue]) return nil;
        UIView *in = gAerialFlavor == 5 ? DMStageInnerView(st) : nil;
        *contentWidth = in ? in.bounds.size.width : (gAerialFlavor == 5 ? st.bounds.size.width - 12.0 : st.bounds.size.width);
        return st;
    }
    if (e == DMEngineMilkyWay) {
        UIView *w = DMFindMilkyWayWindow(kSofaBundle);
        if (!w || w.hidden || DMWindowMinimized(w)) return nil;
        *contentWidth = w.bounds.size.width;
        return w;
    }
    if (e == DMEngineZetsu) {
        UIWindow *zw = DMZetsuWindowFor(kSofaBundle);
        if (!zw || zw.hidden || DMStageMinimized(zw)) return nil;
        *contentWidth = zw.bounds.size.width;
        return zw;
    }
    return nil;
}
static int DMSofaLayout(void) {
    int token = 0; uint64_t state = 0;
    if (notify_register_check("com.besiktasliseba.appbridge.sofalayout", &token) != NOTIFY_STATUS_OK) return 0;
    notify_get_state(token, &state); notify_cancel(token);
    return (int)state;
}
static UIView *DMSofaVeil(UIView *window) {   // a still picture of the window, on top of it in its own container, while the app restarts
    if (!window.superview || [window isKindOfClass:[UIWindow class]]) return nil;
    UIView *snap = [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO];
    if (!snap) return nil;
    id<UICoordinateSpace> screen = [UIScreen mainScreen].coordinateSpace;
    CGRect onScreen = [window convertRect:window.bounds toCoordinateSpace:screen];
    UIView *clip = [[UIView alloc] initWithFrame:[window.superview convertRect:onScreen fromCoordinateSpace:screen]];
    clip.clipsToBounds = YES; clip.userInteractionEnabled = NO;
    clip.layer.cornerRadius = window.layer.cornerRadius;
    snap.frame = CGRectMake(-onScreen.origin.x, -onScreen.origin.y, screen.bounds.size.width, screen.bounds.size.height);
    [clip addSubview:snap];
    [window.superview addSubview:clip];
    return clip;
}
static CFTimeInterval gSofaRelaunchAt = 0;
static CGFloat gSofaGaveUpWidth = 0;
// The relaunched window must come back exactly where the old one was (and in its Fit to Window tile, if it had one). This used to be a 3 s window
// from the start of the relaunch; on the iPad 2 the new window only reached DMCascadeStage 3.35 s after the start, so it was moved to the
// default place and tiled like a new window (an iPad layout stuck in a 379 pt tile). Now it holds until the new window has been placed (or 10 s).
static CGRect gSofaRelaunchFrame = {{0, 0}, {0, 0}};
static BOOL gSofaRelaunchPending = NO;
static NSString *gSofaRelaunchSlot = nil;   // its Fit to Window slot before the relaunch (nil: it was not tiled)
static NSArray<NSString *> *gSofaRelaunchAbove = nil;   // the windows that were in front of it
BOOL DMSofaRelaunchKeepsFrame(NSString *bundleID) {   // (asked by DMCascadeStage for a window that has just opened)
    return [bundleID isEqualToString:kSofaBundle] && gSofaRelaunchPending && CACurrentMediaTime() - gSofaRelaunchAt < 10.0;
}
CGRect DMSofaRelaunchPlaced(UIView *stage) {   // (DMCascadeStage, while DMSofaRelaunchKeepsFrame): the frame to put it at; the tile is given back
    gSofaRelaunchPending = NO;
    if (gSofaRelaunchSlot && gFitGroup && gFitSlots && ![gFitGroup containsObject:kSofaBundle] && gFitGroup.count < 4 && ![[gFitSlots allValues] containsObject:gSofaRelaunchSlot]) {
        [gFitGroup insertObject:kSofaBundle atIndex:0]; gFitSlots[kSofaBundle] = gSofaRelaunchSlot;
        DMLog([NSString stringWithFormat:@"[sofa] relaunch: back in its %@ tile", gSofaRelaunchSlot]);
    }
    gSofaRelaunchSlot = nil;
    NSArray *above = gSofaRelaunchAbove; gSofaRelaunchAbove = nil;
    if (above.count) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
        for (NSString *b in above) { UIView *st = DMStageForBundle(b); if (!st) continue; if (DMIsZetsuWindow(st)) DMZetsuRaise((UIWindow *)st); else if ([st respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(st, front); }
        DMLog([NSString stringWithFormat:@"[sofa] relaunch: %lu window(s) that were in front of it brought forward again", (unsigned long)above.count]);
    });
    return gSofaRelaunchFrame;
}
static void DMSofaRelaunch(UIView *window, CGFloat width, int layout) {
    CGRect frame = window.frame;
    DMEngine e = DMActiveEngine();
    CFTimeInterval t0 = CACurrentMediaTime();
    gSofaRelaunchAt = t0;
    gSofaRelaunchFrame = frame; gSofaRelaunchPending = YES;
    {   // the windows in front of it: the relaunched window opens on top, so they are brought forward again afterwards (in the same order)
        NSMutableArray *above = [NSMutableArray array]; BOOL seen = NO;
        for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (seen && b.length && !DMStageMinimized(st)) [above addObject:b]; if (st == window) seen = YES; }
        gSofaRelaunchAbove = above;
    }
    gSofaRelaunchSlot = nil;   // (its tile is given back only if it really was in it)
    if ([gFitGroup containsObject:kSofaBundle] && gFitSlots[kSofaBundle]) {
        CGRect sf = DMSlotFrame(kSofaBundle);
        if (!CGRectIsNull(sf) && fabs(sf.origin.x - frame.origin.x) <= 2.0 && fabs(sf.size.width - frame.size.width) <= 2.0) gSofaRelaunchSlot = gFitSlots[kSofaBundle];
    }
    DMLog([NSString stringWithFormat:@"[sofa] relaunch: width %.0f does not suit the running %@ layout -> relaunching at %@", width, layout == 1 ? @"phone" : @"iPad", NSStringFromCGRect(frame)]);
    __block UIView *veil = DMSofaVeil(window);
    DMForceQuitBundle(kSofaBundle);
    __block int tries = 0;
    __block void (^waitGone)(void) = nil;
    waitGone = ^{
        SBApplication *app = DMAppForBundle(kSofaBundle);
        id ps = [app respondsToSelector:NSSelectorFromString(@"processState")] ? DMCall(app, @"processState") : nil;
        int pid = ps ? ((int (*)(id, SEL))objc_msgSend)(ps, NSSelectorFromString(@"pid")) : 0;
        if (pid > 0 && ++tries < 40) { if (veil) [veil.superview bringSubviewToFront:veil]; dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitGone); return; }
        waitGone = nil;
        CFTimeInterval t1 = CACurrentMediaTime();
        DMSendWindowSize(kSofaBundle, CGSizeMake(width, MAX(1.0, frame.size.height - 33.0)));   // the size MacAppBridge decides the layout from
        if (e == DMEngineAerial) DMAerialTrigger(kSofaBundle, frame);
        else {
            gPendingWindowFrame = frame;
            if (e == DMEngineMilkyWay) DMLaunchAsWindow(kSofaBundle); else DMZetsuLaunch(kSofaBundle);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(4.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ gPendingWindowFrame = CGRectNull; });
        }
        __block int polls = 0;
        __block void (^waitDrawn)(void) = nil;
        waitDrawn = ^{
            CGFloat w2 = 0; UIView *nw = DMSofaWindow(&w2);
            int now = DMSofaLayout();
            if (veil) [veil.superview bringSubviewToFront:veil];
            if (!(nw && now > 0) && ++polls < 60) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitDrawn); return; }
            waitDrawn = nil;
            DMLog([NSString stringWithFormat:@"[sofa] relaunch: old process gone after %.2f s, new window %@ with layout %d after %.2f s total", t1 - t0, nw ? NSStringFromCGRect(nw.frame) : @"(none)", now, CACurrentMediaTime() - t0]);
            UIView *v = veil; veil = nil;
            if (!v) return;
            [UIView animateWithDuration:0.25 delay:0.35 options:UIViewAnimationOptionCurveEaseOut animations:^{ v.alpha = 0; } completion:^(BOOL d) { [v removeFromSuperview]; }];
        };
        waitDrawn();
    };
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitGone);
}
void DMSofaRelaunchNow(void) { CGFloat w = 0; UIView *win = DMSofaWindow(&w); if (win) DMSofaRelaunch(win, w, DMSofaLayout()); else DMLog(@"[sofa] (test) no SofaScore window"); }
static BOOL DMHasWindowFor(NSString *bundleID);
static long DMRealInterfaceOrientation(void);   // defined below
static CFTimeInterval gSofaFullPhoneSince = 0;
static int gSofaFullReopens = 0;   // (full-screen reopens since SofaScore last closed)
static void DMWatchSofaScore(void) {   // every 0.2 s
    static CGFloat lastWidth = 0; static CFTimeInterval stableSince = 0;
    {   // (S-1, 1.3.3: SofaScore not installed -- most iPads --: nothing to watch, not even its scene looked for; asked again every 30 s)
        static CFTimeInterval askedAt = -100; static BOOL installed = NO;
        CFTimeInterval t = CACurrentMediaTime();
        if (t - askedAt > 30.0) { askedAt = t; installed = DMAppForBundle(kSofaBundle) != nil; }
        if (!installed) return;
    }
    // (watcher plan step 4: nothing to watch while SofaScore has no live scene -- neither full screen nor in a window; both branches below need one)
    if (![[DMFrontApp() bundleIdentifier] isEqualToString:kSofaBundle] && !DMSceneForBundle(kSofaBundle)) { lastWidth = 0; stableSince = 0; gSofaFullPhoneSince = 0; if (CACurrentMediaTime() - gSofaRelaunchAt > 20.0) gSofaFullReopens = 0; return; }
    CGFloat width = 0;
    UIView *window = DMSofaWindow(&width);
    CFTimeInterval now = CACurrentMediaTime();
    if (!window || width <= 0) {
        lastWidth = 0;
        // FULL SCREEN = the iPad layout (iPad 2 cross-test: the green light took a phone-layout window full screen and it stayed a stretched phone
        // layout, since only windows were watched). SofaScore in front, full screen, still phone for 0.8 s -> quit and reopened full screen; with no
        // window size published MacAppBridge decides from the full-screen scene (iPad).
        CFTimeInterval fullPhoneSince = gSofaFullPhoneSince;
        // (Stage Manager engine: DMHasWindowFor knows only Aerial / Zetsu / MilkyWay windows, so a SofaScore WINDOW looked full screen here and was
        //  force-quit and reopened over and over -- it seemed to crash at launch, iPad 2 30 Sep. Stage Manager itself says which app is full screen.)
        BOOL fullScreenNow = DMSMEngine() ? [DMSMFullScreenBundle() isEqualToString:kSofaBundle] : !DMHasWindowFor(kSofaBundle);
        if (fullScreenNow && DMSofaLayout() == 2) gSofaFullReopens = 0;   // (full screen in the iPad layout: any earlier reopen worked, the count starts over)
        BOOL fullPhone = [[DMFrontApp() bundleIdentifier] isEqualToString:kSofaBundle] && fullScreenNow && DMSofaLayout() == 1 && DMScreenOnAndUnlocked();
        if (!fullPhone) { gSofaFullPhoneSince = 0; return; }
        if (!fullPhoneSince) { gSofaFullPhoneSince = now; return; }
        if (now - fullPhoneSince < 0.8 || now - gSofaRelaunchAt < 8.0) return;
        // (at most 2 full-screen reopens while SofaScore stays open: if the layout still comes back phone, it is left as it is -- logic test M1)
        if (gSofaFullReopens >= 2) { gSofaFullPhoneSince = 0; gSofaRelaunchAt = now; if (gSofaFullReopens++ == 2) DMLog(@"[sofa] relaunch: full screen still in the phone layout after 2 reopens -- left as it is until SofaScore closes"); return; }
        gSofaFullReopens++;
        gSofaRelaunchAt = now; gSofaFullPhoneSince = 0;
        DMLog(@"[sofa] relaunch: full screen in the phone layout -> reopening it full screen (iPad layout)");
        DMForceQuitBundle(kSofaBundle);
        __block int tries = 0; __block void (^waitGone)(void) = nil;
        waitGone = ^{
            SBApplication *app = DMAppForBundle(kSofaBundle);
            id ps = [app respondsToSelector:NSSelectorFromString(@"processState")] ? DMCall(app, @"processState") : nil;
            int pid = ps ? ((int (*)(id, SEL))objc_msgSend)(ps, NSSelectorFromString(@"pid")) : 0;
            if (pid > 0 && ++tries < 40) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitGone); return; }
            waitGone = nil;
            if (DMSMEngine()) {
                // Stage Manager engine: a launch opens it as a window, and SofaScore picks its layout once, from its first size. So it is told the
                // full-screen width first (read synchronously at its start), launched, and its window made full screen as soon as it exists; the
                // width goes back to "none" afterwards so a later windowed launch decides from its window again. (Review note, 30 Sep: the plain
                // full-screen open came back as a window, still in the phone layout.)
                CGSize sc = [UIScreen mainScreen].bounds.size;
                DMSendWindowSize(kSofaBundle, CGSizeMake(MAX(sc.width, sc.height), MIN(sc.width, sc.height)));
                DMOpenFullScreen(kSofaBundle);
                __block int polls = 0; __block void (^waitItem)(void) = nil;
                waitItem = ^{
                    id attrs = nil;
                    if (!DMSMItemFor(DMSMStageOf(kSofaBundle), kSofaBundle, &attrs) && ++polls < 40) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitItem); return; }
                    waitItem = nil;
                    BOOL ok = attrs && DMSMPolicyOf(attrs) != 2 ? DMSMSetFullScreenInStage(kSofaBundle, YES) : (attrs != nil);
                    DMLog([NSString stringWithFormat:@"[sofa] relaunch (Stage Manager): full screen -> %d after %d polls", ok, polls]);
                };
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitItem);
                // (the width goes back to "none" once the new process has decided its layout -- up to 15 s: a slow cold start on the 2 GB iPad
                //  read 0 after a fixed 6 s and picked the phone layout again, logic test M1)
                __block int waits = 0; __block void (^waitDecided)(void) = nil;
                waitDecided = ^{
                    if (DMSofaLayout() <= 0 && ++waits < 75) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitDecided); return; }
                    waitDecided = nil;
                    DMSendWindowSize(kSofaBundle, CGSizeZero);
                };
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitDecided);
                return;
            }
            DMOpenFullScreen(kSofaBundle);
        };
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), waitGone);
        return;
    }
    // A turn alone never relaunches it (iPad 2: a 611 pt phone window became 811 pt in landscape and was relaunched into the iPad layout): the
    // width a turn gives it is accepted as it is; only a later change of width by the user (a resize or a layout) applies the rule below.
    static long lastOrientation = 0; static CGFloat turnWidth = -1; static CFTimeInterval turnAt = 0;
    long orientation = DMRealInterfaceOrientation();
    if (lastOrientation && orientation != lastOrientation) { turnWidth = -2; turnAt = now; DMLog([NSString stringWithFormat:@"[sofa] turned (%ld -> %ld): its new width is kept as it is", lastOrientation, orientation]); }
    lastOrientation = orientation;
    if (fabs(width - lastWidth) > 0.5) { lastWidth = width; stableSince = now; return; }
    if (now - stableSince < 0.5 || now - gSofaRelaunchAt < 4.0) return;   // still resizing, or a relaunch just happened
    if (turnWidth == -2) { if (now - turnAt < 2.0) return; turnWidth = width; }   // (settled after the turn: the engine resizes it a moment after)
    if (turnWidth > 0) { if (fabs(width - turnWidth) < 30) return; turnWidth = -1; }
    {   // Fit to Window is still taking it into its tile (back from full screen it opens in the middle and then flies into its tile): wait for
        // that, or the relaunch is decided from the wrong width and the tile is lost (iPad 2 cross-test)
        CGRect slot = [gFitGroup containsObject:kSofaBundle] && DMFitEnabled() ? DMSlotFrame(kSofaBundle) : CGRectNull;
        if ([objc_getAssociatedObject(window, kStageEnteringKey) boolValue]) return;
        if (!CGRectIsNull(slot) && (fabs(slot.origin.x - window.frame.origin.x) > 2.0 || fabs(slot.size.width - window.frame.size.width) > 2.0)) {
            static CFTimeInterval waitingSince = 0;
            if (!waitingSince || now - waitingSince > 10.0) waitingSince = now;
            if (now - waitingSince < 3.0) return;   // (not forever: a tile it never reaches does not block the layout rule)
        }
    }
    int layout = DMSofaLayout();
    // Requirement (2026-09-24): a window in the PHONE layout keeps it when widened (and the user keeps their place in the app) until it is at least 75%
    // of the screen's width (either orientation; ~895 pt on the M1 in landscape) -- too wide for a phone layout to look right -- and only then
    // relaunches into the iPad layout. The iPad layout below 680 pt still relaunches into the phone layout (the iPad layout doesn't work narrow).
    // (never below 700 pt: MacAppBridge builds the iPad layout only for a window at least 700 pt wide, so in portrait -- 75% of 834 = 625 pt --
    // a relaunch between 625 and 700 came back in the phone layout again; seen on the M1, Aerial 3.0, Phase 2b)
    CGFloat phoneMax = MAX(700.0, 0.75 * [UIScreen mainScreen].bounds.size.width);
    BOOL wrong = (layout == 1 && width >= phoneMax) || (layout == 2 && width < 680);
    if (!wrong) { gSofaGaveUpWidth = 0; return; }
    if (gOverlay) return;   // a question is open (Fit's "which side?" is about to move it into a tile): decide once it is answered
    if (gSofaGaveUpWidth > 0 && fabs(width - gSofaGaveUpWidth) < 30) return;   // a relaunch at this size did not help: do not loop
    // (only a relaunch at about THIS width counts as "did not help": after one at 799 pt the window was tiled to 507 pt 2 s later and was left
    // in the iPad layout -- iPad 2 cross-test)
    if (gSofaRelaunchAt > 0 && now - gSofaRelaunchAt < 8.0 && fabs(width - gSofaRelaunchFrame.size.width) < 40.0) { gSofaGaveUpWidth = width; DMLog([NSString stringWithFormat:@"[sofa] layout still wrong right after a relaunch at width %.0f: not trying again at this size", width]); return; }
    DMSofaRelaunch(window, width, layout);
}

static void DMUpdateFocusCatchers(void) {
    if (DMActiveEngine() == DMEngineAerial) { static int n = 0; if (n++ % 10 == 0) DMAttachOutsideTaps(); }   // (watcher plan step 4: the two windows stay for SpringBoard's lifetime: every 2 s is plenty)
    else if (DMSMEngine()) { static int n = 0; if (n++ % 10 == 0) DMAttachOutsideTaps(); }   // (Stage Manager: the Home Screen behind its windows takes touches too, SMDesktop.h)
    if (!DMWindowWorkNeeded()) return;   // (no window: the listeners and the published sizes follow on the tick a window appears)
    if (DMActiveEngine() == DMEngineZetsu) {   // Zetsu raises its own windows; the taps are only listened for so a tap on the full-screen app behind them
        static NSString *lastSig = nil;         // takes the focus back (the status bar returns to it) and a tap in a window gives it to the windows again
        NSMutableArray *bs = [NSMutableArray array];   // (see DMRaiseStageForBundle and GameStatusBar)
        for (UIWindow *w in DMZetsuAllWindows()) { NSString *b = DMZetsuWindowBundle(w); if (b.length) [bs addObject:b]; }
        [bs sortUsingSelector:@selector(compare:)];
        NSString *sig = [NSString stringWithFormat:@"%@|%@", [DMFrontApp() bundleIdentifier] ?: @"", [bs componentsJoinedByString:@","]];
        if (![sig isEqualToString:lastSig ?: @""]) { lastSig = sig; DMRegisterTouchListeners(); }
        return;
    }
    if (DMActiveEngine() != DMEngineAerial) return;
    for (UIView *st in DMAerialStages()) {   // a window whose app scene does not have the orientation the keyboard host is set up for gets an update that corrects it
        NSString *b = DMStageBundle(st); id scene = b.length ? DMSceneForBundle(b) : nil; id settings = nil;
        @try { settings = [scene valueForKey:@"settings"]; } @catch (id e) {}
        if (![settings respondsToSelector:NSSelectorFromString(@"interfaceOrientation")]) continue;
        long so = ((long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientation"));
        if (DMWantedSceneOrientation(so) == so || [objc_getAssociatedObject(st, kStageClosingKey) boolValue]) continue;
        static NSMutableDictionary *tried; if (!tried) tried = [NSMutableDictionary dictionary];
        if (CACurrentMediaTime() - [tried[b] doubleValue] < 1.0) continue;   // (not more than once a second per window)
        tried[b] = @(CACurrentMediaTime());
        id fixed = DMPortraitWindowSettings(scene, settings);
        if (fixed == settings) continue;
        Class ctxClass = objc_getClass("UIApplicationSceneTransitionContext");
        _logos_orig$_ungrouped$FBScene$updateSettings$withTransitionContext$((FBScene *)scene, NSSelectorFromString(@"updateSettings:withTransitionContext:"), fixed, ctxClass ? [[ctxClass alloc] init] : nil);
    }
    {   // (step 4: the listeners only change when the windows or the front app do)
        static NSString *lastSig = nil;
        NSMutableArray *bs = [NSMutableArray array];
        for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length) [bs addObject:b]; }
        [bs sortUsingSelector:@selector(compare:)];
        NSString *sig = [NSString stringWithFormat:@"%@|%@", [DMFrontApp() bundleIdentifier] ?: @"", [bs componentsJoinedByString:@","]];
        if (![sig isEqualToString:lastSig ?: @""]) { lastSig = sig; DMRegisterTouchListeners(); }
    }
    DMPublishWindowSizes();
}
static void DMWatchFitToggle(void) {
    static BOOL primed = NO, wasOn = NO; static int tick = 0;
    if (tick++ % 3) return;   // (every 0.6 s; DMFitEnabled is a cached value now, see there)
    if (DMActiveEngine() == DMEngineNone) return;
    BOOL now = DMFitEnabled();
    if (primed && wasOn && !now) DMSpreadFitGroup();
    if (primed && !wasOn && now) DMTileOpenWindows();
    wasOn = now; primed = YES;
}
// ---- windows survive a respring -------------------------------------------------------------------------------------------------------------
// The state of the windows (which apps, where, in which order, minimized or not, and the Fit to Window tiles) is written to a file whenever it changes.
// After a respring the apps are opened as windows again, back to front, each at the place it was at. Nothing is saved until that has finished (an
// empty screen at start would overwrite the state that is about to be restored).
static BOOL gRestoringWindows = NO, gWindowSaveOn = NO;
BOOL gRestoringWindowsFlag(void) { return gRestoringWindows; }
BOOL gWindowSaveOnFlag(void) { return gWindowSaveOn; }
static NSDictionary *gLastWindowState = nil;
static NSString *DMWindowStatePath(void) { return [NSHomeDirectory() stringByAppendingPathComponent:@"Library/Preferences/com.besiktasliseba.macstatusbar.windows.plist"]; }
static void DMSaveWindowState(void) {
    if (!gWindowSaveOn || gRestoringWindows || DMActiveEngine() == DMEngineNone || !DMWindowWorkNeeded()) return;
    // Nothing is saved while the iPad is locked or its screen is off: Aerial 5.0 turns every window into its round 56 pt icon for the lock (we
    // count that as minimized), so a respring during a lock brought all windows back minimized (iPad 2 cross-test). The state from before the
    // lock stays in the file.
    if (!DMScreenOnAndUnlocked()) return;
    // (perf step 7: a cheap signature of what is saved -- stages, frames, minimized flags, the Fit group and slots, the screen -- and the full
    // pass only when it changed, or at least every 2 s)
    {
        static NSUInteger lastSig = 0; static CFTimeInterval lastFull = 0;
        CFTimeInterval now = CACurrentMediaTime();
        CGSize sc = [UIScreen mainScreen].bounds.size;
        NSUInteger h = gFitGroup.count * 31 + gFitSlots.count * 7 + (NSUInteger)(sc.width * 3 + sc.height);
        for (NSString *b in gFitGroup) h = h * 131 + b.hash + [gFitSlots[b] hash];
        for (UIView *st in DMAerialStages()) {
            CGRect f = st.frame;
            h = h * 131 + (NSUInteger)(f.origin.x * 7 + f.origin.y * 13 + f.size.width * 17 + f.size.height * 19) + (DMStageMinimized(st) ? 1 : 0) + (NSUInteger)(__bridge void *)st
                + (NSUInteger)(DMAutoHideShiftOf(st) * 5) + [objc_getAssociatedObject(st, kStageIntentKey) hash];
        }
        if (h == lastSig && now - lastFull < 2.0) return;
        lastSig = h; lastFull = now;
    }
    NSMutableArray *wins = [NSMutableArray array];
    for (UIView *st in DMAerialStages()) {   // back to front
        NSString *b = DMStageBundle(st);
        if (!b.length) continue;
        BOOL minimized = DMStageMinimized(st);
        NSValue *intent = objc_getAssociatedObject(st, kStageIntentKey);
        CGRect f = (minimized && intent) ? intent.CGRectValue : st.frame;
        if (!(minimized && intent)) f.origin.y -= DMAutoHideShiftOf(st);   // (a window the status bar has moved down for a moment is saved at its own place)
        if (intent && (f.size.width < 150.0 || f.size.height < 150.0)) f = intent.CGRectValue;   // never save a chip-sized frame (Aerial 5.0's round icon)
        if (f.size.width < 150.0 || f.size.height < 150.0) {   // still chip-sized (no remembered frame): keep the frame saved last time, if any
            CGRect old = CGRectNull;
            for (NSDictionary *w in gLastWindowState[@"windows"]) if ([w[@"bundle"] isEqual:b]) old = CGRectFromString(w[@"frame"]);
            if (CGRectIsNull(old) || old.size.width < 150.0 || old.size.height < 150.0) return;   // nothing good to save: leave the file as it is
            f = old;
        }
        [wins addObject:@{@"bundle": b, @"frame": NSStringFromCGRect(f), @"minimized": @(minimized)}];
    }
    NSDictionary *state = @{@"windows": wins, @"screen": NSStringFromCGSize([UIScreen mainScreen].bounds.size),
                            @"fitGroup": gFitGroup ? [gFitGroup copy] : @[], @"fitSlots": gFitSlots ? [gFitSlots copy] : @{}};
    if ([state isEqualToDictionary:gLastWindowState]) return;
    gLastWindowState = state;
    static dispatch_queue_t writer;   // (perf step 7: the file is written off the main thread, in order; the dictionary is immutable)
    if (!writer) writer = dispatch_queue_create("MSBWindowStateWriter", DISPATCH_QUEUE_SERIAL);
    NSString *path = DMWindowStatePath();
    dispatch_async(writer, ^{ [state writeToFile:path atomically:YES]; });
}
static void DMRestoreStep(NSArray *wins, NSUInteger i, NSDictionary *state, int waited);
static NSMutableSet<NSString *> *gRestoreHidden;   // apps whose window the restore brings back minimized: invisible from its first frame
BOOL DMRestoreWantsHidden(NSString *bundleID) { return bundleID.length && [gRestoreHidden containsObject:bundleID]; }
// Apps the user opened since SpringBoard started, before the saved windows were brought back: the restore leaves them as the user opened them
// (iPad 2, 27 Sep: Settings opened ~3 s after a respring came up, then the restore minimized it again, as it had been saved, and a second tap was needed).
static NSMutableSet<NSString *> *gOpenedBeforeRestore;
void DMNoteOpenedBeforeRestore(NSString *bundleID) {
    extern BOOL gWindowSaveOnFlag(void);
    if (!bundleID.length || gWindowSaveOnFlag()) return;   // (the restore is over)
    if (!gOpenedBeforeRestore) gOpenedBeforeRestore = [NSMutableSet set];
    [gOpenedBeforeRestore addObject:bundleID];
    [gRestoreHidden removeObject:bundleID];   // (tapped while it was being brought back: its window is not kept invisible)
}
static void DMFinishRestore(NSDictionary *state) {
    NSMutableArray *group = [NSMutableArray array];
    for (NSString *b in state[@"fitGroup"]) if (DMStageForBundle(b)) [group addObject:b];
    if (group.count >= 2 && DMFitEnabled()) {
        gFitGroup = group;
        gFitSlots = [NSMutableDictionary dictionary];
        for (NSString *b in group) { NSString *slot = state[@"fitSlots"][b]; if (slot) gFitSlots[b] = slot; }
        if (gFitSlots.count != group.count) DMAssignDefaultSlots();
    }
    // Repair a saved layout where windows overlap the tiles (the Aerial 3.0 report: a fifth window had taken the top-left tile, and the overlap
    // came back after every respring). A window outside the group that sits exactly in a free tile joins the group there; any other window
    // outside the group that covers a tile is moved to the standard place, a regular window over the four (what a fifth window should be).
    NSMutableArray<UIView *> *raiseAfter = [NSMutableArray array];   // (moved over the tiles: raised after the stacking order below)
    if (DMFitEnabled() && gFitGroup.count >= 2) {
        NSMutableSet *usedSlots = [NSMutableSet setWithArray:gFitSlots.allValues ?: @[]];
        for (UIView *st in DMAerialStages()) {
            NSString *b = DMStageBundle(st), *slot = DMSlotNameForFrame(st.frame);
            if (!b.length || [gFitGroup containsObject:b] || !DMStageTakesPartInFit(st) || gFitGroup.count >= 4) continue;
            if (slot && ![usedSlots containsObject:slot] && ([slot hasPrefix:@"top"] || [slot hasPrefix:@"bottom"]) && slot.length > 6) {   // a free quarter
                [gFitGroup addObject:b]; gFitSlots[b] = slot; [usedSlots addObject:slot];
                DMLog([NSString stringWithFormat:@"[restore] %@ sits in the free %@ tile: joins the tiles", b, slot]);
            }
        }
        for (UIView *st in DMAerialStages()) {
            NSString *b = DMStageBundle(st);
            if (!b.length || [gFitGroup containsObject:b] || !DMStageTakesPartInFit(st)) continue;
            if (!DMSlotNameForFrame(st.frame)) continue;   // (a regular window floating over the tiles is what it should be: only one that sits in a tile or half is moved)
            BOOL covers = NO;
            for (NSString *g in gFitGroup) { UIView *gs = DMStageForBundle(g); if (gs && DMOverlapFraction(st.frame, gs.frame) > 0.45) covers = YES; }
            if (!covers) continue;
            CGRect c = DMLayoutFrame(@"center");
            if (CGRectIsNull(c)) continue;
            for (int k = 0; k < 8; k++) {   // (cascaded, like new windows: never exactly on top of another window already there)
                BOOL taken = NO;
                for (UIView *o in DMAerialStages()) if (o != st && DMStageTakesPartInFit(o) && fabs(o.frame.origin.x - c.origin.x) < 34.0 && fabs(o.frame.origin.y - c.origin.y) < 34.0) taken = YES;
                if (!taken) break;
                c = CGRectOffset(c, 50.0, 44.0);
            }
            DMLog([NSString stringWithFormat:@"[restore] %@ covered a tile (%@): moved to the standard place, a regular window over the tiles", b, NSStringFromCGRect(st.frame)]);
            DMAerialMoveStage(st, c, nil);
            [raiseAfter addObject:st];
        }
    }
    // stacking order: back to front, as it was (opening the apps one after the other raised each one in turn)
    SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
    for (NSDictionary *w in state[@"windows"]) {
        UIView *st = DMStageForBundle(w[@"bundle"]);
        if (st && ![w[@"minimized"] boolValue] && DMIsZetsuWindow(st)) DMZetsuRaise((UIWindow *)st);
        else if (st && ![w[@"minimized"] boolValue] && [st respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(st, front);
    }
    for (UIView *st in raiseAfter) { if (DMIsZetsuWindow(st)) DMZetsuRaise((UIWindow *)st); else if ([st respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(st, front); }
    gRestoringWindows = NO; gWindowSaveOn = YES;
    gRestoreHidden = nil;   // (nothing is kept invisible after the restore)
    unlink("/tmp/macstatusbar-restore-guard");
    DMLog([NSString stringWithFormat:@"[restore] done: %lu windows, fit group %lu", (unsigned long)DMAerialStages().count, (unsigned long)group.count]);
    if (gFitGroup.count >= 2 && DMFitEnabled()) {   // the tiles exactly in their slots for the screen as it is now (saved frames can be from another shape)
        gMoveKeepsOrder = YES;
        for (NSString *b in [gFitGroup copy]) {
            UIView *st = DMStageForBundle(b); CGRect f = DMSlotFrame(b), cur = st.frame;
            if (!st || CGRectIsNull(f) || st.hidden || DMStageMinimized(st)) continue;
            if (fabs(f.origin.x - cur.origin.x) <= 1.0 && fabs(f.origin.y - cur.origin.y) <= 1.0 && fabs(f.size.width - cur.size.width) <= 1.0 && fabs(f.size.height - cur.size.height) <= 1.0) continue;
            DMLog([NSString stringWithFormat:@"[restore] %@ put in its tile %@ (was brought back at %@)", b, NSStringFromCGRect(f), NSStringFromCGRect(cur)]);
            DMAerialMoveStage(st, f, nil);
        }
        gMoveKeepsOrder = NO;
    }
    // Every window brought back counts as placed: an app that attaches only after the restore has finished (Aerial 3.0 on the iPad 2: Reminders,
    // 1.2 s later) used to be taken for a NEW window by DMCascadeStage's later call and was tiled into the group, re-arranging all the tiles.
    for (UIView *st in DMAerialStages()) {
        NSString *b = DMStageBundle(st);
        if (!b.length || DMStageMinimized(st)) continue;
        CGRect f = [gFitGroup containsObject:b] && DMFitEnabled() ? DMSlotFrame(b) : st.frame;
        objc_setAssociatedObject(st, kStageCascadedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!CGRectIsNull(f)) DMSetStageIntent(st, f);
    }
}
static void DMRestoreStep(NSArray *wins, NSUInteger i, NSDictionary *state, int waited) {
    if (i >= wins.count) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMFinishRestore(state); }); return; }
    NSDictionary *w = wins[i];
    NSString *bundle = w[@"bundle"];
    if (bundle.length && [gOpenedBeforeRestore containsObject:bundle]) {   // (opened by the user meanwhile: left as it is)
        DMLog([NSString stringWithFormat:@"[restore] %@ skipped: opened by the user before the restore", bundle]);
        [gRestoreHidden removeObject:bundle];   // (the user's window: never kept invisible)
        UIView *mine = DMStageForBundle(bundle);
        if (mine && mine.alpha < 0.01 && !DMStageMinimized(mine)) mine.alpha = 1.0;
        DMRestoreStep(wins, i + 1, state, 0); return;
    }
    CGSize saved = CGSizeFromString(state[@"screen"]), now = [UIScreen mainScreen].bounds.size;
    CGRect f = CGRectFromString(w[@"frame"]);
    CGRect usable = DMLayoutFrame(@"fill");
    if (!CGSizeEqualToSize(saved, now) && saved.width > 100.0) f = DMScaleFrame(f, saved, now);
    BOOL wasChip = f.size.width < 150.0 || f.size.height < 150.0;   // (then its "minimized" was the lock icon too: it is not minimized again)
    if (wasChip) {   // a chip-sized frame saved by an older build (Aerial 5.0's lock icon): the standard place instead
        CGRect c = DMLayoutFrame(@"center");
        if (!CGRectIsNull(c)) { if (waited == 0) DMLog([NSString stringWithFormat:@"[restore] %@ was saved chip-sized (%@): brought back at the standard place", bundle, NSStringFromCGRect(f)]); f = c; }
    }
    if (!CGRectIsNull(usable)) f = DMFitInto(f, usable);
    if (DMAppNeedsFullScreen(bundle)) {   // (see DMAppNeedsFullScreen: never brought back as a window)
        DMLog([NSString stringWithFormat:@"[restore] %@ skipped: it cannot live in a window", bundle]);
        DMRestoreStep(wins, i + 1, state, 0); return;
    }
    if (DMActiveEngine() == DMEngineZetsu && DMZetsuCannotHost(bundle)) {   // (see DMZetsuCannotHost: not brought back as a window at all)
        DMLog([NSString stringWithFormat:@"[restore] %@ skipped: Zetsu cannot host it", bundle]);
        DMRestoreStep(wins, i + 1, state, 0); return;
    }
    UIView *stage = DMStageForBundle(bundle);
    if (!stage && waited == 0 && [w[@"minimized"] boolValue] && !wasChip) {   // (kept invisible from its very first frame: it flashed for ~0.25 s before)
        if (!gRestoreHidden) gRestoreHidden = [NSMutableSet set];
        [gRestoreHidden addObject:bundle];
    }
    if (!stage && waited == 0) {
        DMLog([NSString stringWithFormat:@"[restore] opening %@ at %@", bundle, NSStringFromCGRect(f)]);
        if (DMActiveEngine() == DMEngineMilkyWay) DMLaunchAsWindow(bundle);
        else if (DMActiveEngine() == DMEngineZetsu) DMZetsuLaunch(bundle);
        else DMAerialTrigger(bundle, f);
    }
    if (!stage && waited < 40) {   // wait for its window to appear (up to 12 s)
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRestoreStep(wins, i, state, waited + 1); });
        return;
    }
    if (stage) {
        // A window that was minimized is kept invisible while it is brought back and minimized again (it flashed up for a second after a respring,
        // iPad 2, 27 Sep); it is made visible again in any case after 1.8 s -- by then it is hidden as minimized.
        BOOL minimizedAgain = [w[@"minimized"] boolValue] && !wasChip;
        if (minimizedAgain) stage.alpha = 0.0;
        __weak UIView *weakStage = stage;
        if (minimizedAgain) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ UIView *st = weakStage; if (st && st.alpha < 0.01) st.alpha = 1.0; });
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.9 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{   // let it settle, then put it exactly at its place
            if (minimizedAgain && [gOpenedBeforeRestore containsObject:bundle]) {   // (its icon was tapped while it was being brought back: the user's window stays)
                stage.alpha = 1.0;
                DMLog([NSString stringWithFormat:@"[restore] %@ opened by the user while it was brought back: not minimized again", bundle]);
                [gRestoreHidden removeObject:bundle];
                DMRestoreStep(wins, i + 1, state, 0); return;
            }
            gMoveKeepsOrder = YES;
            if (minimizedAgain) [UIView performWithoutAnimation:^{ DMSetStageFrameSafe(stage, f); [stage layoutIfNeeded]; }];
            else DMAerialMoveStage(stage, f, nil);
            gMoveKeepsOrder = NO;
            if (minimizedAgain) DMMinimizeStage(stage);
            [gRestoreHidden removeObject:bundle];
            DMRestoreStep(wins, i + 1, state, 0);
        });
    } else { [gRestoreHidden removeObject:bundle]; DMRestoreStep(wins, i + 1, state, 0); }   // it never appeared: on to the next
}
static void DMRestoreWindows(int attempt) {
    if (gWindowSaveOn || gRestoringWindows) return;
    if (DMActiveEngine() == DMEngineNone || (DMActiveEngine() == DMEngineAerial && !objc_getClass("AerialCore")) || (DMActiveEngine() == DMEngineMilkyWay && !DMMilkyWayLayer()) || (DMActiveEngine() == DMEngineZetsu && !DMZetsuInstalled())) {
        if (attempt < 30) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRestoreWindows(attempt + 1); });
        else gWindowSaveOn = YES;
        return;
    }
    if (access(DMWindowStatePath().fileSystemRepresentation, F_OK) != 0) { gWindowSaveOn = YES; return; }   // (nothing saved: nothing to wait for)
    id lockMgr = DMSBManager("SBLockScreenManager");
    BOOL locked = [lockMgr respondsToSelector:NSSelectorFromString(@"isUILocked")] && ((BOOL (*)(id, SEL))objc_msgSend)(lockMgr, NSSelectorFromString(@"isUILocked"));
    if (locked || gOverlay) {   // wait for the unlock (the state file is read only after it)
        // (performance audit P7: no file read while waiting, no polling with the screen off -- the lock-state and screen notifications wake it,
        // plus a 2 s look while the screen is on -- and at most 20 min in all, as before)
        static CFTimeInterval waitStart = 0; static int generation = 0, tokLock = 0, tokBlank = 0;
        CFTimeInterval now = CACurrentMediaTime();
        if (!waitStart) waitStart = now;
        if (now - waitStart > 1200.0) { gWindowSaveOn = YES; DMLog(@"[restore] still locked after 20 min: not restored"); return; }
        int mine = ++generation;
        void (^again)(void) = ^{ if (generation == mine && !gWindowSaveOn && !gRestoringWindows) { generation++; DMRestoreWindows(attempt + 1); } };
        if (!tokLock) {
            notify_register_dispatch("com.apple.springboard.lockstate", &tokLock, dispatch_get_main_queue(), ^(int t) { if (waitStart && !gWindowSaveOn && !gRestoringWindows) { generation++; DMRestoreWindows(0); } });
            notify_register_dispatch("com.apple.springboard.hasBlankedScreen", &tokBlank, dispatch_get_main_queue(), ^(int t) { if (waitStart && !gWindowSaveOn && !gRestoringWindows) { generation++; DMRestoreWindows(0); } });
        }
        if (!gDMScreenOff) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), again);
        return;
    }
    NSDictionary *state = [NSDictionary dictionaryWithContentsOfFile:DMWindowStatePath()];
    NSArray *wins = [state[@"windows"] isKindOfClass:[NSArray class]] ? state[@"windows"] : nil;
    if (!wins.count) { gWindowSaveOn = YES; return; }
    // a start that ended during the last restore skips it once (a crash loop must not repeat itself)
    struct stat st;
    if (stat("/tmp/macstatusbar-restore-guard", &st) == 0 && difftime(time(NULL), st.st_mtime) < 60.0) {
        DMLog(@"[restore] skipped: the previous start ended during a restore");
        unlink("/tmp/macstatusbar-restore-guard"); gWindowSaveOn = YES; return;
    }
    FILE *g = fopen("/tmp/macstatusbar-restore-guard", "w"); if (g) fclose(g);
    gRestoringWindows = YES;
    DMLog([NSString stringWithFormat:@"[restore] %lu windows to bring back", (unsigned long)wins.count]);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(120.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gRestoringWindows) { gRestoringWindows = NO; gWindowSaveOn = YES; unlink("/tmp/macstatusbar-restore-guard"); DMLog(@"[restore] gave up after 120 s"); } });
    DMRestoreStep(wins, 0, state, 0);
}
// LIVE-REPORTED BUG (2026-09-23): a menu left open across a real device rotation can keep showing the PREVIOUS orientation's turn until it is
// dismissed and reopened, rather than following the rotation as it happens. Root cause: DMMenuHost() (the function that computes gMenuRotator's
// pivot/transform for the current orientation, a few hundred lines below) is only ever called at the moment a menu is OPENED -- from DMHostFor(),
// itself only called from DMOpenMenu/DMPresentMenu et al. Nothing calls it again while a menu is already showing, so gMenuRotator's transform is a
// one-time snapshot of whatever orientation was current at open time, never revisited. This is a different bug from the two fixed earlier tonight
// (the pivot math and the ambiguous-accelerometer fallback in DMRealInterfaceOrientation): those govern what DMMenuHost() computes WHEN IT RUNS;
// this one is about it never running again while a menu is already up. DMRealInterfaceOrientation() itself was checked and is not at fault here --
// it always re-reads live state and only falls back to its own remembered value when the live reading is genuinely ambiguous, so it is not silently
// masking a fresh confident reading; the gap is architectural, not a caching bug in that function.
// The fix here does not try to reposition an already-open menu's panel for the new orientation live (the panel's on-screen position was computed
// from where its button was at open time, in the OLD orientation's coordinate space; recomputing that correctly for every menu/dialog type this
// file can show -- Edit/Go/Window/Audio/App menus, About, Force Quit, confirm dialogs -- would be a much larger, riskier change for comparatively
// little benefit). Instead, exactly like a real rotation-driven layout change dismisses an open menu in other systems, this closes the menu the
// moment the orientation it was built for stops matching the live one, rather than ever showing it turned wrong. Cheap and safe to run on every
// 0.2 s tick (DMSyncWindowsForLibraryBody, below): DMRealInterfaceOrientation() and the "turned" check are pure reads, and DMCloseOverlay() is the
// same normal, animated close already used for every other way a menu closes.
static long DMRealInterfaceOrientation(void);   // defined below
static void DMCloseOverlay(void);                // defined below
static UIWindow *gMenuWindow;                    // defined below
static long gMenuRotatorBuiltForOrientation;     // defined below
static CGSize gMenuBuiltForScreen;               // defined below
// Bug (0.27.7-32: "the issue persists"): this check used to bail out unless the menu window was in the "turned" state AND the open menu had
// been built in gMenuRotator. Live log on iPad 2 showed a menu opened, the device turned twice, and no close: whenever the menu was opened while the
// window was NOT turned, DMMenuHost() set gMenuRotatorBuiltForOrientation to 0, and once the device turned the window's state flipped under the open
// menu anyway -- so the common case never reached the comparison. DMMenuHost() now records the orientation AND the screen size for every menu it
// hosts, turned or not, and any change in either while the menu is open closes it. The orientation reading must disagree on two ticks in a row
// (0.4 s) before closing, so a single momentary reading can't close a menu the user is still using; a change in the screen's own shape is
// unambiguous and closes at once.
static void DMCloseMenuIfOrientationStale(void) {
    static int mismatchTicks = 0;
    if (!gOverlay || !gMenuWindow || gMenuRotatorBuiltForOrientation == 0) { mismatchTicks = 0; return; }
    CGSize screen = [UIScreen mainScreen].bounds.size;
    BOOL screenChanged = gMenuBuiltForScreen.width > 1.0 && (fabs(screen.width - gMenuBuiltForScreen.width) > 1.0 || fabs(screen.height - gMenuBuiltForScreen.height) > 1.0);
    // iPadOS 15: the menu window turns with the screen itself, so a landscape left <-> right turn keeps every menu upright and in place; a turn to
    // the other shape moved the titles on the right away from their open menu (layering audit F3), so only the change of shape closes it here.
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 && !screenChanged) { mismatchTicks = 0; return; }
    long orientation = DMRealInterfaceOrientation();
    if (orientation == gMenuRotatorBuiltForOrientation && !screenChanged) { mismatchTicks = 0; return; }
    if (!screenChanged && ++mismatchTicks < 2) return;
    DMLog([NSString stringWithFormat:@"[menuhost] orientation changed from %ld to %ld (screen %@ -> %@) while a menu was open -- closing it instead of leaving it showing the old turn",
           gMenuRotatorBuiltForOrientation, orientation, NSStringFromCGSize(gMenuBuiltForScreen), NSStringFromCGSize(screen)]);
    mismatchTicks = 0;
    gMenuRotatorBuiltForOrientation = 0;
    DMCloseOverlay();
}
// Aerial 5.0 on iOS 15 (M1): its window layer (AerialWindow) answers -autorotates NO and, with "Use New Rotation Method" off (the only value
// that draws correctly on iOS 15), Aerial's own rotation code never turns it on this iOS. After a turn the layer kept the old orientation, so
// every window was drawn sideways in portrait (requested: "the windows stay in landscape"), and upside down after a landscape-left <-> right turn.
// Measured live (rawshot): UIKit's own window rotation call _setRotatableViewOrientation:updateStatusBar:duration:force: (a UIWindow method,
// nothing of Aerial's is hooked or called) turns the layer to SpringBoard's interface orientation and the windows are drawn upright again.
// Checked every 0.2 s tick, before the relayout, so it also covers turns that keep the screen size (landscape left <-> right).
static BOOL DMAerial5SyncLayerOrientation(void) {
    // (also Aerial 3.0 on iOS 15, 2026-09-24 Phase 2: the same thing was measured there -- after a turn to landscape its window layer kept portrait bounds,
    // Aerial's own _adjustStageToFitScreenIfNeeded then squeezed every window into the same 293 x 794 frame, drawn sideways; debug off switch for 3.0:
    // /tmp/msb-a3-norotate)
    if ((gAerialFlavor != 5 && gAerialFlavor != 3) || DMActiveEngine() != DMEngineAerial) return NO;
    if (gAerialFlavor == 3 && DMTestFlag("/tmp/msb-a3-norotate")) return NO;
    static int ios16 = -1;
    if (ios16 < 0) ios16 = [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}] ? 1 : 0;
    if (ios16 || DMTestFlag("/tmp/msb-a5-norotate")) return NO;
    id app = [UIApplication sharedApplication];
    SEL activeSel = NSSelectorFromString(@"activeInterfaceOrientation"), haveSel = NSSelectorFromString(@"_windowInterfaceOrientation");
    SEL rotSel = NSSelectorFromString(@"_setRotatableViewOrientation:updateStatusBar:duration:force:"), busySel = NSSelectorFromString(@"isRotating");
    if (![app respondsToSelector:activeSel]) return NO;
    long want = ((long (*)(id, SEL))objc_msgSend)(app, activeSel);
    if (want < 1 || want > 4) return NO;
    BOOL turned = NO;
    // the window layer, and Aerial's keyboard window (same story: it kept the orientation SpringBoard started in, so the on-screen keyboard in a window
    // was drawn sideways after a turn -- our keyboard-host fix, DMFixKeyboardHostIOS15, expects that window to be turned with the screen)
    for (UIWindow *w in DMAllWindows()) {
        NSString *cls = NSStringFromClass([w class]);
        if (![cls isEqualToString:@"AerialWindow"] && ![cls isEqualToString:@"AerialKeyboardWindow"]) continue;
        // hardware keyboard attached: its keyboard window (the input bar / pill) is left exactly as before -- only the on-screen keyboard was tested here
        if ([cls isEqualToString:@"AerialKeyboardWindow"] && DMHardwareKeyboardAttached()) continue;
        if (![w respondsToSelector:haveSel] || ![w respondsToSelector:rotSel]) continue;
        long have = ((long (*)(id, SEL))objc_msgSend)(w, haveSel);
        if (want == have) continue;
        if ([w respondsToSelector:busySel] && ((BOOL (*)(id, SEL))objc_msgSend)(w, busySel)) continue;
        ((void (*)(id, SEL, long, BOOL, double, BOOL))objc_msgSend)(w, rotSel, want, NO, 0.3, YES);
        DMLog([NSString stringWithFormat:@"[aerial5] %@ turned from orientation %ld to %ld (frame now %@)", [cls isEqualToString:@"AerialWindow"] ? @"window layer" : @"keyboard window", have, want, NSStringFromCGRect(w.frame)]);
        turned = YES;
    }
    return turned;
}
// The on-screen keyboard is ONE shared scene (com.apple.UIKit.remote-keyboard); its picture (a _UIScenePresentationView) sits inside whichever
// _UIKeyboardLayerHostView is "paired" with it: SpringBoard's own host for the full-screen app (in SBMainSwitcherWindow, level 5) or the one Aerial
// makes in AerialKeyboardWindow (level 1052) for an app in a window. Returns the host holding the picture now (nil: no keyboard picture anywhere).
static UIView *DMKeyboardPresentingHost(void) {
    for (UIWindow *w in DMAllWindows()) {
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            if ([NSStringFromClass([v class]) isEqualToString:@"_UIScenePresentationView"]) {
                id scene = nil; @try { scene = [v valueForKey:@"scene"]; } @catch (id e) {}
                NSString *ident = [scene respondsToSelector:NSSelectorFromString(@"identifier")] ? [scene valueForKey:@"identifier"] : nil;
                if ([ident containsString:@"keyboard"])
                    for (UIView *up = v.superview; up && up != w; up = up.superview)
                        if ([NSStringFromClass([up class]) isEqualToString:@"_UIKeyboardLayerHostView"]) return up;
                continue;   // (nothing of interest inside another scene's picture)
            }
            [stack addObjectsFromArray:v.subviews];
        }
    }
    return nil;
}
static id DMKeyboardHostOwningScene(UIView *host) {   // the app scene a keyboard host view was made for (read-only ivar)
    Ivar iv = host ? class_getInstanceVariable([host class], "_owningScene") : NULL;
    return iv ? object_getIvar(host, iv) : nil;
}
static id DMKeyboardFocusController(void) {
    id ws = DMCall(objc_getClass("SBMainWorkspace"), @"sharedInstance");
    return [ws respondsToSelector:NSSelectorFromString(@"keyboardFocusController")] ? DMCall(ws, @"keyboardFocusController") : nil;
}
// Reported bug (2026-09-24, M1, iOS 15, Aerial 5.0): Notes typing in a window over full-screen Safari, the iPad is turned -> the keyboard ends up BEHIND
// the Notes window until the text field is tapped again. Measured (kbfocus trigger): on every turn SpringBoard's keyboard focus controller re-picks the
// full-screen app (Safari) as the keyboard focus target -- it knows nothing about Aerial's windows. The on-screen keyboard still belongs to Notes, but the
// next time the keyboard scene re-evaluates its host (a relayout, sometimes a second or two later, sometimes never), it pairs with the focused scene's
// host: SpringBoard's own one in SBMainSwitcherWindow (level 5), under the windows (seen in the log of the owner's session: the picture moved there after
// each turn; twice Aerial took it back 1.4-2.4 s later, the third time never). A tap in the field fixed it because a tap requests focus for Notes.
// So after a turn, when the focus moved from a window's app to the full-screen app behind the windows and nobody has tapped that app, focus is requested
// back for the window's scene, exactly as a tap would (-[SBWorkspaceKeyboardFocusController userFocusRequestForScene:reason:]). Nothing of Aerial's is
// touched. It does not depend on the keyboard being up: SpringBoard's own keyboard measurement (gSoftKeyboardH) reads 3 pt for seconds after such a
// turn although Notes' keyboard is still showing, and the window that had the focus before a turn should keep it anyway (a hardware keyboard too).
static NSString *DMBundleOfSceneID(id scene) {   // "sceneID:com.apple.reminders-<UUID>" / "...-default" -> the bundle id
    NSString *ident = nil; @try { ident = scene ? [scene valueForKey:@"identifier"] : nil; } @catch (id e) {}   // (KVC on a private class: guarded)
    if (![ident isKindOfClass:[NSString class]] || ![ident hasPrefix:@"sceneID:"]) return nil;
    NSString *rest = [ident substringFromIndex:8];
    if ([rest hasSuffix:@"-default"]) return [rest substringToIndex:rest.length - 8];
    if (rest.length > 37 && [rest characterAtIndex:rest.length - 37] == '-') return [rest substringToIndex:rest.length - 37];
    return nil;
}
// Keyboard Phase (iPad 2, iOS 16, hardware keyboard): a window brought to the front WITHOUT a tap in it (Cmd-Tab, a Spotlight result, a Dock icon,
// our menus) did not get SpringBoard's keyboard focus: the keys went on to the window that had it before (seen: Return after Cmd-Tab to Safari
// reached Clock behind it and opened its "Edit Alarm" sheet). A tap gives focus by itself; for the other ways, when the front window's app changes
// and within 1.5 s the keyboard focus still sits on another app, focus is asked for the front window's scene once -- what a tap in it would do.
// Only while a hardware keyboard is attached (the on-screen keyboard's behaviour without one is left exactly as it was).
static void DMKeyboardFocusFollowsFrontWindow(void) {
    static NSString *lastFront = nil; static CFTimeInterval changedAt = 0; static BOOL asked = NO;
    if (DMTestFlag("/tmp/msb-nokbfollow")) return;
    NSString *front = [DMActiveApp() bundleIdentifier] ?: @"";
    CFTimeInterval now = CACurrentMediaTime();
    if (![front isEqualToString:lastFront ?: @""]) { lastFront = front; changedAt = now; asked = NO; }
    if (asked || now - changedAt > 1.5 || now - changedAt < 0.25 || !front.length || !DMHasWindowFor(front)) return;
    if (!DMHardwareKeyboardAttached() || DMSpotlightShown()) return;
    UIView *st = DMStageForBundle(front);
    if (DMActiveEngine() != DMEngineZetsu && (!st || st.hidden || DMStageMinimized(st))) return;
    id kfc = DMKeyboardFocusController();
    id focused = [kfc respondsToSelector:NSSelectorFromString(@"externalSceneWithFocus")] ? DMCall(kfc, @"externalSceneWithFocus") : nil;
    NSString *fb = DMBundleOfSceneID(focused);
    if (!fb.length || [fb isEqualToString:front]) { if (fb.length) asked = YES; return; }   // (focus on Spotlight, a banner, nothing: left alone)
    id scene = DMSceneForBundle(front);
    if (!scene) return;
    SEL req3 = NSSelectorFromString(@"userFocusRequestForScene:reason:completion:"), req2 = NSSelectorFromString(@"userFocusRequestForScene:reason:");
    asked = YES;
    if ([kfc respondsToSelector:req3]) ((void (*)(id, SEL, id, id, id))objc_msgSend)(kfc, req3, scene, @"MacStatusBar: the front window takes the keyboard", nil);
    else if ([kfc respondsToSelector:req2]) ((void (*)(id, SEL, id, id))objc_msgSend)(kfc, req2, scene, @"MacStatusBar: the front window takes the keyboard");
    else return;
    DMLog([NSString stringWithFormat:@"[kbfocus] %@ came to the front without a tap (keyboard focus was on %@): focus given to its window", front, fb]);
}
static void DMKeepKeyboardFocusOnWindowAfterTurn(void) {
    static int ios16 = -1;
    if (ios16 < 0) ios16 = [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}] ? 1 : 0;
    if (DMActiveEngine() != DMEngineAerial || DMTestFlag("/tmp/msb-nokbfocusfix")) return;
    if (ios16) {
        // iPadOS 16 (iPad 2 cross-test): the same turn gives SpringBoard's keyboard focus to the full-screen app behind the windows, but here the
        // keyboard does not slip under the windows -- it goes away (the window's text field stays active, the keyboard is gone until tapped). So:
        // when a window's app had the keyboard up right before the turn, and within 4 s after it the focus sits on the full-screen front app and no
        // keyboard is showing, the focus is asked back for the window's scene, the way a tap in its field would (once per turn).
        static long last16 = 0; static CFTimeInterval turned16 = 0; static CGFloat kbSeen = 0, kbAtTurn = 0; static __weak id typer16 = nil; static BOOL asked16 = NO;
        long o16 = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"activeInterfaceOrientation"));
        CFTimeInterval t = CACurrentMediaTime();
        id kfc16 = DMKeyboardFocusController();
        id focused16 = [kfc16 respondsToSelector:NSSelectorFromString(@"externalSceneWithFocus")] ? DMCall(kfc16, @"externalSceneWithFocus") : nil;
        if (o16 != last16) { if (last16) { turned16 = t; kbAtTurn = kbSeen; asked16 = NO; } last16 = o16; }
        if (t - turned16 > 4.5) {   // (outside a turn: remember who types and whether the keyboard is up)
            kbSeen = gSoftKeyboardH;
            NSString *fb = DMBundleOfSceneID(focused16);   // (by bundle: Reminders has two scenes, the focused one is not always the one we track)
            UIView *fst = fb.length ? DMStageForBundle(fb) : nil;
            typer16 = (fst && !fst.hidden && !DMStageMinimized(fst)) ? focused16 : nil;
        }
        if (t - turned16 < 4.0 && DMTestFlag("/tmp/macstatusbar-debug")) {
            static NSString *lastWhy16 = nil;
            NSString *why = [NSString stringWithFormat:@"[kbfocus] iOS 16 after turn: asked %d typer %@ kbAtTurn %.0f kb %.0f focused %@ fsActivated %@", asked16, [typer16 valueForKey:@"identifier"], kbAtTurn, gSoftKeyboardH, [focused16 valueForKey:@"identifier"], gFullScreenActivatedBundle];
            if (![why isEqualToString:lastWhy16]) { lastWhy16 = why; DMLog(why); }
        }
        if (asked16 || !typer16 || kbAtTurn < 100.0 || t - turned16 > 4.0 || t - turned16 < 0.3 || gSoftKeyboardH > 50.0) return;
        if (gFullScreenActivatedBundle.length) return;   // (a tap on the full-screen app: it is meant to type; DMFullScreenAppTyping is not asked -- it reads the very focus that moved)
        // (the focus went to an app with no window -- the full-screen one behind the windows; our own "front app" is the front window by then)
        NSString *fsBundle = DMBundleOfSceneID(focused16);
        if (!fsBundle.length || DMHasWindowFor(fsBundle)) { static int n16 = 0; if (n16++ < 5) DMLog([NSString stringWithFormat:@"[kbfocus] iOS 16: focus on %@ (window %d): left alone", fsBundle, fsBundle.length ? DMHasWindowFor(fsBundle) : -1]); return; }
        NSString *tb = DMBundleOfSceneID(typer16); UIView *tst = tb.length ? DMStageForBundle(tb) : nil;
        BOOL shown16 = tst && !tst.hidden && !DMStageMinimized(tst);
        SEL req16 = NSSelectorFromString(@"userFocusRequestForScene:reason:completion:"), req15 = NSSelectorFromString(@"userFocusRequestForScene:reason:");   // (iOS 16 has only the one with a completion)
        BOOL has3 = [kfc16 respondsToSelector:req16], has2 = [kfc16 respondsToSelector:req15];
        if (!shown16 || (!has3 && !has2)) { DMLog([NSString stringWithFormat:@"[kbfocus] iOS 16: typer %@ shown %d, no focus request method", tb, shown16]); asked16 = YES; return; }
        asked16 = YES;
        if (has3) ((void (*)(id, SEL, id, id, id))objc_msgSend)(kfc16, req16, typer16, @"MacStatusBar: the window typing before the turn keeps the keyboard", nil);
        else ((void (*)(id, SEL, id, id))objc_msgSend)(kfc16, req15, typer16, @"MacStatusBar: the window typing before the turn keeps the keyboard");
        DMLog([NSString stringWithFormat:@"[kbfocus] iOS 16: the turn gave keyboard focus to %@ and the keyboard went away; focus given back to the window %@", [focused16 valueForKey:@"identifier"], [typer16 valueForKey:@"identifier"]]);
        return;
    }
    static __weak id typerScene = nil;   // the window's app scene that had keyboard focus before the turn
    static long lastOrientation = 0;
    static CFTimeInterval turnedAt = 0;
    static int requests = 0;
    id app = [UIApplication sharedApplication];
    SEL activeSel = NSSelectorFromString(@"activeInterfaceOrientation");
    long o = [app respondsToSelector:activeSel] ? ((long (*)(id, SEL))objc_msgSend)(app, activeSel) : 0;
    CFTimeInterval now = CACurrentMediaTime();
    if (o != lastOrientation) { if (lastOrientation) { turnedAt = now; requests = 0; } lastOrientation = o; }
    id kfc = DMKeyboardFocusController();
    if (![kfc respondsToSelector:NSSelectorFromString(@"externalSceneWithFocus")]) return;
    id focused = DMCall(kfc, @"externalSceneWithFocus");
    id stageScene = nil;
    for (UIView *stage in DMAerialStages()) {
        if (stage.hidden || DMStageMinimized(stage)) continue;
        id sc = DMSceneForBundle(DMStageBundle(stage));
        if (sc && sc == focused) { stageScene = sc; break; }
    }
    static CFTimeInterval focusAwaySince = 0;
    if (stageScene) { typerScene = stageScene; focusAwaySince = 0; return; }   // a window's app has the keyboard focus: remember it
    if (!focusAwaySince) focusAwaySince = now;
    // (the typer is not forgotten when the focus merely moved away: on the M1 it moved to the full-screen app on one turn and the picture followed only on a
    // later one. A deliberate move -- a tap on the full-screen app -- is caught by gFullScreenActivatedBundle below, a window that went away by stillShown.)
    if (now - turnedAt < 3.0 && DMTestFlag("/tmp/macstatusbar-debug")) {   // debug: why a turn is (not) acted on, once per state
        static NSString *lastWhy = nil;
        NSString *why = [NSString stringWithFormat:@"[kbfocus] after turn: focused %@ typer %@ requests %d fsActivated %@ fsTyping %d front %@", [focused valueForKey:@"identifier"], [typerScene valueForKey:@"identifier"], requests, gFullScreenActivatedBundle, DMFullScreenAppTyping(), [DMFrontApp() bundleIdentifier]];
        if (![why isEqualToString:lastWhy]) { lastWhy = why; DMLog(why); }
    }
    if (!typerScene || now - turnedAt > 6.0 || requests >= 2) return;
    if (gFullScreenActivatedBundle.length || DMFullScreenAppTyping()) return;   // the full-screen app was tapped: it is meant to type
    NSString *frontBundle = [DMFrontApp() bundleIdentifier];   // only a focus that went to the full-screen app behind the windows is taken back (never Spotlight, a banner...)
    if (!frontBundle.length || !focused || DMSceneForBundle(frontBundle) != focused) return;
    BOOL stillShown = NO;
    for (UIView *stage in DMAerialStages()) if (!stage.hidden && !DMStageMinimized(stage) && DMSceneForBundle(DMStageBundle(stage)) == typerScene) stillShown = YES;
    if (!stillShown) { typerScene = nil; return; }
    // Only when the keyboard picture really went under the windows (the symptom): the picture is shown by a host outside Aerial's keyboard window. The
    // focus alone moves on many turns without any visible harm, and a focus request made then took the keyboard away altogether on some turns (seen on
    // the M1, 2026-09-24 04:05: host unpaired, no keyboard until the field was tapped again) -- so nothing is done unless the picture itself moved.
    UIView *shownBy = DMKeyboardPresentingHost();
    if (!shownBy || [NSStringFromClass([shownBy.window class]) isEqualToString:@"AerialKeyboardWindow"]) return;
    SEL req = NSSelectorFromString(@"userFocusRequestForScene:reason:");
    if (![kfc respondsToSelector:req]) return;
    requests++;
    ((void (*)(id, SEL, id, id))objc_msgSend)(kfc, req, typerScene, @"MacStatusBar: the window typing before the turn keeps the keyboard");
    DMLog([NSString stringWithFormat:@"[kbfocus] the turn gave keyboard focus to %@ and the keyboard went to %@ (under the windows); focus given back to the window %@ (request %d)", [focused valueForKey:@"identifier"], NSStringFromClass([shownBy.window class]), [typerScene valueForKey:@"identifier"], requests]);
}
static void DMWatchOrientation(void) {
    DMAerial5SyncLayerOrientation();
    CGSize now = [UIScreen mainScreen].bounds.size;
    if (now.width < 200.0 || now.height < 200.0) return;
    // A turn to the OTHER landscape (3 <-> 4) or portrait <-> upside down keeps the screen size, but Aerial 5.0 still resets every stage to its own centred
    // default frame (seen on iPad 2, iOS 16: both windows stacked at x 344, 335 x 728 after 3 -> 4), so a flip is re-arranged too. The new orientation must
    // hold for two ticks (0.4 s) so one odd reading (statusBarOrientation can lie while a window is up) never moves anything.
    static long laidOutOrientation = 0; static int flipTicks = 0;
    long orientation = DMRealInterfaceOrientation();
    if (gLaidOutScreen.width < 1.0) { gLaidOutScreen = now; laidOutOrientation = orientation; return; }
    if (CGSizeEqualToSize(now, gLaidOutScreen)) {
        if (orientation == laidOutOrientation || laidOutOrientation == 0) { flipTicks = 0; laidOutOrientation = orientation; return; }
        if (++flipTicks < 2) return;
        flipTicks = 0;
        DMLog([NSString stringWithFormat:@"[orient] flipped %ld -> %ld at the same screen size %@: arranging the windows again", laidOutOrientation, orientation, NSStringFromCGSize(now)]);
        laidOutOrientation = orientation;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRelayoutForOrientation(now, now); });
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout]; });
        return;
    }
    flipTicks = 0; laidOutOrientation = orientation;
    CGSize old = gLaidOutScreen;
    gLaidOutScreen = now;
    // let Aerial finish its own adjustment for the new shape first, then arrange the windows
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRelayoutForOrientation(old, now); });
    // Bug (reported): the SSH icon (and the row of Control Center status icons it hugs) can end up mid-bar right after a turn. dm_layoutLogo reads their
    // CURRENT frames every time it runs (via layoutSubviews), so a stale position is a one-off snapshot taken while the stock icons were still mid-way
    // through their own post-rotation layout, not a wrong formula -- the next real layoutSubviews call already gets it right, which is why it "fixes
    // itself after a while". Forcing one more layout pass on every visible copy once the turn has had a moment to settle (same 0.4 s the window
    // relayout above already waits) catches that stale snapshot without waiting for something else to happen to ask for a layout pass first.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout]; });
}
static void DMStageTrace(NSString *what, UIView *stage) {
    if (!DMTestFlag("/tmp/macstatusbar-debug")) return;
    NSArray *stack = [NSThread callStackSymbols];
    NSMutableString *s = [NSMutableString string];
    for (NSUInteger i = 2; i < stack.count && i < 6; i++) [s appendFormat:@" | %@", [stack[i] substringFromIndex:MIN((NSUInteger)4, [stack[i] length])]];
    DMLog([NSString stringWithFormat:@"[trace] %@ %@ frame %@ window %@%@", what, DMStageBundle(stage), NSStringFromCGRect(stage.frame), NSStringFromCGRect(stage.window.bounds), s]);
}

// The Aerial hooks whose selectors are renamed by obfuscated builds (5.0): their bodies live here as plain functions, used both by the %hook
// versions (3.0, real names) and by the runtime hooks that DMHookAerialObfuscated installs on the resolved names.
static void DMAerialMinimizeBody(UIView *stage) {   // replaces Aerial's minimize completely (the original is never called)
    if (CACurrentMediaTime() < gLockingUntil) { DMLog(@"[aerial] locking the screen: window left as it is"); return; }   // Aerial minimizes every window on lock; they stay as they are
    DMMinimizeStage(stage);
}
// A drag by hand. NO: the drag was cancelled here and the original must not run.
static BOOL DMAerialPanBefore(UIView *stage, UIPanGestureRecognizer *g) {
    UIGestureRecognizerState s = g.state;
    // A window is moved by its title bar only. Aerial's window drag recogniser also starts from a finger dragging inside the app (scrolling a page moved the
    // whole window first): a drag that did not start in the title bar is cancelled before it reaches the drag code.
    if (s == UIGestureRecognizerStateBegan) {
        if ([g respondsToSelector:@selector(setAllowedScrollTypesMask:)]) g.allowedScrollTypesMask = 0;   // (two-finger scrolling on a trackpad must not drag a window)
        CGPoint here = [g locationInView:stage], moved = [g translationInView:stage];
        BOOL byScroll = g.numberOfTouches == 0;   // a trackpad scroll: no touch, the pointer stays where it is
        CGPoint start = byScroll ? here : CGPointMake(here.x - moved.x, here.y - moved.y);   // where the finger / pointer went down (the recogniser only begins after some movement)
        // (the title bar reaches lower while the auto-hiding status bar has slid it down; a few points of slack for the recogniser's own start
        // point, which lags the finger by its threshold -- injected and quick drags from y 20 read as 30)
        if (byScroll || start.y > kStageBarHeight + 12.0 + DMAutoHideTitleShiftOf(stage)) {
            g.enabled = NO; g.enabled = YES;   // cancels this drag
            static int logged = 0; if (logged++ < 6) DMLog([NSString stringWithFormat:@"[aerial] a drag that started inside the window (y %.0f, scroll %d) does not move it", start.y, byScroll]);
            return NO;
        }
        objc_setAssociatedObject(stage, kStageGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    return YES;
}
// After a drag (pan) or a resize by hand: remember the place it ends up in.
static void DMAerialGestureAfter(UIView *stage, UIGestureRecognizerState s, BOOL wasPan) {
    if (s == UIGestureRecognizerStateEnded || s == UIGestureRecognizerStateCancelled || s == UIGestureRecognizerStateFailed) {
        objc_setAssociatedObject(stage, kStageGestureKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMRememberStageFrame(stage);
        DMFitGroupForget(DMStageBundle(stage));   // placed by hand: no longer tiled
        if (wasPan) DMSaveWindowState();
    }
}
%group AerialStyleNamed
%hook AerialStage
// Every minimize (Aerial's own menu included) works the MilkyWay way instead of making the round chip.
- (void)minimizeStage { DMAerialMinimizeBody((UIView *)self); }
// Aerial's own fit-to-screen logic: whatever it does, the window returns to where it was put.
- (void)_adjustStageToFitScreenIfNeeded {
    DMStageTrace(@"_adjustStageToFitScreenIfNeeded", (UIView *)self);
    %orig;
    DMEnforceStageFrame((UIView *)self, @"fit-to-screen");
}
- (void)_saveCurrentStateForOrientation {
    DMStageTrace(@"_saveCurrentStateForOrientation", (UIView *)self);
    %orig;
}
- (void)_applyFlexDisabledLayoutWithScreenBounds:(CGRect)bounds {
    DMStageTrace(@"_applyFlexDisabledLayoutWithScreenBounds", (UIView *)self);
    %orig;
    DMEnforceStageFrame((UIView *)self, @"the flex-disabled layout");
}
- (void)removeStageSafely {
    DMStageTrace(@"removeStageSafely", (UIView *)self);
    %orig;
}
- (void)restoreFromMinimize {
    DMStageTrace(@"restoreFromMinimize", (UIView *)self);
    %orig;
}
- (void)handlePan:(id)gesture {
    if (!DMAerialPanBefore((UIView *)self, gesture)) return;
    %orig;
    DMAerialGestureAfter((UIView *)self, [(UIGestureRecognizer *)gesture state], YES);
}
- (void)handleResizeBR:(id)gesture {
    if ([(UIGestureRecognizer *)gesture state] == UIGestureRecognizerStateBegan) objc_setAssociatedObject(self, kStageGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    %orig;
    DMAerialGestureAfter((UIView *)self, [(UIGestureRecognizer *)gesture state], NO);
}
%end
%hook AerialCore
// Aerial sends the apps of its windows to the background when it hides its window layer for the App Switcher (a video then pauses; a music app keeps going
// on its own). The windows are not really gone, so their apps stay in the foreground: not while the screen is locked or off, and not for a window that
// is being closed.
+ (void)setForeground:(id)app foregroundvalue:(BOOL)value {
    if (!value && DMKeepWindowedApp(app, @"foreground off")) return;
    %orig;
}
+ (void)forceBackgrounded:(BOOL)flag forApp:(id)app {
    if (flag && DMKeepWindowedApp(app, @"force background")) return;
    %orig;
}
%end
%end
// The same hooks for an obfuscated build (5.0), installed on the names DMAerialResolveObfuscated found. Each replacement has exactly the
// signature the resolver verified from the method's type encoding (a mismatch would have left Aerial switched off).
static void (*o5_minimizeT)(id, SEL, CGAffineTransform);
static void (*o5_minimize)(id, SEL);
static void (*o5_fit)(id, SEL), (*o5_save)(id, SEL), (*o5_removeSafely)(id, SEL), (*o5_restore)(id, SEL);
static void (*o5_flex)(id, SEL, CGRect);
static void (*o5_pan)(id, SEL, id), (*o5_resizeBR)(id, SEL, id);
static void (*o5_setFg)(id, SEL, id, BOOL);
static void (*o5_forceBg)(id, SEL, BOOL, id);
static void h5_minimizeT(id self, SEL _cmd, CGAffineTransform t) { DMAerialMinimizeBody((UIView *)self); }
static void h5_minimize(id self, SEL _cmd) { DMAerialMinimizeBody((UIView *)self); }
static void h5_fit(id self, SEL _cmd) {
    DMStageTrace(@"_adjustStageToFitScreenIfNeeded", (UIView *)self);
    if (o5_fit) o5_fit(self, _cmd);
    DMEnforceStageFrame((UIView *)self, @"fit-to-screen");
}
static void h5_save(id self, SEL _cmd) { DMStageTrace(@"_saveCurrentStateForOrientation", (UIView *)self); if (o5_save) o5_save(self, _cmd); }
static void h5_removeSafely(id self, SEL _cmd) { DMStageTrace(@"removeStageSafely", (UIView *)self); if (o5_removeSafely) o5_removeSafely(self, _cmd); }
static void h5_restore(id self, SEL _cmd) { DMStageTrace(@"restoreFromMinimize", (UIView *)self); if (o5_restore) o5_restore(self, _cmd); }
static void h5_flex(id self, SEL _cmd, CGRect bounds) {
    DMStageTrace(@"_applyFlexDisabledLayoutWithScreenBounds", (UIView *)self);
    if (o5_flex) o5_flex(self, _cmd, bounds);
    DMEnforceStageFrame((UIView *)self, @"the flex-disabled layout");
}
static void h5_pan(id self, SEL _cmd, id gesture) {
    if (!DMAerialPanBefore((UIView *)self, gesture)) return;
    if (o5_pan) o5_pan(self, _cmd, gesture);
    DMAerialGestureAfter((UIView *)self, [(UIGestureRecognizer *)gesture state], YES);
}
static void h5_resizeBR(id self, SEL _cmd, id gesture) {
    if ([(UIGestureRecognizer *)gesture state] == UIGestureRecognizerStateBegan) objc_setAssociatedObject(self, kStageGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (o5_resizeBR) o5_resizeBR(self, _cmd, gesture);
    DMAerialGestureAfter((UIView *)self, [(UIGestureRecognizer *)gesture state], NO);
}
static void h5_setFg(id self, SEL _cmd, id app, BOOL value) {
    if (!value && DMKeepWindowedApp(app, @"foreground off")) return;
    if (o5_setFg) o5_setFg(self, _cmd, app, value);
}
static void h5_forceBg(id self, SEL _cmd, BOOL flag, id app) {
    if (flag && DMKeepWindowedApp(app, @"force background")) return;
    if (o5_forceBg) o5_forceBg(self, _cmd, flag, app);
}
static void DMHookAerialObfuscated(void) {
    Class stage = objc_getClass("AerialStage"), coreMeta = object_getClass((id)objc_getClass("AerialCore"));
    // a last check right before hooking: each resolved method must still be there, defined on that class itself
    NSArray *stageRoles = @[@"minimizeStage", @"_adjustStageToFitScreenIfNeeded", @"_saveCurrentStateForOrientation", @"removeStageSafely", @"restoreFromMinimize",
                            @"_applyFlexDisabledLayoutWithScreenBounds:", @"handlePan:", @"handleResizeBR:"];
    for (NSString *r in stageRoles) if (!gAerialSelMap[r] || !class_getInstanceMethod(stage, DMAerialSel(r))) { DMLog([NSString stringWithFormat:@"[aerial] %@ vanished before hooking: runtime hooks skipped", r]); return; }
    for (NSString *r in @[@"setForeground:foregroundvalue:", @"forceBackgrounded:forApp:"]) if (!gAerialSelMap[r] || !class_getInstanceMethod(coreMeta, DMAerialSel(r))) { DMLog([NSString stringWithFormat:@"[aerial] %@ vanished before hooking: runtime hooks skipped", r]); return; }
    if (gAerialMinimizeTakesTransform) MSHookMessageEx(stage, DMAerialSel(@"minimizeStage"), (IMP)h5_minimizeT, (IMP *)&o5_minimizeT);
    else MSHookMessageEx(stage, DMAerialSel(@"minimizeStage"), (IMP)h5_minimize, (IMP *)&o5_minimize);
    MSHookMessageEx(stage, DMAerialSel(@"_adjustStageToFitScreenIfNeeded"), (IMP)h5_fit, (IMP *)&o5_fit);
    MSHookMessageEx(stage, DMAerialSel(@"_saveCurrentStateForOrientation"), (IMP)h5_save, (IMP *)&o5_save);
    MSHookMessageEx(stage, DMAerialSel(@"removeStageSafely"), (IMP)h5_removeSafely, (IMP *)&o5_removeSafely);
    MSHookMessageEx(stage, DMAerialSel(@"restoreFromMinimize"), (IMP)h5_restore, (IMP *)&o5_restore);
    MSHookMessageEx(stage, DMAerialSel(@"_applyFlexDisabledLayoutWithScreenBounds:"), (IMP)h5_flex, (IMP *)&o5_flex);
    MSHookMessageEx(stage, DMAerialSel(@"handlePan:"), (IMP)h5_pan, (IMP *)&o5_pan);
    MSHookMessageEx(stage, DMAerialSel(@"handleResizeBR:"), (IMP)h5_resizeBR, (IMP *)&o5_resizeBR);
    MSHookMessageEx(coreMeta, DMAerialSel(@"setForeground:foregroundvalue:"), (IMP)h5_setFg, (IMP *)&o5_setFg);
    MSHookMessageEx(coreMeta, DMAerialSel(@"forceBackgrounded:forApp:"), (IMP)h5_forceBg, (IMP *)&o5_forceBg);
    DMLog(@"[aerial] runtime hooks installed on the obfuscated Aerial methods");
}
%group AerialStyle
%hook AerialStage
// Aerial's own fit-to-screen logic: whatever it does, the window returns to where it was put.
- (void)didAddSubview:(UIView *)subview {
    %orig;
    __weak UIView *weakSelf = (UIView *)self;
    for (NSNumber *ms in @[@50, @400, @1200]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms.intValue * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ UIView *s = weakSelf; if (s) DMDarkenStageBase(s); });
}
- (void)traitCollectionDidChange:(id)previous {
    DMStageTrace(@"traitCollectionDidChange", (UIView *)self);
    %orig;
    DMEnforceStageFrame((UIView *)self, @"a trait change");
}
- (void)setAlpha:(CGFloat)alpha {
    %orig([objc_getAssociatedObject(self, kStageEnteringKey) boolValue] ? 1.0 : alpha);
}
- (void)setTransform:(CGAffineTransform)transform {
    %orig([objc_getAssociatedObject(self, kStageEnteringKey) boolValue] ? CGAffineTransformIdentity : transform);
}
- (void)setFrame:(CGRect)frame {
    if ([objc_getAssociatedObject(self, kStageEnteringKey) boolValue] && !gStageFrameBypass) return;
    %orig;
}
- (void)layoutSubviews {
    %orig;
    DMStyleStage((UIView *)self);
}
- (id)initWithBundleID:(id)bundleID {
    if ([gFullFrameGuardBundle isEqualToString:bundleID]) gFullFrameGuardBundle = nil;   // the app is being windowed again
    id me = %orig;
    DMDarkenStageBase((UIView *)me);
    if (DMFrontApp()) { gWindowsPinnedForward = YES; DMApplyWindowLevel(); DMLog(@"[lights] a new Aerial stage opened over a full-screen app: windows brought forward"); }
    return me;
}
%end
%end
// Would opening this app make it the third window next to a left and a right tile (Fit to Window's side question)? No side effects. Aerial only.
static BOOL DMThirdWindowSides(NSString *bundleID, NSString **leftOut, NSString **rightOut) {
    if (!bundleID.length || DMActiveEngine() != DMEngineAerial || !DMFitEnabled() || DMStageForBundle(bundleID) || DMAppNeedsFullScreen(bundleID)) return NO;
    if (gSidePromptCtx && ![gSidePromptCtx[@"decided"] boolValue]) return NO;   // (a question is already up)
    NSMutableArray<UIView *> *open = [NSMutableArray array];
    for (UIView *st in DMAerialStages()) if (DMStageTakesPartInFit(st) && ![DMStageBundle(st) isEqualToString:bundleID]) [open addObject:st];
    if (open.count != 2) return NO;
    NSString *sa = DMSlotNameForFrame(open[0].frame), *sb = DMSlotNameForFrame(open[1].frame);
    NSString *l = [sa isEqualToString:@"left"] ? DMStageBundle(open[0]) : ([sb isEqualToString:@"left"] ? DMStageBundle(open[1]) : nil);
    NSString *r = [sa isEqualToString:@"right"] ? DMStageBundle(open[0]) : ([sb isEqualToString:@"right"] ? DMStageBundle(open[1]) : nil);
    if (!l.length || !r.length) return NO;
    if (leftOut) *leftOut = l; if (rightOut) *rightOut = r;
    return YES;
}
static void DMLaunchIntoTile(NSString *bundleID, CGRect frame);
// SpringBoard-side hooks of the Aerial integration (no Aerial class is touched): installed for Aerial 5.0 too.
%group AerialSpringBoard
// Esc while the side question is up: No Fit (the same as its middle button or a tap outside the sides). Only when SpringBoard has the keys.
%hook SpringBoard
- (void)pressesBegan:(NSSet *)presses withEvent:(UIPressesEvent *)event {
    if (@available(iOS 13.4, *)) {
        NSMutableDictionary *ctx = gSidePromptCtx;
        UIPress *p = presses.anyObject;
        if (ctx && ![ctx[@"decided"] boolValue] && presses.count == 1 && p.key.keyCode == UIKeyboardHIDUsageKeyboardEscape) {
            void (^choose)(NSString *, NSString *) = ctx[@"choose"];
            if (choose) { choose(@"none", @"Esc: No Fit"); return; }
        }
    }
    %orig;
}
%end
// With Aerial's toggle on, tapping an icon shows that app's window (Aerial's own hook does that). A window we minimized is hidden, which
// Aerial does not know about, so bring it back first.
%hook SBIconView
- (void)_handleTap {
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[icontap] _handleTap on %@", [[self valueForKey:@"icon"] valueForKey:@"applicationBundleID"]]);
    { extern void DMNoteOpenedBeforeRestore(NSString *); NSString *tb = nil; @try { tb = [[self valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {} DMNoteOpenedBeforeRestore(tb); }
    if (DMAerialToggleOn()) {
        NSString *bundleID = nil;
        @try { bundleID = [[self valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {}
        if (DMAppNeedsFullScreen(bundleID) && !DMStageForBundle(bundleID)) {   // Aerial's own "open as a window" toggle is seen as off for this one tap
            DMLog([NSString stringWithFormat:@"[fullscreenonly] icon tap on %@: it cannot live in a window, opened full screen", bundleID]);
            CFPreferencesSetAppValue(CFSTR("AerialEnabled"), kCFBooleanFalse, CFSTR("com.uzra.aerial"));
            CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
            %orig;
            CFPreferencesSetAppValue(CFSTR("AerialEnabled"), kCFBooleanTrue, CFSTR("com.uzra.aerial"));
            CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
            return;
        }
        // The icon of the app that is open full screen in front (a Dock tap on it): turned into a window the way the status bar's green button does
        // it. Aerial's own tap handling made a window and the tap ALSO launched the app full screen again, so Aerial closed its window at once (M1)
        // and on the iPad 2 the app ended up full screen in portrait (2026-09-26, in 1.0.0 too).
        if (bundleID.length && [[DMFrontApp() bundleIdentifier] isEqualToString:bundleID] && !DMStageForBundle(bundleID) && DMFullScreenAppInFront()) {
            DMLog([NSString stringWithFormat:@"[aerial] icon tap on %@, open full screen in front: made a window the green button's way", bundleID]);
            DMLightAction(2);
            return;
        }
        extern BOOL DMAerialWarmStartIfNeeded(NSString *bundleID);
        extern BOOL DMAerialNeedsWarmStartFlag(NSString *bundleID);
        NSString *leftB = nil, *rightB = nil;
        if (!DMAerialNeedsWarmStartFlag(bundleID) && DMThirdWindowSides(bundleID, &leftB, &rightB)) {   // the third window: which side first, then the launch
            NSString *b = [bundleID copy];
            DMPromptBeforeLaunch(b, leftB, rightB, ^(CGRect f) { DMLaunchIntoTile(b, f); });
            return;
        }
        if (DMAerialWarmStartIfNeeded(bundleID)) return;   // (WhatsApp cold start: full screen first, then a window -- see there)
        UIView *stage = bundleID.length ? DMStageForBundle(bundleID) : nil;
        if (stage && [objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) {
            DMLog([NSString stringWithFormat:@"[aerial] icon tap on %@: its minimized window comes back", bundleID]);
            if (DMFrontApp()) gWindowsPinnedForward = YES;
            DMApplyWindowLevel();
            DMRestoreStage(stage);
        }
    }
    %orig;
}
%end
// Locking the screen: Aerial minimizes all its windows (to little icons). Windows keep their place and state through a lock instead.
%hook SBLockScreenManager
- (void)lockUIFromSource:(int)source withOptions:(id)options {
    gLockingUntil = CACurrentMediaTime() + 2.0;
    DMWelcomeDismissForLock();
    %orig;
}
- (void)lockUIFromSource:(int)source withOptions:(id)options completion:(id)completion {
    gLockingUntil = CACurrentMediaTime() + 2.0;
    DMWelcomeDismissForLock();
    %orig;
}
%end
// Force quitting (or any exit of) an app forgets where its window was. Its Fit to Window tile is NOT dropped here: DMWatchFitClosures does that
// when the window itself goes, and re-tiles the others -- dropping it here first (the red light force-quits the app while its window is still
// fading out) hid the closure from that watcher, so the other tiles never grew back (iPad 2, Aerial 3.0: a closed tile left an empty half).
%hook SBApplication
- (void)_didExitWithContext:(id)context {
    NSString *bundleID = [(SBApplication *)self bundleIdentifier];
    if (bundleID.length) [gLastWindowFrames removeObjectForKey:bundleID];
    { extern BOOL gFitClosureCheckDue; gFitClosureCheckDue = YES; }
    %orig;
}
%end
%end
%group AerialStyleTail
// However a stage is closed (red button, Aerial's own menu, our Window menu), the app gets the whole screen back.
%hook AerialCore
// Aerial sends the apps of its windows to the background when it hides its window layer for the App Switcher (a video then pauses; a music app keeps going
// on its own). The windows are not really gone, so their apps stay in the foreground: not while the screen is locked or off, and not for a window that
// is being closed.
+ (void)closeAerialForBundle:(id)bundleID {
    gFullFrameGuardBundle = [bundleID copy];
    gFullFrameGuardUntil = CACurrentMediaTime() + 3.0;
    DMResetSceneFrameForBundle(bundleID);
    %orig;
}
// A cold launch straight into a window: the app is not running yet, so it starts out at the screen's own size and only gets resized to the window a moment
// later, once Aerial commits the frame. An app told about its real (small) size only after already laying out for the big one (DMPublishWindowSizes, which
// watches existing windows) flipped size mid-launch and reliably hung at least one app (Sofascore) hard enough to trip its 30 s launch watchdog — so the
// size is sent before the app is even told to open, the same way it would have seen it from the very first call, never switching under it.
+ (void)triggerAerialForBundle:(NSString *)bundleID withFrame:(CGRect)frame {
    if (bundleID.length) DMSendWindowSize(bundleID, CGSizeMake(frame.size.width, MAX(0, frame.size.height - kStageBarHeight)));
    %orig;
}
%end
// Aerial keeps its window at 1033; ours decides (behind a full-screen app, under a Dock menu).
%hook AerialWindow
- (void)setWindowLevel:(double)level {
    %orig(DMDesiredWindowLevel());
}
// Aerial hides its window layer with a fade and hides it for good when the fade ends. After a quick App Switcher swipe the "switcher closed" event has
// already shown the layer again by then, and the late hide left the windows gone. A hide is only accepted while the switcher is still the current mode.
- (void)setHidden:(BOOL)hidden {
    if (hidden && gEnvMode != 2) { DMLog(@"[switcher] a late hide of the window layer was ignored"); return; }
    %orig;
}
%end
%end
// Turn loop watch (M1, iOS 15, Aerial 5.0, 2026-09-24 Phase 2b): with Aerial 5.0 loaded, a full-screen app never turns upside down (orientation 2):
// SpringBoard re-runs its rotate-scenes transaction ~100-400 times a second (SBRotateScenesWorkspaceTransaction -> SBToAppsWorkspaceTransaction -> a new
// switcher transition each time) for as long as the iPad stays upside down, and the screen keeps its old orientation. Measured: the same with no windows
// open, with our windowing switched off (Aerial loaded, engine none) and with every kill switch of ours; fine on the Home Screen, fine for turns to 1/3/4,
// and fine with Aerial denied by Choicy (Safari then turns upside down at once). Aerial 5.0 replaces -[SBWorkspaceApplicationSceneTransitionContext
// setInterfaceOrientation:], -[SBOrientationLockManager deviceOrientationAsFarAsAppsAreConcerned] and -[SpringBoard noteInterfaceOrientationChanged:...]
// (hookedby_Aerial): it turns a requested 2 into 0. Fixed by AerialTurnProbe (the request is put back after Aerial, both 3.0 and 5.0); this
// only logs such a loop once per episode, should one ever come back.
static void DMWatchTurnLoop(void) {
    static CFTimeInterval start = 0, lastLog = 0; static int count = 0;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - start > 1.0) { start = now; count = 0; }
    if (++count != 60 || now - lastLog < 10.0) return;
    lastLog = now;
    DMLog(@"[turn] SpringBoard re-runs a transition 60+ times a second: a turn that cannot complete (Aerial 5.0 and upside down with a full-screen app?)");
}
// Probe (Aerial 3.0 only, which may be hooked): Aerial replaces -[SBWorkspaceApplicationSceneTransitionContext setInterfaceOrientation:]; this
// wraps Aerial's replacement and logs what it did with each requested orientation (debug flag), to find out why a full-screen app never turns
// upside down while Aerial is loaded (DMWatchTurnLoop).
@interface SBWorkspaceApplicationSceneTransitionContext : NSObject
- (long long)interfaceOrientation;
@end
%group AerialTurnProbe
%hook SBWorkspaceApplicationSceneTransitionContext
- (void)setInterfaceOrientation:(long long)o {
    %orig;
    long long after = [self respondsToSelector:@selector(interfaceOrientation)] ? [self interfaceOrientation] : -1;
    // Measured: Aerial turns a request for upside down (2) into 0 ("unknown"), and SpringBoard then retries the turn endlessly. The request is put
    // back as it was (the ivar itself: nothing of Aerial's is called or changed). Kill switch: /tmp/msb-noupsidefix.
    if (o == 2 && after != 2 && !DMTestFlag("/tmp/msb-noupsidefix")) {
        Ivar iv = class_getInstanceVariable([self class], "_interfaceOrientation");
        if (iv) { *(long long *)((uint8_t *)(__bridge void *)self + ivar_getOffset(iv)) = 2; after = [self interfaceOrientation]; }
    }
    static int logged = 0;
    if (DMTestFlag("/tmp/macstatusbar-debug") && (after != o || o == 2) && logged < 40) {
        logged++;
        DMLog([NSString stringWithFormat:@"[turnprobe] transition context asked for orientation %lld, holds %lld after Aerial", o, after]);
    }
}
%end
%end
static void DMInitTurnProbe(void) { static BOOL done = NO; if (done) return; done = YES; %init(AerialTurnProbe); }
%group SwitcherLog
%hook SBTransitionSwitcherModifierEvent
- (void)setToEnvironmentMode:(long long)mode {
    gEnvMode = mode;
    DMWatchTurnLoop();
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[switcher] transition event: to environment mode %lld (front %@)", mode, [DMFrontApp() bundleIdentifier]]);
    if (gSwitcherStackLogs > 0) {   // debug (trigger swstack_<n>): who creates the next n switcher transition events
        gSwitcherStackLogs--;
        NSArray *st = [NSThread callStackSymbols]; NSMutableString *tr = [NSMutableString string];
        for (NSUInteger i = 1; i < st.count && i < 70; i++) if (![st[i] containsString:@"BaseBoard"]) [tr appendFormat:@"\n      %@", st[i]];
        DMLog([NSString stringWithFormat:@"[switcher] event created from:%@", tr]);
    }
    %orig;
}
%end
%end
static BOOL gAerialHooked = NO;
static void DMTryHookAerial(int attempt) {
    if (gAerialHooked) return;
    if (objc_getClass("AerialStage") && DMActiveEngine() == DMEngineAerial) {
        gAerialHooked = YES;
        // Aerial 5.0 verifies its own method implementations at runtime and kills SpringBoard (SIGKILL, no crash report) as soon as a window
        // opens while any of its classes is hooked -- confirmed live on the iPad 2 by bisection. That is the author's deliberate protection, so on
        // an obfuscated build NOTHING is hooked on Aerial's classes (neither the resolved names nor the real-named AerialStyle hooks); only the
        // hook-free parts of the integration (calls, KVC, our own views) run. DMHookAerialObfuscated is kept for reference but never called.
        if (gAerialFlavor == 5) {
            DMLog(@"[aerial] Aerial 5.0: its anti-hook protection kills SpringBoard if its classes are hooked, so no Aerial hooks are installed"); (void)DMHookAerialObfuscated;
            // The upside-down fix wraps a SpringBoard method Aerial 5.0 replaced (not an Aerial class): tested on the M1 (Phase 2b, with the owner's OK) --
            // SpringBoard stayed up, Safari turned upside down at once (5 transition events instead of an endless loop), windows drawn upright in all 4
            // orientations. Kill switch: /tmp/msb-a5-noupside (read when SpringBoard starts).
            if (!DMTestFlag("/tmp/msb-a5-noupside")) { DMInitTurnProbe(); DMLog(@"[aerial] Aerial 5.0: upside-down fix installed"); }
        }
        else { %init(AerialStyleNamed); %init(AerialStyle); %init(AerialStyleTail); DMInitTurnProbe(); }   // 3.0: unchanged (+ the upside-down probe)
        %init(AerialSpringBoard);   // SpringBoard classes only: safe on 5.0 as well
        if (objc_getClass("SBTransitionSwitcherModifierEvent")) %init(SwitcherLog);
        DMLog(@"[engine] Aerial stage styling installed");
        return;
    }
    if (attempt < 15) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMTryHookAerial(attempt + 1); });
}

// BigSurCenter's Control Center is a 370 x 794 panel that slides down at the right, nearly the height of the screen. Its content view sits in a
// plain container that BigSurCenter moves by changing its frame; scaling that container from its top right corner makes the whole panel
// smaller while its slide animation and its touches (UIKit maps them through the scale) keep working.
static CGFloat gCCPanelTop = 20.0;   // where the panel rests below the top of the screen (learned from its frame; it slides in from above)
static void DMScalePanelView(UIView *panel) {
    if (!panel || panel.bounds.size.width < 100.0) return;
    if (panel.frame.origin.y >= 0.0) gCCPanelTop = panel.frame.origin.y;
    // Only what is DRAWN inside the container is scaled (sublayerTransform), from its top right corner. The container keeps its own size.
    CGFloat k = gCCScale;
    CGSize s = panel.bounds.size;
    CATransform3D want = CATransform3DIdentity;
    if (k < 0.999) want = CATransform3DTranslate(CATransform3DMakeScale(k, k, 1.0), s.width * (1.0 - k) / (2.0 * k), -s.height * (1.0 - k) / (2.0 * k), 0.0);
    if (!CATransform3DEqualToTransform(panel.layer.sublayerTransform, want)) panel.layer.sublayerTransform = want;
    if (!CGAffineTransformIsIdentity(panel.transform)) panel.transform = CGAffineTransformIdentity;
}
static void DMScaleControlCenterPanel(UIView *content) { DMScalePanelView(content.superview); }
// BigSurCenter works out its panel height as (the toggle grid's position converted into a view ABOVE the panel) + (the grid's content height) + 20,
// capped to the screen. With the panel scaled, that converted position shrinks (20 + 550 x 0.82 instead of 570), so the height came out 736
// instead of 794 and the last row of modules (memory readout, QR, translator, sidebar toggle) was cut off. Rather than fight the conversion,
// the height is corrected where BigSurCenter stores it: setiPadHeight: gets the true value, and the constraint call that follows it (which would
// write the short value back) is sent to a throw-away constraint.
@interface SCContentViewController : UIViewController @end
static BOOL gSwallowHeightConstraint = NO;
static CGFloat gCorrectedPanelHeight = 0.0;
static NSLayoutConstraint *gDummyHeightConstraint = nil;
%group BSCHeightFix
%hook SCContentViewController
- (void)setiPadHeight:(CGFloat)h {
    UIView *panel = self.view;
    if (gCCScale < 0.999 && panel && !CATransform3DIsIdentity(panel.layer.sublayerTransform)) {
        UICollectionView *grid = nil;
        NSMutableArray *stack = [NSMutableArray arrayWithObject:panel];
        while (stack.count && !grid) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            if ([v isKindOfClass:[UICollectionView class]] && v.bounds.size.width > 300.0 && v.bounds.size.width < 340.0) grid = (UICollectionView *)v;
            else [stack addObjectsFromArray:v.subviews];
        }
        if (grid) {
            // The grid's true position inside the panel: frames ignore transforms, so add them up (a convertRect: into the panel would include the scale).
            CGFloat gridY = 0.0;
            for (UIView *v = grid; v && v != panel; v = v.superview) { gridY += v.frame.origin.y; if (v.superview && v.superview != panel) gridY -= v.superview.bounds.origin.y; }
            CGRect r = CGRectMake(0.0, gridY, 0.0, 0.0);
            CGRect screen = [UIScreen mainScreen].bounds;
            // BigSurCenter caps the panel to the screen; drawn at this scale the panel needs 1/scale as much height to fill the same room, so the whole
            // grid (all three rows) fits instead of its last row being cut off at the bottom.
            // (BigSurCenter adds the panel's own 20 pt offset on top of that, leaving 40 pt under the last row; 20 pt matches the margin at the sides.)
            CGFloat wanted = MIN(r.origin.y + grid.contentSize.height + 20.0, (MIN(screen.size.width, screen.size.height) - 40.0) / gCCScale);
            if (wanted > h + 0.5) {
                DMLog([NSString stringWithFormat:@"[bsc] panel height %.1f corrected to %.1f", h, wanted]);
                h = wanted; gCorrectedPanelHeight = wanted; gSwallowHeightConstraint = YES;
            }
        }
    }
    %orig(h);
}
- (NSLayoutConstraint *)heightConstraint {
    NSLayoutConstraint *c = %orig;
    if (!gSwallowHeightConstraint) return c;
    gSwallowHeightConstraint = NO;   // this is the call right after setiPadHeight: - it is about to be given the short height
    if (c && fabs(c.constant - gCorrectedPanelHeight) > 0.5) c.constant = gCorrectedPanelHeight;
    if (!gDummyHeightConstraint) gDummyHeightConstraint = [[UIView new].heightAnchor constraintEqualToConstant:0.0];
    return gDummyHeightConstraint;
}
%end
%end
static BOOL gBSCHeightFixHooked = NO;
static void DMTryHookBigSurCenter(int attempt) {
    if (gBSCHeightFixHooked) return;
    if (objc_getClass("SCContentViewController")) {
        gBSCHeightFixHooked = YES;
        %init(BSCHeightFix);
        DMLog(@"[bsc] height fix installed");
    } else if (attempt < 20) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMTryHookBigSurCenter(attempt + 1); });
    }
}
// ---- Control Center resource tile ------------------------------------------------------------------------------------------------------
// MemoryMagic's module prints two 15 pt lines ("Free RAM: 12480 MB", "Used RAM: 3223 MB") that are far wider than its 75 pt tile and get cut off.
// Its two labels are hidden and this tile is drawn in their place: the available RAM (our own number, below) and the CPU load.
static double DMCPULoad(void) {   // 0...1 since the previous call, or -1 when there is no earlier sample to compare with
    static uint64_t lastBusy = 0, lastTotal = 0; static CFTimeInterval lastTime = 0;
    processor_info_array_t info = NULL; mach_msg_type_number_t infoCount = 0; natural_t cores = 0;
    if (host_processor_info(mach_host_self(), PROCESSOR_CPU_LOAD_INFO, &cores, &info, &infoCount) != KERN_SUCCESS || !info) return -1.0;
    uint64_t busy = 0, total = 0;
    for (natural_t i = 0; i < cores; i++) {
        integer_t *t = info + i * CPU_STATE_MAX;
        uint64_t b = (uint64_t)t[CPU_STATE_USER] + (uint64_t)t[CPU_STATE_SYSTEM] + (uint64_t)t[CPU_STATE_NICE];
        busy += b; total += b + (uint64_t)t[CPU_STATE_IDLE];
    }
    vm_deallocate(mach_task_self(), (vm_address_t)info, infoCount * sizeof(integer_t));
    CFTimeInterval now = CACurrentMediaTime();
    double load = -1.0;
    if (lastTotal && total > lastTotal && now - lastTime < 4.0) load = (double)(busy - lastBusy) / (double)(total - lastTotal);   // an old sample would be an average over a long gap
    lastBusy = busy; lastTotal = total; lastTime = now;
    return load < 0.0 ? -1.0 : MIN(1.0, load);
}
// Available RAM in MB: total - (active + wired + compressed), as the Free RAM line showed with the MemoryMagicAvailable test tweak; 0 if unknown.
static double DMAvailableRAM(void) {
    vm_statistics64_data_t vm; mach_msg_type_number_t n = HOST_VM_INFO64_COUNT;
    if (host_statistics64(mach_host_self(), HOST_VM_INFO64, (host_info64_t)&vm, &n) != KERN_SUCCESS) return 0.0;
    uint64_t page = vm_kernel_page_size;   // (the counters are in kernel pages)
    if (!page) return 0.0;
    uint64_t total = [NSProcessInfo processInfo].physicalMemory / page, used = (uint64_t)vm.active_count + vm.wire_count + vm.compressor_page_count;
    return total > used ? (double)(((total - used) * page) >> 20) : 0.0;
}
@interface DMStatsTile : UIView
- (void)setAvailableMB:(double)available cpu:(double)cpu;
@end
@implementation DMStatsTile {
    UILabel *_ramCaption, *_ramValue, *_cpuCaption, *_cpuValue;
    UIView *_divider;
}
- (UILabel *)labelWithFont:(UIFont *)font alpha:(CGFloat)alpha text:(NSString *)text {
    UILabel *l = [UILabel new]; l.font = font; l.textColor = [UIColor colorWithWhite:1.0 alpha:alpha]; l.text = text;
    l.adjustsFontSizeToFitWidth = YES; l.minimumScaleFactor = 0.7;
    [self addSubview:l]; return l;
}
- (instancetype)initWithFrame:(CGRect)frame {
    if ((self = [super initWithFrame:frame])) {
        self.userInteractionEnabled = NO;
        UIFont *cap = [UIFont systemFontOfSize:7.5 weight:UIFontWeightSemibold], *val = [UIFont monospacedDigitSystemFontOfSize:16.0 weight:UIFontWeightSemibold];
        _ramCaption = [self labelWithFont:cap alpha:0.55 text:@"RAM AVAILABLE"]; _ramValue = [self labelWithFont:val alpha:1.0 text:@"–"];
        _cpuCaption = [self labelWithFont:cap alpha:0.55 text:@"CPU USED"]; _cpuValue = [self labelWithFont:val alpha:1.0 text:@"–"];
        _divider = [UIView new]; _divider.backgroundColor = [UIColor colorWithWhite:1.0 alpha:0.14]; [self addSubview:_divider];
    }
    return self;
}
- (void)layoutSubviews {
    [super layoutSubviews];
    CGFloat w = self.bounds.size.width - 20.0, x = 10.0, h = self.bounds.size.height, half = (h - 12.0) / 2.0;
    _ramCaption.frame = CGRectMake(x, 7.0, w, 10.0);
    _ramValue.frame = CGRectMake(x, 16.0, w, 18.0);
    _divider.frame = CGRectMake(x, 7.0 + half + 0.5, w, 0.5);
    _cpuCaption.frame = CGRectMake(x, 7.0 + half + 5.0, w, 10.0);
    _cpuValue.frame = CGRectMake(x, 7.0 + half + 14.0, w, 18.0);
}
- (void)setAvailableMB:(double)available cpu:(double)cpu {
    _ramValue.text = available > 0.0 ? [NSString stringWithFormat:@"%.1f GB", available / 1024.0] : @"–";
    _cpuValue.text = cpu >= 0.0 ? [NSString stringWithFormat:@"%d%%", (int)lround(cpu * 100.0)] : @"–";
}
@end
@interface DMUptimeTile : UIView
- (void)setDays:(long)d hours:(long)h minutes:(long)m seconds:(long)sec;
@end
@implementation DMUptimeTile {
    UILabel *_caption, *_value, *_detail;
}
- (instancetype)initWithFrame:(CGRect)frame {
    if ((self = [super initWithFrame:frame])) {
        self.userInteractionEnabled = NO;
        _caption = [UILabel new]; _caption.text = @"UPTIME"; _caption.font = [UIFont systemFontOfSize:8.0 weight:UIFontWeightSemibold]; _caption.textColor = [UIColor colorWithWhite:1.0 alpha:0.55];
        _value = [UILabel new]; _value.font = [UIFont monospacedDigitSystemFontOfSize:16.0 weight:UIFontWeightSemibold]; _value.textColor = [UIColor whiteColor]; _value.text = @"–";
        _detail = [UILabel new]; _detail.font = [UIFont monospacedDigitSystemFontOfSize:10.5 weight:UIFontWeightMedium]; _detail.textColor = [UIColor colorWithWhite:1.0 alpha:0.55];
        for (UILabel *l in @[_caption, _value, _detail]) { l.adjustsFontSizeToFitWidth = YES; l.minimumScaleFactor = 0.7; [self addSubview:l]; }
    }
    return self;
}
- (void)layoutSubviews {
    [super layoutSubviews];
    CGFloat w = self.bounds.size.width - 20.0, x = 10.0, top = (self.bounds.size.height - 47.0) / 2.0;
    _caption.frame = CGRectMake(x, top, w, 10.0);
    _value.frame = CGRectMake(x, top + 10.0, w, 20.0);
    _detail.frame = CGRectMake(x, top + 32.0, w, 14.0);
}
- (void)setDays:(long)d hours:(long)h minutes:(long)m seconds:(long)sec {
    // the two biggest units are the headline, the rest ticks underneath
    if (d > 0) { _value.text = [NSString stringWithFormat:@"%ldd %ldh", d, h]; _detail.text = [NSString stringWithFormat:@"%ldm %lds", m, sec]; }
    else if (h > 0) { _value.text = [NSString stringWithFormat:@"%ldh %ldm", h, m]; _detail.text = [NSString stringWithFormat:@"%lds", sec]; }
    else { _value.text = [NSString stringWithFormat:@"%ldm %lds", m, sec]; _detail.text = @""; }
}
@end
static UIView *DMEnclosingTile(UIView *v) {
    while (v && ![NSStringFromClass([v class]) isEqualToString:@"SCModuleContentView"]) v = v.superview;
    return v;
}
// The uptime module keeps its "3d 8h 48m 8s" text in a zero-height container that only shows once the module is pressed and expanded; the collapsed
// tile is blank. The module's label is hidden and an uptime tile is drawn instead, read from the module's own text so both always agree.
// The module leaves out units that are zero ("4d 17m 39s" at four days and 17 minutes), so the text is read token by token.
static BOOL DMParseUptimeText(NSString *text, long *d, long *h, long *m, long *sec) {
    if (text.length < 2 || text.length > 24) return NO;
    int tokens = 0;
    *d = *h = *m = *sec = 0;
    for (NSString *tok in [text componentsSeparatedByString:@" "]) {
        if (tok.length < 2) return NO;
        unichar unit = [tok characterAtIndex:tok.length - 1];
        NSScanner *sc = [NSScanner scannerWithString:[tok substringToIndex:tok.length - 1]];
        long long n = 0;
        if (![sc scanLongLong:&n] || !sc.atEnd) return NO;
        if (unit == 'd') *d = (long)n; else if (unit == 'h') *h = (long)n; else if (unit == 'm') *m = (long)n; else if (unit == 's') *sec = (long)n; else return NO;
        tokens++;
    }
    return tokens >= 2 && [text hasSuffix:@"s"];
}
static void DMUpdateUptimeTiles(NSArray<UILabel *> *labels) {
    for (UILabel *l in labels) {
        if ([l.superview isKindOfClass:[DMUptimeTile class]]) continue;   // (never our own labels)
        UIView *tile = DMEnclosingTile(l);
        if (!tile) continue;
        long d = 0, h = 0, m = 0, sec = 0;
        if (!DMParseUptimeText(l.text, &d, &h, &m, &sec)) continue;
        l.hidden = YES;
        DMUptimeTile *up = nil;
        for (UIView *sub in tile.subviews) if ([sub isKindOfClass:[DMUptimeTile class]]) up = (DMUptimeTile *)sub;
        if (!up) { up = [[DMUptimeTile alloc] initWithFrame:tile.bounds]; up.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight; [tile addSubview:up]; }
        [up setDays:d hours:h minutes:m seconds:sec];
    }
}
static void DMUpdateStatsTiles(NSArray<UILabel *> *ramLabels) {
    static double cpu = -1.0, available = 0.0; static CFTimeInterval lastSample = 0;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - lastSample >= 1.0) { lastSample = now; cpu = DMCPULoad(); available = DMAvailableRAM(); }
    NSMutableDictionary<NSValue *, NSMutableArray *> *byTile = [NSMutableDictionary dictionary];
    for (UILabel *l in ramLabels) {
        UIView *tile = DMEnclosingTile(l);
        if (!tile) continue;
        l.hidden = YES;   // MemoryMagic only ever sets the text, so this stays
        NSValue *key = [NSValue valueWithNonretainedObject:tile];
        if (!byTile[key]) byTile[key] = [NSMutableArray array];
        [byTile[key] addObject:l];
    }
    for (NSValue *key in byTile) {
        UIView *tile = key.nonretainedObjectValue;
        DMStatsTile *stats = nil;
        for (UIView *sub in tile.subviews) if ([sub isKindOfClass:[DMStatsTile class]]) stats = (DMStatsTile *)sub;
        if (!stats) { stats = [[DMStatsTile alloc] initWithFrame:tile.bounds]; stats.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight; [tile addSubview:stats]; }
        [stats setAvailableMB:available cpu:cpu];
    }
}
// The first time Control Center is opened after a respring, BigSurCenter builds its panel, which stalls the pull-down for ~70 ms. So it is
// built once, invisibly, a while after start (only on the Home Screen with nothing else going on): the window is transparent, the panel is
// shown and put away without animation, and the window is made visible again. A guard file keeps a crash from repeating on every start.
// The scale is applied from OUTSIDE BigSurCenter, after its own layout, never from inside it: applying it while BigSurCenter lays the panel out made
// it compute a shorter panel and drop a whole row of modules (the memory readout among them).
static __weak UIWindow *gCCWindow = nil;   // SpringBoard's Control Center window, once seen (its setHidden: hook)
static void DMApplyControlCenterScale(void) {
    // (watcher plan step 3: nothing to do while Control Center is not showing -- the tick used to walk every window to find that out)
    UIWindow *cc = gCCWindow;
    if (cc && cc.hidden) return;
    // (perf: the whole Control Center view tree -- thousands of views -- was walked on every tick. The panels and the RAM/uptime labels found by
    // a walk are kept and re-used; the tree is walked again when Control Center is shown again (gCCWalkDue), its window changes size (a turn),
    // one of the kept views has left the window, or 2 s have passed (a module added while it is open). The scale and the live tiles are still
    // applied on every tick.)
    static NSHashTable<UIView *> *panels, *ramTable, *uptimeTable; static __weak UIWindow *walkedWindow; static CGSize walkedSize; static CFTimeInterval walkedAt = 0;
    extern BOOL gCCWalkDue;
    for (UIWindow *w in cc ? @[cc] : DMAllWindows()) {
        if (![NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"] || w.hidden) continue;
        CFTimeInterval now = CACurrentMediaTime();
        BOOL stale = gCCWalkDue || !panels || walkedWindow != w || !CGSizeEqualToSize(walkedSize, w.bounds.size) || now - walkedAt >= 2.0;
        if (!stale) for (NSHashTable *t in @[panels, ramTable, uptimeTable]) for (UIView *v in t) if (v.window != w) { stale = YES; break; }
        if (stale) {
            gCCWalkDue = NO; walkedWindow = w; walkedSize = w.bounds.size; walkedAt = now;
            panels = [NSHashTable weakObjectsHashTable]; ramTable = [NSHashTable weakObjectsHashTable]; uptimeTable = [NSHashTable weakObjectsHashTable];
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                if ([v isKindOfClass:[DMUptimeTile class]] || [v isKindOfClass:[DMStatsTile class]]) continue;   // (our own tiles: their "58m 0s" line read as the module's text hid our labels)
                [stack addObjectsFromArray:v.subviews];
                if ([NSStringFromClass([v class]) isEqualToString:@"SCContentView"]) [panels addObject:v];
                else if ([v isKindOfClass:[UILabel class]]) {
                    NSString *t = ((UILabel *)v).text;
                    if ([t hasPrefix:@"Used RAM"] || [t hasPrefix:@"Free RAM"]) [ramTable addObject:v];
                    else { long d, h, m, sec; if (DMParseUptimeText(t, &d, &h, &m, &sec)) [uptimeTable addObject:v]; }
                }
            }
        }
        if (!gStockBar) for (UIView *v in panels.allObjects) DMScaleControlCenterPanel(v);   // (stock status bar: the tiles only, see StockCCTiles)
        NSArray *ramLabels = ramTable.allObjects, *uptimeLabels = uptimeTable.allObjects;
        if (ramLabels.count) DMUpdateStatsTiles(ramLabels);
        if (uptimeLabels.count) DMUpdateUptimeTiles(uptimeLabels);
    }
}
BOOL gCCWalkDue = YES;
@interface SBControlCenterWindow : UIWindow
@end
static CFTimeInterval gStartupBegan;   // (defined below)
%hook SBControlCenterWindow
- (void)setHidden:(BOOL)hidden {
    %orig;
    gCCWindow = (UIWindow *)self;
    { extern BOOL gCCWalkDue; gCCWalkDue = YES; }   // (shown or hidden: the next scale pass finds its views again)
    gCCWindowSeen = YES;   // SpringBoard has made Control Center itself: DMControlCenterActive may ask its controller from now on
    // Debug only: who shows Control Center? (the owner sees it come down and go away by itself after resprings on both iPads; on the iPad 2 the pre-build
    // above never runs, so something else does it.) Logs the caller chain of the first 12 shows after each start.
    if (!hidden && DMTestFlag("/tmp/macstatusbar-debug")) {
        static int shown = 0;
        if (shown++ < 12) {
            NSArray *stack = [NSThread callStackSymbols];
            NSMutableArray *frames = [NSMutableArray array];
            for (NSUInteger i = 1; i < stack.count && frames.count < 14; i++) {
                NSMutableArray *parts = [NSMutableArray array];
                for (NSString *part in [stack[i] componentsSeparatedByString:@" "]) if (part.length) [parts addObject:part];
                if (parts.count >= 4) [frames addObject:[NSString stringWithFormat:@"%@ %@", parts[1], [[parts subarrayWithRange:NSMakeRange(3, parts.count - 3)] componentsJoinedByString:@" "]]];
            }
            DMLog([NSString stringWithFormat:@"[ccshow] Control Center window shown (%.1f s after start): %@", CACurrentMediaTime() - gStartupBegan, [frames componentsJoinedByString:@" < "]]);
        }
    }
    if (!hidden && !DMTestFlag("/tmp/macstatusbar-nobsc")) dispatch_async(dispatch_get_main_queue(), ^{ DMApplyControlCenterScale(); });   // after the layout of this run loop turn
    // Bug (reported): the SSH icon can clash with Control Center's own icons for a while after Control Center opens or closes, especially right after a
    // respring. Same cause and same fix as the rotation case in DMWatchOrientation above: dm_layoutLogo measures the CURRENT frames of the stock status
    // icons every time it runs, and those are still animating into place for a few tenths of a second around a Control Center transition, so a layout
    // pass that lands mid-transition catches a stale/in-between position. One more forced pass once it has had a moment to settle fixes it without
    // waiting on whatever else would eventually ask for a layout pass.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout]; });
}
%end
// Stock status bar (StockBar.h): the full run's tick is not there, but the MemoryMagic RAM/CPU tile and the uptime tile still need drawing (else the RAM
// text spills out of its tile and the uptime tile is blank). Only while Control Center is showing: a 0.5 s timer from its presentation to its
// dismissal, nothing at all otherwise. BigSurCenter's panel is not scaled here (the Control Center Size row stays hidden in stock mode).
// Neither iPadOS 15 nor 16 reliably calls the Control Center window's -setHidden: (M1 and iPad 2, 2026-09-26), so the controller's own
// -_willPresent / -_didDismiss (hooked only where both exist) start and stop it; the window hook stays for systems that do call it, and the timer
// stops itself once the controller says Control Center is neither presented nor visible (so a missed dismissal never leaves it running).
static NSTimer *gStockCCTimer;
static BOOL DMStockCCShowing(void) {
    id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
    if (cc) {
        SEL pd = NSSelectorFromString(@"isPresentedOrDismissing");
        if ([cc respondsToSelector:pd] && ((BOOL (*)(id, SEL))objc_msgSend)(cc, pd)) return YES;
        return [DMBoolStr(cc, @"isPresented") isEqualToString:@"Y"] || [DMBoolStr(cc, @"isVisible") isEqualToString:@"Y"];
    }
    UIWindow *w = gCCWindow;
    return w && !w.hidden;
}
static void DMStockCCTiles(BOOL shown) {
    BOOL was = gStockCCTimer != nil;
    [gStockCCTimer invalidate]; gStockCCTimer = nil;
    if (!shown) { if (was) DMLog(@"[stock] Control Center tiles: timer stopped (hidden or dismissed)"); return; }
    { extern BOOL gCCWalkDue; gCCWalkDue = YES; }   // (the next pass finds the labels again)
    dispatch_async(dispatch_get_main_queue(), ^{ DMApplyControlCenterScale(); });   // (after this run loop turn's layout)
    __block int notShowing = 0; CFTimeInterval began = CACurrentMediaTime();
    gStockCCTimer = [NSTimer timerWithTimeInterval:0.5 repeats:YES block:^(NSTimer *t) {
        if (!DMStockCCShowing()) {   // (twice in a row, and not in the first second: a pull-down still starting counts as showing)
            if (++notShowing >= 2 && CACurrentMediaTime() - began > 1.0) { [gStockCCTimer invalidate]; gStockCCTimer = nil; DMLog(@"[stock] Control Center tiles: timer stopped (Control Center closed)"); }
            return;
        }
        notShowing = 0;
        DMApplyControlCenterScale();
    }];
    gStockCCTimer.tolerance = 0.1;
    [[NSRunLoop mainRunLoop] addTimer:gStockCCTimer forMode:NSRunLoopCommonModes];
    DMLog(@"[stock] Control Center tiles: timer started (Control Center showing)");
}
%group StockCCTiles
%hook SBControlCenterWindow
- (void)setHidden:(BOOL)hidden {
    %orig;
    gCCWindow = (UIWindow *)self;
    { extern BOOL gCCWalkDue; gCCWalkDue = YES; }
    if (hidden || !gStockCCTimer) DMStockCCTiles(!hidden);
}
%end
%end
%group StockCCTilesController
%hook SBControlCenterController
- (void)_willPresent {
    %orig;
    if (!gStockCCTimer) DMStockCCTiles(YES);
}
- (void)_didDismiss {
    %orig;
    DMStockCCTiles(NO);
}
%end
%end
// (layering audit F13) Full mode: DMControlCenterActive only asks Control Center's controller once SpringBoard has made Control Center itself, and
// that was only learned from the window's -setHidden:, which iPadOS 15/16 do not reliably call (see above): then menus did not close for Control
// Center, the keep-bar logic was off and the welcome/crash notice did not know it was up. The controller's own -_willPresent (the same hook the
// stock mode uses) marks it too; it only runs when SpringBoard presents Control Center, so nothing is created early.
%group CCPresentSeen
%hook SBControlCenterController
- (void)_willPresent {
    %orig;
    if (!gCCWindowSeen) DMLog(@"[cc] Control Center presented (controller): its state is asked from now on");
    gCCWindowSeen = YES;
}
%end
%end
static void DMCCPresentSeenInit(void) {
    Class c = objc_getClass("SBControlCenterController");
    if (c && class_getInstanceMethod(c, NSSelectorFromString(@"_willPresent"))) %init(CCPresentSeen);
}
static void DMStockCCTilesInit(void) {
    if (objc_getClass("SBControlCenterWindow")) %init(StockCCTiles);
    Class c = objc_getClass("SBControlCenterController");
    if (c && class_getInstanceMethod(c, NSSelectorFromString(@"_willPresent")) && class_getInstanceMethod(c, NSSelectorFromString(@"_didDismiss"))) %init(StockCCTilesController);
    else DMLog(@"[stock] Control Center tiles: no -_willPresent/-_didDismiss here, the window's -setHidden: only");
}
static BOOL gCCPrewarmed = NO;
static void DMPrewarmControlCenter(int attempt) {
    if (gCCPrewarmed) return;
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 16) return;   // only verified on iPadOS 15: on 16 the pre-built panel showed (Control Center pulled down by itself after a respring)
    // OFF by default now (requested: "sometimes the Control Center comes down randomly, then goes away very fast, mainly after resprings" -- on the M1 the
    // log shows this pre-build running 14 s after the respring; the transparent window still flashes the panel). Saving ~70 ms on the first pull-down
    // isn't worth a visible flash. Opt back in for testing with /tmp/macstatusbar-prewarm.
    if (!DMTestFlag("/tmp/macstatusbar-prewarm")) return;
    const char *guard = "/tmp/macstatusbar-prewarm-guard";
    struct stat st;
    if (attempt == 0 && stat(guard, &st) == 0 && difftime(time(NULL), st.st_mtime) < 60.0) { DMLog(@"[prewarm] skipped: the previous start ended right after a pre-build"); return; }
    id lockMgr = DMSBManager("SBLockScreenManager");
    BOOL locked = [lockMgr respondsToSelector:NSSelectorFromString(@"isUILocked")] && ((BOOL (*)(id, SEL))objc_msgSend)(lockMgr, NSSelectorFromString(@"isUILocked"));
    if (DMFrontApp() || locked || DMControlCenterActive() || DMTopStage() || gOverlay) {   // not a quiet moment: try again shortly
        if (attempt < 30) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMPrewarmControlCenter(attempt + 1); });
        return;
    }
    id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
    SEL present = NSSelectorFromString(@"presentAnimated:"), dismiss = NSSelectorFromString(@"dismissAnimated:");
    if (![cc respondsToSelector:present] || ![cc respondsToSelector:dismiss]) return;
    UIWindow *ccWindow = nil;
    for (UIWindow *w in DMAllWindows()) if ([NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"]) ccWindow = w;
    gCCPrewarmed = YES;
    FILE *g = fopen(guard, "w"); if (g) fclose(g);
    DMLog(@"[prewarm] building the Control Center panel invisibly");
    ccWindow.alpha = 0.0;
    ((void (*)(id, SEL, BOOL))objc_msgSend)(cc, present, NO);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        ((void (*)(id, SEL, BOOL))objc_msgSend)(cc, dismiss, NO);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            ccWindow.alpha = 1.0;
            DMLog(@"[prewarm] done");
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(8.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ unlink(guard); });
        });
    });
}

%group MilkyWayGreen
%hook AXWindowView
- (void)layoutSubviews {
    %orig;
    if (gStyleMilkyWay) DMRestyleWindowButtons((AXWindowView *)self);
    DMKeepFit((UIView *)self);
    static int layouts = 0;
    if (layouts++ < 60 && DMTestFlag("/tmp/macstatusbar-debug")) {
        UIView *m = nil; @try { m = [(UIView *)self valueForKey:@"mainView"]; } @catch (id e) {}
        DMLog([NSString stringWithFormat:@"[layout] window %@ main %@ hidden %d", NSStringFromCGRect(((UIView *)self).frame), m ? NSStringFromCGRect(m.frame) : @"-", ((UIView *)self).hidden]);
    }
    DMFitIfNeeded((UIView *)self);   // a new content size: the app lays itself out for it
}
- (void)updateLayers {
    %orig;
    if (gStyleMilkyWay) DMRestyleWindowButtons((AXWindowView *)self);
    DMKeepFit((UIView *)self);
}
- (void)updateContentViewFrame:(CGRect)frame {
    UIView *cv = nil; @try { cv = [(UIView *)self valueForKey:@"contentView"]; } @catch (id e) {}
    DMLog([NSString stringWithFormat:@"[mw] updateContentViewFrame: %@ (window %@, contentView transform before %@)", NSStringFromCGRect(frame), NSStringFromCGRect(((UIView *)self).frame), cv ? NSStringFromCGAffineTransform(cv.transform) : @"-"]);
    %orig;
    DMLog([NSString stringWithFormat:@"[mw]   after: contentView frame %@ transform %@", cv ? NSStringFromCGRect(cv.frame) : @"-", cv ? NSStringFromCGAffineTransform(cv.transform) : @"-"]);
}
- (void)closeButtonAction:(id)sender {
    DMResetSceneFrame((UIView *)self);   // the app gets the whole screen back before the window goes
    %orig;
}
- (void)maxButtonAction:(id)sender {
    AXWindowView *me = (AXWindowView *)self;
    NSString *bundleID = [me bundleIdentifier];
    DMLog([NSString stringWithFormat:@"[lights] green on the MilkyWay window of %@: grow to full screen", bundleID]);
    DMExpandWindowToFullScreen(me, bundleID, sender);
}
- (void)minButtonAction:(id)sender {
    DMMinimizeWindow((UIView *)self);
}
// GREY-BAR FIX, real hand-drag specifically (live report: grey bars are worse when dragged by hand than with a scripted/Window-menu
// resize). Root cause, confirmed by code review: DMShowMilkyWayVeil was only ever called from paths THIS project drives directly
// (DMAerialMoveStage for programmatic moves, initWithContentView:identifier:scene: below for a fresh window, Window-menu layouts) —
// never from MilkyWay's own real resize-handle gesture, "sizeChangePan:" (the exact selector DMFakeResize already calls directly on
// the window to simulate a drag for scripted testing, confirmed real, not guessed). A real finger/pointer drag on the resize handle
// calls this method through MilkyWay's own live gesture recognizer, entirely unobserved by this project before now — so the ordinary
// per-frame lag between a scene frame push and the app's own re-layout catching up (which DMShowMilkyWayVeil already exists
// specifically to hide) was never covered during a real drag, only during moves/menu actions. Fix: show the veil the moment a real
// drag begins, same as every other call site — %orig still runs unmodified, this only adds the courtesy cover. Nothing needed to
// hide it again here: DMShowMilkyWayVeil's own DMMilkyWayVeilCheck polling (already watching gSceneUpdateTime, which every real scene
// push during the drag already updates) keeps it up for the whole live drag and fades it on its own once updates go quiet after
// release — the exact same mechanism already proven correct for the programmatic paths, just reached from one more real entry point.
- (void)sizeChangePan:(id)gesture {
    if (((UIGestureRecognizer *)gesture).state == UIGestureRecognizerStateBegan) DMShowMilkyWayVeil((UIView *)self);
    %orig;
}
- (id)initWithContentView:(id)contentView identifier:(id)identifier scene:(id)scene {
    id me = %orig;
    UIView *created = me;
    DMAttachWindowFocus(created);
    DMShowMilkyWayVeil(created);   // up before the enlarge below (and MilkyWay's own initial layout) ever runs, so none of it is seen mid-settle
    if (gFlexResize && [created respondsToSelector:NSSelectorFromString(@"setIsAspectLock:")])
        ((void (*)(id, SEL, BOOL))objc_msgSend)(created, NSSelectorFromString(@"setIsAspectLock:"), NO);   // the app can take any shape now, so no need to keep the screen's aspect ratio
    DMEnlargeNewWindow(created);   // right away, before the app is asked to lay out at the small default size
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.08 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMEnlargeNewWindow(created); });   // in case MilkyWay set its own frame afterwards
    __weak UIView *weakCreated = created;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ UIView *w = weakCreated; if (w && w.superview && !DMWindowMinimized(w)) DMCascadeStage(w); });   // Fit to Window tiles it, a prompt asks for a side, otherwise it is kept off the others
    if (DMFrontApp()) { gWindowsPinnedForward = YES; DMApplyWindowLevel(); DMLog(@"[lights] a new window opened over a full-screen app: windows brought forward"); }
    return me;
}
%end
%hook AXPassthroughWindow
- (void)setWindowLevel:(double)level {
    %orig(DMDesiredWindowLevel());
}
%end
%end

// ---- launching an app that already has a window shows that window (either engine) ----
static BOOL DMHasWindowFor(NSString *bundleID) { return DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu ? DMStageForBundle(bundleID) != nil : DMFindMilkyWayWindow(bundleID) != nil; }
// Named only for the log line (which app or process asked for this): actually deciding whether to window it is done by target bundle id, not by who asked
// (see DMActivationNeedsIcon below — an origin-based guess turned out to have too much collateral: AirDrop, Shortcuts, a Safari link, the share sheet's
// "Open In" and a plain `uiopen` all arrive the same way an incoming call or Handoff does, with no Home Screen icon of their own behind them).
static NSString *DMOriginName(id origin) {
    for (NSString *key in @[@"bundleIdentifier", @"name", @"processName"]) {
        SEL sel = NSSelectorFromString(key);
        if (![origin respondsToSelector:sel]) continue;
        id value = ((id (*)(id, SEL))objc_msgSend)(origin, sel);
        if ([value isKindOfClass:[NSString class]] && [(NSString *)value length]) return value;
    }
    return nil;
}
// activateApplication:fromIcon:... is not only called for an icon tap: AirDrop's "open the file you just accepted" (in Sileo, for a .deb) goes through it
// too, with no icon, since it is not a Home Screen activation. Blocking every icon-less call caught that along with the two continuity bugs it was written
// for (an iMessage arriving on the iPhone opening Messages, an incoming call opening WhatsApp): both of those are apps a person would recognize by name, so
// they are named here instead, and everything else needs no icon to open as a window.
static BOOL DMActivationNeedsIcon(NSString *bundleID) {
    static NSSet *continuityProne;
    if (!continuityProne) continuityProne = [NSSet setWithArray:@[@"com.apple.MobileSMS", @"com.apple.facetime", @"com.apple.mobilephone", @"net.whatsapp.WhatsApp"]];
    return [continuityProne containsObject:bundleID];
}
// LINKS INTO WINDOWS (iPad 2 cross-test, likely the owner's "Links in window not working"): an open request that carries a URL (a link tapped in one
// app that opens another, openURL:, the engine list's GET button) was turned into "open that app as a window" and the URL was thrown away, so
// Safari came up on its last page. Now the window is opened / brought forward as before and, as soon as the app's scene is in front and its
// content is ready, the URL is handed to that scene the way SpringBoard itself does it (a UIOpenURLAction), for every engine.
static NSURL *DMPayloadURL(id options) {
    id dict = [options respondsToSelector:NSSelectorFromString(@"dictionary")] ? ((id (*)(id, SEL))objc_msgSend)(options, NSSelectorFromString(@"dictionary")) : options;
    if (![dict isKindOfClass:[NSDictionary class]]) return nil;
    id u = [(NSDictionary *)dict objectForKey:@"__PayloadURL"];
    if ([u isKindOfClass:[NSString class]]) u = [NSURL URLWithString:u];
    return [u isKindOfClass:[NSURL class]] ? u : nil;
}
static void DMDeliverURLToWindow(NSString *bundleID, NSURL *url, int attempt) {
    id scene = DMSceneForBundle(bundleID);
    id settings = scene ? DMCall(scene, @"settings") : nil;
    BOOL fg = [settings respondsToSelector:NSSelectorFromString(@"isForeground")] && ((BOOL (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"isForeground"));
    long long content = [scene respondsToSelector:NSSelectorFromString(@"contentState")] ? ((long long (*)(id, SEL))objc_msgSend)(scene, NSSelectorFromString(@"contentState")) : 2;
    if (!scene || !fg || content < 2) {   // (a fresh launch: its scene and content come up within a second or two)
        if (attempt < 100) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMDeliverURLToWindow(bundleID, url, attempt + 1); });
        else DMLog([NSString stringWithFormat:@"[openurl] %@: gave up handing over %@ (scene %d, foreground %d, content %lld)", bundleID, url.scheme, scene != nil, fg, content]);
        return;
    }
    Class actionClass = objc_getClass("UIOpenURLAction");
    SEL init = NSSelectorFromString(@"initWithURL:"), send = NSSelectorFromString(@"sendActions:");
    if (!actionClass || ![actionClass instancesRespondToSelector:init] || ![scene respondsToSelector:send]) { DMLog(@"[openurl] no way to hand a URL to a scene on this iOS"); return; }
    id action = ((id (*)(id, SEL, id))objc_msgSend)([actionClass alloc], init, url);
    ((void (*)(id, SEL, id))objc_msgSend)(scene, send, [NSSet setWithObject:action]);
    DMLog([NSString stringWithFormat:@"[openurl] %@: URL (%@) handed to its window's scene after %.1f s", bundleID, url.scheme, attempt * 0.1]);
}
// Spotlight is shown by SpringBoard in an SBTransientOverlayWindow whose root is SBSpotlightTransientOverlayViewController (level 1057, above the windows).
static BOOL DMSpotlightShown(void) {
    for (UIWindow *w in DMAllWindows())
        if (!w.hidden && w.alpha > 0.01 && [NSStringFromClass([w class]) isEqualToString:@"SBTransientOverlayWindow"] && [NSStringFromClass([w.rootViewController class]) isEqualToString:@"SBSpotlightTransientOverlayViewController"]) return YES;
    return NO;
}
static void DMDismissSpotlightSoon(void) {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!DMSpotlightShown()) return;
        id sb = [UIApplication sharedApplication];
        SEL s = NSSelectorFromString(@"_toggleSearch");
        if (![sb respondsToSelector:s]) return;
        ((void (*)(id, SEL))objc_msgSend)(sb, s);
        DMLog(@"[workspace] Spotlight opened an app that has a window: Spotlight put away");
    });
}
// Cmd-Tab's list is SpringBoard's own recent-apps order, which knows nothing about windows: raising a window does not make its app the "current"
// one there, so a quick Cmd-Tab from a window kept picking that same app again (no change on the screen). When the picked app is the app of the front
// window, the next app in the list is taken instead -- a quick Cmd-Tab then goes to the app used before, as on a Mac.
static id DMCmdTabPick(id controller, id item) {   // returns the display item to switch to
    NSString *b = [item respondsToSelector:@selector(bundleIdentifier)] ? [item bundleIdentifier] : nil;
    NSString *front = [DMActiveApp() bundleIdentifier];   // (the front window's app while windows are in front)
    if (!b.length || !front.length || ![b isEqualToString:front] || !DMHasWindowFor(b)) return item;
    Ivar vi = class_getInstanceVariable(object_getClass(controller), "_commandTabViewController");
    id vc = vi ? object_getIvar(controller, vi) : nil;
    Ivar li = vc ? class_getInstanceVariable(object_getClass(vc), "_recentDisplayItems") : NULL;
    NSOrderedSet *items = li ? object_getIvar(vc, li) : nil;
    if (![items isKindOfClass:[NSOrderedSet class]] || items.count < 2) return item;
    NSUInteger i = [items indexOfObject:item];
    if (i == NSNotFound) return item;
    id next = items[(i + 1) % items.count];
    NSString *nb = [next respondsToSelector:@selector(bundleIdentifier)] ? [next bundleIdentifier] : nil;
    if (!nb.length || [nb isEqualToString:b]) return item;
    DMLog([NSString stringWithFormat:@"[cmdtab] %@ is the front window already: the next app in the list, %@, is taken", b, nb]);
    if (!DMHasWindowFor(nb)) {   // (an app without a window: SpringBoard opens it itself from its own selection, which must be that app)
        Ivar si = class_getInstanceVariable(object_getClass(vc), "_selectedIndex");
        if (si) *(NSUInteger *)((uint8_t *)(__bridge void *)vc + ivar_getOffset(si)) = (i + 1) % items.count;
    }
    return next;
}
static NSMutableDictionary<NSString *, NSNumber *> *gWindowLaunchUntil;   // (defined with DMWindowedLaunch)
%group WindowLaunch
// Launching an app that has a window: show the window instead. Icons (Home Screen, Dock) and code that opens apps go through these.
%hook SBUIController
- (void)activateApplication:(id)app fromIcon:(id)icon location:(id)location activationSettings:(id)settings actions:(id)actions {
    NSString *bundleID = [app bundleIdentifier];
    if ((icon || !DMActivationNeedsIcon(bundleID)) && DMWindowedLaunch(bundleID)) return;
    // A second icon tap while the app's Zetsu window is still coming up (a cold start takes 1-2 s with nothing on screen yet, so a second tap is
    // natural): it used to fall through to the normal full-screen launch (the 4 s "our own launch" pass above), and the app then ran full screen AND
    // in its new window at once -- YouTube on the iPad 2 came up as a full-screen app sized like its window, black below, the screen turned. Zetsu's
    // own launch calls never come through here (it uses -launchApplicationWithIdentifier:suspended:), so with an icon this is always the person.
    if (icon && bundleID.length && !gForceFullScreenLaunch && DMActiveEngine() == DMEngineZetsu && !DMZetsuWindowFor(bundleID)
        && gWindowLaunchUntil[bundleID] && CACurrentMediaTime() < gWindowLaunchUntil[bundleID].doubleValue && !DMTestFlag("/tmp/msb-zetsu-nodoubletap")) {
        DMLog([NSString stringWithFormat:@"[windowed] %@: another icon tap while its Zetsu window is still opening: ignored (not opened full screen too)", bundleID]);
        return;
    }
    %orig;
}
%end
// Opens that come from outside SpringBoard (LaunchServices, links, Spotlight, notifications) arrive as workspace requests.
%hook SBMainWorkspace
- (void)_handleOpenApplicationRequest:(id)request options:(id)options activationSettings:(id)settings origin:(id)origin withResult:(id)result {
    NSString *bundleID = [request isKindOfClass:[NSString class]] ? request : ([request respondsToSelector:@selector(bundleIdentifier)] ? [request bundleIdentifier] : nil);   // on 15.6.1 the request is the bundle id itself
    // The origin alone is not a reliable sign of "a person did this": AirDrop, Shortcuts, a link tapped in Safari, the share sheet's "Open In" and a plain
    // `uiopen` from a shell all go through LaunchServices (origin "lsd") or another system process the same way an incoming call or Handoff does, and
    // blocking every one of those left AirDrop unable to open Sileo windowed. So only the few apps a person would actually recognize by name — the ones
    // that opened unasked for on their own (an iMessage arriving on the iPhone, an incoming call) — are excluded here, whatever opened them.
    // An app that IS a window already comes forward as that window regardless: opening it full screen would give the full-screen app its window's scene
    // size (the rest of the screen stays black).
    // AirDrop (sharingd) does not just launch the app: the options/activationSettings this same call carries are how the app actually receives the file
    // that was sent. Redirecting the request into our own path (which only knows the bundle id, nothing about a file) throws that away — the app opened
    // as a window, but never got the file, confirmed by it opening fine (and the file arriving fine) when it goes full screen the normal way. So an
    // AirDrop request is always let straight through untouched, even for an app that already has a window — better a moment behind a full-screen cover
    // than the file silently lost.
    NSString *originName = DMOriginName(origin);
    BOOL isAirDrop = [originName isEqualToString:@"sharingd"] || [originName isEqualToString:@"com.apple.sharingd"];
    // A BACKGROUND launch (Background App Refresh from dasd, or any request asking to start suspended) is not an open: nothing may appear or come
    // forward. Seen on the iPad 2: dasd launched Reddit in the background during a respring's window restore; it became a window, and 10 s
    // later a second background request brought that window to the front.
    BOOL background = [originName isEqualToString:@"dasd"] || [originName isEqualToString:@"com.apple.dasd"];
    {
        id dict = [options respondsToSelector:NSSelectorFromString(@"dictionary")] ? ((id (*)(id, SEL))objc_msgSend)(options, NSSelectorFromString(@"dictionary")) : options;
        if ([dict isKindOfClass:[NSDictionary class]] && [[(NSDictionary *)dict objectForKey:@"__ActivateSuspended"] respondsToSelector:@selector(boolValue)] && [[(NSDictionary *)dict objectForKey:@"__ActivateSuspended"] boolValue]) background = YES;
        if (background) DMLog([NSString stringWithFormat:@"[workspace] background launch options: %@", [[[dict description] stringByReplacingOccurrencesOfString:@"\n" withString:@" "] substringToIndex:MIN([[dict description] length], (NSUInteger)300)]]);
    }
    BOOL hasWindow = !isAirDrop && !background && bundleID.length && DMHasWindowFor(bundleID);
    BOOL windowable = !isAirDrop && !background && bundleID.length && !DMActivationNeedsIcon(bundleID) && DMWindowedLaunchEligible(bundleID);
    DMLog([NSString stringWithFormat:@"[workspace] open request for %@ (%@) from %@ (%@)", bundleID, NSStringFromClass([request class]), originName ?: NSStringFromClass([origin class]), background ? @"a background launch: left alone" : (hasWindow ? @"its window comes forward" : (windowable ? @"opens as a window" : (isAirDrop ? @"AirDrop: left untouched so the file is not lost" : @"left alone")))]);
    if (bundleID.length && !gForceFullScreenLaunch && (hasWindow || windowable) && DMCallCompletion(result)) {
        DMWindowedLaunch(bundleID);   // an existing window is shown, otherwise the app opens as a window (Open Apps as Windows)
        // Keyboard Phase (iPad 2, iOS 16): a Spotlight result (Return with a hardware keyboard, or a tap) that opens an app with a window left Spotlight
        // open on top of that window -- SpringBoard only puts Spotlight away as part of a real app launch, which this path replaces. So it is put away here.
        if ([originName isEqualToString:@"com.apple.Spotlight"] || [originName isEqualToString:@"Spotlight"]) DMDismissSpotlightSoon();
        NSURL *url = DMPayloadURL(options);
        if (url) DMDeliverURLToWindow(bundleID, url, 0);
        return;
    }
    %orig;
}
%end
// Keyboard Phase (iPad 2, iOS 16, hardware keyboard): Cmd-Tab to an app that has a window opened that app FULL SCREEN (Aerial dropped its window and
// the other windows went behind it). Like on a Mac, Cmd-Tab now brings that app's window to the front instead; apps without a window switch as before.
%hook SBCommandTabController
- (void)viewController:(id)vc selectedApplicationWithDisplayItem:(id)item {
    id pick = DMCmdTabPick((id)self, item);
    NSString *b = [pick respondsToSelector:@selector(bundleIdentifier)] ? [pick bundleIdentifier] : nil;
    if (b.length && DMHasWindowFor(b)) {
        DMLog([NSString stringWithFormat:@"[cmdtab] %@ has a window: its window comes forward (not full screen)", b]);
        if ([(id)self respondsToSelector:@selector(dismiss)]) ((void (*)(id, SEL))objc_msgSend)((id)self, @selector(dismiss));
        dispatch_async(dispatch_get_main_queue(), ^{ DMWindowedLaunch(b); });
        return;
    }
    %orig(vc, pick);
}
- (void)launchCurrentSelectedApplication {
    id vc = nil; Ivar iv = class_getInstanceVariable(object_getClass((id)self), "_commandTabViewController"); if (iv) vc = object_getIvar((id)self, iv);
    id item = [vc respondsToSelector:NSSelectorFromString(@"selectedApplicationDisplayItem")] ? DMCall(vc, @"selectedApplicationDisplayItem") : nil;
    id pick = DMCmdTabPick((id)self, item);
    NSString *b = [pick respondsToSelector:@selector(bundleIdentifier)] ? [pick bundleIdentifier] : nil;
    if (b.length && DMHasWindowFor(b)) {
        DMLog([NSString stringWithFormat:@"[cmdtab] %@ has a window: its window comes forward (not full screen; launchCurrentSelectedApplication)", b]);
        if ([(id)self respondsToSelector:@selector(dismiss)]) ((void (*)(id, SEL))objc_msgSend)((id)self, @selector(dismiss));
        dispatch_async(dispatch_get_main_queue(), ^{ DMWindowedLaunch(b); });
        return;
    }
    %orig;
}
%end
%hook SpringBoard
- (BOOL)launchApplicationWithIdentifier:(id)identifier suspended:(BOOL)suspended {
    extern BOOL DMSwallowZetsuRelaunch(NSString *bundleID, void *caller);
    if ([identifier isKindOfClass:[NSString class]] && DMSwallowZetsuRelaunch(identifier, __builtin_return_address(0))) return YES;
    if (DMTestFlag("/tmp/macstatusbar-debug")) {
        static int told = 0;
        Dl_info di; void *ra = __builtin_return_address(0);
        if (told < 60 && ra && dladdr(ra, &di) && di.dli_fname && strstr(di.dli_fname, "/Zetsu.dylib")) { told++; DMLog([NSString stringWithFormat:@"[zetsu] launch call for %@ (suspended %d, caller +0x%lx)", identifier, suspended, (unsigned long)((uintptr_t)ra - (uintptr_t)di.dli_fbase)]); }
    }
    return %orig;   // (the system launches apps this way for its own reasons; it is not a tap on anything)
}
%end
%end
// WhatsApp straight into a Zetsu window (iPad 2): Zetsu opens a window by calling -[SpringBoard launchApplicationWithIdentifier:suspended:] and then
// calls it AGAIN about every 0.38 s until the app's scene is ready. For a multi-window app every such call makes a brand-new scene (and a saved scene
// session): 92 WhatsApp scenes after 40 s (probe scenes_/scenecreate_), which the app then has to bring up one by one -- a slower start, so more
// retries (13 s before anything showed; our 6 s empty-window rescue then opened it full screen), and ~4,000 saved sessions piled up over time.
// So while Zetsu is our engine, a repeat of Zetsu's own call for the same multi-window app within 1.5 s of the previous one, with no window for it
// yet, is answered "launched" without asking SpringBoard again: the app keeps the one scene the first call made. The first call of every burst goes
// through, so opening the app again later is unaffected. Kill switch /tmp/msb-zetsu-norelaunchdedupe (debug builds).
static BOOL DMAppSupportsMultipleScenes(NSString *bundleID) {
    static NSMutableDictionary<NSString *, NSNumber *> *cache;
    if (!cache) cache = [NSMutableDictionary dictionary];
    NSNumber *known = cache[bundleID];
    if (known) return known.boolValue;
    NSURL *url = nil; @try { url = [DMProxyForBundle(bundleID) valueForKey:@"bundleURL"]; } @catch (id e) {}
    NSDictionary *info = [url isKindOfClass:[NSURL class]] ? [NSDictionary dictionaryWithContentsOfURL:[url URLByAppendingPathComponent:@"Info.plist"]] : nil;
    if (!info) return NO;
    id manifest = info[@"UIApplicationSceneManifest"];
    id multi = [manifest isKindOfClass:[NSDictionary class]] ? manifest[@"UIApplicationSupportsMultipleScenes"] : nil;
    BOOL yes = [multi respondsToSelector:@selector(boolValue)] && [multi boolValue];
    cache[bundleID] = @(yes);
    return yes;
}
BOOL DMSwallowZetsuRelaunch(NSString *bundleID, void *caller) {
    if (!bundleID.length || DMActiveEngine() != DMEngineZetsu || DMTestFlag("/tmp/msb-zetsu-norelaunchdedupe")) return NO;
    Dl_info di;
    if (!caller || !dladdr(caller, &di) || !di.dli_fname || !strstr(di.dli_fname, "/Zetsu.dylib")) return NO;   // only Zetsu's own calls
    static NSMutableDictionary<NSString *, NSNumber *> *lastCall, *swallowed, *burstStart;
    if (!lastCall) { lastCall = [NSMutableDictionary dictionary]; swallowed = [NSMutableDictionary dictionary]; burstStart = [NSMutableDictionary dictionary]; }
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *prev = lastCall[bundleID];
    lastCall[bundleID] = @(now);
    BOOL repeat = prev && now - prev.doubleValue < 1.5;
    if (!repeat) {
        if ([swallowed[bundleID] intValue] > 0) DMLog([NSString stringWithFormat:@"[zetsu] %@: %d repeated launch calls were not passed on (one scene kept)", bundleID, [swallowed[bundleID] intValue]]);
        swallowed[bundleID] = @0;
        burstStart[bundleID] = @(now);
        swallowed[[bundleID stringByAppendingString:@"#warm"]] = @NO;   // (a new burst may use the fallback again)
        return NO;
    }
    if (DMZetsuWindowFor(bundleID) || !DMAppSupportsMultipleScenes(bundleID)) return NO;
    int n = [swallowed[bundleID] intValue] + 1; swallowed[bundleID] = @(n);
    if (n == 1) DMLog([NSString stringWithFormat:@"[zetsu] %@: Zetsu asks to launch it again (%.2f s later): not passed on, so the app keeps one scene", bundleID, now - prev.doubleValue]);
    // Loop guard: still asking 2 s after its first call, with no window -- the app does not come up in a window this way (WhatsApp); the known-good
    // path takes over once per burst: full screen first, then into a window (DMZetsuWarmStart).
    if (now - [burstStart[bundleID] doubleValue] >= 2.0 && ![swallowed[[bundleID stringByAppendingString:@"#warm"]] boolValue]) {
        swallowed[[bundleID stringByAppendingString:@"#warm"]] = @YES;
        extern void DMZetsuWarmStart(NSString *bundleID, NSString *why);
        dispatch_async(dispatch_get_main_queue(), ^{ DMZetsuWarmStart(bundleID, @"Zetsu's launch keeps repeating with no window after 2 s"); });
    }
    return YES;
}
// The known-good way into a window for an app that does not come up in one when started in the background (WhatsApp with Zetsu): it is opened full
// screen behind a still picture of the screen, and once it is in front and has had a moment to draw, the usual full screen -> window transition runs
// (DMSendToWindow: the app goes home, Zetsu's window opens, the picture shrinks into it). Apps that needed this go this way straight away for the rest
// of the session (DMZetsuLaunch). If the app never comes to the front (15 s), the picture goes and the app stays wherever it is.
NSMutableSet<NSString *> *gZetsuWarmStartApps = nil;
void DMZetsuWarmStart(NSString *bundleID, NSString *why) {
    static NSMutableSet<NSString *> *busy;
    if (!busy) busy = [NSMutableSet set];
    if (!bundleID.length || [busy containsObject:bundleID] || DMZetsuWindowFor(bundleID)) return;
    [busy addObject:bundleID];
    if (!gZetsuWarmStartApps) gZetsuWarmStartApps = [NSMutableSet set];
    [gZetsuWarmStartApps addObject:bundleID];
    DMLog([NSString stringWithFormat:@"[zetsu] %@: %@ -- opening it full screen first (behind a picture of the screen), then into a window", bundleID, why]);
    DMCoverShowFor(16.0);
    DMOpenFullScreen(bundleID);
    CFTimeInterval began = CACurrentMediaTime();
    // as soon as it is in front and has drawn its first frame (FrontBoard's content state, checked every display frame; was a fixed 0.8 s)
    extern void DMWhenAppDrawn(NSString *bundleID, BOOL needFront, double timeout, void (^done)(BOOL ready));
    DMWhenAppDrawn(bundleID, YES, 15.0, ^(BOOL drawn) {
        [busy removeObject:bundleID];
        if (![[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) { DMLog([NSString stringWithFormat:@"[zetsu] %@: never came to the front (15 s): left as it is", bundleID]); DMCoverFadeOut(0.0); return; }
        UIWindow *zw = DMZetsuWindowFor(bundleID);
        DMLog([NSString stringWithFormat:@"[zetsu] %@: in front and %@ after %.2f s, now into a window (%@)", bundleID, drawn ? @"drawn" : @"(no first-frame signal)", CACurrentMediaTime() - began, zw ? @"Zetsu already made one" : @"the usual transition"]);
        if (zw) {
            DMMinimize(); DMZetsuSurface(zw); DMShrinkCoverInto(zw);
            // (iPad 2: Safari's window was surfaced before the Home press had finished, and the press then left it minimized -- the app opened
            // nowhere. Checked again once the press is over.)
            __weak UIWindow *weakZW = zw;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIWindow *w2 = weakZW;
                if (w2 && DMStageMinimized(w2) && ![objc_getAssociatedObject(w2, kStageClosingKey) boolValue]) {
                    DMLog([NSString stringWithFormat:@"[zetsu] %@: the Home press left its new window minimized: shown again", bundleID]);
                    DMZetsuSurface(w2);
                }
            });
            return;
        }
        DMSendToWindow(bundleID);
    });
}
static BOOL gLaunchHooked = NO;
static void DMTryHookWindowLaunch(void) {
    if (gLaunchHooked || DMActiveEngine() == DMEngineNone) return;
    gLaunchHooked = YES;
    %init(WindowLaunch);
    DMLog(@"[engine] launch hooks installed (an app that has a window opens that window)");
}

// MilkyWay4, Settings (the A2 report: "content STILL not caught up after 4s", the window kept its old, wider layout, clipped): an app that
// declares UIRequiresFullScreen (Settings does) is not treated as resizable by SpringBoard, so a smaller scene frame never reached its layout.
// MilkyWay's own answer is its per-app "Force resize and rotate" list (isMedusa), which we empty while it is our engine; Aerial answers it for
// every app by replacing -[SBApplication isMedusaCapable] (hookedby_Aerial). Same here, but only for an app that is in a MilkyWay window, so a
// full-screen app is exactly as before. Kill switch: /tmp/msb-mw-nomedusa (read when SpringBoard starts).
static UIView *DMFindMilkyWayWindow(NSString *bundleID);
// Measured (M1, Phase 2b): the answer only matters when the app process STARTS (UIKit then decides whether its windows follow the scene's size);
// asking "is it in a window" at that moment said no (the window is made a moment later), so, like Aerial, every app counts as resizable while
// MilkyWay4 or Zetsu is our engine. Full-screen apps are unchanged (a full-screen scene is the screen's size anyway). Result: Settings, a
// UIRequiresFullScreen app, got a 834 x 1194 window inside a 412 x 528 scene (clipped two-column layout) before, and collapses like under Aerial after.
%group EngineMedusa
%hook SBApplication
- (BOOL)isMedusaCapable {
    BOOL orig = %orig;
    DMEngine e = DMActiveEngine();
    return (e == DMEngineMilkyWay || e == DMEngineZetsu) ? YES : orig;
}
%end
%end
static BOOL gMilkyWayHooked = NO;
static void DMTryHookMilkyWay(int attempt) {
    if (gMilkyWayHooked) return;
    if (DMMilkyWayInstalled() && DMActiveEngine() != DMEngineMilkyWay) {
        static BOOL said = NO;
        if (!said) { said = YES; DMLog([NSString stringWithFormat:@"[engine] MilkyWay is installed but %@ is the chosen window engine: MilkyWay's windows are left alone", DMActiveEngine() == DMEngineZetsu ? @"Zetsu" : @"Aerial"]); }
    } else if (DMMilkyWayInstalled()) {
        gMilkyWayHooked = YES;
        %init(MilkyWayGreen);
        DMLog(@"[lights] MilkyWay window hook installed");
        return;
    }
    if (attempt < 15 && !gMilkyWayHooked) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMTryHookMilkyWay(attempt + 1); });
}

// SBApplication has no -pid on 15.6.1, so ask FrontBoard's process manager instead.
static int DMPidForApp(SBApplication *app) {
    SEL pidSel = NSSelectorFromString(@"pid");
    if ([app respondsToSelector:pidSel]) return ((int (*)(id, SEL))objc_msgSend)(app, pidSel);
    NSString *bid = [app bundleIdentifier];
    id manager = DMCall(objc_getClass("FBProcessManager"), @"sharedInstance");
    for (id process in (NSArray *)DMCall(manager, @"allApplicationProcesses")) {
        if (![[DMCall(process, @"bundleIdentifier") description] isEqualToString:bid]) continue;
        if ([process respondsToSelector:pidSel]) return ((int (*)(id, SEL))objc_msgSend)(process, pidSel);
    }
    return 0;
}

// Physical footprint of a process in bytes (what Activity Monitor-style tools call "memory"); 0 if unreadable.
static uint64_t DMFootprintBytes(int pid) {
    if (pid <= 0) return 0;
    struct rusage_info_v2 ri;
    memset(&ri, 0, sizeof(ri));
    if (proc_pid_rusage(pid, RUSAGE_INFO_V2, (rusage_info_t *)&ri) != 0) return 0;
    return ri.ri_phys_footprint;
}

// ===== drop-down UI (drawn by us, inside the status bar window) =============
// The native UIMenu is presented in a UIKit-owned window that doesn't follow
// SpringBoard's orientation handling: nothing appeared on the Home Screen and it
// was rotated inside apps. UIStatusBarWindow is always correctly oriented, so the
// menu and confirmation dialogs live in it instead.

static const CGFloat kRowH    = 30.0;
static const CGFloat kSepH    = 11.0;
static const CGFloat kPanelW  = 230.0;
static const CGFloat kPanelPad = 6.0;
static const CGFloat kSliderRowH = 46.0;   // taller than a plain DMRow: an app name label above a mute button + slider (see DMSliderRow)

static UIView *gOverlay = nil;   // non-nil while the menu or a dialog is showing
static UIView *gPill = nil;      // highlight behind the logo while the menu is open

@interface DMRow : UIControl
@property (nonatomic, copy) NSString *hint;                 // shortcut shown on the right, like macOS
@property (nonatomic, strong) UILabel *hintLabel;
@property (nonatomic, copy) dispatch_block_t handler;
@property (nonatomic, strong) UILabel *label;
@property (nonatomic, strong) UIView *highlightView;
@property (nonatomic, assign) BOOL hovering;
@property (nonatomic, assign) BOOL checked;                 // a tick in the left margin, like a macOS menu item that is switched on
@property (nonatomic, strong) UIImageView *tickView;
@property (nonatomic, assign) BOOL getBadge;                 // the hint drawn as an App Store-style GET capsule (an app that is not installed)
- (instancetype)initWithTitle:(NSString *)title enabled:(BOOL)enabled handler:(dispatch_block_t)handler;
@end

@implementation DMRow
- (instancetype)initWithTitle:(NSString *)title enabled:(BOOL)enabled handler:(dispatch_block_t)handler {
    self = [super initWithFrame:CGRectZero];
    if (!self) return nil;
    _handler = [handler copy];

    _highlightView = [UIView new];
    _highlightView.backgroundColor = [UIColor systemBlueColor];
    _highlightView.layer.cornerRadius = 5.0;
    _highlightView.hidden = YES;
    _highlightView.userInteractionEnabled = NO;
    [self addSubview:_highlightView];

    _label = [UILabel new];
    _label.text = title;
    _label.font = [UIFont systemFontOfSize:14.0];
    _label.userInteractionEnabled = NO;
    [self addSubview:_label];

    self.enabled = enabled;
    if (enabled) {
        [self addTarget:self action:@selector(fire:forEvent:) forControlEvents:UIControlEventTouchUpInside];
        [self addGestureRecognizer:[[UIHoverGestureRecognizer alloc] initWithTarget:self action:@selector(hover:)]];
    }
    [self refresh];
    return self;
}
- (void)setChecked:(BOOL)checked {
    _checked = checked;
    if (checked && !self.tickView) {
        UIImageSymbolConfiguration *cfg = [UIImageSymbolConfiguration configurationWithPointSize:10.0 weight:UIImageSymbolWeightSemibold];
        self.tickView = [[UIImageView alloc] initWithImage:[UIImage systemImageNamed:@"checkmark" withConfiguration:cfg]];
        self.tickView.userInteractionEnabled = NO;
        [self addSubview:self.tickView];
    }
    self.tickView.hidden = !checked;
    [self setNeedsLayout];
    [self refresh];
}
- (void)setHint:(NSString *)hint {
    _hint = [hint copy];
    if (!self.hintLabel) {
        self.hintLabel = [UILabel new];
        self.hintLabel.font = [UIFont systemFontOfSize:13.0];
        self.hintLabel.textAlignment = NSTextAlignmentRight;
        self.hintLabel.userInteractionEnabled = NO;
        [self addSubview:self.hintLabel];
    }
    self.hintLabel.text = hint;
    [self setNeedsLayout];
    [self refresh];
}
- (void)fire:(id)sender forEvent:(UIEvent *)event {
    UITouch *t = [event.allTouches anyObject];
    // touch type: 0 = finger, 3 = trackpad/mouse click, 2 = Pencil
    DMLog([NSString stringWithFormat:@"[row] tapped \"%@\" (touch type %ld)", self.label.text, (long)t.type]);
    if (self.handler) self.handler();
}
- (void)hover:(UIHoverGestureRecognizer *)g {
    self.hovering = (g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged);
    [self refresh];
}
- (void)setHighlighted:(BOOL)highlighted { [super setHighlighted:highlighted]; [self refresh]; }
- (void)refresh {
    BOOL lit = self.enabled && (self.hovering || self.highlighted);
    self.highlightView.hidden = !lit;
    self.label.textColor = !self.enabled ? [UIColor tertiaryLabelColor]
                         : (lit ? [UIColor whiteColor] : [UIColor labelColor]);
    self.hintLabel.textColor = !self.enabled ? [UIColor tertiaryLabelColor]
                             : (lit ? [UIColor colorWithWhite:1.0 alpha:0.8] : [UIColor secondaryLabelColor]);
    if (self.getBadge) {
        self.hintLabel.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightBold];
        self.hintLabel.textAlignment = NSTextAlignmentCenter;
        self.hintLabel.textColor = lit ? [UIColor whiteColor] : [UIColor systemBlueColor];
        self.hintLabel.backgroundColor = lit ? [UIColor colorWithWhite:1.0 alpha:0.22] : [UIColor tertiarySystemFillColor];
        self.hintLabel.layer.cornerRadius = 9.0; self.hintLabel.clipsToBounds = YES;
    }
    self.tickView.tintColor = lit ? [UIColor whiteColor] : [UIColor labelColor];
}
- (void)layoutSubviews {
    [super layoutSubviews];
    self.highlightView.frame = CGRectInset(self.bounds, 5.0, 0.0);
    CGFloat hintW = self.hint.length ? ceil([self.hintLabel sizeThatFits:CGSizeMake(200, 30)].width) + (self.getBadge ? 18.0 : 0.0) : 0.0;
    self.hintLabel.frame = CGRectMake(self.bounds.size.width - 16.0 - hintW, 0.0, hintW, self.bounds.size.height);
    if (self.getBadge) self.hintLabel.frame = CGRectMake(self.bounds.size.width - 12.0 - hintW, (self.bounds.size.height - 18.0) / 2.0, hintW, 18.0);
    self.label.frame = CGRectMake(16.0, 0.0, self.bounds.size.width - 32.0 - (hintW > 0 ? hintW + 8.0 : 0.0), self.bounds.size.height);
    if (self.tickView) self.tickView.frame = CGRectMake(3.0, (self.bounds.size.height - 11.0) / 2.0, 10.0, 11.0);
}
@end

// A menu row the toolkit did not have yet: an app's display name above a mute button and a volume slider, for the Audio menu's per-app
// rows. Not a DMRow (a DMRow is a single tap target for its whole width; this row's two live controls handle their own touches), but drawn
// with the same left/right margins so it reads as part of the same menu. -bundleID is set by the caller and never touched here; the slider's
// own live drag/commit goes back out through -onChange, which is where Mac Status Bar writes the multiplier and posts MixAudio's notification.
@interface DMSliderRow : UIView
@property (nonatomic, copy) NSString *bundleID;
@property (nonatomic, strong) UILabel *nameLabel;
@property (nonatomic, strong) UISlider *slider;
@property (nonatomic, strong) UIButton *muteButton;
@property (nonatomic, assign) CGFloat preMuteValue;   // the slider position to restore when un-muting, like macOS remembering where a volume slider was
@property (nonatomic, copy) void (^onChange)(float value, BOOL commit);   // commit = NO while dragging (throttled by the caller), YES once settled
// Audio Mixing off: this app is silenced so another one can be heard (its own slider value is kept). The row shows it muted and dimmed; its
// speaker button makes it the one that is heard instead (onMakeSource).
@property (nonatomic, assign) BOOL sourceMuted;
@property (nonatomic, copy) void (^onMakeSource)(void);
// Audio audit F13: an app whose level we can't change (MixAudio isn't running in it, its audio is web audio, it's in a call) keeps its row, but the
// slider and the speaker button are disabled (the stock disabled look) and a short hint follows the name. nil = controllable. Refreshed while the
// menu is open, so a row comes alive by itself when the app becomes controllable.
@property (nonatomic, copy) NSString *blockedHint;
@property (nonatomic, copy) NSString *baseTitle;
- (instancetype)initWithBundleID:(NSString *)bundleID title:(NSString *)title volume:(float)volume;
@end

@implementation DMSliderRow
- (instancetype)initWithBundleID:(NSString *)bundleID title:(NSString *)title volume:(float)volume {
    self = [super initWithFrame:CGRectZero];
    if (!self) return nil;
    _bundleID = [bundleID copy];
    _baseTitle = [title copy];
    _preMuteValue = volume > 0.001 ? volume : 1.0;

    _nameLabel = [UILabel new];
    _nameLabel.text = title;
    _nameLabel.font = [UIFont systemFontOfSize:12.0];
    _nameLabel.textColor = [UIColor secondaryLabelColor];
    _nameLabel.lineBreakMode = NSLineBreakByTruncatingTail;
    [self addSubview:_nameLabel];

    _muteButton = [UIButton buttonWithType:UIButtonTypeSystem];
    _muteButton.tintColor = [UIColor labelColor];
    [_muteButton addTarget:self action:@selector(muteTapped) forControlEvents:UIControlEventTouchUpInside];
    [self addSubview:_muteButton];

    _slider = [UISlider new];
    _slider.minimumValue = 0.0;
    _slider.maximumValue = 1.0;
    _slider.value = volume;
    // BUG FOUND LIVE (2026-09-23, real report: "Enter Value" text-entry alert appearing over the whole screen while using this slider,
    // never seen elsewhere in stock iOS): a native UISlider always carries the UIAccessibilityTraitAdjustable trait built into its own
    // class (not something we set, and not overridable via the public accessibilityTraits property), which iPadOS's pointer/trackpad
    // support surfaces as a system "Enter Value" action on secondary click/long-press -- confirmed this device has NO VoiceOver/Full
    // Keyboard Access/Switch Control features actually enabled (checked com.apple.Accessibility.plist directly), so this is coming purely
    // from the pointer-interaction side, not an assistive-technology setting. Turning the slider itself off as an accessibility element
    // removes it from that pointer-menu path entirely (this is a personal single-user utility, not something needing VoiceOver support).
    _slider.isAccessibilityElement = NO;
    [_slider addTarget:self action:@selector(sliderChanged) forControlEvents:UIControlEventValueChanged];
    [_slider addTarget:self action:@selector(sliderCommitted) forControlEvents:UIControlEventTouchUpInside | UIControlEventTouchUpOutside | UIControlEventTouchCancel];
    [self addSubview:_slider];

    [self refreshMuteIcon];
    return self;
}
- (void)setSourceMuted:(BOOL)sourceMuted {
    _sourceMuted = sourceMuted;
    self.slider.enabled = !sourceMuted && !self.blockedHint;
    self.slider.alpha = sourceMuted ? 0.4 : 1.0;
    [self refreshMuteIcon];
}
- (void)setBlockedHint:(NSString *)hint {
    if (hint == _blockedHint || [hint isEqualToString:_blockedHint]) return;
    _blockedHint = [hint copy];
    self.slider.enabled = !hint && !self.sourceMuted;
    self.muteButton.enabled = !hint;
    self.nameLabel.text = hint ? [NSString stringWithFormat:@"%@ \u00B7 %@", self.baseTitle ?: @"", hint] : self.baseTitle;
}
- (void)refreshMuteIcon {
    BOOL muted = self.slider.value <= 0.001 || self.sourceMuted;
    UIImageSymbolConfiguration *cfg = [UIImageSymbolConfiguration configurationWithPointSize:14.0 weight:UIImageSymbolWeightRegular];
    [self.muteButton setImage:[UIImage systemImageNamed:muted ? @"speaker.slash.fill" : @"speaker.wave.2.fill" withConfiguration:cfg] forState:UIControlStateNormal];
    self.muteButton.accessibilityLabel = muted ? @"Unmute" : @"Mute";
}
- (void)muteTapped {
    if (self.sourceMuted) { if (self.onMakeSource) self.onMakeSource(); self.sourceMuted = NO; return; }
    BOOL muted = self.slider.value <= 0.001;
    float newValue;
    if (muted) { newValue = self.preMuteValue > 0.001 ? self.preMuteValue : 1.0; }
    else { self.preMuteValue = self.slider.value; newValue = 0.0; }
    [self.slider setValue:newValue animated:YES];
    [self refreshMuteIcon];
    if (self.onChange) self.onChange(newValue, YES);
}
- (void)sliderChanged {
    if (self.slider.value > 0.001) self.preMuteValue = self.slider.value;
    [self refreshMuteIcon];
    if (self.onChange) self.onChange(self.slider.value, NO);
}
- (void)sliderCommitted {
    if (self.onChange) self.onChange(self.slider.value, YES);
}
- (void)layoutSubviews {
    [super layoutSubviews];
    CGFloat w = self.bounds.size.width;
    self.nameLabel.frame = CGRectMake(16.0, 3.0, w - 32.0, 15.0);
    self.muteButton.frame = CGRectMake(12.0, 22.0, 24.0, 22.0);
    self.slider.frame = CGRectMake(42.0, 21.0, w - 42.0 - 16.0, 24.0);
}
@end

// The status bar you see inside an app is a separate copy that lives inside the app
// switcher's rotated content, so adding things at the window root puts them 90 degrees
// off. The view above UIStatusBar_Modern is a full-screen container already oriented
// the way the screen is (for the main status bar window it is the window itself).
// ---- external displays ----
// iPadOS 16 with an extended display (TrollPad's external display option, or Apple's own Stage Manager display): SpringBoard gives the TV its own
// window scene with its own status bar, and our status bar is drawn there too (a copy in a window of that scene). Menus opened from that copy
// used to go into our menu window on the iPad (nothing showed on the TV). DMExternalScreenOf says whether a view lives on such a display: its
// window's scene is on a screen other than the iPad's own. iPadOS 15 and plain mirroring (the TV shows the iPad's own picture, no scene of its
// own) always answer nil, so nothing below changes there.
static UIScreen *DMExternalScreenOf(UIView *v) {
    if (!v || [NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16) return nil;
    UIWindow *w = [v isKindOfClass:[UIWindow class]] ? (UIWindow *)v : v.window;
    if (!w) return nil;
    UIScreen *s = nil;
    @try { s = w.windowScene.screen ?: w.screen; } @catch (id e) { return nil; }
    UIScreen *main = [UIScreen mainScreen];
    return (s && main && s != main) ? s : nil;
}
// One menu window per external display's scene (made on the first menu opened there), the same kind of pass-through window as the iPad's
// (only our own catch-all takes touches, see DMMenuWindowHitTest) at the same level. Not turned: an external display has no interface rotation.
// Released when its display goes (DMExtMenuDisplayGone).
static NSMutableArray<UIWindow *> *gExtMenuWindows = nil;
static BOOL DMIsExtMenuHost(UIView *host) { return host && gExtMenuWindows && [gExtMenuWindows indexOfObjectIdenticalTo:(UIWindow *)host] != NSNotFound; }
static BOOL DMExtMenuVisible(void) { for (UIWindow *w in gExtMenuWindows) if (!w.hidden) return YES; return NO; }
static void DMHideExtMenuWindows(void) { for (UIWindow *w in gExtMenuWindows) if (!w.hidden) w.hidden = YES; }
static BOOL gExtNoticeForce = NO;   // (debug trigger extnotice_show: the external display notice now, whatever the conditions; DMCheckExtDisplayNotice)
static BOOL gSMEngineNoticeForce = NO;   // (debug trigger smnotice_show: the Stage Manager engine notice now; DMCheckSMEngineNotice)
// ---- the menu window ----
// Menus used to open inside the window that hosts the status bar: on the Home Screen that is the level-999 status bar window, in an app it
// is an app-level window under MilkyWay's windows, and taps elsewhere on screen never reached the menu's catch-all view there (only the
// Home Screen closed the menu on any tap). Menus now get their own full-screen SpringBoard window, above the app and above MilkyWay's
// windows (level 1040; MilkyWay's are 1033, the Cover Sheet is 1050), hidden except while a menu or dialog is open. It is created a few
// seconds after launch, behind a crash-loop guard, from the same kind of window SpringBoard uses for its own overlays.
static const CGFloat kMenuWindowLevel = 1040.0;
static UIWindow *gMenuWindow = nil;
static UIView *gMenuRotator = nil;   // iPadOS 16: the container menus are built in when the menu window is not turned with the screen (see DMMenuHost)
static long gMenuRotatorBuiltForOrientation = 0;   // the orientation DMMenuHost() last hosted a menu for, turned window or not; 0 when none (see DMCloseMenuIfOrientationStale)
static CGSize gMenuBuiltForScreen = {0, 0};         // the screen size at that same moment
static UIView *DMMenuWindowHitTest(id self, SEL _cmd, CGPoint point, UIEvent *event) {
    UIWindow *w = (UIWindow *)self;
    NSMutableArray<UIView *> *candidates = [NSMutableArray array];
    for (UIView *v in w.subviews) { if (v == gMenuRotator) [candidates addObjectsFromArray:v.subviews]; else [candidates addObject:v]; }
    for (UIView *v in [candidates reverseObjectEnumerator]) {   // only our own overlay takes touches; anything else passes through
        if (v.hidden || v.alpha < 0.01 || !v.userInteractionEnabled) continue;
        if (![NSStringFromClass([v class]) isEqualToString:@"UIControl"]) continue;
        UIView *hit = [v hitTest:[w convertPoint:point toView:v] withEvent:event];
        if (hit) return hit;
    }
    return nil;
}
// `-[UIApplication statusBarOrientation]` is SpringBoard's own idea of the interface orientation, and it follows whichever scene is frontmost. On
// iPadOS 16 a windowed app's scene is always pinned to orientation 1 (see DMWantedSceneOrientation), so with a window in front it keeps reading
// "portrait" even while the real screen is landscape -- DMFixKeyboardOrientation hit exactly this for the keyboard pill and already works around it
// the same way done here: the screen's own shape (from UIScreen, which does track the real rotation) decides landscape vs portrait, and only which
// landscape (left or right) needs the device's raw orientation to tell apart. Without this, DMMenuHost below could pick the wrong turn (or none) for
// its rotated container depending on whether a window happened to be frontmost when a menu was opened -- menus fine in one orientation, hidden or
// sideways in the other, "fixing itself" whenever the frontmost scene's own orientation happened to catch up. Read-only: two public getters.
//
// LIVE-CONFIRMED ROOT CAUSE (2026-09-23) of the menu sometimes opening at a wrong/"random" spot, or not visibly at all, on repeated opens even with
// no menu-code change in between: the UIDevice fallback below used to read `[UIDevice currentDevice].orientation == UIDeviceOrientationLandscapeRight
// ? 3 : 4` -- i.e. it treated EVERY non-LandscapeRight reading as LandscapeLeft. But UIDeviceOrientation also reports FaceUp/FaceDown/Unknown whenever
// the accelerometer can't tell left from right, which is exactly what happens whenever the iPad is close to flat -- the normal way to use this tweak's
// own windowed multitasking with an attached hardware keyboard, sitting low on a desk or in a low-angle stand. Every one of those ambiguous readings
// silently forced orientation 4, independent of which landscape direction the screen was actually, visibly showing, so a menu opened while the device
// was lying flat could rotate the wrong way (appearing off in an unrelated spot, or effectively off-screen) even though nothing about the physical
// screen orientation had changed -- and it would look "fixed" again as soon as a later attempt happened to catch the accelerometer at a confident
// tilt. The real fix is not a guess but memory: keep the last direction that WAS read with confidence (a real LandscapeLeft/LandscapeRight reading, or
// a real landscape `statusBarOrientation`) and keep using it while the live reading is ambiguous, instead of defaulting blind.
static long gLastConfidentLandscapeOrientation = 3;   // 3 or 4; see the comment above
// Which landscape the SCREEN is in (3 / 4), or 0 when nothing says so with confidence. Keyboard Phase fix (iPad 2, iOS 16, 2026-09-24): the old
// fallback read the device's orientation the wrong way round -- UIDeviceOrientationLandscapeLeft (3) IS UIInterfaceOrientationLandscapeRight (3), the
// numbers are equal (UIApplication.h) -- and with the rotation lock on, the device can lie in the other landscape than the screen anyway. After a
// respring in landscape (statusBarOrientation still reads 1 then) this turned the window layer upside down (DMAerial5CheckWindowTurn "fixed" Aerial's
// right turn into the wrong one). SpringBoard's activeInterfaceOrientation is the screen's real one (verified: 3 while the fallback said 4), so it
// comes first; the device's reading, now mapped 1:1, only when that gives no landscape.
static long DMLandscapeSide(void) {
    id app = [UIApplication sharedApplication];
    SEL aio = NSSelectorFromString(@"activeInterfaceOrientation");
    long a = [app respondsToSelector:aio] ? ((long (*)(id, SEL))objc_msgSend)(app, aio) : 0;
    if (a == 3 || a == 4) return a;
    UIDeviceOrientation d = [UIDevice currentDevice].orientation;
    if (d == UIDeviceOrientationLandscapeLeft) return 3;    // (= UIInterfaceOrientationLandscapeRight)
    if (d == UIDeviceOrientationLandscapeRight) return 4;   // (= UIInterfaceOrientationLandscapeLeft)
    return 0;
}
static long DMRealInterfaceOrientation(void) {
    long o = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"));
    CGSize screen = [UIScreen mainScreen].bounds.size;
    BOOL landscapeScreen = screen.width > screen.height;
    if (landscapeScreen && o != 3 && o != 4) {
        long l = DMLandscapeSide();
        if (l == 3 || l == 4) o = gLastConfidentLandscapeOrientation = l;
        else o = gLastConfidentLandscapeOrientation;   // FaceUp/FaceDown/Unknown/etc: no left/right info -- keep the last confirmed direction, don't guess
    } else if (!landscapeScreen && o != 1 && o != 2) {
        o = 1;
    } else if (o == 3 || o == 4) {
        gLastConfidentLandscapeOrientation = o;   // statusBarOrientation itself gave a confident landscape reading -- remember it too
    }
    if (DMTestFlag("/tmp/macstatusbar-debug")) {
        static long lastLogged = -999;
        if (o != lastLogged) {
            lastLogged = o;
            DMLog([NSString stringWithFormat:@"[orientation] resolved %ld (statusBarOrientation raw, device raw %ld, screen %@)", o, (long)[UIDevice currentDevice].orientation, NSStringFromCGSize(screen)]);
        }
    }
    return o;
}
// The width a menu in our menu window must stay inside (layering audit F3: the right-edge clamp was iPadOS 16 only, and on the M1 the SSH/VPN
// menus ran off the screen). iPadOS 16: the host's own width (the rotator has the screen's shape). iPadOS 15: the screen's, because the window
// may still have its old portrait bounds while hidden (it turns itself once shown), see DMMenuHost.
static CGFloat DMMenuHostWidth(UIView *host) {
    if (DMIsExtMenuHost(host)) return host.bounds.size.width;   // (an external display's menu window: that display's width)
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16) return [UIScreen mainScreen].bounds.size.width;
    return host.bounds.size.width;
}
static BOOL DMIsMenuWindowHost(UIView *host) { return host == gMenuRotator || host == gMenuWindow || DMIsExtMenuHost(host); }   // (our menu windows: a menu is kept on the screen)
// Where a menu of width w hangs under its title (`anchor`, in the host's coordinates): its left edge 4 pt in from the title's, kept 6 pt inside the
// screen. In a right-to-left language (the bar mirrored, DMBarRTL) a Mac's menus hang from their title's right edge instead: the right edges line up.
static CGFloat DMMenuOriginX(UIView *fg, UIView *host, CGRect anchor, CGFloat w) {
    BOOL clamp = DMIsMenuWindowHost(host);
    if (DMBarRTL(fg)) {
        CGFloat hostW = clamp ? DMMenuHostWidth(host) : host.bounds.size.width;
        return MAX(6.0, MIN(CGRectGetMaxX(anchor) - 4.0 - w, hostW - w - 6.0));
    }
    CGFloat x = MAX(6.0, anchor.origin.x + 4.0);
    if (clamp) x = MAX(6.0, MIN(x, DMMenuHostWidth(host) - w - 6.0));   // (a title near the right end: the menu stays on the screen, like macOS)
    return x;
}
// The view menus are built in. On iPadOS 15 the menu window turns with the screen (its bounds become 1194 x 834 in landscape) and is used as it is.
// On iPadOS 16 it stays portrait-sized while the scene is turned: its content is shown turned, and positions converted from the screen come out in
// its portrait space, but a menu built in it would be sideways and mostly off the screen. So there menus are built inside a container that has the
// screen's shape and is turned back, which makes its own coordinates the screen's again.
static void DMCreateMenuWindow(void);
static UIView *DMMenuHost(void) {
    // (layering audit F10: menus opened in the first 6 s after a respring, before the scheduled creation, took the old host and could open far
    // from their title on the iPad 2; the window is now made on the first menu instead. The crash-loop guard in DMCreateMenuWindow still applies.)
    if (!gMenuWindow && !DMCtorSkip("menuwin")) DMCreateMenuWindow();
    if (!gMenuWindow) return nil;
    // iPadOS 15: the window turns itself, and while it is hidden its bounds are still the old (portrait) ones, which must not be mistaken for a mismatch.
    // The screen size is still recorded (layering audit F3): a turn to the other shape closes the open menu (DMCloseMenuIfOrientationStale), like on 16.
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16) {
        gMenuBuiltForScreen = [UIScreen mainScreen].bounds.size;
        gMenuRotatorBuiltForOrientation = DMRealInterfaceOrientation();
        return gMenuWindow;
    }
    CGSize screen = [UIScreen mainScreen].bounds.size, win = gMenuWindow.bounds.size;
    BOOL turned = fabs(win.width - screen.width) > 1.0 && fabs(win.width - screen.height) < 1.0 && fabs(win.height - screen.width) < 1.0;
    long orientation = DMRealInterfaceOrientation();
    CGFloat angle = (orientation == 3 || orientation == 4) ? M_PI_2 : M_PI;   // fallback: the old guess (see below)
    {   // How this window's own space really lies on the screen (UIKit knows it). Upside down the window has the screen's shape but is turned 180 deg,
        // which the size test above cannot see: the menu was drawn upside down out of view (verified 2026-09-24, iPad 2, orientation 2).
        id<UICoordinateSpace> scr = [UIScreen mainScreen].coordinateSpace;
        CGPoint o = [gMenuWindow convertPoint:CGPointZero toCoordinateSpace:scr], x = [gMenuWindow convertPoint:CGPointMake(100, 0) toCoordinateSpace:scr];
        CGFloat dx = x.x - o.x, dy = x.y - o.y;
        if (hypot(dx, dy) > 50.0) { angle = -round(atan2(dy, dx) / M_PI_2) * M_PI_2; turned = fabs(angle) > 0.01; }
    }
    gMenuRotatorBuiltForOrientation = orientation;
    gMenuBuiltForScreen = screen;
    if (!turned) {
        if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[menuhost] screen %@ win %@ orientation %ld: window not turned, used as it is", NSStringFromCGSize(screen), NSStringFromCGSize(win), orientation]);
        if (gMenuRotator && !gMenuRotator.subviews.count) [gMenuRotator removeFromSuperview];
        return gMenuWindow;
    }
    if (!gMenuRotator) { gMenuRotator = [UIView new]; gMenuRotator.backgroundColor = [UIColor clearColor]; }
    if (gMenuRotator.superview != gMenuWindow) [gMenuWindow addSubview:gMenuRotator];
    gMenuRotator.transform = CGAffineTransformIdentity;
    gMenuRotator.bounds = CGRectMake(0, 0, screen.width, screen.height);
    // The pivot for the rotation is the window's own true centre, (win.width/2, win.height/2) -- NOT (win.height/2, win.height/2) as an earlier pass
    // here used. That version came from an empirical screenshot check that only confirmed the rotated content was upright and roughly on screen, not
    // that it was pixel-exact: using win.height for BOTH x and y put the pivot's x off by (win.height - win.width) / 2 = (1024 - 768) / 2 = 128pt on
    // this device, verified live via the [menuhost] log below (rotator frame came out {128, 0, 768, 1024} against a 768x1024 window -- 128pt of the
    // rotator, and everything drawn near its edge, was pushed outside the window's own bounds on one side and clipped, which is exactly the top few
    // menu rows the owner reported clipping). The window's bounds ARE reliable for this (unlike its `frame`, per the note above this function): once
    // "turned" is true, win.width/win.height are the two screen dimensions swapped (win.height == screen.width, win.width == screen.height -- that
    // is what "turned" means), so the window's own true centre is exactly where the rotated screen-shaped content needs to sit to end up flush with
    // the window's edges again after the 90-degree turn. Confirmed by the math: with a true centre pivot the rotator's frame comes out {0, 0,
    // win.width, win.height} -- exactly filling the window, on both landscape directions (the frame-size math is the same ±90 degrees either way).
    gMenuRotator.center = CGPointMake(win.width / 2.0, win.height / 2.0);
    // LIVE-CONFIRMED FIX (2026-09-23): this used to be `orientation == 3 ? -M_PI_2 : (orientation == 4 ? M_PI_2 : M_PI)` -- opposite signs for the two
    // landscape directions, on the (reasonable-looking, but wrong for this particular window role) assumption that the OS's own automatic turn of
    // gMenuWindow's content mirrors between them the way it would for an ordinary window. Directly tested both directions with a clean, ground-truth
    // method (force each orientation via SBOrientationLockManager, screenshot, and check whether the SYSTEM's own content -- icons/dock/status bar,
    // nothing this file draws -- needed any correction to look upright, then compare that to how our own menu came out in that same, unprocessed
    // frame): orientation 4 (+M_PI_2) was already correct. Orientation 3 was NOT -- system content was upright with zero correction needed, but our
    // Edit menu came out upside down and in the opposite corner in that same frame, a 180-degree discrepancy from swapping -M_PI_2 for +M_PI_2. This
    // is very likely what the owner actually saw and reported as "the iPad is stuck displaying upside down": not a system-level stuck rotation (confirmed
    // separately via SBOrientationLockManager's own state -- effectivelyLocked was NO, nothing was actually stuck), but our OWN menu rendering upside
    // down for this specific orientation, on a real device that had just rotated into it. Both directions now use the same +M_PI_2; re-verified live
    // after the change (see the coordinator report) with the same forced-orientation, screenshot-based method for both directions before trusting it.
    // The turn is measured, not assumed: UIKit knows how this portrait-sized window's space lies on the screen (verified 2026-09-24 on iPad 2 with
    // the screen really turned from code: window x-axis runs UP the screen in orientation 3, DOWN in 4, right-to-left in 2), and the rotator must
    // undo exactly that. The fixed +90 deg used before was right in 3 but drew menus upside down in the opposite corner in 4 (raw capture).
    gMenuRotator.transform = CGAffineTransformMakeRotation(angle);
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[menuhost] screen %@ win %@ orientation %ld rotator frame %@", NSStringFromCGSize(screen), NSStringFromCGSize(win), orientation, NSStringFromCGRect(gMenuRotator.frame)]);
    return gMenuRotator;
}
// `[view convertRect:rect toView:host]` is unreliable when host is gMenuRotator: gMenuWindow, its superview, is a SBMainScreenActiveInterfaceOrientationWindow
// that stays at its own native (portrait) frame/bounds on iPadOS 16 no matter how the screen is actually turned (see DMMenuHost above), so it does not tell
// UIKit's normal cross-window geometry math -- which trusts every window's frame to be its true place in one shared screen space -- where it really is; a
// button's position converted straight into it comes out wrong (off in the screen by roughly a half turn, verified live: a button near the screen's top
// left converted to something near the opposite corner). The rotator's own local space is deliberately built to equal the screen's (see DMMenuHost's
// comment on it), so going through the button's OWN window instead -- which does track the real rotation, confirmed via its frame matching the live screen
// size -- and using that rect as is amounts to the same thing without that unreliable hop.
//
// iPad 2 bug fix (2026-09-24, "menus float at a random place"): the shortcut above (the button's own window = the screen) only holds for a status bar
// copy whose window turns with the screen (UIStatusBarWindow: Home Screen, windows in front). With a FULL-SCREEN app in front, the copy that takes the
// tap lives in SBMainSwitcherWindow, which stays portrait-sized (768 x 1024) in landscape and turns its content inside: the Go title at screen
// {180, 0, 32, 20} came out as the native rect {748, 180, 20, 32}, so every menu opened ~570 pt right and ~190 pt down, next to the Home button
// (live capture, orientation 3). The title's place on the screen now comes from UIKit's screen coordinate space (which knows how each window lies on
// the screen -- DMMenuHost measures the menu window's turn the same way); the rotator's space IS the screen's, and the unturned menu window's too.
// iPadOS 15 keeps the old path (there the menu window turns itself and convertRect:toView: is right).
static CGRect DMTitleRectOnScreen(UIView *view, CGRect rect) {
    return [view convertRect:rect toCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
}
static CGRect DMConvertToHost(UIView *view, CGRect rect, UIView *host) {
    if (DMIsExtMenuHost(host)) return [view convertRect:rect toView:host];   // (the TV's own menu window and status bar copy: one screen, never turned)
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 16 && gMenuWindow && (host == gMenuRotator || host == gMenuWindow)) {
        CGRect s = DMTitleRectOnScreen(view, rect);
        if (host == gMenuRotator) return s;   // (built to be the screen's own space)
        return [host convertRect:s fromCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
    }
    if (host == gMenuRotator) return [view convertRect:rect toView:view.window];
    return [view convertRect:rect toView:host];
}
// One line per opened menu (debug flag only): where the title and the menu really are on the screen, which status bar copy and host were used, and
// every orientation reading -- the evidence line for menu placement. The menu must hang directly under its title: menu.x == title.x + 4 (or 6 at the
// left edge; in a right-to-left language menu.maxX == title.maxX - 4), menu.y == title.maxY + 2, fully on the screen.
static int gMenuCheckPass = 0, gMenuCheckFail = 0;   // counted by the menucheck trigger
static void DMLogMenuGeometry(NSString *what, UIView *fg, UIButton *btn, UIView *host, UIView *panel) {
    if (!DMTestFlag("/tmp/macstatusbar-debug") || !panel) return;
    if (DMIsExtMenuHost(host)) {   // (a menu on an external display: its own screen, not the iPad's)
        CGRect t = DMConvertToHost(fg, btn.frame, host), m = panel.frame;
        BOOL ok = CGRectContainsRect(CGRectInset(host.bounds, -0.5, -0.5), m) && fabs(m.origin.y - (CGRectGetMaxY(t) + 2.0)) < 1.5;
        DMLog([NSString stringWithFormat:@"[menugeo] %@ %@ on the external display: title %@ menu %@ window %@ scene screen %@", ok ? @"PASS" : @"FAIL", what,
               NSStringFromCGRect(t), NSStringFromCGRect(m), NSStringFromCGRect(host.bounds), NSStringFromCGRect(DMExternalScreenOf(host).bounds)]);
        if (ok) gMenuCheckPass++; else gMenuCheckFail++;
        return;
    }
    id<UICoordinateSpace> scr = [UIScreen mainScreen].coordinateSpace;
    CGRect title = DMTitleRectOnScreen(fg, btn.frame), menu = [panel convertRect:panel.bounds toCoordinateSpace:scr], scrB = [UIScreen mainScreen].bounds;
    CGRect oldAnchor = [fg convertRect:btn.frame toView:fg.window];
    id app = [UIApplication sharedApplication];
    SEL aio = NSSelectorFromString(@"activeInterfaceOrientation");
    long active = [app respondsToSelector:aio] ? ((long (*)(id, SEL))objc_msgSend)(app, aio) : -1;
    long sbo = ((long (*)(id, SEL))objc_msgSend)(app, NSSelectorFromString(@"statusBarOrientation"));
    CGFloat ex = MAX(6.0, MIN(MAX(6.0, title.origin.x + 4.0), scrB.size.width - menu.size.width - 6.0)), ey = CGRectGetMaxY(title) + 2.0;
    if (DMBarRTL(fg)) ex = MAX(6.0, MIN(CGRectGetMaxX(title) - 4.0 - menu.size.width, scrB.size.width - menu.size.width - 6.0));   // (right-to-left: the right edges line up, DMMenuOriginX)
    BOOL ok = fabs(menu.origin.x - ex) < 1.5 && fabs(menu.origin.y - ey) < 1.5 && CGRectContainsRect(CGRectInset(scrB, -0.5, -0.5), menu) && title.origin.y < 40.0;
    DMLog([NSString stringWithFormat:@"[menugeo] %@ %@: title %@ menu %@ expected origin {%.1f, %.1f} screen %@ | copy in %@ (frame %@ bounds %@) host %@ | orientation resolved %ld built %ld active %ld statusBar %ld device %ld | old anchor %@ | fg ty %.1f",
           ok ? @"PASS" : @"FAIL", what, NSStringFromCGRect(title), NSStringFromCGRect(menu), ex, ey, NSStringFromCGSize(scrB.size),
           NSStringFromClass([fg.window class]), NSStringFromCGRect(fg.window.frame), NSStringFromCGSize(fg.window.bounds.size),
           host == gMenuRotator ? @"rotator" : (host == gMenuWindow ? @"menu window" : NSStringFromClass([host class])),
           DMRealInterfaceOrientation(), gMenuRotatorBuiltForOrientation, active, sbo, (long)[UIDevice currentDevice].orientation,
           NSStringFromCGRect(oldAnchor), [fg convertRect:fg.bounds toCoordinateSpace:scr].origin.y]);
    if (ok) gMenuCheckPass++; else gMenuCheckFail++;
}
static void DMCreateMenuWindow(void) {
    if (gMenuWindow) return;
    static BOOL waiting = NO;   // (a creation already waits for the guard to age: the first menu opening meanwhile uses the old host)
    if (waiting) return;
    const char *guardPath = "/tmp/macstatusbar-menuwindow-guard";
    // The guard protects against a crash loop: it exists from the moment the window is made until 10 s later. If SpringBoard restarted in
    // between (a crash, or several quick resprings while testing) it is still there. It used to stay forever, which left menus without
    // their orientation-aware window (menus stuck in portrait, only an edge visible in landscape). Now it only counts while it is recent:
    // an old guard is stale and ignored, and a recent one delays the window until it has aged instead of giving up.
    struct stat st;
    if (stat(guardPath, &st) == 0) {
        double age = difftime(time(NULL), st.st_mtime);
        if (age < 45.0) {
            DMLog([NSString stringWithFormat:@"[menuwindow] the previous start ended %.0f s ago before it finished: waiting a little before making the menu window", age]);
            waiting = YES;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((46.0 - age) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ waiting = NO; DMCreateMenuWindow(); });
            return;
        }
        unlink(guardPath);   // stale
    }
    FILE *g = fopen(guardPath, "w"); if (g) fclose(g);
    @try {
        Class base = objc_getClass("SBMainScreenActiveInterfaceOrientationWindow");
        SEL initRole = NSSelectorFromString(@"initWithRole:debugName:");
        if (!base || ![base instancesRespondToSelector:initRole]) { DMLog(@"[menuwindow] the window class or initializer is missing"); return; }
        Class sub = objc_getClass("MSBMenuWindow");
        if (!sub) {
            sub = objc_allocateClassPair(base, "MSBMenuWindow", 0);
            class_addMethod(sub, @selector(hitTest:withEvent:), (IMP)DMMenuWindowHitTest, "@@:{CGPoint=dd}@");
            objc_registerClassPair(sub);
        }
        UIWindow *w = ((id (*)(id, SEL, id, id))objc_msgSend)([sub alloc], initRole, @"SBFTraitsParticipantRoleRecordingIndicator", @"MacStatusBarMenus"); DMSnapInvalidate();
        w.windowLevel = kMenuWindowLevel;
        w.backgroundColor = [UIColor clearColor];
        w.hidden = YES;   // shown only while a menu is open
        gMenuWindow = w;
        // Shown once right away, then hidden again: SpringBoard gives this window the screen's orientation only once it has been shown. Until then
        // a landscape iPad's first menu after a respring was measured in an unturned window and laid out as in portrait, and only the menus after
        // it were right (GitHub #6, iPad Pro 11" on iPadOS 16.0). Empty, it takes no touches (DMMenuWindowHitTest) and draws nothing.
        if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 16 && !DMTestFlag("/tmp/msb-menuwin-noprime")) {
            w.hidden = NO;
            // (0.3 s, not one turn of the main queue: long enough for SpringBoard to turn it; kept shown only while a menu is in it)
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gMenuWindow == w && !(gOverlay && gOverlay.window == w)) w.hidden = YES; });
        }
        DMLog([NSString stringWithFormat:@"[menuwindow] created %@ frame %@ level %.0f", NSStringFromClass([w class]), NSStringFromCGRect(w.frame), w.windowLevel]);
    } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[menuwindow] exception %@", e]); }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(10 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ unlink(guardPath); DMLog(@"[menuwindow] stable, guard cleared"); });
}

// The external display went away (unplugged, or its scene closed): a menu open there closes, and its menu window is let go. `what` is the screen
// or scene the notification named (nil: only windows whose scene is already gone).
static void DMRemoveOverlayNow(void);
static void DMExtMenuDisplayGone(id what, NSString *why) {
    if (!gExtMenuWindows.count) return;
    NSMutableArray *gone = [NSMutableArray array];
    for (UIWindow *w in gExtMenuWindows) {
        UIWindowScene *sc = nil; UIScreen *scr = nil;
        @try { sc = w.windowScene; scr = sc.screen; } @catch (id e) {}
        if (!sc || !scr || (what && (what == sc || what == scr))) [gone addObject:w];
    }
    if (!gone.count) return;
    UIView *o = gOverlay;
    for (UIWindow *w in gone) if (o && o.window == w) { DMLog(@"[extmenu] the menu's display went away: menu closed"); DMRemoveOverlayNow(); break; }
    for (UIWindow *w in gone) { w.hidden = YES; [gExtMenuWindows removeObjectIdenticalTo:w]; }
    DMSnapInvalidate();
    DMLog([NSString stringWithFormat:@"[extmenu] %lu external menu window(s) released (%@)", (unsigned long)gone.count, why]);
}
// The menu window for the external display a status bar copy is on; nil for the iPad's own screen (and always on iPadOS 15).
static UIWindow *DMExtMenuWindowFor(UIView *fg) {
    if (!DMExternalScreenOf(fg)) return nil;
    UIWindowScene *scene = fg.window.windowScene;
    if (![scene isKindOfClass:[UIWindowScene class]]) return nil;
    if (!gExtMenuWindows) {
        gExtMenuWindows = [NSMutableArray array];
        // (registered only once an external display's menu was used: without one nothing is observed)
        for (NSString *n in @[UIScreenDidDisconnectNotification, UISceneDidDisconnectNotification])
            [[NSNotificationCenter defaultCenter] addObserverForName:n object:nil queue:[NSOperationQueue mainQueue] usingBlock:^(NSNotification *note) {
                id what = note.object; NSString *why = note.name;
                DMExtMenuDisplayGone(what, why);
                dispatch_async(dispatch_get_main_queue(), ^{ DMExtMenuDisplayGone(nil, why); });   // (again once UIKit has let the scene go)
            }];
    }
    DMExtMenuDisplayGone(nil, @"checked before a menu");
    for (UIWindow *w in gExtMenuWindows) if (w.windowScene == scene) return w;
    UIWindow *w = nil;
    @try {
        Class sub = objc_getClass("MSBExtMenuWindow");
        if (!sub) {
            sub = objc_allocateClassPair([UIWindow class], "MSBExtMenuWindow", 0);
            if (!sub) return nil;
            class_addMethod(sub, @selector(hitTest:withEvent:), (IMP)DMMenuWindowHitTest, "@@:{CGPoint=dd}@");
            objc_registerClassPair(sub);
        }
        w = [(UIWindow *)[sub alloc] initWithWindowScene:scene];
        w.windowLevel = kMenuWindowLevel;
        w.backgroundColor = [UIColor clearColor];
        w.hidden = YES;
    } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[extmenu] exception %@", e]); return nil; }
    if (!w) return nil;
    [gExtMenuWindows addObject:w];
    DMSnapInvalidate();
    DMLog([NSString stringWithFormat:@"[extmenu] menu window made for the external display (scene %@, screen %@, window %@)", NSStringFromClass([scene class]), NSStringFromCGRect(scene.screen.bounds), NSStringFromCGRect(w.bounds)]);
    return w;
}
static UIView *DMHostFor(UIView *fg) {
    {   // a status bar copy on an external display: the menu opens on that display (see DMExternalScreenOf)
        UIWindow *ext = DMExtMenuWindowFor(fg);
        if (ext) { gMenuRotatorBuiltForOrientation = 0; return ext; }   // (the iPad turning does not move a menu on the TV: no orientation close)
    }
    if (!gMenuWindow && !DMCtorSkip("menuwin")) DMCreateMenuWindow();   // (made on the first menu if it is not there yet, see DMMenuHost)
    if (gMenuWindow) return DMMenuHost();
    UIView *host = fg.superview.superview.superview;   // fg > _UIStatusBar > UIStatusBar_Modern > host
    // Inside an app the bar copy lives in an app-level window, under MilkyWay's windows. When there are windows, the menu goes into the
    // real status bar window instead (level 999, upright): above the app AND the windows, so the windows can stay where they are.
    UIWindow *bar = DMStatusBarWindow();
    if (bar && fg.window != bar && DMMilkyWayWindowCount() > 0) return bar;
    return host ?: fg.window;
}

// A windowed app's keyboard (Aerial's AerialKeyboardWindow, level 1052) is above our menu window (1040), so the lower rows of a long menu went under
// it (layering audit F11). While a menu is open that keyboard window steps down to just under the menu window (still above the windows, 1033) and
// goes back to its own level when the menu goes. Our menu window is never raised: it must stay under the Cover Sheet (1050). Checked when a menu
// opens or closes and on every tick (Aerial may set its level again). Zetsu's keyboard (1003) is under the menus already.
static __weak UIWindow *gKbLowered = nil;
static CGFloat gKbLoweredFrom = 0;
static void DMMenuKeyboardOrder(void) {
    UIWindow *kb = nil;
    if (gOverlay && gMenuWindow && !gMenuWindow.hidden) {
        for (UIWindow *w in DMAllWindows())
            if (!w.hidden && w.alpha > 0.01 && (w == gKbLowered || w.windowLevel > kMenuWindowLevel) && [NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) { kb = w; break; }
    }
    UIWindow *was = gKbLowered;
    if (was && was != kb) {
        if (was.windowLevel < kMenuWindowLevel) was.windowLevel = gKbLoweredFrom;
        gKbLowered = nil;
        DMLog([NSString stringWithFormat:@"[overlay] windowed app's keyboard back to level %.0f", gKbLoweredFrom]);
    }
    if (!kb) return;
    if (kb != was) { gKbLoweredFrom = kb.windowLevel; gKbLowered = kb; DMLog([NSString stringWithFormat:@"[overlay] a menu is open: windowed app's keyboard from level %.0f to under the menu", gKbLoweredFrom]); }
    if (kb.windowLevel != kMenuWindowLevel - 1.0) kb.windowLevel = kMenuWindowLevel - 1.0;
}
static void DMTodayGiveBack(NSString *why);
static void DMRemoveOverlayNow(void) {
    DMTodayGiveBack(@"another menu or dialog");
    DMWiFiMenuGone(@"removed");   // (the Wi-Fi menu's scan stops with it)
    UIView *o = gOverlay;
    if (o) DMLog(@"[overlay] removed immediately");
#if DEBUG
    if (o && DMTestFlag("/tmp/msb-grwatch")) { NSArray<NSNumber *> *ret = [NSThread callStackReturnAddresses]; for (NSUInteger i = 1; i < ret.count && i < 8; i++) DMSymbolize(ret[i].unsignedLongLongValue); }
#endif
    gOverlay = nil;
    gPill.hidden = YES;
    [o removeFromSuperview];
    if (gMenuWindow) gMenuWindow.hidden = YES;
    DMHideExtMenuWindows();
    DMApplyWindowLevel();
    DMMenuKeyboardOrder();
}

static void DMCloseOverlay(void) {
    DMTodayGiveBack(@"closed");
    DMWiFiMenuGone(@"closed");   // (the Wi-Fi menu's scan stops with it; also the screen going off, DMCloseOverlaysForScreenOff)
    UIView *o = gOverlay;
    DMLog([NSString stringWithFormat:@"[overlay] close requested (overlay %@)", o ? @"present" : @"already gone"]);
    gOverlay = nil;
    gPill.hidden = YES;
    if (!o) return;
    o.userInteractionEnabled = NO;   // stop intercepting touches immediately
    [UIView animateWithDuration:0.12 animations:^{ o.alpha = 0.0; }
                     completion:^(BOOL finished) { [o removeFromSuperview]; if (!gOverlay && gMenuWindow) gMenuWindow.hidden = YES; if (!gOverlay) DMHideExtMenuWindows(); DMApplyWindowLevel(); }];
    DMMenuKeyboardOrder();   // (a windowed app's keyboard lowered under the menu goes back up at once)
}
// The screen went off: every menu, panel or question goes, as it would a moment later on the Lock Screen (the tick's rule; the Fit question applies
// the default arrangement, as for any other close). Before, they stayed until the next wake and a quick Face ID unlock could show them for ~0.5 s.
static void DMCloseOverlaysForScreenOff(void) {
    if (!gOverlay || DMTestFlag("/tmp/msb-overlay-keep")) return;
    DMLog(@"[overlay] the screen went off while a menu or question was open: closed");
    DMCloseOverlay();
}

// The appearance the user chose in Settings > Display & Brightness. SpringBoard's own windows (the status bar
// window included) can be held dark, so menus that simply inherit from them would ignore a switch to Light Mode.
// The main screen's trait is the system-wide setting. (gDebugStyle lets a test force light or dark.)
static int gDebugStyle = 0;   // 0 = follow the system, 1 = force light, 2 = force dark
static UIUserInterfaceStyle DMSystemInterfaceStyle(void) {
    if (gDebugStyle == 1) return UIUserInterfaceStyleLight;
    if (gDebugStyle == 2) return UIUserInterfaceStyleDark;
    UIUserInterfaceStyle s = [UIScreen mainScreen].traitCollection.userInterfaceStyle;
    return s == UIUserInterfaceStyleUnspecified ? UIUserInterfaceStyleLight : s;
}

// Full-window control that catches every touch while something is showing.
static UIControl *DMMakeOverlay(UIView *host, CGFloat dimAlpha) {
    DMRemoveOverlayNow();
    UIControl *o = [[UIControl alloc] initWithFrame:host.bounds];
    o.overrideUserInterfaceStyle = DMSystemInterfaceStyle();   // every menu and dialog follows the system appearance
    o.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    o.backgroundColor = [UIColor colorWithWhite:0.0 alpha:dimAlpha];
    if (host == gMenuWindow || host == gMenuRotator) {
        gMenuWindow.hidden = NO;
        // Inside an app, which process a tap goes to is decided by the render server from what is VISIBLE under the finger, and a fully
        // transparent layer counts as nothing (the tap went straight to the app). Give the catch-all a barely visible tint and flag its layers
        // as opaque for hit testing.
        if (dimAlpha < 0.02) o.backgroundColor = [UIColor colorWithWhite:0.0 alpha:0.02];
        SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
        static BOOL loggedOpaque = NO;
        if (!loggedOpaque) { loggedOpaque = YES; DMLog([NSString stringWithFormat:@"[menuwindow] CALayer setHitTestsAsOpaque: available %d, overlay tint alpha %.2f", [o.layer respondsToSelector:opaque], CGColorGetAlpha(o.backgroundColor.CGColor)]); }
        for (CALayer *layer in @[o.layer, gMenuWindow.layer]) if ([layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(layer, opaque, YES);
    } else if (DMIsExtMenuHost(host)) {   // an external display's menu window: shown, and its catch-all made to take touches the same way
        host.hidden = NO;
        if (dimAlpha < 0.02) o.backgroundColor = [UIColor colorWithWhite:0.0 alpha:0.02];
        SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
        for (CALayer *layer in @[o.layer, host.layer]) if ([layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(layer, opaque, YES);
    }
    [host addSubview:o];
    // iPadOS 15: the menu window turns itself, but while hidden it keeps its old shape, and the catch-all made from it then covered only the old
    // (portrait) area: touches right of x 834 in landscape went through to the windows below (seen with the Today View panel under the clock).
    if (host == gMenuWindow && [NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16) o.frame = [UIScreen mainScreen].bounds;
    gOverlay = o;
    DMApplyWindowLevel();   // MilkyWay's windows drop below the menu's window (not needed for the menu window itself: it is above them)
    DMMenuKeyboardOrder();   // (a windowed app's keyboard steps under the menu while it is open)
    return o;
}

static UIVisualEffectView *DMMakeBlur(CGFloat radius) {
    UIVisualEffectView *v = [[UIVisualEffectView alloc] initWithEffect:
        [UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
    v.layer.cornerRadius = radius;
    v.layer.cornerCurve = kCACornerCurveContinuous;
    v.clipsToBounds = YES;
    v.layer.borderWidth = 0.5;
    v.layer.borderColor = [[UIColor colorWithWhite:1.0 alpha:0.18] CGColor];
    return v;
}

// Divider lines between menu groups: 1 pt and clearly visible (the system separator colour is too faint on the
// blurred panel). A dynamic colour, so it follows the light/dark style the panel is shown in.
static const CGFloat kDividerH = 1.0;
static UIColor *DMMenuDividerColor(void) {
    return [UIColor colorWithDynamicProvider:^UIColor *(UITraitCollection *tc) {
        return tc.userInterfaceStyle == UIUserInterfaceStyleDark ? [UIColor colorWithWhite:1.0 alpha:0.28]
                                                                 : [UIColor colorWithWhite:0.0 alpha:0.22];
    }];
}

// items: DMRow or DMSliderRow objects, or [NSNull null] for a separator line.
static CGFloat DMPanelItemHeight(id it) {
    if (it == [NSNull null]) return kSepH;
    if ([it isKindOfClass:[DMSliderRow class]]) return kSliderRowH;
    { SEL h = NSSelectorFromString(@"dmRowHeight"); if ([it respondsToSelector:h]) return ((CGFloat (*)(id, SEL))objc_msgSend)(it, h); }   // (a row with a height of its own: the Wi-Fi menu's heading and switch rows)
    return kRowH;
}
// Our menus are English and keep their left-to-right layout in a right-to-left language too (only where they hang is mirrored, DMMenuOriginX): every
// view of a menu is set to left-to-right, so a row's title stays left-aligned and an Audio row's slider runs from the left (a right-to-left app
// aligns natural text right and turns sliders round). semanticContentAttribute is not inherited, so it is set on each view.
static void DMForceLeftToRight(UIView *v, int depth) {
    if (!v || depth > 8) return;
    v.semanticContentAttribute = UISemanticContentAttributeForceLeftToRight;
    for (UIView *s in v.subviews) DMForceLeftToRight(s, depth + 1);
}
static UIView *DMMakePanel(NSArray *items) {
    CGFloat h = kPanelPad * 2.0;
    for (id it in items) h += DMPanelItemHeight(it);

    UIView *host = [[UIView alloc] initWithFrame:CGRectMake(0, 0, kPanelW, h)];
    host.layer.shadowColor = [[UIColor blackColor] CGColor];
    host.layer.shadowOpacity = 0.35;
    host.layer.shadowRadius = 16.0;
    host.layer.shadowOffset = CGSizeMake(0, 8);

    UIVisualEffectView *blur = DMMakeBlur(10.0);
    blur.frame = host.bounds;
    [host addSubview:blur];

    CGFloat y = kPanelPad;
    for (id it in items) {
        CGFloat rh = DMPanelItemHeight(it);
        if (it == [NSNull null]) {
            UIView *line = [[UIView alloc] initWithFrame:CGRectMake(12.0, y + (kSepH - kDividerH) / 2.0, kPanelW - 24.0, kDividerH)];
            line.backgroundColor = DMMenuDividerColor();
            [blur.contentView addSubview:line];
        } else {
            UIView *row = it;
            row.frame = CGRectMake(0, y, kPanelW, rh);
            [blur.contentView addSubview:row];
        }
        y += rh;
    }
    if ([UIApplication sharedApplication].userInterfaceLayoutDirection == UIUserInterfaceLayoutDirectionRightToLeft) DMForceLeftToRight(host, 0);
    return host;
}

static UIButton *DMDialogButton(NSString *title, BOOL bold, UIColor *color, CGRect frame, dispatch_block_t action) {
    UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
    b.frame = frame;
    [b setTitle:title forState:UIControlStateNormal];
    b.titleLabel.font = [UIFont systemFontOfSize:17.0 weight:bold ? UIFontWeightSemibold : UIFontWeightRegular];
    [b setTitleColor:color forState:UIControlStateNormal];
    [b addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { action(); }]
        forControlEvents:UIControlEventTouchUpInside];
    return b;
}

static void DMShowConfirm(UIView *host, NSString *title, NSString *message,
                          NSString *confirmTitle, BOOL destructive, dispatch_block_t confirm) {
    UIControl *o = DMMakeOverlay(host, 0.30);   // dim; tapping outside does nothing on purpose

    const CGFloat W = 280.0, pad = 20.0, buttonH = 46.0;
    UILabel *t = [UILabel new];
    t.text = title;
    t.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightSemibold];
    t.textColor = [UIColor labelColor];
    t.textAlignment = NSTextAlignmentCenter;
    t.numberOfLines = 0;
    UILabel *m = [UILabel new];
    m.text = message;
    m.font = [UIFont systemFontOfSize:13.0];
    m.textColor = [UIColor secondaryLabelColor];
    m.textAlignment = NSTextAlignmentCenter;
    m.numberOfLines = 0;

    CGSize ts = [t sizeThatFits:CGSizeMake(W - 2 * pad, CGFLOAT_MAX)];
    CGSize ms = [m sizeThatFits:CGSizeMake(W - 2 * pad, CGFLOAT_MAX)];
    CGFloat y = 20.0;
    t.frame = CGRectMake(pad, y, W - 2 * pad, ts.height);   y += ts.height + 6.0;
    m.frame = CGRectMake(pad, y, W - 2 * pad, ms.height);   y += ms.height + 20.0;
    CGFloat H = y + buttonH;

    UIVisualEffectView *box = DMMakeBlur(14.0);
    box.frame = CGRectMake(0, 0, W, H);
    box.center = CGPointMake(CGRectGetMidX(o.bounds), CGRectGetMidY(o.bounds));
    box.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleRightMargin |
                           UIViewAutoresizingFlexibleTopMargin  | UIViewAutoresizingFlexibleBottomMargin;
    [box.contentView addSubview:t];
    [box.contentView addSubview:m];

    UIView *hLine = [[UIView alloc] initWithFrame:CGRectMake(0, y, W, 0.5)];
    hLine.backgroundColor = [UIColor separatorColor];
    UIView *vLine = [[UIView alloc] initWithFrame:CGRectMake(W / 2.0, y, 0.5, buttonH)];
    vLine.backgroundColor = [UIColor separatorColor];
    [box.contentView addSubview:hLine];
    [box.contentView addSubview:vLine];

    UIColor *confirmColor = destructive ? [UIColor systemRedColor] : [UIColor systemBlueColor];
    [box.contentView addSubview:DMDialogButton(@"Cancel", NO, [UIColor systemBlueColor],
        CGRectMake(0, y, W / 2.0, buttonH), ^{ DMCloseOverlay(); })];
    [box.contentView addSubview:DMDialogButton(confirmTitle, YES, confirmColor,
        CGRectMake(W / 2.0, y, W / 2.0, buttonH), ^{
            DMCloseOverlay();
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)),
                           dispatch_get_main_queue(), confirm);
        })];

    [o addSubview:box];
    box.alpha = 0.0;
    [UIView animateWithDuration:0.12 animations:^{ box.alpha = 1.0; }];
    DMLog([NSString stringWithFormat:@"[dialog] shown \"%@\"", title]);
}


// ===== Force Quit Applications panel =======================================
#import <objc/message.h>


// Apps you can actually launch have an icon on the Home Screen; background services that
// SpringBoard also lists as "running applications" (Safari view service, Spotlight, iTunes UI
// service, Screenshots, InCallService) do not.
static BOOL DMHasHomeScreenIcon(NSString *bundleID) {
    id model = DMCall(DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager"), @"iconModel");
    if (!model) return NO;
    for (NSString *name in @[@"applicationIconForBundleIdentifier:", @"expectedIconForDisplayIdentifier:"]) {
        SEL sel = NSSelectorFromString(name);
        if ([model respondsToSelector:sel]) return ((id (*)(id, SEL, id))objc_msgSend)(model, sel, bundleID) != nil;
    }
    return NO;
}

static BOOL DMLooksLikeService(NSString *bundleID) {
    return [bundleID hasSuffix:@"Service"] || [bundleID hasSuffix:@"ViewService"] ||
           [bundleID hasSuffix:@"UIService"] || [bundleID hasSuffix:@"ServicesService"] ||
           [bundleID isEqualToString:@"com.apple.Spotlight"];
}

static NSSet<NSString *> *DMFinderHiddenApps(void);   // (Finder.h: the apps hidden with AppHider)
static NSArray *DMUserRunningApps(void) {
    id controller = DMCall(objc_getClass("SBApplicationController"), @"sharedInstance");
    NSSet *hidden = DMFinderHiddenApps();   // (1.3.3, audit L-24: an app hidden with AppHider is not named in Force Quit Apps, as Finder already does)
    NSArray *running = DMCall(controller, @"runningApplications") ?: @[];
    BOOL iconLookupWorks = DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager") != nil;

    NSMutableArray *keep = [NSMutableArray array];
    NSMutableArray *dropped = [NSMutableArray array];
    for (SBApplication *app in running) {
        NSString *bid = [app bundleIdentifier];
        if (!bid) continue;
        BOOL visible = (iconLookupWorks ? DMHasHomeScreenIcon(bid) : !DMLooksLikeService(bid)) && ![hidden containsObject:bid];
        [(visible ? keep : dropped) addObject:app];
    }
    [keep sortUsingComparator:^NSComparisonResult(SBApplication *a, SBApplication *b) {
        return [[a displayName] localizedCaseInsensitiveCompare:[b displayName]];
    }];
    NSMutableArray *k = [NSMutableArray array], *d = [NSMutableArray array];
    NSUInteger hiddenN = 0;
    for (SBApplication *a in keep) [k addObject:[a bundleIdentifier]];
    for (SBApplication *a in dropped) { if ([hidden containsObject:[a bundleIdentifier]]) hiddenN++; else [d addObject:[a bundleIdentifier]]; }   // (hidden apps are not named, even in the debug log)
    DMLog([NSString stringWithFormat:@"[fqlist] %@ | filtered out (no Home Screen icon): %@ | hidden with AppHider: %lu | icon lookup %@",
           [k componentsJoinedByString:@", "], [d componentsJoinedByString:@", "], (unsigned long)hiddenN,
           iconLookupWorks ? @"used" : @"UNAVAILABLE, used name fallback"]);
    return keep;
}

static UIImage *DMAppIcon(NSString *bundleID) {
    SEL sel = NSSelectorFromString(@"_applicationIconImageForBundleIdentifier:format:scale:");
    if (![UIImage respondsToSelector:sel]) return nil;
    return ((UIImage *(*)(id, SEL, NSString *, int, CGFloat))objc_msgSend)(
        [UIImage class], sel, bundleID, 2, [UIScreen mainScreen].scale);
}

// Force quits every open app (the same list the Force Quit Apps panel shows), one after the other.
static void DMCleanStaleSwitcherCardsSoon(void);   // defined below
static void DMForceQuitAll(void) {
    NSArray *apps = DMUserRunningApps();
    DMLog([NSString stringWithFormat:@"[action] force quit all: %lu apps", (unsigned long)apps.count]);
    for (SBApplication *app in apps) DMForceQuit(app);
    DMCleanStaleSwitcherCardsSoon();
}

static const CGFloat kListW = 340.0, kListRowH = 48.0, kListHeaderH = 50.0, kListFooterH = 46.0;
static const NSUInteger kListMaxRows = 7;

@interface DMAppRow : UIView
@property (nonatomic, strong) SBApplication *app;
@property (nonatomic, strong) UIImageView *iconView;
@property (nonatomic, strong) UILabel *nameLabel;
@property (nonatomic, strong) UIButton *quitButton;
@property (nonatomic, strong) UIView *line;
@end

@implementation DMAppRow
- (void)layoutSubviews {
    [super layoutSubviews];
    CGFloat w = self.bounds.size.width, h = self.bounds.size.height;
    self.iconView.frame = CGRectMake(16.0, (h - 30.0) / 2.0, 30.0, 30.0);
    CGFloat btnW = 92.0;
    self.quitButton.frame = CGRectMake(w - 16.0 - btnW, (h - 28.0) / 2.0, btnW, 28.0);
    self.nameLabel.frame = CGRectMake(58.0, 0, w - 58.0 - btnW - 24.0, h);
    self.line.frame = CGRectMake(16.0, h - 0.5, w - 16.0, 0.5);
}
@end

@interface DMForceQuitPanel : UIVisualEffectView
@property (nonatomic, strong) NSMutableArray<DMAppRow *> *rows;
@property (nonatomic, strong) UIScrollView *scroll;
@property (nonatomic, strong) UILabel *titleLabel;
@property (nonatomic, strong) UILabel *emptyLabel;
@property (nonatomic, strong) UIView *headerLine;
@property (nonatomic, strong) UIView *footerLine;
@property (nonatomic, strong) UIButton *doneButton;
- (instancetype)initWithApps:(NSArray *)apps onDone:(dispatch_block_t)onDone;
- (void)relayout;
@end

@implementation DMForceQuitPanel
- (instancetype)initWithApps:(NSArray *)apps onDone:(dispatch_block_t)onDone {
    self = [super initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
    if (!self) return nil;
    self.layer.cornerRadius = 14.0;
    self.layer.cornerCurve = kCACornerCurveContinuous;
    self.clipsToBounds = YES;
    self.layer.borderWidth = 0.5;
    self.layer.borderColor = [[UIColor colorWithWhite:1.0 alpha:0.18] CGColor];
    _rows = [NSMutableArray array];
    UIView *content = self.contentView;

    _titleLabel = [UILabel new];
    _titleLabel.text = @"Force Quit Applications";
    _titleLabel.font = [UIFont systemFontOfSize:16.0 weight:UIFontWeightSemibold];
    _titleLabel.textColor = [UIColor labelColor];
    _titleLabel.textAlignment = NSTextAlignmentCenter;
    [content addSubview:_titleLabel];

    _headerLine = [UIView new];
    _headerLine.backgroundColor = [UIColor separatorColor];
    [content addSubview:_headerLine];

    _scroll = [UIScrollView new];
    _scroll.showsVerticalScrollIndicator = YES;
    [content addSubview:_scroll];

    _emptyLabel = [UILabel new];
    _emptyLabel.text = @"No running apps";
    _emptyLabel.font = [UIFont systemFontOfSize:14.0];
    _emptyLabel.textColor = [UIColor secondaryLabelColor];
    _emptyLabel.textAlignment = NSTextAlignmentCenter;
    [content addSubview:_emptyLabel];

    _footerLine = [UIView new];
    _footerLine.backgroundColor = [UIColor separatorColor];
    [content addSubview:_footerLine];

    _doneButton = [UIButton buttonWithType:UIButtonTypeSystem];
    [_doneButton setTitle:@"Done" forState:UIControlStateNormal];
    _doneButton.titleLabel.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightSemibold];
    [_doneButton addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { onDone(); }]
          forControlEvents:UIControlEventTouchUpInside];
    [content addSubview:_doneButton];

    for (SBApplication *app in apps) [self addRowForApp:app];
    [self relayout];
    return self;
}

- (void)addRowForApp:(SBApplication *)app {
    DMAppRow *row = [DMAppRow new];
    row.app = app;
    NSString *bid = [app bundleIdentifier];

    row.iconView = [UIImageView new];
    row.iconView.accessibilityIgnoresInvertColors = YES;   // (Smart Invert leaves pictures as they are, like Apple's own icons: 1.3.3, audit L-3)
    row.iconView.image = DMAppIcon(bid);
    row.iconView.backgroundColor = row.iconView.image ? nil : [UIColor tertiarySystemFillColor];
    row.iconView.layer.cornerRadius = 30.0 * 0.225;
    row.iconView.layer.cornerCurve = kCACornerCurveContinuous;
    row.iconView.clipsToBounds = YES;
    if (!row.iconView.image) DMLog([NSString stringWithFormat:@"[fqlist] no icon image for %@", bid]);
    [row addSubview:row.iconView];

    row.nameLabel = [UILabel new];
    row.nameLabel.text = [app displayName] ?: bid;
    row.nameLabel.font = [UIFont systemFontOfSize:15.0];
    row.nameLabel.textColor = [UIColor labelColor];
    [row addSubview:row.nameLabel];

    row.quitButton = [UIButton buttonWithType:UIButtonTypeSystem];
    [row.quitButton setTitle:@"Force Quit" forState:UIControlStateNormal];
    row.quitButton.titleLabel.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold];
    [row.quitButton setTitleColor:[UIColor systemRedColor] forState:UIControlStateNormal];
    row.quitButton.backgroundColor = [[UIColor systemRedColor] colorWithAlphaComponent:0.16];
    row.quitButton.layer.cornerRadius = 7.0;
    __weak DMForceQuitPanel *weakSelf = self;
    __weak DMAppRow *weakRow = row;
    [row.quitButton addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) {
        [weakSelf quitRow:weakRow];
    }] forControlEvents:UIControlEventTouchUpInside];
    [row addSubview:row.quitButton];

    row.line = [UIView new];
    row.line.backgroundColor = [UIColor separatorColor];
    [row addSubview:row.line];

    [self.scroll addSubview:row];
    [self.rows addObject:row];
}

- (void)quitRow:(DMAppRow *)row {
    if (!row || !row.quitButton.enabled) return;
    DMLog([NSString stringWithFormat:@"[fqlist] force quit tapped for %@", [row.app bundleIdentifier]]);
    row.quitButton.enabled = NO;
    [row.quitButton setTitle:@"Quitting…" forState:UIControlStateNormal];
    DMForceQuit(row.app);
    __weak DMForceQuitPanel *weakSelf = self;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.45 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        [weakSelf removeRow:row];
    });
}

- (void)removeRow:(DMAppRow *)row {
    [UIView animateWithDuration:0.18 animations:^{ row.alpha = 0.0; } completion:^(BOOL f) {
        [row removeFromSuperview];
        [self.rows removeObject:row];
        [UIView animateWithDuration:0.2 animations:^{ [self relayout]; }];
    }];
}

// Sizes the panel to its rows (up to kListMaxRows, then it scrolls) around its current centre.
- (void)relayout {
    NSUInteger n = self.rows.count;
    CGFloat listH = n == 0 ? 60.0 : MIN(n, kListMaxRows) * kListRowH;
    CGFloat totalH = kListHeaderH + listH + kListFooterH;
    CGPoint c = self.center;
    self.bounds = CGRectMake(0, 0, kListW, totalH);
    self.center = c;

    self.titleLabel.frame = CGRectMake(0, 0, kListW, kListHeaderH);
    self.headerLine.frame = CGRectMake(0, kListHeaderH, kListW, 0.5);
    self.scroll.frame = CGRectMake(0, kListHeaderH, kListW, listH);
    self.scroll.contentSize = CGSizeMake(kListW, n * kListRowH);
    for (NSUInteger i = 0; i < n; i++) self.rows[i].frame = CGRectMake(0, i * kListRowH, kListW, kListRowH);
    self.emptyLabel.frame = CGRectMake(0, kListHeaderH, kListW, listH);
    self.emptyLabel.hidden = n != 0;
    self.footerLine.frame = CGRectMake(0, kListHeaderH + listH, kListW, 0.5);
    self.doneButton.frame = CGRectMake(0, kListHeaderH + listH, kListW, kListFooterH);
}
@end

static void DMShowForceQuitList(UIView *host) {
    NSArray *apps = DMUserRunningApps();
    UIControl *o = DMMakeOverlay(host, 0.30);
    // Tapping outside the panel just closes it (nothing destructive happens until "Force Quit").
    [o addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMCloseOverlay(); }]
        forControlEvents:UIControlEventTouchUpInside];

    DMForceQuitPanel *panel = [[DMForceQuitPanel alloc] initWithApps:apps onDone:^{ DMCloseOverlay(); }];
    panel.center = CGPointMake(CGRectGetMidX(o.bounds), CGRectGetMidY(o.bounds));
    panel.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleRightMargin |
                             UIViewAutoresizingFlexibleTopMargin  | UIViewAutoresizingFlexibleBottomMargin;
    [o addSubview:panel];
    panel.alpha = 0.0;
    [UIView animateWithDuration:0.12 animations:^{ panel.alpha = 1.0; }];
}


// ===== App Switcher stale-card cleanup ======================================
// The switcher keeps its own list of "app layouts" (SBMainSwitcherViewController.recentAppLayouts,
// backed on disk by SBRecentAppLayoutsPersister) -- a separate, persisted record of switcher cards,
// not a live view of which apps are actually running. Confirmed read-only via methsearch_/classearch_:
// our own DMForceQuitBundle already has to manually call -_deleteAppLayoutsMatchingBundleIdentifier:
// after killing a process, precisely because nothing does that automatically for every quit path (Apple's
// own "swipe the card away" and a normal app-initiated exit route through -_applicationDidExit: /
// -_removeAppLayout:forReason:, which our BKSTerminateApplicationForReasonAndReportWithDescription call
// does not trigger the same way) -- and the owner's report ("Force Quit All" leaving stragglers, dead cards
// after apps are already gone) matches a switcher card whose process died without that path running.
// This periodically reconciles the switcher's own card list against SBApplicationController's live
// -runningApplications (the same ground truth DMUserRunningApps() already trusts) and deletes any card
// whose bundle ID is not actually running, via the exact same already-shipped, already-safe call our
// own force-quit path uses. No alloc/init of anything: SBMainSwitcherViewController's sharedInstance is
// a singleton the OS already owns, and every other object read here (app layouts, display items) comes
// from walking its own live, already-created object graph -- read-only until the one delete call.
static NSSet<NSString *> *DMLiveRunningBundleIDs(void) {
    id controller = DMCall(objc_getClass("SBApplicationController"), @"sharedInstance");
    NSArray *running = DMCall(controller, @"runningApplications") ?: @[];
    NSMutableSet *set = [NSMutableSet setWithCapacity:running.count];
    for (SBApplication *app in running) {
        NSString *bid = [app bundleIdentifier];
        if (bid) [set addObject:bid];
    }
    return set;
}

// Every bundle identifier the switcher currently shows a card for, read straight off its own
// recentAppLayouts -> allItems (SBDisplayItem, which carries -bundleIdentifier directly).
// Takes the controller instance as a parameter rather than fetching `sharedInstance` itself --
// see the crash note on DMCleanStaleSwitcherCards below for why that distinction is load-bearing.
static NSSet<NSString *> *DMSwitcherBundleIDs(id sw) {
    NSArray *layouts = DMCall(sw, @"recentAppLayouts") ?: @[];
    NSMutableSet *set = [NSMutableSet set];
    for (id layout in layouts) {
        NSArray *items = DMCall(layout, @"allItems") ?: @[];
        for (id item in items) {
            NSString *bid = DMCall(item, @"bundleIdentifier");
            if (bid) [set addObject:bid];
        }
    }
    return set;
}

// CRASH FIX (2026-09-23, found the hard way -- SpringBoard crashed into Safe Mode on the very first
// respring after this shipped): this used to call `sharedInstance` itself instead of taking `sw` as a
// parameter. `+[SBMainSwitcherViewController sharedInstance]` is a `dispatch_once`-guarded singleton;
// its FIRST-EVER call (which happened right here, at respring, when something asks for the switcher for
// the first time this boot) runs `-_init`, which constructs the switcher's own `SBWindow` and root view
// controller -- and THAT synchronously drives `-viewWillAppear:` on the very instance being constructed,
// before the outer `dispatch_once` block has returned. Our `%hook -viewWillAppear:` then called
// `DMCleanStaleSwitcherCards`, which called `sharedInstance` AGAIN from inside that same call stack --
// blocking on the SAME `dispatch_once` that the current thread itself needed to finish first: a
// self-deadlock (crash log: `EXC_BREAKPOINT` in `_dispatch_once_wait`, directly under
// `+[SBMainSwitcherViewController sharedInstance]` under `DMCall`/`DMCleanStaleSwitcherCards` under our
// hook under `-[SBMainSwitcherViewController _init]`). Fix: the hook already has the right, fully-valid
// instance as `self` -- pass it straight through instead of re-deriving it via `sharedInstance`, so the
// hook path never calls that selector at all. The timer/force-quit-all paths below still fetch
// `sharedInstance` themselves, safely, since they always run later, well outside the `_init` call stack.
// CRASH/REGRESSION FIX (2026-09-23, found from the owner's report: "Safari app launch in full screen is crashing"):
// the very first version of this deleted a card the INSTANT it was shown-but-not-yet-running, with no grace period.
// But there IS a real, ordinary gap between a fresh launch's switcher card appearing and
// SBApplicationController.runningApplications actually listing the new process -- app launch is multi-step and async
// (process spawn, scene creation, then finally showing up as "running" in this specific bookkeeping sense). This hook
// runs on -viewWillAppear:, which (confirmed live in the log) fires far more often than just "the user opened the
// switcher" -- several times within a few seconds during ordinary app-switching/launch bookkeeping -- so a launch could
// get caught by this sweep mid-flight, look "stale" for one instant, and have its brand new layout deleted before the
// running-list ever had a chance to catch up: exactly a plausible cause of a full-screen launch appearing to fail/
// "crash" (its scene got its layout entry ripped away moments after being created). Fix: track how long a bundle ID
// has been CONTINUOUSLY stale across sweeps, in-memory, and only actually delete once it has stayed stale for several
// seconds straight -- comfortably longer than any real launch takes, but still well within "clean those often
// automatically".
static const NSTimeInterval kStaleGraceSeconds = 4.0;
static NSMutableDictionary<NSString *, NSDate *> *DMStaleCandidates(void) {
    static NSMutableDictionary *d; static dispatch_once_t once;
    dispatch_once(&once, ^{ d = [NSMutableDictionary dictionary]; });
    return d;
}
static void DMCleanStaleSwitcherCards(id sw, NSString *reason) {
    SEL deleteSel = @selector(_deleteAppLayoutsMatchingBundleIdentifier:);
    if (!sw || ![sw respondsToSelector:deleteSel] || DMTestFlag("/tmp/msb-noswitchergc")) return;
    if (DMSMEngine()) return;   // (Stage Manager as the engine: a minimized window's app can be suspended while its window -- its card -- is valid; Stage Manager keeps its own cards)
    NSString *frontBid = [DMFrontApp() bundleIdentifier];   // (the app in front is never "stale", even while its process is still starting)
    NSSet<NSString *> *shown = DMSwitcherBundleIDs(sw);
    NSSet<NSString *> *running = DMLiveRunningBundleIDs();
    NSMutableDictionary<NSString *, NSDate *> *candidates = DMStaleCandidates();
    NSDate *now = [NSDate date];
    NSMutableArray<NSString *> *stale = [NSMutableArray array];
    for (NSString *bid in shown) {
        if ([running containsObject:bid] || [bid isEqualToString:frontBid]) { [candidates removeObjectForKey:bid]; continue; }   // running again (or still), or in front: not stale
        NSDate *firstSeen = candidates[bid];
        if (!firstSeen) { candidates[bid] = now; continue; }   // first time seen stale this sweep-series -- start the clock, do NOT delete yet
        if ([now timeIntervalSinceDate:firstSeen] >= kStaleGraceSeconds) [stale addObject:bid];
    }
    for (NSString *bid in [candidates.allKeys copy]) if (![shown containsObject:bid]) [candidates removeObjectForKey:bid];   // no longer even shown: nothing to track
    if (!stale.count) return;
    DMLog([NSString stringWithFormat:@"[switchergc] (%@) removing %lu stale switcher card(s) after %.0fs grace: %@",
           reason, (unsigned long)stale.count, kStaleGraceSeconds, [stale componentsJoinedByString:@", "]]);
    for (NSString *bid in stale) { ((void (*)(id, SEL, id))objc_msgSend)(sw, deleteSel, bid); [candidates removeObjectForKey:bid]; }
}

// Runs the sweep every 15 s in the background -- cheap (a couple of small in-memory arrays, no I/O,
// typically well under a millisecond for the handful of apps this iPad ever has open at once) and
// frequent enough that a straggler left by any quit path is gone on its own within moments, matching
// The owner's "clean those often automatically". This is on top of, not instead of, the immediate per-bundle-ID
// delete DMForceQuitBundle already does for our own Force Quit / Force Quit All paths.
static void DMStartSwitcherGCTimer(void) {
    NSTimer *t = [NSTimer timerWithTimeInterval:15.0 repeats:YES block:^(NSTimer *timer) {
        DMCleanStaleSwitcherCards(DMSwitcherController(), @"periodic");
    }];
    [[NSRunLoop mainRunLoop] addTimer:t forMode:NSRunLoopCommonModes];
    DMGateTimer(t);
}

// Belt-and-suspenders for the exact scenario the owner reported: run the sweep once more shortly after a
// "Force Quit All" finishes, after every individual delete DMForceQuitBundle already scheduled has had
// time to land, in case the OS re-added a card in between (the "dockcontroller"-style pattern used
// elsewhere in this file, of re-checking a moment after an action rather than trusting a single call).
static void DMCleanStaleSwitcherCardsSoon(void) {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        DMCleanStaleSwitcherCards(DMSwitcherController(), @"after force quit all");
    });
}

// Whenever the switcher is actually about to be shown to the user -- by any gesture (swipe-up-and-hold,
// four-finger pinch, our own "switcher_" trigger) -- give it one last clean pass first, so a card left
// over since the last periodic sweep never gets a chance to be seen. -viewWillAppear: is a plain
// UIViewController lifecycle method the OS already calls; this only wraps it, nothing is created.
// `self` is passed directly rather than fetched via `sharedInstance` -- see the crash note on
// DMCleanStaleSwitcherCards above; this exact call site is the one that deadlocked SpringBoard.
%hook SBMainSwitcherViewController
- (void)viewWillAppear:(BOOL)animated {
    DMCleanStaleSwitcherCards(self, @"switcher opening");
    { extern void DMZetsuSwitcherCheck(BOOL appearing); DMZetsuSwitcherCheck(YES); }   // Zetsu's windows get out of the way at once
    %orig;
}
%end
// iOS 16: the same moment on the coordinator (the view controller class above does not exist there). `self` is passed straight through, as above.
%group SwitcherCoordinator16
%hook SBMainSwitcherControllerCoordinator
// Unlike iOS 15's -viewWillAppear:, this also runs when an app simply opens full screen (the switcher hosts full-screen apps on 16), so the
// windows are faded only once the App Switcher itself is really showing (right after the call, or at the latest by the 0.2 s check).
- (void)viewWillAppearForSwitcherViewController:(id)switcherVC {
    DMCleanStaleSwitcherCards(self, @"switcher opening");
    %orig;
    BOOL now = DMSwitcherVisible();
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[switcher16] will appear (%@): switcher visible %d", switcherVC ? NSStringFromClass([switcherVC class]) : @"-", now]);
    extern void DMZetsuSwitcherCheck(BOOL appearing);
    if (now) DMZetsuSwitcherCheck(YES);
    else dispatch_async(dispatch_get_main_queue(), ^{ if (DMSwitcherVisible()) DMZetsuSwitcherCheck(YES); });
}
%end
%end
// iPadOS 18 name of the same moment (18.2 SpringBoard): -switcherControllerViewWillAppear:animated:. Installed only where it exists.
%group SwitcherCoordinator18
%hook SBMainSwitcherControllerCoordinator
- (void)switcherControllerViewWillAppear:(id)switcherVC animated:(BOOL)animated {
    DMCleanStaleSwitcherCards(self, @"switcher opening");
    %orig;
    extern void DMZetsuSwitcherCheck(BOOL appearing);
    if (DMSwitcherVisible()) DMZetsuSwitcherCheck(YES);
    else dispatch_async(dispatch_get_main_queue(), ^{ if (DMSwitcherVisible()) DMZetsuSwitcherCheck(YES); });
}
%end
%end
static void DMSwitcherHooksInit(void) {
    if (!objc_getClass("SBMainSwitcherViewController") && objc_getClass("SBMainSwitcherControllerCoordinator")) %init(SwitcherCoordinator16);
    if ([objc_getClass("SBMainSwitcherControllerCoordinator") instancesRespondToSelector:NSSelectorFromString(@"switcherControllerViewWillAppear:animated:")]) %init(SwitcherCoordinator18);
}


static dispatch_block_t DMCloseThen(dispatch_block_t action);   // defined below

// ===== About This iPad panel (macOS style) ===================================
static id DMMG(NSString *key) {
    static CFTypeRef (*fn)(CFStringRef) = NULL;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *h = dlopen("/usr/lib/libMobileGestalt.dylib", RTLD_LAZY);
        if (h) fn = (CFTypeRef (*)(CFStringRef))dlsym(h, "MGCopyAnswer");
    });
    if (!fn) return nil;
    CFTypeRef v = fn((__bridge CFStringRef)key);
    return v ? CFBridgingRelease(v) : nil;
}

static NSString *DMPackageVersion(NSString *package) { return MSBDPackageVersion(package); }   // (dpkg's status file: read once per change, CrashExplain.h)

static NSString *DMChipName(void) {
    switch ([DMMG(@"ChipID") intValue]) {      // 0x8103 = 33027; the iPads that run iPadOS 15/16 (the iPad 2 cross-test showed "Apple silicon" for its A9X)
        case 0x7000: return @"Apple A8";
        case 0x7001: return @"Apple A8X";
        case 0x8000: case 0x8003: return @"Apple A9";
        case 0x8001: return @"Apple A9X";
        case 0x8010: return @"Apple A10 Fusion";
        case 0x8011: return @"Apple A10X Fusion";
        case 0x8015: return @"Apple A11 Bionic";
        case 0x8020: return @"Apple A12 Bionic";
        case 0x8027: {   // the same chip ID for A12X and A12Z: the 2020 iPad Pros (iPad8,9-12) have the A12Z
            struct utsname u; uname(&u); NSString *m = @(u.machine);
            return [m hasPrefix:@"iPad8,"] && [[m substringFromIndex:6] intValue] >= 9 ? @"Apple A12Z Bionic" : @"Apple A12X Bionic";
        }
        case 0x8030: return @"Apple A13 Bionic";
        case 0x8101: return @"Apple A14 Bionic";
        case 0x8110: return @"Apple A15 Bionic";
        case 0x8103: return @"Apple M1";
        case 0x8112: return @"Apple M2";
        default:     return @"Apple silicon";
    }
}

static NSString *DMMemoryString(void) {
    uint64_t bytes = 0; size_t len = sizeof(bytes);
    if (sysctlbyname("hw.memsize", &bytes, &len, NULL, 0) != 0) return nil;
    double gib = bytes / 1073741824.0;
    int sizes[] = {2, 3, 4, 6, 8, 12, 16, 32};   // marketed RAM sizes; the OS reports slightly less
    for (unsigned i = 0; i < sizeof(sizes) / sizeof(sizes[0]); i++) if (gib <= sizes[i] * 1.0 && gib > sizes[i] * 0.9) return [NSString stringWithFormat:@"%d GB", sizes[i]];
    return [NSString stringWithFormat:@"%.0f GB", gib];
}

static NSString *DMStorageString(void) {
    NSDictionary *usage = DMMG(@"DiskUsage");
    double total = [usage[@"TotalDiskCapacity"] doubleValue] / 1e9;
    double avail = [usage[@"AmountDataAvailable"] doubleValue] / 1e9;
    if (total <= 0) return nil;
    double marketed[] = {32, 64, 128, 256, 512, 1000, 2000};
    double best = marketed[0];
    for (unsigned i = 0; i < sizeof(marketed) / sizeof(marketed[0]); i++)
        if (fabs(log(marketed[i] / total)) < fabs(log(best / total))) best = marketed[i];
    NSString *cap = best >= 1000 ? [NSString stringWithFormat:@"%.0f TB", best / 1000.0]
                                 : [NSString stringWithFormat:@"%.0f GB", best];
    return avail > 0 ? [NSString stringWithFormat:@"%@ (%.0f GB available)", cap, avail] : cap;
}

// "iPad Pro" -> "iPad Pro (11-inch)", like Settings > General > About shows it (unless the model name already carries the size).
static NSString *DMModelWithScreenSize(void) {
    NSString *name = DMMG(@"marketing-name");
    if (!name.length || [name containsString:@"-inch"]) return name;
    CGSize px = [UIScreen mainScreen].nativeBounds.size;
    double ppi = [name localizedCaseInsensitiveContainsString:@"mini"] ? 326.0 : 264.0;
    double inches = hypot(px.width, px.height) / ppi;
    if (inches < 5.0) return name;
    double rounded = round(inches);
    NSString *size = fabs(inches - rounded) < 0.06 ? [NSString stringWithFormat:@"%.0f", rounded] : [NSString stringWithFormat:@"%.1f", inches];
    return [NSString stringWithFormat:@"%@ (%@-inch)", name, size];
}
// "11-inch (2388 x 1668)": the screen's size in inches and its resolution (no longer shown in About: the model already carries the size).
__attribute__((unused)) static NSString *DMDisplayString(void) {
    CGSize px = [UIScreen mainScreen].nativeBounds.size;
    NSString *name = DMMG(@"marketing-name");
    double ppi = [name localizedCaseInsensitiveContainsString:@"mini"] ? 326.0 : 264.0;
    double inches = hypot(px.width, px.height) / ppi;
    if (inches < 5.0) return nil;
    double rounded = round(inches);
    NSString *size = fabs(inches - rounded) < 0.06 ? [NSString stringWithFormat:@"%.0f", rounded] : [NSString stringWithFormat:@"%.1f", inches];
    return [NSString stringWithFormat:@"%@-inch (%.0f × %.0f)", size, MAX(px.width, px.height), MIN(px.width, px.height)];
}
static NSString *DMUptimeString(void) {
    struct timeval boot; size_t len = sizeof(boot);
    if (sysctlbyname("kern.boottime", &boot, &len, NULL, 0) != 0) return nil;
    long secs = (long)(time(NULL) - boot.tv_sec);
    long d = secs / 86400, h = (secs % 86400) / 3600, m = (secs % 3600) / 60;
    if (d > 0) return [NSString stringWithFormat:@"%ld day%@, %ld hour%@", d, d == 1 ? @"" : @"s", h, h == 1 ? @"" : @"s"];
    if (h > 0) return [NSString stringWithFormat:@"%ld hour%@, %ld min", h, h == 1 ? @"" : @"s", m];
    return [NSString stringWithFormat:@"%ld min", m];
}

static NSString *DMDopamineVersion(void) {
    Class proxyClass = objc_getClass("LSApplicationProxy");
    SEL sel = NSSelectorFromString(@"applicationProxyForIdentifier:");
    id proxy = [proxyClass respondsToSelector:sel]
        ? ((id (*)(id, SEL, id))objc_msgSend)(proxyClass, sel, @"com.opa334.Dopamine") : nil;
    NSString *v = DMCall(proxy, @"shortVersionString");
    return v ? [@"Dopamine " stringByAppendingString:v] : @"Dopamine";
}

// Hypervisor: iPadOS ships no Hypervisor.framework of its own (not on iOS 15 or 16), but VirtualMac brings one (taken from macOS) and a jailbreak can
// place one in the usual framework folders; any of those counts. Whether the chip and kernel can actually run virtual machines is the kernel's own
// answer, kern.hv_support (1 on M1/M2 iPads up to iPadOS 16.3.1; Apple took the hypervisor out of the kernel in 16.4). Debug: /tmp/msb-about-hv = "11",
// "10" or "00" forces framework/capable for testing the layout on an iPad without them.
#if DEBUG
static NSString *DMAboutHVOverride(void) { NSString *o = [NSString stringWithContentsOfFile:@"/tmp/msb-about-hv" encoding:NSUTF8StringEncoding error:nil]; return o.length >= 2 ? o : nil; }
#else
static NSString *DMAboutHVOverride(void) { return nil; }
#endif
static BOOL DMHypervisorFrameworkPresent(void) {
    NSString *o = DMAboutHVOverride(); if (o) return [o characterAtIndex:0] == '1';
    for (NSString *p in @[@"/System/Library/Frameworks/Hypervisor.framework", @"/System/Library/PrivateFrameworks/Hypervisor.framework",
                          @"/var/jb/System/Library/Frameworks/Hypervisor.framework", @"/var/jb/Library/Frameworks/Hypervisor.framework",
                          @"/var/jb/Applications/VirtualMac.app/Frameworks/Hypervisor.framework", @"/var/root/VirtualMac/payload/Frameworks/Hypervisor.framework"])
        if (access(p.UTF8String, F_OK) == 0) return YES;
    return NO;
}
static BOOL DMHypervisorCapable(void) {
    NSString *o = DMAboutHVOverride(); if (o) return [o characterAtIndex:1] == '1';
    int hv = 0; size_t len = sizeof(hv);
    return sysctlbyname("kern.hv_support", &hv, &len, NULL, 0) == 0 && hv == 1;
}
@interface DMAboutLinks : NSObject <UITextViewDelegate>
@end
@implementation DMAboutLinks
- (BOOL)textView:(UITextView *)textView shouldInteractWithURL:(NSURL *)URL inRange:(NSRange)characterRange interaction:(UITextItemInteraction)interaction {
    DMCloseOverlay();
    DMOpenURL(URL.absoluteString, [@"about link " stringByAppendingString:URL.absoluteString]);
    return NO;
}
@end
static DMAboutLinks *gAboutLinks;
// The fine print under the first section when the chip can run virtual machines (smaller than a footer, links to the official pages).
static NSAttributedString *DMAboutVirtualizationNote(void) {
    if (!DMHypervisorFrameworkPresent() || !DMHypervisorCapable()) return nil;
    NSString *text = @"This iPad can run virtual machines with UTM, and macOS itself with VirtualMac.";
    NSMutableParagraphStyle *ps = [NSMutableParagraphStyle new]; ps.alignment = NSTextAlignmentCenter;   // (centered, like the two lines above it)
    NSMutableAttributedString *a = [[NSMutableAttributedString alloc] initWithString:text attributes:@{
        NSFontAttributeName: [UIFont systemFontOfSize:11.0], NSForegroundColorAttributeName: [UIColor secondaryLabelColor], NSParagraphStyleAttributeName: ps}];
    [a addAttribute:NSLinkAttributeName value:[NSURL URLWithString:@"https://getutm.app"] range:[text rangeOfString:@"UTM"]];
    [a addAttribute:NSLinkAttributeName value:[NSURL URLWithString:@"https://github.com/nfzerox/VirtualMacOniPad"] range:[text rangeOfString:@"VirtualMac"]];
    return a;
}
// Each entry is @[label, value]; entries with no value are left out.
static NSArray *DMAboutHardwareRows(void) {
    NSString *product = DMMG(@"ProductVersion"), *build = DMMG(@"BuildVersion");
    NSMutableArray *rows = [NSMutableArray array];
    struct { NSString *label; NSString *value; } items[] = {
        {@"Model",         DMModelWithScreenSize()},
        {@"Chip",          [NSString stringWithFormat:@"%@ (%d-core CPU)", DMChipName(), (int)[[NSProcessInfo processInfo] processorCount]]},
        {@"Memory",        DMMemoryString()},
        {@"Storage",       DMStorageString()},
        {@"Serial Number", DMMG(@"SerialNumber")},
        {@"iPadOS",        product ? [NSString stringWithFormat:@"%@%@", product, build ? [NSString stringWithFormat:@" (%@)", build] : @""] : nil},
    };
    for (unsigned i = 0; i < sizeof(items) / sizeof(items[0]); i++)
        if (items[i].value.length) [rows addObject:@[items[i].label, items[i].value]];
    // Requirement (2026-09-24): at the bottom of the first section, whether the Hypervisor framework is there and whether this chip can run virtual machines.
    BOOL framework = DMHypervisorFrameworkPresent();
    // Requirement (later the same day): these two lines are centered like the device name header (a third element "center" marks such a row).
    [rows addObject:@[@"Hypervisor Framework", framework ? @"Yes" : @"No", @"center"]];
    if (framework) [rows addObject:@[@"Virtualization Capability", DMHypervisorCapable() ? [@"Yes - " stringByAppendingString:DMChipName()] : @"No - Chip not capable", @"center"]];
    return rows;
}

static NSArray *DMAboutJailbreakRows(void) {
    NSArray *dylibs = [[NSFileManager defaultManager] contentsOfDirectoryAtPath:@"/var/jb/Library/MobileSubstrate/DynamicLibraries" error:nil];
    NSUInteger tweaks = 0;
    for (NSString *f in dylibs) if ([f hasSuffix:@".dylib"]) tweaks++;
    NSString *ellekit = DMPackageVersion(@"ellekit"), *sileo = DMPackageVersion(@"org.coolstar.sileo");   // (the dpkg package name, not the app's bundle id)
    struct utsname u; uname(&u);
    NSMutableArray *rows = [NSMutableArray array];
    struct { NSString *label; NSString *value; } items[] = {
        {@"Jailbreak",       DMDopamineVersion()},
        {@"Type",            @"Rootless"},
        {@"Injection",       ellekit ? [@"ElleKit " stringByAppendingString:ellekit] : @"ElleKit"},
        {@"Package Manager", sileo ? [@"Sileo " stringByAppendingString:sileo] : nil},
        {@"Tweaks",          tweaks ? [NSString stringWithFormat:@"%lu installed", (unsigned long)tweaks] : nil},
        {@"Kernel",          [NSString stringWithFormat:@"Darwin %s", u.release]},
        {@"Uptime",          DMUptimeString()},
    };
    for (unsigned i = 0; i < sizeof(items) / sizeof(items[0]); i++)
        if (items[i].value.length) [rows addObject:@[items[i].label, items[i].value]];
    return rows;
}

static const CGFloat kAboutW = 460.0, kAboutLabelW = 175.0, kAboutRowH = 25.0, kAboutFooterH = 48.0;

// Shared layout for "About" style panels: an icon, a title and subtitle, then one or more
// tables of label/value rows, and a footer with Done (+ an optional second button).
// sections: array of @{@"header": NSString (optional), @"rows": NSArray of @[label, value]}.
static void DMShowInfoPanel(UIView *host, UIView *icon, NSString *title, NSString *subtitle,
                            NSArray *sections, NSString *secondTitle, dispatch_block_t secondAction) {
    UIControl *o = DMMakeOverlay(host, 0.30);
    // Tapping outside just closes it (nothing destructive here).
    [o addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMCloseOverlay(); }]
        forControlEvents:UIControlEventTouchUpInside];

    UIVisualEffectView *box = DMMakeBlur(14.0);
    UIScrollView *scroll = [UIScrollView new];
    [box.contentView addSubview:scroll];

    // --- header: icon, title, subtitle ---
    __block CGFloat y = 26.0;
    CGSize iconSize = icon.frame.size;
    icon.frame = CGRectMake((kAboutW - iconSize.width) / 2.0, y, iconSize.width, iconSize.height);
    [scroll addSubview:icon];
    y += iconSize.height + 12.0;

    UILabel *t = [UILabel new];
    t.text = title;
    t.font = [UIFont systemFontOfSize:26.0 weight:UIFontWeightSemibold];
    t.textColor = [UIColor labelColor];
    t.textAlignment = NSTextAlignmentCenter;
    t.adjustsFontSizeToFitWidth = YES;
    t.minimumScaleFactor = 0.6;
    t.frame = CGRectMake(20.0, y, kAboutW - 40.0, 32.0);
    [scroll addSubview:t];
    y += 32.0;
    if (subtitle.length) {
        UILabel *st = [UILabel new];
        st.text = subtitle;
        st.font = [UIFont systemFontOfSize:14.0];
        st.textColor = [UIColor secondaryLabelColor];
        st.textAlignment = NSTextAlignmentCenter;
        st.frame = CGRectMake(20.0, y, kAboutW - 40.0, 20.0);
        [scroll addSubview:st];
        y += 20.0;
    }
    y += 16.0;

    // --- two-column tables: right-aligned labels, left-aligned values ---
    void (^addRows)(NSArray *) = ^(NSArray *rows) {
        BOOL centeredBefore = NO;
        for (NSArray *pair in rows) {
            if (pair.count > 2 && [pair[2] isEqual:@"center"]) {   // one centered line: the label (like the table's labels), then the value
                if (!centeredBefore) y += 4.0;
                centeredBefore = YES;
                NSMutableAttributedString *line = [[NSMutableAttributedString alloc] initWithString:pair[0] attributes:@{
                    NSFontAttributeName: [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold], NSForegroundColorAttributeName: [UIColor secondaryLabelColor]}];
                [line appendAttributedString:[[NSAttributedString alloc] initWithString:[@"  " stringByAppendingString:pair[1]] attributes:@{
                    NSFontAttributeName: [UIFont systemFontOfSize:13.0], NSForegroundColorAttributeName: [UIColor labelColor]}]];
                UILabel *c = [UILabel new];
                c.attributedText = line;
                c.textAlignment = NSTextAlignmentCenter;
                c.adjustsFontSizeToFitWidth = YES;
                c.minimumScaleFactor = 0.8;
                c.frame = CGRectMake(20.0, y, kAboutW - 40.0, kAboutRowH);
                [scroll addSubview:c];
                y += kAboutRowH;
                continue;
            }
            UILabel *l = [UILabel new];
            l.text = pair[0];
            l.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold];
            l.textColor = [UIColor secondaryLabelColor];
            l.textAlignment = NSTextAlignmentRight;
            l.frame = CGRectMake(0, y, kAboutLabelW, kAboutRowH);
            UILabel *v = [UILabel new];
            v.text = pair[1];
            v.font = [UIFont systemFontOfSize:13.0];
            v.textColor = [UIColor labelColor];
            v.adjustsFontSizeToFitWidth = YES;
            v.minimumScaleFactor = 0.8;
            v.frame = CGRectMake(kAboutLabelW + 12.0, y, kAboutW - kAboutLabelW - 12.0 - 20.0, kAboutRowH);
            [scroll addSubview:l];
            [scroll addSubview:v];
            y += kAboutRowH;
        }
    };
    NSUInteger index = 0;
    for (NSDictionary *section in sections) {
        NSArray *rows = section[@"rows"];
        if (rows.count) {
            if (index > 0) {
                y += 12.0;
                UIView *line = [[UIView alloc] initWithFrame:CGRectMake(24.0, y, kAboutW - 48.0, 0.5)];
                line.backgroundColor = [UIColor separatorColor];
                [scroll addSubview:line];
                y += 14.0;
                NSString *header = section[@"header"];
                if (header.length) {
                    UILabel *h = [UILabel new];
                    h.text = header;
                    h.font = [UIFont systemFontOfSize:11.0 weight:UIFontWeightSemibold];
                    h.textColor = [UIColor tertiaryLabelColor];
                    h.textAlignment = NSTextAlignmentCenter;
                    h.frame = CGRectMake(0, y, kAboutW, 16.0);
                    [scroll addSubview:h];
                    y += 16.0 + 6.0;
                }
            }
            addRows(rows);
            NSAttributedString *note = section[@"note"];
            if (note.length) {   // small print under the rows, with tappable links
                if (!gAboutLinks) gAboutLinks = [DMAboutLinks new];
                UITextView *tv = [UITextView new];
                tv.editable = NO; tv.scrollEnabled = NO; tv.backgroundColor = [UIColor clearColor];
                tv.textContainerInset = UIEdgeInsetsZero; tv.textContainer.lineFragmentPadding = 0;
                tv.attributedText = note; tv.delegate = gAboutLinks;
                tv.linkTextAttributes = @{NSForegroundColorAttributeName: [UIColor systemBlueColor]};
                NSParagraphStyle *nps = [note attribute:NSParagraphStyleAttributeName atIndex:0 effectiveRange:NULL];
                BOOL centered = nps.alignment == NSTextAlignmentCenter;   // (centered notes span the panel; others sit under the values column)
                CGFloat nx = centered ? 40.0 : kAboutLabelW + 12.0, nw = centered ? kAboutW - 80.0 : kAboutW - kAboutLabelW - 12.0 - 20.0;
                CGSize fit = [tv sizeThatFits:CGSizeMake(nw, CGFLOAT_MAX)];
                y += 6.0;
                tv.frame = CGRectMake(nx, y, nw, ceil(fit.height));
                [scroll addSubview:tv];
                y += ceil(fit.height);
            }
        }
        index++;
    }
    y += 18.0;

    // --- size: scroll if the screen is short (portrait iPad is tall, landscape is not) ---
    CGFloat maxBody = MAX(200.0, host.bounds.size.height - 80.0 - kAboutFooterH);
    CGFloat bodyH = MIN(y, maxBody);
    scroll.frame = CGRectMake(0, 0, kAboutW, bodyH);
    scroll.contentSize = CGSizeMake(kAboutW, y);
    scroll.showsVerticalScrollIndicator = y > maxBody;

    // --- footer ---
    CGFloat H = bodyH + kAboutFooterH;
    box.frame = CGRectMake(0, 0, kAboutW, H);
    box.center = CGPointMake(CGRectGetMidX(o.bounds), CGRectGetMidY(o.bounds));
    box.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleRightMargin |
                           UIViewAutoresizingFlexibleTopMargin  | UIViewAutoresizingFlexibleBottomMargin;

    UIView *hLine = [[UIView alloc] initWithFrame:CGRectMake(0, bodyH, kAboutW, 0.5)];
    hLine.backgroundColor = [UIColor separatorColor];
    [box.contentView addSubview:hLine];
    if (secondTitle.length && secondAction) {
        UIView *vLine = [[UIView alloc] initWithFrame:CGRectMake(kAboutW / 2.0, bodyH, 0.5, kAboutFooterH)];
        vLine.backgroundColor = [UIColor separatorColor];
        [box.contentView addSubview:vLine];
        [box.contentView addSubview:DMDialogButton(@"Done", NO, [UIColor systemBlueColor],
            CGRectMake(0, bodyH, kAboutW / 2.0, kAboutFooterH), ^{ DMCloseOverlay(); })];
        [box.contentView addSubview:DMDialogButton(secondTitle, YES, [UIColor systemBlueColor],
            CGRectMake(kAboutW / 2.0, bodyH, kAboutW / 2.0, kAboutFooterH), ^{ DMCloseThen(secondAction)(); })];
    } else {
        [box.contentView addSubview:DMDialogButton(@"Done", YES, [UIColor systemBlueColor],
            CGRectMake(0, bodyH, kAboutW, kAboutFooterH), ^{ DMCloseOverlay(); })];
    }

    [o addSubview:box];
    box.alpha = 0.0;
    [UIView animateWithDuration:0.12 animations:^{ box.alpha = 1.0; }];
}

static void DMShowAbout(UIView *host) {
    NSArray *hw = DMAboutHardwareRows(), *jb = DMAboutJailbreakRows();
    DMLog([NSString stringWithFormat:@"[about] shown: %lu hardware rows, %lu jailbreak rows", (unsigned long)hw.count, (unsigned long)jb.count]);
    for (NSArray *pair in [hw arrayByAddingObjectsFromArray:jb])
        DMLog([NSString stringWithFormat:@"[about]   %@: %@", pair[0], [pair[0] isEqualToString:@"Serial Number"] ? @"(hidden in log)" : pair[1]]);

    UIImage *symbol = [UIImage systemImageNamed:@"ipad.landscape"
        withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:58 weight:UIImageSymbolWeightUltraLight]];
    UIView *icon;
    if (symbol) {
        UIImageView *iv = [[UIImageView alloc] initWithImage:[symbol imageWithTintColor:[UIColor secondaryLabelColor]
                                                                          renderingMode:UIImageRenderingModeAlwaysOriginal]];
        iv.contentMode = UIViewContentModeScaleAspectFit;
        iv.frame = CGRectMake(0, 0, 84.0, 66.0);
        icon = iv;
    } else {
        UILabel *g = [UILabel new];
        g.text = [NSString stringWithFormat:@"%C", (unichar)0xF8FF];
        g.font = [UIFont systemFontOfSize:58.0 weight:UIFontWeightThin];
        g.textColor = [UIColor secondaryLabelColor];
        g.textAlignment = NSTextAlignmentCenter;
        g.frame = CGRectMake(0, 0, 84.0, 66.0);
        icon = g;
    }

    NSString *marketing = DMMG(@"marketing-name") ?: @"iPad";
    NSString *title = marketing, *subtitle = nil;
    NSRange paren = [marketing rangeOfString:@" ("];
    if (paren.location != NSNotFound) {
        title = [marketing substringToIndex:paren.location];
        subtitle = [[marketing substringFromIndex:paren.location + 2]
                    stringByReplacingOccurrencesOfString:@") (" withString:@", "];
        if ([subtitle hasSuffix:@")"]) subtitle = [subtitle substringToIndex:subtitle.length - 1];
    }
    DMShowInfoPanel(host, icon, title, subtitle,
                    @[ DMAboutVirtualizationNote() ? @{@"rows": hw, @"note": DMAboutVirtualizationNote()} : @{@"rows": hw}, @{@"header": @"JAILBREAK", @"rows": jb} ],
                    @"More Info…", ^{ DMAbout(); });
}

// ---- About <App> ----
static id DMProxyForBundle(NSString *bundleID) {
    Class proxyClass = objc_getClass("LSApplicationProxy");
    SEL sel = NSSelectorFromString(@"applicationProxyForIdentifier:");
    return [proxyClass respondsToSelector:sel] ? ((id (*)(id, SEL, id))objc_msgSend)(proxyClass, sel, bundleID) : nil;
}


// Open (or close) Spotlight search. Lynx sends the Home Screen swipe-down to the App Library, so
// Spotlight needs its own way in. -[SpringBoard _toggleSearch] exists on 15.6.1 and presents the
// Spotlight overlay from the Home Screen or over an app.
static void DMOpenSpotlight(void) {
    {   // never over the Lock Screen or the Cover Sheet (the icon is hidden there; this also covers a tap that lands during the change)
        id lm = DMSBManager("SBLockScreenManager");
        id csm = DMSBManager("SBCoverSheetPresentationManager");
        BOOL cover = [csm respondsToSelector:NSSelectorFromString(@"isVisible")] && ((BOOL (*)(id, SEL))objc_msgSend)(csm, NSSelectorFromString(@"isVisible"));
        if (DMLockUp(lm) || cover) { DMLog(@"[spotlight] the Lock Screen or Cover Sheet is up: not opened"); return; }
    }
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    SEL toggle = NSSelectorFromString(@"_toggleSearch");
    if ([sb respondsToSelector:toggle]) {
        DMLog(@"[spotlight] toggling via -[SpringBoard _toggleSearch]");
        ((void (*)(id, SEL))objc_msgSend)(sb, toggle);
    } else {
        DMLog(@"[spotlight] -[SpringBoard _toggleSearch] is missing");
    }
}

static NSString *DMBytesString(unsigned long long bytes) {
    return [NSByteCountFormatter stringFromByteCount:(long long)bytes countStyle:NSByteCountFormatterCountStyleFile];
}

static NSArray *DMAppAboutRows(SBApplication *app, id proxy) {
    NSString *bid = [app bundleIdentifier];
    NSMutableArray *rows = [NSMutableArray array];
    void (^add)(NSString *, NSString *) = ^(NSString *label, NSString *value) {
        if (value.length) [rows addObject:@[label, value]];
    };
    NSString *vendor = DMCall(proxy, @"vendorName");
    NSString *type = DMCall(proxy, @"applicationType");
    unsigned long long itemID = [DMCall(proxy, @"itemID") unsignedLongLongValue];
    unsigned long long appBytes = [DMCall(proxy, @"staticDiskUsage") unsignedLongLongValue];
    unsigned long long dataBytes = [DMCall(proxy, @"dynamicDiskUsage") unsignedLongLongValue];
    NSString *minOS = DMCall(proxy, @"minimumSystemVersion");
    int pid = DMPidForApp(app);
    uint64_t footprint = DMFootprintBytes(pid);

    add(@"Developer", vendor);
    add(@"Bundle ID", bid);
    add(@"Source", [type isEqualToString:@"System"] ? @"System App" : (itemID ? @"App Store" : @"Sideloaded"));
    if (appBytes > 8192 && dataBytes > 8192)
        add(@"Size", [NSString stringWithFormat:@"%@ app, %@ data", DMBytesString(appBytes), DMBytesString(dataBytes)]);
    else if (appBytes > 8192)
        add(@"Size", [DMBytesString(appBytes) stringByAppendingString:@" app"]);
    add(@"Memory", footprint ? [NSString stringWithFormat:@"%@ in use now", DMBytesString(footprint)] : nil);
    add(@"Process ID", pid > 0 ? [NSString stringWithFormat:@"%d", pid] : nil);
    add(@"Requires", minOS ? [NSString stringWithFormat:@"iPadOS %@ or later", minOS] : nil);
    add(@"App Store ID", itemID ? [NSString stringWithFormat:@"%llu", itemID] : nil);
    return rows;
}

static void DMShowAppAbout(UIView *host, SBApplication *app) {
    NSString *bid = [app bundleIdentifier];
    id proxy = DMProxyForBundle(bid);
    NSString *name = [app displayName] ?: DMCall(proxy, @"localizedName") ?: bid;
    NSString *version = DMCall(proxy, @"shortVersionString");
    NSString *build = DMCall(proxy, @"bundleVersion");
    NSString *subtitle = version.length
        ? ((build.length && ![build isEqualToString:version])
              ? [NSString stringWithFormat:@"Version %@ (%@)", version, build]
              : [NSString stringWithFormat:@"Version %@", version])
        : nil;
    NSArray *rows = DMAppAboutRows(app, proxy);
    DMLog([NSString stringWithFormat:@"[appabout] %@: %lu rows, proxy %@", bid, (unsigned long)rows.count, proxy ? @"ok" : @"MISSING"]);

    UIImageView *icon = [[UIImageView alloc] initWithFrame:CGRectMake(0, 0, 72.0, 72.0)];
    icon.accessibilityIgnoresInvertColors = YES;
    icon.image = DMAppIcon(bid);
    icon.backgroundColor = icon.image ? nil : [UIColor tertiarySystemFillColor];
    icon.layer.cornerRadius = 72.0 * 0.225;
    icon.layer.cornerCurve = kCACornerCurveContinuous;
    icon.clipsToBounds = YES;

    // Same idea as AppData's "Open in Filza": jump to the app's data folder if Filza is installed.
    NSURL *dataURL = DMCall(proxy, @"dataContainerURL");
    BOOL filza = dataURL.path.length &&
        [[UIApplication sharedApplication] canOpenURL:[NSURL URLWithString:@"filza://"]];
    NSString *secondTitle = filza ? @"Open Data in Filza" : nil;
    dispatch_block_t secondAction = filza ? ^{
        DMOpenURL([@"filza://view" stringByAppendingString:dataURL.path], @"open data in filza");
    } : nil;

    DMShowInfoPanel(host, icon, name, subtitle, @[ @{@"rows": rows} ], secondTitle, secondAction);
}

// Close the menu, then run the action a moment later so the menu is gone first.
static dispatch_block_t DMCloseThen(dispatch_block_t action) {
    return ^{
        DMCloseOverlay();
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), action);
    };
}

static void DMAttachMenuHover(UIControl *overlay, UIView *fg, UIView *host, UIButton *currentButton);   // defined below
// A title tapped while a menu is open: its own menu closes (like before); another title's menu takes over at once (like macOS). Returns YES when
// nothing more is to be done. (In portrait on the iPad 2 a tap on a title reached the status bar's own button instead of our catch-all, and the
// button only closed the open menu: switching took two taps.)
static __weak UIButton *gOverlayTitle = nil;
static BOOL DMTitleTapWithMenuOpen(UIButton *btn) {
    if (!gOverlay) return NO;
    UIButton *cur = gOverlayTitle;
    if (!cur || cur == btn || !btn) { DMCloseOverlay(); return YES; }
    DMLog(@"[menu] another title tapped while a menu is open: switching menus");
    DMRemoveOverlayNow();
    return NO;
}

static void DMOpenMenu(UIButton *btn) {
    UIView *fg = btn.superview;
    UIView *host = DMHostFor(fg);
    if (!host) return;
    if (DMTitleTapWithMenuOpen(btn)) return;

    // Built each time so "Force Quit" reflects the app in front right now.
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    SBApplication *front = [sb respondsToSelector:@selector(_accessibilityFrontMostApplication)]
                               ? [sb _accessibilityFrontMostApplication] : nil;
    NSString *fqTitle = front ? [NSString stringWithFormat:@"Force Quit %@", [front displayName] ?: @"App"]
                              : @"Force Quit";
    NSArray *runningApps = DMUserRunningApps();   // the apps "Force Quit All Apps…" would quit

    // A newer MacStatusBar&Dock waiting in Sileo's or Zebra's downloaded package list: its own row, right under About This iPad, like a Mac's
    // "1 update" (nothing is fetched by us: common/UpdateCheck.h). Only while there is one.
    NSString *installedVersion = MSBDPackageVersionNoWait(MSBD_PACKAGE_ID);   // (never reads dpkg's status file here: cached, refreshed off the main thread)
#if DEBUG
    {   // (debug /tmp/msb-fake-installed: the version written there counts as installed, to see the row without an older package)
        NSString *fake = [[NSString stringWithContentsOfFile:@"/tmp/msb-fake-installed" encoding:NSUTF8StringEncoding error:nil] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (fake.length) installedVersion = fake;
    }
#endif
    NSString *update = MSBDUpdateAvailable(installedVersion);
    DMLog([NSString stringWithFormat:@"[update] installed %@, newest in the package managers' lists %@ (%lu list files) -> %@", installedVersion, MSBDNewestListedVersion(), (unsigned long)MSBDRepoListFiles().count, update ?: @"no update"]);
    NSString *managerID = nil;
    NSURL *updateURL = update ? MSBDPackageManagerURL(^BOOL(NSString *bid) {
        return ((id (*)(id, SEL, id))objc_msgSend)(DMCall(objc_getClass("SBApplicationController"), @"sharedInstance"), NSSelectorFromString(@"applicationWithBundleIdentifier:"), bid) != nil;
    }, &managerID) : nil;
    NSMutableArray *updateRows = [NSMutableArray array];
    if (update && updateURL) {
        DM_FEATURE_MARK("apple-menu-update");
        [updateRows addObject:[[DMRow alloc] initWithTitle:[NSString stringWithFormat:@"Update Available (%@)…", update] enabled:YES handler:DMCloseThen(^{
            // (a package manager started by the link drops it while it starts up -- Sileo opened on Featured: once it runs, the link again)
            id mgrApp = ((id (*)(id, SEL, id))objc_msgSend)(DMCall(objc_getClass("SBApplicationController"), @"sharedInstance"), NSSelectorFromString(@"applicationWithBundleIdentifier:"), managerID);
            BOOL running = [mgrApp respondsToSelector:NSSelectorFromString(@"isRunning")] && ((BOOL (*)(id, SEL))objc_msgSend)(mgrApp, NSSelectorFromString(@"isRunning"));
            [[UIApplication sharedApplication] openURL:updateURL options:@{} completionHandler:nil];
            if (!running) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                [[UIApplication sharedApplication] openURL:updateURL options:@{} completionHandler:nil];
            });
        })]];
    }
    NSArray *items = [@[
        [[DMRow alloc] initWithTitle:@"About This iPad" enabled:YES handler:^{ DMShowAbout(host); }]] arrayByAddingObjectsFromArray:[updateRows arrayByAddingObjectsFromArray:@[
        [NSNull null],
        [[DMRow alloc] initWithTitle:@"App Store…" enabled:YES handler:DMCloseThen(^{ DMAppStoreUpdates(); })],
        [NSNull null],
        [[DMRow alloc] initWithTitle:fqTitle enabled:(front != nil)
                             handler:DMCloseThen(^{ if (front) DMForceQuit(front); })],
        [[DMRow alloc] initWithTitle:@"Force Quit Apps…" enabled:YES handler:^{ DMShowForceQuitList(host); }],
        [[DMRow alloc] initWithTitle:@"Force Quit All Apps…" enabled:(runningApps.count > 0) handler:^{
            DMShowConfirm(host, runningApps.count == 1 ? @"Force quit the open app?" : [NSString stringWithFormat:@"Force quit all %lu apps?", (unsigned long)runningApps.count],
                          @"Every open app will be quit at once, and anything you have not saved in them will be lost.",
                          @"Force Quit All", YES, ^{ DMForceQuitAll(); });
        }],
        [NSNull null],
        [[DMRow alloc] initWithTitle:@"Respring…" enabled:YES handler:^{
            if (DMRespringNeedsVPNWarning()) { DMCloseThen(^{ DMRespringChecked(); })(); return; }   // (the menu closes; the VPN warning instead of the usual question)
            DMShowConfirm(host, @"Respring?", @"SpringBoard will restart and your tweaks will reload.",
                          @"Respring", NO, ^{ DMRespringChecked(); });
        }],
        [[DMRow alloc] initWithTitle:@"Safe Mode…" enabled:YES handler:^{
            DMShowConfirm(host, @"Enter Safe Mode?",
                          @"SpringBoard will restart with all tweaks turned off until you exit Safe Mode.",
                          @"Enter Safe Mode", YES, ^{ DMEnterSafeMode(); });
        }],
        [NSNull null],
        [[DMRow alloc] initWithTitle:@"Lock Screen" enabled:YES handler:DMCloseThen(^{ DMLock(); })],
        [[DMRow alloc] initWithTitle:@"Sleep" enabled:YES handler:DMCloseThen(^{ DMSleep(); })],
        [[DMRow alloc] initWithTitle:@"Shut Down…" enabled:YES handler:^{
            DMShowConfirm(host, @"Shut down this iPad?",
                          @"You will need to run Dopamine again after turning it back on.",
                          @"Shut Down", YES, ^{ DMShutDown(); });
        }],
    ]]];

    UIControl *o = DMMakeOverlay(host, 0.0);
    [o addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMCloseOverlay(); }]
        forControlEvents:UIControlEventTouchUpInside];
    DMAttachMenuHover(o, fg, host, btn);

    UIView *panel = DMMakePanel(items);
    CGRect anchor = DMConvertToHost(fg, btn.frame, host);
    CGRect pf = panel.frame;
    pf.origin = CGPointMake(DMMenuOriginX(fg, host, anchor, pf.size.width), CGRectGetMaxY(anchor) + 2.0);
    panel.frame = pf;
    [o addSubview:panel];

    gPill = objc_getAssociatedObject(fg, kPillKey);
    gPill.backgroundColor = [[(UILabel *)objc_getAssociatedObject(fg, kLogoKey) textColor] colorWithAlphaComponent:0.25];
    gPill.hidden = NO;

    DMLogMenuGeometry(@"Apple", fg, btn, host, panel);
    panel.alpha = 0.0;
    [UIView animateWithDuration:0.10 animations:^{ panel.alpha = 1.0; }];
    NSMutableString *chain = [NSMutableString string];
    for (UIView *v = fg; v; v = v.superview) {
        [chain appendFormat:@"%@ f=%@ t=%@ | ", NSStringFromClass([v class]), NSStringFromCGRect(v.frame),
            NSStringFromCGAffineTransform(v.transform)];
    }
    DMLog([NSString stringWithFormat:@"[menu] opened panel=%@ anchor=%@ btn=%@", NSStringFromCGRect(pf),
           NSStringFromCGRect(anchor), NSStringFromCGRect(btn.frame)]);
    DMLog([NSString stringWithFormat:@"[menu] window bounds=%@ frame=%@ t=%@ screen=%@ style=%ld",
           NSStringFromCGRect(host.bounds), NSStringFromCGRect(host.frame), NSStringFromCGAffineTransform(host.transform),
           NSStringFromCGRect([UIScreen mainScreen].bounds), (long)host.traitCollection.userInterfaceStyle]);
    DMLog([NSString stringWithFormat:@"[menu] chain: %@", chain]);
}





// ===== Finder + Edit menus ====================================================
#import <mach/mach_time.h>

static BOOL DMAppInstalled(NSString *bundleID) {
    id proxy = DMProxyForBundle(bundleID);
    return proxy && [DMBoolStr(proxy, @"isInstalled") isEqualToString:@"Y"] && [DMCall(proxy, @"localizedName") length] > 0;
}

// With "Open Apps as Windows" on, an app opened from anywhere opens as a window: an existing window is shown, otherwise a new one opens in the standard
// place. Returns NO when the normal full-screen launch should happen. `gWindowLaunchUntil` keeps the launch we start from being caught again by the
// launch hooks (Aerial's and MilkyWay's own launch code go through them too).
static NSMutableDictionary<NSString *, NSNumber *> *gWindowLaunchUntil = nil;
static BOOL DMHasHomeIcon(NSString *bundleID) {
    id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
    id model = DMCall(DMCall(ic, @"iconManager"), @"iconModel");
    SEL sel = NSSelectorFromString(@"applicationIconForBundleIdentifier:");
    return [model respondsToSelector:sel] && ((id (*)(id, SEL, id))objc_msgSend)(model, sel, bundleID) != nil;
}
static void DMLaunchIntoTile(NSString *bundleID, CGRect frame) {   // (the side question was answered before the launch)
    if (!gWindowLaunchUntil) gWindowLaunchUntil = [NSMutableDictionary dictionary];
    gWindowLaunchUntil[bundleID] = @(CACurrentMediaTime() + 4.0);
    DMLog([NSString stringWithFormat:@"[windowed] open %@ as an Aerial window, straight into its place %@", bundleID, NSStringFromCGRect(frame)]);
    DMAerialTrigger(bundleID, CGRectIsNull(frame) ? DMLayoutFrame(@"center") : frame);
    DMDismissLibraryForWindow(bundleID);
}
static BOOL DMWindowedLaunchEligible(NSString *bundleID) {   // would this launch open as a new window? (no side effects)
    if (!bundleID.length || gForceFullScreenLaunch || DMActiveEngine() == DMEngineNone || !DMWindowedLaunchOn()) return NO;
    if (DMAppNeedsFullScreen(bundleID)) return NO;   // a full-screen-only game: the normal full-screen launch
    if ([[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) return NO;   // already open full screen
    // Opened from inside an app that can only be full screen (the Camera's photo thumbnail opening Photos, a game's link): full screen too, as on
    // a stock iPad (2026-09-26, M1: Photos opened this way went straight into its photo view, then the window's size change made its split view
    // abort, three times, and Aerial's clean-up of that window took SpringBoard down with it).
    NSString *fromFS = [DMFrontApp() bundleIdentifier];
    if (fromFS.length && DMAppNeedsFullScreen(fromFS)) { DMLog([NSString stringWithFormat:@"[windowed] %@ opened from %@ (full screen only): full screen too", bundleID, fromFS]); return NO; }
    if ([bundleID isEqualToString:@"com.apple.springboard"] || !DMHasHomeIcon(bundleID)) return NO;   // only apps with an icon
    id lock = DMSBManager("SBLockScreenManager");
    if (DMLockUp(lock)) return NO;   // Camera from the lock screen etc.
    NSNumber *until = gWindowLaunchUntil[bundleID];
    if (until && CACurrentMediaTime() < until.doubleValue) return NO;   // the launch we started ourselves
    return YES;
}
static BOOL DMWindowedLaunch(NSString *bundleID) {
    if (!bundleID.length || gForceFullScreenLaunch || DMActiveEngine() == DMEngineNone) return NO;
    if (!gRestoringWindows) DMNoteOpenedBeforeRestore(bundleID);   // (not the restore's own launches)
    if (DMSurfaceWindowForApp(bundleID)) return YES;
    if (!DMWindowedLaunchEligible(bundleID)) return NO;
    if (!gWindowLaunchUntil) gWindowLaunchUntil = [NSMutableDictionary dictionary];
    gWindowLaunchUntil[bundleID] = @(CACurrentMediaTime() + 4.0);
    if (DMActiveEngine() == DMEngineMilkyWay) { DMLog([NSString stringWithFormat:@"[windowed] open %@ as a MilkyWay window", bundleID]); DMLaunchAsWindow(bundleID); return YES; }
    if (DMActiveEngine() == DMEngineZetsu) {   // size, place and tiling are set when the window appears (DMZetsuAdopt)
        DMLog([NSString stringWithFormat:@"[windowed] open %@ as a Zetsu window", bundleID]);
        DMZetsuLaunch(bundleID);
        DMDismissLibraryForWindow(bundleID);
        return YES;
    }
    CGRect target = DMLayoutFrame(@"center");
    if (CGRectIsNull(target)) { [gWindowLaunchUntil removeObjectForKey:bundleID]; return NO; }
    extern BOOL DMAerialWarmStartIfNeeded(NSString *bundleID);
    extern BOOL DMAerialNeedsWarmStartFlag(NSString *bundleID);
    NSString *leftB = nil, *rightB = nil;
    if (!DMAerialNeedsWarmStartFlag(bundleID) && DMThirdWindowSides(bundleID, &leftB, &rightB)) {   // the third window: which side first, then the launch
        NSString *b = [bundleID copy];
        DMPromptBeforeLaunch(b, leftB, rightB, ^(CGRect f) { DMLaunchIntoTile(b, f); });
        DMDismissLibraryForWindow(bundleID);
        return YES;
    }
    if (DMAerialWarmStartIfNeeded(bundleID)) { DMDismissLibraryForWindow(bundleID); return YES; }
    DMLog([NSString stringWithFormat:@"[windowed] open %@ as an Aerial window", bundleID]);
    DMAerialTrigger(bundleID, target);
    DMDismissLibraryForWindow(bundleID);
    return YES;
}
// Aerial 5.0, WhatsApp started straight into a window (M1, iOS 15): the window stays black. A cold windowed start brings up 7 of its scenes at
// once (its saved scene sessions are reconnected); WhatsApp draws into one the window does not show, and even full screen that window stays
// black. Started full screen it gets exactly one scene, and turning that into a window works. So for such an app, when it is not running, the
// known-good way is taken automatically: a still picture of the screen goes up (it hides the full-screen moment), the app opens full screen,
// once it is in front and has drawn it goes home and Aerial opens its window (the same steps as the status bar's green light), and the
// picture fades once the window's veil is gone. A running app (in the background) opens straight into its window as before. Aerial 5.0 only
// (the engine it was found and verified on). Kill switch /tmp/msb-a5-nowarmstart (debug builds).
static BOOL DMAerialNeedsWarmStart(NSString *bundleID) {
    if (!bundleID.length || DMActiveEngine() != DMEngineAerial || gAerialFlavor != 5 || DMTestFlag("/tmp/msb-a5-nowarmstart")) return NO;
    static NSSet<NSString *> *known;
    if (!known) known = [NSSet setWithObjects:@"net.whatsapp.WhatsApp", @"net.whatsapp.WhatsAppSMB", nil];
    if (![known containsObject:bundleID] || !DMAppSupportsMultipleScenes(bundleID) || DMAppNeedsFullScreen(bundleID)) return NO;
    if (DMStageForBundle(bundleID) || [DMLiveRunningBundleIDs() containsObject:bundleID]) return NO;   // a window already, or running: the direct way works
    return YES;
}
BOOL DMAerialNeedsWarmStartFlag(NSString *bundleID) { return DMAerialNeedsWarmStart(bundleID); }
BOOL DMAerialWarmStartIfNeeded(NSString *bundleID) {
    if (!DMAerialNeedsWarmStart(bundleID)) return NO;
    static NSMutableSet<NSString *> *busy;
    if (!busy) busy = [NSMutableSet set];
    if ([busy containsObject:bundleID]) return YES;   // (a second tap while it runs)
    [busy addObject:bundleID];
    if (!gWindowLaunchUntil) gWindowLaunchUntil = [NSMutableDictionary dictionary];
    gWindowLaunchUntil[bundleID] = @(CACurrentMediaTime() + 8.0);   // (our own full-screen launch is not turned into a window launch again)
    CFTimeInterval began = CACurrentMediaTime();
    NSString *before = [DMFrontApp() bundleIdentifier];   // a full-screen app it was opened over comes back behind the window (else the Home Screen)
    DMLog([NSString stringWithFormat:@"[windowed] %@: cold start of an app that stays black when started in a window -- full screen first (behind a picture of the screen), then into a window", bundleID]);
    DMCoverShowFor(9.0);
    DMOpenFullScreen(bundleID);
    void (^finish)(NSString *) = ^(NSString *why) {
        [busy removeObject:bundleID];
        [gWindowLaunchUntil removeObjectForKey:bundleID];
        DMLog([NSString stringWithFormat:@"[windowed] %@: %@ (%.2f s after the tap)", bundleID, why, CACurrentMediaTime() - began]);
        DMCoverFadeOut(0.0);
    };
    // as soon as it is in front and has drawn its first frame (FrontBoard's content state, checked every display frame): into the window
    extern void DMWhenAppDrawn(NSString *bundleID, BOOL needFront, double timeout, void (^done)(BOOL ready));
    DMWhenAppDrawn(bundleID, YES, 5.0, ^(BOOL drawn) {
        if (![[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) { finish(@"not in front after 5 s: left as it is"); return; }
        CGRect target = gLastWindowFrames[bundleID] ? gLastWindowFrames[bundleID].CGRectValue : DMLayoutFrame(@"center");
        DMLog([NSString stringWithFormat:@"[windowed] %@: in front and %@ after %.2f s; now into a window at %@", bundleID, drawn ? @"drawn" : @"(timed out waiting for its first frame)", CACurrentMediaTime() - began, NSStringFromCGRect(target)]);
        void (^open)(void) = ^{
            DMAerialTrigger(bundleID, target);
            // the window sits above the picture (Aerial's layer is over the status bar window) with its own veil until the app has drawn in
            // it, so the picture can fade as soon as the window exists
            DMWaitFor(^BOOL{ return DMStageForBundle(bundleID) != nil; }, 60, ^(BOOL shown) { finish(shown ? @"window open, picture fades" : @"no window after 3 s, picture fades anyway"); });
        };
        SEL goHome = NSSelectorFromString(@"_returnToHomeScreenWithCompletion:");
        UIApplication *ui = [UIApplication sharedApplication];
        if (before.length && ![before isEqualToString:bundleID]) DMOpenFullScreen(before);
        else if (![ui respondsToSelector:goHome]) { open(); return; }
        else ((void (*)(id, SEL, id))objc_msgSend)(ui, goHome, ^{});
        CFTimeInterval homeAt = CACurrentMediaTime();
        DMWaitFor(^BOOL{ return (![[DMFrontApp() bundleIdentifier] isEqualToString:bundleID] && CACurrentMediaTime() - homeAt >= 0.1) || CACurrentMediaTime() - homeAt > 1.2; }, 30, ^(BOOL ok) { open(); });
    });
    return YES;
}
// Debug: per display frame, the on-screen (presentation) frame of the big views inside the Control Center window
@interface DMCCRecorder : NSObject
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval start, until;
@property (nonatomic, strong) NSMutableDictionary *last;
@end
@implementation DMCCRecorder
- (void)walk:(UIView *)v depth:(int)d path:(NSString *)path now:(CFTimeInterval)now {
    CALayer *pl = v.layer.presentationLayer ?: v.layer;
    NSString *me = [path stringByAppendingFormat:@"/%@", NSStringFromClass([v class])];
    if (pl.bounds.size.width > 150.0 && pl.bounds.size.height > 40.0 && d > 0 && d < 8) {
        NSString *state = [NSString stringWithFormat:@"%@ frame %@ alpha %.2f", me, NSStringFromCGRect(pl.frame), pl.opacity];
        NSString *key = [NSString stringWithFormat:@"%p", v];
        if (![self.last[key] isEqualToString:state]) { self.last[key] = state; DMLog([NSString stringWithFormat:@"[ccrec %4.0f ms] d%d %@", (now - self.start) * 1000.0, d, state]); }
    }
    if (d < 8) for (UIView *c in v.subviews) [self walk:c depth:d + 1 path:me now:now];
}
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval now = CACurrentMediaTime();
    if (now > self.until) { [l invalidate]; DMLog(@"[ccrec] done"); return; }
    for (UIWindow *w in DMAllWindows())
        if ([NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"] && !w.hidden) [self walk:w depth:0 path:@"" now:now];
}
@end
static DMCCRecorder *gCCRecorder;
@interface DMGapWatcher : NSObject
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval last, until, start;
@property (nonatomic) int frames, slow;
@end
@implementation DMGapWatcher
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval now = l.timestamp;
    if (self.last > 0) {
        double dt = (now - self.last) * 1000.0;
        self.frames++;
        if (dt > 18.0) { self.slow++; DMLog([NSString stringWithFormat:@"[gap] %6.0f ms into the run: frame took %.1f ms", (now - self.start) * 1000.0, dt]); }
    }
    self.last = now;
    if (CACurrentMediaTime() > self.until) { [l invalidate]; DMLog([NSString stringWithFormat:@"[gap] done: %d frames, %d slow (over 18 ms)", self.frames, self.slow]); }
}
@end
static DMGapWatcher *gGapWatcher;
static void DMWatchFrameGaps(double seconds) {
    gGapWatcher = [DMGapWatcher new];
    gGapWatcher.start = CACurrentMediaTime(); gGapWatcher.until = gGapWatcher.start + seconds;
    gGapWatcher.link = [CADisplayLink displayLinkWithTarget:gGapWatcher selector:@selector(tick:)];
    [gGapWatcher.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[gap] start");
}
static void DMDumpViewTree(UIView *v, int depth) {   // debug aid
    DMLog([NSString stringWithFormat:@"[atree] %*s%@ frame %@ bounds %@ transform %@ alpha %.2f hidden %d bg %@ opaque %d clips %d id %@ %p", depth * 2, "", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), NSStringFromCGRect(v.bounds), NSStringFromCGAffineTransform(v.transform), v.alpha, v.hidden, v.backgroundColor, v.opaque, v.clipsToBounds, v.accessibilityIdentifier, v]);
    if (depth < 11) for (UIView *c in v.subviews) DMDumpViewTree(c, depth + 1);
}
// Debug: every big, light-coloured view in every window right now (who draws the white during a launch?).
static void DMWhiteHunt(UIView *v, UIWindow *w, int depth) {
    CGFloat r = 0, g = 0, b = 0, a = 0;
    UIColor *bg = v.backgroundColor;
    BOOL light = bg && [bg getRed:&r green:&g blue:&b alpha:&a] && a > 0.3 && (r + g + b) / 3.0 > 0.8;
    if (!light && v.layer.backgroundColor) { UIColor *lc = [UIColor colorWithCGColor:v.layer.backgroundColor]; light = [lc getRed:&r green:&g blue:&b alpha:&a] && a > 0.3 && (r + g + b) / 3.0 > 0.8; }
    CGSize s = v.bounds.size;
    if (light && s.width * s.height > 40000.0 && !v.hidden && v.alpha > 0.05)
        DMLog([NSString stringWithFormat:@"[white] window %@ (level %.0f alpha %.2f) > %@ frame %@ alpha %.2f depth %d", NSStringFromClass([w class]), w.windowLevel, w.alpha, NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.alpha, depth]);
    if (depth < 9) for (UIView *c in v.subviews) DMWhiteHunt(c, w, depth + 1);
}
static void DMWhiteHuntAll(NSString *tag) {
    DMLog([NSString stringWithFormat:@"[white] ---- %@", tag]);
    for (UIWindow *w in DMAllWindows()) if (!w.hidden && w.alpha > 0.02) DMWhiteHunt(w, w, 0);
}
static void DMFindByClass(UIView *v, NSString *keyword, int depth, UIWindow *w) {
    NSString *cn = NSStringFromClass([v class]);
    if ([cn rangeOfString:keyword options:NSCaseInsensitiveSearch].location != NSNotFound)
        DMLog([NSString stringWithFormat:@"[class] window %@ (level %.0f) > %@ frame %@ hidden %d alpha %.2f", NSStringFromClass([w class]), w.windowLevel, cn, NSStringFromCGRect(v.frame), v.hidden, v.alpha]);
    if (depth < 10) for (UIView *c in v.subviews) DMFindByClass(c, keyword, depth + 1, w);
}
static void DMPointHunt(UIView *v, UIWindow *w, CGPoint pt, NSString *chain) {
    NSString *cn = NSStringFromClass([v class]);
    NSString *here = [chain stringByAppendingFormat:@"/%@", cn];
    CGRect fr = [v convertRect:v.bounds toCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
    if (!v.hidden && v.alpha > 0.02 && fr.size.width < 140.0 && fr.size.height < 60.0 && fr.size.width > 3.0 && CGRectContainsPoint(CGRectInset(fr, -25, -25), pt))
        DMLog([NSString stringWithFormat:@"[point] %@ lvl %.0f %@ screen-frame %@ alpha %.2f", NSStringFromClass([w class]), w.windowLevel, here.length > 220 ? [here substringFromIndex:here.length - 220] : here, NSStringFromCGRect(fr), v.alpha]);
    for (UIView *c in v.subviews) DMPointHunt(c, w, pt, here);
}
static UIView *DMFindIconView(UIView *v, NSString *bundleID) {   // the Home Screen / Dock icon view of an app (debug aid)
    if ([v isKindOfClass:objc_getClass("SBIconView")]) {
        NSString *vb = nil; @try { vb = [[v valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {}
        if ([vb isEqualToString:bundleID]) return v;
    }
    for (UIView *s in v.subviews) { UIView *f = DMFindIconView(s, bundleID); if (f) return f; }
    return nil;
}
static void DMOpenApp(NSString *bundleID) {
    if ([NSThread isMainThread] ? DMWindowedLaunch(bundleID) : NO) return;
    // Its Zetsu window is still being built (asked < 4 s ago, not on screen yet): opening it the normal way now ran it full screen AND in the new
    // window at once (iPad 2, Settings opened twice right after a respring). The window on its way is the answer.
    if ([NSThread isMainThread] && DMActiveEngine() == DMEngineZetsu && gZetsuOpening[bundleID] && CACurrentMediaTime() - gZetsuOpening[bundleID].doubleValue < 4.0
        && !DMZetsuWindowFor(bundleID) && !DMTestFlag("/tmp/msb-zetsu-nolaunchdedupe")) {
        DMLog([NSString stringWithFormat:@"[windowed] %@: opened again while its Zetsu window is still coming up: not opened full screen too", bundleID]);
        return;
    }
    if (![NSThread isMainThread]) {
        dispatch_async(dispatch_get_main_queue(), ^{ if (!DMWindowedLaunch(bundleID)) DMOpenApp(bundleID); });
        return;
    }
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
        LSApplicationWorkspace *ws = [objc_getClass("LSApplicationWorkspace") defaultWorkspace];
        BOOL ok = [ws respondsToSelector:@selector(openApplicationWithBundleID:)] && [ws openApplicationWithBundleID:bundleID];
        DMLog([NSString stringWithFormat:@"[action] open app %@, ok=%d", bundleID, ok]);
    });
}

// The Home Screen folder that holds the jailbreak apps, found by what is inside it (so renaming it
// does not matter): the folder with the most of Dopamine, TrollStore, Sileo, Zebra, Cydia.
static id DMFindJailbreakFolderIcon(NSString **nameOut) {
    id mgr = DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager");
    id root = DMCall(DMCall(mgr, @"iconModel"), @"rootFolder");
    NSSet *jb = [NSSet setWithObjects:@"com.opa334.Dopamine", @"com.opa334.TrollStore", @"org.coolstar.SileoStore",
                 @"xyz.willy.Zebra", @"com.cydiaclassic.manager", nil];
    id best = nil;
    NSInteger bestCount = 0;
    for (id list in (NSArray *)DMCall(root, @"lists")) {
        for (id icon in (NSArray *)DMCall(list, @"icons")) {
            if (![DMBoolStr(icon, @"isFolderIcon") isEqualToString:@"Y"]) continue;
            NSInteger count = 0;
            for (id inner in (NSArray *)DMCall(DMCall(icon, @"folder"), @"lists"))
                for (id leaf in (NSArray *)DMCall(inner, @"icons"))
                    if ([jb containsObject:DMCall(leaf, @"leafIdentifier")]) count++;
            if (count > bestCount) { best = icon; bestCount = count; }
        }
    }
    if (best && nameOut) *nameOut = DMCall(best, @"displayName") ?: DMCall(DMCall(best, @"folder"), @"displayName");
    return best;
}

// Scroll the Home Screen to the folder's page, then open it.
static void DMOpenJailbreakFolder(void) {
    id icon = DMFindJailbreakFolderIcon(NULL);
    id mgr = DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager");
    if (!icon || !mgr) { DMLog(@"[folder] jailbreak folder not found"); return; }
    SEL reveal = NSSelectorFromString(@"revealIcon:animated:completionHandler:");
    SEL open = NSSelectorFromString(@"openFolderIcon:location:animated:withCompletion:");
    if (![mgr respondsToSelector:open]) { DMLog(@"[folder] openFolderIcon:... is missing"); return; }
    __block BOOL opened = NO;
    void (^openIt)(void) = ^{
        if (opened) return;
        opened = YES;
        DMLog(@"[folder] opening the jailbreak folder");
        ((void (*)(id, SEL, id, id, BOOL, id))objc_msgSend)(mgr, open, icon, @"SBIconLocationRoot", YES, nil);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            DMLog([NSString stringWithFormat:@"[folder] hasOpenFolder=%@", DMBoolStr(mgr, @"hasOpenFolder")]);
        });
    };
    if ([mgr respondsToSelector:reveal]) {
        ((void (*)(id, SEL, id, BOOL, id))objc_msgSend)(mgr, reveal, icon, YES, ^{ dispatch_async(dispatch_get_main_queue(), openIt); });
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), openIt);  // if it never calls back
    } else {
        openIt();
    }
}

// ---- keyboard shortcuts sent to whatever app is in front ----
// The status bar lives in SpringBoard, so Cut/Copy/Paste cannot be called in the app directly. Instead
// this posts the same hardware-keyboard events an external keyboard would, and the app handles them
// exactly like a real Cmd+C.
typedef void *HIDClientRef;
static void DMPostKey(uint32_t usage, BOOL down) {
    static HIDClientRef client = NULL;
    static void *(*createKey)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, int, uint32_t) = NULL;
    static void (*setSender)(void *, uint64_t) = NULL;
    static void (*dispatch)(HIDClientRef, void *) = NULL;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        createKey = dlsym(iokit, "IOHIDEventCreateKeyboardEvent");
        setSender = dlsym(iokit, "IOHIDEventSetSenderID");
        dispatch = dlsym(iokit, "IOHIDEventSystemClientDispatchEvent");
        HIDClientRef (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        if (create) client = create(kCFAllocatorDefault);
        DMLog([NSString stringWithFormat:@"[keys] client=%d createKey=%d setSender=%d dispatch=%d", client != NULL, createKey != NULL, setSender != NULL, dispatch != NULL]);
    });
    if (!client || !createKey || !dispatch) return;
    if (!DMHardwareKeyboardAttached()) return;   // fake keyboard events make apps hide their on-screen keyboard
    void *event = createKey(kCFAllocatorDefault, mach_absolute_time(), 0x07, usage, down, 0);   // usage page 7: keyboard
    if (!event) return;
    if (setSender) setSender(event, 0x8000000817319372ULL);   // the id an external keyboard reports
    dispatch(client, event);
    CFRelease(event);
}

// ---- real touch injection: a genuine digitizer event, not a simulated gesture-recognizer call ----
// The FIRST attempt (this project's earlier `DMPostTouch`, and the `tap_x_y_2`/`tap_x_y_m` triggers other
// agents tried tonight on the other devices) built the same kind of IOHIDEvent as the working keyboard
// injection above and dispatched it the same way -- IOHIDEventSystemClientCreate
// + IOHIDEventSystemClientDispatchEvent -- and it worked on the second iPad (iPadOS 16.7.7) but never on the
// M1 (iPadOS 15.6.1). Root cause, found by reading Apple's OWN on-device UI test harness (WebKit's
// HIDEventGenerator.mm, the code WebKitTestRunner uses to drive real iOS hardware in Apple's CI): that whole
// system-wide dispatch path is a red herring for touches. WebKit builds the identical kind of IOHIDEvent
// (hand event + appended finger child event) but NEVER calls IOHIDEventSystemClientDispatchEvent with it --
// it stamps the event with `BKSHIDEventSetDigitizerInfo(event, contextID, ...)` (contextID = the target
// window's private `_contextId`, i.e. which window/scene the touch belongs to) and hands it straight to
// that PROCESS'S OWN `UIApplication` via the private `-_enqueueHIDEvent:` -- the exact same call backboardd
// itself makes once it has already decided which app a real touch belongs to. Keyboard events have no
// coordinate and get broadcast/routed by focus, which is why the generic system dispatch already worked for
// them; touches are inherently positional and (at least on 15.6.1) the generic system-wide path silently
// drops them without this context stamp. Since MacStatusBar's trigger code runs INSIDE SpringBoard, calling
// `-_enqueueHIDEvent:` on SpringBoard's own `[UIApplication sharedApplication]` delivers a touch exactly the
// way a real finger would to anything SpringBoard itself renders (Home Screen icons, Dock, Haptic Touch
// menus, Aerial/MilkyWay window resize handles -- all SpringBoard-hosted) with full hit-testing and gesture
// recognizer competition. It does NOT reach a separate app process (e.g. SofaScore) -- that needs the same
// `-_enqueueHIDEvent:` call made from INSIDE that app's own process (MacAppBridge, which already injects
// into every app, is the natural place to add it; not done here since this project is SpringBoard-only).
//
// Field values below are copied field-for-field from `-[HIDEventGenerator _createIOHIDEventType:]`, the
// exact method WebKit's touchDown:/moveToPoints:/liftUp: (i.e. tap AND drag) funnel through.
typedef enum { DMTouchDown, DMTouchMove, DMTouchUp, DMTouchWarm } DMTouchPhase;

// The window/scene context a synthetic touch should be stamped as belonging to. WebKit's own reference
// always uses `keyWindow` because its target is a normal single-window app; SpringBoard hosts upwards of a
// dozen windows at once (Home Screen, status bar, each MilkyWay/Aerial window, menus, the Dock, ...), and
// `keyWindow` is not reliable there (it can be nil, or an unrelated window). LIVE-CONFIRMED FIX (2026-09-23):
// an earlier version of this used a single global fallback (keyWindow, then "first visible window with a
// context" from an unordered enumeration) regardless of where the touch actually was -- that version's
// touches were provably reaching *some* real UIKit responder (`DMFocusCatcher`'s plain `touchesBegan:`,
// which does not care which window it is in, did react to an injected touch), but never any tap/button
// target that needs `-_enqueueHIDEvent:` to land in the SAME window whose own hit-testing finds it (every
// `UIControl`/icon tap tried came back negative, even at coordinates independently confirmed correct with
// the read-only `pointhunt_` trigger) -- consistent with the context stamp routing to the wrong window's
// queue while a same-process, no-context-needed responder still happened to be reachable. This version
// resolves the SAME window a real touch would hit-test to at that exact point (identical approach to the
// existing `hittest` debug trigger: topmost by window level whose bounds actually contain the point), so
// the stamped context always matches where the event needs to be examined.
static uint32_t DMTouchContextID(CGPoint p) {
    SEL ctxSel = NSSelectorFromString(@"_contextId");
    NSArray<UIWindow *> *windows = [[UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES]
        sortedArrayUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) {
            return a.windowLevel < b.windowLevel ? NSOrderedDescending : NSOrderedAscending;
        }];
    for (UIWindow *w in windows) {
        if (w.hidden || w.alpha < 0.01 || ![w respondsToSelector:ctxSel]) continue;
        CGPoint local = [w convertPoint:p fromWindow:nil];
        if (![w pointInside:local withEvent:nil]) continue;
        uint32_t cid = ((unsigned (*)(id, SEL))objc_msgSend)(w, ctxSel);
        if (cid) return cid;
    }
    // Nothing at that exact point (e.g. it is just past every window's edge) -- fall back to whatever
    // window has a context at all, so the event still has somewhere valid to go.
    for (UIWindow *w in windows) {
        if (w.hidden || ![w respondsToSelector:ctxSel]) continue;
        uint32_t cid = ((unsigned (*)(id, SEL))objc_msgSend)(w, ctxSel);
        if (cid) return cid;
    }
    return 0;
}

// EXPERIMENTAL (2026-09-23, testing a specific theory): every UIControl/tap-gesture target tried tonight
// missed (menu rows, a status bar button, a Home Screen icon, a window's own traffic-light buttons) while
// a plain `touchesBegan:`-only responder (DMFocusCatcher) reacted correctly -- consistent with real
// hit-testing consulting a location UIKit was never actually given, rather than the raw finger event's x/y
// this file already sets correctly. `BKSHIDEventDigitizerAttributes` (read-only introspected via
// `methsearch_BKSHIDEventDigitizerAttributes` and `...PathAttributes`, both real, tonight) carries a
// `pathAttributes` array of per-finger `BKSHIDEventDigitizerPathAttributes`, each with its OWN
// `hitTestLocation` -- entirely separate from the finger IOHIDEvent's own x/y. This sets it to the same
// point, once per phase, so a real hit-test path (if one specifically reads this instead of, or in
// addition to, the raw event) has a location to work with.
//
// SAFETY: `BKSHIDEventDigitizerPathAttributes` needs alloc/init to construct, which is normally a red flag
// per this project's own rules -- but unlike the `SBFloatingDockBehaviorAssertion` precedent that crashed
// SpringBoard (a lifecycle-managed object whose `dealloc` assumed a prior add/remove pairing this project
// never gave it), everything found on this class via read-only `methsearch_` is a plain value object: only
// property getters/setters (`touchIdentifier`, `hitTestLocation`, `zGradient`, ...), `isEqual:`,
// `copyWithZone:`, `appendDescriptionToFormatter:` -- no register/unregister pair, no assertion semantics,
// nothing that looks like it expects a matched teardown call. Built as a SINGLE instance per phase (never
// looped), wrapped in `@try`/`@catch`, and every step logged so a failure is immediately visible in
// `/tmp/macstatusbar.log` rather than silent.
static void DMSetDigitizerHitTestLocation(void *handEvent, CGPoint p, DMTouchPhase phase) {
    static Class pathAttrsClass = Nil;
    static BOOL classChecked = NO;
    if (!classChecked) {
        classChecked = YES;
        pathAttrsClass = objc_getClass("BKSHIDEventDigitizerPathAttributes");
        DMLog([NSString stringWithFormat:@"[touch2][hittest-loc] BKSHIDEventDigitizerPathAttributes class %@", pathAttrsClass ? @"found" : @"MISSING"]);
    }
    if (!pathAttrsClass) return;
    @try {
        id attrs = BKSHIDEventGetDigitizerAttributes(handEvent);
        if (!attrs) { DMLog(@"[touch2][hittest-loc] BKSHIDEventGetDigitizerAttributes returned nil"); return; }

        id pathAttrs = [[pathAttrsClass alloc] init];
        if (!pathAttrs) { DMLog(@"[touch2][hittest-loc] alloc/init of path attributes failed"); return; }

        if ([pathAttrs respondsToSelector:@selector(setTouchIdentifier:)])
            [pathAttrs setValue:@(2) forKey:@"touchIdentifier"];   // matches the finger's own identity/index (2) used above
        if ([pathAttrs respondsToSelector:@selector(setHitTestLocation:)])
            [pathAttrs setValue:[NSValue valueWithCGPoint:p] forKey:@"hitTestLocation"];

        if ([attrs respondsToSelector:@selector(setPathAttributes:)])
            [attrs setValue:@[pathAttrs] forKey:@"pathAttributes"];

        static int loggedCount = 0;
        if (loggedCount++ < 8) {
            DMLog([NSString stringWithFormat:@"[touch2][hittest-loc] phase %d set hitTestLocation %@ on path attrs, attached to hand attrs %@",
                   (int)phase, NSStringFromCGPoint(p), attrs]);
        }
    } @catch (NSException *e) {
        DMLog([NSString stringWithFormat:@"[touch2][hittest-loc] EXCEPTION: %@ -- %@", e.name, e.reason]);
    }
}

// One IOHIDEvent (hand + one appended finger) for one phase of a touch, delivered straight into this
// process's own UIApplication event queue. p is a plain screen point (UIScreen.mainScreen's coordinate
// space, same as everywhere else in this file) -- no coordinate-system guessing needed, unlike the old
// system-dispatch attempt's `map` parameter.
typedef void *HIDClientRef2;
static void DMSendDigitizerPhase(CGPoint p, DMTouchPhase phase) {
    static void *(*createHand)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, double, double, double, double, double, BOOL, BOOL, uint32_t) = NULL;
    static void *(*createFinger)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, uint32_t, double, double, double, double, double, BOOL, BOOL, uint32_t) = NULL;
    static void (*append)(void *, void *, uint32_t) = NULL;
    static void (*setInt)(void *, uint32_t, int) = NULL;
    static void (*setFloat)(void *, uint32_t, double) = NULL;
    static void (*setSender)(void *, uint64_t) = NULL;
    static void (*sysDispatch)(HIDClientRef2, void *) = NULL;
    static HIDClientRef2 sysClient = NULL;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        createHand = dlsym(iokit, "IOHIDEventCreateDigitizerEvent");
        createFinger = dlsym(iokit, "IOHIDEventCreateDigitizerFingerEvent");
        append = dlsym(iokit, "IOHIDEventAppendEvent");
        setInt = dlsym(iokit, "IOHIDEventSetIntegerValue");
        setFloat = dlsym(iokit, "IOHIDEventSetFloatValue");
        setSender = dlsym(iokit, "IOHIDEventSetSenderID");
        sysDispatch = dlsym(iokit, "IOHIDEventSystemClientDispatchEvent");
        HIDClientRef2 (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        if (create) sysClient = create(kCFAllocatorDefault);
        DMLog([NSString stringWithFormat:@"[touch2] hand=%d finger=%d append=%d setInt=%d setFloat=%d enqueue=%d sysClient=%d sysDispatch=%d",
               createHand != NULL, createFinger != NULL, append != NULL, setInt != NULL, setFloat != NULL,
               [[UIApplication sharedApplication] respondsToSelector:NSSelectorFromString(@"_enqueueHIDEvent:")],
               sysClient != NULL, sysDispatch != NULL]);
    });
    if (!createHand || !createFinger || !append) return;
    UIApplication *app = [UIApplication sharedApplication];
    SEL enqueueSel = NSSelectorFromString(@"_enqueueHIDEvent:");
    BOOL canEnqueue = [app respondsToSelector:enqueueSel];
    uint32_t contextID = DMTouchContextID(p);
    if (!contextID) { DMLog(@"[touch2] no window context available"); return; }

    // kIOHIDDigitizerEventTouch=0x2, ...Position=0x4, ...Identity=0x20, ...Attribute=0x40 (from the real
    // IOHIDEventTypes.h enum, cross-checked against KIF's and WebKit's own copies of the same header).
    uint32_t mask; BOOL hasFinger;
    switch (phase) {
        case DMTouchDown: mask = 0x2 | 0x20; hasFinger = YES; break;                 // touch | identity, range still up
        case DMTouchMove: mask = 0x4 | 0x40; hasFinger = YES; break;                 // position | attribute
        default:          mask = 0x2 | 0x20; hasFinger = NO;  break;                 // touch | identity, lifting
    }
    BOOL handTouching = hasFinger;   // "hand" (the whole gesture) is touching whenever the finger is down or moving

    uint64_t now = mach_absolute_time();
    void *hand = createHand(kCFAllocatorDefault, now, 3 /* kIOHIDDigitizerTransducerTypeHand */, 0, 0, mask, 0, 0, 0, 0, 0, 0, NO, handTouching, 0);
    if (!hand) return;
    if (setInt) setInt(hand, 0xb0019, 1);   // kIOHIDEventFieldDigitizerIsDisplayIntegrated

    void *finger = createFinger(kCFAllocatorDefault, now, 2, 2, mask, p.x, p.y, 0, 0, 0, hasFinger, hasFinger, 0);
    if (finger) {
        if (setFloat) {
            setFloat(finger, 0xb0014, 5.0);   // kIOHIDEventFieldDigitizerMajorRadius
            setFloat(finger, 0xb0015, 5.0);   // kIOHIDEventFieldDigitizerMinorRadius
            setFloat(finger, 0xb001a, 0.0);   // kIOHIDEventFieldDigitizerQualityRadiiAccuracy
        }
        append(hand, finger, 0);
        CFRelease(finger);
    }

    // Stamp the target window/scene context either way (harmless for the system-dispatch path, required
    // for -_enqueueHIDEvent:). Two delivery paths are tried because it is not yet confirmed on 15.6.1 which
    // one UIKit actually honours for a self-injected digitizer event: -_enqueueHIDEvent: is what WebKit's
    // own real-device UI test harness uses (see the long comment above), but that harness runs inside a
    // process launched under testmanagerd, which may carry a debugger/test entitlement that plain SpringBoard
    // does not have even under a jailbreak's codesign bypass -- if so it would silently no-op exactly like
    // what was observed live (no crash, no effect). The system-wide client dispatch is what the working
    // keyboard injection above already uses successfully on this exact device, so pairing it with the same
    // context stamp (which the OLD, broken touch attempt never set) is the other real candidate.
    BKSHIDEventSetDigitizerInfo(hand, contextID, 0, 0, NULL, 0, 0);
    if (setSender) setSender(hand, 0xDEFACEDBEEFFECE5ULL);
    DMSetDigitizerHitTestLocation(hand, p, phase);
    // Only ONE delivery path is used per call, not both: sending the same down/up through two independent
    // pipelines (the system-wide HID client AND direct in-process enqueue) risks UIKit seeing two unrelated
    // touch-tracking sessions instead of one continuous gesture, which would explain a real, reproducible
    // symptom found live -- DMFocusCatcher's plain `touchesBegan:` (fires on contact alone, no down/up
    // continuity needed) reacted correctly to an injected touch, but every `UIControl`/tap-gesture target
    // tried (menu rows, a status bar button, a Home Screen icon) did not, even at coordinates independently
    // confirmed correct via the read-only `pointhunt_` trigger. `-_enqueueHIDEvent:` alone is what WebKit's
    // own real-device UI test harness uses for exactly this (real taps AND drags), so it is tried first,
    // cleanly, with the system-wide dispatch only as a fallback if this process ever lacks the selector,
    // rather than sent alongside it.
    if (canEnqueue) {
        ((void (*)(id, SEL, void *))objc_msgSend)(app, enqueueSel, hand);
    } else if (sysClient && sysDispatch) {
        DMLog(@"[touch2] no _enqueueHIDEvent:, falling back to system-wide dispatch");
        sysDispatch(sysClient, hand);
    }
    CFRelease(hand);
}

// ---- single tap: down, a short real hold, up ----
static void DMInjectTap(CGPoint p) {
    DMLog([NSString stringWithFormat:@"[touch2] tap at (%.0f, %.0f)", p.x, p.y]);
    dispatch_async(dispatch_get_main_queue(), ^{
        DMSendDigitizerPhase(p, DMTouchDown);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(70 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{
            DMSendDigitizerPhase(p, DMTouchUp);
            DMLog(@"[touch2] tap complete");
        });
    });
}

// ---- drag: down at `from`, a real-time-paced sequence of move events tracing a straight line to `to`
// over `durationMs`, then up. Steps are ~16ms apart (60Hz, matching a real touch's report rate) so a
// resize handle or a system gesture recognizer that looks at velocity/duration sees a real-looking drag,
// not a single instantaneous jump. Chained via dispatch_after on the main queue (never blocks/sleeps a
// thread) because -_enqueueHIDEvent: -- like any UIApplication/UIKit call -- must happen on the main thread. ----
static void DMInjectDragStep(CGPoint from, CGPoint to, int stepIndex, int stepCount, double stepMs) {
    if (stepIndex <= 0) {
        DMSendDigitizerPhase(from, DMTouchDown);
    } else if (stepIndex >= stepCount) {
        DMSendDigitizerPhase(to, DMTouchUp);
        DMLog(@"[touch2] drag complete");
        return;
    } else {
        double t = (double)stepIndex / (double)stepCount;
        DMSendDigitizerPhase(CGPointMake(from.x + (to.x - from.x) * t, from.y + (to.y - from.y) * t), DMTouchMove);
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(stepMs * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{
        DMInjectDragStep(from, to, stepIndex + 1, stepCount, stepMs);
    });
}
static void DMInjectDrag(CGPoint from, CGPoint to, double durationMs) {
    int stepCount = MAX(2, (int)(durationMs / 16.0));
    double stepMs = durationMs / stepCount;
    DMLog([NSString stringWithFormat:@"[touch2] drag (%.0f,%.0f) -> (%.0f,%.0f) over %.0fms, %d steps",
           from.x, from.y, to.x, to.y, durationMs, stepCount]);
    dispatch_async(dispatch_get_main_queue(), ^{
        DMInjectDragStep(from, to, 0, stepCount, stepMs);
    });
}

// ---- system-wide touch injection (debug; tapsys_ / dragsys_): the touch goes to backboardd, which routes it like a real finger ----
// DMSendDigitizerPhase above enqueues the event into SpringBoard's own UIApplication, so it can only ever reach SpringBoard's windows -- never an app
// shown in an Aerial window (another process). Here the same digitizer event (hand + finger) is dispatched system-wide with the position NORMALISED
// (0..1) in the display's native portrait space, with no SpringBoard context stamp, so backboardd hit-tests it and delivers it to whichever
// process owns that point.
static uint64_t gSysTouchSenderOverride = 0;   // debug (tapsysid_): try another sender ID
// The sender ID must be the built-in touch screen's own HID service (its registry ID): iOS 15 (M1) drops a digitizer event from any other sender -- with
// the fixed 0x10000027F nothing reached any app, with the M1's touch screen ID (0x1000007b3, found by the hidservices trigger) taps landed exactly. iOS 16
// (iPad 2) accepted 0x10000027F. So it is looked up once: the event system's service on usage page 13 (digitizer), usage 4 (touch screen), built in; the
// old constant stays as the fallback.
static uint64_t DMTouchscreenSenderID(void *client) {
    static uint64_t sender = 0;
    if (sender) return sender;
    sender = 0x000000010000027FULL;
    void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
    CFArrayRef (*copyServices)(void *) = dlsym(iokit, "IOHIDEventSystemClientCopyServices");
    CFTypeRef (*copyProp)(void *, CFStringRef) = dlsym(iokit, "IOHIDServiceClientCopyProperty");
    CFTypeRef (*regID)(void *) = dlsym(iokit, "IOHIDServiceClientGetRegistryID");
    CFArrayRef list = (client && copyServices && copyProp && regID) ? copyServices(client) : NULL;
    for (CFIndex i = 0; list && i < CFArrayGetCount(list); i++) {
        void *svc = (void *)CFArrayGetValueAtIndex(list, i);
        NSNumber *page = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsagePage"))), *usage = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsage")));
        NSNumber *builtIn = CFBridgingRelease(copyProp(svc, CFSTR("Built-In")));
        if (page.intValue != 13 || usage.intValue != 4 || (builtIn && !builtIn.boolValue)) continue;
        CFTypeRef r = regID(svc);
        uint64_t v = (r && CFGetTypeID(r) == CFNumberGetTypeID()) ? [(__bridge NSNumber *)r unsignedLongLongValue] : 0;
        DMLog([NSString stringWithFormat:@"[touchsys] touch screen candidate: built-in %@, registry ID 0x%llx", builtIn, v]);
        // (iPad 2, after a long idle: this once gave a different nonsense value on every start, 0x109296e300000 / 0x13b0577300000, and every
        // injected touch went nowhere; real registry IDs are small, 0x1_0000_xxxx)
        if (v && v < 0x1000000000ULL) { sender = v; break; }
    }
    if (list) CFRelease(list);
    DMLog([NSString stringWithFormat:@"[touchsys] touch screen sender ID 0x%llx", sender]);
    return sender;
}
static BOOL gDMSysTouchNativeZero = NO;
static uint32_t gDMSysTouchIdentity = 2;   // (tapjump_<x>_<y>_newid: the (0, 0) report comes with another finger identity, like the 20:21 miss)
static void DMSysTouch(CGPoint screenPoint, DMTouchPhase phase) {
    static void *(*createHand)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, double, double, double, double, double, BOOL, BOOL, uint32_t) = NULL;
    static void *(*createFinger)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, uint32_t, double, double, double, double, double, BOOL, BOOL, uint32_t) = NULL;
    static void (*append)(void *, void *, uint32_t) = NULL;
    static void (*setInt)(void *, uint32_t, int) = NULL;
    static void (*setFloat)(void *, uint32_t, double) = NULL;
    static void (*setSender)(void *, uint64_t) = NULL;
    static void (*sysDispatch)(HIDClientRef2, void *) = NULL;
    static HIDClientRef2 sysClient = NULL;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        createHand = dlsym(iokit, "IOHIDEventCreateDigitizerEvent");
        createFinger = dlsym(iokit, "IOHIDEventCreateDigitizerFingerEvent");
        append = dlsym(iokit, "IOHIDEventAppendEvent");
        setInt = dlsym(iokit, "IOHIDEventSetIntegerValue");
        setFloat = dlsym(iokit, "IOHIDEventSetFloatValue");
        setSender = dlsym(iokit, "IOHIDEventSetSenderID");
        sysDispatch = dlsym(iokit, "IOHIDEventSystemClientDispatchEvent");
        HIDClientRef2 (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        if (create) sysClient = create(kCFAllocatorDefault);
    });
    if (!createHand || !createFinger || !append || !sysClient || !sysDispatch) { DMLog(@"[touchsys] IOKit functions missing"); return; }
    if (phase == DMTouchWarm) { DMTouchscreenSenderID(sysClient); return; }   // only the one-time set-up (see DMSysTouchReady)
    CGSize screen = [UIScreen mainScreen].bounds.size;
    CGSize native = CGSizeMake(MIN(screen.width, screen.height), MAX(screen.width, screen.height));
    CGPoint n = DMScreenToNative(screenPoint, DMRealInterfaceOrientation(), native);
    double nx = n.x / native.width, ny = n.y / native.height;
    if (gDMSysTouchNativeZero) nx = ny = 0.0;   // (tapjump_: the touch screen's bogus mid-touch report at its own (0, 0))
    uint32_t mask; BOOL down;
    switch (phase) {
        case DMTouchDown: mask = 0x2 | 0x20; down = YES; break;
        case DMTouchMove: mask = 0x4 | 0x40; down = YES; break;
        default:          mask = 0x2 | 0x20; down = NO;  break;
    }
    uint64_t now = mach_absolute_time();
    void *hand = createHand(kCFAllocatorDefault, now, 3, 0, 0, mask, 0, nx, ny, 0, 0, 0, NO, down, 0);
    if (!hand) return;
    if (setInt) setInt(hand, 0xb0019, 1);   // display integrated
    void *finger = createFinger(kCFAllocatorDefault, now, 2, gDMSysTouchIdentity, mask, nx, ny, 0, down ? 0.5 : 0, 0, down, down, 0);
    if (finger) {
        if (setFloat) { setFloat(finger, 0xb0014, 0.04); setFloat(finger, 0xb0015, 0.04); }
        append(hand, finger, 0);
        CFRelease(finger);
    }
    if (setSender) setSender(hand, gSysTouchSenderOverride ? gSysTouchSenderOverride : DMTouchscreenSenderID(sysClient));
    sysDispatch(sysClient, hand);
    CFRelease(hand);
}
// The first injected touch after SpringBoard starts used to go wrong (it landed at (0, 768), and once it stayed down: a long press on the Dock
// put the Home Screen into jiggle mode) -- the one-time look-up of the touch screen's sender ID ran while that first touch was being sent. So the
// set-up is done first and the first touch goes 0.4 s later; every later touch goes at once.
static void DMSysTouchReady(void (^go)(void)) {
    static BOOL warm = NO;
    if (warm) { go(); return; }
    warm = YES;
    DMSysTouch(CGPointZero, DMTouchWarm);
    // and a first, throw-away tap where it does nothing -- the first touch itself still got lost now and then (iPad 2: a red light press that did
    // nothing). It used to go to the empty middle of the status bar (y = 6); in landscape, right after a respring, that first touch at the top edge
    // brought the Cover Sheet down (iPad 2 cross-test, reproduced twice). Now it goes to the middle of the screen, onto a small invisible window of
    // ours that swallows it, so it can do nothing in any orientation.
    CGSize sc = [UIScreen mainScreen].bounds.size;
    CGPoint idle = CGPointMake(round(sc.width / 2.0), round(sc.height / 2.0));
    static UIWindow *shield = nil;
    {
        UIWindowScene *scene = MSBDMainWindowScene();   // (on the iPad's own screen, where the throw-away touch goes)
        shield = scene ? [[UIWindow alloc] initWithWindowScene:scene] : [[UIWindow alloc] initWithFrame:[UIScreen mainScreen].bounds]; DMSnapInvalidate();
        shield.frame = CGRectMake(idle.x - 60.0, idle.y - 60.0, 120.0, 120.0);
        shield.windowLevel = 100000.0;
        UIViewController *vc = [UIViewController new];
        UIControl *eat = [[UIControl alloc] initWithFrame:shield.bounds];
        eat.backgroundColor = [UIColor colorWithWhite:0 alpha:0.011];   // (not clear: a clear view can let the touch through)
        [eat addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMLog(@"[touchsys] the throw-away tap landed on our shield"); }] forControlEvents:UIControlEventTouchDown];
        vc.view = eat;
        shield.rootViewController = vc;
        shield.hidden = NO;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ shield.hidden = YES; shield = nil; });
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSysTouch(idle, DMTouchDown); });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.28 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSysTouch(idle, DMTouchUp); });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.42 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSysTouch(idle, DMTouchUp); });
    DMLog([NSString stringWithFormat:@"[touchsys] set up (first injected touch since SpringBoard started): a throw-away tap at %@, then the real one in 0.9 s", NSStringFromCGPoint(idle)]);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.9 * NSEC_PER_SEC)), dispatch_get_main_queue(), go);
}
// The first touches after SpringBoard starts can also lose their finger-up (seen twice on the iPad 2: a tap became a long press and put the Home
// Screen into jiggle mode; a tap on a title bar stayed down and the NEXT tap dragged that window across the screen). For the first few touches the
// finger-up is sent a second time 120 ms later: a lone extra finger-up with no finger down does nothing.
static void DMSysTouchSecondUp(CGPoint p) {
    static int count = 0;
    if (count++ >= 4) return;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSysTouch(p, DMTouchUp); });
}
static double gSysTapHoldMs = 80;   // tapsys_<x>_<y>_<ms>: how long the finger stays down (default 80 ms)
static void DMSysTap(CGPoint p) {
    DMLog([NSString stringWithFormat:@"[touchsys] tap at (%.0f, %.0f), orientation %ld", p.x, p.y, DMRealInterfaceOrientation()]);
    DMSysTouch(p, DMTouchDown);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(gSysTapHoldMs * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(p, DMTouchUp); DMSysTouchSecondUp(p); });
}
static double gSysDragEndHoldMs = 0;   // (dragsys_'s 7th value: the finger rests at the end before it lifts -- spring-loaded folders, hovering)
static void DMSysDrag(CGPoint from, CGPoint to, double ms, double holdMs) {   // holdMs: the finger rests first (a table's grab handle, a long press)
    int steps = MAX(4, (int)(ms / 16.0));
    DMLog([NSString stringWithFormat:@"[touchsys] drag (%.0f,%.0f) -> (%.0f,%.0f) in %.0f ms after a %.0f ms hold", from.x, from.y, to.x, to.y, ms, holdMs]);
    DMSysTouch(from, DMTouchDown);
    for (int i = 1; i <= steps; i++) {
        CGPoint q = CGPointMake(from.x + (to.x - from.x) * i / steps, from.y + (to.y - from.y) * i / steps);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((holdMs + ms / steps * i) * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(q, DMTouchMove); });
    }
    double endHold = gSysDragEndHoldMs; gSysDragEndHoldMs = 0;
    for (double t = 100; t < endHold; t += 100)   // (resting: small still moves keep the touch alive, as a finger's do)
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((holdMs + ms + t) * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(to, DMTouchMove); });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((holdMs + ms + 30 + endHold) * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(to, DMTouchUp); DMSysTouchSecondUp(to); });
}

#define HID_KEY_A 0x04
#define HID_KEY_C 0x06
#define HID_KEY_F 0x09
#define HID_KEY_V 0x19
#define HID_KEY_X 0x1B
#define HID_KEY_Z 0x1D
#define HID_LEFT_SHIFT 0xE1
#define HID_LEFT_COMMAND 0xE3

static void DMSendShortcut(uint32_t usage, BOOL shift) {
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
        if (shift) DMPostKey(HID_LEFT_SHIFT, YES);
        DMPostKey(HID_LEFT_COMMAND, YES);
        usleep(15000);
        DMPostKey(usage, YES);
        usleep(15000);
        DMPostKey(usage, NO);
        usleep(15000);
        DMPostKey(HID_LEFT_COMMAND, NO);
        if (shift) DMPostKey(HID_LEFT_SHIFT, NO);
        DMLog([NSString stringWithFormat:@"[keys] sent %@Cmd+usage 0x%02x", shift ? @"Shift+" : @"", usage]);
    });
}

// ---- debug (Keyboard Phase): keys_<spec> presses keys like a hardware keyboard, for tests ----
// spec: tokens separated by ','; a token is modifiers joined with '-' then the key, e.g. "c-space" (Cmd+Space), "c-tab", "c-h", "g-h" (globe+H),
// "s-a", "hello" (types the letters one by one), "ret", "esc", "del", "up"/"down"/"left"/"right", "p<ms>" pauses, "hold-c-<ms>" holds Cmd.
// Modifiers: c Cmd, s Shift, a Option, t Control, g globe/Fn. Only while a hardware keyboard is attached, unless the spec starts with "force," (see DMPostKey).
static void DMPostKeyRaw(uint32_t page, uint32_t usage, BOOL down) {
    static HIDClientRef client = NULL;
    static void *(*createKey)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, int, uint32_t) = NULL;
    static void (*setSender)(void *, uint64_t) = NULL;
    static void (*dispatchEv)(HIDClientRef, void *) = NULL;
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        createKey = dlsym(iokit, "IOHIDEventCreateKeyboardEvent");
        setSender = dlsym(iokit, "IOHIDEventSetSenderID");
        dispatchEv = dlsym(iokit, "IOHIDEventSystemClientDispatchEvent");
        HIDClientRef (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        if (create) client = create(kCFAllocatorDefault);
    });
    if (!client || !createKey || !dispatchEv) return;
    void *event = createKey(kCFAllocatorDefault, mach_absolute_time(), page, usage, down, 0);
    if (!event) return;
    if (setSender) setSender(event, 0x8000000817319372ULL);
    dispatchEv(client, event);
    CFRelease(event);
}
static uint32_t DMUsageForKeyName(NSString *k) {
    if (k.length == 1) {
        unichar ch = [k characterAtIndex:0];
        if (ch >= 'a' && ch <= 'z') return 0x04 + (ch - 'a');
        if (ch >= '1' && ch <= '9') return 0x1E + (ch - '1');
        if (ch == '0') return 0x27;
        if (ch == '_') return 0x2C;   // (a space inside a word: "_")
        if (ch == '.') return 0x37;
        if (ch == '/') return 0x38;
        if (ch == '`') return 0x35;
    }
    NSDictionary *named = @{@"ret": @0x28, @"esc": @0x29, @"del": @0x2A, @"tab": @0x2B, @"space": @0x2C, @"right": @0x4F, @"left": @0x4E, @"down": @0x51, @"up": @0x52,
                            @"f1": @0x3A, @"caps": @0x39, @"period": @0x37, @"slash": @0x38, @"grave": @0x35, @"comma": @0x36};
    NSNumber *n = named[k];
    return n ? n.unsignedIntValue : 0;
}
static void DMKeysSpec(NSString *spec) {
    BOOL force = [spec hasPrefix:@"force,"];
    if (force) spec = [spec substringFromIndex:6];
    if (!force && !DMHardwareKeyboardAttached()) { DMLog(@"[keys] keys_ skipped: no hardware keyboard (use keys_force,...)"); return; }
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
        for (NSString *tok in [spec componentsSeparatedByString:@","]) {
            if (!tok.length) continue;
            if ([tok hasPrefix:@"p"] && tok.length > 1 && isdigit([tok characterAtIndex:1])) { usleep((useconds_t)([[tok substringFromIndex:1] intValue] * 1000)); continue; }
            BOOL hold = [tok hasPrefix:@"hold-"];
            NSArray *parts = [(hold ? [tok substringFromIndex:5] : tok) componentsSeparatedByString:@"-"];
            NSString *key = parts.lastObject;
            NSMutableArray *mods = [NSMutableArray array];   // (page, usage) pairs
            for (NSUInteger i = 0; i + 1 < parts.count; i++) {
                NSString *m = parts[i];
                if ([m isEqualToString:@"c"]) [mods addObject:@[@7, @0xE3]];
                else if ([m isEqualToString:@"s"]) [mods addObject:@[@7, @0xE1]];
                else if ([m isEqualToString:@"a"]) [mods addObject:@[@7, @0xE2]];
                else if ([m isEqualToString:@"t"]) [mods addObject:@[@7, @0xE0]];
                else if ([m isEqualToString:@"g"]) [mods addObject:@[@0xFF, @0x03]];   // Apple vendor top-case page: Fn / globe
            }
            for (NSArray *m in mods) { DMPostKeyRaw([m[0] unsignedIntValue], [m[1] unsignedIntValue], YES); usleep(15000); }
            if (hold) { usleep((useconds_t)([key intValue] * 1000)); }
            else if (mods.count == 0 && key.length > 1 && !DMUsageForKeyName(key)) {   // a word: its letters one by one
                for (NSUInteger i = 0; i < key.length; i++) {
                    uint32_t u = DMUsageForKeyName([key substringWithRange:NSMakeRange(i, 1)]);
                    if (!u) continue;
                    DMPostKeyRaw(7, u, YES); usleep(12000); DMPostKeyRaw(7, u, NO); usleep(25000);
                }
            } else {
                uint32_t u = DMUsageForKeyName(key);
                if (u) { DMPostKeyRaw(7, u, YES); usleep(20000); DMPostKeyRaw(7, u, NO); usleep(15000); }
                else if (!mods.count) DMLog([NSString stringWithFormat:@"[keys] unknown key %@", key]);
            }
            for (NSArray *m in mods.reverseObjectEnumerator) { DMPostKeyRaw([m[0] unsignedIntValue], [m[1] unsignedIntValue], NO); usleep(15000); }
            usleep(60000);
        }
        DMLog([NSString stringWithFormat:@"[keys] keys_ sent: %@%@", force ? @"(forced) " : @"", spec]);
    });
}

// What kind of thing is on the clipboard, WITHOUT reading it. Reading the contents (pb.strings, pb.string, ...) makes
// iOS announce "pasted from ..." every time, and this runs whenever the Edit menu is opened or hovered. numberOfItems
// and the hasStrings/hasImages/hasURLs checks do not trigger that notice.
static NSString *DMClipboardSummary(void) {
    UIPasteboard *pb = [UIPasteboard generalPasteboard];
    if (pb.numberOfItems == 0) return @"Clipboard is empty";
    if (pb.hasStrings) return @"Clipboard: text";
    if (pb.hasImages) return @"Clipboard: image";
    if (pb.hasURLs) return @"Clipboard: link";
    return @"Clipboard: other data";
}

// Opens a drop-down under a menu title: an overlay to catch outside taps, the panel, and the highlight pill.
static void DMPresentMenu(UIButton *btn, const void *labelKey, const void *pillKey, NSArray *items) {
    // On the Lock Screen and the Cover Sheet (iOS reports both as UI-locked) the menus stay shut (M1 pipeline 2026-09-24): the menu window sits under the Cover Sheet, so a tap on a menu title there
    // opened a menu nobody could see (it showed up after unlocking), and nothing in the menus is meant to be used before unlocking anyway.
    { id lm = DMSBManager("SBLockScreenManager"); if (DMLockUp(lm)) { DMLog(@"[menu] the Lock Screen or Cover Sheet is up: menu not opened"); return; } }
    UIView *fg = btn.superview;
    UIView *host = DMHostFor(fg);
    if (!host) return;
    UIControl *o = DMMakeOverlay(host, 0.0);
    [o addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMCloseOverlay(); }]
        forControlEvents:UIControlEventTouchUpInside];
    DMAttachMenuHover(o, fg, host, btn);

    UIView *panel = DMMakePanel(items);
    CGRect anchor = DMConvertToHost(fg, btn.frame, host);
    CGRect pf = panel.frame;
    pf.origin = CGPointMake(DMMenuOriginX(fg, host, anchor, pf.size.width), CGRectGetMaxY(anchor) + 2.0);
    panel.frame = pf;
    [o addSubview:panel];

    gPill = objc_getAssociatedObject(fg, pillKey);
    gPill.backgroundColor = [[(UILabel *)objc_getAssociatedObject(fg, labelKey) textColor] colorWithAlphaComponent:0.25];
    gPill.hidden = NO;

    { id lab = objc_getAssociatedObject(fg, labelKey); DMLogMenuGeometry([lab isKindOfClass:[UILabel class]] ? ([(UILabel *)lab text] ?: @"?") : @"icon", fg, btn, host, panel); }
    panel.alpha = 0.0;
    [UIView animateWithDuration:0.10 animations:^{ panel.alpha = 1.0; }];
    static int styleLogs = 0;
    if (styleLogs++ < 6) DMLog([NSString stringWithFormat:@"[style] menu opened: window style=%ld, system (screen) style=%ld, menu uses %ld",
                                (long)host.window.traitCollection.userInterfaceStyle, (long)[UIScreen mainScreen].traitCollection.userInterfaceStyle,
                                (long)o.traitCollection.userInterfaceStyle]);
}

static BOOL gNativeAway = NO;   // (the native windows are faded out for the App Library / App Switcher, DMNativeTick)
// Finder's switch (com.besiktasliseba.macstatusbar finderEnabled, on unless set; Settings > Mac Status Bar > Finder): DMFinderApplyPref. Off -- by
// the user, or by the crash guard after a crash in Finder's code (tools/crashmap-rules.txt, target finder) --: no Finder windows, and Finder's rows
// leave the menus; its hooks are only installed once it is on.
static BOOL gFinderOn = NO;
#include "NativeWindow.h"   // (our own Mac windows in SpringBoard, 2026-09-30)
#include "Finder.h"         // (the first one: Finder)
#include "WiFiMenu.h"       // (the Wi-Fi menu: Settings > Status Bar > Wi-Fi Menu, 2 Oct 2026)
#include "TextWindow.h"     // (plain text files: a TextEdit-style window)
#include "Desktop.h"        // (Finder's desktop: the Desktop folder's icons on the Home Screen's first page)
static void DMNativeMenuBarChanged(void) { for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout]; }
static DMRow *DMFinderRow(NSString *title, NSString *keys, BOOL enabled, void (^h)(DMFinderWindow *f)) {
    DMRow *r = [[DMRow alloc] initWithTitle:title enabled:enabled handler:DMCloseThen(^{ DMFinderWindow *f = DMFinderFront(); if (f) h(f); })];
    r.hint = keys;
    return r;
}
static void DMOpenFinderFileMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    DMFinderWindow *f = DMFinderFront(); BOOL sel = [f dm_selectedItem] != nil;
    BOOL change = sel && [f dm_canChangeSelection], here = f && [f dm_canWriteHere], inTrash = f && DMFinderInOwnTrash(f.path);   // (read-only places: greyed, as on a Mac)
    NSArray *items = @[
        [[DMRow alloc] initWithTitle:@"New Finder Window" enabled:YES handler:DMCloseThen(^{ DMFinderOpen(nil, YES); })],
        DMFinderRow(@"New Folder", @"⇧⌘N", here, ^(DMFinderWindow *w) { [w dm_newFolder]; }),
        DMFinderRow(@"New Text File", nil, here, ^(DMFinderWindow *w) { [w dm_newTextFile]; }),
        [NSNull null],
        DMFinderRow(@"Open", @"⌘O", sel, ^(DMFinderWindow *w) { [w dm_openSelected]; }),
        DMFinderRow(@"Quick Look", @"Space", sel, ^(DMFinderWindow *w) { [w dm_quickLookSelected]; }),
        DMFinderRow(@"Get Info", @"⌘I", sel, ^(DMFinderWindow *w) { [w dm_infoSelected]; }),
        DMFinderRow(@"Rename", @"\u21A9\uFE0E", change && [f dm_selectedItems].count == 1, ^(DMFinderWindow *w) { [w dm_renameSelected]; }),
        DMFinderRow(@"Duplicate", @"⌘D", sel && here, ^(DMFinderWindow *w) { [w dm_duplicateSelected]; }),
        [NSNull null],
        inTrash ? DMFinderRow(@"Put Back", @"⌘⌫", sel, ^(DMFinderWindow *w) { [w dm_trashSelected]; })
                : DMFinderRow(@"Move to Trash", @"⌘⌫", change, ^(DMFinderWindow *w) { [w dm_trashSelected]; }),
        [NSNull null],
        DMFinderRow(@"Close Window", @"⌘W", f != nil, ^(DMFinderWindow *w) { [w close]; }),
    ];
    DMPresentMenu(btn, kFileLabelKey, kFilePillKey, items);
}
// The Window menu while a native window is active: Minimize / Zoom, the same layouts as for app windows (placed in the desktop above the Dock),
// and the native windows by name -- a minimized one comes back from here.
static void DMOpenNativeWindowMenu(UIButton *btn) {
    DMNativeWindow *w = DMNativeActiveApp();
    NSMutableArray *items = [NSMutableArray array];
    DMRow *(^R)(NSString *, NSString *, dispatch_block_t) = ^DMRow *(NSString *t, NSString *k, dispatch_block_t h) { DMRow *r = [[DMRow alloc] initWithTitle:t enabled:w != nil handler:DMCloseThen(h)]; r.hint = k; return r; };
    [items addObject:R(@"Minimize", @"⌘M", ^{ [w minimize]; })];
    [items addObject:R(@"Zoom", nil, ^{ [w zoom]; })];
    [items addObject:[NSNull null]];
    NSArray *sections = @[ @[ @[@"Fill Screen", @"fill"], @[@"Center", @"center"] ],
                           @[ @[@"Left Half", @"left"], @[@"Right Half", @"right"], @[@"Top Half", @"top"], @[@"Bottom Half", @"bottom"] ],
                           @[ @[@"Top Left", @"topleft"], @[@"Top Right", @"topright"], @[@"Bottom Left", @"bottomleft"], @[@"Bottom Right", @"bottomright"] ] ];
    for (NSArray *sec in sections) {
        for (NSArray *e in sec) {
            NSString *name = e[1];
            [items addObject:R(e[0], nil, ^{
                CGRect f = DMLayoutFrameInArea(name, DMNativeDesktop(), [UIScreen mainScreen].bounds.size);
                if (CGRectIsNull(f) || CGRectIsEmpty(f)) return;
                w.restoreFrame = CGRectNull;
                w.layoutName = [name isEqualToString:@"center"] ? nil : name;   // (kept for a turn: DMNativeRelayoutForTurn)
                MSBAnimate(0.2, 0, 0, UIViewAnimationOptionCurveEaseOut, ^{ w.frame = f; }, nil);
            })];
        }
        [items addObject:[NSNull null]];
    }
    [items addObject:R(@"Bring All to Front", nil, ^{ for (DMNativeWindow *x in [gNativeWindows copy]) if (!x.hidden) [x.superview bringSubviewToFront:x]; [w activate]; })];
    [items addObject:[NSNull null]];
    for (DMNativeWindow *x in [gNativeWindows copy]) {
        DMRow *r = [[DMRow alloc] initWithTitle:x.title ?: @"Finder" enabled:YES handler:DMCloseThen(^{ [x show]; })];
        r.checked = x == w;
        [items addObject:r];
    }
    DMPresentMenu(btn, kWinLabelKey, kWinPillKey, items);
}
static void DMOpenFinderViewMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    DMFinderWindow *f = DMFinderFront();
    NSArray *items = @[
        DMFinderRow(@"as Icons", @"⌘1", f != nil, ^(DMFinderWindow *w) { [w dm_setIcons:YES]; }),
        DMFinderRow(@"as List", @"⌘2", f != nil, ^(DMFinderWindow *w) { [w dm_setIcons:NO]; }),
        [NSNull null],
        DMFinderRow([f dm_showsHidden] ? @"Hide Hidden Files" : @"Show Hidden Files", @"⇧⌘.", f != nil, ^(DMFinderWindow *w) { [w dm_toggleHidden]; }),
    ];
    DMPresentMenu(btn, kViewLabelKey, kViewPillKey, items);
}
static NSString *DMNativeActiveAppName(void) { return DMNativeActiveApp().appName; }
// (every tick: the native windows' level follows the engine's window layer, which moves; after a turn they are kept inside the new desktop)
static void DMNativeTick(void) {
    DMDesktopTick();   // (the desktop: on page 1 while wanted, out of the way in jiggle mode)
    if (gNativeFocusLock && !DMNativeActiveApp()) DMNativeFocus(NO);   // (safety net: the keyboard lock is only ever held while a native window is active)
    if (!gNativeLayer || gNativeLayer.hidden) return;
    {   // (the App Library, a Home Screen icon menu or the App Switcher takes over the screen: the native windows fade out of its way, like the
        //  engines' windows (DMSyncWindowFade) -- Finder stayed over the App Library, 30 Sep -- and come back when it is gone)
        BOOL away = DMLibraryVisible() || gHomeMenuOpen || DMSwitcherVisible();
        if (away != gNativeAway) {
            gNativeAway = away;
            if (away && gNativeActive) DMNativeSetActive(nil);
            gNativeRotator.userInteractionEnabled = !away;
            [UIView animateWithDuration:away ? 0.16 : 0.22 delay:0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState
                             animations:^{ gNativeRotator.alpha = away ? 0.0 : 1.0; } completion:nil];
            DMLog([NSString stringWithFormat:@"[native] %@", away ? @"App Library / App Switcher up: native windows faded out" : @"back: native windows shown"]);
        }
    }
    // (an app came to the front some other way than a touch -- opened from the Dock, a menu, a link --: the native windows step back, as on a Mac.
    //  Only an app OTHER than the one in front when the native window became active counts: the watcher's first look took the app that was
    //  already in front for a new one and sent Finder back 55 ms after it opened -- M1 30 Sep 13:33; a front app flickering through nil and back
    //  (the Dock, the App Switcher) is no change either)
    SBApplication *fa = DMActiveApp();
    NSString *front = [fa bundleIdentifier];
    if (gNativeActive && front.length && gNativeFrontAtActivation && ![front isEqualToString:gNativeFrontAtActivation] && CACurrentMediaTime() - gNativeActivatedAt > 0.4) {
        DMLog([NSString stringWithFormat:@"[native] %@ came to the front (was %@): native windows inactive", front, gNativeFrontAtActivation]);
        DMNativeSetActive(nil);
    }
    static CGSize last;
    CGSize now = [UIScreen mainScreen].bounds.size;
    if (!CGSizeEqualToSize(now, last)) { last = now; [gNativeLayer setNeedsLayout]; }   // (backup: the layer's own layout pass does the turn)
    DMNativeApplyLevel();
}
static void DMOpenFinderMenu(UIButton *btn) {
    NSMutableArray *finder = [NSMutableArray array];
    if (gFinderOn) [finder addObject:[[DMRow alloc] initWithTitle:@"New Finder Window" enabled:YES handler:DMCloseThen(^{ DMFinderOpen(nil, YES); })]];
    if (DMFinderFront()) [finder addObject:[[DMRow alloc] initWithTitle:@"Empty Trash…" enabled:YES handler:DMCloseThen(^{ DMFinderWindow *f = DMFinderFront(); [f go:kFinderTrash]; [f emptyTrash]; })]];
    NSMutableArray *apps = [NSMutableArray array];
    for (NSString *bid in @[@"com.tigisoftware.Filza", @"com.apple.DocumentsApp"]) {
        if (!DMAppInstalled(bid)) continue;   // only what is really on this iPad
        [apps addObject:[[DMRow alloc] initWithTitle:DMCall(DMProxyForBundle(bid), @"localizedName") enabled:YES
                                             handler:DMCloseThen(^{ DMOpenApp(bid); })]];
    }
    NSMutableArray *jailbreak = [NSMutableArray array];
    NSString *folderName = nil;
    if (DMFindJailbreakFolderIcon(&folderName)) {
        [jailbreak addObject:[[DMRow alloc] initWithTitle:folderName.length ? folderName : @"Jailbreak" enabled:YES
                                                  handler:DMCloseThen(^{ DMOpenJailbreakFolder(); })]];
    } else if (DMAppInstalled(@"com.opa334.TrollStore")) {
        [jailbreak addObject:[[DMRow alloc] initWithTitle:DMCall(DMProxyForBundle(@"com.opa334.TrollStore"), @"localizedName") enabled:YES
                                                  handler:DMCloseThen(^{ DMOpenApp(@"com.opa334.TrollStore"); })]];
    }
    NSMutableArray *items = [NSMutableArray arrayWithArray:finder];
    if (apps.count || jailbreak.count) [items addObject:[NSNull null]];
    [items addObjectsFromArray:apps];
    if (apps.count && jailbreak.count) [items addObject:[NSNull null]];
    [items addObjectsFromArray:jailbreak];
    if (!items.count) [items addObject:[[DMRow alloc] initWithTitle:@"Nothing to open" enabled:NO handler:nil]];
    DMPresentMenu(btn, kAppLabelKey, kAppPillKey, items);
    DMLog([NSString stringWithFormat:@"[finder] menu opened with %lu items", (unsigned long)items.count]);
}

static DMRow *DMShortcutRow(NSString *title, NSString *hint, BOOL enabled, uint32_t usage, BOOL shift) {
    enabled = enabled && DMHardwareKeyboardAttached();   // these rows press keys for the app; without a hardware keyboard that would disturb its on-screen keyboard
    DMRow *row = [[DMRow alloc] initWithTitle:title enabled:enabled handler:DMCloseThen(^{ DMSendShortcut(usage, shift); })];
    row.hint = hint;
    return row;
}

// The Edit menu while a Finder window is active: Finder's own Undo, Copy and Paste of files (a Mac Finder's Edit menu), not the app behind it.
static void DMOpenFinderEditMenu(UIButton *btn, DMFinderWindow *f) {
    NSArray *items = @[
        DMFinderRow([f dm_undoTitle], @"⌘Z", [f dm_canUndo], ^(DMFinderWindow *w) { [w dm_undo]; }),
        [[DMRow alloc] initWithTitle:@"Redo" enabled:NO handler:nil],
        [NSNull null],
        [[DMRow alloc] initWithTitle:@"Cut" enabled:NO handler:nil],
        DMFinderRow(@"Copy", @"⌘C", [f dm_selectedItem] != nil, ^(DMFinderWindow *w) { [w dm_keyCopy:nil]; }),
        DMFinderRow(gFinderClipboard.count > 1 ? [NSString stringWithFormat:@"Paste %lu Items", (unsigned long)gFinderClipboard.count] : @"Paste Item", @"⌘V", gFinderClipboard.count && [f dm_canWriteHere], ^(DMFinderWindow *w) { [w dm_keyPaste:nil]; }),
        [NSNull null],
        DMFinderRow(@"Find…", @"⌘F", YES, ^(DMFinderWindow *w) { [w dm_keyFind:nil]; }),
    ];
    DMPresentMenu(btn, kEditLabelKey, kEditPillKey, items);
    DMLog(@"[edit] Finder's Edit menu opened");
}
static void DMOpenEditMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    { DMNativeWindow *nw = DMNativeActiveApp(); if ([nw isKindOfClass:[DMFinderWindow class]]) { DMOpenFinderEditMenu(btn, (DMFinderWindow *)nw); return; } }
    UIPasteboard *pb = [UIPasteboard generalPasteboard];
    BOOL hasClip = pb.numberOfItems > 0;
    NSString *activeBundle = [DMActiveApp() bundleIdentifier];
    DMRow *undoRow = [[DMRow alloc] initWithTitle:@"Undo" enabled:activeBundle.length handler:DMCloseThen(^{ DMPostAppBridgeAction(activeBundle, @"undo"); })];
    undoRow.hint = @"⌘Z";
    DMRow *redoRow = [[DMRow alloc] initWithTitle:@"Redo" enabled:activeBundle.length handler:DMCloseThen(^{ DMPostAppBridgeAction(activeBundle, @"redo"); })];
    redoRow.hint = @"⇧⌘Z";
    NSArray *items = @[
        // Real Undo/Redo (the standard UIResponderStandardEditActions selectors, the same as a shake or a Cmd+Z would reach), not a keystroke: works with
        // no hardware keyboard attached, unlike the shortcut rows below.
        undoRow, redoRow,
        [NSNull null],
        DMShortcutRow(@"Cut", @"⌘X", YES, HID_KEY_X, NO),
        DMShortcutRow(@"Copy", @"⌘C", YES, HID_KEY_C, NO),
        DMShortcutRow(@"Paste", @"⌘V", hasClip, HID_KEY_V, NO),
        DMShortcutRow(@"Select All", @"⌘A", YES, HID_KEY_A, NO),
        [NSNull null],
        DMShortcutRow(@"Find…", @"⌘F", YES, HID_KEY_F, NO),
        [NSNull null],
        [[DMRow alloc] initWithTitle:DMClipboardSummary() enabled:NO handler:nil],
        [[DMRow alloc] initWithTitle:@"Clear Clipboard" enabled:hasClip handler:DMCloseThen(^{
            [UIPasteboard generalPasteboard].items = @[];
            DMLog(@"[edit] clipboard cleared");
        })],
    ];
    DMPresentMenu(btn, kEditLabelKey, kEditPillKey, items);
    DMLog(@"[edit] menu opened");
}


// The apps the Go menu should list, in order: Settings > Status Bar > Go Menu > Apps stores them as an array in the menu's order (MSBGoAppsController,
// which can reorder them). Missing apps are dropped later, when the menu is built (Reynard is offered with GET instead). Before the list could be
// reordered the menu showed its built-in choices first, then the rest by name: the first time (no goAppsOrdered yet) that order is written into the
// array, so an update keeps its menu order (Settings does the same when its list is opened first). New installs start with Calendar, Terminal, Maps
// and Reynard (kDMGoAppsSeed, already in order); an update keeps its list (sshtoggled --freeze-defaults).
// "@terminal" stands for the first installed terminal app (kDMTerminalApps; none: not shown), so it follows installs and removals.
#define kDMTerminalToken @"@terminal"
#define kDMTerminalApps (@[@"dev.diffterm.app", @"ws.hbang.Terminal", @"com.officialscheduler.mterminal", @"com.googlecode.mobileterminal.Terminal"])   // (same list in MSBGoAppsController.m)
#define kDMGoAppsSeed (@[@"com.apple.mobilecal", kDMTerminalToken, @"com.apple.Maps", @"com.minh-ton.Reynard"])
#define kDMReynardBundle @"com.minh-ton.Reynard"
#define kDMReynardPage @"https://github.com/minh-ton/reynard-browser"   // (Reynard's own repository, by its developer)
static NSArray<NSString *> *DMGoAppBundleIDs(void) {
    CFPreferencesAppSynchronize(MSB_DOMAIN);
    CFPropertyListRef raw = CFPreferencesCopyValue(CFSTR("goApps"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    id stored = raw ? CFBridgingRelease(raw) : nil;
    NSMutableArray *list = [NSMutableArray array];
    if ([stored isKindOfClass:[NSArray class]]) { for (id bid in stored) if ([bid isKindOfClass:[NSString class]] && ![list containsObject:bid]) [list addObject:bid]; }
    else if ([stored isKindOfClass:[NSDictionary class]]) { for (NSString *bid in stored) if ([stored[bid] boolValue]) [list addObject:bid]; }
    else if (!stored) return kDMGoAppsSeed;   // (already in the menu's order)
    CFPropertyListRef orderedRef = CFPreferencesCopyValue(CFSTR("goAppsOrdered"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (orderedRef) { CFRelease(orderedRef); return list; }

    NSArray *original = @[@"com.apple.mobilecal", @"com.minh-ton.Reynard"];   // (legacy lists only: Calendar and Reynard first, then by name)
    NSMutableArray *ordered = [NSMutableArray array];
    for (NSString *bid in original) if ([list containsObject:bid]) [ordered addObject:bid];
    NSMutableArray *others = [NSMutableArray array];
    for (NSString *bid in list) if (![original containsObject:bid]) [others addObject:bid];
    [others sortUsingComparator:^NSComparisonResult(NSString *x, NSString *y) {
        return [(DMCall(DMProxyForBundle(x), @"localizedName") ?: x) localizedCaseInsensitiveCompare:(DMCall(DMProxyForBundle(y), @"localizedName") ?: y)];
    }];
    [ordered addObjectsFromArray:others];
    if (stored) {   // (written down once: from now on the array is the order)
        CFPreferencesSetValue(CFSTR("goApps"), (__bridge CFPropertyListRef)ordered, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSetValue(CFSTR("goAppsOrdered"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        DMLog([NSString stringWithFormat:@"[go] the menu's order written into goApps: %@", [ordered componentsJoinedByString:@", "]]);
    }
    return ordered;
}

// Settings, full screen, on our Status Bar page (target 0), its Go Menu > Apps picker (1) or its Window Engine picker (2): the time of the request and the target go to
// Settings in a notify state (StatusBarSettingsRow.x), the same way as the welcome alert's "Take Me There".
static void DMOpenAppFullScreen(NSString *bundleID);
static void DMOpenStatusBarSettings(uint32_t target) {
    static int token = 0;
    if (!token) notify_register_check("com.besiktasliseba.macstatusbaranddock.openstatusbarpage", &token);
    notify_set_state(token, ((uint64_t)target << 32) | (uint64_t)(uint32_t)time(NULL));
    notify_post("com.besiktasliseba.macstatusbaranddock.openstatusbarpage");
    DMOpenAppFullScreen(@"com.apple.Preferences");
}
// "Go": Settings pages, then the apps chosen in Settings (installed ones; Reynard not installed: GET), then "Edit Go Menu…".
static void DMOpenGoMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    NSMutableArray *places = [NSMutableArray array];   // (Finder's places, as on a Mac's Go menu: each opens in the front Finder window)
    for (NSDictionary *sec in gFinderOn ? DMFinderSidebar() : @[]) for (NSDictionary *r in sec[@"rows"]) {   // (Finder switched off: none)
        if ([r[@"t"] isEqualToString:@"Trash"] || [r[@"t"] isEqualToString:@"Jailbreak"]) continue;
        NSString *p = r[@"p"];
        DMRow *row = [[DMRow alloc] initWithTitle:r[@"t"] enabled:YES handler:DMCloseThen(^{ DMFinderOpen(p, NO); })];
        if ([r[@"desktop"] boolValue]) row.hint = @"⇧⌘D";   // (Go > Desktop, as on a Mac)
        [places addObject:row];
    }
    NSMutableArray *items = [NSMutableArray array];
    if (DMNativeActiveApp()) {
        [items addObject:DMFinderRow(@"Back", @"⌘[", YES, ^(DMFinderWindow *w) { [w goBack]; })];
        [items addObject:DMFinderRow(@"Forward", @"⌘]", YES, ^(DMFinderWindow *w) { [w goForward]; })];
        [items addObject:DMFinderRow(@"Enclosing Folder", @"⌘↑", YES, ^(DMFinderWindow *w) { [w goUp]; })];
        [items addObject:[NSNull null]];
        [items addObject:DMFinderRow(@"Go to Folder…", @"⇧⌘G", YES, ^(DMFinderWindow *w) { [w dm_goToFolder]; })];
        [items addObject:[NSNull null]];
    }
    [items addObjectsFromArray:places];
    if (places.count) [items addObject:[NSNull null]];
    [items addObjectsFromArray:@[
        [[DMRow alloc] initWithTitle:@"Battery" enabled:YES
                             handler:DMCloseThen(^{ DMOpenURL(@"prefs:root=BATTERY_USAGE", @"go: battery"); })],
        [[DMRow alloc] initWithTitle:@"iPad Storage" enabled:YES
                             handler:DMCloseThen(^{ DMOpenURL(@"prefs:root=General&path=STORAGE_MGMT", @"go: storage"); })]]];
    NSMutableArray *apps = [NSMutableArray array];
    NSArray<NSString *> *list = DMGoAppBundleIDs();
    for (NSString *entry in list) {
        NSString *bid = entry;
        if ([entry isEqualToString:kDMTerminalToken]) {   // the first installed terminal; none, or listed on its own too: skipped here
            bid = nil;
            for (NSString *t in kDMTerminalApps) if (DMAppInstalled(t)) { bid = t; break; }
            if (!bid || [list containsObject:bid]) continue;
            [apps addObject:[[DMRow alloc] initWithTitle:@"Terminal" enabled:YES handler:DMCloseThen(^{ DMOpenApp(bid); })]];
            continue;
        }
        if (!DMAppInstalled(bid)) {
            if (![bid isEqualToString:kDMReynardBundle]) continue;
            DMRow *get = [[DMRow alloc] initWithTitle:@"Reynard" enabled:YES handler:DMCloseThen(^{ DMOpenURL(kDMReynardPage, @"go: get Reynard"); })];
            get.getBadge = YES; get.hint = @"GET";
            [apps addObject:get];
            continue;
        }
        NSString *title = [kDMTerminalApps containsObject:bid] ? @"Terminal" : DMCall(DMProxyForBundle(bid), @"localizedName");
        [apps addObject:[[DMRow alloc] initWithTitle:title enabled:YES handler:DMCloseThen(^{ DMOpenApp(bid); })]];
    }
    if (apps.count) { [items addObject:[NSNull null]]; [items addObjectsFromArray:apps]; }
    [items addObject:[NSNull null]];
    [items addObject:[[DMRow alloc] initWithTitle:@"Edit Go Menu…" enabled:YES handler:DMCloseThen(^{ DMOpenStatusBarSettings(1); })]];
    DMPresentMenu(btn, kGoLabelKey, kGoPillKey, items);
    DMLog([NSString stringWithFormat:@"[go] menu opened with %lu app entries", (unsigned long)apps.count]);
}

// "Window": sizes and places for the active app (a MilkyWay window, or a full-screen app that is turned into one).
// ---- "which side?" for a third window ----------------------------------------------------------------------------------------------------
// Two windows each cover a side of the screen and a third one opens: the two halves light up as targets, over the dimmed screen, and one tap picks the
// side the new window goes on (that side is split in two, the new window on top). Tapping elsewhere, or waiting, uses the default arrangement.
static UIControl *DMSidePanel(NSString *side, NSString *title, NSString *subtitle) {
    CGRect f = CGRectInset(DMLayoutFrame(side), 12.0, 12.0);
    UIControl *panel = [[UIControl alloc] initWithFrame:f];
    panel.layer.cornerRadius = 24.0; panel.layer.cornerCurve = kCACornerCurveContinuous;
    panel.layer.borderWidth = 2.0; panel.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.35].CGColor;
    panel.clipsToBounds = YES;
    UIVisualEffectView *blur = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterial]];
    blur.frame = panel.bounds; blur.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight; blur.userInteractionEnabled = NO;
    [panel addSubview:blur];
    NSDictionary *symbols = @{@"left": @"rectangle.lefthalf.inset.filled", @"right": @"rectangle.righthalf.inset.filled", @"top": @"rectangle.tophalf.inset.filled", @"bottom": @"rectangle.bottomhalf.inset.filled",
                              @"topleft": @"rectangle.inset.topleading.filled", @"topright": @"rectangle.inset.topright.filled", @"bottomleft": @"rectangle.inset.bottomleading.filled", @"bottomright": @"rectangle.inset.bottomright.filled"};
    NSString *symbol = symbols[side] ?: @"rectangle.righthalf.inset.filled";
    UIImageView *glyph = [[UIImageView alloc] initWithImage:[UIImage systemImageNamed:symbol withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:64.0 weight:UIImageSymbolWeightRegular]]];
    glyph.tintColor = [UIColor labelColor]; glyph.contentMode = UIViewContentModeCenter; glyph.userInteractionEnabled = NO;
    glyph.frame = CGRectMake(0, f.size.height / 2.0 - 96.0, f.size.width, 80.0);
    UILabel *t = [UILabel new]; t.text = title; t.font = [UIFont systemFontOfSize:30.0 weight:UIFontWeightSemibold]; t.textColor = [UIColor labelColor]; t.textAlignment = NSTextAlignmentCenter;
    t.frame = CGRectMake(0, f.size.height / 2.0 - 4.0, f.size.width, 38.0);
    UILabel *st = [UILabel new]; st.text = subtitle; st.font = [UIFont systemFontOfSize:15.0]; st.textColor = [UIColor secondaryLabelColor]; st.textAlignment = NSTextAlignmentCenter;
    st.frame = CGRectMake(16.0, f.size.height / 2.0 + 38.0, f.size.width - 32.0, 22.0);
    for (UIView *v in @[glyph, t, st]) { v.userInteractionEnabled = NO; [panel addSubview:v]; }
    __weak UIControl *wp = panel;
    [panel addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { [UIView animateWithDuration:0.12 animations:^{ wp.transform = CGAffineTransformMakeScale(0.97, 0.97); wp.layer.borderColor = [UIColor systemBlueColor].CGColor; }]; }] forControlEvents:UIControlEventTouchDown];
    UIAction *reset = [UIAction actionWithHandler:^(__kindof UIAction *a) { [UIView animateWithDuration:0.12 animations:^{ wp.transform = CGAffineTransformIdentity; wp.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.35].CGColor; }]; }];
    [panel addAction:reset forControlEvents:UIControlEventTouchUpOutside | UIControlEventTouchCancel];
    return panel;
}
// The prompt survives a turn (2026-09-24): while it is up, a turn (or any change of the screen's shape) rebuilds it for the new orientation -- the
// panels re-measured from DMLayoutFrame, the same entrance, the 12 s deadline kept -- and a choice is ALWAYS applied in the end: a tap on a side, a tap
// elsewhere or the deadline (the default arrangement), and closing it for any other reason (another menu, a lock...) applies the default too, so the
// third window is never left un-tiled. One 0.2 s timer per prompt watches all of that.
static void DMShowSidePrompt(NSMutableDictionary *ctx, BOOL rebuilt);
static void DMPromptForSideApply(UIView *stage, NSString *newBundle, NSString *leftBundle, NSString *rightBundle, void (^apply)(NSString *side));
static void DMPromptForSide(UIView *stage, NSString *newBundle, NSString *leftBundle, NSString *rightBundle) { DMPromptForSideApply(stage, newBundle, leftBundle, rightBundle, nil); }
// apply: the engine's own way of placing the choice (the Stage Manager engine's layouts); nil: the Aerial/MilkyWay/Zetsu path below.
static void DMPromptForSideApply(UIView *stage, NSString *newBundle, NSString *leftBundle, NSString *rightBundle, void (^apply)(NSString *side)) {
    DM_FEATURE_MARK("fit-side-question");
    NSMutableDictionary *ctx = [NSMutableDictionary dictionary];
    ctx[@"new"] = newBundle; ctx[@"left"] = leftBundle; ctx[@"right"] = rightBundle;
    if (apply) ctx[@"apply"] = [apply copy];
    if (stage) ctx[@"stageRef"] = stage;   // (strong: the stage stays valid until the choice is applied; none when asked before the launch)
    gSidePromptCtx = ctx;
    ctx[@"deadline"] = @(CACurrentMediaTime() + 12.0);
    DMShowSidePrompt(ctx, NO);
    NSTimer *t = [NSTimer timerWithTimeInterval:0.2 repeats:YES block:^(NSTimer *timer) {
        if ([ctx[@"decided"] boolValue]) { [timer invalidate]; return; }
        void (^decide)(NSString *, NSString *) = ctx[@"choose"];
        UIView *o = ctx[@"overlay"];
        CGSize screen = [UIScreen mainScreen].bounds.size;
        long orientation = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"activeInterfaceOrientation"));
        BOOL turned = orientation != [ctx[@"orientation"] longValue] || fabs(screen.width - [ctx[@"screenW"] doubleValue]) > 1.0;
        if (CACurrentMediaTime() >= [ctx[@"deadline"] doubleValue]) { decide(nil, @"no choice within 12 s: the default arrangement"); [timer invalidate]; return; }
        if (turned) {
            if (o && gOverlay == o) { ctx[@"rebuilding"] = @YES; DMRemoveOverlayNow(); ctx[@"rebuilding"] = @NO; }
            DMLog([NSString stringWithFormat:@"[aerial] the iPad turned (orientation %ld -> %ld) while asking which side %@ goes on: asked again for the new shape", [ctx[@"orientation"] longValue], orientation, ctx[@"new"]]);
            DMShowSidePrompt(ctx, YES);
            ctx[@"deadline"] = @(MAX([ctx[@"deadline"] doubleValue], CACurrentMediaTime() + 8.0));   // a rebuilt question gets time to be read again (iPad 2 cross-test: 7 s were left)
            return;
        }
        if (!o || gOverlay != o || !o.window) { decide(nil, @"the question was closed: the default arrangement"); [timer invalidate]; }
    }];
    [[NSRunLoop mainRunLoop] addTimer:t forMode:NSRunLoopCommonModes];
}
// The third window asked about BEFORE its app is launched (the owner, 27 Sep): opened behind the question at the default window size and squeezed into its
// tile after the pick, apps laid themselves out twice (Reddit's content shifted, a scroll bar sat in the middle for a second). Now the question comes
// first, and on the pick the app is started straight into its tile (its size is published before the launch).
static void DMPromptBeforeLaunch(NSString *newBundle, NSString *leftBundle, NSString *rightBundle, void (^launch)(CGRect frame)) {
    DMPromptForSide(nil, newBundle, leftBundle, rightBundle);
    NSMutableDictionary *ctx = gSidePromptCtx;
    if (ctx && ![ctx[@"decided"] boolValue]) ctx[@"prelaunch"] = [launch copy];
    else launch(DMLayoutFrame(@"center"));   // (the question could not be shown: an ordinary launch, tiled when it appears)
    DMLog([NSString stringWithFormat:@"[aerial] %@: asked which side before launching it", newBundle]);
}
static void DMShowSidePrompt(NSMutableDictionary *ctx, BOOL rebuilt) {
    NSString *newBundle = ctx[@"new"], *leftBundle = ctx[@"left"], *rightBundle = ctx[@"right"];
    ctx[@"orientation"] = @(((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"activeInterfaceOrientation")));
    ctx[@"screenW"] = @([UIScreen mainScreen].bounds.size.width);
    if (!ctx[@"choose"]) {
        __weak NSMutableDictionary *wctx = ctx;
        ctx[@"choose"] = [^(NSString *side, NSString *why) {
            NSMutableDictionary *c = wctx; if (!c || [c[@"decided"] boolValue]) return;
            c[@"decided"] = @YES;
            UIView *o = c[@"overlay"];
            if (o && gOverlay == o) DMCloseOverlay();
            DMLog([NSString stringWithFormat:@"[aerial] %@ goes on the %@ (%@)", c[@"new"], [side isEqualToString:@"none"] ? @"middle, untiled" : (side ?: @"default side"), why]);
            void (^apply)(NSString *) = c[@"apply"];
            if (apply) { [c removeObjectForKey:@"apply"]; [c removeObjectForKey:@"choose"]; apply(side); return; }
            void (^launch)(CGRect) = c[@"prelaunch"];
            if (launch) {   // (asked before the launch: the app now opens straight into its tile; DMCascadeStage applies the choice when its window appears)
                gPreSideBundle = [c[@"new"] copy]; gPreSide = side ?: @""; gPreSideUntil = CACurrentMediaTime() + 8.0;
                CGRect f = DMSideChoiceFrame(c[@"new"], c[@"left"], c[@"right"], side);
                [c removeObjectForKey:@"prelaunch"]; [c removeObjectForKey:@"choose"];
                launch(f);
                return;
            }
            DMApplySideChoice(c[@"stageRef"], c[@"new"], c[@"left"], c[@"right"], side);
            [c removeObjectForKey:@"stageRef"]; [c removeObjectForKey:@"choose"];
        } copy];
    }
    void (^choose)(NSString *, NSString *) = ctx[@"choose"];
    UIView *host = DMMenuHost();
    if (!host) { choose(nil, @"no place to ask"); return; }
    NSString *newName = DMCall(DMProxyForBundle(newBundle), @"localizedName") ?: newBundle;
    NSString *leftName = DMCall(DMProxyForBundle(leftBundle), @"localizedName") ?: leftBundle;
    NSString *rightName = DMCall(DMProxyForBundle(rightBundle), @"localizedName") ?: rightBundle;
    UIControl *o = DMMakeOverlay(host, 0.32);
    ctx[@"overlay"] = o;
    [o addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { choose(@"none", @"a tap outside the sides: No Fit"); }] forControlEvents:UIControlEventTouchUpInside];
    NSMutableArray<UIView *> *panels = [NSMutableArray array];
    for (NSString *side in @[@"left", @"right"]) {
        BOOL left = [side isEqualToString:@"left"];
        UIControl *panel = DMSidePanel(side, left ? @"Left" : @"Right", [NSString stringWithFormat:@"Shares this side with %@", left ? leftName : rightName]);
        [panel addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { choose(side, @"tapped"); }] forControlEvents:UIControlEventTouchUpInside];
        [o addSubview:panel]; [panels addObject:panel];
    }
    // "No Fit" (the owner's sketch, 27 Sep): a round button on the seam between the two sides -- the app opens untiled in the middle.
    UIControl *noFit = [[UIControl alloc] initWithFrame:CGRectMake(0, 0, 88.0, 88.0)];
    noFit.center = CGPointMake((CGRectGetMaxX(panels[0].frame) + CGRectGetMinX(panels[1].frame)) / 2.0, CGRectGetMidY(panels[0].frame) + 96.0);
    noFit.layer.cornerRadius = 44.0; noFit.clipsToBounds = YES;
    noFit.layer.borderWidth = 2.0; noFit.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:0.35].CGColor;
    UIVisualEffectView *nfBlur = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
    nfBlur.frame = noFit.bounds; nfBlur.userInteractionEnabled = NO; [noFit addSubview:nfBlur];
    UIImageView *nfGlyph = [[UIImageView alloc] initWithImage:[UIImage systemImageNamed:@"macwindow" withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:24.0 weight:UIImageSymbolWeightMedium]]];
    nfGlyph.tintColor = [UIColor labelColor]; nfGlyph.contentMode = UIViewContentModeCenter; nfGlyph.frame = CGRectMake(0, 16.0, 88.0, 32.0); nfGlyph.userInteractionEnabled = NO;
    UILabel *nfLabel = [UILabel new]; nfLabel.text = @"No Fit"; nfLabel.font = [UIFont systemFontOfSize:14.0 weight:UIFontWeightSemibold]; nfLabel.textColor = [UIColor labelColor];
    nfLabel.textAlignment = NSTextAlignmentCenter; nfLabel.frame = CGRectMake(0, 50.0, 88.0, 20.0); nfLabel.userInteractionEnabled = NO;
    [noFit addSubview:nfGlyph]; [noFit addSubview:nfLabel];
    __weak UIControl *wnf = noFit;
    [noFit addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { [UIView animateWithDuration:0.12 animations:^{ wnf.transform = CGAffineTransformMakeScale(0.94, 0.94); }]; }] forControlEvents:UIControlEventTouchDown];
    [noFit addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { [UIView animateWithDuration:0.12 animations:^{ wnf.transform = CGAffineTransformIdentity; }]; }] forControlEvents:UIControlEventTouchUpOutside | UIControlEventTouchCancel];
    [noFit addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { choose(@"none", @"No Fit tapped"); }] forControlEvents:UIControlEventTouchUpInside];
    [o addSubview:noFit]; [panels addObject:noFit];   // (it comes in with the panels, after them)
    UIVisualEffectView *pill = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
    UILabel *q = [UILabel new]; q.text = [NSString stringWithFormat:@"Where should %@ go?", newName]; q.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightSemibold]; q.textColor = [UIColor labelColor];
    [q sizeToFit];
    CGRect usable = DMLayoutFrame(@"fill");
    pill.frame = CGRectMake((host.bounds.size.width - q.bounds.size.width - 44.0) / 2.0, usable.origin.y + 16.0, q.bounds.size.width + 44.0, 40.0);
    pill.layer.cornerRadius = 20.0; pill.clipsToBounds = YES; pill.userInteractionEnabled = NO;
    q.frame = CGRectMake(22.0, 0, q.bounds.size.width, 40.0);
    [pill.contentView addSubview:q]; [o addSubview:pill];
    // in: the dim fades up, the two halves rise into place one after the other, the question drops in from above
    o.alpha = 0.0;
    // (Reduce Motion: everything fades in together in one short ease-in-out, the panels with only a tiny scale, the question without the drop)
    BOOL rmIn = MSBReduceMotion();
    for (UIView *pn in panels) { pn.alpha = 0.0; pn.transform = rmIn ? CGAffineTransformMakeScale(kMSBRMScale, kMSBRMScale) : CGAffineTransformMakeScale(0.9, 0.9); }
    pill.alpha = 0.0; pill.transform = rmIn ? CGAffineTransformIdentity : CGAffineTransformMakeTranslation(0, -16.0);
    if (rmIn) {
        [UIView animateWithDuration:kMSBRMDuration delay:0 options:UIViewAnimationOptionCurveEaseInOut animations:^{
            o.alpha = 1.0; pill.alpha = 1.0;
            for (UIView *pn in panels) { pn.alpha = 1.0; pn.transform = CGAffineTransformIdentity; }
        } completion:nil];
    } else {
    [UIView animateWithDuration:0.2 animations:^{ o.alpha = 1.0; }];
    for (NSUInteger i = 0; i < panels.count; i++) {
        UIView *pn = panels[i];
        [UIView animateWithDuration:0.5 delay:0.05 + 0.07 * i usingSpringWithDamping:0.78 initialSpringVelocity:0.3 options:0 animations:^{ pn.alpha = 1.0; pn.transform = CGAffineTransformIdentity; } completion:nil];
    }
    [UIView animateWithDuration:0.45 delay:0.12 usingSpringWithDamping:0.8 initialSpringVelocity:0.2 options:0 animations:^{ pill.alpha = 1.0; pill.transform = CGAffineTransformIdentity; } completion:nil];
    }
    DMLog([NSString stringWithFormat:@"[aerial] asking which side %@ goes on (left %@, right %@)%@, panels %@ / %@", newBundle, leftBundle, rightBundle, rebuilt ? @" -- rebuilt after a turn" : @"",
           NSStringFromCGRect(panels[0].frame), NSStringFromCGRect(panels[1].frame)]);
}

// ---- swap the windows of a tiled layout ---------------------------------------------------------------------------------------------------
// Left/right (horizontally opposed) or top/bottom (vertically opposed) windows exchange places: the layout is mirrored. A swap is only offered
// when at least two windows are open, all of them sit in one of the tile slots, and mirroring moves at least one of them.
static BOOL DMSwapPlan(BOOL horizontal, NSMutableArray<UIView *> *stagesOut, NSMutableArray<NSString *> *slotsOut) {
    NSMutableArray<UIView *> *open = [NSMutableArray array];
    for (UIView *st in DMAerialStages()) if (!st.hidden && !DMStageMinimized(st) && DMStageBundle(st).length) [open addObject:st];
    if (open.count < 2) return NO;
    NSMutableSet *used = [NSMutableSet set];
    BOOL changes = NO;
    for (UIView *st in open) {
        NSString *slot = DMSlotNameForFrame(st.frame);
        if (!slot) return NO;
        NSString *target = DMMirrorSlot(slot, horizontal);
        if ([used containsObject:target]) return NO;
        [used addObject:target];
        if (![target isEqualToString:slot]) changes = YES;
        [stagesOut addObject:st]; [slotsOut addObject:target];
    }
    return changes;
}
// (Stage Manager as the engine: the same plans from each window's frame on the screen, applied to the stage in one go)
static BOOL DMSMSwapPlan(BOOL horizontal, NSMutableDictionary<NSString *, NSString *> *out) {
    id work = DMSMWorkingStage();
    NSDictionary<NSString *, NSValue *> *open = DMSMOpenWindowFrames();
    if (open.count < 2) return NO;
    NSMutableSet *used = [NSMutableSet set];
    BOOL changes = NO;
    for (NSString *b in open) {
        NSString *slot = DMSMSlotNameForFrameIn(open[b].CGRectValue, work);
        if (!slot) return NO;
        NSString *target = DMMirrorSlot(slot, horizontal);
        if ([used containsObject:target]) return NO;
        [used addObject:target];
        if (![target isEqualToString:slot]) changes = YES;
        out[b] = target;
    }
    return changes;
}
static BOOL DMSMHalfQuarterPlan(NSString **halfB, NSString **halfSlot, NSArray<NSString *> **quarterBs, NSArray<NSString *> **quarterSlots) {
    id work = DMSMWorkingStage();
    NSDictionary<NSString *, NSValue *> *open = DMSMOpenWindowFrames();
    if (open.count != 3) return NO;
    NSString *half = nil, *halfName = nil; NSMutableDictionary<NSString *, NSString *> *bySlot = [NSMutableDictionary dictionary];
    for (NSString *b in open) {
        NSString *slot = DMSMSlotNameForFrameIn(open[b].CGRectValue, work);
        if (!slot) return NO;
        bySlot[slot] = b;
        if ([@[@"left", @"right", @"top", @"bottom"] containsObject:slot]) { if (half) return NO; half = b; halfName = slot; }
    }
    if (!half) return NO;
    NSString *a = bySlot[DMOtherHalfQuarter(halfName, YES)], *c = bySlot[DMOtherHalfQuarter(halfName, NO)];
    if (!a || !c) return NO;
    if (halfB) *halfB = half;
    if (halfSlot) *halfSlot = halfName;
    if (quarterBs) *quarterBs = @[a, c];
    if (quarterSlots) *quarterSlots = @[DMOtherHalfQuarter(halfName, YES), DMOtherHalfQuarter(halfName, NO)];
    return YES;
}
static BOOL DMSwapAvailable(BOOL horizontal) {
    if (DMSMEngine()) return DMSMSwapPlan(horizontal, [NSMutableDictionary dictionary]);
    return DMActiveEngine() != DMEngineNone && DMSwapPlan(horizontal, [NSMutableArray array], [NSMutableArray array]);
}
static void DMSwapWindows(BOOL horizontal) {
    if (DMSMEngine()) {
        NSMutableDictionary *plan = [NSMutableDictionary dictionary];
        if (DMSMSwapPlan(horizontal, plan)) DMSMApplyLayouts(plan);
        return;
    }
    NSMutableArray<UIView *> *stages = [NSMutableArray array]; NSMutableArray<NSString *> *slots = [NSMutableArray array];
    if (!DMSwapPlan(horizontal, stages, slots)) return;
    gMoveKeepsOrder = YES;
    for (NSUInteger i = 0; i < stages.count; i++) {
        NSString *b = DMStageBundle(stages[i]);
        DMAerialMoveStage(stages[i], DMLayoutFrame(slots[i]), nil);
        if (gFitGroup && [gFitGroup containsObject:b]) { if (!gFitSlots) gFitSlots = [NSMutableDictionary dictionary]; gFitSlots[b] = slots[i]; }
    }
    gMoveKeepsOrder = NO;
    DMLog([NSString stringWithFormat:@"[window] swapped %@ opposed windows (%lu)", horizontal ? @"horizontally" : @"vertically", (unsigned long)stages.count]);
}

// Which layout the active app's window is in right now (a tick in the Window menu): its frame is compared with every layout's frame, so moving or resizing
// the window takes the tick away (or moves it to the layout the window ends up matching).
static NSString *DMCurrentLayoutName(void) {
    NSString *bundleID = [DMActiveApp() bundleIdentifier];
    if (!bundleID.length) return nil;
    CGRect f = CGRectNull;
    if (DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu) {
        UIView *stage = DMStageForBundle(bundleID);
        if (stage && !stage.hidden && !DMStageMinimized(stage) && ![objc_getAssociatedObject(stage, kStageClosingKey) boolValue]) f = stage.frame;
    } else if (DMActiveEngine() == DMEngineMilkyWay) {
        UIView *window = DMFindMilkyWayWindow(bundleID);
        if (window && !DMWindowMinimized(window)) f = window.frame;
    } else if (DMSMEngine()) {   // (the whole window: the card and our title bar above it)
        UIView *card = DMSMCardFor(bundleID);
        if (card) { CGRect c = [card convertRect:card.bounds toCoordinateSpace:(card.window.screen ?: [UIScreen mainScreen]).coordinateSpace]; f = CGRectMake(c.origin.x, c.origin.y - kSMBarH, c.size.width, c.size.height + kSMBarH); }   // (the switcher window is in the native portrait space of the screen)
        if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[sm] layout name for %@: card %@, window frame %@, left would be %@", bundleID, card, NSStringFromCGRect(f), NSStringFromCGRect(DMLayoutFrame(@"left"))]);
    }
    if (CGRectIsNull(f)) return nil;
    for (NSString *name in @[@"fill", @"center", @"left", @"right", @"top", @"bottom", @"topleft", @"topright", @"bottomleft", @"bottomright", @"small", @"medium", @"large"]) {
        CGRect t = DMLayoutFrame(name);
        if (CGRectIsNull(t)) continue;
        if (fabs(t.origin.x - f.origin.x) < 6.0 && fabs(t.origin.y - f.origin.y) < 6.0 && fabs(t.size.width - f.size.width) < 6.0 && fabs(t.size.height - f.size.height) < 6.0) return name;
    }
    return nil;
}
// ---- swap a half with a quarter ---------------------------------------------------------------------------------------------------------------
// Three windows: one has a half of the screen, the other two the quarters of the other half. The half's window and one of the quarter windows change places;
// with two quarter windows to choose from, the two quarters light up over the dimmed screen and a tap picks the one that trades with the half.
static NSString *DMOtherHalfQuarter(NSString *halfSlot, BOOL first) {
    static NSDictionary *q;
    if (!q) q = @{@"left": @[@"topright", @"bottomright"], @"right": @[@"topleft", @"bottomleft"], @"top": @[@"bottomleft", @"bottomright"], @"bottom": @[@"topleft", @"topright"]};
    return q[halfSlot][first ? 0 : 1];
}
static BOOL DMHalfQuarterPlan(UIView **halfStage, NSString **halfSlot, NSArray<UIView *> **quarterStages, NSArray<NSString *> **quarterSlots) {
    NSMutableArray<UIView *> *open = [NSMutableArray array];
    for (UIView *st in DMAerialStages()) if (!st.hidden && !DMStageMinimized(st) && DMStageBundle(st).length) [open addObject:st];
    if (open.count != 3) return NO;
    UIView *half = nil; NSString *halfName = nil; NSMutableDictionary<NSString *, UIView *> *bySlot = [NSMutableDictionary dictionary];
    for (UIView *st in open) {
        NSString *slot = DMSlotNameForFrame(st.frame);
        if (!slot) return NO;
        bySlot[slot] = st;
        if ([@[@"left", @"right", @"top", @"bottom"] containsObject:slot]) { if (half) return NO; half = st; halfName = slot; }
    }
    if (!half) return NO;
    UIView *a = bySlot[DMOtherHalfQuarter(halfName, YES)], *b = bySlot[DMOtherHalfQuarter(halfName, NO)];
    if (!a || !b) return NO;
    if (halfStage) *halfStage = half;
    if (halfSlot) *halfSlot = halfName;
    if (quarterStages) *quarterStages = @[a, b];
    if (quarterSlots) *quarterSlots = @[DMOtherHalfQuarter(halfName, YES), DMOtherHalfQuarter(halfName, NO)];
    return YES;
}
static BOOL DMHalfQuarterAvailable(void) {
    if (DMSMEngine()) return DMSMHalfQuarterPlan(NULL, NULL, NULL, NULL);
    return (DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu) && DMHalfQuarterPlan(NULL, NULL, NULL, NULL);
}
static void DMApplyHalfQuarterSwap(UIView *half, NSString *halfSlot, UIView *quarter, NSString *quarterSlot) {
    if (!half || !quarter) return;
    gMoveKeepsOrder = YES;
    NSString *hb = DMStageBundle(half), *qb = DMStageBundle(quarter);
    DMAerialMoveStage(half, DMLayoutFrame(quarterSlot), nil);
    DMAerialMoveStage(quarter, DMLayoutFrame(halfSlot), nil);
    if (gFitGroup) {
        if ([gFitGroup containsObject:hb]) { if (!gFitSlots) gFitSlots = [NSMutableDictionary dictionary]; gFitSlots[hb] = quarterSlot; }
        if ([gFitGroup containsObject:qb]) { if (!gFitSlots) gFitSlots = [NSMutableDictionary dictionary]; gFitSlots[qb] = halfSlot; }
    }
    gMoveKeepsOrder = NO;
    DMLog([NSString stringWithFormat:@"[window] swapped the half (%@, %@) with the quarter (%@, %@)", hb, halfSlot, qb, quarterSlot]);
}
static void DMSwapHalfWithQuarter(void) {
    // (the plan as apps and slots, whichever engine; apply(i): the half trades places with quarter i)
    NSString *halfB = nil, *halfSlot = nil; NSArray<NSString *> *quarterBs = nil, *slots = nil;
    void (^apply)(NSInteger) = nil;
    if (DMSMEngine()) {
        if (!DMSMHalfQuarterPlan(&halfB, &halfSlot, &quarterBs, &slots)) return;
        NSString *hb = halfB, *hs = halfSlot; NSArray *qb = quarterBs, *qs = slots;
        apply = ^(NSInteger i) { DMSMApplyLayouts(@{hb: qs[i], qb[i]: hs}); };
    } else {
        UIView *half = nil; NSArray<UIView *> *quarters = nil;
        if (!DMHalfQuarterPlan(&half, &halfSlot, &quarters, &slots)) return;
        halfB = DMStageBundle(half); quarterBs = @[DMStageBundle(quarters[0]) ?: @"", DMStageBundle(quarters[1]) ?: @""];
        NSString *hs = halfSlot; NSArray *qs = slots;
        apply = ^(NSInteger i) { DMApplyHalfQuarterSwap(half, hs, quarters[i], qs[i]); };
    }
    UIView *host = DMMenuHost();
    if (!host) { apply(0); return; }
    NSString *halfName = DMCall(DMProxyForBundle(halfB), @"localizedName") ?: halfB;
    UIControl *o = DMMakeOverlay(host, 0.32);
    __block BOOL decided = NO;
    void (^choose)(NSInteger) = ^(NSInteger index) {
        if (decided) return; decided = YES;
        DMCloseOverlay();
        if (index >= 0) apply(index);
    };
    [o addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { choose(-1); }] forControlEvents:UIControlEventTouchUpInside];
    NSMutableArray<UIView *> *panels = [NSMutableArray array];
    for (NSInteger i = 0; i < 2; i++) {
        NSString *qName = DMCall(DMProxyForBundle(quarterBs[i]), @"localizedName") ?: quarterBs[i];
        UIControl *panel = DMSidePanel(slots[i], qName, [NSString stringWithFormat:@"Trades places with %@", halfName]);
        [panel addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { choose(i); }] forControlEvents:UIControlEventTouchUpInside];
        [o addSubview:panel]; [panels addObject:panel];
    }
    UIVisualEffectView *pill = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
    UILabel *q = [UILabel new]; q.text = [NSString stringWithFormat:@"Which app should trade places with %@?", halfName]; q.font = [UIFont systemFontOfSize:17.0 weight:UIFontWeightSemibold]; q.textColor = [UIColor labelColor];
    [q sizeToFit];
    CGRect usable = DMLayoutFrame(@"fill");
    pill.frame = CGRectMake((host.bounds.size.width - q.bounds.size.width - 44.0) / 2.0, usable.origin.y + 16.0, q.bounds.size.width + 44.0, 40.0);
    pill.layer.cornerRadius = 20.0; pill.clipsToBounds = YES; pill.userInteractionEnabled = NO;
    q.frame = CGRectMake(22.0, 0, q.bounds.size.width, 40.0);
    [pill.contentView addSubview:q]; [o addSubview:pill];
    // in: the dim fades up, the two quarters rise into place one after the other, the question drops in from above
    o.alpha = 0.0;
    // (Reduce Motion: everything fades in together in one short ease-in-out, the panels with only a tiny scale, the question without the drop)
    BOOL rmIn = MSBReduceMotion();
    for (UIView *pn in panels) { pn.alpha = 0.0; pn.transform = rmIn ? CGAffineTransformMakeScale(kMSBRMScale, kMSBRMScale) : CGAffineTransformMakeScale(0.9, 0.9); }
    pill.alpha = 0.0; pill.transform = rmIn ? CGAffineTransformIdentity : CGAffineTransformMakeTranslation(0, -16.0);
    if (rmIn) {
        [UIView animateWithDuration:kMSBRMDuration delay:0 options:UIViewAnimationOptionCurveEaseInOut animations:^{
            o.alpha = 1.0; pill.alpha = 1.0;
            for (UIView *pn in panels) { pn.alpha = 1.0; pn.transform = CGAffineTransformIdentity; }
        } completion:nil];
    } else {
    [UIView animateWithDuration:0.2 animations:^{ o.alpha = 1.0; }];
    for (NSUInteger i = 0; i < panels.count; i++) {
        UIView *pn = panels[i];
        [UIView animateWithDuration:0.5 delay:0.05 + 0.07 * i usingSpringWithDamping:0.78 initialSpringVelocity:0.3 options:0 animations:^{ pn.alpha = 1.0; pn.transform = CGAffineTransformIdentity; } completion:nil];
    }
    [UIView animateWithDuration:0.45 delay:0.12 usingSpringWithDamping:0.8 initialSpringVelocity:0.2 options:0 animations:^{ pill.alpha = 1.0; pill.transform = CGAffineTransformIdentity; } completion:nil];
    }
    __weak UIControl *wo = o;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(12.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gOverlay && gOverlay == wo) choose(-1); });
    DMLog([NSString stringWithFormat:@"[window] asking which quarter trades places with the half %@", halfName]);
}

// Minimizes every open window (or Aerial stage) at once, the same way each one minimizes individually — not a distinct "all windows"
// concept of its own, just DMMinimizeStage/DMMinimizeWindow called once per window currently on screen. Already-minimized or hidden
// windows are skipped (nothing to do, and re-minimizing would just restart their own animation pointlessly).
static void DMMinimizeAllWindows(void) {
    if (DMSMEngine()) {   // Stage Manager: each window's own Minimize, a moment apart (one stage transition at a time)
        NSArray<NSString *> *bundles = DMSMWindowBundles();
        for (NSUInteger i = 0; i < bundles.count; i++) {
            NSString *b = bundles[i];
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSMWindowAction(b, @"removeFromSet"); });
        }
        return;
    }
    if (DMActiveEngine() == DMEngineZetsu) {   // Zetsu as the engine: each window fades away like an Aerial stage (not Zetsu's own title-bar pill)
        for (UIView *w in [DMAerialStages() copy]) if (!w.hidden && !DMStageMinimized(w)) DMMinimizeStage(w);
        return;
    }
    if (DMActiveEngine() == DMEngineAerial) {
        for (UIView *stage in [DMAerialStages() copy]) {
            if (stage.hidden || DMStageMinimized(stage) || !DMStageBundle(stage).length) continue;
            DMMinimizeStage(stage);
        }
    } else if (DMActiveEngine() == DMEngineMilkyWay) {
        Class viewClass = objc_getClass("AXWindowView");
        for (UIView *v in [DMMilkyWayLayer().subviews copy]) {
            if (viewClass && [v isKindOfClass:viewClass] && !v.hidden && !DMWindowMinimized(v)) DMMinimizeWindow(v);
        }
    }
    // Zetsu parity: independent of which of the two engines above is active (Zetsu can have windows open alongside/instead of either),
    // so this runs regardless, not as another `else if`. -MinibtnEvent is a real, existing ZetsuAppController method (confirmed via
    // methsearch on a live instance) -- the same one its own minimize button already calls; this fires it directly the way DMForceQuitBundle
    // above already does for -CloseAppWindow:, not a reimplementation of what it does.
    for (UIWindow *zw in DMZetsuWindows()) {
        id appCtl = nil; @try { appCtl = [zw valueForKey:@"ZetsuApp"]; } @catch (id e) {}
        SEL miniSel = NSSelectorFromString(@"MinibtnEvent");
        if ([appCtl respondsToSelector:miniSel]) ((void (*)(id, SEL))objc_msgSend)(appCtl, miniSel);
    }
}
static void DMOpenWindowMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    if (DMNativeActiveApp()) { DMOpenNativeWindowMenu(btn); return; }   // (our Finder window in front: the Window menu is about it)
    BOOL enabled = (DMActiveEngine() != DMEngineNone || DMSMEngine()) && DMActiveApp() != nil;
    if (enabled && DMAppNeedsFullScreen([DMActiveApp() bundleIdentifier])) enabled = NO;   // a full-screen-only app: its window layouts are greyed out
    NSArray *sections = @[
        @[ @[@"Fill Screen", @"fill"], @[@"Center", @"center"] ],
        @[ @[@"Left Half", @"left"], @[@"Right Half", @"right"], @[@"Top Half", @"top"], @[@"Bottom Half", @"bottom"] ],
        @[ @[@"Top Left", @"topleft"], @[@"Top Right", @"topright"], @[@"Bottom Left", @"bottomleft"], @[@"Bottom Right", @"bottomright"] ],
        @[ @[@"Small", @"small"], @[@"Large", @"large"] ] ];
    NSMutableArray *items = [NSMutableArray array];
    if (DMActiveEngine() != DMEngineNone) {   // "Open Apps as Windows" (Aerial's Control Center toggle / our own switch with MilkyWay) and "Fit to Window", in a section of their own at the top
        DMRow *openRow = [[DMRow alloc] initWithTitle:@"Open Apps as Windows" enabled:YES handler:DMCloseThen(^{
            BOOL now = !DMWindowedLaunchOn();
            DMSetWindowedLaunch(now);
            DMLog([NSString stringWithFormat:@"[window] Open Apps as Windows switched %@", now ? @"on" : @"off"]);
        })];
        openRow.checked = DMWindowedLaunchOn();
        [items addObject:openRow];
        BOOL fit = DMFitEnabled();
        DMRow *fitRow = [[DMRow alloc] initWithTitle:@"Fit to Window" enabled:YES handler:DMCloseThen(^{
            BOOL now = !DMFitEnabled();
            DMSetFitEnabled(now);
            DMLog([NSString stringWithFormat:@"[window] Fit to Window switched %@", now ? @"on" : @"off"]);
        })];
        fitRow.checked = fit;
        [items addObject:fitRow];
        [items addObject:[[DMRow alloc] initWithTitle:@"Minimize All Windows" enabled:DMVisibleWindowCount() > 0 handler:DMCloseThen(^{ DMMinimizeAllWindows(); })]];
        // Windows tucked behind (or pulled in front of) a full-screen app, from here (like macOS's own Window menu "Bring All to Front"), not from the app
        // name menu, which is about the app itself, not its windows. Which of the two this offers follows where the windows already are.
        if (gWindowsBehindApps && DMVisibleWindowCount() > 0)
            [items addObject:[[DMRow alloc] initWithTitle:(gWindowsPinnedForward ? @"Send All to Back" : @"Bring All to Front") enabled:YES
                                                  handler:DMCloseThen(^{ DMToggleWindowsForward(); })]];
    } else if (DMSMEngine()) {   // (the same rows as with our other engines)
        DMRow *openRow = [[DMRow alloc] initWithTitle:@"Open Apps as Windows" enabled:YES handler:DMCloseThen(^{
            BOOL now = !DMWindowedLaunchOn();
            DMSetWindowedLaunch(now);
            DMLog([NSString stringWithFormat:@"[window] Open Apps as Windows switched %@ (Stage Manager)", now ? @"on" : @"off"]);
        })];
        openRow.checked = DMWindowedLaunchOn();
        [items addObject:openRow];
        DMRow *fitRow = [[DMRow alloc] initWithTitle:@"Fit to Window" enabled:YES handler:DMCloseThen(^{
            BOOL now = !DMFitEnabled();
            DMSetFitEnabled(now);
            DMLog([NSString stringWithFormat:@"[window] Fit to Window switched %@ (Stage Manager)", now ? @"on" : @"off"]);
            if (now) DMSMFitTick(YES);
        })];
        fitRow.checked = DMFitEnabled();
        [items addObject:fitRow];
        [items addObject:[[DMRow alloc] initWithTitle:@"Minimize All Windows" enabled:DMVisibleWindowCount() > 0 handler:DMCloseThen(^{ DMMinimizeAllWindows(); })]];
        NSString *active = [DMActiveApp() bundleIdentifier];
        if ([UIScreen screens].count > 1 && active.length)   // (a TV or monitor connected: the active app's window to the other screen -- Stage Manager's own move)
            [items addObject:[[DMRow alloc] initWithTitle:@"Move to Other Display" enabled:YES handler:DMCloseThen(^{ DMSMWindowAction(active, @"moveToDisplay"); })]];
        if (DMSMFullScreenBundle().length && DMVisibleWindowCount() > 0) {   // (a full-screen app with windows: which of them is in front)
            BOOL behind = DMSMWindowsBehindFullScreen();
            [items addObject:[[DMRow alloc] initWithTitle:(behind ? @"Bring All to Front" : @"Send All to Back") enabled:YES handler:DMCloseThen(^{ DMSMWindowsForward(behind); })]];
        }
    }
    NSString *currentLayout = DMCurrentLayoutName();
    for (NSArray *section in sections) {
        if (items.count) [items addObject:[NSNull null]];
        for (NSArray *entry in section) {
            NSString *layout = entry[1];
            DMRow *row = [[DMRow alloc] initWithTitle:entry[0] enabled:enabled handler:DMCloseThen(^{ DMWindowLayout(layout); })];
            row.checked = [layout isEqualToString:currentLayout];
            [items addObject:row];
        }
    }
    if (DMActiveEngine() != DMEngineNone || DMSMEngine()) {   // swap the places of opposed windows (only active when there is something to swap)
        [items addObject:[NSNull null]];
        [items addObject:[[DMRow alloc] initWithTitle:@"Swap Top and Bottom" enabled:DMSwapAvailable(NO) handler:DMCloseThen(^{ DMSwapWindows(NO); })]];
        [items addObject:[[DMRow alloc] initWithTitle:@"Swap Left and Right" enabled:DMSwapAvailable(YES) handler:DMCloseThen(^{ DMSwapWindows(YES); })]];
        [items addObject:[[DMRow alloc] initWithTitle:@"Swap Half and Quarter" enabled:DMHalfQuarterAvailable() handler:DMCloseThen(^{ DMSwapHalfWithQuarter(); })]];
    }
    DMPresentMenu(btn, kWinLabelKey, kWinPillKey, items);
    DMLog([NSString stringWithFormat:@"[window] menu opened (active app %@)", [DMActiveApp() bundleIdentifier]]);
}

// ---- Audio menu (right of Window): master mixing switch, plus one volume slider per currently-audio-playing app --------------------------------
// MixAudio (a separate tweak) hooks AVPlayer/AVAudioPlayer/AVAudioEngine inside every app and applies a per-bundle-ID multiplier.
//
// ROOT CAUSE FOUND LIVE (2026-09-23, real report: YouTube + Spotify genuinely mixing, Audio menu still said "no apps playing" -- the SAME
// bug reported once before and thought fixed by a staleness-timer change; that fix addressed a real secondary issue but not this one).
// Confirmed by inspecting a real app's container on-device: MA_VOL_DOMAIN / MA_NOWPLAYING_DOMAIN, both plain CFPreferences domains with
// kCFPreferencesAnyHost, do NOT actually behave as a shared location when written from inside a sandboxed app. cfprefsd silently redirects
// an app's write for an arbitrary (non-own-bundle) domain into that app's OWN container (.../Containers/Data/Application/<uuid>/Library/
// Preferences/<domain>.plist) -- found Spotify's own now-playing timestamp sitting ONLY there, never in the real shared location SpringBoard
// reads from (confirmed empty: /var/mobile/Library/Preferences has no such file at all). SpringBoard runs unsandboxed with its real home
// there, so it can never see what a sandboxed app "wrote to the shared domain" -- the domain was never actually shared to begin with. This
// also meant the per-app volume multiplier was silently non-functional the same way (the slider never got to appear to prove it, since the
// menu never had any candidate apps), just undiscovered until now.
//
// FIX: both directions moved off CFPreferences custom-domain sharing onto Darwin notify state (notifyd is a real system daemon, not
// container-scoped -- this is exactly the mechanism the mixAudio on/off toggle already used successfully this whole time, which is why THAT
// one never had this bug). Each app now posts its own "I'm playing, as of now" timestamp, and reads its own current volume multiplier, under
// names hashed from its own bundle ID (com.besiktasliseba.mixaudio.nowplaying.<hash> / com.besiktasliseba.mixaudio.setvolume.<hash>, the latter reusing the name
// already used for the reapply trigger). SpringBoard checks each currently-running app's exact name directly instead of trying to enumerate
// a shared domain's keys (which was never possible with notify state anyway, and was the actual dead end here). MA_VOL_DOMAIN is kept as
// SpringBoard's OWN bookkeeping only now (a slider's starting position across a respring) -- a same-process round trip, never crossing the
// sandbox boundary, so it stays reliable for that narrower purpose.
static void DMLoadPrefs(void);   // defined below; reused as-is by the Audio Mixing toggle so its notify_state translation is not duplicated here

// Live, uncached (see DMLoadPrefs's own comment on why): whether MixAudio's "let apps play together" switch is currently on.
static BOOL DMMixAudioOn(void) {
    BOOL mix = YES;
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("mixAudio"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (v) { if (CFGetTypeID(v) == CFBooleanGetTypeID()) mix = CFBooleanGetValue(v); CFRelease(v); }
    return mix;
}
// Requirement: the Audio menu should only be in the status bar while at least one app is playing audio. The system's own audio controller keeps
// exactly that flag (AVSystemController_AudioIsPlayingSomewhereAttribute; checked live on the M1: YES while Spotify plays), read through the
// shared controller's getter -- no subscription, nothing set. Its per-app list (PlayingSessionsDescription) comes back nil when asked this
// way, so which apps are listed inside the menu still comes from MixAudio for now. Read once a second from the 0.2 s tick (it is a call to
// the media server, so not on every tick). The title appears as soon as something plays and goes only after 3 s of silence, so a track
// change or a short gap doesn't make it blink, and never while a menu is open. If the controller can't be reached, it stays shown as before.
static BOOL gAudioTabShown = NO;
// Which apps are playing, straight from the same controller: "PlayingSessionsDescriptionAttribute" (that is the constant's real string -- the
// symbol is named AVSystemController_PlayingSessionsDescriptionAttribute, but asking by the symbol's name returns nil) is a list of
// { ClientPID, AudioSessionID, ... } for every session playing right now. Checked live on the M1: Spotify alone, then Spotify + YouTube, then
// Spotify, then nothing, exactly following what was played and paused. Readable with a plain getter, no notification subscription needed.
// Each PID is matched to its app through FrontBoard's process list. Web audio plays from WebKit's own helper processes, not from the app
// showing the page: a WebKit process counts for the app RunningBoard names as its host (Safari, or the app with the in-app browser), else for
// Safari when Safari is running (see DMAudioWebKitHosts).
static NSArray<NSString *> *gAudioPlayingBundleIDs = nil;   // nil until the controller has answered once
static NSDictionary<NSNumber *, NSString *> *gDMAudioPidToBundle = nil;   // every app process's pid -> bundle ID, as of the last check
static NSSet<NSString *> *gDMAudioWebOnly = nil;   // apps heard only through WebKit's processes (their level can't be changed, F13)
extern int proc_name(int pid, void *buffer, uint32_t buffersize);
// (F13: which app a WebKit process plays for. RunningBoard knows the app that hosts it; asked on the audio queue only (it is a question to
// runningboardd), once per WebKit process. 0 = not a WebKit process, or no answer: then the old guess -- Safari, if Safari is running -- is used.)
static int DMAudioHostPid(int pid) {
    Class idClass = objc_getClass("RBSProcessIdentifier"), handleClass = objc_getClass("RBSProcessHandle");
    SEL withPid = NSSelectorFromString(@"identifierWithPid:"), forId = NSSelectorFromString(@"handleForIdentifier:error:"), pidSel = NSSelectorFromString(@"pid");
    if (![idClass respondsToSelector:withPid] || ![handleClass respondsToSelector:forId]) return 0;
    id ident = ((id (*)(id, SEL, int))objc_msgSend)(idClass, withPid, pid);
    id handle = ident ? ((id (*)(id, SEL, id, NSError **))objc_msgSend)(handleClass, forId, ident, NULL) : nil;
    id host = DMCall(handle, @"hostProcess");
    if (!host || ![host respondsToSelector:pidSel]) return 0;
    int h = ((int (*)(id, SEL))objc_msgSend)(host, pidSel);
    return h > 0 && h != pid ? h : 0;
}
static NSDictionary<NSNumber *, NSNumber *> *DMAudioWebKitHosts(id sessions) {   // (audio queue only) WebKit pid -> host app pid
    static NSMutableDictionary<NSNumber *, NSNumber *> *cache;
    if (!cache) cache = [NSMutableDictionary dictionary];
    NSMutableDictionary<NSNumber *, NSNumber *> *out = [NSMutableDictionary dictionary];
    if (![sessions isKindOfClass:[NSArray class]]) return out;
    for (NSDictionary *session in (NSArray *)sessions) {
        if (![session isKindOfClass:[NSDictionary class]]) continue;
        int pid = [session[@"ClientPID"] intValue];
        if (pid <= 0) continue;
        NSNumber *host = cache[@(pid)];
        if (!host) {
            char name[64] = {0};
            proc_name(pid, name, sizeof name);
            host = @(strcasestr(name, "webkit") ? DMAudioHostPid(pid) : 0);
            if (cache.count > 64) [cache removeAllObjects];
            cache[@(pid)] = host;
        }
        if (host.intValue > 0) out[@(pid)] = host;
    }
    return out;
}
static NSArray<NSString *> *DMAudioBundleIDsForSessions(NSArray *sessions, NSDictionary<NSNumber *, NSNumber *> *webHosts) {
    NSMutableOrderedSet<NSString *> *ids = [NSMutableOrderedSet orderedSet];
    if (![sessions isKindOfClass:[NSArray class]] || !sessions.count) { gDMAudioWebOnly = nil; return ids.array; }
    NSMutableDictionary<NSNumber *, NSString *> *byPid = [NSMutableDictionary dictionary];
    id manager = DMCall(objc_getClass("FBProcessManager"), @"sharedInstance");
    SEL pidSel = NSSelectorFromString(@"pid");
    for (id process in (NSArray *)DMCall(manager, @"allApplicationProcesses")) {
        NSString *bid = [DMCall(process, @"bundleIdentifier") description];
        if (bid.length && [process respondsToSelector:pidSel]) byPid[@(((int (*)(id, SEL))objc_msgSend)(process, pidSel))] = bid;
    }
    gDMAudioPidToBundle = [byPid copy];
    BOOL safariRunning = [byPid.allValues containsObject:@"com.apple.mobilesafari"];
    NSMutableSet<NSString *> *web = [NSMutableSet set], *native = [NSMutableSet set];
    for (NSDictionary *session in sessions) {
        if (![session isKindOfClass:[NSDictionary class]]) continue;
        int pid = [session[@"ClientPID"] intValue];
        NSString *bid = byPid[@(pid)];
        if (bid) [native addObject:bid];
        else {
            char name[64] = {0};
            proc_name(pid, name, sizeof name);
            NSString *proc = @(name);
            if ([proc rangeOfString:@"WebKit" options:NSCaseInsensitiveSearch].location != NSNotFound) {
                NSNumber *hostPid = webHosts[@(pid)];
                NSString *host = hostPid ? byPid[hostPid] : nil;   // (the app showing the page: Safari, or another app's in-app browser)
                bid = host ?: (safariRunning ? @"com.apple.mobilesafari" : nil);
                static NSMutableSet *loggedWeb; if (!loggedWeb) loggedWeb = [NSMutableSet set];
                if (![loggedWeb containsObject:@(pid)]) { if (loggedWeb.count > 64) [loggedWeb removeAllObjects]; [loggedWeb addObject:@(pid)]; DMLog([NSString stringWithFormat:@"[audio] web audio from pid %d (%@): %@", pid, proc, host ? [NSString stringWithFormat:@"hosted by %@", host] : (bid ? @"host unknown, listed as Safari" : @"host unknown, not listed")]); }
                if (bid) [web addObject:bid];
            }
            else { static NSMutableSet *logged; if (!logged) logged = [NSMutableSet set]; if (![logged containsObject:proc]) { [logged addObject:proc]; DMLog([NSString stringWithFormat:@"[audio] playing session from pid %d (%@) matches no app -- not listed", pid, proc]); } }
        }
        if (bid) [ids addObject:bid];
    }
    [web minusSet:native];
    gDMAudioWebOnly = web;
    return ids.array;
}
static void DMAudioSingleSourceUpdate(NSArray<NSString *> *playing, BOOL mixingJustChanged);   // (below: one audible app while Audio Mixing is off)
// (Audio audit F15a: the two questions to the media server are asked on a background queue, never on SpringBoard's main thread, so a slow
// media server -- a Bluetooth route connecting, a route change -- can't make SpringBoard hitch. At most one question is on its way at a time;
// the answer is used on the main thread, where everything else here stays.)
static void DMAudioPlayingAnswer(id v, id sessions, NSDictionary *webHosts);
// (Audio audit F10: nothing is checked while the screen is off (the gated timers stop), so a heard app that stopped then left a silenced app
// playing unheard. When the screen comes on, the check runs on the very first tick; an app last seen before the screen went off is past the 3 s
// grace (DMAudioSingleSourceUpdate), so it counts as stopped at once and the app still playing is heard again right away.)
static BOOL gDMAudioCheckNow = NO;
static void DMWatchAudioPlaying(void) {
    static CFTimeInterval lastCheck = 0;
    static id controller = nil;
    static BOOL looked = NO, asking = NO;
    static dispatch_queue_t queue;
    CFTimeInterval now = CACurrentMediaTime();
    if ((now - lastCheck < 1.0 && !gDMAudioCheckNow) || asking) return;
    gDMAudioCheckNow = NO;
    lastCheck = now;
    SEL get = NSSelectorFromString(@"attributeForKey:");
    if (!looked) {
        looked = YES;
        controller = DMCall(objc_getClass("AVSystemController"), @"sharedAVSystemController");
        if (controller && ![controller respondsToSelector:get]) controller = nil;
        if (!controller) DMLog(@"[audio] no system audio controller: the Audio title stays shown all the time");
        queue = dispatch_queue_create("com.besiktasliseba.macstatusbar.audiowatch", DISPATCH_QUEUE_SERIAL);
    }
    if (!controller) { DMAudioPlayingAnswer(nil, nil, nil); return; }
    asking = YES;
    id c = controller;
    dispatch_async(queue, ^{
        id v = ((id (*)(id, SEL, id))objc_msgSend)(c, get, @"AVSystemController_AudioIsPlayingSomewhereAttribute");
        id sessions = ((id (*)(id, SEL, id))objc_msgSend)(c, get, @"PlayingSessionsDescriptionAttribute");
        NSDictionary *webHosts = DMAudioWebKitHosts(sessions);
        dispatch_async(dispatch_get_main_queue(), ^{ asking = NO; DMAudioPlayingAnswer(v ?: [NSNull null], sessions, webHosts); });
    });
}
// v nil = no controller (the title stays shown); otherwise the controller's answers (NSNull when it gave none).
static void DMAudioRefreshOpenRows(void);
static void DMAudioPlayingAnswer(id v, id sessions, NSDictionary *webHosts) {
    static CFTimeInterval silentSince = 0;
    CFTimeInterval now = CACurrentMediaTime();
    BOOL playing = YES;
    if (v) {
        playing = [v respondsToSelector:@selector(boolValue)] && [v boolValue];
        if ([sessions isKindOfClass:[NSArray class]]) {
            NSArray<NSString *> *ids = DMAudioBundleIDsForSessions(sessions, webHosts);
#if DEBUG
            extern NSArray<NSString *> *gDMAudioSim;
            if (gDMAudioSim) ids = gDMAudioSim;   // (debug: audiosim_ stands in for the system's list)
#endif
            if (![ids isEqualToArray:gAudioPlayingBundleIDs ?: @[]] || !gAudioPlayingBundleIDs) {
                DMLog([NSString stringWithFormat:@"[audio] playing apps: %@", ids.count ? [ids componentsJoinedByString:@", "] : @"none"]);
                gAudioPlayingBundleIDs = ids;
            }
            DMAudioSingleSourceUpdate(ids, NO);
            DMAudioRefreshOpenRows();
            if (ids.count) playing = YES;
        }
    }
    BOOL show = gAudioTabShown;
    if (playing || gOverlay) { silentSince = 0; if (playing) show = YES; }
    else if (gAudioTabShown) {
        if (silentSince == 0) silentSince = now;
        else if (now - silentSince >= 3.0) show = NO;
    }
    if (show == gAudioTabShown) return;
    gAudioTabShown = show;
    DMLog([NSString stringWithFormat:@"[audio] %@ -- %@ the Audio title", playing ? @"audio started" : @"silent for 3 s", show ? @"showing" : @"hiding"]);
    for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];
}
static float DMAudioVolumeForBundle(NSString *bid) {
    if (!bid.length) return 1.0f;
    CFPropertyListRef v = CFPreferencesCopyValue((__bridge CFStringRef)bid, MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    float vol = 1.0f;
    if (v) {
        if (CFGetTypeID(v) == CFNumberGetTypeID()) { double d = 1.0; if (CFNumberGetValue((CFNumberRef)v, kCFNumberDoubleType, &d)) vol = (float)d; }
        CFRelease(v);
    }
    if (vol < 0.0f) vol = 0.0f; else if (vol > 1.0f) vol = 1.0f;
    return vol;
}
// The same FNV-1a hash MacAppBridge and MixAudio itself compute from a bundle ID, so the notification name lines up on both ends.
static uint32_t DMFNV1aHash(NSString *s) {
    uint32_t hash = 2166136261u;
    for (const char *c = s.UTF8String; c && *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
    return hash;
}
static void DMPostAudioVolumeNotify(NSString *bid) {
    char name[64];
    snprintf(name, sizeof name, "com.besiktasliseba.mixaudio.setvolume.%08x", DMFNV1aHash(bid));
    notify_post(name);
}
// One notify_register_check token per bundle, cached -- registering fresh every drag tick would work too (notifyd doesn't mind), but this
// avoids the syscall churn while a slider is actively being dragged.
static int DMAudioVolumeToken(NSString *bid) {
    static NSMutableDictionary<NSString *, NSNumber *> *tokens;
    if (!tokens) tokens = [NSMutableDictionary dictionary];
    NSNumber *cached = tokens[bid];
    if (cached) return cached.intValue;
    char name[64];
    snprintf(name, sizeof name, "com.besiktasliseba.mixaudio.setvolume.%08x", DMFNV1aHash(bid));
    int token = 0;
    notify_register_check(name, &token);
    if (token) tokens[bid] = @(token);
    return token;
}
// Writes the multiplier immediately (CFPreferencesSetValue alone is cheap, no disk I/O), but throttles the disk sync + Darwin notification to
// roughly every 80 ms while dragging -- "not literally every pixel of movement" -- always flushing on `commit` (touch released, or the mute button).
// The CFPreferences write is SpringBoard's own bookkeeping now (see this section's header comment) -- the live value MixAudio actually reads
// is the notify_set_state call below, sent on the SAME name as the existing reapply-trigger post so one register/token pair covers both.
static void DMSetAudioVolumeAndNotify(NSString *bid, float value, BOOL commit) {
    if (!bid.length) return;
    if (value < 0.0f) value = 0.0f; else if (value > 1.0f) value = 1.0f;
    double d = value;
    CFNumberRef n = CFNumberCreate(NULL, kCFNumberDoubleType, &d);
    CFPreferencesSetValue((__bridge CFStringRef)bid, n, MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    CFRelease(n);
    static NSMutableDictionary<NSString *, NSNumber *> *lastPost;
    if (!lastPost) lastPost = [NSMutableDictionary dictionary];
    CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
    NSNumber *last = lastPost[bid];
    if (!commit && last && (now - last.doubleValue) < 0.08) return;
    lastPost[bid] = @(now);
    CFPreferencesSynchronize(MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    extern BOOL DMAudioIsSourceMuted(NSString *bid);
    extern BOOL DMAudioInCall(NSString *bid);
    if (DMAudioIsSourceMuted(bid)) return;   // (silenced while Audio Mixing is off: the new value is kept for later, the app stays silent)
    if (DMAudioInCall(bid)) return;          // (in a call: full level until it ends, then this value, audio audit F1)
    int token = DMAudioVolumeToken(bid);
    // +1 sentinel: state 0 means "MixAudio has never had a value set for this bundle" (default full volume); an explicit mute (0.0) has to
    // encode to a nonzero state to be distinguishable from that, so every real value is stored as round(value*1e6)+1.
    if (token) notify_set_state(token, (uint64_t)(value * 1000000.0 + 0.5) + 1);
    DMPostAudioVolumeNotify(bid);
}
// ===== One audible app while Audio Mixing is off (2026-09-25) =====================================================================================
// Switching mixing off only changes how apps set up their audio from then on; apps already playing together would go on playing together. So
// while it is off, exactly one app is heard: the front-most playing app, else the one that started playing last; every other playing app is
// silenced through MixAudio's own per-app volume (its multiplier set to 0 -- the app's own slider value is kept and nothing in the app changes),
// and an app that starts playing while it is off takes over. Switching mixing back on gives every app its own slider value back; an app that
// only started while it was off gets the level of the app that was heard. The Audio menu shows silenced apps muted (DMSliderRow.sourceMuted).
#if DEBUG
NSArray<NSString *> *gDMAudioSim = nil;   // (debug: audiosim_)
#endif
static NSString *gDMAudioSource = nil;                                  // the app that is heard
static NSMutableSet<NSString *> *gDMAudioSourceMuted = nil;             // apps silenced for it (never an app in a call, see DMAudioUpdateCalls)
static NSMutableDictionary<NSString *, NSNumber *> *gDMAudioStarted = nil;   // when each playing app was first seen playing
static NSMutableSet<NSString *> *gDMAudioStartedWhileOff = nil;         // apps first seen playing while mixing was off
static BOOL gDMAudioSingleActive = NO;
BOOL DMAudioIsSourceMuted(NSString *bid) { return bid && [gDMAudioSourceMuted containsObject:bid]; }
static void DMAudioPublish(NSString *bid, float value) {   // what MixAudio in the app applies (notify state only; the saved slider value stays)
    int token = DMAudioVolumeToken(bid);
    if (token) notify_set_state(token, (uint64_t)(MAX(0.0f, MIN(1.0f, value)) * 1000000.0 + 0.5) + 1);
    DMPostAudioVolumeNotify(bid);
}
// The per-app levels MixAudio applies live in notifyd state, which is gone after a respring (SpringBoard held the registration): an app started
// afterwards played at full volume while its Audio-menu slider still showed the saved level (seen with Jetpack Joyride at 10%). So every saved slider
// value is published again once SpringBoard is up.
static void DMAudioRepublishSaved(void) {
    CFArrayRef keys = CFPreferencesCopyKeyList(MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    NSUInteger n = 0;
    if (keys) {
        for (id k in (__bridge NSArray *)keys) if ([k isKindOfClass:[NSString class]] && [(NSString *)k length] && !DMAudioIsSourceMuted(k)) { DMAudioPublish(k, DMAudioVolumeForBundle(k)); n++; }
        CFRelease(keys);
    }
    DMLog([NSString stringWithFormat:@"[audio] saved per-app levels published again after the start: %lu app(s)", (unsigned long)n]);
}
// ---- calls are never touched (audio audit F1) ----
// An app in a call is left out of the one-app rule (never silenced, never "the heard app") and its level is published as full while the call lasts
// (its slider value is kept for afterwards). In a call: Apple's own call apps whenever they play; an app whose MixAudio reports a call (its session is
// in a voice / video chat mode or it has a voice-processing unit, see MixAudio.x); and the app behind every CallKit call SpringBoard knows about.
static NSMutableSet<NSString *> *gDMAudioInCall = nil;
BOOL DMAudioInCall(NSString *bid) { return bid && [gDMAudioInCall containsObject:bid]; }
static int DMAudioCallToken(NSString *bid) {
    static NSMutableDictionary<NSString *, NSNumber *> *tokens;
    if (!tokens) tokens = [NSMutableDictionary dictionary];
    NSNumber *cached = tokens[bid];
    if (cached) return cached.intValue;
    char name[64];
    snprintf(name, sizeof name, "com.besiktasliseba.mixaudio.call.%08x", DMFNV1aHash(bid));
    int token = 0;
    notify_register_check(name, &token);
    if (token) tokens[bid] = @(token);
    return token;
}
static NSSet<NSString *> *DMAudioCallBundleIDs(NSArray<NSString *> *playing) {
    NSMutableSet<NSString *> *calls = [NSMutableSet set];
    if (!playing.count) return calls;
    static NSSet *apple;
    if (!apple) apple = [NSSet setWithArray:@[@"com.apple.mobilephone", @"com.apple.InCallService", @"com.apple.facetime", @"com.apple.TelephonyUtilities", @"com.apple.CarPlayApp"]];
    for (NSString *bid in playing) {
        if ([apple containsObject:bid]) { [calls addObject:bid]; continue; }
        uint64_t st = 0; int t = DMAudioCallToken(bid);
        if (t && notify_get_state(t, &st) == NOTIFY_STATUS_OK && st != 0 && [gDMAudioPidToBundle[@((int)st)] isEqualToString:bid]) [calls addObject:bid];   // (the pid must still be that app's)
    }
    Class center = objc_getClass("TUCallCenter");   // CallKit calls (WhatsApp, Teams...): the provider of each current call names its app
    id calls2 = center ? DMCall(DMCall(center, @"sharedInstance"), @"currentCalls") : nil;
    if ([calls2 isKindOfClass:[NSArray class]]) for (id call in (NSArray *)calls2) {
        id b = DMCall(DMCall(call, @"provider"), @"bundleIdentifier");
        if ([b isKindOfClass:[NSString class]] && [playing containsObject:b]) [calls addObject:b];
    }
    return calls;
}
// Updates the in-call set: an app entering a call is taken out of the one-app rule and published at full level; one leaving gets its slider level back.
static void DMAudioUpdateCalls(NSArray<NSString *> *playing) {
    NSSet<NSString *> *now = DMAudioCallBundleIDs(playing);
    if (!gDMAudioInCall) gDMAudioInCall = [NSMutableSet set];
    for (NSString *bid in now) if (![gDMAudioInCall containsObject:bid]) {
        [gDMAudioSourceMuted removeObject:bid];
        if ([bid isEqualToString:gDMAudioSource]) gDMAudioSource = nil;
        DMAudioPublish(bid, 1.0f);
        DMLog([NSString stringWithFormat:@"[audio] %@ is in a call: full level, left out of the one-app rule", bid]);
    }
    for (NSString *bid in gDMAudioInCall.allObjects) if (![now containsObject:bid]) {
        [gDMAudioInCall removeObject:bid];
        if (![gDMAudioSourceMuted containsObject:bid]) DMAudioPublish(bid, DMAudioVolumeForBundle(bid));
        DMLog([NSString stringWithFormat:@"[audio] %@ call over: its own level again", bid]);
    }
    [gDMAudioInCall unionSet:now];
}
static void DMAudioSetSource(NSString *src, NSArray<NSString *> *playing) {
    BOOL newSource = src && ![src isEqualToString:gDMAudioSource];
    if (newSource) DMLog([NSString stringWithFormat:@"[audio] mixing off: %@ is heard%@", src, gDMAudioSource ? [NSString stringWithFormat:@" instead of %@", gDMAudioSource] : @""]);
    gDMAudioSource = src;
    for (NSString *bid in playing) {
        if ([bid isEqualToString:src] || DMAudioInCall(bid)) continue;   // (F1: a call is never silenced)
        if (![gDMAudioSourceMuted containsObject:bid]) { [gDMAudioSourceMuted addObject:bid]; DMAudioPublish(bid, 0.0f); DMLog([NSString stringWithFormat:@"[audio] mixing off: %@ silenced", bid]); }
    }
    // (F4: the heard app always gets its own level published when it becomes the heard one, not only when this run silenced it: after a respring
    // this run's sets are empty, and an app silenced by the SpringBoard before still sits at 0 in notify state)
    if (src && ([gDMAudioSourceMuted containsObject:src] || newSource) && !DMAudioInCall(src)) { [gDMAudioSourceMuted removeObject:src]; DMAudioPublish(src, DMAudioVolumeForBundle(src)); }
}
static void DMAudioMakeSource(NSString *bid) {   // the Audio menu: this silenced app is the one to hear now
    if (!gDMAudioSingleActive || !bid) return;
    DMAudioSetSource(bid, gAudioPlayingBundleIDs ?: @[]);
}
static void DMAudioSingleSourceUpdate(NSArray<NSString *> *playing, BOOL mixingJustChanged) {
    if (!gDMAudioSourceMuted) { gDMAudioSourceMuted = [NSMutableSet set]; gDMAudioStarted = [NSMutableDictionary dictionary]; gDMAudioStartedWhileOff = [NSMutableSet set]; }
    if (!playing) return;   // (the system has not answered yet)
    CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
    // (F4: after a respring or a SpringBoard crash, an app that survived may still sit at the level 0 an earlier SpringBoard's one-app rule gave it,
    // and this run knows nothing about it (DMAudioRepublishSaved only covers apps with a saved slider). So once per run every running app gets its
    // own level (saved slider, else 100%) published, as soon as the process list is known, and so does every app the first time it is seen playing.
    // The one-app rule below then silences again whatever it has to, in the same pass, so nothing is heard that shouldn't be.)
    static NSMutableSet<NSString *> *published;
    if (!published) published = [NSMutableSet set];
    NSMutableArray<NSString *> *fresh = [NSMutableArray array];
    static BOOL allRunningDone = NO;
    if (!allRunningDone && gDMAudioPidToBundle) { allRunningDone = YES; [fresh addObjectsFromArray:gDMAudioPidToBundle.allValues]; }
    [fresh addObjectsFromArray:playing];
    NSUInteger republished = 0;
    for (NSString *bid in fresh) {
        if ([published containsObject:bid]) continue;
        [published addObject:bid];
        if (DMAudioIsSourceMuted(bid) || DMAudioInCall(bid)) continue;
        DMAudioPublish(bid, DMAudioVolumeForBundle(bid)); republished++;
    }
    if (republished) DMLog([NSString stringWithFormat:@"[audio] own level published for %lu app(s) seen for the first time since the start", (unsigned long)republished]);
    // (F5: an app counts as stopped only after it has been missing from the system's list for 3 s. Buffering, an ad break, the gap between two
    // tracks or videos drop an app out of the list for about a second; it used to count as stopped at once and as a NEW app when it came back,
    // so the heard app flipped, and a silenced app coming back from a track gap took the audio from the heard one. Within the grace an app keeps
    // its place: the heard app stays heard (the others stay silenced), a silenced one stays silenced and keeps its old start time.)
    static NSMutableDictionary<NSString *, NSNumber *> *lastSeen;
    if (!lastSeen) lastSeen = [NSMutableDictionary dictionary];
    for (NSString *bid in playing) lastSeen[bid] = @(now);
    NSMutableArray<NSString *> *withGrace = [playing mutableCopy];
    for (NSString *bid in gDMAudioStarted.allKeys) {
        if ([playing containsObject:bid]) continue;
        if (now - [lastSeen[bid] doubleValue] < 3.0) [withGrace addObject:bid];
        else [lastSeen removeObjectForKey:bid];
    }
    playing = withGrace;
    DMAudioUpdateCalls(playing);
    BOOL off = !DMMixAudioOn();
    NSMutableArray<NSString *> *started = [NSMutableArray array];
    for (NSString *bid in playing) if (!gDMAudioStarted[bid]) { gDMAudioStarted[bid] = @(now); if (!DMAudioInCall(bid)) { [started addObject:bid]; if (off) [gDMAudioStartedWhileOff addObject:bid]; } }
    // (apps in a call take no part in the rule below: they are never picked, silenced or restored by it; their start is still noted above, so
    // an app whose call ends while it goes on playing is not a "new" app that takes over)
    NSArray<NSString *> *stillPlaying = playing;   // (with the apps in a call: those have not stopped)
    playing = [playing filteredArrayUsingPredicate:[NSPredicate predicateWithBlock:^BOOL(NSString *bid, NSDictionary *b) { return !DMAudioInCall(bid); }]];
    for (NSString *bid in gDMAudioStarted.allKeys) if (![stillPlaying containsObject:bid]) {
        [gDMAudioStarted removeObjectForKey:bid];
        [gDMAudioStartedWhileOff removeObject:bid];   // (F11: an app that stopped -- after the grace -- inherits nothing later)
        if ([gDMAudioSourceMuted containsObject:bid]) { [gDMAudioSourceMuted removeObject:bid]; DMAudioPublish(bid, DMAudioVolumeForBundle(bid)); }   // (stopped: not left silenced)
        if ([bid isEqualToString:gDMAudioSource]) gDMAudioSource = nil;
    }
    if (!off) {
        if (!gDMAudioSingleActive) return;
        // mixing is back on: every app its own level; an app that only started while it was off gets the level of the app that was heard
        float heard = gDMAudioSource ? DMAudioVolumeForBundle(gDMAudioSource) : 1.0f;
        if (heard < 0.05f) heard = 1.0f;   // (F11: the heard app was muted with its own speaker button: a new app starts at 100%, not silent for good)
        for (NSString *bid in gDMAudioStartedWhileOff) {
            CFPropertyListRef v = CFPreferencesCopyValue((__bridge CFStringRef)bid, MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            if (v) { CFRelease(v); continue; }
            double d = heard; CFNumberRef n = CFNumberCreate(NULL, kCFNumberDoubleType, &d);
            CFPreferencesSetValue((__bridge CFStringRef)bid, n, MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost); CFRelease(n);
        }
        CFPreferencesSynchronize(MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        NSMutableSet *restore = [gDMAudioSourceMuted mutableCopy]; [restore unionSet:gDMAudioStartedWhileOff]; [restore minusSet:gDMAudioInCall ?: [NSSet set]];
        for (NSString *bid in restore) DMAudioPublish(bid, DMAudioVolumeForBundle(bid));
        DMLog([NSString stringWithFormat:@"[audio] mixing on: %lu app(s) given their own level back (%@)", (unsigned long)restore.count, [restore.allObjects componentsJoinedByString:@", "]]);
        [gDMAudioSourceMuted removeAllObjects]; [gDMAudioStartedWhileOff removeAllObjects];
        gDMAudioSource = nil; gDMAudioSingleActive = NO;
        return;
    }
    BOOL first = !gDMAudioSingleActive;
    gDMAudioSingleActive = YES;
    NSString *src = gDMAudioSource;
    if (!first && started.count) {   // a new app started playing: it takes over (the latest of them)
        src = started.lastObject;
    }
    if (!src || ![playing containsObject:src]) {
        // (a window in front of the full-screen app is the front-most one: a YouTube window over a full-screen game is the app heard, not the game)
        NSString *topWin = DMWindowsOwnStatusBar() ? DMStageBundle(DMTopStage()) : nil;
        NSString *front = [DMFrontApp() bundleIdentifier];
        if (topWin && [playing containsObject:topWin]) src = topWin;
        else if (front && [playing containsObject:front]) src = front;
        else {
            src = nil; double latest = -1;
            for (NSString *bid in playing) if ([gDMAudioStarted[bid] doubleValue] > latest) { latest = [gDMAudioStarted[bid] doubleValue]; src = bid; }
        }
    }
    if (src || first || mixingJustChanged) DMAudioSetSource(src, playing);
}

// Which apps to show a slider for: confirmed live on device (classearch_/methsearch_, read-only) that MPNowPlayingInfoCenter/MRNowPlayingController
// only ever track ONE current "now playing" app system-wide -- no enumeration of the several apps MixAudio is specifically for having play at
// once. So instead: every RUNNING app that already has a saved multiplier (SpringBoard's own bookkeeping, worth still showing even if quiet
// right now), plus every currently-running app whose own per-bundle Darwin notify state says it set a playback-ish AVAudioSession category
// recently (see this section's header comment for why this can no longer be a shared-domain enumeration -- there's no "list all keys" with
// notify state, so this checks each running app's own exact name directly instead, which is both correct AND simpler than the old approach).
//
// BUG FOUND LIVE (2026-09-23, real report: menu showed Spotify/YouTube as mixing apps with NEITHER app even open, no audio playing at all):
// the saved-multiplier fallback added every bundle EVER given a slider position, with no check that the app was even still running --
// "worth still showing even if quiet right now" was meant for a running-but-currently-paused app, not one closed entirely. Fixed by
// intersecting with DMUserRunningApps() the same way the nowplaying check already does, instead of taking the saved-multiplier list as-is.
static NSArray<NSString *> *DMAudioCandidateBundleIDsAll(void);
static NSArray<NSString *> *DMAudioCandidateBundleIDs(void) {   // (1.3.3, audit L-24: apps hidden with AppHider get no row of their own -- not named on screen)
    NSArray<NSString *> *all = DMAudioCandidateBundleIDsAll();
    NSSet *hidden = DMFinderHiddenApps();
    if (!hidden.count) return all;
    NSMutableArray *shown = [NSMutableArray array];
    for (NSString *b in all) if (![hidden containsObject:b]) [shown addObject:b];
    return shown;
}
static NSArray<NSString *> *DMAudioCandidateBundleIDsAll(void) {
    if (gAudioPlayingBundleIDs) return gAudioPlayingBundleIDs;   // the system's own list (see DMWatchAudioPlaying); below is the old guess, kept only as a fallback
    NSMutableOrderedSet<NSString *> *ids = [NSMutableOrderedSet orderedSet];
    NSArray<SBApplication *> *running = DMUserRunningApps();
    NSMutableSet<NSString *> *runningBundleIDs = [NSMutableSet set];
    for (SBApplication *app in running) { NSString *bid = [app bundleIdentifier]; if (bid.length) [runningBundleIDs addObject:bid]; }

    CFArrayRef volKeys = CFPreferencesCopyKeyList(MA_VOL_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (volKeys) {
        for (id k in (__bridge NSArray *)volKeys) if ([k isKindOfClass:[NSString class]] && [runningBundleIDs containsObject:k]) [ids addObject:k];
        CFRelease(volKeys);
    }

    CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
    for (SBApplication *app in running) {
        NSString *bid = [app bundleIdentifier];
        if (!bid.length) continue;
        char name[64];
        snprintf(name, sizeof name, "com.besiktasliseba.mixaudio.nowplaying.%08x", DMFNV1aHash(bid));
        int token = 0;
        notify_register_check(name, &token);
        uint64_t state = 0;
        BOOL playing = token && notify_get_state(token, &state) == NOTIFY_STATUS_OK && state != 0 && (now - (CFAbsoluteTime)state) < kAudioIdleWindow;
        if (token) notify_cancel(token);
        if (playing) [ids addObject:bid];
    }
    return ids.array;
}
// (F13) Why an app's level can't be changed right now, or nil. "MixAudio runs in it" = the app's current pid published itself (MixAudio.x, alive
// state); an app relaunched without tweaks or excluded in Choicy never does, and a new launch with tweaks does at once.
static int DMAudioAliveToken(NSString *bid) {
    static NSMutableDictionary<NSString *, NSNumber *> *tokens;
    if (!tokens) tokens = [NSMutableDictionary dictionary];
    NSNumber *cached = tokens[bid];
    if (cached) return cached.intValue;
    char name[64];
    snprintf(name, sizeof name, "com.besiktasliseba.mixaudio.alive.%08x", DMFNV1aHash(bid));
    int token = 0;
    notify_register_check(name, &token);
    if (token) tokens[bid] = @(token);
    return token;
}
static NSString *DMAudioBlockedHint(NSString *bid) {
    if (!bid.length) return nil;
    if (DMAudioInCall(bid)) return @"In a call";
    if ([gDMAudioWebOnly containsObject:bid]) return @"Can't be adjusted";
    if (!gDMAudioPidToBundle) return nil;   // (no process list yet: unknown, left adjustable as before)
    uint64_t st = 0; int t = DMAudioAliveToken(bid);
    if (t && notify_get_state(t, &st) == NOTIFY_STATUS_OK && st != 0 && [gDMAudioPidToBundle[@((int)st)] isEqualToString:bid]) return nil;
    return @"Can't be adjusted";
}
static NSHashTable<DMSliderRow *> *gDMAudioRows = nil;   // the Audio menu's rows while it is open (weak)
static void DMAudioRefreshOpenRows(void) {
    for (DMSliderRow *row in gDMAudioRows.allObjects) if (row.window) row.blockedHint = DMAudioBlockedHint(row.bundleID);
}
static void DMOpenAudioMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    NSMutableArray *items = [NSMutableArray array];

    DMRow *toggle = [[DMRow alloc] initWithTitle:@"Audio Mixing" enabled:YES handler:DMCloseThen(^{
        BOOL now = !DMMixAudioOn();
        CFPreferencesSetValue(CFSTR("mixAudio"), now ? kCFBooleanTrue : kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        DMLoadPrefs();   // reuses DMLoadPrefs's own existing mix-audio block, which posts com.besiktasliseba.mixaudio.disabled -- not duplicated here
        DMLog([NSString stringWithFormat:@"[audio] Audio Mixing switched %@", now ? @"on" : @"off"]);
        DMAudioSingleSourceUpdate(gAudioPlayingBundleIDs, YES);
    })];
    toggle.checked = DMMixAudioOn();
    [items addObject:toggle];

    NSArray<NSString *> *bids = DMAudioCandidateBundleIDs();
    [items addObject:[NSNull null]];
    if (bids.count) {
        for (NSString *bid in bids) {
            NSString *name = DMCall(DMProxyForBundle(bid), @"localizedName") ?: bid;
            float vol = DMAudioVolumeForBundle(bid);
            DMSliderRow *row = [[DMSliderRow alloc] initWithBundleID:bid title:name volume:vol];
            row.onChange = ^(float value, BOOL commit) { DMSetAudioVolumeAndNotify(bid, value, commit); };
            __weak DMSliderRow *weakRow = row;
            row.onMakeSource = ^{
                DMAudioMakeSource(bid);
                for (UIView *v in weakRow.superview.subviews) if ([v isKindOfClass:[DMSliderRow class]]) ((DMSliderRow *)v).sourceMuted = DMAudioIsSourceMuted(((DMSliderRow *)v).bundleID);
            };
            row.sourceMuted = DMAudioIsSourceMuted(bid);
            row.blockedHint = DMAudioBlockedHint(bid);
            if (!gDMAudioRows) gDMAudioRows = [NSHashTable weakObjectsHashTable];
            [gDMAudioRows addObject:row];
            [items addObject:row];
        }
    } else {
        [items addObject:[[DMRow alloc] initWithTitle:@"No Apps Playing Audio" enabled:NO handler:nil]];
    }

    DMPresentMenu(btn, kAudioLabelKey, kAudioPillKey, items);
    DMLog([NSString stringWithFormat:@"[audio] menu opened with %lu app row(s)", (unsigned long)bids.count]);
}

// The SSH icon in the status bar opens a small menu, like the Wi-Fi menu on a Mac: it shows whether OpenSSH is on and turns it on or off (the root helper
// of Mac Settings does the work; this only posts the request).
static const void *kSSHMenuLabelKey = &kSSHMenuLabelKey, *kSSHMenuPillKey = &kSSHMenuPillKey;
static BOOL DMSSHSessionActive(void);
static void DMOpenSSHMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    BOOL connected = DMSSHSessionActive();
    DMRow *state = [[DMRow alloc] initWithTitle:@"SSH: On" enabled:NO handler:nil];
    DMRow *detail = [[DMRow alloc] initWithTitle:connected ? @"Someone is connected" : @"Nobody is connected" enabled:NO handler:nil];
    DMRow *off = [[DMRow alloc] initWithTitle:@"Turn SSH Off" enabled:YES handler:DMCloseThen(^{
        // (hardening: the root helper takes what to do from MacSettings' own preference -- written here as Settings does -- and the notification only
        // says "look again"; the old .disable notification is no longer acted on once the preference exists)
        CFPreferencesSetValue(CFSTR("sshWanted"), kCFBooleanFalse, CFSTR("com.besiktasliseba.macsettings"), kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(CFSTR("com.besiktasliseba.macsettings"), kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        notify_post("com.besiktasliseba.sshtoggle.changed");
        gSSHActive = NO;   // the icon goes at once; the helper's own answer (the state file) follows a moment later. It comes back when SSH is switched on in Settings.
        for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];
        DMLog(@"[ssh] switched off from the status bar");
    })];
    DMPresentMenu(btn, kSSHMenuLabelKey, kSSHMenuPillKey, @[state, detail, [NSNull null], off]);
}

// The VPN icon: like the Wi-Fi menu on a Mac, but for a VPN — it only shows while a tunnel is actually connected (Control Center still has its own icon
// for turning one on or off; this is only about knowing one is on, and reaching the app behind it).
static const void *kVPNMenuLabelKey = &kVPNMenuLabelKey, *kVPNMenuPillKey = &kVPNMenuPillKey;
// The icon is iOS's own VPN badge (28 Sep: the native VPN sign), from UIKit's status bar artwork ("Black_VPN", the template the stock
// VPN item draws, tinted like the other icons). If a later iPadOS renames it: the same badge drawn -- a rounded box with "VPN" in it.
static UIImage *DMVPNGlyph(CGFloat textSize) {
    static UIImage *glyph = nil;
    static BOOL tried = NO;
    if (tried) return glyph;
    tried = YES;
    NSBundle *artwork = [NSBundle bundleWithPath:@"/System/Library/PrivateFrameworks/UIKitCore.framework/Artwork.bundle"];
    SEL kit = NSSelectorFromString(@"kitImageNamed:");
    for (NSString *name in @[@"Black_VPN", @"VPN"]) {
        if ([UIImage respondsToSelector:kit]) glyph = ((UIImage *(*)(id, SEL, NSString *))objc_msgSend)([UIImage class], kit, name);
        if (!glyph && artwork) glyph = [UIImage imageNamed:name inBundle:artwork compatibleWithTraitCollection:nil];
        if (glyph) { DMLog([NSString stringWithFormat:@"[vpn] icon: iOS's %@ (%.1f x %.1f)", name, glyph.size.width, glyph.size.height]); break; }
    }
    if (!glyph) {
        UIFont *font = [UIFont systemFontOfSize:MAX(8.0, textSize - 4.0) weight:UIFontWeightBold];
        NSDictionary *attrs = @{NSFontAttributeName: font, NSForegroundColorAttributeName: UIColor.blackColor};
        CGSize ts = [@"VPN" sizeWithAttributes:attrs];
        CGSize size = CGSizeMake(ceil(ts.width) + 6.0, ceil(font.capHeight) + 6.0);
        glyph = [[[UIGraphicsImageRenderer alloc] initWithSize:size] imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
            UIBezierPath *box = [UIBezierPath bezierPathWithRoundedRect:CGRectInset((CGRect){CGPointZero, size}, 0.75, 0.75) cornerRadius:2.5];
            box.lineWidth = 1.5;
            [UIColor.blackColor setStroke]; [box stroke];
            [@"VPN" drawAtPoint:CGPointMake((size.width - ts.width) / 2.0, (size.height - ts.height) / 2.0) withAttributes:attrs];
        }];
        DMLog(@"[vpn] icon: iOS's VPN artwork not found, drawn badge");
    }
    glyph = [glyph imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
    return glyph;
}
static void DMOpenVPNMenu(UIButton *btn) {
    if (DMTitleTapWithMenuOpen(btn)) return;
    NSString *name = gVPNAppName.length ? gVPNAppName : @"a VPN";
    DMRow *state = [[DMRow alloc] initWithTitle:@"VPN: Connected" enabled:NO handler:nil];
    // (the second line: just the connected VPN's name, as Settings > VPN lists it)
    DMRow *detail = [[DMRow alloc] initWithTitle:gVPNConfigName.length ? gVPNConfigName : name enabled:NO handler:nil];
    NSMutableArray *items = [NSMutableArray arrayWithObjects:state, detail, [NSNull null], nil];
    id manager = gVPNManager;
#if DEBUG
    if (gVPNFakeProvider) manager = [NSNull null];   // (tests: the row is shown; tapping it only logs)
#endif
    if (manager) {   // Disconnect, the same as the switch in Settings > VPN (no Connect here: the icon shows only while connected)
        [items addObject:[[DMRow alloc] initWithTitle:@"Disconnect" enabled:YES handler:DMCloseThen(^{
            if (![manager isKindOfClass:[NEVPNManager class]]) { DMLog(@"[vpn] disconnect asked from the status bar -- test, nothing stopped"); return; }
            DMVPNDisconnect(manager);
        })]];
        [items addObject:[NSNull null]];
    }
    if (gVPNAppBundleID.length) {   // (the app itself, not its tunnel extension: DMVPNAppForProvider)
        NSString *app = gVPNAppBundleID;
        [items addObject:[[DMRow alloc] initWithTitle:[NSString stringWithFormat:@"Open %@", name] enabled:YES handler:DMCloseThen(^{
            DMOpenApp(app);
            DMLog([NSString stringWithFormat:@"[vpn] opened %@ from the status bar", app]);
        })]];
    }
    [items addObject:[[DMRow alloc] initWithTitle:@"VPN & Device Management…" enabled:YES handler:DMCloseThen(^{   // (always, like macOS's "Open VPN Settings…")
        DMOpenURL(@"prefs:root=General&path=ManagedConfigurationList", @"vpn settings");   // (path=VPN only reaches General on 15: checked on the M1)
    })]];
    DMPresentMenu(btn, kVPNMenuLabelKey, kVPNMenuPillKey, items);
}
// Disconnect from the VPN menu. A VPN with Connect On Demand (a VPN app's auto-connect) comes straight back when only its connection is stopped
// (0.4 s on the M1), and the public NEVPNManager cannot save another app's configuration ("configuration type is wrong"). Settings' own
// configuration store (NEConfigurationManager, private; SpringBoard can load it -- checked on the iPad 2) is used to turn On Demand off first, as
// the switch in the VPN's own app does; if that is refused, the VPN's app is opened to switch it off there (the only way that keeps it off).
static void DMVPNDisconnect(NEVPNManager *m) {
    NSString *name = gVPNConfigName ?: @"the VPN";
    if (!m.isOnDemandEnabled) { [m.connection stopVPNTunnel]; DMLog([NSString stringWithFormat:@"[vpn] disconnected from the status bar (%@)", name]); return; }
    void (^fallback)(NSString *) = ^(NSString *why) {
        DMLog([NSString stringWithFormat:@"[vpn] %@: auto-connect could not be turned off (%@) -- opening its app", name, why]);
        [m.connection stopVPNTunnel];
        if (gVPNAppBundleID.length) DMOpenApp(gVPNAppBundleID); else DMOpenURL(MSBD_VPN_SETTINGS_URL, @"vpn settings (disconnect)");
    };
    id cfg = nil;
    @try { cfg = [m valueForKey:@"configuration"]; } @catch (id e) { cfg = nil; }   // (the manager's own NEConfiguration)
    Class cm = objc_getClass("NEConfigurationManager");
    id store = [cm respondsToSelector:@selector(sharedManager)] ? ((id (*)(id, SEL))objc_msgSend)(cm, @selector(sharedManager)) : nil;
    SEL load = NSSelectorFromString(@"loadConfigurationsWithCompletionQueue:handler:"), save = NSSelectorFromString(@"saveConfiguration:withCompletionQueue:handler:");
    NSUUID *want = [DMCall(cfg, @"identifier") isKindOfClass:[NSUUID class]] ? DMCall(cfg, @"identifier") : nil;
    if (!want || ![store respondsToSelector:load] || ![store respondsToSelector:save]) { fallback(@"no configuration store"); return; }
    ((void (*)(id, SEL, id, id))objc_msgSend)(store, load, dispatch_get_main_queue(), ^(NSArray *configs, NSError *error) {
        id mine = nil;
        for (id c in configs) if ([DMCall(c, @"identifier") isEqual:want]) { mine = c; break; }
        id vpn = DMCall(mine, @"VPN") ?: DMCall(mine, @"appVPN");
        SEL setOD = NSSelectorFromString(@"setOnDemandEnabled:");
        if (![vpn respondsToSelector:setOD]) { fallback(error ? error.localizedDescription : @"not found"); return; }
        ((void (*)(id, SEL, BOOL))objc_msgSend)(vpn, setOD, NO);
        ((void (*)(id, SEL, id, id, id))objc_msgSend)(store, save, mine, dispatch_get_main_queue(), ^(NSError *e) {
            if (e) { fallback(e.localizedDescription); return; }
            [m.connection stopVPNTunnel];
            DMLog([NSString stringWithFormat:@"[vpn] disconnected from the status bar (%@): auto-connect turned off first", name]);
        });
    });
}
// Minimize the app you are working in: a window in front minimizes its window; anything else (a full-screen app, even when other windows
// exist behind it) goes home, exactly like the orange status bar button.
static void DMMinimizeActiveApp(void) {
    BOOL windowsInFront = DMWindowsInFront();
    DMLog([NSString stringWithFormat:@"[action] minimize active app: windows in front %d, front app %@, top stage %@", windowsInFront, [DMFrontApp() bundleIdentifier], DMTopStage() ? DMStageBundle(DMTopStage()) : @"none"]);
    if (!windowsInFront) { DMMinimize(); return; }
    if ((DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu) && DMTopStage()) { DMMinimizeStage(DMTopStage()); return; }
    UIView *top = DMTopWindow();
    if (top) DMMinimizeWindow(top); else DMMinimize();
}
static void DMOpenAppMenu(UIButton *btn) {
    UIView *fg = btn.superview;
    UIView *host = DMHostFor(fg);
    if (!host) return;
    if (DMTitleTapWithMenuOpen(btn)) return;
    SBApplication *app = DMNativeActiveApp() ? nil : DMActiveApp();
    if (!app) { DMOpenFinderMenu(btn); return; }   // no app open (or our Finder window in front): this title is "Finder"
    NSString *name = [app displayName] ?: [app bundleIdentifier];

    NSMutableArray *items = [NSMutableArray arrayWithObjects:
        [[DMRow alloc] initWithTitle:[NSString stringWithFormat:@"About %@", name] enabled:YES
                             handler:^{ DMShowAppAbout(host, app); }],
        nil];
    // "Check for Updates…": whether this can do anything depends on where the app came from. A stock app updates with iPadOS itself, a sideloaded or
    // TestFlight app has no update mechanism Apple exposes here, and neither does a tweak (Sileo's own list is what the Apple menu's "App Store…" row is
    // for). Only an app that was actually downloaded from the App Store (it has an item ID) can really be checked for an update, so only that one is enabled.
    {
        unsigned long long itemID = [DMCall(DMProxyForBundle([app bundleIdentifier]), @"itemID") unsignedLongLongValue];
        [items addObject:[[DMRow alloc] initWithTitle:@"Check for Updates…" enabled:(itemID != 0) handler:DMCloseThen(^{ DMAppStoreUpdates(); })]];
    }
    [items addObject:[NSNull null]];
    // "Settings…" like macOS, except in Settings itself, where it would only open the app you are in.
    if (![[app bundleIdentifier] isEqualToString:@"com.apple.Preferences"]) {
        [items addObject:[[DMRow alloc] initWithTitle:@"Settings…" enabled:YES handler:DMCloseThen(^{ DMOpenAppSettings(app); })]];
        // (An "App Permissions…" row used to follow here. iOS has no URL for one app's privacy permissions -- Privacy is organised by
        // category (Camera, Photos, ...), not by app -- so it could only open the same page as "Settings…"; the owner asked for it to go.)
        [items addObject:[NSNull null]];
    }
    [items addObject:[[DMRow alloc] initWithTitle:@"Minimize" enabled:YES handler:DMCloseThen(^{ DMMinimizeActiveApp(); })]];
    [items addObject:[NSNull null]];
    // "Print…" and "Share…", like macOS's own App menu: found in the app's own UI (a Share button is close to universal; a dedicated Print button is
    // rarer, so that one falls back to Share, where Print is usually one of the choices) and activated the same way VoiceOver would, so no hardware
    // keyboard is needed the way the Edit menu's shortcuts do. Whether the app actually has one is only known once the app itself looks (a cross-process
    // question, not something worth a round trip just to grey out a row), so both stay enabled; nothing happens if the app has neither.
    [items addObject:[[DMRow alloc] initWithTitle:@"Print…" enabled:YES handler:DMCloseThen(^{ DMPostAppBridgeAction([app bundleIdentifier], @"print"); })]];
    [items addObject:[[DMRow alloc] initWithTitle:@"Share…" enabled:YES handler:DMCloseThen(^{ DMPostAppBridgeAction([app bundleIdentifier], @"share"); })]];
    [items addObject:[NSNull null]];
    [items addObject:[[DMRow alloc] initWithTitle:[NSString stringWithFormat:@"Force Quit %@", name] enabled:YES
                                          handler:DMCloseThen(^{ DMForceQuit(app); })]];

    DMPresentMenu(btn, kAppLabelKey, kAppPillKey, items);
    DMLog([NSString stringWithFormat:@"[appmenu] opened for %@", [app bundleIdentifier]]);
}


// ---- menu-bar hover switching, like macOS ----
// While one of the left-hand menus is open, moving the pointer onto another left-hand title opens that
// title's menu straight away, without a click. (The right-hand side of the bar is left as it was.)
@interface DMHoverHandler : NSObject
@property (nonatomic, copy) void (^block)(UIHoverGestureRecognizer *);
- (void)hover:(UIHoverGestureRecognizer *)g;
@end
@implementation DMHoverHandler
- (void)hover:(UIHoverGestureRecognizer *)g { if (self.block) self.block(g); }
@end

static void DMOpenMenuForButton(UIButton *b) {
    UIView *fg = b.superview;
    if (b == objc_getAssociatedObject(fg, kButtonKey)) DMOpenMenu(b);
    else if (b == objc_getAssociatedObject(fg, kAppButtonKey)) DMOpenAppMenu(b);
    else if (b == objc_getAssociatedObject(fg, kEditButtonKey)) DMOpenEditMenu(b);
    else if (b == objc_getAssociatedObject(fg, kGoButtonKey)) DMOpenGoMenu(b);
    else if (b == objc_getAssociatedObject(fg, kWinButtonKey)) DMOpenWindowMenu(b);
    else if (b == objc_getAssociatedObject(fg, kAudioButtonKey)) DMOpenAudioMenu(b);
    else if (b == objc_getAssociatedObject(fg, kFileButtonKey)) DMOpenFinderFileMenu(b);
    else if (b == objc_getAssociatedObject(fg, kViewButtonKey)) DMOpenFinderViewMenu(b);
}

// A finger (or a click) on another title while a menu is open opens that title's menu at once, like macOS; before, the catch-all took the tap and
// only closed the open menu, so switching took two taps (menu stress test, iPad 2). Only touches that land on another title are taken; every
// other touch reaches the catch-all as before (a tap outside closes, the same title closes).
@interface DMTitleTapSwitch : NSObject <UIGestureRecognizerDelegate>
@property (nonatomic, weak) UIView *fg, *host;
@property (nonatomic, weak) UIButton *current;
- (UIButton *)titleAt:(CGPoint)p;
- (void)tapped:(UITapGestureRecognizer *)g;
@end
@implementation DMTitleTapSwitch
- (UIButton *)titleAt:(CGPoint)p {
    UIView *fg = self.fg, *host = self.host;
    if (!fg || !host) return nil;
    const void *keys[] = { kButtonKey, kAppButtonKey, kFileButtonKey, kEditButtonKey, kViewButtonKey, kGoButtonKey, kWinButtonKey, kAudioButtonKey, kSSHButtonKey, kVPNButtonKey, kWiFiButtonKey };
    for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
        UIButton *b = objc_getAssociatedObject(fg, keys[i]);
        if (!b || b.hidden || b == self.current || b.frame.size.width < 1.0) continue;
        if (CGRectContainsPoint(DMConvertToHost(fg, b.frame, host), p)) return b;
    }
    return nil;
}
// Acted on at touch-down, like a mouse-down on a macOS menu title: at the top edge a touch's end is not reliably delivered to our window (iPad 2,
// portrait: the touch began on the catch-all, its end arrived with no view, so neither the catch-all nor a tap recognizer ever fired). The touch
// itself is then left alone.
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)touch {
    CGPoint p = [touch locationInView:self.host];
    UIButton *b = [self titleAt:p];
    UIButton *cur = self.current;
    UIView *fg = self.fg, *host = self.host;
    BOOL onCurrent = !b && cur && fg && host && CGRectContainsPoint(DMConvertToHost(fg, cur.frame, host), p);
    if (b) dispatch_async(dispatch_get_main_queue(), ^{
        UIView *bfg = b.superview;
        if (!bfg) return;
        DMLog(@"[menu] touch on another title: switching menus");
        DMRemoveOverlayNow();
        if (b == objc_getAssociatedObject(bfg, kSSHButtonKey)) DMOpenSSHMenu(b);
        else if (b == objc_getAssociatedObject(bfg, kVPNButtonKey)) DMOpenVPNMenu(b);
        else if (b == objc_getAssociatedObject(bfg, kWiFiButtonKey)) DMOpenWiFiMenu(b);
        else DMOpenMenuForButton(b);
    });
    else if (onCurrent) dispatch_async(dispatch_get_main_queue(), ^{ DMLog(@"[menu] touch on its own title: closed"); DMCloseOverlay(); });
    return NO;
}
- (void)tapped:(UITapGestureRecognizer *)g {
    if (g.state != UIGestureRecognizerStateEnded) return;
    UIButton *b = [self titleAt:[g locationInView:self.host]];
    if (!b) return;
    UIView *fg = b.superview;
    DMLog(@"[menu] tap on another title: switching menus");
    DMRemoveOverlayNow();
    if (b == objc_getAssociatedObject(fg, kSSHButtonKey)) DMOpenSSHMenu(b);
    else if (b == objc_getAssociatedObject(fg, kVPNButtonKey)) DMOpenVPNMenu(b);
    else if (b == objc_getAssociatedObject(fg, kWiFiButtonKey)) DMOpenWiFiMenu(b);
    else DMOpenMenuForButton(b);
}
@end
static const void *kTitleTapKey = &kTitleTapKey;
static void DMAttachMenuHover(UIControl *overlay, UIView *fg, UIView *host, UIButton *currentButton) {
    gOverlayTitle = currentButton;
    {
        DMTitleTapSwitch *sw = [DMTitleTapSwitch new];
        sw.fg = fg; sw.host = host; sw.current = currentButton;
        UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:sw action:@selector(tapped:)];
        tap.delegate = sw;
        [overlay addGestureRecognizer:tap];
        objc_setAssociatedObject(overlay, kTitleTapKey, sw, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    DMHoverHandler *handler = [DMHoverHandler new];
    __weak UIView *weakFg = fg, *weakHost = host;
    __weak UIButton *weakCurrent = currentButton;
    handler.block = ^(UIHoverGestureRecognizer *g) {
        if (g.state != UIGestureRecognizerStateBegan && g.state != UIGestureRecognizerStateChanged) return;
        UIView *fg = weakFg, *host = weakHost;
        if (!fg || !host) return;
        CGPoint p = [g locationInView:host];
        const void *keys[] = { kButtonKey, kAppButtonKey, kFileButtonKey, kEditButtonKey, kViewButtonKey, kGoButtonKey, kWinButtonKey, kAudioButtonKey };
        for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
            UIButton *b = objc_getAssociatedObject(fg, keys[i]);
            if (!b || b.hidden || b == weakCurrent) continue;
            if (!CGRectContainsPoint(DMConvertToHost(fg, b.frame, host), p)) continue;
            DMLog(@"[hover] pointer moved onto another title: switching menus");
            DMRemoveOverlayNow();   // instant, no fade, like macOS
            DMOpenMenuForButton(b);
            return;
        }
    };
    [overlay addGestureRecognizer:[[UIHoverGestureRecognizer alloc] initWithTarget:handler action:@selector(hover:)]];
    objc_setAssociatedObject(overlay, kHoverHandlerKey, handler, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}

// ===== the traffic lights: three dots after the Apple logo while an app is full screen =====
@interface DMLightCell : UIButton
@property (nonatomic, strong) UIView *dot;
@property (nonatomic, strong) UIImageView *glyph;
@end
@implementation DMLightCell
- (void)setHighlighted:(BOOL)highlighted {
    [super setHighlighted:highlighted];
    self.dot.alpha = highlighted ? 0.7 : 1.0;
}
@end

@interface DMLights : UIView
@property (nonatomic, strong) NSArray<DMLightCell *> *cells;
@property (nonatomic, assign) CGFloat dotCenterY;
@property (nonatomic, assign) BOOL greenHidden;   // windowing is off: there is nothing for the green button to do
@property (nonatomic, assign) BOOL greenDisabled;   // the app can only run full screen (DMAppNeedsFullScreen): green shown greyed, like macOS
@end

static char kLightsInwardKey;
@implementation DMLights
- (instancetype)init {
    self = [super initWithFrame:CGRectZero];
    if (!self) return nil;
    NSMutableArray *cells = [NSMutableArray array];
    for (int i = 0; i < 3; i++) {
        DMLightCell *c = [DMLightCell buttonWithType:UIButtonTypeCustom];
        c.tag = i;
        UIImageView *glyph = nil;
        c.dot = DMMakeLightDot(i, YES, &glyph);
        c.glyph = glyph;
        [c addSubview:c.dot];
        [c addTarget:self action:@selector(tapped:) forControlEvents:UIControlEventTouchUpInside];
        [self addSubview:c];
        [cells addObject:c];
    }
    self.cells = cells;
    DMLightGroupAttach(self, cells, [cells valueForKey:@"dot"], nil);   // (the active app's own: always colored; symbols on hover or press)
    return self;
}

- (void)layoutSubviews {
    [super layoutSubviews];
    // (green's arrows say what it does: inward for a full-screen app -- every engine but Stage Manager shows these lights only then --, outward for
    //  a Stage Manager window, which green takes into full screen)
    BOOL inward = !DMSMEngine() || DMSMFrontIsFullScreen();
    DMLightCell *green = self.cells.count > 2 ? self.cells[2] : nil;
    if (green && green.tag == 2 && [objc_getAssociatedObject(self, &kLightsInwardKey) boolValue] != inward) {
        objc_setAssociatedObject(self, &kLightsInwardKey, @(inward), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        green.glyph.image = [UIImage systemImageNamed:DMLightSymbolName(2, inward) withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:7.0 weight:UIImageSymbolWeightHeavy]];
    }
    BOOL rtl = DMBarRTL(self);   // (a right-to-left language: mirrored, red nearest the logo at the right, like a Mac's window buttons then)
    NSInteger shown = self.greenHidden ? 2 : 3;
    for (DMLightCell *c in self.cells) {
        c.frame = CGRectMake((rtl ? MAX(0, shown - 1 - c.tag) : c.tag) * kLightCell, 0, kLightCell, self.bounds.size.height);
        c.dot.center = CGPointMake(kLightCell / 2.0, self.dotCenterY);
        c.hidden = (c.tag == 2 && self.greenHidden);
        if (c.tag == 2) {   // greyed out and inert for a full-screen-only app (macOS shows a disabled green button the same way)
            BOOL off = self.greenDisabled;
            c.enabled = !off;
            c.dot.backgroundColor = off ? [UIColor colorWithWhite:0.62 alpha:0.55] : DMLightColor(2);
            objc_setAssociatedObject(c.dot, kLightDisabledKey, off ? @YES : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (off) c.glyph.hidden = YES;
        }
    }
    [objc_getAssociatedObject(self, kLightGroupKey) apply];
}

- (void)tapped:(DMLightCell *)cell { DMLightAction(cell.tag); }
@end

@interface _UIStatusBarForegroundView : UIView
- (void)dm_layoutLogo;
@end

// ---- Status bar diagnostics (untested iPadOS only, common/Diag.h; 1 Oct, issue #5: on iPadOS 17.0 only Apple's own status bar showed, so a step
// of dressing it quietly gave up there). Counts which step of -dm_layoutLogo each layout pass reached, and a sketch of the status bar window's views:
// class names, frames and hidden/alpha flags only -- no text, nothing personal. Written about 35 s and 105 s after SpringBoard starts (20 s and
// 90 s after the hook check, DMDiagHooks, which itself runs 15 s in), and on request.
static NSMutableDictionary<NSString *, NSNumber *> *gSBDiagSteps;
static void DMSBDiagStep(NSString *step) {
    if (!MSBDDiagEnabled()) return;
    if (!gSBDiagSteps) gSBDiagSteps = [NSMutableDictionary dictionary];
    gSBDiagSteps[step] = @(gSBDiagSteps[step].integerValue + 1);
}
static void DMSBDiagTree(UIView *v, int depth, NSMutableString *out, int *lines) {
    if (!v || depth > 7 || *lines >= 40) return;
    CGRect f = v.frame;   // (compact: the depth as a number, no braces -- spaces and braces triple in the report's link, logic test 1.2.2)
    [out appendFormat:@"%d %@ %.0f,%.0f,%.0f,%.0f%@%@ %lu\n", depth, NSStringFromClass([v class]), f.origin.x, f.origin.y, f.size.width, f.size.height,
        v.hidden ? @" hidden" : @"", v.alpha < 0.01 ? @" a0" : @"", (unsigned long)v.subviews.count];
    (*lines)++;
    for (UIView *sub in v.subviews) DMSBDiagTree(sub, depth + 1, out, lines);
}
// (the first view of class `c` under `v`, depth-first)
static UIView *DMSBDiagFind(UIView *v, Class c) {
    if (!v || !c) return nil;
    if ([v isKindOfClass:c]) return v;
    for (UIView *s in v.subviews) { UIView *r = DMSBDiagFind(s, c); if (r) return r; }
    return nil;
}
// Compact on purpose (the report's link: every space costs 3 characters): the most telling lines first, the sketch last (it is what gets cut).
static void DMSBDiagFlush(void) {
    if (!MSBDDiagEnabled()) return;
    NSMutableString *t = [NSMutableString string];
    CFPropertyListRef st = CFPreferencesCopyAppValue(CFSTR("stockStatusBar"), CFSTR("com.besiktasliseba.macstatusbar"));
    BOOL stock = st && CFGetTypeID(st) == CFBooleanGetTypeID() && CFBooleanGetValue((CFBooleanRef)st);
    if (st) CFRelease(st);
    // which family is in use, and which classes of both families exist (1/0 per class: fg,str,modern,bar,window,vpn,act,pill)
    NSMutableString *uk = [NSMutableString string], *nu = [NSMutableString string];
    for (size_t i = 0; i < sizeof(kDMSBNames) / sizeof(kDMSBNames[0]); i++) {
        [uk appendString:objc_getClass(kDMSBNames[i][0]) ? @"1" : @"0"];
        [nu appendString:objc_getClass(kDMSBNames[i][1]) ? @"1" : @"0"];
    }
    [t appendFormat:@"style %@;bar %@;UIKit %@;STUI %@ (fg,str,mod,bar,win,vpn,act,pill)\n", stock ? @"Stock" : @"Mac", DMSBUseSTUI() ? @"STUI" : @"UIKit", uk, nu];
    // hooks: the classes the core hooks went on, and the item groups
    if (!stock) [t appendFormat:@"hooks on %@,%@,%@,%@,%@;items %u\n", DMSBName("_UIStatusBarForegroundView"), DMSBName("_UIStatusBarStringView"),
        DMSBName("UIStatusBar_Modern"), DMSBName("_UIStatusBar"), DMSBName("UIStatusBarWindow"), gSBItemHooks];
    // SystemStatusUI's classes (17+): how many, and the ones that look like a window, wrapper or the bar's main views
    Class stui = objc_getClass("STUIStatusBar");
    Dl_info di;
    if (stui && dladdr((__bridge void *)stui, &di) && di.dli_fname) {
        unsigned n = 0;
        const char **names = objc_copyClassNamesForImage(di.dli_fname, &n);
        NSMutableArray *keep = [NSMutableArray array];
        for (unsigned i = 0; i < n; i++) {
            NSString *c = @(names[i]);
            if ([c containsString:@"Window"] || [c containsString:@"Wrapper"] || [c hasSuffix:@"ForegroundView"] || [c hasSuffix:@"_Modern"] || [c isEqualToString:@"STUIStatusBar"]) [keep addObject:c];
        }
        free(names);
        [keep sortUsingSelector:@selector(compare:)];
        [t appendFormat:@"STUI classes %u:%@\n", n, [keep componentsJoinedByString:@","]];
    }
    NSMutableArray *steps = [NSMutableArray array];
    for (NSString *k in [gSBDiagSteps.allKeys sortedArrayUsingSelector:@selector(compare:)]) [steps addObject:[NSString stringWithFormat:@"%@ %@", k, gSBDiagSteps[k]]];
    [t appendFormat:@"layout steps: %@\n", steps.count ? [steps componentsJoinedByString:@","] : @"none (the foreground view never laid out)"];
    // where the foreground views are (either family), and every window (class without "Window", level, h = hidden)
    Class fgUIKit = objc_getClass("_UIStatusBarForegroundView"), fgNew = objc_getClass("STUIStatusBarForegroundView");
    NSMutableArray *wins = [NSMutableArray array], *fgs = [NSMutableArray array];
    UIWindow *host = nil;
    for (UIWindow *w in DMAllWindows()) {
        NSString *c = [NSStringFromClass([w class]) stringByReplacingOccurrencesOfString:@"Window" withString:@""];
        [wins addObject:[NSString stringWithFormat:@"%@:%.0f%@", c.length ? c : @"UI", w.windowLevel, w.hidden ? @"h" : @""]];
        UIView *a = DMSBDiagFind(w, fgNew), *b = DMSBDiagFind(w, fgUIKit);
        if (a) [fgs addObject:[@"STUI:" stringByAppendingString:c.length ? c : @"UI"]];
        if (b) [fgs addObject:[@"UIKit:" stringByAppendingString:c.length ? c : @"UI"]];
        if (!host && (a || b) && !w.hidden && DMSBIsBarWindowName(NSStringFromClass([w class]))) host = w;
    }
    if (!host) for (UIWindow *w in DMAllWindows()) if (!w.hidden && (DMSBDiagFind(w, fgNew) || DMSBDiagFind(w, fgUIKit))) { host = w; break; }
    [t appendFormat:@"fg in %@\nwindows %@\n", fgs.count ? [fgs componentsJoinedByString:@","] : @"none", [wins componentsJoinedByString:@","]];
    if (host) {
        [t appendFormat:@"sketch %@ %.0f%@\n", NSStringFromClass([host class]), host.windowLevel, host.alpha < 0.01 ? @" a0" : @""];
        int lines = 0;
        for (UIView *sub in host.subviews) DMSBDiagTree(sub, 1, t, &lines);
    }
    MSBDDiagWrite(@"StatusBar", t);
}

// The leading region container: a plain UIView in the leading half of the foreground view (the left half; the right one in a right-to-left
// language, DMBarRTL) that holds _UIStatusBarStringViews (the time and date).
static UIView *DMLeadingContainer(UIView *fg) {
    Class stringView = DMSBClass("_UIStatusBarStringView");
    BOOL rtl = DMBarRTL(fg);
    CGFloat W = fg.bounds.size.width, bestLead = CGFLOAT_MAX;
    UIView *best = nil;
    for (UIView *v in fg.subviews) {
        if (![NSStringFromClass([v class]) isEqualToString:@"UIView"]) continue;
        CGFloat lead = rtl ? W - v.center.x : v.center.x;   // (its centre from the leading end; centre ignores transforms)
        if (lead >= W / 2.0) continue;
        BOOL hasString = NO;
        for (UIView *s in v.subviews) if ([s isKindOfClass:stringView]) { hasString = YES; break; }
        if (!hasString) continue;
        if (!best || lead < bestLead) { best = v; bestLead = lead; }
    }
    return best;
}

// (the string view nearest the leading end: the time; in a right-to-left language the rightmost)
static UIView *DMFirstStringView(UIView *container) {
    Class stringView = DMSBClass("_UIStatusBarStringView");
    BOOL rtl = DMBarRTL(container);
    UIView *first = nil;
    for (UIView *s in container.subviews) {
        if (![s isKindOfClass:stringView]) continue;
        if (!first || (rtl ? s.center.x > first.center.x : s.center.x < first.center.x)) first = s;
    }
    return first;
}

// The status bar keeps a second, short-format time label beside the date, and on some copies (an app's
// bar as it opens) it sits where the date is expected. Choosing the date by position then put the time
// in the date slot and dropped the real date, so choose by content: not the clock label, and not a time.
static BOOL DMLooksLikeTime(NSString *t) {
    if (t.length == 0) return NO;
    if ([t containsString:@":"]) return YES;
    // (time separators other than ":" -- Finnish "12.30", French Canadian "12 h 30": compared with the short time of this minute and the one before,
    //  worked out again at every minute and region change; 1.3.3, audit L-7: a string kept for 30 s across a minute change missed the new time)
    static NSString *shortTime = nil, *previous = nil; static long minute = -1; static unsigned gen = 0;
    long nowMinute = (long)floor([[NSDate date] timeIntervalSince1970] / 60.0);
    if (!shortTime || nowMinute != minute || gen != gDMLocaleGen) {
        if (gen == gDMLocaleGen && nowMinute == minute + 1) previous = shortTime; else previous = nil;
        shortTime = [NSDateFormatter localizedStringFromDate:[NSDate date] dateStyle:NSDateFormatterNoStyle timeStyle:NSDateFormatterShortStyle];
        minute = nowMinute; gen = gDMLocaleGen;
    }
    return [t isEqualToString:shortTime] || (previous && [t isEqualToString:previous]);
}

static UIView *DMDateStringView(UIView *container) {
    Class stringView = DMSBClass("_UIStatusBarStringView");
    UIView *time = DMFirstStringView(container);
    CGFloat dir = DMBarRTL(container) ? -1.0 : 1.0;   // (the one furthest toward the trailing end: the rightmost; the leftmost right-to-left)
    UIView *best = nil, *blank = nil;
    for (UIView *s in container.subviews) {
        if (![s isKindOfClass:stringView] || s == time) continue;
        NSString *text = ((UILabel *)s).text;
        if (text.length == 0) { if (!blank || dir * s.center.x > dir * blank.center.x) blank = s; continue; }
        if (DMLooksLikeTime(text)) continue;
        if (!best || dir * s.center.x > dir * best.center.x) best = s;
    }
    return best ?: blank;
}


// Creates (once) and lays out one menu title in the status bar: a label, a transparent tap button over it,
// and a highlight pill for while its menu is open. Returns the title's right edge, or -1 if there is no room.
// (x and maxRight in leading coordinates, DMBarRTL: in a right-to-left language the titles go left from the logo)
static CGFloat DMLayoutTitle(UIView *fg, BOOL rtl, const void *labelKey, const void *buttonKey, const void *pillKey,
                             NSString *text, UIFontWeight weight, UIFont *baseFont, UIColor *color,
                             CGFloat centreY, CGFloat x, CGFloat maxRight, void (^onTap)(UIButton *)) {
    UILabel *label = objc_getAssociatedObject(fg, labelKey);
    UIButton *btn = objc_getAssociatedObject(fg, buttonKey);
    UIView *pill = objc_getAssociatedObject(fg, pillKey);
    if (!label) {
        pill = [UIView new];
        pill.layer.cornerRadius = 5.0;
        pill.hidden = YES;
        pill.userInteractionEnabled = NO;
        [fg addSubview:pill];
        objc_setAssociatedObject(fg, pillKey, pill, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

        label = [UILabel new];
        label.userInteractionEnabled = NO;
        label.lineBreakMode = NSLineBreakByTruncatingTail;
        [fg addSubview:label];
        objc_setAssociatedObject(fg, labelKey, label, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

        btn = [UIButton buttonWithType:UIButtonTypeCustom];
        btn.pointerInteractionEnabled = YES;
        __weak UIButton *weakBtn = btn;
        [btn addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { if (weakBtn) onTap(weakBtn); }]
      forControlEvents:UIControlEventTouchUpInside];
        [fg addSubview:btn];
        objc_setAssociatedObject(fg, buttonKey, btn, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    CGFloat maxW = maxRight - x;
    BOOL show = text.length && maxW >= 30.0;
    label.hidden = btn.hidden = !show;
    if (!show) { pill.hidden = YES; return -1.0; }
    // (S-5, 1.3.3: the bar is laid out again many times while an app opens or closes -- the title's font, text and measured size are only made
    //  again when they change; before, each pass made a font and measured every title)
    static NSMutableDictionary<NSString *, UIFont *> *fonts; if (!fonts) fonts = [NSMutableDictionary dictionary];
    NSString *fontKey = [NSString stringWithFormat:@"%.2f/%.2f", baseFont.pointSize, weight];
    UIFont *font = fonts[fontKey];
    if (!font) { font = [UIFont systemFontOfSize:baseFont.pointSize weight:weight]; if (font) fonts[fontKey] = font; }
    static const void *kTitleSizeKey = &kTitleSizeKey;   // (the label's natural size for its current text and font)
    NSValue *natural = objc_getAssociatedObject(label, kTitleSizeKey);
    if (!natural || label.font != font || ![label.text isEqualToString:text]) {
        if (![label.text isEqualToString:text]) label.text = text;
        if (label.font != font) label.font = font;
        [label sizeToFit];
        natural = [NSValue valueWithCGSize:label.bounds.size];
        objc_setAssociatedObject(label, kTitleSizeKey, natural, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (color && ![label.textColor isEqual:color]) label.textColor = color;
    CGFloat w = MIN(natural.CGSizeValue.width, maxW), h = natural.CGSizeValue.height;
    label.frame = DMBarRect(fg, rtl, CGRectMake(x, centreY + kTitleDrop - h / 2.0, w, h));
    btn.frame = DMBarRect(fg, rtl, CGRectMake(x - 8.0, 0, w + 16.0, fg.bounds.size.height));
    pill.frame = CGRectInset(btn.frame, 3.0, 3.0);
    [fg bringSubviewToFront:label];
    [fg bringSubviewToFront:btn];
    return x + w;
}

// The Apple logo is glyph U+F8FF. Measure its real ink (not the text box) once, at 100pt, so it can be
// sized to fill the status bar as tall as possible and centred on what you actually see.
static BOOL DMLogoInkAt100(CGRect *ink) {
    static BOOL ok = NO, done = NO;
    static CGRect rect;
    if (!done) {
        done = YES;
        UIFont *font = [UIFont systemFontOfSize:100.0 weight:UIFontWeightSemibold];
        unichar ch = 0xF8FF;
        NSString *str = [NSString stringWithCharacters:&ch length:1];
        CTFontRef drawn = CTFontCreateForString((__bridge CTFontRef)font, (__bridge CFStringRef)str, CFRangeMake(0, 1));
        CGGlyph glyph = 0;
        if (drawn && CTFontGetGlyphsForCharacters(drawn, &ch, &glyph, 1)) {
            CTFontGetBoundingRectsForGlyphs(drawn, kCTFontOrientationHorizontal, &glyph, &rect, 1);
            ok = rect.size.height > 1.0;
        }
        if (drawn) CFRelease(drawn);
        DMLog([NSString stringWithFormat:@"[logo] ink at 100pt: %@ (ok=%d)", NSStringFromCGRect(rect), ok]);
    }
    if (ok && ink) *ink = rect;
    return ok;
}


// ColorBar15 (which the owner uses) already colours the bar, so "Automatic" stays out of its way -- only while it really runs here: its library
// loaded into SpringBoard (not switched off in Choicy / iCleaner Pro) and its own switch on. The library check is done once SpringBoard has
// started (every tweak is loaded by then); the switch is read at most every 2 s (this is asked on every status bar layout).
static BOOL DMColorBarActive(void) {
    static int loaded = -1; static CFTimeInterval readAt = -10; static BOOL on = NO;
    if (loaded < 0 || (loaded == 0 && DMProcessAge() < 15.0)) {
        loaded = 0;
        for (uint32_t i = 0; i < _dyld_image_count(); i++) { const char *p = _dyld_get_image_name(i); if (p && strstr(p, "/ColorBar15.dylib")) { loaded = 1; break; } }
    }
    if (!loaded) return NO;
    if (CACurrentMediaTime() - readAt > 2.0) {
        readAt = CACurrentMediaTime();
        CFPreferencesAppSynchronize(CFSTR("com.dcproducts.colorbar15prefs"));
        CFPropertyListRef enabled = CFPreferencesCopyValue(CFSTR("isEnabled"), CFSTR("com.dcproducts.colorbar15prefs"), kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        on = enabled && CFGetTypeID(enabled) == CFBooleanGetTypeID() && CFBooleanGetValue(enabled);
        if (enabled) CFRelease(enabled);
    }
    return on;
}

static BOOL DMBackgroundWanted(void) {
    if (gBgMode == DMBackgroundOn) return YES;
    if (gBgMode == DMBackgroundOff) return NO;
    return !DMColorBarActive();
}

// A solid background behind the status bar's contents. It follows the text: iPadOS decides whether the
// bar's text is light or dark, so the chosen colour is used when the text is light and a light colour when
// the text is dark, which keeps it readable whatever the system picks. A switch between the two cross-fades
// (0.3 s, like the text); otherwise the colour is only written when it changes.
static const void *kBackgroundLightKey = &kBackgroundLightKey;
static void DMApplyBackground(UIView *fg, UIColor *textColor) {
    UIView *bar = fg.superview;   // _UIStatusBar
    UIView *bg = objc_getAssociatedObject(fg, kBackgroundKey);
    if (!bar || !DMBackgroundWanted()) { bg.hidden = YES; return; }
    if (!bg) {
        bg = [UIView new];
        bg.userInteractionEnabled = NO;
        bg.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [bar insertSubview:bg belowSubview:fg];
        objc_setAssociatedObject(fg, kBackgroundKey, bg, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    CGFloat r = 1, g = 1, b = 1;
    BOOL lightText = ![textColor getRed:&r green:&g blue:&b alpha:NULL] || (0.299 * r + 0.587 * g + 0.114 * b) > 0.5;
    if (!CGRectEqualToRect(bg.frame, bar.bounds)) bg.frame = bar.bounds;
    UIColor *want = lightText ? [(gBgColor ?: [UIColor blackColor]) colorWithAlphaComponent:gBgOpacity]
                              : [UIColor colorWithWhite:0.96 alpha:gBgOpacity];
    if (![bg.backgroundColor isEqual:want]) {
        NSNumber *was = objc_getAssociatedObject(bg, kBackgroundLightKey);
        BOOL flip = was && was.boolValue != lightText && !bg.hidden && bg.window;
        if (flip) [UIView animateWithDuration:0.3 delay:0 options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction
                                   animations:^{ bg.backgroundColor = want; } completion:nil];
        else bg.backgroundColor = want;
    }
    objc_setAssociatedObject(bg, kBackgroundLightKey, @(lightText), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    bg.hidden = NO;
    // Right under the bar's contents, NOT at index 0: PeepReborn's _UIStatusBar layout hook takes out whatever view is at the bottom (its own
    // slot), so a background there was removed on every layout and never showed (M1, iPadOS 15). If anything still takes it out, it goes back.
    NSArray *subs = bar.subviews;
    NSUInteger fi = [subs indexOfObjectIdenticalTo:fg];
    if (bg.superview != bar || (fi != NSNotFound && (fi == 0 || subs[fi - 1] != bg))) [bar insertSubview:bg belowSubview:fg];
}

// The trailing region container: a plain UIView in the trailing half (the right half; the left one in a right-to-left language) holding the status icons.
static UIView *DMTrailingContainer(UIView *fg) {
    BOOL rtl = DMBarRTL(fg);
    CGFloat W = fg.bounds.size.width;
    UIView *best = nil;
    for (UIView *v in fg.subviews) {
        if (![NSStringFromClass([v class]) isEqualToString:@"UIView"]) continue;
        if ((rtl ? W - v.center.x : v.center.x) <= W / 2.0) continue;
        if (v.subviews.count == 0) continue;
        if (!best || v.subviews.count > best.subviews.count) best = v;
    }
    return best;
}


// ===== preferences (Settings > Mac Status Bar) ===============================
static BOOL gShowSeconds = NO;   // (off for new installs, like macOS; an update keeps it on: sshtoggled --freeze-defaults)
static BOOL gShowWindowButtons = YES;   // Settings > Mac Status Bar > Window Buttons
static BOOL gHideMultitaskingDots = YES;   // Settings > Mac Status Bar > Multitasking: the three dots at the top centre of full-screen apps
static __weak UIView *gDotsAffordance = nil;   // SpringBoard's _SBTopAffordanceView (the last one laid out)
static BOOL gDotsOwnChange = NO;   // (set while we change the dots view ourselves: not SpringBoard's wish)
static const void *kDotsWantHiddenKey = &kDotsWantHiddenKey, *kDotsWantAlphaKey = &kDotsWantAlphaKey;   // (SpringBoard's own wishes for the dots view)
static BOOL gShowSpotlight = YES;       // Settings > Mac Status Bar > Search
static BOOL gBlockPointerPull = NO;   // Settings > Pointer > Block Pointer Pull-Down (on by default: DMReadBlockPointerPull)
// ---- Today View from the status bar clock (2026-09-24) ----
// Tapping the time or date in our status bar (finger or pointer) brings the Today View (the widgets) down from the top of the screen, like
// macOS's Notification Center from its clock: the Cover Sheet is presented already turned to its Today page (-[CSCoverSheetViewController
// activateTodayViewWithCompletion:] first, then -[SBCoverSheetPresentationManager setCoverSheetPresented:animated:withCompletion:], so it slides
// down showing the widgets, over apps and windows alike). Tapping the clock again puts it away (so does the usual swipe up / Home gesture); when it
// goes away its page is turned back, so the ordinary pull-down from the top still shows notifications. The Home Screen's own Today View (a right
// swipe on the first page) is switched off at the same time (-[SBRootFolderController setLeadingCustomViewPageHidden:YES], the same thing the
// "Today View on Home Screen" option of iPadOS 15 changes; the same class exists on iPadOS 16). A swipe down from the right edge still opens
// Control Center only (nothing of that is touched). Settings > Mac Status Bar > Clock > Clock Opens Today View (on by default).
static BOOL gClockOpensToday = YES;
static BOOL gTodayOpenedByClock = NO;
static void DMApplyHomeScreenTodayPage(void) {
    id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
    id rfc = DMCall(DMCall(ic, @"iconManager"), @"rootFolderController");
    SEL setHidden = NSSelectorFromString(@"setLeadingCustomViewPageHidden:"), isHidden = NSSelectorFromString(@"isLeadingCustomViewPageHidden");
    if (![rfc respondsToSelector:setHidden] || ![rfc respondsToSelector:isHidden]) {
        static BOOL told = NO;
        if (!told) { told = YES; DMLog([NSString stringWithFormat:@"[today] no root folder controller to hide the Home Screen Today View on (icon manager %@, controller %@)", DMCall(ic, @"iconManager"), rfc]); }
        return;
    }
    BOOL now = ((BOOL (*)(id, SEL))objc_msgSend)(rfc, isHidden);
    { static BOOL told = NO; if (!told) { told = YES; SEL tv = NSSelectorFromString(@"isTodayViewPageHidden");
        DMLog([NSString stringWithFormat:@"[today] root folder controller %@: leading page hidden %d, today page hidden %d", NSStringFromClass([rfc class]), now, [rfc respondsToSelector:tv] ? ((BOOL (*)(id, SEL))objc_msgSend)(rfc, tv) : -1]); } }
    // Only a page WE hid is ever given back: on iPadOS 16 (and 15 without "Keep on Home Screen") the system itself keeps that page hidden (the
    // Today View is an overlay there, see the allowsHomeScreenOverlay hook), and asking for it back with the switch off never stuck -- we
    // re-asked every 2.6 s (iPad 2 cross-test).
    static BOOL weHid = NO;
    if (gClockOpensToday && !now) {
        ((void (*)(id, SEL, BOOL))objc_msgSend)(rfc, setHidden, YES); weHid = YES;
        DMLog(@"[today] Home Screen Today View page hidden (the clock opens the Today View)");
    } else if (!gClockOpensToday && now && weHid) {
        ((void (*)(id, SEL, BOOL))objc_msgSend)(rfc, setHidden, NO); weHid = NO;
        DMLog(@"[today] Home Screen Today View page back");
    }
}
// ---- Notifications in the Today panel (2026-09-27) ----
// A "Notifications" box at the top of our Today panel (Settings > Status Bar > Clock > Notifications in Today View, on by default): the
// notifications iOS holds as delivered, the same ones the Cover Sheet's list holds (CSCoverSheetViewController > CSMainPageContentViewController >
// CSCombinedListViewController > NCNotificationStructuredListViewController > NCNotificationMasterList: its section lists' allNotificationRequests),
// in one flat list, newest first. They are read again when the panel opens and on every tick while it is open; nothing of ours is kept. The box is
// an arranged view at the top of the borrowed Today View's widget column (a UIStackView), so it scrolls with the widgets as one page and the
// widgets slide when it grows, shrinks, comes or goes; it leaves the column before the Today View is given back (DMTodayGiveBack). A row's tap runs
// the notification's default action, a swipe left (or Clear in the header, for all) asks iOS to clear it -- both through NCNotificationDispatcher,
// with the Cover Sheet's own destination (CSNotificationDispatcher), the way the Cover Sheet's list asks.
static BOOL gTodayNotifications = YES;
static const NSUInteger kTNCollapsedRows = 5;
static const CGFloat kTNHeaderH = 40.0, kTNMoreH = 40.0, kTNPad = 12.0, kTNIcon = 30.0;
@interface DMTNRow : UIView <UIGestureRecognizerDelegate>
@property (nonatomic, strong) id request;
@property (nonatomic, copy) NSString *key;
@property (nonatomic, strong) NSDate *date;
@property (nonatomic, strong) UIView *slide;        // the row's content: slides left over the Clear behind it
@property (nonatomic, strong) UIView *clearBack;
@property (nonatomic, strong) UILabel *timeLabel;
@property (nonatomic, strong) UIView *separator;
@property (nonatomic) BOOL leaving;
@end
@interface DMTNTarget : NSObject <UIGestureRecognizerDelegate>
+ (instancetype)shared;
@end
static UIView *gTNBox = nil;                 // (held while the panel is open)
static UIView *gTNBack = nil, *gTNHeader = nil, *gTNMore = nil;
static UILabel *gTNMoreLabel = nil;
static NSLayoutConstraint *gTNHeight = nil;
static NSMutableDictionary<NSString *, DMTNRow *> *gTNRows = nil;
static __weak UIStackView *gTNStack = nil;
static __weak UIView *gTNPanel = nil, *gTNToday = nil;
static CGFloat gTNMaxH = 0.0, gTNSkip = 0.0;
static BOOL gTNExpanded = NO, gTNBusy = NO, gTNAgain = NO, gTNKeepMore = NO;   // (gTNKeepMore: Show more/less keeps its row where the finger is)
static NSString *gTNSig = nil;
static __weak id gTNListVC = nil;   // the Cover Sheet's notification list controller (its Focus filter)
static NSMutableDictionary<NSString *, NSDate *> *gTNGone = nil;   // cleared by us: kept out for a moment while the list catches up
static NSString *DMTNStr(id o, NSString *k) { id v = DMCall(o, k); return ([v isKindOfClass:[NSString class]] && [(NSString *)v length]) ? v : nil; }
static NSMapTable *gTNInfo = nil;   // request (weak) -> its key, date, whether it is one of our test notifications, shown or not, when that was decided
static NSString *DMTNKeyFresh(id r) { return [NSString stringWithFormat:@"%@|%@", DMTNStr(r, @"sectionIdentifier") ?: @"", DMTNStr(r, @"notificationIdentifier") ?: [NSString stringWithFormat:@"%p", r]]; }
static NSString *DMTNKey(id r) { NSArray *i = [gTNInfo objectForKey:r]; return i ? i[0] : DMTNKeyFresh(r); }
static BOOL DMTNIsTest(id r) { return [DMTNStr(r, @"sectionIdentifier") isEqualToString:@"com.apple.Preferences"] && [DMTNStr(DMCall(r, @"content"), @"title") hasPrefix:@"MSB Test"]; }
static id DMTNGet(id o, NSString *k) {   // a getter, or the instance variable of that name when there is no getter
    if (!o) return nil;
    if ([o respondsToSelector:NSSelectorFromString(k)]) return DMCall(o, k);
    id v = nil; @try { v = [o valueForKey:k]; } @catch (id e) { v = nil; }
    return v;
}
static __weak id gTNMaster = nil;   // (found once: the Cover Sheet keeps it for SpringBoard's life)
static id DMTNMasterList(void) {
    id have = gTNMaster;
    if (have && gTNListVC) return have;
    id cs = DMCall(DMSBManager("SBCoverSheetPresentationManager"), @"coverSheetViewController");
    id list = DMTNGet(DMTNGet(DMTNGet(cs, @"mainPageContentViewController"), @"combinedListViewController"), @"structuredListViewController");
    gTNListVC = list;
    id ml = DMTNGet(list, @"masterList");
    gTNMaster = ml;
    return ml;
}
// Only real, delivered notifications (calls & special items): the call UI, media controls and Live Activities are not notification requests
// at all; what could still be in the lists is held out here -- a request that presents full screen (a ringing alarm or timer), one iOS does
// not deliver to the Notification Center / Lock Screen / Cover Sheet, one the list's own Focus filter hides, and a persistent one (it stays on
// the Lock Screen until acted on). Missed calls, time-sensitive and critical notifications are ordinary requests: shown like any other.
static BOOL DMTNShows(id r, id ml) {
    id o = DMCall(r, @"options");
    SEL fs = NSSelectorFromString(@"requestsFullScreenPresentation"), ps = NSSelectorFromString(@"lockScreenPersistence");
    if ([o respondsToSelector:fs] && ((BOOL (*)(id, SEL))objc_msgSend)(o, fs)) return NO;
    if ([o respondsToSelector:ps] && ((unsigned long long (*)(id, SEL))objc_msgSend)(o, ps) != 0) return NO;
    NSSet *d = DMCall(r, @"requestDestinations");
    if ([d isKindOfClass:[NSSet class]] && d.count && ![d containsObject:@"BulletinDestinationNotificationCenter"] && ![d containsObject:@"BulletinDestinationLockScreen"] && ![d containsObject:@"BulletinDestinationCoverSheet"]) return NO;
    SEL filt = NSSelectorFromString(@"notificationMasterList:shouldFilterNotificationRequest:");
    if ([gTNListVC respondsToSelector:filt] && ((BOOL (*)(id, SEL, id, id))objc_msgSend)(gTNListVC, filt, ml, r)) return NO;
    return YES;
}
// (the requests are immutable -- a change is a new request -- so what is read from one is kept with it: each tick only looks it up. Whether it
// is shown is decided again after 5 s: a Focus change can change it.)
static NSArray *DMTNInfoFor(id r, id ml, NSDate *now) {
    if (!gTNInfo) gTNInfo = [NSMapTable weakToStrongObjectsMapTable];
    NSArray *i = [gTNInfo objectForKey:r];
    if (i && [now timeIntervalSinceDate:i[4]] < 5.0) return i;
    NSDate *d = DMCall(r, @"timestamp");
    i = @[i ? i[0] : DMTNKeyFresh(r), [d isKindOfClass:[NSDate class]] ? d : [NSDate distantPast], @(DMTNIsTest(r)), @(DMTNShows(r, ml)), now];
    [gTNInfo setObject:i forKey:r];
    return i;
}
// THE SOURCE: the delivered notifications themselves, as SpringBoard's notification source holds them -- NCBulletinNotificationSource (the
// bridge between the bulletin server and NCNotificationDispatcher; SpringBoard -notificationDispatcher -notificationSource) keeps every delivered
// bulletin's notification request in -uuidsToRequests until the bulletin is withdrawn or cleared, on iOS 15 and 16 alike. It is what the Cover
// Sheet, Notification Center and banners are all fed from, so what a Lock Screen tweak does to the Cover Sheet's own list (a grouping tweak takes
// the requests out of it) does not change it, and it is complete from SpringBoard's start (Notification Center need not have been opened). The
// dictionary lives on the source's own queue: it is copied there (asynchronously: nothing waits on that queue) and the copy is used on the main
// thread. Without it (another iOS), the Cover Sheet's list is read as before.
static NSArray *gTNSnap = nil;          // the last copy of the source's requests (nil: no source here / not read yet)
static BOOL gTNFetching = NO, gTNFetchAgain = NO, gTNNoSource = NO;
static void DMTNRefresh(BOOL animated);
static id DMTNSource(dispatch_queue_t *queue) {
    id src = DMCall(DMCall([UIApplication sharedApplication], @"notificationDispatcher"), @"notificationSource");
    if (!src || ![src respondsToSelector:NSSelectorFromString(@"uuidsToRequests")]) return nil;
    Ivar qi = class_getInstanceVariable([src class], "_queue");
    id q = qi ? object_getIvar(src, qi) : nil;
    if (!q) return nil;
    if (queue) *queue = (dispatch_queue_t)q;
    return src;
}
static void DMTNFetch(void) {   // (main thread) a fresh copy of the source's requests; the box follows when it comes
    if (gTNFetching) { gTNFetchAgain = YES; return; }
    dispatch_queue_t q = NULL;
    id src = DMTNSource(&q);
    if (!src) {
        if (!gTNNoSource) { gTNNoSource = YES; gTNSnap = nil; DMLog(@"[tn] SpringBoard's notification source not found here: the Cover Sheet's list is read instead"); }
        DMTNRefresh(YES);
        return;
    }
    gTNFetching = YES;
    dispatch_async(q, ^{
        NSArray *vals = nil;
        @try { id d = ((id (*)(id, SEL))objc_msgSend)(src, NSSelectorFromString(@"uuidsToRequests")); if ([d isKindOfClass:[NSDictionary class]]) vals = [[(NSDictionary *)d allValues] copy]; }
        @catch (NSException *e) { vals = nil; }
        dispatch_async(dispatch_get_main_queue(), ^{
            gTNFetching = NO;
            static int told = -1;
            if (told != (vals != nil)) { told = (vals != nil); DMLog([NSString stringWithFormat:@"[tn] notification source %@", vals ? @"read (the delivered notifications)" : @"NOT readable: the Cover Sheet's list is read instead"]); }
            gTNSnap = vals;
            if (gTNFetchAgain) { gTNFetchAgain = NO; DMTNFetch(); return; }
            DMTNRefresh(YES);
        });
    });
}
static NSArray *DMTNRequests(void) {
    id ml = DMTNMasterList();
    static int told = -1;
    if (told != (ml != nil)) { told = (ml != nil); DMLog([NSString stringWithFormat:@"[tn] the Cover Sheet's notification list %@", ml ? @"found" : @"NOT found"]); }
    if (!ml && !gTNSnap) return @[];
    NSMutableArray *lists = [NSMutableArray array];
    if (gTNSnap) [lists addObject:gTNSnap];
    else {
        id secs = DMCall(ml, @"notificationSections");
        if ([secs isKindOfClass:[NSArray class]]) [lists addObjectsFromArray:secs];
        for (NSString *k in @[@"prominentIncomingSectionList", @"incomingSectionList", @"historySectionList", @"missedSectionList", @"persistentSectionList", @"highlightedSectionList"]) {
            id l = DMCall(ml, k);
            if (l && ![lists containsObject:l]) [lists addObject:l];
        }
    }
    NSMutableSet *skip = [NSMutableSet set];   // (not delivered yet: a scheduled summary still to come -- known from the Cover Sheet's list, when it has one)
    for (NSString *k in @[@"upcomingDigestSectionList", @"upcomingMissedSectionList"]) {
        id l = DMCall(ml, k);
        if (!l) continue;
        [lists removeObjectIdenticalTo:l];
        NSArray *rs = DMCall(l, @"allNotificationRequests");
        if ([rs isKindOfClass:[NSArray class]]) for (id r in rs) [skip addObject:DMTNKey(r)];
    }
    NSDate *now = [NSDate date];
    for (NSString *k in gTNGone.allKeys) if ([now timeIntervalSinceDate:gTNGone[k]] > 4.0) [gTNGone removeObjectForKey:k];
    BOOL testOnly = DMTestFlag("/tmp/msb-tn-testonly");   // (tests: only our own test notifications, never the owner's)
    NSMutableDictionary *byKey = [NSMutableDictionary dictionary];
    for (id l in lists) {
        NSArray *rs = [l isKindOfClass:[NSArray class]] ? l : DMCall(l, @"allNotificationRequests");
        if (![rs isKindOfClass:[NSArray class]]) continue;
        for (id r in rs) {
            NSArray *info = DMTNInfoFor(r, ml, now);
            NSString *k = info[0];
            if (byKey[k] || [skip containsObject:k] || gTNGone[k]) continue;
            if (testOnly && ![info[2] boolValue]) continue;
            if (![info[3] boolValue]) continue;
            byKey[k] = r;
        }
    }
    return [byKey.allValues sortedArrayUsingComparator:^NSComparisonResult(id a, id b) {
        NSDate *da = [gTNInfo objectForKey:a][1] ?: [NSDate distantPast], *db = [gTNInfo objectForKey:b][1] ?: [NSDate distantPast];
        return [db compare:da];
    }];
}
static BOOL DMTNHidesPreview(id r) {   // Settings > Notifications > Show Previews (and the app's own): 0 always, 1 when unlocked (our panel opens unlocked only), 2 never
    id opts = DMCall(r, @"options");
    SEL s = NSSelectorFromString(@"contentPreviewSetting");
    return [opts respondsToSelector:s] && ((unsigned long long (*)(id, SEL))objc_msgSend)(opts, s) == 2;
}
static NSString *DMTNAgo(NSDate *d) {
    if (![d isKindOfClass:[NSDate class]]) return @"";
    NSTimeInterval s = -[d timeIntervalSinceNow];
    if (s < 60.0) return @"now";
    if (s < 3600.0) return [NSString stringWithFormat:@"%dm ago", (int)(s / 60.0)];
    if (s < 86400.0) return [NSString stringWithFormat:@"%dh ago", (int)(s / 3600.0)];
    NSCalendar *cal = [NSCalendar currentCalendar];
    if ([cal isDateInYesterday:d]) return @"Yesterday";
    static NSDateFormatter *f; if (!f) { f = [NSDateFormatter new]; [f setLocalizedDateFormatFromTemplate:@"dMMM"]; }
    return [f stringFromDate:d];
}
static id DMTNDispatcher(void) { return DMCall(DMCall([UIApplication sharedApplication], @"notificationDispatcher"), @"dispatcher"); }
static id DMTNDestination(id disp) {   // the Cover Sheet's own destination (what its list is to the dispatcher)
    NSDictionary *d = DMCall(DMCall(disp, @"destinationsRegistry"), @"destinations");
    if (![d isKindOfClass:[NSDictionary class]]) return nil;
    for (id x in d.allValues) if ([NSStringFromClass([x class]) isEqualToString:@"CSNotificationDispatcher"]) return x;
    for (id x in d.allValues) if ([NSStringFromClass([x class]) isEqualToString:@"SBNotificationCenterDestination"]) return x;   // (no Cover Sheet destination: Notification Center's)
    return nil;
}
static void DMTNRefresh(BOOL animated);
static void DMTNClear(NSArray *reqs, NSString *why) {
    if (!reqs.count) return;
    id disp = DMTNDispatcher(), dest = DMTNDestination(disp);
    SEL s = NSSelectorFromString(@"destination:requestsClearingNotificationRequests:");
    if (!dest || ![disp respondsToSelector:s]) { DMLog([NSString stringWithFormat:@"[tn] cannot clear here (dispatcher %@, destination %@)", NSStringFromClass([disp class]), NSStringFromClass([dest class])]); return; }
    if (!gTNGone) gTNGone = [NSMutableDictionary dictionary];
    for (id r in reqs) gTNGone[DMTNKey(r)] = [NSDate date];
    @try { ((void (*)(id, SEL, id, id))objc_msgSend)(disp, s, dest, [NSSet setWithArray:reqs]); }
    @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[tn] clearing refused (%@)", e.reason]); }
    DMLog([NSString stringWithFormat:@"[tn] %@: %lu notification(s) cleared", why, (unsigned long)reqs.count]);
    DMTNRefresh(YES);
}
static void DMTNOpen(id r) {
    id disp = DMTNDispatcher(), dest = DMTNDestination(disp), action = DMCall(r, @"defaultAction");
    SEL s = NSSelectorFromString(@"destination:executeAction:forNotificationRequest:requestAuthentication:withParameters:completion:");
    BOOL ran = NO;
    if (action && dest && [disp respondsToSelector:s]) {
        @try { ((void (*)(id, SEL, id, id, id, BOOL, id, id))objc_msgSend)(disp, s, dest, action, r, NO, @{}, nil); ran = YES; }
        @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[tn] the default action was refused (%@)", e.reason]); }
    }
    if (!ran) {   // (no action of its own, or no dispatcher: the app opens)
        NSString *b = DMTNStr(r, @"sectionIdentifier");
        SEL l = NSSelectorFromString(@"launchApplicationWithIdentifier:suspended:");
        if (b && [[UIApplication sharedApplication] respondsToSelector:l]) ((BOOL (*)(id, SEL, id, BOOL))objc_msgSend)([UIApplication sharedApplication], l, b, NO);
    }
    DMLog([NSString stringWithFormat:@"[tn] row tapped: %@%@", ran ? @"its default action run" : @"its app opened", DMTNIsTest(r) ? [@" -- " stringByAppendingString:DMTNStr(DMCall(r, @"content"), @"title")] : @""]);
    DMCloseOverlay();
}
// The box's look is the widgets' own: their material (copied from the one behind the widget column, MTMaterialView's recipe and configuration)
// and their corner radius.
static CGFloat gTNRadius = 20.0;
static UIView *DMTNPlatter(UIStackView *column) {
    UIView *src = nil;
    for (UIView *list in column.arrangedSubviews) if ([list isKindOfClass:objc_getClass("SBIconListView")])
        for (UIView *u in list.subviews) if ([NSStringFromClass([u class]) isEqualToString:@"MTMaterialView"]) { src = u; break; }
    for (UIView *list in column.arrangedSubviews) if ([list isKindOfClass:objc_getClass("SBIconListView")]) {   // (a widget's corner radius)
        NSMutableArray *st = [NSMutableArray arrayWithArray:list.subviews]; int n = 0;
        while (st.count && n++ < 200) {
            UIView *u = st.firstObject; [st removeObjectAtIndex:0];
            if ([u isKindOfClass:objc_getClass("SBIconView")] || [u.superview isKindOfClass:objc_getClass("SBIconView")] || u.layer.cornerRadius > 4.0) {
                if (u.layer.cornerRadius > 4.0 && u.bounds.size.width > 60.0) { gTNRadius = u.layer.cornerRadius; st = nil; break; }
            }
            [st addObjectsFromArray:u.subviews];
        }
    }
    UIView *bg = nil;
    Class mt = objc_getClass("MTMaterialView");
    SEL make = NSSelectorFromString(@"materialViewWithRecipe:"), makeNamed = NSSelectorFromString(@"materialViewWithRecipeNamed:"), rs = NSSelectorFromString(@"recipe");
    NSString *name = DMTNStr(src, @"recipeName");
    long long recipe = [src respondsToSelector:rs] ? ((long long (*)(id, SEL))objc_msgSend)(src, rs) : 0;
    @try {
        if (src && recipe > 0 && [mt respondsToSelector:make]) bg = ((id (*)(id, SEL, long long))objc_msgSend)(mt, make, recipe);
        else if (src && name && [mt respondsToSelector:makeNamed]) bg = ((id (*)(id, SEL, id))objc_msgSend)(mt, makeNamed, name);
    } @catch (id e) { bg = nil; }
    { static BOOL told = NO; if (!told && src) { told = YES; DMLog([NSString stringWithFormat:@"[tn] the widgets' material: recipe %lld, name %@, mask %d, alpha %.2f -> %@; corners %.1f", recipe, name, src.layer.mask != nil || src.maskView != nil, src.alpha, NSStringFromClass([bg class]), gTNRadius]); } }
    if (![bg isKindOfClass:[UIView class]]) {
        bg = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
        static BOOL told = NO; if (!told) { told = YES; DMLog([NSString stringWithFormat:@"[tn] box material: a system material (the widgets' was not found: %@), corners %.1f", NSStringFromClass([src class]), gTNRadius]); }
    }
    bg.userInteractionEnabled = NO;
    return bg;
}
static UILabel *DMTNLabel(CGFloat size, UIFontWeight w, UIColor *c) {
    UILabel *l = [UILabel new]; l.font = [UIFont systemFontOfSize:size weight:w]; l.textColor = c; l.lineBreakMode = NSLineBreakByTruncatingTail;
    return l;
}
static NSString *DMTNAppName(NSString *bundle) {
    id app = [DMCall(objc_getClass("SBApplicationController"), @"sharedInstance") respondsToSelector:NSSelectorFromString(@"applicationWithBundleIdentifier:")] ?
        ((id (*)(id, SEL, id))objc_msgSend)(DMCall(objc_getClass("SBApplicationController"), @"sharedInstance"), NSSelectorFromString(@"applicationWithBundleIdentifier:"), bundle) : nil;
    return DMTNStr(app, @"displayName") ?: bundle;
}
static DMTNRow *DMTNMakeRow(id r, CGFloat W) {
    id content = DMCall(r, @"content");
    NSString *bundle = DMTNStr(r, @"sectionIdentifier") ?: @"";
    NSString *app = DMTNStr(content, @"header") ?: DMTNAppName(bundle);
    BOOL hidden = DMTNHidesPreview(r);
    // Title and subtitle both, as iOS shows them (a WhatsApp group: the group in one, the sender in the other -- with only the title it looked like
    // a direct message): "title · subtitle" on the top line.
    NSString *title = nil;
    if (!hidden) {
        NSString *t = DMTNStr(content, @"title"), *st = DMTNStr(content, @"subtitle");
        title = (t.length && st.length && ![t isEqualToString:st]) ? [NSString stringWithFormat:@"%@ · %@", t, st] : (t.length ? t : st);
    }
    NSString *body = hidden ? @"Notification" : DMTNStr(content, @"message");
    if (!title && !body) body = @"Notification";
    id icon = DMCall(content, @"icon");
    if (![icon isKindOfClass:[UIImage class]]) { NSArray *icons = DMCall(content, @"icons"); icon = [icons isKindOfClass:[NSArray class]] ? icons.firstObject : nil; }
    if (![icon isKindOfClass:[UIImage class]]) icon = DMAppIcon(bundle);
    DMTNRow *row = [[DMTNRow alloc] initWithFrame:CGRectMake(0, 0, W, 60)];
    row.request = r; row.key = DMTNKey(r); row.date = DMCall(r, @"timestamp");
    row.clipsToBounds = YES;
    UIView *back = [[UIView alloc] initWithFrame:row.bounds];
    back.backgroundColor = [UIColor systemRedColor]; back.alpha = 0.0; back.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    UILabel *cl = DMTNLabel(14, UIFontWeightSemibold, [UIColor whiteColor]); cl.text = @"Clear"; [cl sizeToFit];
    cl.frame = CGRectMake(W - kTNPad - cl.bounds.size.width, 0, cl.bounds.size.width, 60); cl.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin | UIViewAutoresizingFlexibleHeight;
    [back addSubview:cl];
    [row addSubview:back]; row.clearBack = back;
    UIView *slide = [[UIView alloc] initWithFrame:row.bounds]; slide.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [row addSubview:slide]; row.slide = slide;
    CGFloat x0 = kTNPad + kTNIcon + 10.0, tw = W - x0 - kTNPad, y = 10.0;
    UIImageView *iv = [[UIImageView alloc] initWithFrame:CGRectMake(kTNPad, 11.0, kTNIcon, kTNIcon)];
    iv.accessibilityIgnoresInvertColors = YES;
    iv.image = icon; iv.contentMode = UIViewContentModeScaleAspectFit; iv.layer.cornerRadius = 7.0; iv.layer.cornerCurve = kCACornerCurveContinuous; iv.clipsToBounds = YES;
    [slide addSubview:iv];
    UILabel *tl = DMTNLabel(12, UIFontWeightRegular, [UIColor secondaryLabelColor]); tl.text = DMTNAgo(row.date); [tl sizeToFit];
    CGFloat tlw = MIN(tl.bounds.size.width + 2.0, tw * 0.45);
    tl.frame = CGRectMake(W - kTNPad - tlw, y, tlw, 16.0); tl.textAlignment = NSTextAlignmentRight;
    [slide addSubview:tl]; row.timeLabel = tl;
    UILabel *al = DMTNLabel(12, UIFontWeightMedium, [UIColor secondaryLabelColor]); al.text = app;
    al.frame = CGRectMake(x0, y, tw - tlw - 6.0, 16.0);
    [slide addSubview:al];
    y += 17.0;
    if (title) {
        UILabel *ttl = DMTNLabel(14, UIFontWeightSemibold, [UIColor labelColor]); ttl.text = title;
        ttl.frame = CGRectMake(x0, y, tw, 18.0); [slide addSubview:ttl]; y += 18.0;
    }
    if (body) {
        UILabel *bl = DMTNLabel(14, UIFontWeightRegular, title ? [UIColor secondaryLabelColor] : [UIColor labelColor]); bl.text = body; bl.numberOfLines = 2;
        CGFloat h = MIN(ceil([bl sizeThatFits:CGSizeMake(tw, CGFLOAT_MAX)].height), ceil(bl.font.lineHeight * 2.0) + 1.0);
        bl.frame = CGRectMake(x0, y, tw, MAX(18.0, h)); [slide addSubview:bl]; y += MAX(18.0, h);
    }
    CGFloat h = MAX(y + 10.0, 11.0 + kTNIcon + 11.0);
    row.frame = CGRectMake(0, 0, W, h);
    cl.frame = CGRectMake(W - kTNPad - cl.bounds.size.width, 0, cl.bounds.size.width, h);
    UIView *sep = [[UIView alloc] initWithFrame:CGRectMake(kTNPad, 0, W - 2.0 * kTNPad, 1.0 / [UIScreen mainScreen].scale)];
    sep.backgroundColor = [UIColor separatorColor]; sep.autoresizingMask = UIViewAutoresizingFlexibleWidth;
    [row addSubview:sep]; row.separator = sep;
    UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:[DMTNTarget shared] action:NSSelectorFromString(@"rowTap:")];
    [row addGestureRecognizer:tap];
    UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:[DMTNTarget shared] action:NSSelectorFromString(@"rowPan:")];
    pan.delegate = row; [row addGestureRecognizer:pan];
    return row;
}
// The box fits the widget column's new height into the panel (at most the room it had when it opened); called inside the animations, so the
// panel's edge moves with the widgets.
static void DMTNFitPanel(void) {
    UIView *panel = gTNPanel, *v = gTNToday; UIStackView *col = gTNStack;
    if (!panel || !v || !col) return;
    [v layoutIfNeeded];
    CGFloat want = col.bounds.size.height + 24.0;
    CGRect pf = panel.frame; pf.size.height = MIN(gTNMaxH, MAX(120.0, want));
    if (fabs(pf.size.height - panel.frame.size.height) < 0.5) return;
    panel.frame = pf;
    if (!(v.autoresizingMask & UIViewAutoresizingFlexibleHeight)) { CGRect vf = v.frame; vf.size.height = pf.size.height + gTNSkip; v.frame = vf; }
    [v layoutIfNeeded];
}
static void DMTNRefresh(BOOL animated) {
    UIView *box = gTNBox;
    if (!box) return;
    if (gTNBusy) { gTNAgain = YES; return; }
    CFTimeInterval tr0 = CACurrentMediaTime();
    NSArray *reqs = gTodayNotifications ? DMTNRequests() : @[];
    if (DMTestFlag("/tmp/msb-tn-prof")) { static double sum = 0; static int n = 0; sum += CACurrentMediaTime() - tr0; if (++n == 40) { DMLog([NSString stringWithFormat:@"[tn] reading the list: %.2f ms each", sum / n * 1000.0]); sum = 0; n = 0; } }
    NSMutableArray *keys = [NSMutableArray array];
    for (id r in reqs) [keys addObject:DMTNKey(r)];
    NSString *sig = [NSString stringWithFormat:@"%d|%@", gTNExpanded && reqs.count > kTNCollapsedRows, [keys componentsJoinedByString:@","]];
    for (DMTNRow *row in gTNRows.allValues) { NSString *t = DMTNAgo(row.date); if (![row.timeLabel.text isEqualToString:t]) row.timeLabel.text = t; }
    if ([sig isEqualToString:gTNSig]) return;
    BOOL first = gTNSig == nil;
    gTNSig = sig;
    CGFloat W = box.bounds.size.width > 100.0 ? box.bounds.size.width : gTNStack.bounds.size.width;
    if (reqs.count <= kTNCollapsedRows) gTNExpanded = NO;   // (the newest 5; more behind "Show N more")
    NSUInteger shown = gTNExpanded ? reqs.count : MIN(reqs.count, kTNCollapsedRows);
    NSMutableDictionary *next = [NSMutableDictionary dictionary];
    NSMutableArray *fresh = [NSMutableArray array], *order = [NSMutableArray array];
    for (NSUInteger i = 0; i < shown; i++) {
        id r = reqs[i]; NSString *k = keys[i];
        DMTNRow *row = gTNRows[k];
        if (!row || row.leaving) { row = DMTNMakeRow(r, W); [fresh addObject:row]; }
        next[k] = row; [order addObject:row];
    }
    NSMutableArray *gone = [NSMutableArray array];
    for (NSString *k in gTNRows) if (!next[k]) [gone addObject:gTNRows[k]];
    gTNRows = next;
    CGFloat y = kTNHeaderH;
    NSMutableArray *frames = [NSMutableArray array];
    for (DMTNRow *row in order) { [frames addObject:[NSValue valueWithCGRect:CGRectMake(0, y, W, row.bounds.size.height)]]; y += row.bounds.size.height; }
    BOOL more = reqs.count > kTNCollapsedRows;
    gTNMoreLabel.text = gTNExpanded ? @"Show less" : [NSString stringWithFormat:@"Show %lu more", (unsigned long)(reqs.count - shown)];
    CGRect moreFrame = CGRectMake(0, y, W, kTNMoreH);
    CGFloat H = y + (more ? kTNMoreH : 0.0) + 4.0;
    BOOL show = reqs.count > 0, wasShown = !box.hidden;
    UIScrollView *list = [gTNStack.superview isKindOfClass:[UIScrollView class]] ? (UIScrollView *)gTNStack.superview : nil;
    CGFloat newOffset = NAN;
    if (gTNKeepMore && list && more) {   // (the list moves by what the box lost or gained above that row, within its range)
        CGFloat was = [gTNMore convertPoint:CGPointZero toView:list].y, will = [box convertPoint:moreFrame.origin toView:list].y;
        CGFloat top = -list.adjustedContentInset.top, grow = H - box.bounds.size.height;
        CGFloat maxY = MAX(top, list.contentSize.height + grow + list.adjustedContentInset.bottom - list.bounds.size.height);
        newOffset = MIN(MAX(list.contentOffset.y - (was - will), top), maxY);
    }
    gTNKeepMore = NO;
    for (DMTNRow *row in fresh) {   // (new rows start where they will be, clear)
        NSUInteger i = [order indexOfObjectIdenticalTo:row];
        row.frame = [frames[i] CGRectValue]; row.alpha = 0.0; [box addSubview:row];
    }
    if (!wasShown || first) { gTNMore.frame = moreFrame; gTNMore.alpha = more ? 1.0 : 0.0; }
    void (^apply)(void) = ^{
        for (NSUInteger i = 0; i < order.count; i++) { DMTNRow *row = order[i]; row.frame = [frames[i] CGRectValue]; row.alpha = 1.0; row.separator.alpha = 1.0; }
        for (DMTNRow *row in gone) row.alpha = 0.0;
        gTNMore.frame = moreFrame; gTNMore.alpha = more ? 1.0 : 0.0; gTNMore.userInteractionEnabled = more;
        if (show) { gTNHeight.constant = H; box.hidden = NO; box.alpha = 1.0; }
        else { box.hidden = YES; box.alpha = 0.0; }
        DMTNFitPanel();
        if (!isnan(newOffset)) list.contentOffset = CGPointMake(list.contentOffset.x, newOffset);
    };
    void (^done)(BOOL) = ^(BOOL f) {
        for (DMTNRow *row in gone) [row removeFromSuperview];
        UIView *v = gTNToday; v.userInteractionEnabled = YES;
        gTNBusy = NO;
        if (gTNAgain) { gTNAgain = NO; dispatch_async(dispatch_get_main_queue(), ^{ DMTNRefresh(YES); }); }   // (anything that changed meanwhile, animated too)
    };
    DMLog([NSString stringWithFormat:@"[tn] %lu notification(s), %lu shown%@ (%lu new, %lu gone): box %@", (unsigned long)reqs.count, (unsigned long)shown, more ? (gTNExpanded ? @", expanded" : @", collapsed") : @"", (unsigned long)fresh.count, (unsigned long)gone.count, show ? [NSString stringWithFormat:@"%.0f pt", H] : @"hidden"]);
    if (!animated || first) {
        [UIView performWithoutAnimation:^{ apply(); [gTNToday layoutIfNeeded]; }];
        done(YES);
        return;
    }
    if (show && !wasShown) { [UIView performWithoutAnimation:^{ gTNHeight.constant = H; box.alpha = 0.0; }]; }
    gTNBusy = YES;
    gTNToday.userInteractionEnabled = NO;   // (no taps on a widget or row while they move)
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[tn] animating (reduce motion %d, inside an animation %d)", MSBReduceMotion(), [UIView inheritedAnimationDuration] > 0.0]);
    MSBAnimate(0.32, 0.0, 0.0, UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionOverrideInheritedDuration | UIViewAnimationOptionOverrideInheritedCurve, ^{ apply(); [gTNToday layoutIfNeeded]; }, done);
}
static UIView *DMTNMakeBox(UIStackView *column, CGFloat W) {
    UIView *box = [[UIView alloc] initWithFrame:CGRectMake(0, 0, W, 100)];
    box.translatesAutoresizingMaskIntoConstraints = NO;
    UIView *bg = DMTNPlatter(column);
    box.layer.cornerRadius = gTNRadius; box.layer.cornerCurve = kCACornerCurveContinuous; box.clipsToBounds = YES;
    bg.frame = box.bounds; bg.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [box addSubview:bg]; gTNBack = bg;
    UIView *header = [[UIView alloc] initWithFrame:CGRectMake(0, 0, W, kTNHeaderH)]; header.autoresizingMask = UIViewAutoresizingFlexibleWidth;
    UILabel *hl = DMTNLabel(15, UIFontWeightSemibold, [UIColor labelColor]); hl.text = @"Notifications";
    hl.frame = CGRectMake(kTNPad, 0, W - 2.0 * kTNPad - 70.0, kTNHeaderH); [header addSubview:hl];
    UIView *clear = [[UIView alloc] initWithFrame:CGRectMake(W - 76.0, 0, 76.0, kTNHeaderH)]; clear.autoresizingMask = UIViewAutoresizingFlexibleLeftMargin;
    UILabel *cl = DMTNLabel(14, UIFontWeightMedium, [UIColor secondaryLabelColor]); cl.text = @"Clear"; cl.textAlignment = NSTextAlignmentRight;
    cl.frame = CGRectMake(0, 0, 76.0 - kTNPad, kTNHeaderH); [clear addSubview:cl];
    [clear addGestureRecognizer:[[UITapGestureRecognizer alloc] initWithTarget:[DMTNTarget shared] action:NSSelectorFromString(@"clearAll:")]];
    [header addSubview:clear];
    [box addSubview:header]; gTNHeader = header;
    UIView *more = [[UIView alloc] initWithFrame:CGRectMake(0, 0, W, kTNMoreH)]; more.autoresizingMask = UIViewAutoresizingFlexibleWidth;
    UIView *sep = [[UIView alloc] initWithFrame:CGRectMake(kTNPad, 0, W - 2.0 * kTNPad, 1.0 / [UIScreen mainScreen].scale)];
    sep.backgroundColor = [UIColor separatorColor]; sep.autoresizingMask = UIViewAutoresizingFlexibleWidth; [more addSubview:sep];
    UILabel *ml = DMTNLabel(14, UIFontWeightMedium, [UIColor systemBlueColor]); ml.frame = CGRectMake(kTNPad, 0, W - 2.0 * kTNPad, kTNMoreH);
    [more addSubview:ml]; gTNMoreLabel = ml;
    [more addGestureRecognizer:[[UITapGestureRecognizer alloc] initWithTarget:[DMTNTarget shared] action:NSSelectorFromString(@"moreTap:")]];
    more.alpha = 0.0;
    [box addSubview:more]; gTNMore = more;
    gTNHeight = [box.heightAnchor constraintEqualToConstant:100.0];
    gTNHeight.priority = 999; gTNHeight.active = YES;
    return box;
}
// The source is copied only when something changed -- every delivered, changed, withdrawn or cleared notification goes through
// NCNotificationDispatcher's post/modify/withdraw (and the Cover Sheet's list's insert/modify/remove, where it has one) -- and every 2 s while the
// panel is open anyway (the times, a Focus change). Kept up to date while the panel is closed too (only on a change: a copy costs well under
// 1 ms), so the box is right the moment the panel opens. Without the hooks (another iOS), the panel's tick reads it every 2 s and at once when
// the panel opens.
static BOOL gTNDirty = YES, gTNHooked = NO, gTNSoon = NO;
static void DMTNChanged(void) {   // (any thread) a notification came, changed or went: a fresh copy shortly (a burst -- a respring's -- is one copy)
    gTNDirty = YES;
    if (gTNSoon) return;
    gTNSoon = YES;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        gTNSoon = NO;
        if (!gTodayNotifications || !gTNDirty) return;
        gTNDirty = NO;
        DMTNFetch();
    });
}
%group DMTNWatch
%hook NCNotificationMasterList
- (void)insertNotificationRequest:(id)r {
    %orig;
    DMTNChanged();
}
- (void)removeNotificationRequest:(id)r {
    %orig;
    DMTNChanged();
}
- (void)modifyNotificationRequest:(id)r {
    %orig;
    DMTNChanged();
}
%end
%end
%group DMTNDispatch
%hook NCNotificationDispatcher
- (void)postNotificationWithRequest:(id)r {
    %orig;
    DMTNChanged();
}
- (void)modifyNotificationWithRequest:(id)r {
    %orig;
    DMTNChanged();
}
- (void)withdrawNotificationWithRequest:(id)r {
    %orig;
    DMTNChanged();
}
%end
%end
static BOOL DMTNHas(Class c, NSArray *names) {
    for (NSString *m in names) { Method x = c ? class_getInstanceMethod(c, NSSelectorFromString(m)) : NULL; if (!x || method_getNumberOfArguments(x) != 3) return NO; }
    return c != nil;
}
static void DMTNWatchInit(void) {
    BOOL list = DMTNHas(objc_getClass("NCNotificationMasterList"), @[@"insertNotificationRequest:", @"removeNotificationRequest:", @"modifyNotificationRequest:"]);
    BOOL disp = DMTNHas(objc_getClass("NCNotificationDispatcher"), @[@"postNotificationWithRequest:", @"modifyNotificationWithRequest:", @"withdrawNotificationWithRequest:"]);
    if (list) %init(DMTNWatch);
    if (disp) %init(DMTNDispatch);
    gTNHooked = disp;
    DMLog([NSString stringWithFormat:@"[tn] watching the notifications: dispatcher %@, Cover Sheet list %@", disp ? @"yes" : @"NO (read every 2 s)", list ? @"yes" : @"no"]);
}
static void DMTNTick(void) {   // (the Today watcher, while the panel is open)
    static CFTimeInterval last = 0;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - last < 2.0) return;   // (a change is copied at once by DMTNChanged; this is the safety net)
    last = now;
    gTNDirty = NO;
    DMTNFetch();
}
// Called by DMOpenTodayPanel once the Today View is in the panel, before the panel's height is measured (the box counts in it).
static void DMTNInstall(UIView *column) {
    if (!gTodayNotifications || gTNBox || ![column isKindOfClass:[UIStackView class]]) return;
    UIStackView *stack = (UIStackView *)column;
    CGFloat W = stack.bounds.size.width;
    for (UIView *u in stack.arrangedSubviews) if ([u isKindOfClass:objc_getClass("SBIconListView")] && u.bounds.size.width > 100.0) W = MIN(W, u.bounds.size.width);
    if (W < 100.0) return;
    UIView *box = DMTNMakeBox(stack, W);
    box.hidden = YES;
    @try { [stack insertArrangedSubview:box atIndex:0]; }
    @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[tn] the box could not join the widget column (%@)", e.reason]); return; }
    NSLayoutConstraint *w = [box.widthAnchor constraintEqualToConstant:W]; w.priority = 999; w.active = YES;
    gTNBox = box; gTNStack = stack; gTNRows = [NSMutableDictionary dictionary]; gTNSig = nil; gTNExpanded = NO; gTNBusy = NO; gTNAgain = NO;
    box.frame = CGRectMake(0, 0, W, 100);
    DMTNRefresh(NO);
    [stack layoutIfNeeded];
    DMTNFetch();   // (a fresh copy anyway -- the one kept may be from before the switch was turned on; the box follows in a moment if it differs)
}
static void DMTNAttach(UIView *panel, UIView *todayView, CGFloat maxH, CGFloat skip) {
    if (!gTNBox) return;
    gTNPanel = panel; gTNToday = todayView; gTNMaxH = maxH; gTNSkip = skip;
}
// Before the Today View goes back (DMTodayGiveBack): the box leaves SpringBoard's column, which is then exactly as it was.
static void DMTNRemove(void) {
    UIView *box = gTNBox;
    if (!box) return;
    UIStackView *s = gTNStack;
    [box.layer removeAllAnimations];
    @try { [s removeArrangedSubview:box]; } @catch (id e) {}
    [box removeFromSuperview];
    gTNBox = nil; gTNRows = nil; gTNHeader = nil; gTNMore = nil; gTNMoreLabel = nil; gTNBack = nil; gTNHeight = nil; gTNSig = nil;
    gTNBusy = NO; gTNAgain = NO; gTNExpanded = NO;
    UIView *v = gTNToday; v.userInteractionEnabled = YES;
    @try { [s setNeedsLayout]; [s.superview layoutIfNeeded]; [s layoutIfNeeded]; } @catch (id e) {}   // (the column's own frames as they were, at once)
}
@implementation DMTNRow
- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)g {   // (only a sideways swipe to the left; up and down scroll the panel)
    if (![g isKindOfClass:[UIPanGestureRecognizer class]]) return YES;
    if (gTNBusy || self.leaving) return NO;
    CGPoint v = [(UIPanGestureRecognizer *)g velocityInView:self];
    return v.x < 0.0 && fabs(v.x) > fabs(v.y) * 1.2;
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldBeRequiredToFailByGestureRecognizer:(UIGestureRecognizer *)other {
    return [g isKindOfClass:[UIPanGestureRecognizer class]] && [other.view isKindOfClass:[UIScrollView class]] && other == ((UIScrollView *)other.view).panGestureRecognizer;
}
@end
@implementation DMTNTarget
+ (instancetype)shared { static DMTNTarget *t; static dispatch_once_t once; dispatch_once(&once, ^{ t = [DMTNTarget new]; }); return t; }
- (void)rowTap:(UITapGestureRecognizer *)g {
    DMTNRow *row = (DMTNRow *)g.view;
    if (g.state != UIGestureRecognizerStateEnded || gTNBusy || row.leaving || ![row isKindOfClass:[DMTNRow class]]) return;
    row.slide.backgroundColor = [[UIColor labelColor] colorWithAlphaComponent:0.08];
    DMTNOpen(row.request);
}
- (void)rowPan:(UIPanGestureRecognizer *)g {
    DMTNRow *row = (DMTNRow *)g.view;
    if (![row isKindOfClass:[DMTNRow class]]) return;
    CGFloat W = row.bounds.size.width, tx = MIN(0.0, [g translationInView:row].x);
    if (g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged) {
        row.slide.transform = CGAffineTransformMakeTranslation(tx, 0);
        row.clearBack.alpha = MIN(1.0, -tx / 60.0);
        row.separator.alpha = 0.0;
        return;
    }
    BOOL clear = g.state == UIGestureRecognizerStateEnded && (tx < -W * 0.4 || ([g velocityInView:row].x < -700.0 && tx < -30.0));
    if (!clear) {
        MSBAnimate(0.3, 0.0, 0.8, 0, ^{ row.slide.transform = CGAffineTransformIdentity; row.clearBack.alpha = 0.0; row.separator.alpha = 1.0; }, nil);
        return;
    }
    row.leaving = YES;
    id r = row.request;
    [UIView animateWithDuration:0.18 delay:0 options:UIViewAnimationOptionCurveEaseOut animations:^{ row.slide.transform = CGAffineTransformMakeTranslation(-W, 0); } completion:^(BOOL f) {
        DMTNClear(@[r], @"swiped away");
    }];
}
- (void)clearAll:(UITapGestureRecognizer *)g {
    if (g.state != UIGestureRecognizerStateEnded || gTNBusy) return;
    DMTNClear(DMTNRequests(), @"Clear");
}
- (void)moreTap:(UITapGestureRecognizer *)g {
    if (g.state != UIGestureRecognizerStateEnded || gTNBusy) return;
    gTNExpanded = !gTNExpanded;
    gTNKeepMore = !gTNExpanded;   // (Show more opens downwards from where it is; Show less keeps its row under the finger)
    DMLog([NSString stringWithFormat:@"[tn] %@", gTNExpanded ? @"Show more" : @"Show less"]);
    DMTNRefresh(YES);
}
@end
#if DEBUG
// (tests) our own test notifications: published through SpringBoard's bulletin server for Settings (com.apple.Preferences), titled "MSB Test n",
// withdrawn again by tnwithdraw; their ids are kept in /tmp/msb-tn-testids so a respring does not strand them.
static __weak id gTNServer = nil;
%group DMTNServerA
%hook BBServer
- (id)initWithQueue:(id)q {
    id s = %orig;
    if (s) gTNServer = s;
    return s;
}
%end
%end
%group DMTNServerB
%hook BBServer
- (id)initWithQueue:(id)q dataProviderManager:(id)a syncService:(id)b dismissalSyncCache:(id)c observerListener:(id)d conduitListener:(id)e settingsListener:(id)f {
    id s = %orig;
    if (s) gTNServer = s;
    return s;
}
%end
%end
static void DMTNTestInit(void) {
    Class c = objc_getClass("BBServer");
    if (c && class_getInstanceMethod(c, @selector(initWithQueue:))) %init(DMTNServerA);
    if (c && class_getInstanceMethod(c, NSSelectorFromString(@"initWithQueue:dataProviderManager:syncService:dismissalSyncCache:observerListener:conduitListener:settingsListener:"))) %init(DMTNServerB);
}
static dispatch_queue_t DMTNServerQueue(id srv) {
    Ivar qi = srv ? class_getInstanceVariable([srv class], "_queue") : NULL;
    id q = qi ? object_getIvar(srv, qi) : nil;
    return q;
}
static BOOL gTNTestLong = NO;   // (tnpost_..._long: a long message, as long chat messages or mails bring)
static void DMTNTestPost(int n, unsigned long long dest, long long persistence) {
    id srv = gTNServer; dispatch_queue_t q = DMTNServerQueue(srv);
    if (!srv || !q) { DMLog([NSString stringWithFormat:@"[tntest] no bulletin server (%@) or queue", srv]); return; }
    static int counter = 0;
    NSString *idsPath = @"/tmp/msb-tn-testids";
    for (int i = 0; i < n; i++) {
        int num = ++counter;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.35 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            id b = [objc_getClass("BBBulletin") new];
            NSString *pid = [@"msbtest-" stringByAppendingString:[[NSUUID UUID] UUIDString]];
            @try {
                [b setValue:@"com.apple.Preferences" forKey:@"sectionID"];
                [b setValue:pid forKey:@"bulletinID"]; [b setValue:pid forKey:@"recordID"]; [b setValue:pid forKey:@"publisherBulletinID"];
                [b setValue:[NSString stringWithFormat:@"MSB Test %d", num] forKey:@"title"];
                [b setValue:gTNTestLong ? [NSString stringWithFormat:@"Test notification %d from MacStatusBar&Dock with a long message. It goes on for several sentences, the way a long chat message or the start of a mail does, so the banner has far more text than fits in it. Every word here is only test text. The end of the message comes here, after many lines.", num]
                                        : [NSString stringWithFormat:@"Test notification %d from MacStatusBar&Dock: a preview long enough to need a second line in the box.", num] forKey:@"message"];
                [b setValue:[NSDate date] forKey:@"date"];
                [b setValue:[NSDate date] forKey:@"lastInterruptDate"];
                id act = ((id (*)(id, SEL, id, id))objc_msgSend)(objc_getClass("BBAction"), NSSelectorFromString(@"actionWithLaunchBundleID:callblock:"), @"com.apple.Preferences", nil);
                if (act) [b setValue:act forKey:@"defaultAction"];
                [b setValue:@YES forKey:@"clearable"];
                if (persistence >= 0) [b setValue:@(persistence) forKey:@"lockScreenPersistence"];
            } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[tntest] bulletin setup refused (%@)", e.reason]); return; }
            NSString *old = [NSString stringWithContentsOfFile:idsPath encoding:NSUTF8StringEncoding error:nil] ?: @"";
            [[old stringByAppendingFormat:@"%@\n", pid] writeToFile:idsPath atomically:YES encoding:NSUTF8StringEncoding error:nil];
            dispatch_async(q, ^{ ((void (*)(id, SEL, id, unsigned long long))objc_msgSend)(srv, NSSelectorFromString(@"publishBulletin:destinations:"), b, dest); });
            DMLog([NSString stringWithFormat:@"[tntest] posted MSB Test %d (destinations %llu)", num, dest]);
        });
    }
}
static void DMTNTestWithdraw(void) {
    id srv = gTNServer; dispatch_queue_t q = DMTNServerQueue(srv);
    NSString *idsPath = @"/tmp/msb-tn-testids";
    NSArray *ids = [[NSString stringWithContentsOfFile:idsPath encoding:NSUTF8StringEncoding error:nil] componentsSeparatedByString:@"\n"];
    int n = 0;
    SEL byID = NSSelectorFromString(@"withdrawBulletinID:");   // (iOS 15: a bulletin published straight to the server is only found by its bulletin ID)
    if (srv && q) for (NSString *pid in ids) if (pid.length) { n++; dispatch_async(q, ^{
        if ([srv respondsToSelector:byID]) ((void (*)(id, SEL, id))objc_msgSend)(srv, byID, pid);
        ((void (*)(id, SEL, id, id))objc_msgSend)(srv, NSSelectorFromString(@"withdrawBulletinRequestsWithPublisherBulletinID:forSectionID:"), pid, @"com.apple.Preferences");
    }); }
    unlink(idsPath.UTF8String);
    // (and any test notification still in the list, by the Cover Sheet's own clearing)
    NSMutableArray *left = [NSMutableArray array];
    id ml = DMTNMasterList(); (void)ml;
    BOOL was = gTodayNotifications; gTodayNotifications = YES;
    for (id r in DMTNRequests()) if (DMTNIsTest(r)) [left addObject:r];
    gTodayNotifications = was;
    DMLog([NSString stringWithFormat:@"[tntest] withdrew %d test notification(s); %lu still listed", n, (unsigned long)left.count]);
}
static void DMTNTestInfo(void) {
    NSArray *all = DMTNRequests();
    int tests = 0; for (id r in all) if (DMTNIsTest(r)) tests++;
    NSMutableString *m = [NSMutableString stringWithFormat:@"[tninfo] %lu listed (%d ours), box %@ hidden %d alpha %.2f, panel %@, column %@, list content %.0f offset %.0f, expanded %d busy %d",
        (unsigned long)all.count, tests, gTNBox ? NSStringFromCGRect(gTNBox.frame) : @"-", gTNBox.hidden, gTNBox.alpha, NSStringFromCGRect(gTNPanel.frame), NSStringFromCGRect(gTNStack.frame),
        [gTNStack.superview isKindOfClass:[UIScrollView class]] ? ((UIScrollView *)gTNStack.superview).contentSize.height : -1.0, [gTNStack.superview isKindOfClass:[UIScrollView class]] ? ((UIScrollView *)gTNStack.superview).contentOffset.y : -1.0, gTNExpanded, gTNBusy];
    NSArray *rows = [gTNRows.allValues sortedArrayUsingComparator:^NSComparisonResult(UIView *a, UIView *b) { return a.frame.origin.y < b.frame.origin.y ? NSOrderedAscending : NSOrderedDescending; }];
    for (DMTNRow *row in rows) {
        CGRect s = [row convertRect:row.bounds toCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
        [m appendFormat:@"\n  row %@ screen %@%@", NSStringFromCGRect(row.frame), NSStringFromCGRect(s), DMTNIsTest(row.request) ? [@" " stringByAppendingString:DMTNStr(DMCall(row.request, @"content"), @"title")] : @""];
    }
    if (gTNMore) [m appendFormat:@"\n  more %@ screen %@ alpha %.2f '%@'", NSStringFromCGRect(gTNMore.frame), NSStringFromCGRect([gTNMore convertRect:gTNMore.bounds toCoordinateSpace:[UIScreen mainScreen].coordinateSpace]), gTNMore.alpha, gTNMoreLabel.text];
    if (gTNHeader) [m appendFormat:@"\n  header screen %@", NSStringFromCGRect([gTNHeader convertRect:gTNHeader.bounds toCoordinateSpace:[UIScreen mainScreen].coordinateSpace])];
    for (UIView *u in gTNStack.arrangedSubviews) [m appendFormat:@"\n  column item %@ %@%@", NSStringFromClass([u class]), NSStringFromCGRect(u.frame), u.hidden ? @" hidden" : @""];
    DMLog(m);
}
static NSString *DMTNFlags(id r) {   // (tests) a request's delivery flags -- no content
    id o = DMCall(r, @"options");
    BOOL (*b)(id, SEL) = (BOOL (*)(id, SEL))objc_msgSend; unsigned long long (*q)(id, SEL) = (unsigned long long (*)(id, SEL))objc_msgSend;
    #define TNB(k) ([o respondsToSelector:NSSelectorFromString(k)] ? (int)b(o, NSSelectorFromString(k)) : -1)
    #define TNQ(k) ([o respondsToSelector:NSSelectorFromString(k)] ? (long long)q(o, NSSelectorFromString(k)) : -1)
    NSSet *dests = DMCall(r, @"requestDestinations");
    NSString *f = [NSString stringWithFormat:@"fullscreen %d persist %lld prio %lld preview %lld hideClear %d dismissAuto %d addLS %d interruption %lld critical %d collapsed %d dests %@",
        TNB(@"requestsFullScreenPresentation"), TNQ(@"lockScreenPersistence"), TNQ(@"lockScreenPriority"), TNQ(@"contentPreviewSetting"), TNB(@"hideClearActionInList"), TNB(@"dismissAutomatically"), TNB(@"addToLockScreenWhenUnlocked"),
        [r respondsToSelector:@selector(interruptionLevel)] ? (long long)q(r, @selector(interruptionLevel)) : -1, [r respondsToSelector:NSSelectorFromString(@"isCriticalAlert")] ? (int)b(r, NSSelectorFromString(@"isCriticalAlert")) : -1,
        [r respondsToSelector:NSSelectorFromString(@"isCollapsedNotification")] ? (int)b(r, NSSelectorFromString(@"isCollapsedNotification")) : -1,
        [dests isKindOfClass:[NSSet class]] ? [[dests.allObjects sortedArrayUsingSelector:@selector(compare:)] componentsJoinedByString:@"+"] : @"-"];
    #undef TNB
    #undef TNQ
    return f;
}
static void DMTNTestSource(void) {   // (tests) counts only: the source, what the box would show, the bulletin server, the Cover Sheet's list
    dispatch_queue_t q = NULL; id src = DMTNSource(&q);
    id srv = gTNServer; dispatch_queue_t sq = DMTNServerQueue(srv);
    BOOL was = gTodayNotifications; gTodayNotifications = YES;
    NSUInteger shown = DMTNRequests().count, tests = 0; for (id r in DMTNRequests()) if (DMTNIsTest(r)) tests++;
    gTodayNotifications = was;
    NSUInteger csn = 0; id ml = DMTNMasterList();
    id secs = DMCall(ml, @"notificationSections"); if ([secs isKindOfClass:[NSArray class]]) for (id l in secs) csn += [DMCall(l, @"allNotificationRequests") count];
    long axn = -1;   // (the Lock Screen grouping tweak Axon, when installed: how many requests it holds -- a count)
    { Class ac = objc_getClass("AXNManager"); SEL si = NSSelectorFromString(@"sharedInstance"); id am = (ac && [ac respondsToSelector:si]) ? ((id (*)(id, SEL))objc_msgSend)(ac, si) : nil;
      Ivar ri = am ? class_getInstanceVariable([am class], "_notificationRequests") : NULL; id d = ri ? object_getIvar(am, ri) : nil;
      if ([d isKindOfClass:[NSDictionary class]]) { axn = 0; for (id v in [(NSDictionary *)d allValues]) if ([v respondsToSelector:@selector(count)]) axn += [v count]; } }
    NSString *head = [NSString stringWithFormat:@"[tnsrc] copy %@, box would show %lu (%lu ours), Cover Sheet list %lu, Axon %ld", gTNSnap ? [NSString stringWithFormat:@"%lu", (unsigned long)gTNSnap.count] : @"none", (unsigned long)shown, (unsigned long)tests, (unsigned long)csn, axn];
    if (!src || !sq) { DMLog([head stringByAppendingFormat:@"; source %@ server %@", src ? @"yes" : @"no", srv ? @"yes" : @"no"]); return; }
    dispatch_async(q, ^{
        NSUInteger n = [((id (*)(id, SEL))objc_msgSend)(src, NSSelectorFromString(@"uuidsToRequests")) count];
        dispatch_async(sq, ^{
            Ivar bi = class_getInstanceVariable([srv class], "_bulletinsByID");
            NSUInteger b = bi ? [object_getIvar(srv, bi) count] : 0;
            DMLog([head stringByAppendingFormat:@"; source now %lu; bulletin server %lu bulletins", (unsigned long)n, (unsigned long)b]);
        });
    });
}
static void DMTNTestProbe(void) {   // (tests) which of the master list's lists hold how many requests, the flags our own test notifications carry, and how often each flag set occurs overall (counts only)
    id ml = DMTNMasterList();
    NSMutableString *m = [NSMutableString stringWithString:@"[tnprobe] lists:"];
    for (NSString *k in @[@"notificationSections", @"prominentIncomingSectionList", @"incomingSectionList", @"historySectionList", @"missedSectionList", @"persistentSectionList", @"highlightedSectionList", @"upcomingDigestSectionList", @"upcomingMissedSectionList", @"_notificationSectionListsForEnumeration"]) {
        id l = DMTNGet(ml, k);
        if ([l isKindOfClass:[NSArray class]]) { NSUInteger n = 0; for (id x in l) n += [DMCall(x, @"allNotificationRequests") count]; [m appendFormat:@" %@=[%lu lists, %lu]", k, (unsigned long)[l count], (unsigned long)n]; }
        else [m appendFormat:@" %@=%@", k, l ? [NSString stringWithFormat:@"%lu", (unsigned long)[DMCall(l, @"allNotificationRequests") count]] : @"-"];
    }
    NSCountedSet *hist = [NSCountedSet set]; NSMutableArray *others = [NSMutableArray array]; NSString *base = @""; int hidden = 0;
    id slvc = DMTNGet(DMTNGet(DMTNGet(DMCall(DMSBManager("SBCoverSheetPresentationManager"), @"coverSheetViewController"), @"mainPageContentViewController"), @"combinedListViewController"), @"structuredListViewController");
    SEL fs = NSSelectorFromString(@"notificationMasterList:shouldFilterNotificationRequest:");
    BOOL was = gTodayNotifications; gTodayNotifications = YES;
    for (id l in [DMTNGet(ml, @"notificationSections") arrayByAddingObjectsFromArray:@[]]) for (id r in DMCall(l, @"allNotificationRequests")) {
        NSString *f = DMTNFlags(r);
        if ([slvc respondsToSelector:fs]) f = [f stringByAppendingFormat:@" filtered %d", ((BOOL (*)(id, SEL, id, id))objc_msgSend)(slvc, fs, ml, r)];
        if (!DMTNShows(r, ml)) hidden++;
        if (DMTNIsTest(r)) { [m appendFormat:@"\n  test %@: %@ -> %@", DMTNStr(DMCall(r, @"content"), @"title"), f, DMTNShows(r, ml) ? @"shown" : @"held out"]; if (!base.length) base = f; }
        else [others addObject:f];
    }
    gTodayNotifications = was;
    // the owner's notifications: only how many differ from our test notification in each flag (counts, nothing else)
    NSArray *bt = [base componentsSeparatedByString:@" "];
    for (NSString *f in others) { NSArray *t = [f componentsSeparatedByString:@" "]; for (NSUInteger i = 0; i + 1 < MIN(t.count, bt.count); i += 2) if (![t[i + 1] isEqualToString:bt[i + 1]]) [hist addObject:t[i]]; }
    [m appendFormat:@"\n  held out in all: %d", hidden];
    [m appendFormat:@"\n  others: %lu; differing from the test notification in:", (unsigned long)others.count];
    for (NSString *k in hist) [m appendFormat:@" %@ x%lu", k, (unsigned long)[hist countForObject:k]];
    DMLog(m);
}
#endif
// ---- the Today View as a drop-down panel (requested: it drops from the clock like our menus; no Cover Sheet, no slide from the side) ----
// Unlocked, a clock tap BORROWS SpringBoard's own Home Screen Today View (-[SBIconController homeScreenTodayViewController]: the real, live widgets,
// nothing new is created) into a panel in our menu window, under the clock, with the menus' look and fade. Every way the panel goes (the clock again,
// a tap outside, another menu, an app opening, the Home gesture, the Lock Screen, a turn, SpringBoard wanting its Today View) gives the view back to
// exactly where it was (DMTodayGiveBack; a 1 s watchdog in DMWatchTodayView too). On the Lock Screen the Cover Sheet's own Today page is used as
// before (DMToggleTodayView): nothing there can unlock.
static UIViewController *gTodayVC = nil;           // borrowed while non-nil
static __weak UIViewController *gTodayOldParent = nil;   // the controller it was a child of (the Home Screen sidebar), while borrowed
static BOOL gTodayOldTAMIC = YES;                  // its translatesAutoresizingMaskIntoConstraints before it was borrowed
static NSArray<NSLayoutConstraint *> *gTodayOldConstraints = nil;   // the constraints that tied it into its old place (removed with it, put back with it)
// In the sidebar the Today View is placed with Auto Layout (no autoresizing mask), so in our panel it collapsed to its smallest size (8 x 0: an
// empty panel), and the constraints that held it in the sidebar are dropped by UIKit when it leaves. So: the constraints tying it to its old place
// are kept, it is sized by frame while borrowed, and both come back with it.
static void DMTodayRememberPlacement(UIView *v) {
    gTodayOldTAMIC = v.translatesAutoresizingMaskIntoConstraints;
    NSMutableArray *keep = [NSMutableArray array];
    for (UIView *a = v.superview; a; a = a.superview)
        for (NSLayoutConstraint *c in a.constraints) if (c.firstItem == v || c.secondItem == v) [keep addObject:c];
    gTodayOldConstraints = keep.count ? [keep copy] : nil;
}
static void DMTodayRestorePlacement(UIView *v) {
    @try {
        v.translatesAutoresizingMaskIntoConstraints = gTodayOldTAMIC;
        if (gTodayOldConstraints.count && v.superview) {
            NSMutableArray *ok = [NSMutableArray array];   // (only constraints whose other view is still in the same tree)
            for (NSLayoutConstraint *c in gTodayOldConstraints) {
                id other = c.firstItem == v ? c.secondItem : c.firstItem;
                UIView *ov = [other isKindOfClass:[UIView class]] ? other : ([other respondsToSelector:@selector(owningView)] ? [other owningView] : nil);
                if (!other || (ov && ov.window == v.window)) [ok addObject:c];
            }
            [NSLayoutConstraint activateConstraints:ok];
            DMLog([NSString stringWithFormat:@"[today] %lu of %lu layout constraints of its old place put back", (unsigned long)ok.count, (unsigned long)gTodayOldConstraints.count]);
        }
    } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[today] its old layout could not be put back (%@)", e.reason]); }
    gTodayOldConstraints = nil; gTodayOldTAMIC = YES;
}
// Giving it back: a child of its old parent again BEFORE its view goes back under the parent's view (so the view hierarchy and the controller
// hierarchy agree at every step), then didMoveToParentViewController: once the view is in place.
static UIViewController *DMTodayRejoinParentBegin(UIViewController *vc) {
    UIViewController *parent = gTodayOldParent;
    gTodayOldParent = nil;
    if (!parent || !vc || vc.parentViewController) return nil;
    @try { [parent addChildViewController:vc]; return parent; }
    @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[today] the Today View's controller could not rejoin %@ (%@)", NSStringFromClass([parent class]), e.reason]); }
    return nil;
}
static void DMTodayRejoinParentEnd(UIViewController *vc, UIViewController *parent) {
    if (!parent) return;
    @try { [vc didMoveToParentViewController:parent]; DMLog([NSString stringWithFormat:@"[today] the Today View's controller is a child of %@ again", NSStringFromClass([parent class])]); }
    @catch (NSException *e) {}
}
static __weak UIView *gTodayOldSuper = nil;
static NSUInteger gTodayOldIndex = 0;
static CGRect gTodayOldFrame;
static UIViewAutoresizing gTodayOldMask;
static __weak UIView *gTodayOverlay = nil, *gTodayPanel = nil;
static CGSize gTodayScreen;
static NSString *gLastFront;   // (the app in front, as the status bar shows it: defined with the 0.2 s watcher)
static NSString *gTodayFront = nil;   // the app in front when it opened (an app opening from a widget, or going home, closes the panel)
static int gTodayHeaderWas = -1;   // the Today View's big date header: hidden in our panel (the clock is right above it), given back as it was
static NSArray<UIView *> *gTodayHidden = nil;
static const void *kTodayScrollKey = &kTodayScrollKey;   // (a list we switched scrolling on for: switched back off when given back)
static __weak UIScrollView *gTodayList = nil;
static void DMTodayGiveBack(NSString *why) {
    UIViewController *vc = gTodayVC;
    if (!vc) return;
    DMTNRemove();   // (our notifications box leaves the widget column first)
    gTodayVC = nil;
    UIView *v = vc.view, *old = gTodayOldSuper;
    [vc beginAppearanceTransition:NO animated:NO];
    if (gTodayHeaderWas == 1 && [vc respondsToSelector:NSSelectorFromString(@"setHeaderVisible:")]) ((void (*)(id, SEL, BOOL))objc_msgSend)(vc, NSSelectorFromString(@"setHeaderVisible:"), YES);
    gTodayHeaderWas = -1;
    for (UIView *h in gTodayHidden) h.hidden = NO;
    UIScrollView *tl = gTodayList; if ([objc_getAssociatedObject(tl, kTodayScrollKey) boolValue]) { tl.scrollEnabled = NO; objc_setAssociatedObject(tl, kTodayScrollKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    gTodayHidden = nil;
    UIViewController *rejoined = DMTodayRejoinParentBegin(vc);
    @try {   // (SpringBoard's own view going home: a refused move must never abort SpringBoard; the view is left detached then, as with no place of its own)
        [v removeFromSuperview];
        v.autoresizingMask = gTodayOldMask;
        v.frame = gTodayOldFrame;
        if (old) [old insertSubview:v atIndex:MIN(gTodayOldIndex, old.subviews.count)];
        DMTodayRestorePlacement(v);
    } @catch (NSException *e) {
        DMLog([NSString stringWithFormat:@"[today] UIKit refused to give the Today View back (%@: %@): left detached", e.name, e.reason]);
        @try { [v removeFromSuperview]; } @catch (NSException *e2) {}
    }
    @try { [vc endAppearanceTransition]; } @catch (NSException *e3) {}
    DMTodayRejoinParentEnd(vc, rejoined);
    UIView *panel = gTodayPanel; [panel removeFromSuperview];
    DMLog([NSString stringWithFormat:@"[today] Today View given back (%@)%@", why, old ? @"" : @" (it had no place of its own)"]);
    if (DMTestFlag("/tmp/msb-today-trace")) DMLog([NSString stringWithFormat:@"[today] given back from: %@", [[[NSThread callStackSymbols] subarrayWithRange:NSMakeRange(1, MIN((NSUInteger)10, [NSThread callStackSymbols].count - 1))] componentsJoinedByString:@" | "]]);
}
// The panel keeps every touch that reaches it: a view passes touches it does not handle up to its next responder, and that is the catch-all
// UIControl behind it -- a drag in the widget list that did not scroll (iPad 2: content barely taller than the panel) ended as the catch-all's
// "tap outside" and closed the panel.
@interface DMTouchSinkView : UIView
@end
@implementation DMTouchSinkView
- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {}
- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {}
- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {}
- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {}
@end
// (and the catch-all only closes for a touch that really began outside the panel: the borrowed controller's responder chain can lead past the
// panel -- a child view controller answers to its parent, which is SpringBoard's -- so the sink alone did not catch every case on iPadOS 16)
@interface DMTodayOutsideTap : NSObject <UIGestureRecognizerDelegate>
+ (instancetype)shared;
- (void)tapped:(UIControl *)c event:(UIEvent *)e;
- (void)widgetTap:(UITapGestureRecognizer *)g;
@end
@implementation DMTodayOutsideTap
+ (instancetype)shared { static DMTodayOutsideTap *t; static dispatch_once_t once; dispatch_once(&once, ^{ t = [DMTodayOutsideTap new]; }); return t; }
- (void)tapped:(UIControl *)c event:(UIEvent *)e {
    UIView *panel = gTodayPanel;
    UITouch *t = [[e allTouches] anyObject];
    if (panel && t && CGRectContainsPoint(panel.bounds, [t locationInView:panel])) return;
    if (panel && t && t.view && [t.view isDescendantOfView:panel]) return;
    DMCloseOverlay();
}
// A tap on a widget opens its app (iOS 15/16 widgets have no buttons of their own): the panel goes like a menu after its row is picked. The app may
// already be in front (a window), so there is not always a change of front app to notice. Long presses (edit, the widget's menu) and scrolls
// are not taps.
- (void)widgetTap:(UITapGestureRecognizer *)g {
    if (g.state != UIGestureRecognizerStateEnded || !gTodayVC) return;
    UIView *v = gTodayVC.view;
    UIView *hit = [v hitTest:[g locationInView:v] withEvent:nil];
    BOOL onWidget = NO;
    for (UIView *u = hit; u && u != v; u = u.superview) if ([u isKindOfClass:[UIControl class]]) return;   // (a button: Edit, Show More... do their own thing)
    for (UIView *u = hit; u && u != v; u = u.superview) if ([NSStringFromClass([u class]) rangeOfString:@"Icon"].location != NSNotFound || [NSStringFromClass([u class]) rangeOfString:@"Widget"].location != NSNotFound) { onWidget = YES; break; }
    if (!onWidget) return;
    DMLog([NSString stringWithFormat:@"[today] widget tapped (%@): the panel goes", NSStringFromClass([hit class])]);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gTodayVC) DMCloseOverlay(); });
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b { return YES; }
@end
#if DEBUG
static NSString *DMNearestObjCMethod(uintptr_t a) {   // (debug) the Objective-C method whose code holds this address (stripped images)
    Dl_info info; if (!dladdr((void *)a, &info) || !info.dli_fname) return @"?";
    unsigned int n = 0; const char **names = objc_copyClassNamesForImage(info.dli_fname, &n);
    uintptr_t best = 0; NSString *bestName = nil;
    for (unsigned int i = 0; i < n; i++) {
        Class c = objc_getClass(names[i]); if (!c) continue;
        for (int meta = 0; meta < 2; meta++) {
            Class k = meta ? object_getClass(c) : c; unsigned int mc = 0; Method *ms = class_copyMethodList(k, &mc);
            for (unsigned int j = 0; j < mc; j++) {
                uintptr_t imp = (uintptr_t)ptrauth_strip((void *)method_getImplementation(ms[j]), ptrauth_key_function_pointer);
                if (imp <= a && imp > best) { best = imp; bestName = [NSString stringWithFormat:@"%c[%s %s]", meta ? '+' : '-', names[i], sel_getName(method_getName(ms[j]))]; }
            }
            free(ms);
        }
    }
    free(names);
    const char *img = strrchr(info.dli_fname, '/');
    return [NSString stringWithFormat:@"%s %@ +%lu", img ? img + 1 : info.dli_fname, bestName ?: @"?", (unsigned long)(a - best)];
}
static NSString *DMProbeStack(void) {
    NSMutableString *m = [NSMutableString string]; NSArray *ra = [NSThread callStackReturnAddresses];
    for (NSUInteger i = 1; i < MIN(ra.count, (NSUInteger)7); i++) [m appendFormat:@"\n  %@", DMNearestObjCMethod((uintptr_t)ptrauth_strip((void *)[ra[i] unsignedLongValue], ptrauth_key_asia))];
    return m;
}
static BOOL gTodayProbeOn = NO;
%group TodayOffsetProbe   // (debug, todayrec_: who moves the borrowed Today list by a big jump)
%hook UIScrollView
- (void)setContentOffset:(CGPoint)p {
    CGFloat was = self.contentOffset.y;
    %orig;
    if (gTodayProbeOn && self == gTodayList && (fabs(p.y - was) > 150.0 || (p.y == 0.0 && fabs(was) > 3.0))) DMLog([NSString stringWithFormat:@"[todayrec] JUMP setContentOffset %.1f -> %.1f%@", was, p.y, DMProbeStack()]);
}
- (void)setBounds:(CGRect)b {
    CGFloat was = self.bounds.origin.y;
    %orig;
    if (gTodayProbeOn && self == gTodayList && (fabs(b.origin.y - was) > 150.0 || (b.origin.y == 0.0 && fabs(was) > 3.0))) DMLog([NSString stringWithFormat:@"[todayrec] JUMP setBounds %.1f -> %.1f%@", was, b.origin.y, DMProbeStack()]);
}
%end
%end
static void DMInitTodayOffsetProbe(void) { static BOOL done = NO; if (done) return; done = YES; %init(TodayOffsetProbe); }
#endif
// The borrowed Today View's list must keep its own scroll position. SBTodayViewController, on every layout of its view
// (-viewWillLayoutSubviews -> -_updateScrollViewContentInset), puts the list back at -lastRootSideBarContentOffset (where the list was last
// left as the Home Screen's side bar) unless a setContentOffset:animated: is running. A fast flick back to the top overshoots, its bounce
// lays the view out, and the list jumped back to that saved offset (the end of the list) and ran up again: the "scroll loop" (measured with
// todayrec_: offset -23 -> 447 twice in 0.4 s). While the view is in our panel the list's offset from before that call is put back (unless
// the call really changed the list's insets, which our panel never does); the saved value and everything else are left alone (making the
// getter return the live offset instead also changed the header spacing: a 120 pt gap came and went at the top).
%group TodayKeepOffset
%hook SBTodayViewController
- (void)_updateScrollViewContentInset {
    UIScrollView *l = (gTodayVC && (id)self == (id)gTodayVC) ? gTodayList : nil;
    CGPoint before = l ? l.contentOffset : CGPointZero; UIEdgeInsets insets = l ? l.adjustedContentInset : UIEdgeInsetsZero;
    %orig;
    if (l && gTodayList == l && UIEdgeInsetsEqualToEdgeInsets(insets, l.adjustedContentInset) && fabs(l.contentOffset.y - before.y) > 0.5) {
        static int told = 0;
        if (told < 3 && DMTestFlag("/tmp/macstatusbar-debug")) { told++; DMLog([NSString stringWithFormat:@"[today] SpringBoard moved the panel's list %.1f -> %.1f on a layout: kept at %.1f", before.y, l.contentOffset.y, before.y]); }
        // (put back inside the list's valid range only: a negative offset lays the view out again, and holding one against SpringBoard's
        // restore looped layouts forever (SpringBoard hung). Also a loop breaker: a bounce lays out once a frame (8 ms at 120 Hz); more than
        // 12 put-backs within 50 ms can only be a layout loop, and SpringBoard then gets its way.)
        static CFTimeInterval winStart = 0; static int inWin = 0;
        CFTimeInterval now = CACurrentMediaTime();
        if (now - winStart > 0.05) { winStart = now; inWin = 0; }
        if (++inWin > 12) { if (inWin == 13) DMLog(@"[today] panel list: layout loop broken (SpringBoard keeps moving it)"); return; }
        // (and a loop inside ONE layout pass -- the main thread never gets back to its run loop, each round too slow for the 50 ms count: seen on
        // the M1 with a tall notifications box, SpringBoard putting the list back to its saved offset on every round, SpringBoard hung. The count
        // is reset once the main queue runs again; a bounce lays the view out once a frame, i.e. once a turn, so a third put-back before that can only be such a loop, and SpringBoard gets its way.)
        static int inTurn = 0; static BOOL turnReset = NO;
        if (!turnReset) { turnReset = YES; dispatch_async(dispatch_get_main_queue(), ^{ inTurn = 0; turnReset = NO; }); }
        if (++inTurn > 2) { if (inTurn == 3) DMLog(@"[today] panel list: layout loop inside one pass broken (SpringBoard keeps moving it)"); return; }
        // (layering audit #9: a slower ping-pong, one put-back a frame, never reaches 12 in 50 ms. Put-backs while the list is at rest -- not
        // dragged, tracked or decelerating/bouncing, i.e. nobody is scrolling it -- are counted over one second: more than 30 means SpringBoard
        // keeps moving it, so it gets its way for 2 s. A user's flick and its bounce are never counted.)
        static CFTimeInterval longStart = 0, pausedUntil = 0; static int inLong = 0;
        if (now < pausedUntil) return;
        if (!l.dragging && !l.tracking && !l.decelerating) {
            if (now - longStart > 1.0) { longStart = now; inLong = 0; }
            if (++inLong > 30) { pausedUntil = now + 2.0; inLong = 0; DMLog(@"[today] panel list: kept being moved at rest (slow layout loop): not held for 2 s"); return; }
        }
        CGFloat top = -l.adjustedContentInset.top, maxY = MAX(top, l.contentSize.height + l.adjustedContentInset.bottom - l.bounds.size.height);
        l.contentOffset = CGPointMake(before.x, MIN(MAX(before.y, top), maxY));
    }
}
%end
%end
// The date header's visibility is left alone while the Today View is in our panel (its header views are hidden there; given back, it is shown
// again as it was). SpringBoard updates it from scrolling (-_updateHeaderVisibility), and on the M1 (15.6.1, landscape) with a tall
// notifications box, from ~590 pt down every update relaid the view out, which put the list back to the side bar's saved offset (0), which
// updated the header again: a layout loop inside one pass that hung SpringBoard (measured: with the update skipped the list scrolls through
// smoothly, with it the loop broke every time).
%group TodayKeepHeader
%hook SBTodayViewController
- (void)_updateHeaderVisibility {
    if (gTodayVC && (id)self == (id)gTodayVC) return;
    %orig;
}
%end
%end
static void DMTodayKeepOffsetInit(void) {
    Class c = objc_getClass("SBTodayViewController");
    Method hm = c ? class_getInstanceMethod(c, NSSelectorFromString(@"_updateHeaderVisibility")) : NULL;
    if (hm && method_getNumberOfArguments(hm) == 2) %init(TodayKeepHeader);
    else DMLog(@"[today] -[SBTodayViewController _updateHeaderVisibility] not found here: the header is not held");
    Method m = c ? class_getInstanceMethod(c, NSSelectorFromString(@"_updateScrollViewContentInset")) : NULL;
    if (!m || method_getNumberOfArguments(m) != 2) { DMLog(@"[today] -[SBTodayViewController _updateScrollViewContentInset] not found here: the panel's list offset is not held"); return; }
    %init(TodayKeepOffset);
}
static BOOL DMOpenTodayPanel(UIButton *clockBtn) {
    id icc = DMCall(objc_getClass("SBIconController"), @"sharedInstance");   // (iPadOS 15: -homeScreenTodayViewController; 16: -todayViewController)
    UIViewController *vc = [icc respondsToSelector:NSSelectorFromString(@"homeScreenTodayViewController")] ? DMCall(icc, @"homeScreenTodayViewController") : DMCall(icc, @"todayViewController");
    if (![vc isKindOfClass:[UIViewController class]]) { DMLog(@"[today] no Home Screen Today View to borrow: the Cover Sheet way"); return NO; }
    id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
    SEL overlaySel = NSSelectorFromString(@"isTodayOverlayPresented");
    if ([ic respondsToSelector:overlaySel] && ((BOOL (*)(id, SEL))objc_msgSend)(ic, overlaySel)) { DMLog(@"[today] the Home Screen's own Today View is showing: not borrowed"); return NO; }
    UIView *v = vc.view;
    if (v.window && !v.window.hidden && DMEffectiveAlpha(v) > 0.05) { DMLog(@"[today] the Today View is on screen somewhere: not borrowed"); return NO; }
    UIView *fg = clockBtn.superview;
    UIView *host = fg ? DMHostFor(fg) : nil;
    if (!host) return NO;
    UIControl *o = DMMakeOverlay(host, 0.0);
    [o addTarget:[DMTodayOutsideTap shared] action:@selector(tapped:event:) forControlEvents:UIControlEventTouchUpInside];
    gOverlayTitle = clockBtn;   // (a menu title tapped now switches to that menu)
    CGRect anchor = DMConvertToHost(fg, clockBtn.frame, host);
    CGFloat W = 380.0, top = CGRectGetMaxY(anchor) + 2.0;
    BOOL portrait = host.bounds.size.width < host.bounds.size.height;
    CGFloat dockTop = CGRectGetMaxY(DMUsableArea());   // (the Dock's top, measured: its height differs between iPads)
    if (dockTop < top + 150.0 || dockTop > host.bounds.size.height) dockTop = host.bounds.size.height - (portrait ? 110.0 : 96.0);
    if (DMIsExtMenuHost(host)) dockTop = host.bounds.size.height - 96.0;   // (on an external display: that display's height, not the iPad's Dock)
    CGFloat maxH = MIN(dockTop - top - 10.0, host.bounds.size.height * 0.72);   // (clear of the Dock, with a margin; a bit smaller than all the room: the owner)
    CGFloat x = MIN(CGRectGetMaxX(anchor) + 4.0, host.bounds.size.width - 6.0) - W;
    if (DMBarRTL(fg)) x = MIN(anchor.origin.x - 4.0, host.bounds.size.width - 6.0 - W);   // (a right-to-left language: the clock is at the left end, the panel hangs from its left edge)
    UIView *panel = [[DMTouchSinkView alloc] initWithFrame:CGRectMake(MAX(6.0, x), top, W, maxH)];
    panel.layer.shadowColor = [[UIColor blackColor] CGColor]; panel.layer.shadowOpacity = 0.35; panel.layer.shadowRadius = 16.0; panel.layer.shadowOffset = CGSizeMake(0, 8);
    // The look of our Control Center panel: its thin dark blur with a dark tint in Dark Mode (light in Light Mode), 14 pt corners, a hairline
    // edge; the widgets' own tiles sit on it like Control Center's modules.
    UIVisualEffectView *blur = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemThinMaterial]];
    blur.layer.cornerRadius = 14.0; blur.layer.cornerCurve = kCACornerCurveContinuous; blur.clipsToBounds = YES;
    blur.layer.borderWidth = 0.5; blur.layer.borderColor = [[UIColor colorWithWhite:1.0 alpha:0.14] CGColor];
    UIView *tint = [[UIView alloc] initWithFrame:blur.bounds];
    tint.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight; tint.userInteractionEnabled = NO;
    tint.backgroundColor = [UIColor colorWithDynamicProvider:^UIColor *(UITraitCollection *tc) {
        return tc.userInterfaceStyle == UIUserInterfaceStyleDark ? [UIColor colorWithWhite:0.0 alpha:0.28] : [UIColor colorWithWhite:1.0 alpha:0.18];
    }];
    [blur.contentView addSubview:tint];
    blur.frame = panel.bounds; blur.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [panel addSubview:blur];
    [o addSubview:panel];
    // borrow
    gTodayOldSuper = v.superview; gTodayOldIndex = v.superview ? [v.superview.subviews indexOfObject:v] : 0; gTodayOldFrame = v.frame; gTodayOldMask = v.autoresizingMask;
    gTodayVC = vc; gTodayOverlay = o; gTodayPanel = panel; gTodayScreen = [UIScreen mainScreen].bounds.size;
    gTodayFront = [[DMFrontApp() bundleIdentifier] copy] ?: @"";   // (the full-screen app, or none: windows coming and going do not count)
    // UIKit refuses to move a view controller's view under a view whose controller isn't its parent when it judges the hierarchy inconsistent
    // (iPad 2, iOS 16, landscape, 26 Sep: an Objective-C exception here aborted SpringBoard -> Safe Mode). That must never take SpringBoard
    // down: if the move is refused, the Today View goes back where it was, our panel is removed, and the tap simply does nothing.
    // WHY it was refused (iPad 2, 26 Sep, reproduced): once the Home Screen's own Today View has been swiped in (from the first page), SpringBoard
    // keeps SBTodayViewController as a CHILD of its sidebar (SBHRootSidebarController > SBHomeScreenOverlayViewController > ...), and UIKit
    // throws UIViewControllerHierarchyInconsistency when a child controller's view is put under a view that does not belong to its parent. Before
    // that swipe the controller has no parent and the move is fine -- which is why it failed only sometimes. So, the way UIKit's containment asks
    // for: the controller leaves its parent while it is borrowed (willMoveToParentViewController:nil + removeFromParentViewController) and is
    // added back to the same parent, in the same place, when it is given back (DMTodayGiveBack).
    UIViewController *oldParent = vc.parentViewController;
    if (oldParent) {
        @try {
            [vc willMoveToParentViewController:nil];
            [vc removeFromParentViewController];
            gTodayOldParent = oldParent;
            DMLog([NSString stringWithFormat:@"[today] the Today View's controller is a child of %@: taken out of it while borrowed", NSStringFromClass([oldParent class])]);
        } @catch (NSException *e) {
            DMLog([NSString stringWithFormat:@"[today] the Today View's controller could not leave %@ (%@)", NSStringFromClass([oldParent class]), e.reason]);
        }
    }
    [vc beginAppearanceTransition:YES animated:NO];
    UIView *oldSuper = v.superview; NSUInteger oldIndex = oldSuper ? [oldSuper.subviews indexOfObject:v] : 0;
    CGRect oldFrame = v.frame; UIViewAutoresizing oldMask = v.autoresizingMask; CGAffineTransform oldTransform = v.transform;
    DMTodayRememberPlacement(v);
    BOOL moved = NO;
    @try {
        [v removeFromSuperview];
        v.translatesAutoresizingMaskIntoConstraints = YES;
        v.transform = CGAffineTransformIdentity;
        v.frame = blur.contentView.bounds; v.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [blur.contentView addSubview:v];
        moved = YES;
    } @catch (NSException *e) {
        DMLog([NSString stringWithFormat:@"[today] UIKit refused to move the Today View (%@: %@): put back, the panel is not opened", e.name, e.reason]);
    }
    if (!moved) {
        UIViewController *rejoined = DMTodayRejoinParentBegin(vc);
        @try {
            [v removeFromSuperview];
            v.transform = oldTransform; v.frame = oldFrame; v.autoresizingMask = oldMask;
            if (oldSuper) { if (oldIndex < oldSuper.subviews.count) [oldSuper insertSubview:v atIndex:oldIndex]; else [oldSuper addSubview:v]; }
            DMTodayRestorePlacement(v);
        } @catch (NSException *e2) { DMLog(@"[today] could not put the Today View back either: left detached"); }
        @try { [vc endAppearanceTransition]; } @catch (NSException *e3) {}
        DMTodayRejoinParentEnd(vc, rejoined);
        gTodayVC = nil; gTodayOverlay = nil; gTodayPanel = nil; gTodayOldSuper = nil;
        DMRemoveOverlayNow();   // (our overlay and its state go, as when any menu closes)
        [o removeFromSuperview];
        return YES;   // (handled: no Cover Sheet fallback, which is the Lock Screen on iPadOS 15)
    }
    [vc endAppearanceTransition];
    {   // (the render server hands a touch to the window whose layers are there; clear and blurred layers do not count: flagged, or touches on
        // the panel's clear parts went through to the windows below)
        SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
        for (UIView *u in @[panel, blur, blur.contentView, v]) if ([u.layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(u.layer, opaque, YES);
    }
    SEL isHV = NSSelectorFromString(@"isHeaderVisible"), setHV = NSSelectorFromString(@"setHeaderVisible:");
    gTodayHeaderWas = -1;
    if ([vc respondsToSelector:isHV] && [vc respondsToSelector:setHV]) {
        gTodayHeaderWas = ((BOOL (*)(id, SEL))objc_msgSend)(vc, isHV);
        if (gTodayHeaderWas) ((void (*)(id, SEL, BOOL))objc_msgSend)(vc, setHV, NO);
    }
    NSMutableArray *hid = [NSMutableArray array];   // the header views themselves (the date above the widgets), hidden while ours
    for (NSString *k in @[@"dateHeaderView", @"headerContainerView"]) {
        UIView *h = nil; @try { h = [vc valueForKey:k]; } @catch (id e) {}
        if ([h isKindOfClass:[UIView class]] && !h.hidden) { h.hidden = YES; [hid addObject:h]; }
    }
    gTodayHidden = hid;
    DMLog([NSString stringWithFormat:@"[today] header visible was %d; %lu header views hidden", gTodayHeaderWas, (unsigned long)hid.count]);
    [v layoutIfNeeded];
    // height: to the content (the widget list's scroll view), at most the room above the Dock
    UIScrollView *list = nil;
    NSMutableArray *stack = [NSMutableArray arrayWithObject:v];
    while (stack.count && !list) { UIView *u = stack.firstObject; [stack removeObjectAtIndex:0]; if ([u isKindOfClass:[UIScrollView class]] && u.bounds.size.height > 100.0) list = (UIScrollView *)u; else [stack addObjectsFromArray:u.subviews]; }
    if (list) {   // width: the widgets' own column plus a small even inset (no empty sides)
        UIView *column = nil;
        for (UIView *u in list.subviews) if (u.bounds.size.width > 100.0 && u.bounds.size.height > 100.0 && !u.hidden && (!column || u.bounds.size.width > column.bounds.size.width)) column = u;
        DMTNInstall(column);   // (the notifications box, at the top of the column: measured with it below)
        if (gTNBox) [v layoutIfNeeded];
        // The widgets' own list inside the column gives the width: the column (a stack view) can still carry the Home Screen sidebar's width
        // (467 pt, centred) until SpringBoard's next layout pass narrows it to the list's 300 pt (M1, iPadOS 15, 26 Sep: scrolled in portrait,
        // then opened in landscape -> the panel stayed 380 pt wide with empty sides). The list sits at the same place in both states.
        UIView *widgets = column;
        for (UIView *u in column.subviews) if ([u isKindOfClass:objc_getClass("SBIconListView")] && !u.hidden && u.bounds.size.width > 100.0 && u.bounds.size.width < widgets.bounds.size.width) widgets = u;
        CGFloat colW = widgets.bounds.size.width, inset = 12.0;
        if (colW > 100.0 && colW + 2.0 * inset < panel.bounds.size.width - 1.0) {
            // (the Today View keeps its own width -- its layout centres the column in it -- and is moved left inside the narrower panel, which
            // clips it: the column then sits in the panel with the inset on both sides)
            CGFloat colX = [widgets.superview convertPoint:widgets.frame.origin toView:v].x;
            CGRect pf = panel.frame; CGFloat right = CGRectGetMaxX(pf);
            pf.size.width = colW + 2.0 * inset;
            if (!DMBarRTL(fg)) pf.origin.x = MAX(6.0, right - pf.size.width);   // (it hangs from the clock: its right edge stays; right-to-left the clock is at the left end and the left edge stays)
            v.autoresizingMask = UIViewAutoresizingFlexibleHeight;
            panel.frame = pf;
            CGRect vf = v.frame; vf.origin.x = inset - colX; v.frame = vf;
        }
        // height: the column from its top (the space left for the hidden date header is skipped: the Today View is moved up inside the panel, like
        // the sideways move above) plus the inset below, at most maxH
        CGFloat colY = column ? [column.superview convertPoint:column.frame.origin toView:v].y : 0.0;
        CGFloat skip = MAX(0.0, colY - 12.0);
        CGFloat want = column ? column.bounds.size.height + 24.0 : list.contentSize.height + list.adjustedContentInset.top + list.adjustedContentInset.bottom + list.frame.origin.y;
        CGRect pf = panel.frame; pf.size.height = MIN(maxH, MAX(120.0, want)); panel.frame = pf;
        if (skip > 0.5) {
            v.autoresizingMask = UIViewAutoresizingNone;
            CGRect vf = v.frame; vf.origin.y = -skip; vf.size.height = pf.size.height + skip; v.frame = vf;
            [v layoutIfNeeded];
        }
        DMTNAttach(panel, v, maxH, skip > 0.5 ? skip : 0.0);
    }
    UITapGestureRecognizer *wt = [[UITapGestureRecognizer alloc] initWithTarget:[DMTodayOutsideTap shared] action:@selector(widgetTap:)];
    wt.cancelsTouchesInView = NO; wt.delaysTouchesEnded = NO; wt.delegate = (id)[DMTodayOutsideTap shared];
    [panel addGestureRecognizer:wt];
    panel.alpha = 0.0;
    [UIView animateWithDuration:0.10 animations:^{ panel.alpha = 1.0; }];
    DMLog([NSString stringWithFormat:@"[today] clock tapped: Today View dropped down in our panel %@ (list %@ content %.0f, scroll %d interaction %d pan %d, frame %@, bounces %d)", NSStringFromCGRect(panel.frame), NSStringFromClass([list class]), list.contentSize.height, list.scrollEnabled, list.userInteractionEnabled, list.panGestureRecognizer.enabled, NSStringFromCGRect(list.frame), list.alwaysBounceVertical]);
    gTodayList = list;
    if (list && !list.scrollEnabled) { list.scrollEnabled = YES; objc_setAssociatedObject(list, kTodayScrollKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); gTodayList = list; }
    return YES;
}
static void DMToggleTodayView(void);
static void DMToggleTodayViewFrom(UIButton *clockBtn) {
    if (gTodayVC) { DMCloseOverlay(); return; }
    id lm = DMSBManager("SBLockScreenManager");
    id mgr = DMSBManager("SBCoverSheetPresentationManager");
    BOOL csShown = [mgr respondsToSelector:NSSelectorFromString(@"isVisible")] && ((BOOL (*)(id, SEL))objc_msgSend)(mgr, NSSelectorFromString(@"isVisible"));
    if (!DMLockUp(lm) && !csShown && !DMTestFlag("/tmp/msb-today-stock")) {
        if (!clockBtn) for (UIView *fg in gCopies.allObjects) {   // (the trigger: the clock of the bar on screen)
            UIButton *b = objc_getAssociatedObject(fg, kClockButtonKey);
            if (fg.window && !fg.window.hidden && DMEffectiveAlpha(fg) > 0.5 && b && !b.hidden && b.bounds.size.width > 10.0) clockBtn = b;
        }
        if (gOverlay) DMCloseOverlay();
        if (clockBtn && DMOpenTodayPanel(clockBtn)) return;
        // iPadOS 15: bringing the Cover Sheet down from code while unlocked LOCKS the iPad, even with the "put away since the respring" flag
        // set (M1, 26 Sep: the clock tapped while the App Switcher was up, no panel could open, and the fallback below ended on the Lock Screen).
        // So when our panel can't open there, the tap does nothing. (iPadOS 16 keeps the Cover Sheet way: the flag is enough there.)
        if (![[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}]) { DMLog(@"[today] the Today panel could not open here: nothing done (on iPadOS 15 the Cover Sheet from code would lock the iPad)"); return; }
    }
    DMToggleTodayView();
}
static void DMToggleTodayView(void) {
    id mgr = DMSBManager("SBCoverSheetPresentationManager");
    SEL present = NSSelectorFromString(@"setCoverSheetPresented:animated:withCompletion:");
    if (![mgr respondsToSelector:present]) return;
    BOOL shown = [mgr respondsToSelector:NSSelectorFromString(@"isVisible")] && ((BOOL (*)(id, SEL))objc_msgSend)(mgr, NSSelectorFromString(@"isVisible"));
    id cs = DMCall(mgr, @"coverSheetViewController");
    SEL activate = NSSelectorFromString(@"activateTodayViewWithCompletion:");
    if (shown && gTodayOpenedByClock) { ((void (*)(id, SEL, BOOL, BOOL, id))objc_msgSend)(mgr, present, NO, YES, nil); DMLog(@"[today] clock tapped: Today View put away"); return; }
    if (shown) {
        // The Cover Sheet is already down and NOT ours (the Lock Screen, or the user's own pull-down): the clock only turns it between the
        // widgets and the notifications. Putting it away here would be an unlock (with no passcode, a tap on the Lock Screen clock opened the iPad).
        SEL isToday = NSSelectorFromString(@"isShowingTodayView"), deactivate = NSSelectorFromString(@"deactivateTodayViewWithCompletion:");
        BOOL today = [cs respondsToSelector:isToday] && ((BOOL (*)(id, SEL))objc_msgSend)(cs, isToday);
        SEL s = today ? deactivate : activate;
        if ([cs respondsToSelector:s]) ((void (*)(id, SEL, id))objc_msgSend)(cs, s, nil);
        DMLog([NSString stringWithFormat:@"[today] clock tapped on a Cover Sheet that was already down: %@", today ? @"back to the notifications" : @"turned to the widgets"]);
        return;
    }
    // After a respring with no passcode we skip the Lock Screen, so SpringBoard still thinks the Cover Sheet has never been put away since the
    // keybag lock; bringing it down from code then counted as LOCKING the iPad (iPadOS 16: the apps went to the background and a 25 s Lock
    // Screen sleep timer started, the screen went off). A finger pull-down sets this flag first; we do the same, only while really unlocked.
    {
        id lockMgr = DMSBManager("SBLockScreenManager");
        SEL hasSel = NSSelectorFromString(@"hasBeenDismissedSinceKeybagLock"), setSel = NSSelectorFromString(@"setHasBeenDismissedSinceKeybagLock:");
        BOOL uiLocked = DMLockUp(lockMgr);
        if (!uiLocked && [mgr respondsToSelector:hasSel] && [mgr respondsToSelector:setSel] && !((BOOL (*)(id, SEL))objc_msgSend)(mgr, hasSel)) {
            ((void (*)(id, SEL, BOOL))objc_msgSend)(mgr, setSel, YES);
            DMLog(@"[today] the Cover Sheet had not been put away since the respring: marked as put away (so it opens as Notification Center, not as a lock)");
        }
    }
    // iPadOS 15: the Today View is a page of the Cover Sheet, turned to before it comes down. iPadOS 16: it is an overlay
    // (-_isTodayViewOverlayShowing) that only comes up properly (the clock and notifications blurred away behind the widgets, like the stock
    // right swipe) when it is activated AFTER the Cover Sheet is down; activated before, the widgets were drawn sharp over the notifications
    // and the overlay never counted as showing (iPad 2 cross-test).
    BOOL overlayStyle = NO;
    if (@available(iOS 16.0, *)) overlayStyle = YES;
    if (!overlayStyle && [cs respondsToSelector:activate]) ((void (*)(id, SEL, id))objc_msgSend)(cs, activate, nil);
    gTodayOpenedByClock = YES;
    ((void (*)(id, SEL, BOOL, BOOL, id))objc_msgSend)(mgr, present, YES, YES, !overlayStyle ? nil : ^{
        id cs2 = DMCall(DMSBManager("SBCoverSheetPresentationManager"), @"coverSheetViewController");
        if (gTodayOpenedByClock && [cs2 respondsToSelector:activate]) ((void (*)(id, SEL, id))objc_msgSend)(cs2, activate, nil);
    });
    DMLog([NSString stringWithFormat:@"[today] clock tapped: Today View brought down (today page %d)", [cs respondsToSelector:activate]]);
}
static void DMWatchTodayView(void) {   // (every tick) once the Today View we opened has gone, the Cover Sheet's page is turned back
    if (gTodayVC) {   // the borrowed Today View: given back when its panel has gone or anything else takes over
        id lm = DMSBManager("SBLockScreenManager");
        UIView *o = gTodayOverlay, *panel = gTodayPanel;
        NSString *why = nil;
        if (!o || gOverlay != o || !panel.window) why = @"its panel is gone";
        else if (DMLockUp(lm)) why = @"the Lock Screen or Cover Sheet";
        else if (!CGSizeEqualToSize(gTodayScreen, [UIScreen mainScreen].bounds.size)) why = @"the screen turned";
        else if (gTodayVC.view.superview && ![gTodayVC.view isDescendantOfView:panel]) why = @"SpringBoard took it back";
        else if (![([DMFrontApp() bundleIdentifier] ?: @"") isEqualToString:gTodayFront ?: @""]) why = @"a full-screen app opened or went away";
        id im = DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager");
        BOOL editing = [im respondsToSelector:@selector(isEditing)] && ((BOOL (*)(id, SEL))objc_msgSend)(im, @selector(isEditing));
        if (!why && editing) {   // editing the widgets (Edit, or a long press's Edit Home Screen): done in SpringBoard's own Today View, where it belongs
            DMTodayGiveBack(@"widget editing");
            if (gOverlay == o && o) DMCloseOverlay();
            DMMinimizeAllWindows();   // (the windows go down to the Dock, so the Home Screen's Today View is in view)
            SEL present = NSSelectorFromString(@"presentTodayOverlayForIconManager:");
            id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
            if ([ic respondsToSelector:present]) ((void (*)(id, SEL, id))objc_msgSend)(ic, present, im);
            DMLog(@"[today] widget editing: the Home Screen's own Today View opened for it");
        }
        if (!why && !editing && gTodayVC) DMTNTick();   // (notifications that came or went while the panel is open)
        if (why) { DMTodayGiveBack(why); if (gOverlay == o && o) DMCloseOverlay(); }
    }
    if (!gTodayOpenedByClock) return;
    id mgr = DMSBManager("SBCoverSheetPresentationManager");
    if ([mgr respondsToSelector:NSSelectorFromString(@"isVisible")] && ((BOOL (*)(id, SEL))objc_msgSend)(mgr, NSSelectorFromString(@"isVisible"))) return;
    gTodayOpenedByClock = NO;
    id cs = DMCall(mgr, @"coverSheetViewController");
    SEL deactivate = NSSelectorFromString(@"deactivateTodayViewWithCompletion:");
    if ([cs respondsToSelector:deactivate]) ((void (*)(id, SEL, id))objc_msgSend)(cs, deactivate, nil);
    DMLog(@"[today] Today View gone: the Cover Sheet is back on its notifications page");
}


// Hide Multitasking Dots: only while windowing is on AND a window engine really runs (with none, the dots are the only way to Split View / Slide
// Over). The engine is decided a few seconds after the start (Aerial's crash-loop guard, engines loading after us), so "no engine" counts only
// from 12 s on; DMActiveEngine calls this again whenever its answer changes.
static BOOL gHideDotsWanted = YES, gDotsEngineSettled = NO;
static void DMDotsApply(void) {
    BOOL wasHidden = gHideMultitaskingDots;
    gHideMultitaskingDots = gHideDotsWanted && (!gDotsEngineSettled || DMActiveEngine() != DMEngineNone);
    if (wasHidden != gHideMultitaskingDots) dispatch_async(dispatch_get_main_queue(), ^{   // (switched: the dots showing now follow at once, not at the next app)
        UIView *aff = gDotsAffordance;
        if (!aff) return;
        if (!gHideMultitaskingDots) {   // (SpringBoard's own last wishes, which our hide overrode)
            NSNumber *h = objc_getAssociatedObject(aff, kDotsWantHiddenKey), *a = objc_getAssociatedObject(aff, kDotsWantAlphaKey);
            gDotsOwnChange = YES;
            aff.hidden = h ? h.boolValue : NO;
            aff.alpha = a ? a.doubleValue : 1.0;
            gDotsOwnChange = NO;
        }
        [aff setNeedsLayout]; [aff layoutIfNeeded];
    });
}
static void DMReadBlockPointerPull(void) {   // Settings > Pointer > Block Pointer Pull-Down (also read in stock mode, StockBar.h)
    BOOL blockPull = YES;   // on unless switched off in Settings
    CFPropertyListRef pullRef = CFPreferencesCopyValue(CFSTR("noTopEdgePull"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (pullRef) {
        if (CFGetTypeID(pullRef) == CFBooleanGetTypeID()) blockPull = CFBooleanGetValue(pullRef);
        CFRelease(pullRef);
    }
    gBlockPointerPull = blockPull;
}
// Strict lookup of only our own domain (CFPreferencesCopyAppValue also walks the global search list
// and once returned a stray value for a generic key on this device).
static void DMLoadPrefs(void) {
    CFPreferencesAppSynchronize(MSB_DOMAIN);
    BOOL show = NO;
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("showSeconds"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (v) {
        if (CFGetTypeID(v) == CFBooleanGetTypeID()) show = CFBooleanGetValue(v);
        CFRelease(v);
    }
    gShowSeconds = show;

    BOOL showSpot = YES;
    CFPropertyListRef spotRef = CFPreferencesCopyValue(CFSTR("showSpotlight"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (spotRef) {
        if (CFGetTypeID(spotRef) == CFBooleanGetTypeID()) showSpot = CFBooleanGetValue(spotRef);
        CFRelease(spotRef);
    }
    gShowSpotlight = showSpot;
    {   // the Dock's "Swipe Down Opens App Library" takes the swipe only while this button is shown (Dock.x): the state is this SpringBoard's pid
        // while shown, else 0 (stock mode, the line off or safe mode never reach here, so a stale pid from an earlier SpringBoard never matches)
        static int spotToken = 0;
        if (!spotToken) notify_register_check("com.besiktasliseba.macstatusbar.spotlightshown", &spotToken);
        if (spotToken) notify_set_state(spotToken, showSpot ? (uint64_t)getpid() : 0);
    }

    BOOL today = YES;
    CFPropertyListRef todayRef = CFPreferencesCopyValue(CFSTR("clockOpensToday"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (todayRef) { if (CFGetTypeID(todayRef) == CFBooleanGetTypeID()) today = CFBooleanGetValue(todayRef); CFRelease(todayRef); }
    {
        BOOL tn = YES;   // Notifications in Today View: on unless switched off
        CFPropertyListRef tnRef = CFPreferencesCopyValue(CFSTR("todayNotifications"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (tnRef) { if (CFGetTypeID(tnRef) == CFBooleanGetTypeID()) tn = CFBooleanGetValue(tnRef); CFRelease(tnRef); }
        gTodayNotifications = tn;
    }
    gClockOpensToday = today;   // (applied to the Home Screen by the tick, never from here: DMLoadPrefs also runs in %ctor, and asking
                                // SBIconController for its sharedInstance that early hung SpringBoard at start -- Phase 2b, build 155)

    DMReadBlockPointerPull();

    BOOL showButtons = YES;
    {   // Settings > Turn Off Traffic Lights (full-screen apps); an older install only has "Show Window Buttons", which stays in force until the new switch is used
        CFPropertyListRef hideRef = CFPreferencesCopyValue(CFSTR("hideTrafficLights"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (hideRef && CFGetTypeID(hideRef) == CFBooleanGetTypeID()) showButtons = !CFBooleanGetValue(hideRef);
        else {
            CFPropertyListRef buttonsRef = CFPreferencesCopyValue(CFSTR("showWindowButtons"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            if (buttonsRef) { if (CFGetTypeID(buttonsRef) == CFBooleanGetTypeID()) showButtons = CFBooleanGetValue(buttonsRef); CFRelease(buttonsRef); }
        }
        if (hideRef) CFRelease(hideRef);
    }
    gShowWindowButtons = showButtons;
    {
        BOOL hideDots = YES;
        CFPropertyListRef dotsRef = CFPreferencesCopyValue(CFSTR("hideMultitaskingDots"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (dotsRef) { if (CFGetTypeID(dotsRef) == CFBooleanGetTypeID()) hideDots = CFBooleanGetValue(dotsRef); CFRelease(dotsRef); }
        gHideDotsWanted = hideDots && DMWindowingEnabled();   // (windowing off: the dots are iPadOS's own way to multitask, so they come back)
        static BOOL settleQueued = NO;   // (the engine is decided a few seconds after the start: until then the dots stay as wanted)
        if (!settleQueued) { settleQueued = YES; dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ gDotsEngineSettled = YES; DMDotsApply(); }); }
        DMDotsApply();
    }
    {
        BOOL tidy = NO;
        CFPropertyListRef pillRef = CFPreferencesCopyValue(CFSTR("tidyKeyboardPill"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (pillRef) { if (CFGetTypeID(pillRef) == CFBooleanGetTypeID()) tidy = CFBooleanGetValue(pillRef); CFRelease(pillRef); }
        gTidyKeyboardPill = tidy;
    }
    {   // Resize Handles (Stage Manager engine): ours (default) or Stage Manager's own
        CFPropertyListRef hs = CFPreferencesCopyValue(CFSTR("resizeHandleStyle"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        gSMAppleHandles = hs && CFGetTypeID(hs) == CFStringGetTypeID() && [(__bridge NSString *)hs isEqualToString:@"stagemanager"];
        if (hs) CFRelease(hs);
        dispatch_async(dispatch_get_main_queue(), ^{ if (DMSMEngine()) DMSMRefreshBars(); });   // (Stage Manager engine only: logic test C1)
    }
    {   // Tint Resize Handles: off unless switched on (1.1.0: untinted handles for everyone who never chose tinting -- deliberately NOT
        // frozen for updates in the root helper's OldDefaults: only Settings ever writes this key, so a stored "on" is someone's own choice and stays)
        BOOL tint = NO;
        CFPropertyListRef tintRef = CFPreferencesCopyValue(CFSTR("tintResizeHandles"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (tintRef) { if (CFGetTypeID(tintRef) == CFBooleanGetTypeID()) tint = CFBooleanGetValue(tintRef); CFRelease(tintRef); }
        gTintGrips = tint;
        static int tintToken = 0; static uint64_t tintPublished = 0;   // (MacAppBridge skips its colour reports with it off)
        if (!tintToken) notify_register_check("com.besiktasliseba.appbridge.tintgrips", &tintToken);
        uint64_t want = tint ? 1 : 2;
        if (tintToken && want != tintPublished) { notify_set_state(tintToken, want); tintPublished = want; }
    }
    {   // Esc Ends Typing in Windows (on unless switched off): published for MacAppBridge in every app (apps cannot read these preferences), state 1 on / 2 off
        BOOL esc = YES;
        CFPropertyListRef escRef = CFPreferencesCopyValue(CFSTR("escEndsTyping"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (escRef) { if (CFGetTypeID(escRef) == CFBooleanGetTypeID()) esc = CFBooleanGetValue(escRef); CFRelease(escRef); }
        static int escToken = 0; static uint64_t escPublished = 0;
        if (!escToken) notify_register_check("com.besiktasliseba.appbridge.escends", &escToken);
        uint64_t want = esc ? 1 : 2;
        if (escToken && want != escPublished) { notify_set_state(escToken, want); escPublished = want; DMLog([NSString stringWithFormat:@"[prefs] Esc Ends Typing in Windows: %@", esc ? @"on" : @"off"]); }
    }
    {
        BOOL mute = YES;   // Show Mute Icon: on unless switched off
        CFPropertyListRef muteRef = CFPreferencesCopyValue(CFSTR("showMuteIcon"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (muteRef) { if (CFGetTypeID(muteRef) == CFBooleanGetTypeID()) mute = CFBooleanGetValue(muteRef); CFRelease(muteRef); }
        gShowMuteIcon = mute;
    }
    {   // Wi-Fi Menu: on unless switched off, where this iPad has what it needs (DMWiFiSupported; DMWiFiApplyPref: iPadOS 15/16 only, and only once
        // iOS's Wi-Fi item could be left out)
        BOOL wifi = YES;
        CFPropertyListRef wifiRef = CFPreferencesCopyValue(CFSTR("wifiMenu"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (wifiRef) { if (CFGetTypeID(wifiRef) == CFBooleanGetTypeID()) wifi = CFBooleanGetValue(wifiRef); CFRelease(wifiRef); }
        DMWiFiApplyPref(wifi && (gSBItemHooks & 16) && DMWiFiSupported());
    }
    {
        CGFloat scale = 0.82;
        CFPropertyListRef ccRef = CFPreferencesCopyValue(CFSTR("controlCenterScale"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (ccRef) { double d = 0; if (CFGetTypeID(ccRef) == CFNumberGetTypeID() && CFNumberGetValue(ccRef, kCFNumberDoubleType, &d)) scale = d; CFRelease(ccRef); }
        gCCScale = MIN(1.0, MAX(0.5, scale));
    }
    {   // "Mix Audio Between Apps": published as notification state for the MixAudio tweak in every app (1 = mixing off; an app that never heard of it sees 0 = on)
        BOOL mix = YES;
        CFPropertyListRef mixRef = CFPreferencesCopyValue(CFSTR("mixAudio"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (mixRef) { if (CFGetTypeID(mixRef) == CFBooleanGetTypeID()) mix = CFBooleanGetValue(mixRef); CFRelease(mixRef); }
        static int mixToken = 0;
        if (!mixToken) notify_register_check("com.besiktasliseba.mixaudio.disabled", &mixToken);
        uint64_t before = 0;
        if (mixToken) notify_get_state(mixToken, &before);
        if (mixToken && before != (mix ? 0 : 1)) { notify_set_state(mixToken, mix ? 0 : 1); notify_post("com.besiktasliseba.mixaudio.disabled"); }
    }
    {   // "Use Stock Status Bar" switched while this (full) run goes on: takes effect after a respring, but the engines get their settings back now
        BOOL was = gStockStored;
        gStockStored = DMStockBarSwitch();
        if (was != gStockStored) DMStockPendingChanged();
    }
    BOOL styleMW = YES;   // (the windows always have the same button look, a darker title bar and no app name: "Style Windows" is not a choice any more)
    gStyleMilkyWay = styleMW;
    CFPropertyListRef engineRef = CFPreferencesCopyValue(CFSTR("windowEngine"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    NSString *engineText = engineRef ? CFBridgingRelease(engineRef) : nil;
    gEnginePref = [engineText isKindOfClass:[NSString class]] ? engineText : nil;
    if ([gEnginePref isEqualToString:@"milkyway"] && [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}]) gEnginePref = nil;   // (MilkyWay4 does not run on iOS 16: whatever is installed)
    {   // "Open Apps as Windows" starts unticked on a fresh install (a person turns it on once they are ready, rather than every icon tap already
        // opening a window from the first respring). Only touched once, ever, and only if truly untouched (Aerial or MilkyWay already has a real
        // value here, on an existing setup, and this leaves it alone).
        CFPropertyListRef doneRef = CFPreferencesCopyValue(CFSTR("windowedLaunchInitialized"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (!doneRef) {
            Boolean aerialValid = false, milkywayValid = false;
            CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
            CFPreferencesGetAppBooleanValue(CFSTR("AerialEnabled"), CFSTR("com.uzra.aerial"), &aerialValid);
            CFPropertyListRef mwRef = CFPreferencesCopyValue(CFSTR("openAsWindows"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            milkywayValid = mwRef != NULL; if (mwRef) CFRelease(mwRef);
            // (Aerial's own domain is written only while Aerial is installed, so nothing of Aerial's is left on a device that never had it; until it
            // is installed, this first-run step stays pending and runs again at the next start)
            BOOL aerialHere = access("/var/jb/usr/lib/TweakInject/Aerial.dylib", F_OK) == 0 || access("/var/jb/usr/lib/TweakInject/Aerial.disabled", F_OK) == 0;
            if (!aerialValid && aerialHere) { CFPreferencesSetAppValue(CFSTR("AerialEnabled"), kCFBooleanFalse, CFSTR("com.uzra.aerial")); CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial")); }
            if (!milkywayValid) { CFPreferencesSetValue(CFSTR("openAsWindows"), kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost); }
            if (aerialValid || aerialHere) {
                CFPreferencesSetValue(CFSTR("windowedLaunchInitialized"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
                DMLog([NSString stringWithFormat:@"[prefs] first run: Open Apps as Windows set to off (Aerial already had a value: %d, MilkyWay already had a value: %d)", aerialValid, milkywayValid]);
            }
        }
        if (doneRef) CFRelease(doneRef);
    }
    BOOL flex = YES;
    CFPropertyListRef flexRef = CFPreferencesCopyValue(CFSTR("flexResizeWindows"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (flexRef) {
        if (CFGetTypeID(flexRef) == CFBooleanGetTypeID()) flex = CFBooleanGetValue(flexRef);
        CFRelease(flexRef);
    }
    gFlexResize = flex;
    BOOL behind = YES;
    CFPropertyListRef behindRef = CFPreferencesCopyValue(CFSTR("windowsBehindApps"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (behindRef) {
        if (CFGetTypeID(behindRef) == CFBooleanGetTypeID()) behind = CFBooleanGetValue(behindRef);
        CFRelease(behindRef);
    }
    gWindowsBehindApps = behind;

    CFPropertyListRef modeRef = CFPreferencesCopyValue(CFSTR("backgroundMode"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    NSString *modeText = modeRef ? CFBridgingRelease(modeRef) : nil;
    gBgMode = [modeText isEqual:@"on"] ? DMBackgroundOn : ([modeText isEqual:@"off"] ? DMBackgroundOff : DMBackgroundAuto);
    CFPropertyListRef colorRef = CFPreferencesCopyValue(CFSTR("backgroundColor"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    NSString *colorText = colorRef ? CFBridgingRelease(colorRef) : nil;
    gBgColor = ([colorText isKindOfClass:[NSString class]] ? DMParseHexColor(colorText) : nil) ?: DMParseHexColor(@"#242225");
    CFPropertyListRef opacityRef = CFPreferencesCopyValue(CFSTR("backgroundOpacity"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    id opacityValue = opacityRef ? CFBridgingRelease(opacityRef) : nil;
    gBgOpacity = [opacityValue isKindOfClass:[NSNumber class]] ? MIN(1.0, MAX(0.0, [opacityValue doubleValue])) : 0.70;
    DMLog([NSString stringWithFormat:@"[prefs] blockPointerPull=%d showSeconds=%d spotlight=%d background=%@ color=%@ opacity=%.2f", gBlockPointerPull, show, showSpot,
           gBgMode == DMBackgroundOn ? @"on" : (gBgMode == DMBackgroundOff ? @"off" : @"auto"), colorText ?: @"(default)", gBgOpacity]);

    // The picker in Settings (AltList) stores the choice as an ARRAY of bundle ids. First run: pre-tick the apps the
    // Go menu has always shown, so the picker matches the menu. An older build saved a dictionary, which crashes the
    // picker, so convert that to an array too.
    NSArray *original = kDMGoAppsSeed;   // (new installs: Calendar, Terminal, Maps, Reynard; an update keeps its list, see sshtoggled --freeze-defaults)
    CFPropertyListRef goApps = CFPreferencesCopyValue(CFSTR("goApps"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    id current = goApps ? CFBridgingRelease(goApps) : nil;
    if (!current) {
        CFPreferencesSetValue(CFSTR("goApps"), (__bridge CFPropertyListRef)original, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSetValue(CFSTR("goAppsOrdered"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);   // (the seed is in order)
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        DMLog(@"[prefs] seeded goApps (array) with the default apps");
    } else if ([current isKindOfClass:[NSDictionary class]]) {
        NSMutableArray *ids = [NSMutableArray array];
        for (NSString *bid in current) if ([current[bid] boolValue]) [ids addObject:bid];
        CFPreferencesSetValue(CFSTR("goApps"), (__bridge CFPropertyListRef)ids, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        DMLog(@"[prefs] converted goApps from a dictionary to an array");
    }
}

static void DMPrefsChanged(CFNotificationCenterRef c, void *o, CFNotificationName n, const void *obj, CFDictionaryRef info) {
    DMInvalidateFitCache();
    DMInvalidateEngineCache();
    dispatch_async(dispatch_get_main_queue(), ^{ DMAutoHideRefreshTimerIfStarted(); });
    DMLoadPrefs();
    for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];   // show the new format right away
}

// The time in the user's own 12/24 hour style, with seconds unless turned off ("6:09:35 PM" or "6:09 PM").
static NSString *DMTimeString(void) {
    static NSDateFormatter *formatter = nil;
    static NSString *format = nil;
    // (perf: working the format out from the template is the slow part; it is done again only when the seconds setting changes or the region /
    // 12-24 hour setting does -- 1.3.3, audit L-8: that took up to a minute before -- and once a minute as a backstop)
    static NSString *want = nil; static BOOL wantSeconds = NO; static CFTimeInterval wantAt = -100; static unsigned wantGen = 0;
    if (!want || wantSeconds != gShowSeconds || wantGen != gDMLocaleGen || CACurrentMediaTime() - wantAt > 60.0) {
        wantGen = gDMLocaleGen;
        want = [NSDateFormatter dateFormatFromTemplate:(gShowSeconds ? @"jmmss" : @"jmm") options:0 locale:[NSLocale autoupdatingCurrentLocale]];
        wantSeconds = gShowSeconds; wantAt = CACurrentMediaTime();
    }
    if (!formatter || ![want isEqualToString:format]) {
        formatter = [NSDateFormatter new];
        formatter.locale = [NSLocale autoupdatingCurrentLocale];
        formatter.dateFormat = want;
        format = want;
    }
    return [formatter stringFromDate:[NSDate date]];
}


// Same font, but with fixed-width (tabular) digits so the seconds ticking over never changes the
// clock's width (the status bar's font has proportional digits, which made the date jitter).
static UIFont *DMTabularFont(UIFont *base) {
    UIFontDescriptor *d = [base.fontDescriptor fontDescriptorByAddingAttributes:@{
        UIFontDescriptorFeatureSettingsAttribute: @[ @{
            UIFontFeatureTypeIdentifierKey: @6,        // kNumberSpacingType
            UIFontFeatureSelectorIdentifierKey: @0,    // kMonospacedNumbersSelector
        } ],
    }];
    return [UIFont fontWithDescriptor:d size:base.pointSize];
}

static BOOL gApplyingClockTransform = NO;   // true while our own code writes a clock label's transform

// Moves a label sideways so its left edge lands on targetLeft (fg coordinates). Centre and
// bounds ignore transforms, so they give the label's laid-out position however it is shifted.
static void DMShiftLabel(UIView *fg, UIView *label, CGFloat targetLeft) {
    if (!label) return;
    CGPoint c = [label.superview convertPoint:label.center toView:fg];
    CGFloat tx = targetLeft - (c.x - label.bounds.size.width / 2.0);
    objc_setAssociatedObject(label, kClockShiftKey, @(tx), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    gApplyingClockTransform = YES;
    label.transform = CGAffineTransformMakeTranslation(tx, 0);
    gApplyingClockTransform = NO;
}

static BOOL DMLabelShown(UIView *v) { return v && !v.hidden && v.alpha > 0.01 && v.bounds.size.width > 0; }

// Is this string view the clock's date label (the second string in the leading region)?
static BOOL DMIsDateLabel(UIView *v) {
    UIView *container = v.superview;
    UIView *fg = container.superview;
    if (!fg || !objc_getAssociatedObject(fg, kLogoKey)) return NO;
    return v == DMDateStringView(container);
}

// Is this string view the clock's time label in one of our status bar copies?
// ---- the time on the Lock Screen / Cover Sheet ----
// There the stock status bar drops its whole time-and-date group (the big clock shows the time), which left the date we draw with an empty space
// beside it. The time is then drawn by us in the same place, font and colour as it was, updated every second (2026-09-24).
static const void *kTimeProxyKey = &kTimeProxyKey, *kTimeSlotKey = &kTimeSlotKey, *kTimeSlotFontKey = &kTimeSlotFontKey;
static NSHashTable<UILabel *> *gTimeProxies;
static NSString *DMTimeString(void);
static void DMShowTimeProxy(UIView *fg, BOOL show) {
    UILabel *tp = objc_getAssociatedObject(fg, kTimeProxyKey);
    NSValue *slot = objc_getAssociatedObject(fg, kTimeSlotKey);
    UILabel *dateProxy = objc_getAssociatedObject(fg, kDateProxyKey);
    if (!show || !slot || !dateProxy || dateProxy.hidden) { tp.hidden = YES; return; }
    if (!tp) {
        tp = [UILabel new];
        tp.userInteractionEnabled = NO;
        tp.textAlignment = NSTextAlignmentRight;
        [fg addSubview:tp];
        objc_setAssociatedObject(fg, kTimeProxyKey, tp, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!gTimeProxies) {
            gTimeProxies = [NSHashTable weakObjectsHashTable];
            NSTimer *t = [NSTimer timerWithTimeInterval:1.0 repeats:YES block:^(NSTimer *timer) {
                NSString *now = DMTimeString();
                for (UILabel *l in gTimeProxies.allObjects) {
                    if (l.hidden) continue;
                    if (![l.text isEqualToString:now]) l.text = now;
                    UILabel *dp = l.superview ? objc_getAssociatedObject(l.superview, kDateProxyKey) : nil;   // (two bars: only the one drawing the clock)
                    if (dp && l.alpha != dp.alpha) l.alpha = dp.alpha;
                }
            }];
            [[NSRunLoop mainRunLoop] addTimer:t forMode:NSRunLoopCommonModes];
        }
        [gTimeProxies addObject:tp];
    }
    CGRect r = slot.CGRectValue;
    tp.font = objc_getAssociatedObject(fg, kTimeSlotFontKey) ?: dateProxy.font;
    tp.textColor = dateProxy.textColor;
    tp.alpha = dateProxy.alpha;
    tp.text = DMTimeString();
    CGFloat w = MAX(r.size.width, ceil([tp sizeThatFits:CGSizeMake(CGFLOAT_MAX, CGFLOAT_MAX)].width));
    tp.frame = CGRectMake(CGRectGetMaxX(r) - w, r.origin.y, w, r.size.height);
    tp.hidden = NO;
    [fg bringSubviewToFront:tp];
}
// ---- Mute icon (Settings > Status Bar > Audio > Show Mute Icon, on by default) ----
// While the ringer is muted (Silent Mode: Control Center's bell, our Tab key, anything else going through SpringBoard's ringer control) a bell with a
// slash shows just left of the status icons, drawn like our SSH/VPN icons (same symbol size, weight and colour as the time). iPadOS 15/16's status
// bar has no silent-mode item of its own (only Focus/quiet mode), so the icon is ours. Event-driven: -[SBRingerControl setRingerMuted:] re-lays out
// the status bars when the state changes; each layout also reads the ringer control's own answer, so nothing can leave it stale. No polling.
// Single Mute (82Flex) installed and switched on: it shows its own icon, so ours steps aside (OtherTweaks.h).
static id gRingerControl = nil;   // SBRingerControl (SpringBoard keeps exactly one for its whole life)
static BOOL DMMuteIconWanted(void) { return gShowMuteIcon && gRingerMuted && !MSBDOtherTweakDoing(kMSBDDupMuteIcon, YES); }
static void DMRingerChanged(BOOL muted, NSString *why) {
    if (![NSThread isMainThread]) { dispatch_async(dispatch_get_main_queue(), ^{ DMRingerChanged(muted, why); }); return; }   // (views: main thread only)
    if (muted == gRingerMuted) return;
    gRingerMuted = muted;
    DMLog([NSString stringWithFormat:@"[mute] ringer %@ (%@): mute icon %@", muted ? @"muted" : @"unmuted", why, DMMuteIconWanted() ? @"shown" : @"hidden"]);
    for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];
}
static void DMReadRingerState(void) {   // (from each status bar layout: one getter call; nothing at all while switched off)
    if (!gShowMuteIcon) return;
    if (!gRingerControl) {
        id app = [UIApplication sharedApplication];
        SEL rc = NSSelectorFromString(@"ringerControl");
        if ([app respondsToSelector:rc]) gRingerControl = ((id (*)(id, SEL))objc_msgSend)(app, rc);
    }
    SEL get = NSSelectorFromString(@"isRingerMuted");
    if ([gRingerControl respondsToSelector:get]) DMRingerChanged(((BOOL (*)(id, SEL))objc_msgSend)(gRingerControl, get), @"read");
}
static UIImageView *DMMuteIcon(UIView *fg, CGFloat pointSize) {
    UIImageView *icon = objc_getAssociatedObject(fg, kMuteIconKey);
    if (!icon) {
        icon = [UIImageView new];
        icon.contentMode = UIViewContentModeScaleAspectFit;
        icon.userInteractionEnabled = NO;   // (only a sign, like Apple's own status icons)
        icon.hidden = YES;
        [fg addSubview:icon];
        objc_setAssociatedObject(fg, kMuteIconKey, icon, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (!icon.image && pointSize > 1.0) {
        UIImageSymbolConfiguration *cfg = [UIImageSymbolConfiguration configurationWithPointSize:pointSize + 0.5 weight:UIImageSymbolWeightSemibold];
        UIImage *g = [UIImage systemImageNamed:@"bell.slash.fill" withConfiguration:cfg] ?: [UIImage systemImageNamed:@"bell.slash" withConfiguration:cfg];
        icon.image = [g imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
    }
    return icon;
}
// The colour the status icons are drawn in, for a status bar copy that has no time label to take it from (the Lock Screen's).
static UIColor *DMTrailingIconColor(UIView *trailing) {
    NSMutableArray *pending = [NSMutableArray arrayWithObject:trailing];
    while (pending.count) {
        UIView *v = pending.firstObject; [pending removeObjectAtIndex:0];
        if (v != trailing && !v.hidden && v.alpha > 0.05) {
            if ([v isKindOfClass:[UILabel class]]) return ((UILabel *)v).textColor;
            if ([v isKindOfClass:[UIImageView class]] && ((UIImageView *)v).image.renderingMode != UIImageRenderingModeAlwaysOriginal) return v.tintColor;
        }
        [pending addObjectsFromArray:v.subviews];
    }
    return gStatusTextColor;
}

%hook SBRingerControl
- (void)setRingerMuted:(BOOL)muted {
    %orig;
    if (!gRingerControl) gRingerControl = self;
    if (gShowMuteIcon) DMRingerChanged(muted, @"set");   // (switched off: left alone; the next layout reads the state again once it is on)
}
%end
// iPadOS 18 name (18.2 SpringBoard): -setRingerMuted:withFeedback:reason:clientType:. Installed only where it exists (DMRinger18Init).
%group Ringer18
%hook SBRingerControl
- (void)setRingerMuted:(BOOL)muted withFeedback:(BOOL)feedback reason:(id)reason clientType:(unsigned long long)clientType {
    %orig;
    if (!gRingerControl) gRingerControl = self;
    if (gShowMuteIcon) DMRingerChanged(muted, @"set");
}
%end
%end
static void DMRinger18Init(void) {
    static BOOL done = NO; if (done) return; done = YES;
    if ([objc_getClass("SBRingerControl") instancesRespondToSelector:NSSelectorFromString(@"setRingerMuted:withFeedback:reason:clientType:")]) %init(Ringer18);
}

// ---- the time on the Lock Screen / Cover Sheet (continued) ----
// On the Lock Screen and the Cover Sheet the stock status bar drops its whole time-and-date group (the big clock over the wallpaper shows them).
// Requirement: that is fine, but no empty slot may be left where they were -- our date is hidden too, and the status icons (with the Spotlight icon at
// their right) close up to the right edge, with the same spacing as elsewhere. Going back (unlocking) the icons slide back left as the clock returns.
// (The earlier time stand-in, DMShowTimeProxy, is no longer shown: it needed the time's place seen before in the same status bar copy, and the
// Lock Screen's copy had never had one, so on the M1 it never appeared.)
// Returns whether it laid the copy out (a copy with no status icons region is left alone). (x in leading coordinates, DMBarRTL: in a right-to-left
// language the icons close up to the left edge, ours on their right.)
static BOOL DMLayoutWithoutClock(UIView *fg) {
    DMShowTimeProxy(fg, NO);
    ((UIView *)objc_getAssociatedObject(fg, kDateProxyKey)).hidden = YES;
    ((UIView *)objc_getAssociatedObject(fg, kClockButtonKey)).hidden = YES;
    UIView *trailing = DMTrailingContainer(fg);
    if (!trailing) return NO;
    BOOL rtl = DMBarRTL(fg);
    UIImageView *spotIcon = objc_getAssociatedObject(fg, kSpotIconKey);
    UIButton *spotBtn = objc_getAssociatedObject(fg, kSpotButtonKey);
    CGFloat shift = 0.0;
    // Requirement (2026-09-25): a locked iPad shows only passive icons -- the Spotlight icon goes too (a tap on it opened Spotlight over the Lock Screen),
    // and the status icons close up to the right edge in its place. It comes back (fading in) with the clock after unlocking.
    if (spotIcon && !spotIcon.hidden) { spotIcon.hidden = YES; spotBtn.hidden = YES; objc_setAssociatedObject(fg, kSpotLockHidKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    UIView *prevTrail = objc_getAssociatedObject(fg, kTrailShiftKey);
    if (prevTrail && prevTrail != trailing) prevTrail.transform = CGAffineTransformIdentity;
    objc_setAssociatedObject(fg, kTrailShiftKey, trailing, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    // the VPN, mute and SSH icons (ours) go just left of the status icons, as elsewhere
    __block CGFloat left = CGFLOAT_MAX;
    for (UIView *sub in trailing.subviews) {
        if (sub.hidden || sub.alpha < 0.05 || sub.bounds.size.width < 1.0) continue;
        left = MIN(left, DMBarLead(fg, rtl, CGRectOffset([trailing convertRect:sub.frame toView:fg], -trailing.transform.tx, 0)) + shift);   // (where it is with the shift below)
    }
    // our own icons (VPN, then later SSH) keep their size and height and only move along to close up; the VPN icon sits nearest the status icons
    void (^closeUp)(const void *, const void *) = ^(const void *iconKey, const void *btnKey) {
        UIView *icon = objc_getAssociatedObject(fg, iconKey), *btn = objc_getAssociatedObject(fg, btnKey);
        if (left == CGFLOAT_MAX || !icon || icon.hidden) return;
        CGRect f = DMBarRect(fg, rtl, icon.frame); left -= 8.0 + f.size.width; f.origin.x = left; icon.frame = DMBarRect(fg, rtl, f);
        CGRect b = DMBarRect(fg, rtl, btn.frame); b.origin.x = left - 6.0; btn.frame = DMBarRect(fg, rtl, b);
    };
    DMWiFiRefreshIcon(fg, DMTrailingIconColor(trailing));
    closeUp(kWiFiIconKey, kWiFiButtonKey);   // (the Wi-Fi icon nearest the status icons, as elsewhere)
    closeUp(kVPNIconKey, kVPNButtonKey);
    {   // the mute icon (ours) after the VPN icon, as elsewhere (DMMuteIconWanted)
        DMReadRingerState();
        UIImageView *muteIcon = DMMuteIcon(fg, 12.0);   // (12 pt: the status bar's time size, for a copy that never had a time label)
        BOOL show = DMMuteIconWanted() && left < CGFLOAT_MAX && muteIcon.image;
        muteIcon.hidden = !show;
        if (show) {
            UIColor *tint = DMTrailingIconColor(trailing);
            if (tint) muteIcon.tintColor = tint;
            CGFloat w = ceil(muteIcon.image.size.width), h = ceil(muteIcon.image.size.height);
            left -= 8.0 + w;
            CGFloat midY = [trailing convertPoint:CGPointMake(0, CGRectGetMidY(trailing.bounds)) toView:fg].y;
            muteIcon.frame = DMBarRect(fg, rtl, CGRectMake(left, round(midY - h / 2.0), w, h));
            [fg bringSubviewToFront:muteIcon];
        }
    }
    closeUp(kSSHIconKey, kSSHButtonKey);
    if (fabs(DMBarShiftOf(rtl, trailing.transform) - shift) < 0.5) return YES;
    BOOL onScreen = fg.window && !fg.window.hidden;
    void (^apply)(void) = ^{ trailing.transform = DMBarShift(rtl, shift); };
    if (onScreen) [UIView animateWithDuration:0.25 delay:0 options:UIViewAnimationOptionBeginFromCurrentState animations:apply completion:nil]; else apply();
    return YES;
}
static BOOL DMIsTimeLabel(UIView *v) {
    UIView *container = v.superview;
    UIView *fg = container.superview;
    if (!fg || !objc_getAssociatedObject(fg, kLogoKey)) return NO;
    return v == DMFirstStringView(container) && container == DMLeadingContainer(fg);
}

// ---- no flash of the stock status bar ----
// A status bar copy is kept invisible from the moment it enters a window until our layout has been applied to it, so the stock bar never
// shows (after a respring the copy could otherwise sit there for seconds until a retry found it). A safety release makes sure a copy
// our layout cannot handle is never left invisible.
static void DMHoldSafetyCheck(UIView *fg, int checks);
static const void *kHoldGaveUpKey = &kHoldGaveUpKey;      // (the safety release let this copy go: never held again, see DMHoldSafetyCheck)
static const void *kNoClockLayoutKey = &kNoClockLayoutKey;  // (our Lock Screen layout -- no clock, the icons closed up -- is on this copy)
// While a copy is held, the opacity iOS asks for is remembered and given back on release, so the hold only delays iOS's choice and never overrides
// it (1.3.3: with plain Stage Manager and Windowing off, iPadOS hides SpringBoard's bar while a window fills the screen and the app's own bar in the
// window becomes the top bar; a release that always set 1.0 could show a bar iOS had hidden, or keep one invisible).
static const void *kHoldWantAlphaKey = &kHoldWantAlphaKey;
static BOOL gDMHoldOwnAlpha = NO;   // (our own setAlpha: of the hold itself -- not iOS's wish)
static void DMHoldStatusBarCopy(UIView *fg) {
    if (objc_getAssociatedObject(fg, kLogoKey) || objc_getAssociatedObject(fg, kHoldKey) || objc_getAssociatedObject(fg, kHoldGaveUpKey)) return;   // already ours, already held, or given up on
    // (iOS's choice when the hold starts -- unless the copy is a Stage Manager window card's, whose opacity is ours: setAlpha: below; then iOS's
    //  last word is not known and 1.0 is kept, as before)
    BOOL oursNow = DMSMEngine() && [NSStringFromClass([fg.window class]) isEqualToString:@"SBMainSwitcherWindow"] && !DMSMInFullScreenCard(fg);
    objc_setAssociatedObject(fg, kHoldWantAlphaKey, @(oursNow ? 1.0 : fg.alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(fg, kHoldKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    gDMHoldOwnAlpha = YES; fg.alpha = 0.0; gDMHoldOwnAlpha = NO;
    DMHoldSafetyCheck(fg, 0);
}
// iOS has filled this copy with its text items (the time, the date, the battery percentage), whichever region they are in and whatever our layout
// makes of them. (Not our own clock lookup: before 1.3.3 the check used the same lookup that had failed -- with a right-to-left language it found
// no clock and kept each new copy invisible for 30 s.)
static BOOL DMCopyHasStockText(UIView *fg) {
    Class stringView = DMSBClass("_UIStatusBarStringView");
    for (UIView *region in fg.subviews) {
        if (![NSStringFromClass([region class]) isEqualToString:@"UIView"]) continue;
        for (UIView *s in region.subviews) if ([s isKindOfClass:stringView] && s.bounds.size.width > 0.5) return YES;
    }
    return NO;
}
// An empty copy (SpringBoard fills the real bar seconds after launch) has nothing to flash, so it is simply kept hidden. Only when the
// stock items exist but our layout still cannot attach (or after a long time) is the copy released, so it can never stay invisible; such a copy
// is then left to iOS for good (each app opening or closing moves a copy to another window: holding it again there hid the bar each time).
static void DMHoldSafetyCheck(UIView *fg, int checks) {
    __weak UIView *weakFg = fg;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *v = weakFg;
        if (!v || ![objc_getAssociatedObject(v, kHoldKey) boolValue]) return;
        BOOL hasItems = DMCopyHasStockText(v);
        if ((hasItems && checks >= 1) || checks >= 30) {
            DMLog([NSString stringWithFormat:@"[hold] safety release: a status bar copy was not attached (%@); left to iOS from now on", hasItems ? @"its items exist but the layout would not attach" : @"still empty after 30 s"]);
            DMSBDiagStep(@"z-hold-gave-up");
            objc_setAssociatedObject(v, kHoldGaveUpKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMReleaseStatusBarCopy(v);
        } else DMHoldSafetyCheck(v, checks + 1);
    });
}
static void DMReleaseStatusBarCopy(UIView *fg) {
    if (![objc_getAssociatedObject(fg, kHoldKey) boolValue]) return;
    NSNumber *want = objc_getAssociatedObject(fg, kHoldWantAlphaKey);
    objc_setAssociatedObject(fg, kHoldKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(fg, kHoldWantAlphaKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    fg.alpha = want ? want.doubleValue : 1.0;   // (the opacity iOS last asked for while it was held)
    if (want && want.doubleValue < 0.99) DMLog([NSString stringWithFormat:@"[hold] released at the opacity iOS asked for: %.2f (%@)", want.doubleValue, NSStringFromClass([fg.window class])]);
    {   // (now ours: iOS's items are asked again, after this layout pass -- the VPN badge, the activity spinner and the background-activity pill
        //  that were already showing; a copy made during a FaceTime call kept the full capsule, logic test 1.2.3)
        __weak UIView *weakFg = fg;
        dispatch_async(dispatch_get_main_queue(), ^{ if (weakFg) DMStockVPNRecheck(weakFg); });
    }
}

// iOS's own VPN badge sits inside the status icons group, which opens Control Center. In our bars (every copy the Mac look lays out) it is left
// out, and our VPN icon is its own item next to the group instead. The stock item is asked whether its badge may show; for our copies
// the answer is no, so the group closes up with no gap. A copy becomes ours at its first layout (kHoldKey at once, kLogoKey after): the items are
// asked again then (DMStockVPNRecheck). Control Center's own status bar and the stock-bar mode keep iOS's badge. Kill switch /tmp/msb-stockvpn.
static BOOL DMHideStockVPN(id item) {
    UIView *fg = DMCall(DMCall(item, @"statusBar"), @"foregroundView");
    if (![fg isKindOfClass:[UIView class]] || DMTestFlag("/tmp/msb-stockvpn")) return NO;
    // (only while our own VPN icon is there to replace it: a VPN we do not see -- an IKEv2 / L2TP one from Settings or a profile, another app's
    // personal VPN -- keeps iOS's badge, the only sign of it; DMRefreshVPNState asks again when our icon comes)
    if (!gVPNActive) return NO;
    return objc_getAssociatedObject(fg, kLogoKey) || [objc_getAssociatedObject(fg, kHoldKey) boolValue];
}
// iOS's activity spinner (network / sync activity) in OUR menu bar (the background-activity pill below is made compact instead): a Mac menu bar has none, and
// coming and going between Control Center and the
// mute icon it pushed the icons beside it back and forth (iPad 2, 1 Oct). Kept off only on a bar that is ours (dressed, or being set up), like the
// VPN badge above; Apple's own bar (Stock style, Lock Screen) keeps it.
static BOOL DMHideStockActivity(id item) {
    UIView *fg = DMCall(DMCall(item, @"statusBar"), @"foregroundView");
    if (![fg isKindOfClass:[UIView class]] || DMTestFlag("/tmp/msb-stockactivity")) return NO;
    return objc_getAssociatedObject(fg, kLogoKey) || [objc_getAssociatedObject(fg, kHoldKey) boolValue];
}
// iOS's own Wi-Fi item, while the Wi-Fi Menu switch is on: left out of our bars the same way (our Wi-Fi icon replaces it; Control Center's own
// bar and the stock-bar mode keep it). _UIStatusBarWifiItem does not answer -canEnableDisplayItem:fromData: itself (its superclass does), so the
// method is added to it, calling the superclass's own. Kill switch /tmp/msb-stockwifi.
static BOOL DMHideStockWiFi(id item) {
    if (!gWiFiMenuOn) return NO;
    UIView *fg = DMCall(DMCall(item, @"statusBar"), @"foregroundView");
    if (![fg isKindOfClass:[UIView class]] || DMTestFlag("/tmp/msb-stockwifi")) return NO;
    return objc_getAssociatedObject(fg, kLogoKey) || [objc_getAssociatedObject(fg, kHoldKey) boolValue];
}
static BOOL DMWiFiItemCanEnable(id self, SEL _cmd, id displayItem, id data) {
    if (DMHideStockWiFi(self)) return NO;
    Class sup = class_getSuperclass(DMSBClass("_UIStatusBarWifiItem"));
    BOOL (*orig)(id, SEL, id, id) = (BOOL (*)(id, SEL, id, id))class_getMethodImplementation(sup, _cmd);
    return orig ? orig(self, _cmd, displayItem, data) : YES;
}
static void DMStockWiFiInit(void) {
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 17) return;   // (the Wi-Fi menu is for iPadOS 15/16)
    Class c = DMSBClass("_UIStatusBarWifiItem");
    SEL sel = @selector(canEnableDisplayItem:fromData:);
    Method m = c ? class_getInstanceMethod(c, sel) : NULL;
    if (!m) { DMLog(@"[wifi] iOS's Wi-Fi item not found: the Wi-Fi Menu stays off"); return; }
    Method own = NULL; unsigned n = 0; Method *ms = class_copyMethodList(c, &n);
    for (unsigned i = 0; i < n; i++) if (method_getName(ms[i]) == sel) own = ms[i];
    free(ms);
    if (own) { DMLog(@"[wifi] iOS's Wi-Fi item answers canEnableDisplayItem itself here: left alone, the Wi-Fi Menu stays off"); return; }   // (not this iPadOS's shape)
    class_addMethod(c, sel, (IMP)DMWiFiItemCanEnable, method_getTypeEncoding(m));
    gSBItemHooks |= 16;
}
static void DMStockVPNRecheck(UIView *fg) {   // (a copy that has just become ours: its items are asked again -- VPN badge, spinner, activity pill)
    id bar = fg.superview;
    while (bar && ![bar isKindOfClass:DMSBClass("_UIStatusBar")]) bar = [bar superview];
    SEL upd = NSSelectorFromString(@"_updateWithAggregatedData:");
    id data = DMCall(bar, @"currentAggregatedData");
    if (data && [bar respondsToSelector:upd]) ((void (*)(id, SEL, id))objc_msgSend)(bar, upd, data);
}
// Our icons beside the status icons (VPN, mute, SSH) are placed from where the status icons start, in our layout pass. iOS updates its icons without
// one (the Wi-Fi icon coming back seconds after a VPN connects moved the Airplane icon under our VPN badge for about a second, 28 Sep), so right
// after each of its data updates our copy is laid out again (and once more after its icon animations).
static void DMStatusIconsUpdated(id bar) {
    if (!(gVPNActive || gSSHActive || gMuteIconShown || gWiFiMenuOn)) return;   // (nothing of ours beside them; the Wi-Fi icon also follows the bars from here)
    UIView *fg = DMCall(bar, @"foregroundView");
    if (![fg isKindOfClass:[UIView class]] || !objc_getAssociatedObject(fg, kLogoKey)) return;
    [fg setNeedsLayout];
    __weak UIView *weakFg = fg;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ [weakFg setNeedsLayout]; });
}
// Anyone else's respring (Control Center respring buttons such as CCToggles', Settings, other tweaks, our Settings pages) reaches SpringBoard as a
// restart request to SBRestartManager (SBSRelaunchAction from another process ends there too). While a respring could hang (VPNRespring.h) the
// request is held and the same warning shown; Respring Anyway lets it through. sbreload (Sileo, our own Apple menu) sends an SBSRelaunchAction too
// and comes here ("requester: anon<sbreload>", iPad 2, logic test 1.0.10); our own respring has asked already (gOwnRespringAt) and passes.
// Resprings that kill SpringBoard directly (killall) never come here. Kill switch /tmp/msb-norestartgate.
static BOOL gRestartGateOpen = NO;
%group VPNRestartGate
%hook SBRestartManager
- (void)restartWithTransitionRequest:(id)request {
    BOOL ours = gOwnRespringAt > 0 && CACurrentMediaTime() - gOwnRespringAt < 10.0;
    if (gRestartGateOpen || ours || DMTestFlag("/tmp/msb-norestartgate") || !DMRespringNeedsVPNWarning()) {
        gRestartGateOpen = NO; gOwnRespringAt = 0;
        %orig;
        return;
    }
    DMLog([NSString stringWithFormat:@"[vpnwarn] a restart request held (%@)", [[request description] substringToIndex:MIN((NSUInteger)160, [request description].length)]]);
    id manager = self, held = request;
    dispatch_async(dispatch_get_main_queue(), ^{
        DMRespringWarnThen(^{ gRestartGateOpen = YES; ((void (*)(id, SEL, id))objc_msgSend)(manager, @selector(restartWithTransitionRequest:), held); });
    });
}
%end
%end
%group StockVPNItem
%hook _UIStatusBar
- (void)_updateWithAggregatedData:(id)data {
    %orig;
    DMStatusIconsUpdated(self);
}
%end
%hook _UIStatusBarIndicatorVPNItem
- (BOOL)canEnableDisplayItem:(id)displayItem fromData:(id)data {
    if (DMHideStockVPN(self)) return NO;
    return %orig;
}
%end
%end
%group StockActivityItem
%hook _UIStatusBarActivityItem
- (BOOL)canEnableDisplayItem:(id)displayItem fromData:(id)data {
    if (DMHideStockActivity(self)) return NO;
    return %orig;
}
%end
%end
// The background-activity pill (an app's capsule -- a FaceTime call, screen sharing, Handoff) between Control Center and the mute icon: in our
// menu bar its 44 pt coloured capsule left a lot of room around a small icon (iPad 2, 1 Oct). The owner likes the icon itself, so iOS's own icon
// stays and only the capsule goes: the pill is made just as wide as its icon, with no colour behind it -- like a Mac's menu bar icon for a call.
%group StockPillItem
%hook _UIStatusBarPillBackgroundActivityItem
- (CGSize)pillSize {
    CGSize s = %orig;
    if (DMHideStockActivity(self)) return CGSizeMake(MIN(s.width, 20.0), MIN(s.height > 0 ? s.height : 16.0, 16.0));
    return s;
}
- (id)_backgroundColorForActivityType:(long long)type {
    if (DMHideStockActivity(self)) return [UIColor clearColor];
    return %orig;
}
%end
%end
%group StockPillItem17
%hook _UIStatusBarPillBackgroundActivityItem
- (CGSize)pillSize {
    CGSize s = %orig;
    if (DMHideStockActivity(self)) return CGSizeMake(MIN(s.width, 20.0), MIN(s.height > 0 ? s.height : 16.0, 16.0));
    return s;
}
- (id)_backgroundColorForActivityWithIdentifier:(id)identifier {
    if (DMHideStockActivity(self)) return [UIColor clearColor];
    return %orig;
}
%end
%end
static void DMStockVPNInit(void) {
    if ([objc_getClass("SBRestartManager") instancesRespondToSelector:@selector(restartWithTransitionRequest:)]) { %init(VPNRestartGate); DMLog(@"[vpnwarn] restart requests are checked (VPN + Aerial 5.0)"); }
    Class c = DMSBClass("_UIStatusBarIndicatorVPNItem");
    if (c && [c instancesRespondToSelector:@selector(canEnableDisplayItem:fromData:)] && [DMSBClass("_UIStatusBar") instancesRespondToSelector:NSSelectorFromString(@"_updateWithAggregatedData:")]) { %init(StockVPNItem, _UIStatusBar = DMSBClass("_UIStatusBar"), _UIStatusBarIndicatorVPNItem = c); gSBItemHooks |= 1; DMLog(@"[vpn] iOS's own VPN badge left out of our status bars"); }
    else DMLog(@"[vpn] iOS's VPN item not found: its badge stays in the status icons");
    Class act = DMSBClass("_UIStatusBarActivityItem");
    if (act && [act instancesRespondToSelector:@selector(canEnableDisplayItem:fromData:)]) { %init(StockActivityItem, _UIStatusBarActivityItem = act); gSBItemHooks |= 2; }
    else DMLog(@"[activity] iOS's activity item not found: its spinner stays in the status icons");
    Class pill = DMSBClass("_UIStatusBarPillBackgroundActivityItem");
    if (pill && [pill instancesRespondToSelector:@selector(pillSize)] && [pill instancesRespondToSelector:NSSelectorFromString(@"_backgroundColorForActivityType:")]) { %init(StockPillItem, _UIStatusBarPillBackgroundActivityItem = pill); gSBItemHooks |= 4; }
    else if (DMSBUseSTUI() && pill && [pill instancesRespondToSelector:@selector(pillSize)] && [pill instancesRespondToSelector:NSSelectorFromString(@"_backgroundColorForActivityWithIdentifier:")]) { %init(StockPillItem17, _UIStatusBarPillBackgroundActivityItem = pill); gSBItemHooks |= 8; }   // (17+: the colour is asked per activity identifier)
    else DMLog(@"[activity] iOS's background activity pill item not found: it stays in the status icons");
}

%hook _UIStatusBarForegroundView

- (void)setAlpha:(CGFloat)a {
    if (((UIView *)self).alpha != a) DMWatchLog(@"_UIStatusBarForegroundView setAlpha", self, a);
    if ([objc_getAssociatedObject(self, kHoldKey) boolValue]) {   // still being set up: the stock bar must not show -- iOS's wish is kept for the release
        if (!gDMHoldOwnAlpha) objc_setAssociatedObject(self, kHoldWantAlphaKey, @(a), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        a = 0.0;
    }
    if (DMSMEngine() && [NSStringFromClass([((UIView *)self).window class]) isEqualToString:@"SBMainSwitcherWindow"] && !DMSMInFullScreenCard((UIView *)self)) a = 0.0;   // (Stage Manager engine: no menu bar inside a window card unless it is full screen, see dm_layoutLogo)
    %orig(a);
}
- (void)didMoveToWindow {
    %orig;
    if (((UIView *)self).window) DMHoldStatusBarCopy((UIView *)self);
}
- (void)setHidden:(BOOL)h {
    if (((UIView *)self).hidden != h) DMWatchLog(@"_UIStatusBarForegroundView setHidden", self, h);
    %orig;
}

- (void)layoutSubviews {
    CFTimeInterval origBegan = CACurrentMediaTime();
    %orig;
    CFTimeInterval began = CACurrentMediaTime();
    DMHoldStatusBarCopy((UIView *)self);
    DMSnapBegin();   // (S-1: one look at the windows, stages and front window for the whole pass, as in the watchers' ticks)
    [self dm_layoutLogo];
    DMSnapEnd();
    if (objc_getAssociatedObject(self, kLogoKey) || objc_getAssociatedObject(self, kNoClockLayoutKey)) DMReleaseStatusBarCopy((UIView *)self);
    double ms = (CACurrentMediaTime() - began) * 1000.0;
    if (DMPerfOn()) {   // (perf summary: the whole status bar layout pass, the system's part included)
        DMPerfSlot *ps = DMPerfSlotFor("barlayout"); double all = (CACurrentMediaTime() - origBegan) * 1000.0;
        if (ps) { ps->sum += all; ps->n++; if (all > ps->max) ps->max = all; }
    }
    if (ms > 8.0 && DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[perf] status bar layout took %.1f ms", ms]);
}

%new
- (void)dm_layoutLogo {
    UIView *fg = (UIView *)self;
    DMSBDiagStep(@"a-layout");
    // Stage Manager as the engine: a status bar copy inside a window card (SBMainSwitcherWindow: a window that was maximized keeps its app's status
    // bar strip) is not ours to dress -- a Mac window has no menu bar of its own; the one menu bar is at the top of the screen. Hidden.
    // (A window in native full screen is the exception: SpringBoard then fades the main bar out and this strip IS the top bar -- it gets our menu
    //  bar with the traffic lights, whose green takes it back to a window, as with every engine.)
    if (DMSMEngine() && [NSStringFromClass([fg.window class]) isEqualToString:@"SBMainSwitcherWindow"] && !DMSMInFullScreenCard(fg)) {
        if (fg.alpha > 0.0) { gDMHoldOwnAlpha = YES; fg.alpha = 0.0; gDMHoldOwnAlpha = NO; }   // (ours, not iOS's wish: a hold keeps iOS's own)
        return;
    }
    // While a status bar copy is being created (e.g. when an app opens) it can briefly be
    // zero-width, and the regions sit at meaningless positions. Wait for a real layout.
    if (fg.bounds.size.width < 300.0) {
        DMSBDiagStep(@"b-narrow");
        // A copy that has collapsed (an app card being dismissed, say) must not leave our
        // views behind at their old positions, or a stale app name lingers that nobody updates.
        const void *keys[] = { kSSHIconKey, kSSHButtonKey, kVPNIconKey, kVPNButtonKey, kWiFiIconKey, kWiFiButtonKey, kMuteIconKey, kLogoKey, kButtonKey, kPillKey, kAppLabelKey, kAppButtonKey, kAppPillKey, kDateProxyKey, kClockButtonKey, kSpotIconKey, kSpotButtonKey, kEditLabelKey, kEditButtonKey, kEditPillKey, kGoLabelKey, kGoButtonKey, kGoPillKey, kWinLabelKey, kWinButtonKey, kWinPillKey, kAudioLabelKey, kAudioButtonKey, kAudioPillKey, kBackgroundKey, kLightsKey , kFileLabelKey, kFileButtonKey, kFilePillKey, kViewLabelKey, kViewButtonKey, kViewPillKey };
        for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++)
            ((UIView *)objc_getAssociatedObject(fg, keys[i])).hidden = YES;
        return;
    }
    UIView *container = DMLeadingContainer(fg);
    UIView *timeLabel = container ? DMFirstStringView(container) : nil;
    if (!container || !timeLabel) {   // (the Lock Screen / Cover Sheet drop the time and date: the icons close up)
        DMSBDiagStep(container ? @"c-no-time-label" : @"c-no-leading-region");
        // That layout is ours too: on the Lock Screen or the Cover Sheet the copy is released as soon as it is applied, like a copy with the clock
        // (it waited for a clock that never comes there). Anywhere else a copy without a clock is one still being built: held as before.
        BOOL lockedNow = !(DMNewOS() && DMStarting()) && (DMLockUp(DMSBManager("SBLockScreenManager")) || DMCoverSheetShown());
        BOOL laidOut = DMLayoutWithoutClock(fg);
        objc_setAssociatedObject(fg, kNoClockLayoutKey, (laidOut && lockedNow) ? @YES : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    objc_setAssociatedObject(fg, kNoClockLayoutKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UIView *trailing = DMTrailingContainer(fg);
    DMSBDiagStep(trailing ? @"d-regions-found" : @"d-no-trailing-region");
    // Every x below is in leading coordinates (DMBarRTL: from the left in English, from the right in a right-to-left language, where the bar is
    // laid out as a Mac's menu bar is then: the Apple menu at the right end, the clock at the left end); frames go through DMBarRect.
    BOOL rtl = DMBarRTL(fg);
    if (rtl) { DMSBDiagStep(@"e-right-to-left"); DM_FEATURE_MARK("statusbar-rtl"); }
    // (right-to-left: the time sits at the time region's right end, so where it is depends on the region's width. When the iPad turns, this pass
    //  runs as the region takes its new width but before the region has moved its labels for it; the time's shift was measured from where it had
    //  been and put it past the region's edge, and iOS then dropped the time and the date for good -- portrait to landscape in Hebrew, iPad 2
    //  16.7.7, 4 Oct. The region lays its labels out first. Left-to-right the time is at the region's left end, whatever its width.)
    if (rtl) [container layoutIfNeeded];
    DMShowTimeProxy(fg, NO);
    UIView *dateLabel = DMDateStringView(container);
    {   // A spare time label (iOS's short-format time item) left visible next to our clock: hidden. It showed after an app was opened from a link out of a
        // full-screen app (iPad 2, 28 Sep: Safari -> Reddit, the App Switcher's status bar copy had two "2:17 AM" labels 23 pt apart, over the date).
        Class stringView = DMSBClass("_UIStatusBarStringView");
        static const void *kSpareTimeKey = &kSpareTimeKey;   // (marks a label hidden here: iOS only re-sets a label's alpha when its own alpha inputs change)
        for (UIView *s2 in container.subviews) {
            if (![s2 isKindOfClass:stringView]) continue;
            if (s2 != timeLabel && s2 != dateLabel && DMLooksLikeTime(((UILabel *)s2).text)) {
                if (s2.alpha > 0.01) { s2.alpha = 0.0; objc_setAssociatedObject(s2, kSpareTimeKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
            } else if (objc_getAssociatedObject(s2, kSpareTimeKey)) {   // hidden here earlier and now the clock (the other time item went): shown again
                objc_setAssociatedObject(s2, kSpareTimeKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                if (s2 == timeLabel) s2.alpha = 1.0;   // (the setAlpha: hook still keeps it at 0 where the other status bar copy draws the clock)
            }
        }
    }

    // The status bar only updates the clock once a minute; show seconds ourselves.
    UIFont *currentFont = [timeLabel valueForKey:@"font"];
    UIFont *tabular = objc_getAssociatedObject(timeLabel, kTabularFontKey);
    if (currentFont && (!tabular || ![currentFont isEqual:tabular])) {
        tabular = DMTabularFont(currentFont);
        objc_setAssociatedObject(timeLabel, kTabularFontKey, tabular, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        ((UILabel *)timeLabel).font = tabular;
    }
    NSString *clockText = DMTimeString();
    if (![((UILabel *)timeLabel).text isEqualToString:clockText]) ((UILabel *)timeLabel).text = clockText;

    // ---- the logo ----
    UILabel *logo = objc_getAssociatedObject(fg, kLogoKey);
    BOOL created = NO;
    if (!logo) {
        logo = [UILabel new];
        logo.text = [NSString stringWithFormat:@"%C", (unichar)0xF8FF];   // Apple logo in SF fonts
        logo.userInteractionEnabled = NO;
        [fg addSubview:logo];
        objc_setAssociatedObject(fg, kLogoKey, logo, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        created = YES;
    }
    UIFont *timeFont = [timeLabel valueForKey:@"font"];
    UIColor *timeColor = [timeLabel valueForKey:@"textColor"];
    // Size the logo so its visible shape is as tall as the bar allows (minus a small margin), and
    // centre that shape vertically in the bar.
    CGRect ink100;
    CGFloat logoSize = timeFont.pointSize + 3.5;   // fallback if the glyph cannot be measured
    BOOL measured = DMLogoInkAt100(&ink100);
    CGFloat targetInk = fg.bounds.size.height - 2.0 * kLogoBarMargin;
    if (measured) logoSize = targetInk / (ink100.size.height / 100.0);
    logo.font = [UIFont systemFontOfSize:logoSize weight:UIFontWeightSemibold];
    if (timeColor) logo.textColor = timeColor;
    DMApplyBackground(fg, timeColor);
    [logo sizeToFit];

    // Untransformed leading edge of the leading container (centre/bounds ignore transforms), from the leading end.
    CGFloat baseLeft = DMBarLead(fg, rtl, DMBarUntransformed(container));
    CGPoint timeCentre = [timeLabel.superview convertPoint:timeLabel.center toView:fg];   // only y is used
    CGRect lf;   // the logo, in leading coordinates
    if (measured) {
        // baseline sits `ascender` below the top of the label; the ink spans minY..maxY around the baseline
        CGFloat scale = logoSize / 100.0;
        CGFloat inkMid = (ink100.origin.y + ink100.size.height / 2.0) * scale;
        CGFloat inkMidFromTop = logo.font.ascender - inkMid;
        lf = CGRectMake(baseLeft, fg.bounds.size.height / 2.0 - inkMidFromTop, logo.bounds.size.width, logo.bounds.size.height);
    } else {
        lf = CGRectMake(baseLeft, timeCentre.y - logo.bounds.size.height / 2.0, logo.bounds.size.width, logo.bounds.size.height);
    }
    logo.frame = DMBarRect(fg, rtl, lf);
    logo.hidden = NO;
    [fg bringSubviewToFront:logo];

    // Transparent button over the logo; tapping it opens our drop-down.
    UIButton *btn = objc_getAssociatedObject(fg, kButtonKey);
    if (!btn) {
        UIView *pill = [UIView new];
        pill.layer.cornerRadius = 5.0;
        pill.hidden = YES;
        pill.userInteractionEnabled = NO;
        [fg insertSubview:pill belowSubview:logo];
        objc_setAssociatedObject(fg, kPillKey, pill, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

        btn = [UIButton buttonWithType:UIButtonTypeCustom];
        btn.pointerInteractionEnabled = YES;
        __weak UIButton *weakBtn = btn;
        [btn addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) {
            DMLog(@"[button] tapped");
            if (weakBtn) DMOpenMenu(weakBtn);
        }] forControlEvents:UIControlEventTouchUpInside];
        [fg addSubview:btn];
        objc_setAssociatedObject(fg, kButtonKey, btn, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    btn.hidden = NO;
    btn.frame = DMBarRect(fg, rtl, CGRectMake(MAX(0.0, lf.origin.x - kLogoHitSlop), 0, lf.size.width + 2.0 * kLogoHitSlop, fg.bounds.size.height));
    UIView *pillView = objc_getAssociatedObject(fg, kPillKey);
    pillView.frame = CGRectInset(btn.frame, 3.0, 3.0);
    [fg bringSubviewToFront:btn];

    // ---- menu titles after the logo: the app name (or "Finder" with no app open), then "Edit" ----
    if (!gCopies) gCopies = [NSHashTable weakObjectsHashTable];
    [gCopies addObject:fg];
    DMStartClockBalanceIfNeeded();   // a second status bar copy has just appeared (an app opening over another)
    SBApplication *frontApp = DMNativeActiveApp() ? nil : DMActiveApp();   // whichever app is frontmost, windowed or full screen (a native window: none)
    BOOL activeIsWindow = DMWindowsOwnStatusBar();
    NSString *appName = frontApp ? ([frontApp displayName] ?: [frontApp bundleIdentifier]) : (DMNativeActiveAppName() ?: @"Finder");

    // ---- traffic lights, right after the logo, while an app is full screen; the titles move right to make room ----
    CGFloat titlesStart = CGRectGetMaxX(lf) + kAppGap;
    DMLights *lights = objc_getAssociatedObject(fg, kLightsKey);
    CGRect lightsL = CGRectZero;   // (the traffic lights, in leading coordinates)
    // Locked (the Lock Screen, or the Cover Sheet pulled down): only the Apple menu on the left and the status icons with Control Center on the right --
    // no traffic lights and no menu titles, whatever app was in front, windowed or full screen (2026-09-26: an app's lights stayed on the Lock Screen).
    BOOL earlyOnNewOS = DMNewOS() && DMStarting();   // (issue #1: not asked while starting)
    BOOL locked = !earlyOnNewOS && (DMLockUp(DMSBManager("SBLockScreenManager")) || DMCoverSheetShown());   // (the Cover Sheet pulled down while unlocked counts too: iPad 2)
    BOOL wantLights = gShowWindowButtons && frontApp != nil && !activeIsWindow && !locked;   // a window has its own buttons
    if (DMTestFlag("/tmp/macstatusbar-debug")) {
        static NSMutableDictionary *lastWant = nil; if (!lastWant) lastWant = [NSMutableDictionary dictionary];
        NSString *k = [NSString stringWithFormat:@"%p", fg];
        if (!lastWant[k] || [lastWant[k] boolValue] != wantLights) { lastWant[k] = @(wantLights); if (fg.window && !fg.window.hidden) DMLog([NSString stringWithFormat:@"[lights] status bar traffic lights %@ (active app %@, window in front %d)", wantLights ? @"shown" : @"hidden", [frontApp bundleIdentifier], activeIsWindow]); }
    }
    if (wantLights) {
        if (!lights) {
            lights = [DMLights new];
            [fg addSubview:lights];
            objc_setAssociatedObject(fg, kLightsKey, lights, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        lights.dotCenterY = timeCentre.y + kLightsDrop;
        BOOL noWindows = DMActiveEngine() == DMEngineNone && !DMSMEngine();
        lights.greenHidden = noWindows;
        lights.greenDisabled = DMAppNeedsFullScreen([frontApp bundleIdentifier]);
        lightsL = CGRectMake(CGRectGetMaxX(lf) + kAppGap - 4.0, 0, kLightCell * (noWindows ? 2.0 : 3.0), fg.bounds.size.height);
        lights.frame = DMBarRect(fg, rtl, lightsL);
        lights.hidden = NO;
        gStatusLightsFrame = lights.frame; gStatusLightsDotY = lights.dotCenterY; gStatusLightsTime = CACurrentMediaTime();
        [lights setNeedsLayout];
        [fg bringSubviewToFront:lights];
        titlesStart = CGRectGetMaxX(lightsL) - 4.0 + kAppGap;   // 4 pt of each end cell is empty padding
    } else {
        lights.hidden = YES;
    }

    CGFloat titleMaxRight = locked ? 0.0 : fg.bounds.size.width / 2.0 - 24.0;   // stay in the left half (locked: no room, so every title hides)
    CGFloat leftEnd = wantLights ? CGRectGetMaxX(lightsL) - 4.0 : CGRectGetMaxX(lf);
    CGFloat appRight = DMLayoutTitle(fg, rtl, kAppLabelKey, kAppButtonKey, kAppPillKey, appName, UIFontWeightBold, timeFont, timeColor,
                                     timeCentre.y, titlesStart, titleMaxRight,
                                     ^(UIButton *b) { DMLog(@"[appbutton] tapped"); DMOpenAppMenu(b); });
    BOOL finderTitles = DMNativeActiveApp() != nil && appRight > 0;   // (our Finder in front: File and View too, like a Mac's Finder)
    if (!finderTitles) for (NSValue *k in @[[NSValue valueWithPointer:kFileLabelKey], [NSValue valueWithPointer:kFileButtonKey], [NSValue valueWithPointer:kViewLabelKey], [NSValue valueWithPointer:kViewButtonKey]])
        ((UIView *)objc_getAssociatedObject(fg, k.pointerValue)).hidden = YES;
    if (appRight > 0) {
        leftEnd = appRight;
        CGFloat editStart = appRight + kTitleGap;
        if (finderTitles) {
            CGFloat fileRight = DMLayoutTitle(fg, rtl, kFileLabelKey, kFileButtonKey, kFilePillKey, @"File", UIFontWeightRegular, timeFont, timeColor,
                                              timeCentre.y, appRight + kTitleGap, titleMaxRight, ^(UIButton *b) { DMOpenFinderFileMenu(b); });
            if (fileRight > 0) editStart = fileRight + kTitleGap;
        }
        CGFloat editRight = DMLayoutTitle(fg, rtl, kEditLabelKey, kEditButtonKey, kEditPillKey, @"Edit", UIFontWeightRegular, timeFont, timeColor,
                                          timeCentre.y, editStart, titleMaxRight,
                                          ^(UIButton *b) { DMLog(@"[editbutton] tapped"); DMOpenEditMenu(b); });
        if (editRight > 0 && finderTitles) {
            CGFloat viewRight = DMLayoutTitle(fg, rtl, kViewLabelKey, kViewButtonKey, kViewPillKey, @"View", UIFontWeightRegular, timeFont, timeColor,
                                              timeCentre.y, editRight + kTitleGap, titleMaxRight, ^(UIButton *b) { DMOpenFinderViewMenu(b); });
            if (viewRight > 0) editRight = viewRight;
        }
        if (editRight > 0) {
            leftEnd = editRight;
            CGFloat goRight = DMLayoutTitle(fg, rtl, kGoLabelKey, kGoButtonKey, kGoPillKey, @"Go", UIFontWeightRegular, timeFont, timeColor,
                                            timeCentre.y, editRight + kTitleGap, titleMaxRight,
                                            ^(UIButton *b) { DMLog(@"[gobutton] tapped"); DMOpenGoMenu(b); });
            if (goRight > 0) {
                leftEnd = goRight;
                CGFloat audioStart = goRight + kTitleGap;   // Window is only shown while windowing is active; Audio always follows whichever of the two actually laid out
                if (DMActiveEngine() != DMEngineNone || DMSMEngine() || DMNativeActiveApp()) {   // (Stage Manager as the engine is windowing too, with no engine library; our native windows always are)
                    CGFloat winRight = DMLayoutTitle(fg, rtl, kWinLabelKey, kWinButtonKey, kWinPillKey, @"Window", UIFontWeightRegular, timeFont, timeColor,
                                                     timeCentre.y, goRight + kTitleGap, titleMaxRight,
                                                     ^(UIButton *b) { DMLog(@"[winbutton] tapped"); DMOpenWindowMenu(b); });
                    if (winRight > 0) { leftEnd = winRight; audioStart = winRight + kTitleGap; }
                } else {
                    ((UIView *)objc_getAssociatedObject(fg, kWinLabelKey)).hidden = YES;
                    ((UIView *)objc_getAssociatedObject(fg, kWinButtonKey)).hidden = YES;
                }
                if (gAudioTabShown) {   // only while some app is playing audio (see DMWatchAudioPlaying)
                    CGFloat audioRight = DMLayoutTitle(fg, rtl, kAudioLabelKey, kAudioButtonKey, kAudioPillKey, @"Audio", UIFontWeightRegular, timeFont, timeColor,
                                                       timeCentre.y, audioStart, titleMaxRight,
                                                       ^(UIButton *b) { DMLog(@"[audiobutton] tapped"); DMOpenAudioMenu(b); });
                    if (audioRight > 0) leftEnd = audioRight;
                } else {
                    ((UIView *)objc_getAssociatedObject(fg, kAudioLabelKey)).hidden = YES;
                    ((UIView *)objc_getAssociatedObject(fg, kAudioButtonKey)).hidden = YES;
                }
            } else {
                ((UIView *)objc_getAssociatedObject(fg, kWinLabelKey)).hidden = YES;
                ((UIView *)objc_getAssociatedObject(fg, kWinButtonKey)).hidden = YES;
                ((UIView *)objc_getAssociatedObject(fg, kAudioLabelKey)).hidden = YES;
                ((UIView *)objc_getAssociatedObject(fg, kAudioButtonKey)).hidden = YES;
            }
        } else {
            ((UIView *)objc_getAssociatedObject(fg, kGoLabelKey)).hidden = YES;
            ((UIView *)objc_getAssociatedObject(fg, kGoButtonKey)).hidden = YES;
            ((UIView *)objc_getAssociatedObject(fg, kWinLabelKey)).hidden = YES;
            ((UIView *)objc_getAssociatedObject(fg, kWinButtonKey)).hidden = YES;
            ((UIView *)objc_getAssociatedObject(fg, kAudioLabelKey)).hidden = YES;
            ((UIView *)objc_getAssociatedObject(fg, kAudioButtonKey)).hidden = YES;
        }
    } else {
        // no room for the app name, so none for Edit, Go, Window or Audio either
        ((UIView *)objc_getAssociatedObject(fg, kEditLabelKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kEditButtonKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kGoLabelKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kGoButtonKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kWinLabelKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kWinButtonKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kAudioLabelKey)).hidden = YES;
        ((UIView *)objc_getAssociatedObject(fg, kAudioButtonKey)).hidden = YES;
    }

    // ---- the date, when the status bar has dropped its own date label ----
    // After Control Center the in-app status bar removes the date item and only adds it back a
    // while later. Until then, draw the date ourselves in the same font and colour.
    UILabel *dateProxy = objc_getAssociatedObject(fg, kDateProxyKey);
    // Always draw the date ourselves and keep the status bar's own date label invisible. Handing over
    // between the two left gaps: the label is marked opaque up to ~0.4 s before its fade actually starts
    // (opening an app), and it is removed while the rest of the bar is still fading out (closing one).
    BOOL needProxy = YES;
    if (needProxy && !dateProxy) {
        dateProxy = [UILabel new];
        dateProxy.userInteractionEnabled = NO;
        [fg addSubview:dateProxy];
        objc_setAssociatedObject(fg, kDateProxyKey, dateProxy, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    dateProxy.hidden = !needProxy;
    CGFloat proxyW = 0.0, proxyH = 0.0;
    if (needProxy) {
        dateProxy.text = DMDateString();
        dateProxy.font = tabular ?: timeFont;
        if (timeColor) dateProxy.textColor = timeColor;
        [dateProxy sizeToFit];
        proxyW = dateProxy.bounds.size.width;
        proxyH = dateProxy.bounds.size.height;
    }

    // ---- the clock (date, then time, like macOS) at the far right; icons shift left to make room ----
    // The container that holds the time and date is moved to the right edge itself (labels moved
    // far outside their container's bounds were clipped away, leaving the clock slot blank).
    CGFloat tw = DMLabelShown(timeLabel) ? timeLabel.bounds.size.width : 0.0;
    CGFloat dw = needProxy ? proxyW : (DMLabelShown(dateLabel) ? dateLabel.bounds.size.width : 0.0);
    CGFloat clockW = tw + dw + ((tw > 0 && dw > 0) ? kClockGap : 0.0);
    CGFloat rightEdge = trailing ? DMBarTrail(fg, rtl, DMBarUntransformed(trailing))   // (the trailing end of the status icons, before any shift)
                                 : (fg.bounds.size.width - baseLeft);
    CGFloat clockLeft = rightEdge - clockW;
    UIView *prevLead = objc_getAssociatedObject(fg, kShiftedKey);
    if (prevLead && prevLead != container) prevLead.transform = CGAffineTransformIdentity;
    objc_setAssociatedObject(fg, kShiftedKey, container, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    // container's left edge at the clock's left edge; with no clock, park it after the app name
    container.transform = DMBarShift(rtl, (clockW > 0 ? clockLeft : leftEnd + kLeftGroupGap) - baseLeft);
    // ---- Spotlight search icon, between the status icons and the clock ----
    UIImageView *spotIcon = objc_getAssociatedObject(fg, kSpotIconKey);
    UIButton *spotBtn = objc_getAssociatedObject(fg, kSpotButtonKey);
    if (!spotIcon) {
        spotIcon = [UIImageView new];
        spotIcon.contentMode = UIViewContentModeScaleAspectFit;
        spotIcon.userInteractionEnabled = NO;
        [fg addSubview:spotIcon];
        objc_setAssociatedObject(fg, kSpotIconKey, spotIcon, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

        spotBtn = [UIButton buttonWithType:UIButtonTypeCustom];
        spotBtn.pointerInteractionEnabled = YES;
        [spotBtn addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMOpenSpotlight(); }]
          forControlEvents:UIControlEventTouchUpInside];
        [fg addSubview:spotBtn];
        objc_setAssociatedObject(fg, kSpotButtonKey, spotBtn, OBJC_ASSOCIATION_RETAIN_NONATOMIC);

        UIImage *glyph = [UIImage systemImageNamed:@"magnifyingglass"
            withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:timeFont.pointSize + 0.5 weight:UIImageSymbolWeightSemibold]];
        spotIcon.image = [glyph imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
    }
    spotIcon.hidden = spotBtn.hidden = !gShowSpotlight;
    if ([objc_getAssociatedObject(fg, kSpotLockHidKey) boolValue]) {   // (back after the Lock Screen: it fades in while the icons slide back)
        objc_setAssociatedObject(fg, kSpotLockHidKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!spotIcon.hidden && fg.window && !fg.window.hidden) { spotIcon.alpha = 0.0; [UIView animateWithDuration:0.25 animations:^{ spotIcon.alpha = 1.0; }]; }
    }
    if (timeColor) spotIcon.tintColor = timeColor;
    CGSize glyphSize = spotIcon.image.size;
    CGFloat spotW = ceil(glyphSize.width), spotH = ceil(glyphSize.height);
    // Anything else that lives in the clock's container (a recording indicator drawn around the time) is part of the clock: the icons keep clear of it.
    CGFloat clockEdge = clockLeft;
    for (UIView *extra in container.subviews) {
        if (extra == timeLabel || extra == dateLabel || extra.hidden || extra.alpha < 0.05 || extra.bounds.size.width < 1.0) continue;
        clockEdge = MIN(clockEdge, DMBarLead(fg, rtl, [container convertRect:extra.frame toView:fg]));
    }
    CGFloat spotLeft = clockEdge - kSpotClockGap - spotW;   // with the icon off, the status icons end right before the clock instead
    if (gShowSpotlight) {
        spotIcon.frame = DMBarRect(fg, rtl, CGRectMake(spotLeft, timeCentre.y - spotH / 2.0, spotW, spotH));
        spotBtn.frame = DMBarRect(fg, rtl, CGRectMake(spotLeft - kSpotHitSlop, 0, spotW + 2.0 * kSpotHitSlop, fg.bounds.size.height));
        [fg bringSubviewToFront:spotIcon];
        [fg bringSubviewToFront:spotBtn];
    }
    CGFloat iconsEnd = gShowSpotlight ? spotLeft : clockEdge;

    if (needProxy) {
        dateProxy.frame = DMBarRect(fg, rtl, CGRectMake(clockLeft, timeCentre.y - proxyH / 2.0, proxyW, proxyH));
        [fg bringSubviewToFront:dateProxy];
    }
    {   // the clock (date + time) opens the Today View (DMToggleTodayView)
        UIButton *clockBtn = objc_getAssociatedObject(fg, kClockButtonKey);
        if (!clockBtn) {
            clockBtn = [UIButton buttonWithType:UIButtonTypeCustom];
            clockBtn.pointerInteractionEnabled = YES;
            __weak UIButton *weakClock = clockBtn;
            [clockBtn addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { DMToggleTodayViewFrom(weakClock); }] forControlEvents:UIControlEventTouchUpInside];
            [fg addSubview:clockBtn];
            objc_setAssociatedObject(fg, kClockButtonKey, clockBtn, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        clockBtn.hidden = !gClockOpensToday || clockW <= 0;
        if (!clockBtn.hidden) { clockBtn.frame = DMBarRect(fg, rtl, CGRectMake(clockLeft - 4.0, 0, clockW + 8.0, fg.bounds.size.height)); [fg bringSubviewToFront:clockBtn]; }
    }
    if (dateLabel && dateLabel.alpha != 0.0) dateLabel.alpha = 0.0;   // ours is the one drawn
    if (tw > 0) DMShiftLabel(fg, timeLabel, DMBarRect(fg, rtl, CGRectMake(clockLeft + (dw > 0 ? dw + kClockGap : 0.0), 0, tw, 1)).origin.x);   // (its place, as the label's own left edge)
    for (UIView *v in container.subviews) {   // anything else in there stays where the engine put it
        if (v == timeLabel || v == dateLabel) continue;
        if (objc_getAssociatedObject(v, kClockShiftKey)) {
            objc_setAssociatedObject(v, kClockShiftKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            v.transform = CGAffineTransformIdentity;
        }
    }

    UIView *prevTrail = objc_getAssociatedObject(fg, kTrailShiftKey);
    if (prevTrail && prevTrail != trailing) prevTrail.transform = CGAffineTransformIdentity;
    objc_setAssociatedObject(fg, kTrailShiftKey, trailing, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    // icons end kClockIconsGap before the spotlight icon, which ends kSpotClockGap before the clock
    {
        CGFloat want = -((rightEdge - iconsEnd) + kClockIconsGap);
        // (a big change -- the clock coming back after the Lock Screen -- slides; the everyday small ones, a second digit changing width, do not)
        if (fabs(DMBarShiftOf(rtl, trailing.transform) - want) > 20.0 && fg.window && !fg.window.hidden && ![trailing.layer animationForKey:@"transform"])
            [UIView animateWithDuration:0.25 delay:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{ trailing.transform = DMBarShift(rtl, want); } completion:nil];
        else trailing.transform = DMBarShift(rtl, want);
    }
    {   // where the Control Center icons start (for the keyboard pill, which sits just left of them)
        CGFloat left = CGFLOAT_MAX;
        for (UIView *sub in trailing.subviews) {
            if (sub.hidden || sub.alpha < 0.05 || sub.bounds.size.width < 1.0) continue;
            CGFloat x = DMBarLead(fg, rtl, [trailing convertRect:sub.frame toView:fg]);
            if (x < left) left = x;
        }
        // Temporary items the status bar may put in its other region containers (the right half): they count as status icons too.
        for (UIView *region in fg.subviews) {
            if (region == trailing || region == container || ![NSStringFromClass([region class]) isEqualToString:@"UIView"]) continue;
            NSMutableArray *pending = [NSMutableArray arrayWithArray:region.subviews];
            while (pending.count) {
                UIView *v = pending.lastObject; [pending removeLastObject]; [pending addObjectsFromArray:v.subviews];
                if (v.hidden || v.alpha < 0.05 || v.bounds.size.width < 1.0) continue;
                CGFloat x = DMBarLead(fg, rtl, [v.superview convertRect:v.frame toView:fg]);
                if (x > fg.bounds.size.width / 2.0 && x < left) left = x;
            }
        }
        // A copy that is still being built can be laid out once before all its status icons are in place, and the next layout may only come with
        // the next minute (seen on the iPad 2: an app going full screen, the bell and SSH icon over the Airplane icon for ~40 s). So while the icons'
        // start keeps moving, look again shortly after (at most 4 follow-ups in a row; a pass that finds them settled ends it).
        if (left < CGFLOAT_MAX && fg.window && !fg.window.hidden && fg.bounds.size.width > 300.0) {
            NSNumber *prevStart = objc_getAssociatedObject(fg, kIconsStartKey);
            int rechecks = [objc_getAssociatedObject(fg, kIconsRecheckKey) intValue];
            if (!prevStart || fabs(prevStart.doubleValue - left) > 0.5) {
                objc_setAssociatedObject(fg, kIconsStartKey, @(left), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                if (rechecks < 4) {
                    objc_setAssociatedObject(fg, kIconsRecheckKey, @(rechecks + 1), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    __weak UIView *weakFg = fg;
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ [weakFg setNeedsLayout]; });
                }
            } else if (rechecks) objc_setAssociatedObject(fg, kIconsRecheckKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            // (M1, after a respring: the copy settled at 918 with the Airplane icon not there yet; that icon came seconds later without a layout
            // of ours, and the SSH icon sat on it until the next minute. So a young copy -- its first 45 s -- also looks again every 2 s while
            // settled; a move found then starts the quick follow-ups above.)
            NSNumber *born = objc_getAssociatedObject(fg, kIconsBornKey);
            if (!born) { born = @(CACurrentMediaTime()); objc_setAssociatedObject(fg, kIconsBornKey, born, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
            if (CACurrentMediaTime() - born.doubleValue < 45.0 && !objc_getAssociatedObject(fg, kIconsSlowLookKey)) {
                objc_setAssociatedObject(fg, kIconsSlowLookKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                __weak UIView *weakFg = fg;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    UIView *f = weakFg; if (!f) return;
                    objc_setAssociatedObject(f, kIconsSlowLookKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                    [f setNeedsLayout];
                });
            }
        }
        // Wi-Fi icon (Settings > Status Bar > Wi-Fi Menu): our own item nearest the status icons, like a Mac's Wi-Fi menu extra beside Control
        // Center; iOS's own Wi-Fi item is left out of our bars then (DMHideStockWiFi). It stays with Wi-Fi off (the empty fan). Tapping it opens its menu.
        left = DMWiFiLayoutIcon(fg, left, timeCentre.y, timeColor);
        // VPN icon: its own item right next to the status icons, like a Mac's VPN menu extra next to Control Center, only while a
        // tunnel is connected; iOS's own VPN badge is taken out of the status icons group in our bars (DMHideStockVPN). Tapping it opens its menu.
        UIImageView *vpnIcon = objc_getAssociatedObject(fg, kVPNIconKey);
        if (!vpnIcon) {
            vpnIcon = [UIImageView new];
            vpnIcon.contentMode = UIViewContentModeScaleAspectFit;
            vpnIcon.userInteractionEnabled = NO;
            vpnIcon.image = DMVPNGlyph(timeFont.pointSize);
            [fg addSubview:vpnIcon];
            objc_setAssociatedObject(fg, kVPNIconKey, vpnIcon, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            UIButton *vpnButton = [UIButton buttonWithType:UIButtonTypeCustom];
            vpnButton.pointerInteractionEnabled = YES;
            __weak UIButton *weakVPNButton = vpnButton;
            [vpnButton addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { if (weakVPNButton) DMOpenVPNMenu(weakVPNButton); }] forControlEvents:UIControlEventTouchUpInside];
            [fg addSubview:vpnButton];
            objc_setAssociatedObject(fg, kVPNButtonKey, vpnButton, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        UIButton *vpnButton = objc_getAssociatedObject(fg, kVPNButtonKey);
        vpnIcon.hidden = vpnButton.hidden = !gVPNActive;
        if (timeColor) vpnIcon.tintColor = timeColor;
        if (gVPNActive && left < CGFLOAT_MAX && vpnIcon.image) {
            CGFloat w = ceil(vpnIcon.image.size.width), h = ceil(vpnIcon.image.size.height);
            left -= 8.0 + w;
            vpnIcon.frame = DMBarRect(fg, rtl, CGRectMake(left, timeCentre.y - h / 2.0, w, h));
            vpnButton.frame = DMBarRect(fg, rtl, CGRectMake(left - 6.0, 0, w + 12.0, fg.bounds.size.height));
            [fg bringSubviewToFront:vpnIcon]; [fg bringSubviewToFront:vpnButton];
        }
        {   // Mute icon: next to the status icons (after the VPN icon), only while muted
            DMReadRingerState();
            UIImageView *muteIcon = DMMuteIcon(fg, timeFont.pointSize);
            if (timeColor) muteIcon.tintColor = timeColor;
            BOOL show = DMMuteIconWanted() && left < CGFLOAT_MAX && muteIcon.image;
            muteIcon.hidden = !show;
            if (fg.window && !fg.window.hidden && fg.bounds.size.width > 300.0) gMuteIconShown = show;
            if (show) {
                CGFloat w = ceil(muteIcon.image.size.width), h = ceil(muteIcon.image.size.height);
                left -= 8.0 + w;
                muteIcon.frame = DMBarRect(fg, rtl, CGRectMake(left, timeCentre.y - h / 2.0, w, h));
                [fg bringSubviewToFront:muteIcon];
            }
        }
        // SSH icon, like the VPN one: just left of the status icons, only while someone is connected over SSH
        UIImageView *sshIcon = objc_getAssociatedObject(fg, kSSHIconKey);
        if (!sshIcon) {
            sshIcon = [UIImageView new];
            sshIcon.contentMode = UIViewContentModeScaleAspectFit;
            sshIcon.userInteractionEnabled = NO;
            UIImage *g = [UIImage systemImageNamed:@"terminal" withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:timeFont.pointSize + 0.5 weight:UIImageSymbolWeightSemibold]];
            sshIcon.image = [g imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate];
            [fg addSubview:sshIcon];
            objc_setAssociatedObject(fg, kSSHIconKey, sshIcon, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            UIButton *sshButton = [UIButton buttonWithType:UIButtonTypeCustom];
            sshButton.pointerInteractionEnabled = YES;
            __weak UIButton *weakButton = sshButton;
            [sshButton addAction:[UIAction actionWithHandler:^(__kindof UIAction *a) { if (weakButton) DMOpenSSHMenu(weakButton); }] forControlEvents:UIControlEventTouchUpInside];
            [fg addSubview:sshButton];
            objc_setAssociatedObject(fg, kSSHButtonKey, sshButton, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        UIButton *sshButton = objc_getAssociatedObject(fg, kSSHButtonKey);
        sshIcon.hidden = sshButton.hidden = !gSSHActive;
        if (timeColor) sshIcon.tintColor = timeColor;
        if (gSSHActive && left < CGFLOAT_MAX && sshIcon.image) {
            CGFloat w = ceil(sshIcon.image.size.width), h = ceil(sshIcon.image.size.height);
            left -= 8.0 + w;
            sshIcon.frame = DMBarRect(fg, rtl, CGRectMake(left, timeCentre.y - h / 2.0, w, h));
            sshButton.frame = DMBarRect(fg, rtl, CGRectMake(left - 6.0, 0, w + 12.0, fg.bounds.size.height));
            [fg bringSubviewToFront:sshIcon]; [fg bringSubviewToFront:sshButton];
        }
        if (left < CGFLOAT_MAX && fg.window && !fg.window.hidden && fg.bounds.size.width > 300.0) { gStatusIconsLeft = rtl ? 0.0 : left; if (timeColor) gStatusTextColor = timeColor; }   // (the keyboard button's place: left-to-right only, see DMPlaceKeyboardPill)
    }

    if (DMLabelShown(timeLabel) && timeLabel.bounds.size.width > 1.0) {   // where the time is drawn, for the Lock Screen (see DMShowTimeProxy)
        objc_setAssociatedObject(fg, kTimeSlotKey, [NSValue valueWithCGRect:[timeLabel.superview convertRect:timeLabel.frame toView:fg]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(fg, kTimeSlotFontKey, ((UILabel *)timeLabel).font, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (created) {
        DMLog([NSString stringWithFormat:@"[attach] logo=%@ container=%@ trailing=%@ fg=%@", NSStringFromCGRect(logo.frame),
               NSStringFromCGRect(container.frame), NSStringFromCGRect(trailing.frame), NSStringFromCGRect(fg.bounds)]);
    }
    if (DMTestFlag("/tmp/macstatusbar-debug") && fg.window && !fg.window.hidden && fg.bounds.size.width > 300.0) {   // debug timeline of everything visible in this status bar copy
        NSMutableString *dump = [NSMutableString string];
        NSMutableArray *stack = [NSMutableArray arrayWithObject:@[fg, @0]];
        while (stack.count) {
            NSArray *e = stack.lastObject; [stack removeLastObject];
            UIView *v = e[0]; int d = [e[1] intValue];
            if (d > 0 && !v.hidden && v.alpha > 0.01 && v.bounds.size.width > 0.5) {
                CGRect r = [v.superview convertRect:v.frame toView:fg];
                [dump appendFormat:@"\n%*s%@ x %.1f..%.1f y %.1f h %.1f a %.2f", d * 2, "", NSStringFromClass([v class]), r.origin.x, r.origin.x + r.size.width, r.origin.y, r.size.height, v.alpha];
            }
            if (d < 5) for (UIView *sub in [v.subviews reverseObjectEnumerator]) [stack addObject:@[sub, @(d + 1)]];
        }
        static NSMutableDictionary *lastDump = nil; if (!lastDump) lastDump = [NSMutableDictionary dictionary];
        NSString *key = [NSString stringWithFormat:@"%p", fg];
        NSString *cmp = [dump stringByReplacingOccurrencesOfString:@"a 1.00" withString:@""];
        if (![lastDump[key] isEqualToString:cmp]) { lastDump[key] = cmp; DMLog([NSString stringWithFormat:@"[bar] %p in %@ (icons start %.1f, ssh %d)%@", fg, NSStringFromClass([fg.window class]), gStatusIconsLeft, gSSHActive, dump]); }
    }
    static int clipLog = 0;
    if (clipLog < 2 && clockW > 0) {
        clipLog++;
        DMLog([NSString stringWithFormat:@"[clip] container clips=%d layer.masks=%d, fg clips=%d, trailing clips=%d; date frame in fg=%@ time frame in fg=%@ (alpha %.2f/%.2f hidden %d/%d)",
               container.clipsToBounds, container.layer.masksToBounds, fg.clipsToBounds, trailing.clipsToBounds,
               dateLabel ? NSStringFromCGRect([dateLabel.superview convertRect:dateLabel.frame toView:fg]) : @"-",
               NSStringFromCGRect([timeLabel.superview convertRect:timeLabel.frame toView:fg]),
               dateLabel.alpha, timeLabel.alpha, dateLabel.hidden, timeLabel.hidden]);
    }
    static int geometryLogs = 0;
    if (geometryLogs < 14 && clockW > 0) {
        geometryLogs++;
        CGSize need = [(UILabel *)timeLabel sizeThatFits:CGSizeMake(CGFLOAT_MAX, CGFLOAT_MAX)];
        DMLog([NSString stringWithFormat:@"[clock] \"%@\" timeW=%.1f needs=%.1f dateW=%.1f -> clock %.1f..%.1f (right edge %.1f), icons shifted %.1f",
               ((UILabel *)timeLabel).text, tw, need.width, dw, clockLeft, clockLeft + clockW, rightEdge, -(clockW + kClockIconsGap)]);
    }
}

%end

// Keep the logo's colour in step with the time when the status bar restyles
// (light/dark content behind it).
%hook _UIStatusBarStringView

- (void)setAlpha:(CGFloat)a {
    UIView *me = (UIView *)self;
    if (DMIsDateLabel(me)) a = 0.0;   // our own date is drawn instead (see dm_layoutLogo)
    else if (DMIsTimeLabel(me) && [objc_getAssociatedObject(me.superview.superview, kClockSuppressedKey) boolValue]) a = 0.0;   // the other status bar copy draws the clock
    %orig(a);
}

// Keep our labels' colour in step with the time when the status bar restyles. Read the label's
// FINAL colour after %orig, so tweaks that recolour it (ColorBar15) are followed rather than fought.
- (void)setTextColor:(UIColor *)color {
    %orig;
    UIView *me = (UIView *)self;
    UIView *fg = me.superview.superview;
    UILabel *logo = fg ? objc_getAssociatedObject(fg, kLogoKey) : nil;
    if (!logo) return;
    if (me != DMFirstStringView(me.superview)) return;
    if (me.superview != DMLeadingContainer(fg)) return;
    UIColor *final = [(UILabel *)me textColor] ?: color;
    logo.textColor = final;
    DMApplyBackground(fg, final);
    ((UILabel *)objc_getAssociatedObject(fg, kAppLabelKey)).textColor = final;
    ((UILabel *)objc_getAssociatedObject(fg, kEditLabelKey)).textColor = final;
    ((UILabel *)objc_getAssociatedObject(fg, kGoLabelKey)).textColor = final;
    ((UILabel *)objc_getAssociatedObject(fg, kFileLabelKey)).textColor = final;
    ((UILabel *)objc_getAssociatedObject(fg, kViewLabelKey)).textColor = final;
    ((UILabel *)objc_getAssociatedObject(fg, kWinLabelKey)).textColor = final;
    ((UILabel *)objc_getAssociatedObject(fg, kDateProxyKey)).textColor = final;
    ((UIImageView *)objc_getAssociatedObject(fg, kSpotIconKey)).tintColor = final;
}

// The status bar writes the time without seconds once a minute; substitute ours.
- (void)setText:(NSString *)text {
    if (DMIsTimeLabel((UIView *)self)) text = DMTimeString();
    %orig(text);
}

// If the status bar resets a clock label's transform (its own animations), keep our shift.
- (void)setTransform:(CGAffineTransform)t {
    NSNumber *shift = objc_getAssociatedObject((id)self, kClockShiftKey);
    if (shift && !gApplyingClockTransform && CGAffineTransformIsIdentity(t))
        t = CGAffineTransformMakeTranslation(shift.doubleValue, 0);
    %orig(t);
}

%end

// A Dock icon's menu is a _UIContextMenuContainerView added to SBFloatingDockWindow; it is removed when the menu closes.
@interface _UIContextMenuContainerView : UIView
@end
%hook _UIContextMenuContainerView
- (void)didMoveToWindow {
    %orig;
    UIWindow *w = ((UIView *)self).window;
    if (w && gCtxAskedAt > 0) { DMLog([NSString stringWithFormat:@"[ctxperf] menu on screen %.0f ms after it was asked (%@)", (CACurrentMediaTime() - gCtxAskedAt) * 1000.0, NSStringFromClass([w class])]); gCtxAskedAt = 0; }
    if (w && [NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) {
        if (!gDockMenuOpen) { gDockMenuOpen = YES; DMLog(@"[lights] dock menu opened: windows go under the Dock"); }
        DMApplyWindowLevel();
    } else if (!w && gDockMenuOpen) {
        gDockMenuOpen = NO;
        DMLog(@"[lights] dock menu closed: windows back to normal");
        DMApplyWindowLevel();
    }
    // A Home Screen icon's menu (in SBHomeScreenWindow, under the windows): the windows fade while it is open (DMSyncWindowFade)
    if (w && [NSStringFromClass([w class]) isEqualToString:@"SBHomeScreenWindow"]) {
        if (!gHomeMenuOpen) { gHomeMenuOpen = YES; DMLog(@"[lights] Home Screen icon menu opened: windows fade away"); }
        dispatch_async(dispatch_get_main_queue(), ^{ DMSyncWindowFade(); });
    } else if (!w && gHomeMenuOpen) {
        gHomeMenuOpen = NO;
        DMLog(@"[lights] Home Screen icon menu closed: windows come back");
        dispatch_async(dispatch_get_main_queue(), ^{ DMSyncWindowFade(); });
    }
}
%end

// ===== keeping the Cover Sheet pull away from the logo ====================
static BOOL DMPointOverLogo(UIView *bar, UIGestureRecognizer *g) {
    if (![g respondsToSelector:@selector(locationInView:)]) return NO;
    UIView *fg = nil; @try { fg = [bar valueForKey:@"foregroundView"]; } @catch (id e) {}   // (KVC on a private class, in a hook that runs on every pull: guarded)
    if (![fg isKindOfClass:[UIView class]]) return NO;
    CGPoint p = [g locationInView:fg];
    UIButton *btn = objc_getAssociatedObject(fg, kButtonKey);
    UIButton *appBtn = objc_getAssociatedObject(fg, kAppButtonKey);
    UIButton *goBtn = objc_getAssociatedObject(fg, kGoButtonKey);
    if (goBtn && !goBtn.hidden && CGRectContainsPoint(goBtn.frame, p)) return YES;
    UIButton *editBtn = objc_getAssociatedObject(fg, kEditButtonKey);
    if (editBtn && !editBtn.hidden && CGRectContainsPoint(editBtn.frame, p)) return YES;
    UIButton *spotBtn = objc_getAssociatedObject(fg, kSpotButtonKey);
    if (spotBtn && !spotBtn.hidden && CGRectContainsPoint(spotBtn.frame, p)) return YES;
    UIView *lightsView = objc_getAssociatedObject(fg, kLightsKey);
    if (lightsView && !lightsView.hidden && CGRectContainsPoint(lightsView.frame, p)) return YES;
    if (btn && CGRectContainsPoint(btn.frame, p)) return YES;
    return appBtn && !appBtn.hidden && CGRectContainsPoint(appBtn.frame, p);
}

%hook UIStatusBar_Modern
- (void)setAlpha:(CGFloat)a {
    UIView *me = (UIView *)self;
    if (me.alpha != a) DMWatchLog(@"UIStatusBar_Modern setAlpha", self, a);
    // While Control Center is on screen SpringBoard fades every status bar to 0 (the visible one, and
    // its own copies inside Control Center that only fade in later), leaving no bar and no ColorBar15
    // background for seconds. Keep the visible bar as it is, and Control Center's duplicates hidden.
    if (DMControlCenterActive()) {
        NSString *windowClass = NSStringFromClass([me.window class]);
        static int logged = 0;
        if ([windowClass isEqualToString:@"SBControlCenterWindow"]) {
            if (a > 0.01) {
                if (logged++ < 20) DMLog(@"[keepbar] keeping Control Center's own status bar copy hidden");
                a = 0.0;
            }
        } else if (a < 0.01 && me.alpha > 0.99 && me.window && !me.window.hidden) {
            objc_setAssociatedObject(me, kIntendedAlphaKey, @(a), OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // remember what it wanted
            if (logged++ < 20) DMLog([NSString stringWithFormat:@"[keepbar] refused to hide the status bar in %@ while Control Center is up", windowClass]);
            a = me.alpha;
        } else {
            objc_setAssociatedObject(me, kIntendedAlphaKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    } else {
        objc_setAssociatedObject(me, kIntendedAlphaKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    %orig(a);
}
- (void)setHidden:(BOOL)h {
    if (((UIView *)self).hidden != h) DMWatchLog(@"UIStatusBar_Modern setHidden", self, h);
    %orig;
}
%end

// The multitasking dots (when they are shown: the switch off, or windowing off) sit under the app's status bar in the same switcher page, and our
// status bar takes every touch on it: a finger on the dots never reached them. A touch on the dots' own spot -- their touch area (72 x 34 pt
// around the three dots) while the app under them is on screen -- is left to them, as on a stock iPad.
static BOOL DMDotsNo(NSString *why) {
    static NSString *last = nil;
    if (![why isEqualToString:last] && DMTestFlag("/tmp/macstatusbar-debug")) { last = why; DMLog([@"[dots] not on the dots: " stringByAppendingString:why]); }
    return NO;
}
static BOOL DMPointOnMultitaskingDots(UIView *fromView, CGPoint point) {
    if (gHideMultitaskingDots) return NO;
    UIView *aff = gDotsAffordance;
    UIWindow *w = aff.window;
    if (!aff || !w) return DMDotsNo(aff ? @"no window" : @"no dots view seen yet");
    if (w.hidden || w.alpha < 0.01 || aff.hidden || aff.alpha < 0.01 || !aff.userInteractionEnabled) return DMDotsNo([NSString stringWithFormat:@"window hidden %d alpha %.2f, view hidden %d alpha %.2f touch %d", w.hidden, w.alpha, aff.hidden, aff.alpha, aff.userInteractionEnabled]);
    for (UIView *sup = aff.superview; sup; sup = sup.superview) if (sup.hidden || sup.alpha < 0.01) return DMDotsNo([NSString stringWithFormat:@"%@ hidden", NSStringFromClass([sup class])]);
    UIView *dots = nil;
    for (UIView *sv in aff.subviews) if ([NSStringFromClass([sv class]) isEqualToString:@"SBTopAffordanceDotsView"]) { dots = sv; break; }
    // (dots kept invisible -- our engines' title bars and traffic lights take their place: SMEngine's -[SBTopAffordanceDotsView setAlpha:] -- take no
    //  touches: a tap on the Window menu's title over them was left to them and no menu opened, 1.3.4 logic test P2)
    if (!dots || dots.hidden || dots.alpha < 0.01) return DMDotsNo(dots ? @"dots invisible" : @"no dots subview");
    CGRect f = [dots convertRect:dots.bounds toCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
    CGRect area = CGRectMake(CGRectGetMidX(f) - 36.0, 0.0, 72.0, MAX(34.0, CGRectGetMaxY(f)));
    CGPoint p = [fromView convertPoint:point toCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
    return CGRectContainsPoint(area, p);
}

%hook _UIStatusBar

// Control Center makes a new status bar every time it opens and drops it when it closes. Another tweak's gesture (PeepReborn's BindableGesture)
// on every status bar keeps a closure that holds the bar itself: bar -> its gesture -> closure -> bar, so none of them was ever freed, each with our
// views in it (~0.3 MB per Control Center open on the M1: SpringBoard 98 -> 108 MB in 60 cycles, 5 dead copies every 10). A bar that is still
// out of any view 2 s after it was taken out is dead: the gestures that do not come from UIKit are taken off it, which ends the loop.
- (void)didMoveToSuperview {
    %orig;
    UIView *me = (UIView *)self;
    if (me.superview || DMTestFlag("/tmp/msb-nobarfree")) return;
    __weak UIView *weakBar = me;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *bar = weakBar;
        if (!bar || bar.superview || bar.window) return;
        static const void *uikit = NULL;
        if (!uikit) { Dl_info i; if (dladdr((__bridge void *)[UIView class], &i)) uikit = i.dli_fbase; }
        const void *own = NULL;   // (the bar's own framework: UIKit on 15/16; 17+: SystemStatusUI, whose recognisers stay too)
        if (DMSBUseSTUI()) { Dl_info i; if (dladdr((__bridge void *)[bar class], &i)) own = i.dli_fbase; }
        NSUInteger n = 0;
        for (UIGestureRecognizer *g in [bar.gestureRecognizers copy]) {
            Dl_info i;
            if (!dladdr((__bridge void *)[g class], &i) || i.dli_fbase == uikit || i.dli_fbase == own) continue;   // (UIKit's own recognisers stay)
            [bar removeGestureRecognizer:g]; n++;
        }
        if (n) DMLog([NSString stringWithFormat:@"[barfree] a dropped status bar: %lu gesture(s) from other tweaks taken off so it can be freed", (unsigned long)n]);
    });
}

- (void)setAlpha:(CGFloat)a {
    if (((UIView *)self).alpha != a) DMWatchLog(@"_UIStatusBar setAlpha", self, a);
    %orig;
}
- (void)setHidden:(BOOL)h {
    if (((UIView *)self).hidden != h) DMWatchLog(@"_UIStatusBar setHidden", self, h);
    %orig;
}

// A touch on the multitasking dots (when shown) goes to them: the app's status bar sits above them in the same switcher page.
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    // (not while a native window is active: the menu bar is its menu bar then, and the dots belong to an app window behind it -- "Window" and the
    //  Wi-Fi icon over an app's dots did nothing with Finder in front, iPad 2 30 Sep)
    if (point.y >= 0.0 && point.y < 40.0 && !gHideMultitaskingDots && !DMNativeActiveApp() && DMPointOnMultitaskingDots((UIView *)self, point)) {
        static int n = 0;
        if (n++ < 20) DMLog([NSString stringWithFormat:@"[dots] touch at %@ left to the multitasking dots", NSStringFromCGPoint(point)]);
        return nil;
    }
    return %orig;
}

// Stop the status bar's tap action from starting when the touch is on the logo.
- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)g {
    BOOL orig = %orig;
    BOOL over = DMPointOverLogo((UIView *)self, g);
    static int n = 0;
    if (n++ < 30) DMLog([NSString stringWithFormat:@"[shouldBegin] %@ orig=%d overLogo=%d",
                         NSStringFromClass([g class]), orig, over]);
    return (orig && over) ? NO : orig;
}

// Belt and braces: if the action fires anyway, swallow it over the logo.
- (void)statusBarGesture:(UIGestureRecognizer *)g {
    BOOL over = DMPointOverLogo((UIView *)self, g);
    static int n = 0;
    if (n++ < 30) DMLog([NSString stringWithFormat:@"[statusBarGesture] %@ overLogo=%d",
                         NSStringFromClass([g class]), over]);
    if (over) return;
    %orig;
}

%end

// While the menu or a dialog is showing, route every touch on the status bar window
// to it (the window normally passes touches outside the status bar through to apps).
%hook UIStatusBarWindow

- (void)setAlpha:(CGFloat)a {
    if (((UIView *)self).alpha != a) DMWatchLog(@"UIStatusBarWindow setAlpha", self, a);
    %orig;
}
- (void)setHidden:(BOOL)h {
    if (((UIView *)self).hidden != h) DMWatchLog(@"UIStatusBarWindow setHidden", self, h);
    %orig;
}
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    UIView *o = gOverlay;
    if (o && o.window == (UIWindow *)self) {
        UIView *hit = [o hitTest:[(UIView *)self convertPoint:point toView:o] withEvent:event];
        if (hit) return hit;
    }
    return %orig;
}
%end

// ===== make sure the logo appears promptly after a respring ================
@interface UIWindow (DMPrivate)
+ (NSArray *)allWindowsIncludingInternalWindows:(BOOL)internal onlyVisibleWindows:(BOOL)visible;
@end

static UIView *DMFindForegroundView(UIView *v) {
    if (DMSBIs(NSStringFromClass([v class]), "_UIStatusBarForegroundView")) return v;
    for (UIView *s in v.subviews) {
        UIView *r = DMFindForegroundView(s);
        if (r) return r;
    }
    return nil;
}

// The foreground view only lays out when something changes, which can be long
// after a respring, so go and look for it instead of waiting.
// Right after launch look for the status bar every frame (instead of every second) and lay it out the moment its stock items exist.
@interface DMStartupWatcher : NSObject
- (void)frame:(CADisplayLink *)link;
@end
static CADisplayLink *gStartupLink = nil;
static CFTimeInterval gStartupBegan = 0.0;
@implementation DMStartupWatcher
- (void)frame:(CADisplayLink *)link {
    if (!gStartupBegan) gStartupBegan = link.timestamp;
    BOOL done = NO;
    for (UIWindow *w in DMAllWindows()) {
        if (!DMSBIs(NSStringFromClass([w class]), "UIStatusBarWindow")) continue;
        UIView *fg = DMFindForegroundView(w);
        if (!fg) continue;
        DMHoldStatusBarCopy(fg);
        [(_UIStatusBarForegroundView *)fg dm_layoutLogo];
        if (objc_getAssociatedObject(fg, kLogoKey)) { DMReleaseStatusBarCopy(fg); done = YES; }
    }
    if (done || link.timestamp - gStartupBegan > 12.0) {
        DMLog([NSString stringWithFormat:@"[startup] status bar %@ %.2f s after the watcher started", done ? @"attached" : @"NOT found; watcher stopped", link.timestamp - gStartupBegan]);
        [gStartupLink invalidate];
        gStartupLink = nil;
    }
}
@end
static void DMStartStartupWatcher(void) {
    if (gStartupLink) return;
    gStartupLink = [CADisplayLink displayLinkWithTarget:[DMStartupWatcher new] selector:@selector(frame:)];
    [gStartupLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
}

static void DMEnsureLogo(int attempt) {
    for (UIWindow *w in DMAllWindows()) {
        if (!DMSBIs(NSStringFromClass([w class]), "UIStatusBarWindow")) continue;
        UIView *fg = DMFindForegroundView(w);
        if (!fg) continue;
        [(_UIStatusBarForegroundView *)fg dm_layoutLogo];
        if (objc_getAssociatedObject(fg, kLogoKey)) {
            DMReleaseStatusBarCopy(fg);
            DMLog([NSString stringWithFormat:@"[ensure] logo present after %d attempt(s)", attempt + 1]);
            return;
        }
    }
    if (attempt < 40) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{ DMEnsureLogo(attempt + 1); });
    }
}




// iPadOS 16 (iPad 2, 27 Sep): now and then the touch screen sends a report in the middle of a touch with the finger at exactly (0, 0) -- the
// display's native top-left corner, whatever the orientation (mask 0x803, still touching; the finger itself never went there) -- and the next
// report is the lift at the real point. UIKit takes it as a jump to the corner: the tap on a Dock icon moves off the icon and launches nothing,
// and a jump to the top edge can start the Notification Center pull. Such a report is dropped here, before anything in SpringBoard
// uses it (SpringBoard sendEvent:): only a finger that is already down, last seen away from both corner edges, reported at exactly (0, 0). A real finger that starts at an
// edge or slides to one reports its path on the way, so edge gestures are left alone.
#define DMTF_SLOTS 32
// (per path index; main thread only) down: a real touch in progress, at x/y. badStart: a touch whose DOWN came at (0, 0) -- its events are kept
// from SpringBoard; realX/realY: the first real point seen since; t0: when it began.
static struct { BOOL down, badStart, hasReal; double x, y, realX, realY; CFTimeInterval t0; } gDMTFFinger[DMTF_SLOTS];
static double (*gDMTFGetF)(void *, uint32_t);
static long (*gDMTFGetI)(void *, uint32_t);
static CFArrayRef (*gDMTFKids)(void *);
static uint32_t (*gDMTFType)(void *);
static CFTimeInterval gDMTFReinjectUntil = 0;   // (our own re-sent tap is never treated again)
typedef enum { DMTFPass = 0, DMTFDropMove, DMTFBadStart, DMTFBadMove, DMTFBadLift } DMTFVerdict;
static void DMTFLog(NSString *line) { if (DMTestFlag("/tmp/macstatusbar-debug")) dispatch_async(dispatch_get_main_queue(), ^{ DMLog(line); }); }
static DMTFVerdict DMTouchFixClassify(void *e, int *slotOut) {
    if (!e || gDMTFType(e) != 11) return DMTFPass;
    CFArrayRef kids = gDMTFKids(e);
    DMTFVerdict verdict = DMTFPass;
    for (CFIndex i = 0; kids && i < CFArrayGetCount(kids); i++) {
        void *f = (void *)CFArrayGetValueAtIndex(kids, i);
        if (gDMTFType(f) != 11) continue;
        // Keyed by the finger's path index (what UIKit matches a UITouch by), not its identity: the bogus report can come with a NEW identity
        // for the same finger (iPad 2, 27 Sep 20:21, the first touch after a respring: finger 2 -> finger 3 at (0, 0), same index 1, and UIKit
        // moved the same touch to the corner).
        long ident = gDMTFGetI(f, 0xb0006);   // (kIOHIDEventFieldDigitizerIdentity: only logged)
        long index = gDMTFGetI(f, 0xb0005);   // (kIOHIDEventFieldDigitizerIndex)
        if (index < 0) continue;
        int slot = (int)(index % DMTF_SLOTS);
        BOOL touching = gDMTFGetI(f, 0xb0009) != 0;   // (kIOHIDEventFieldDigitizerTouch)
        double x = gDMTFGetF(f, 0xb0000), y = gDMTFGetF(f, 0xb0001);
        BOOL corner = x == 0.0 && y == 0.0;
#if DEBUG
        if (DMTestFlag("/tmp/macstatusbar-touchfixlog")) DMTFLog([NSString stringWithFormat:@"[touchfix] seen finger %ld index %ld touch %d x %.4f y %.4f mask 0x%lx children %ld", ident, index, touching, x, y, gDMTFGetI(f, 0xb0007), (long)CFArrayGetCount(kids)]);
        if (DMTestFlag("/tmp/macstatusbar-notouchfix")) { if (!touching) gDMTFFinger[slot].down = NO; else if (!corner) { gDMTFFinger[slot].down = YES; gDMTFFinger[slot].x = x; gDMTFFinger[slot].y = y; } continue; }
#endif
        if (slotOut) *slotOut = slot;
        if (gDMTFFinger[slot].badStart && CACurrentMediaTime() - gDMTFFinger[slot].t0 > 1.5) {   // (its lift never came: forgotten, so it can't hide the next touch)
            gDMTFFinger[slot].badStart = NO; gDMTFFinger[slot].down = NO;
            DMTFLog([NSString stringWithFormat:@"[touchfix] a held-back touch (index %ld) got no lift within 1.5 s: forgotten", index]);
        }
        if (gDMTFFinger[slot].badStart) {   // a touch whose down came at the corner: all of it stays away from SpringBoard; the lift decides
            if (!touching) {
                gDMTFFinger[slot].badStart = NO; gDMTFFinger[slot].down = NO;
                if (!corner && !gDMTFFinger[slot].hasReal) { gDMTFFinger[slot].hasReal = YES; gDMTFFinger[slot].realX = x; gDMTFFinger[slot].realY = y; }
                if (!corner) { gDMTFFinger[slot].x = x; gDMTFFinger[slot].y = y; }
                verdict = DMTFBadLift;
            } else {
                if (!corner && !gDMTFFinger[slot].hasReal) { gDMTFFinger[slot].hasReal = YES; gDMTFFinger[slot].realX = x; gDMTFFinger[slot].realY = y; }
                if (!corner) { gDMTFFinger[slot].x = x; gDMTFFinger[slot].y = y; }
                if (verdict == DMTFPass) verdict = DMTFBadMove;
            }
            continue;
        }
        if (!touching) { gDMTFFinger[slot].down = NO; continue; }
        if (corner) {
            if (!gDMTFFinger[slot].down) {   // a DOWN at exactly the corner (no real finger lands on the display's exact (0, 0))
                gDMTFFinger[slot].badStart = YES; gDMTFFinger[slot].hasReal = NO; gDMTFFinger[slot].x = gDMTFFinger[slot].y = 0; gDMTFFinger[slot].t0 = CACurrentMediaTime();
                DMTFLog([NSString stringWithFormat:@"[touchfix] a touch-screen DOWN of finger %ld (index %ld) at (0, 0) (mask 0x%lx): kept from SpringBoard until the real point is known", ident, index, gDMTFGetI(f, 0xb0007)]);
                verdict = DMTFBadStart;
            } else if (gDMTFFinger[slot].down && gDMTFFinger[slot].x > 20.0 && gDMTFFinger[slot].y > 20.0) {
                verdict = DMTFDropMove;
                DMTFLog([NSString stringWithFormat:@"[touchfix] dropped a touch-screen report of finger %ld (index %ld) at (0, 0) (mask 0x%lx) -- it was at (%.1f, %.1f)", ident, index, gDMTFGetI(f, 0xb0007), gDMTFFinger[slot].x, gDMTFFinger[slot].y]);
            }
            continue;   // (never remembered as a position)
        }
        gDMTFFinger[slot].down = YES; gDMTFFinger[slot].x = x; gDMTFFinger[slot].y = y;
    }
    return verdict;
}
%group DMTouchFix
%hook SpringBoard
- (void)sendEvent:(UIEvent *)event {
    BOOL fingers = event.type == UIEventTypeTouches;   // (only a finger on the touch screen: a Pencil, trackpad or mouse click at the corner is left alone)
    if (fingers) for (UITouch *t in event.allTouches) if (t.type != UITouchTypeDirect) { fingers = NO; break; }
    if (fingers && [event respondsToSelector:@selector(_hidEvent)]) {
        void *e = ((void *(*)(id, SEL))objc_msgSend)(event, @selector(_hidEvent));
        int slot = -1;
        DMTFVerdict v = DMTouchFixClassify(e, &slot);
        NSSet<UITouch *> *all = event.allTouches;
        if (v == DMTFDropMove) {
            // (UIKit has already moved the touch to (0, 0) by now: the touch goes back where it was and the event is not handled -- a lone move
            // report, so nothing else is lost; the next report, usually the lift, carries the real point)
            BOOL onlyMoves = YES;
            for (UITouch *t in all) if (t.phase != UITouchPhaseMoved && t.phase != UITouchPhaseStationary) onlyMoves = NO;
            if (onlyMoves) {
                SEL set = NSSelectorFromString(@"_setLocationInWindow:resetPrevious:");
                for (UITouch *t in all)   // (the corner is (0, 0) only in the display's own orientation: every moved touch goes back)
                    if (t.phase == UITouchPhaseMoved && [t respondsToSelector:set]) ((void (*)(id, SEL, CGPoint, BOOL))objc_msgSend)(t, set, [t previousLocationInView:nil], YES);
                return;
            }
        } else if ((v == DMTFBadStart || v == DMTFBadMove) && all.count == 1) {
            // A touch whose DOWN came at the corner (iPad 2 after a respring with no window open: the Notification Center pull, a Dock tap that
            // did nothing). backboardd already sent it to whatever is at the corner, and the edge swipe recognisers would start at once: SpringBoard
            // never sees its down or moves (so no recogniser or view takes it), only its lift, and a short still tap is sent again at the real point.
            return;
        } else if (v == DMTFBadLift && all.count == 1 && slot >= 0) {
            UITouch *t = all.anyObject;
            CGPoint lift = [t.window convertPoint:[t locationInView:nil] toCoordinateSpace:[UIScreen mainScreen].coordinateSpace];
            CGSize sc = [UIScreen mainScreen].bounds.size;
            CFTimeInterval held = CACurrentMediaTime() - gDMTFFinger[slot].t0;
            // (the real points are in this event stream's own units -- pixels or points -- so "still" is judged relative to the lift in the same units)
            double moved = gDMTFFinger[slot].hasReal ? hypot(gDMTFFinger[slot].realX - gDMTFFinger[slot].x, gDMTFFinger[slot].realY - gDMTFFinger[slot].y) : 0;
            BOOL away = lift.x > 20.0 && lift.y > 20.0 && lift.x < sc.width - 20.0 && lift.y < sc.height - 20.0;
            BOOL locked = DMLockUp(DMSBManager("SBLockScreenManager")) || DMCoverSheetShown();   // (never on the Lock Screen / Cover Sheet: a re-sent tap on a notification would unlock into its app)
            BOOL again = away && !locked && held < 0.6 && moved < 30.0 && CACurrentMediaTime() > gDMTFReinjectUntil;
            %orig;   // (the lift: UIKit forgets the touch; nothing had it)
            DMTFLog([NSString stringWithFormat:@"[touchfix] its lift at %@ after %.0f ms (moved %.0f): %@", NSStringFromCGPoint(lift), held * 1000.0, moved, again ? @"the tap is sent again there" : (locked ? @"Lock Screen or Cover Sheet up, nothing sent" : @"not a tap, nothing sent")]);
            if (again) {
                gDMTFReinjectUntil = CACurrentMediaTime() + 0.5;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(20 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(lift, DMTouchDown); });
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(90 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(lift, DMTouchUp); });
            }
            return;
        }
    }
    %orig;
}
%end
%end
static void DMTouchFixInit(void) {
    if (![[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}]) return;   // (iPadOS 15 never showed it)
    if (![UIEvent instancesRespondToSelector:@selector(_hidEvent)]) { DMLog(@"[touchfix] UIEvent _hidEvent missing: off"); return; }
    void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
    gDMTFGetF = dlsym(iokit, "IOHIDEventGetFloatValue"); gDMTFGetI = dlsym(iokit, "IOHIDEventGetIntegerValue");
    gDMTFKids = dlsym(iokit, "IOHIDEventGetChildren"); gDMTFType = dlsym(iokit, "IOHIDEventGetType");
    if (!gDMTFGetF || !gDMTFGetI || !gDMTFKids || !gDMTFType) { DMLog(@"[touchfix] IOKit functions missing: off"); return; }
    %init(DMTouchFix);
    DMSysTouch(CGPointZero, DMTouchWarm);   // (the touch screen's sender ID looked up now, not during the first re-sent tap)
    DMLog(@"[touchfix] on: touch-screen reports at (0, 0) -- a jump in the middle of a touch, or a touch that begins there -- are kept from SpringBoard");
}

#if DEBUG   // ===== everything from here to the matching #endif is test machinery: never in a release (FINALPACKAGE=1) build =====
// ---- debug aids (only while /tmp/macstatusbar-debug exists) ----
static BOOL DMDebugOn(void) { return DMTestFlag("/tmp/macstatusbar-debug"); }

// ---- external display (HDMI / AirPlay) evidence, log only (debug builds, while the debug flag exists) ----
// On iPadOS 15 SpringBoard gives the external display to ONE app: SBExternalDisplayController adds an update to every main-display
// transition (-slaveTransactionsForTransitionRequest:) and SBExternalDisplayPresenter -updateToConfiguration:withForegroundApp: hosts that
// app's external-display scene (its UIWindowSceneSessionRoleExternalDisplay scene; the app sees UIScreen didConnect / a new UIWindowScene).
// The foreground app comes from the main display's layout (the full-screen app); an app inside a window is not part of that layout.
// These hooks only log what SpringBoard decides ([extdisplay]), for the hand test with a TV/monitor connected.
static NSString *DMExtAppName(id app) { if (!app) return @"(none)"; NSString *b = nil; @try { b = [app valueForKey:@"bundleIdentifier"]; } @catch (id e) {} return b ?: NSStringFromClass([app class]); }
static NSString *DMExtFrontWindowBundle(void);
%group ExtDisplayLog
%hook SBExternalDisplayPresenter
- (id)updateToConfiguration:(id)config withForegroundApp:(id)app {
    if (DMDebugOn()) DMLog([NSString stringWithFormat:@"[extdisplay] presenter update: foreground app %@ (full-screen app %@, front window %@), config %@", DMExtAppName(app), DMExtAppName(DMFrontApp()), DMExtFrontWindowBundle(), config ? NSStringFromClass([config class]) : @"nil"]);
    return %orig;
}
%end
%hook SBExternalDisplayController
- (BOOL)_application:(id)app canAccessDisplay:(id)display {
    BOOL r = %orig;
    if (DMDebugOn()) DMLog([NSString stringWithFormat:@"[extdisplay] can %@ use the display: %d", DMExtAppName(app), r]);
    return r;
}
- (BOOL)_shouldConnectDisplayNow:(id)x {
    BOOL r = %orig;
    if (DMDebugOn()) DMLog([NSString stringWithFormat:@"[extdisplay] connect the display now: %d", r]);
    return r;
}
%end
%hook SBExternalDisplayManager
- (void)displayMonitor:(id)m didConnectIdentity:(id)identity withConfiguration:(id)config {
    if (DMDebugOn()) DMLog([NSString stringWithFormat:@"[extdisplay] display connected: %@", identity]);
    %orig;
}
- (void)displayMonitor:(id)m willDisconnectIdentity:(id)identity {
    if (DMDebugOn()) DMLog([NSString stringWithFormat:@"[extdisplay] display disconnecting: %@", identity]);
    %orig;
}
%end
%end
static NSString *DMExtFrontWindowBundle(void) { UIView *st = DMTopStage(); return st ? (DMStageBundle(st) ?: @"?") : @"(none)"; }
static void DMExtDisplayLogInit(void) {
    struct { const char *cls, *sel, *types; } need[] = {
        {"SBExternalDisplayPresenter", "updateToConfiguration:withForegroundApp:", "@32@0:8@16@24"},
        {"SBExternalDisplayController", "_application:canAccessDisplay:", "B32@0:8@16@24"},
        {"SBExternalDisplayController", "_shouldConnectDisplayNow:", "B24@0:8@16"},
        {"SBExternalDisplayManager", "displayMonitor:didConnectIdentity:withConfiguration:", "v40@0:8@16@24@32"},
        {"SBExternalDisplayManager", "displayMonitor:willDisconnectIdentity:", "v32@0:8@16@24"}};
    for (size_t i = 0; i < sizeof(need) / sizeof(need[0]); i++) {
        Class c = objc_getClass(need[i].cls); Method m = c ? class_getInstanceMethod(c, sel_registerName(need[i].sel)) : NULL;
        if (!m || strcmp(method_getTypeEncoding(m), need[i].types) != 0) { DMLog([NSString stringWithFormat:@"[extdisplay] %s %s not as expected: no display logging", need[i].cls, need[i].sel]); return; }
    }
    %init(ExtDisplayLog);
    for (NSString *n in @[UIScreenDidConnectNotification, UIScreenDidDisconnectNotification, UIScreenModeDidChangeNotification])
        [[NSNotificationCenter defaultCenter] addObserverForName:n object:nil queue:[NSOperationQueue mainQueue] usingBlock:^(NSNotification *note) {
            if (DMDebugOn()) DMLog([NSString stringWithFormat:@"[extdisplay] SpringBoard %@: %@ (screens now %lu)", note.name, note.object, (unsigned long)[UIScreen screens].count]);
        }];
}

static NSMapTable<CADisplayLink *, NSString *> *gDMLinkTargets;   // (debug: each display link's target class and selector)
static NSMapTable<CADisplayLink *, NSString *> *gDMLinks;   // (debug, idleprobe: every display link added to a run loop, and who added it)
%group DMDebugHooks
// Debug (iPad 2, 27 Sep: after a quiet while, the first tap on a Dock icon launches nothing -- our outside-touch watcher sees it already cancelled,
// at {0, 0}): the first touch after 20 s without touches is followed for 3 s -- every phase, the window and view it is on, and each gesture
// recognizer on it with its state after SpringBoard handled the event; an icon's touchesCancelled in that time logs who cancelled it.
// Widened: also after 8 s idle, the first touches after SpringBoard starts / each unlock, and any touch that begins exactly on a screen edge;
// with the raw IOHIDEvent (sender, age, normalised digitizer coordinates) and the visible windows.
static CFTimeInterval gDMLastTouchAt = 0, gDMTouchWatchUntil = 0;
// The raw IOHIDEvent behind a touch event: the hand event and each finger (normalised 0..1 digitizer coordinates, masks, range/touch), its sender
// (the touch screen's registry ID for a real finger) and how old it is -- tells a real digitizer report from a synthesized one, and whether a wrong
// location (the {0, 0} / y = 0 first touches) already came from backboardd or appeared later in UIKit.
static NSString *DMHIDTouchDesc(UIEvent *event) {
    static double (*getF)(void *, uint32_t); static long (*getI)(void *, uint32_t); static CFArrayRef (*kids)(void *);
    static uint64_t (*sender)(void *); static uint64_t (*stamp)(void *); static uint32_t (*type)(void *);
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        getF = dlsym(iokit, "IOHIDEventGetFloatValue"); getI = dlsym(iokit, "IOHIDEventGetIntegerValue"); kids = dlsym(iokit, "IOHIDEventGetChildren");
        sender = dlsym(iokit, "IOHIDEventGetSenderID"); stamp = dlsym(iokit, "IOHIDEventGetTimeStamp"); type = dlsym(iokit, "IOHIDEventGetType");
    });
    SEL hs = NSSelectorFromString(@"_hidEvent");
    void *e = [event respondsToSelector:hs] ? ((void *(*)(id, SEL))objc_msgSend)(event, hs) : NULL;
    if (!e || !getF || !getI || !kids || !sender || !stamp || !type) return @"hid none";
    static mach_timebase_info_data_t tb; if (!tb.denom) mach_timebase_info(&tb);
    double ageMs = (double)(mach_absolute_time() - stamp(e)) * tb.numer / tb.denom / 1e6;
    NSMutableString *m = [NSMutableString stringWithFormat:@"hid type %u sender 0x%llx age %.1f ms", type(e), sender(e), ageMs];
    if (type(e) == 11) {
        [m appendFormat:@" hand x %.4f y %.4f mask 0x%lx range %ld touch %ld dtype %ld", getF(e, 0xb0000), getF(e, 0xb0001), getI(e, 0xb0007), getI(e, 0xb0008), getI(e, 0xb0009), getI(e, 0xb0004)];
        CFArrayRef k = kids(e);
        for (CFIndex i = 0; k && i < CFArrayGetCount(k) && i < 6; i++) {
            void *c = (void *)CFArrayGetValueAtIndex(k, i);
            if (type(c) != 11) { [m appendFormat:@" | child type %u", type(c)]; continue; }
            [m appendFormat:@" | finger id %ld idx %ld x %.4f y %.4f mask 0x%lx range %ld touch %ld r %.3f", getI(c, 0xb0006), getI(c, 0xb0005), getF(c, 0xb0000), getF(c, 0xb0001), getI(c, 0xb0007), getI(c, 0xb0008), getI(c, 0xb0009), getF(c, 0xb0014)];
        }
    }
    return m;
}
// (debug /tmp/msb-cornerwatch: a touch near a Stage Manager window's bottom corner -- which view it hits and which gesture recognizers see it, as it
//  begins, moves and ends: the left resize corner did nothing while the right one resized, iPad 2 29 Sep)
#if DEBUG
@class SBAppSwitcherPageView;
static SBAppSwitcherPageView *DMSMPageViewOf(UIView *card);
static void DMCornerWatch(UIEvent *event) {
    for (UITouch *t in event.allTouches) {
        static char kCornerKey;
        NSString *corner = objc_getAssociatedObject(t, &kCornerKey);
        if (t.phase == UITouchPhaseBegan) {
            CGPoint p = [t locationInView:nil];
            NSDictionary<NSString *, NSValue *> *frames = DMSMOpenWindowFrames();
            for (NSString *b in frames) {
                CGRect f = frames[b].CGRectValue;
                if (fabs(p.y - CGRectGetMaxY(f)) > 40.0) continue;
                if (fabs(p.x - CGRectGetMinX(f)) <= 40.0) corner = [b stringByAppendingString:@" LEFT"];
                else if (fabs(p.x - CGRectGetMaxX(f)) <= 40.0) corner = [b stringByAppendingString:@" RIGHT"];
            }
            if (!corner) continue;
            objc_setAssociatedObject(t, &kCornerKey, corner, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            NSMutableString *chain = [NSMutableString string];
            int n = 0; for (UIView *v = t.view; v && n < 6; v = v.superview, n++) [chain appendFormat:@"%@%@ ", NSStringFromClass([v class]), v.userInteractionEnabled ? @"" : @"(no-ui)"];
            DMLog([NSString stringWithFormat:@"[corner] %@ began at %@, window %@, view chain: %@", corner, NSStringFromCGPoint(p), NSStringFromClass([t.window class]), chain]);
            UIView *card = DMSMCardFor([corner componentsSeparatedByString:@" "].firstObject);
            UIView *page = card ? (UIView *)DMSMPageViewOf(card) : nil;
            for (UIView *g in page.subviews) {
                if (![NSStringFromClass([g class]) isEqualToString:@"SBAppResizeGrabberView"]) continue;
                Ivar ci = class_getInstanceVariable([g class], "_corner");
                long long cv = ci ? *(long long *)((char *)(__bridge void *)g + ivar_getOffset(ci)) : -1;
                DMLog([NSString stringWithFormat:@"[corner]   grabber corner %lld frame %@ in page %@ alpha %.2f hidden %d ui %d", cv, NSStringFromCGRect(g.frame), NSStringFromCGRect(page.bounds), g.alpha, g.hidden, g.userInteractionEnabled]);
            }
        }
        if (!corner) continue;
        if (t.phase == UITouchPhaseBegan || t.phase == UITouchPhaseEnded || t.phase == UITouchPhaseCancelled || (t.phase == UITouchPhaseMoved && arc4random_uniform(8) == 0)) {
            NSMutableString *g = [NSMutableString string];
            for (UIGestureRecognizer *r in t.gestureRecognizers) [g appendFormat:@"%@%@(%ld on %@) ", NSStringFromClass([r class]), r.name ? [NSString stringWithFormat:@"'%@'", r.name] : @"", (long)r.state, NSStringFromClass([r.view class])];
            DMLog([NSString stringWithFormat:@"[corner] %@ phase %ld at %@: %@", corner, (long)t.phase, NSStringFromCGPoint([t locationInView:nil]), g]);
        }
    }
}
#endif
%hook SpringBoard
- (void)sendEvent:(UIEvent *)event {
#if DEBUG
    if (event.type == UIEventTypeTouches && DMTestFlag("/tmp/msb-cornerwatch") && DMSMEngine()) DMCornerWatch(event);
#endif
    BOOL watch = NO, began = NO, edge = NO;
    NSString *why = nil;
    if (event.type == UIEventTypeTouches && DMTestFlag("/tmp/macstatusbar-debug") && !DMTestFlag("/tmp/msb-notouchwatch")) {   // (/tmp/msb-notouchwatch: off, for timing tests)
        CFTimeInterval now = CACurrentMediaTime();
        CGSize sc = [UIScreen mainScreen].bounds.size;
        BOOL anyDown = NO;
        for (UITouch *t in event.allTouches) {
            if (t.phase != UITouchPhaseBegan) { if (t.phase != UITouchPhaseEnded && t.phase != UITouchPhaseCancelled) anyDown = YES; continue; }
            anyDown = YES; began = YES;
            CGPoint p = [t locationInView:nil];
            if (p.x <= 0.5 || p.y <= 0.5 || p.x >= sc.width - 0.5 || p.y >= sc.height - 0.5) edge = YES;
        }
        if (began && gDMLastTouchAt > 0 && now - gDMLastTouchAt > 8.0) why = [NSString stringWithFormat:@"first touch after %.0f s without touches", now - gDMLastTouchAt];
        else if (began && gDMTouchWatchArm > 0) why = [NSString stringWithFormat:@"a first touch after %@ (%d left)", gDMTouchWatchWhy, gDMTouchWatchArm - 1];
        else if (edge) why = @"a touch that begins exactly on the screen edge";
        else {   // a touch cancelled outside the traced time: logged too (rate-limited), with its raw event (a digitizer cancel has mask bit 0x80)
            static CFTimeInterval minute = 0; static int n = 0;
            for (UITouch *t in event.allTouches) if (t.phase == UITouchPhaseCancelled) {
                if (now - minute > 60.0) { minute = now; n = 0; }
                if (n++ < 10) DMLog([NSString stringWithFormat:@"[touchwatch] touch cancelled at %@ in %@ (last down event %.0f ms before); event %@", NSStringFromCGPoint([t locationInView:nil]), NSStringFromClass([t.window class]), (CACurrentMediaTime() - gDMLastTouchAt) * 1000.0, DMHIDTouchDesc(event)]);
                break;
            }
        }
        if (why) {
            if (gDMTouchWatchArm > 0 && began) gDMTouchWatchArm--;
            gDMTouchWatchUntil = now + 3.0;
            NSMutableString *wl = [NSMutableString string];
            for (UIWindow *w in DMAllWindows()) if (!w.hidden && w.alpha > 0.01) [wl appendFormat:@" %@(%.0f)", NSStringFromClass([w class]), w.windowLevel];
            DMLog([NSString stringWithFormat:@"[touchwatch] %@; windows:%@", why, wl]);
        }
        if (anyDown) gDMLastTouchAt = now;
        watch = now < gDMTouchWatchUntil;
    }
    static int hidLines = 0;
    if (watch) {   // before SpringBoard handles it (the gesture states below are after)
        if (began || edge || hidLines < 4) DMLog([NSString stringWithFormat:@"[touchwatch] event %@", DMHIDTouchDesc(event)]);
        hidLines = began ? 0 : hidLines + 1;
    }
    %orig;
    if (!watch) return;
    for (UITouch *t in event.allTouches) {
        NSMutableString *m = [NSMutableString stringWithFormat:@"[touchwatch] phase %ld type %ld at %@ (precise %@) t-age %.1f ms tap %lu r %.1f window %@ view %@ gestures:", (long)t.phase, (long)t.type,
            NSStringFromCGPoint([t locationInView:nil]), NSStringFromCGPoint([t preciseLocationInView:nil]), (CACurrentMediaTime() - t.timestamp) * 1000.0, (unsigned long)t.tapCount, t.majorRadius,
            NSStringFromClass([t.window class]), NSStringFromClass([t.view class])];
        for (UIGestureRecognizer *g in t.gestureRecognizers) [m appendFormat:@" %@(%ld)", NSStringFromClass([g class]), (long)g.state];
        DMLog(m);
        // (the system gesture window's recognisers: who they belong to -- delegate, name, action -- for the Stage Manager conflicts)
        if (t.phase == UITouchPhaseBegan && [NSStringFromClass([t.window class]) isEqualToString:@"_UISystemGestureWindow"] && DMTestFlag("/tmp/msb-grwatch"))
            for (UIGestureRecognizer *g in t.gestureRecognizers) {
                NSString *d = [g description]; NSRange r = [d rangeOfString:@"target="];
                DMLog([NSString stringWithFormat:@"[grwatch] %@ name %@ delegate %@ view %@ %@", NSStringFromClass([g class]), g.name, NSStringFromClass([(id)g.delegate class]), NSStringFromClass([g.view class]), r.location != NSNotFound ? [d substringFromIndex:r.location] : @""]);
            }
    }
}
%end
%hook SBIconView
- (void)touchesCancelled:(NSSet *)touches withEvent:(UIEvent *)event {
    if (CACurrentMediaTime() < gDMTouchWatchUntil) {
        DMLog(@"[touchwatch] an icon's touches were cancelled; by:");
        NSArray<NSNumber *> *ret = [NSThread callStackReturnAddresses];
        for (NSUInteger i = 1; i < ret.count && i < 10; i++) DMSymbolize(ret[i].unsignedLongLongValue);
    }
    %orig;
}
%end
%hook CADisplayLink
+ (CADisplayLink *)displayLinkWithTarget:(id)target selector:(SEL)sel {
    CADisplayLink *l = %orig;
    if (!gDMLinkTargets) gDMLinkTargets = [NSMapTable weakToStrongObjectsMapTable];
    if (l) [gDMLinkTargets setObject:[NSString stringWithFormat:@"%@ %@", NSStringFromClass([target class]), NSStringFromSelector(sel)] forKey:l];
    return l;
}
- (void)addToRunLoop:(NSRunLoop *)runloop forMode:(NSRunLoopMode)mode {
    %orig;
    if (!gDMLinks) gDMLinks = [NSMapTable weakToStrongObjectsMapTable];
    if (![gDMLinks objectForKey:self]) {
        NSArray *st = [NSThread callStackSymbols];
        NSMutableArray *short_ = [NSMutableArray array];
        for (NSUInteger i = 1; i < MIN(st.count, (NSUInteger)8); i++) { NSString *f = st[i]; NSRange r = [f rangeOfString:@"0x"]; [short_ addObject:r.location != NSNotFound ? [f substringFromIndex:r.location] : f]; }
        [gDMLinks setObject:[short_ componentsJoinedByString:@" | "] forKey:self];
    }
}
%end
%hook SpringBoard
- (void)pressesBegan:(NSSet *)presses withEvent:(UIPressesEvent *)event {
    if (DMDebugOn()) {
        for (UIPress *p in presses)
            DMLog([NSString stringWithFormat:@"[keyrecv] SpringBoard got key usage 0x%02lx modifiers 0x%lx", (long)p.key.keyCode, (long)p.key.modifierFlags]);
    }
    %orig;
}
%end
%end

// Debug only (trigger a5trace_<bundle>_<seconds>): who moves that Aerial stage? Aerial 5.0 may not be hooked, so its stage's CALayer position/bounds setters
// (QuartzCore, not Aerial) are hooked once, at runtime, and log the call stack while the trace window is open -- then decode_ turns Aerial's offsets into names.
static __weak CALayer *gTraceLayer = nil;
static CFTimeInterval gTraceUntil = 0;
static int gTraceCount = 0;
static void (*o_layerSetPosition)(id, SEL, CGPoint) = NULL;
static void (*o_layerSetBounds)(id, SEL, CGRect) = NULL;
static void DMTraceLayerChange(CALayer *layer, NSString *what) {
    if (layer != gTraceLayer || CACurrentMediaTime() > gTraceUntil || gTraceCount >= 40) return;
    gTraceCount++;
    NSArray *stack = [NSThread callStackSymbols];
    NSMutableString *s = [NSMutableString stringWithFormat:@"[a5trace] %@", what];
    for (NSUInteger i = 2; i < stack.count && i < 14; i++) [s appendFormat:@"\n    %@", stack[i]];
    DMLog(s);
}
static void h_layerSetPosition(id self, SEL _cmd, CGPoint p) { DMTraceLayerChange(self, [NSString stringWithFormat:@"position %@", NSStringFromCGPoint(p)]); o_layerSetPosition(self, _cmd, p); }
static void h_layerSetBounds(id self, SEL _cmd, CGRect b) { DMTraceLayerChange(self, [NSString stringWithFormat:@"bounds %@", NSStringFromCGRect(b)]); o_layerSetBounds(self, _cmd, b); }
static void (*o_layerSetNeedsLayout)(id, SEL) = NULL;
static void h_layerSetNeedsLayout(id self, SEL _cmd) { DMTraceLayerChange(self, @"setNeedsLayout"); o_layerSetNeedsLayout(self, _cmd); }
static void (*o_layerSetTransform)(id, SEL, CATransform3D) = NULL;
static void h_layerSetTransform(id self, SEL _cmd, CATransform3D t) { DMTraceLayerChange(self, [NSString stringWithFormat:@"transform a=%.3f b=%.3f c=%.3f d=%.3f", t.m11, t.m12, t.m21, t.m22]); o_layerSetTransform(self, _cmd, t); }
static double gTraceNextSecs = 0;   // a5tracenext_: trace the next new window (armed), for this long
static void DMInstallLayerTrace(void) {
    static dispatch_once_t once;
    dispatch_once(&once, ^{
        MSHookMessageEx([CALayer class], @selector(setPosition:), (IMP)h_layerSetPosition, (IMP *)&o_layerSetPosition);
        MSHookMessageEx([CALayer class], @selector(setBounds:), (IMP)h_layerSetBounds, (IMP *)&o_layerSetBounds);
        MSHookMessageEx([CALayer class], @selector(setTransform:), (IMP)h_layerSetTransform, (IMP *)&o_layerSetTransform);
        MSHookMessageEx([CALayer class], @selector(setNeedsLayout), (IMP)h_layerSetNeedsLayout, (IMP *)&o_layerSetNeedsLayout);
    });
}

// `echo key > /tmp/macstatusbar-trigger` runs a test; compared by modification time because SpringBoard
// cannot delete root's files in /tmp.
// Reads memory for the reverse-engineering triggers (decode_, memdump_) through the kernel: an unmapped or protected address fails instead of
// crashing SpringBoard (29 Sep: decode_ followed a -1 pointer, SIGSEGV, Safe Mode on the iPad 2).
static BOOL DMSafeRead(uintptr_t addr, void *out, size_t len) {
    if (!addr || !out || !len) return NO;
    vm_size_t got = 0;
    return vm_read_overwrite(mach_task_self(), (vm_address_t)addr, (vm_size_t)len, (vm_address_t)out, &got) == KERN_SUCCESS && got == len;
}
static void DMRunTrigger(NSString *cmd);
static const void *kA5GripBLKey, *kA5GripBRKey;
static time_t gLastTrigger = -1;   // -1: first poll adopts any leftover trigger file without running it
static void DMCheckTrigger(void) {
    if (!DMDebugOn()) return;
    struct stat st;
    if (stat("/tmp/macstatusbar-trigger", &st) != 0) { if (gLastTrigger == -1) gLastTrigger = 0; return; }
    if (st.st_mtime == gLastTrigger) return;
    BOOL firstPoll = (gLastTrigger == -1);
    gLastTrigger = st.st_mtime;
    if (firstPoll) return;
    NSString *cmd = [[NSString stringWithContentsOfFile:@"/tmp/macstatusbar-trigger" encoding:NSUTF8StringEncoding error:nil]
                     stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
    { NSRange u = [cmd rangeOfString:@"_"]; DMLog([NSString stringWithFormat:@"[trigger] %@", u.location == NSNotFound ? cmd : [cmd substringToIndex:u.location]]); }   // (the command's name only, never its arguments)
    DMRunTrigger(cmd);
}
// seq:<ms>|<cmd>;<ms>|<cmd>...: several triggers from one write, each run <ms> after the write (timed measurements: start a recorder, then act)
static NSString *DMEngineWarningText(NSString *lib, NSString *version, BOOL *needed);
static UIWindow *gEngineWarningWindow;
// ---- debug: who holds this object? (refs_<hex address>) -- the heap blocks that contain a pointer to it, with their class when they are objects.
#import <malloc/malloc.h>
typedef struct { uintptr_t target; uintptr_t hits[600][3]; int n; } DMRefScan;   // (block, size, offset); filled without allocating
static void DMRefRanges(task_t task, void *ctx, unsigned type, vm_range_t *ranges, unsigned count) {
    DMRefScan *scan = ctx;
    for (unsigned i = 0; i < count && scan->n < 600; i++) {
        uintptr_t *p = (uintptr_t *)ranges[i].address; size_t words = ranges[i].size / sizeof(uintptr_t);
        for (size_t k = 0; k < words; k++) if ((p[k] & 0x0000000FFFFFFFFFULL) == scan->target) { scan->hits[scan->n][0] = ranges[i].address; scan->hits[scan->n][1] = ranges[i].size; scan->hits[scan->n][2] = k * sizeof(uintptr_t); scan->n++; break; }
    }
}
static kern_return_t DMRefRead(task_t task, vm_address_t address, vm_size_t size, void **local) { *local = (void *)address; return KERN_SUCCESS; }
static NSString *DMRefsTo(uintptr_t target) {
    static DMRefScan scan; memset(&scan, 0, sizeof(scan)); scan.target = target & 0x0000000FFFFFFFFFULL;
    vm_address_t *zones = NULL; unsigned zc = 0;
    if (malloc_get_all_zones(mach_task_self(), DMRefRead, &zones, &zc) != KERN_SUCCESS) return @"no zones";
    unsigned n = zc > 16 ? 16 : zc; malloc_zone_t *zs[16];
    for (unsigned z = 0; z < n; z++) zs[z] = (malloc_zone_t *)zones[z];
    for (unsigned z = 0; z < n; z++) {
        malloc_zone_t *zone = zs[z];
        if (!zone || !zone->introspect || !zone->introspect->enumerator) continue;
        if (zone->introspect->force_lock) zone->introspect->force_lock(zone);
        zone->introspect->enumerator(mach_task_self(), &scan, MALLOC_PTR_IN_USE_RANGE_TYPE, (vm_address_t)zone, DMRefRead, DMRefRanges);
        if (zone->introspect->force_unlock) zone->introspect->force_unlock(zone);
    }
    unsigned cc = 0; Class *classes = objc_copyClassList(&cc);
    NSMutableSet *known = [NSMutableSet setWithCapacity:cc];
    for (unsigned i = 0; i < cc; i++) [known addObject:[NSValue valueWithPointer:(__bridge void *)classes[i]]];
    free(classes);
    NSMutableString *out = [NSMutableString string];
    for (int i = 0; i < scan.n; i++) {
        uintptr_t isa = *(uintptr_t *)scan.hits[i][0] & 0x0000000FFFFFFFF8ULL;
        NSString *cls = [known containsObject:[NSValue valueWithPointer:(void *)isa]] ? NSStringFromClass((__bridge Class)(void *)isa) : @"?";
        NSString *extra = @"";
        if (([cls hasPrefix:@"_UIStatusBar"] || (DMSBUseSTUI() && [cls hasPrefix:@"STUIStatusBar"])) && ([cls hasSuffix:@"Item"] || [cls hasSuffix:@"ItemState"])) continue;   // (the bar's own items and their states point back at it)
        if ([cls hasPrefix:@"NS"] && [cls hasSuffix:@"LayoutConstraint"]) continue;
        if ([cls hasSuffix:@"Block__"]) {   // a block: whose code it runs
            void *invoke = *(void **)(scan.hits[i][0] + 16); Dl_info info;
            #if __has_feature(ptrauth_calls)
            invoke = __builtin_ptrauth_strip(invoke, 0);
            #endif
            if (dladdr(invoke, &info)) extra = [NSString stringWithFormat:@" runs %s+0x%lx in %s (image offset 0x%lx)", info.dli_sname ?: "?", (unsigned long)((uintptr_t)invoke - (uintptr_t)info.dli_saddr), info.dli_fname ? strrchr(info.dli_fname, '/') + 1 : "?", (unsigned long)((uintptr_t)invoke - (uintptr_t)info.dli_fbase)];
        }
        [out appendFormat:@"\n  0x%lx (%lu bytes, at +%lu) %@%@", (unsigned long)scan.hits[i][0], (unsigned long)scan.hits[i][1], (unsigned long)scan.hits[i][2], cls, extra];
    }
    return out.length ? out : @" none";
}
// The external display's picture from the render server (debug: seeing the TV without a camera).
static void DMCaptureExternalDisplay(void) {
    id disp = nil;
    for (id d in DMCall(objc_getClass("CADisplay"), @"displays")) {
        SEL ext = NSSelectorFromString(@"isExternal");
        if ([d respondsToSelector:ext] && ((BOOL (*)(id, SEL))objc_msgSend)(d, ext)) { disp = d; break; }
    }
    if (!disp) { DMLog(@"[tvshot] no external display"); return; }
    NSString *name = DMCall(disp, @"name");
    id mode = DMCall(disp, @"currentMode");
    long w = mode ? ((long (*)(id, SEL))objc_msgSend)(mode, NSSelectorFromString(@"width")) : 0, h = mode ? ((long (*)(id, SEL))objc_msgSend)(mode, NSSelectorFromString(@"height")) : 0;
    if (w <= 0 || h <= 0 || w > 8000 || h > 8000) { DMLog([NSString stringWithFormat:@"[tvshot] odd size %ld x %ld", w, h]); return; }
    void (*render)(mach_port_t, CFStringRef, void *, int, int) = dlsym(RTLD_DEFAULT, "CARenderServerRenderDisplay");
    void *(*create)(CFDictionaryRef) = dlsym(RTLD_DEFAULT, "IOSurfaceCreate");
    int (*lock)(void *, uint32_t, uint32_t *) = dlsym(RTLD_DEFAULT, "IOSurfaceLock");
    int (*unlock)(void *, uint32_t, uint32_t *) = dlsym(RTLD_DEFAULT, "IOSurfaceUnlock");
    void *(*baseOf)(void *) = dlsym(RTLD_DEFAULT, "IOSurfaceGetBaseAddress");
    size_t (*rowOf)(void *) = dlsym(RTLD_DEFAULT, "IOSurfaceGetBytesPerRow");
    if (!render || !create || !lock || !unlock || !baseOf || !rowOf) { DMLog(@"[tvshot] render server functions missing"); return; }
    int bpr = (int)(w * 4); bpr = (bpr + 63) & ~63;
    NSDictionary *props = @{ @"IOSurfaceWidth": @(w), @"IOSurfaceHeight": @(h), @"IOSurfaceBytesPerElement": @4, @"IOSurfaceBytesPerRow": @(bpr),
                             @"IOSurfaceAllocSize": @(bpr * h), @"IOSurfacePixelFormat": @((unsigned)'BGRA'), @"IOSurfaceIsGlobal": @YES };
    void *surf = create((__bridge CFDictionaryRef)props);
    if (!surf) { DMLog(@"[tvshot] no surface"); return; }
    render(0, (__bridge CFStringRef)name, surf, 0, 0);
    lock(surf, 1, NULL);
    CGColorSpaceRef cs = CGColorSpaceCreateDeviceRGB();
    CGContextRef src = CGBitmapContextCreate(baseOf(surf), (size_t)w, (size_t)h, 8, rowOf(surf), cs, kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
    CGImageRef full = src ? CGBitmapContextCreateImage(src) : NULL;
    unlock(surf, 1, NULL);
    BOOL ok = NO;
    if (full) {
        CGContextRef dst = CGBitmapContextCreate(NULL, (size_t)(w / 2), (size_t)(h / 2), 8, 0, cs, kCGImageAlphaPremultipliedFirst | kCGBitmapByteOrder32Little);
        CGContextDrawImage(dst, CGRectMake(0, 0, w / 2, h / 2), full);
        CGImageRef small = CGBitmapContextCreateImage(dst);
        ok = [UIImagePNGRepresentation([UIImage imageWithCGImage:small]) writeToFile:@"/tmp/macstatusbar-tv.png" atomically:NO];
        CGImageRelease(small); CGContextRelease(dst); CGImageRelease(full);
    }
    if (src) CGContextRelease(src);
    CGColorSpaceRelease(cs); CFRelease(surf);
    DMLog([NSString stringWithFormat:@"[tvshot] %@ (%ld x %ld): %@", name, w, h, ok ? @"written /tmp/macstatusbar-tv.png" : @"FAILED"]);
}
static void DMRunTrigger(NSString *cmd) {
    if ([cmd hasPrefix:@"seq:"]) {
        for (NSString *part in [[cmd substringFromIndex:4] componentsSeparatedByString:@";"]) {
            NSRange bar = [part rangeOfString:@"|"];
            if (bar.location == NSNotFound) continue;
            double ms = [[part substringToIndex:bar.location] doubleValue];
            NSString *sub = [part substringFromIndex:bar.location + 1];
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMLog([NSString stringWithFormat:@"[trigger] (seq) %@", sub]); DMRunTrigger(sub); });
        }
        return;
    }
    if ([cmd isEqualToString:@"key"]) DMSendShortcut(HID_KEY_F, NO);
    else if ([cmd isEqualToString:@"sbregions"]) {   // sbregions: (debug) the main status bar's own regions and display item states -- which item iOS shows, and why not (read-only)
        UIView *fg = DMFindForegroundView(DMStatusBarWindow());
        id bar = fg.superview;
        NSDictionary *regions = nil; @try { regions = [bar valueForKey:@"regions"]; } @catch (id e) {}
        if (![regions isKindOfClass:[NSDictionary class]]) { DMLog([NSString stringWithFormat:@"[sbregions] no regions on %@", NSStringFromClass([bar class])]); return; }
        for (id rid in regions) {
            id r = regions[rid];
            id en = nil, items = nil, lay = nil, guide = nil, view = nil;
            @try { en = [r valueForKey:@"enabled"]; } @catch (id e) {}
            @try { items = [r valueForKey:@"displayItems"]; } @catch (id e) {}
            @try { lay = [r valueForKey:@"layout"]; } @catch (id e) {}
            @try { guide = [r valueForKey:@"layoutItem"]; } @catch (id e) {}
            @try { view = [r valueForKey:@"contentView"]; } @catch (id e) {}
            NSMutableString *m = [NSMutableString stringWithFormat:@"[sbregions] %@ enabled %@ layout %@ guide %@ view %p %@ transform tx %.1f:", rid, en, lay ? NSStringFromClass([lay class]) : @"-",
                [guide isKindOfClass:[UILayoutGuide class]] ? NSStringFromCGRect(((UILayoutGuide *)guide).layoutFrame) : @"-", view, [view isKindOfClass:[UIView class]] ? NSStringFromCGRect(((UIView *)view).frame) : @"-",
                [view isKindOfClass:[UIView class]] ? ((UIView *)view).transform.tx : 0.0];
            for (id it in ([items respondsToSelector:@selector(countByEnumeratingWithState:objects:count:)] ? items : @[])) {
                id iid = nil, ien = nil, ifl = nil, iv = nil;
                @try { iid = [it valueForKey:@"identifier"]; } @catch (id e) {}
                @try { ien = [it valueForKey:@"enabled"]; } @catch (id e) {}
                @try { ifl = [it valueForKey:@"floating"]; } @catch (id e) {}
                @try { iv = [it valueForKey:@"view"]; } @catch (id e) {}
                [m appendFormat:@" %@(enabled %@ floating %@ view %@ in %p)", iid, ien, ifl, iv ? NSStringFromClass([iv class]) : @"-", [iv isKindOfClass:[UIView class]] ? ((UIView *)iv).superview : nil];
            }
            DMLog(m);
        }
        id states = nil; @try { states = [bar valueForKey:@"displayItemStates"]; } @catch (id e) {}
        if ([states isKindOfClass:[NSDictionary class]]) for (id k in states) {
            NSString *d = [states[k] description];
            if ([[k description] rangeOfString:@"Time" options:NSCaseInsensitiveSearch].location != NSNotFound || [[k description] rangeOfString:@"Date" options:NSCaseInsensitiveSearch].location != NSNotFound)
                DMLog([NSString stringWithFormat:@"[sbregions] state %@: %@", k, [d stringByReplacingOccurrencesOfString:@"\n" withString:@" "]]);
        }
    }
    else if ([cmd isEqualToString:@"rtlinfo"]) {   // rtlinfo: right-to-left evidence (1.3.3, H-1) -- the layout direction, each status bar copy's regions, the Home Screen's icon lists and the Dock's icons (read-only)
        UIApplication *app = [UIApplication sharedApplication];
        DMLog([NSString stringWithFormat:@"[rtlinfo] app direction %ld (1 = right-to-left), languages %@, locale %@", (long)app.userInterfaceLayoutDirection,
               [[NSLocale preferredLanguages] componentsJoinedByString:@","], [NSLocale currentLocale].localeIdentifier]);
        NSMutableArray *fgs = [NSMutableArray arrayWithArray:gCopies.allObjects ?: @[]];
        UIView *mainFg = DMFindForegroundView(DMStatusBarWindow());
        if (mainFg && ![fgs containsObject:mainFg]) [fgs addObject:mainFg];
        Class sv = DMSBClass("_UIStatusBarStringView");
        for (UIView *fg in fgs) {
            NSMutableString *m = [NSMutableString stringWithFormat:@"[rtlinfo] copy %p in %@ (hidden %d) width %.0f direction %ld alpha %.2f logo %d hold %d gaveup %d noclock %d; regions:", fg, NSStringFromClass([fg.window class]), fg.window.hidden, fg.bounds.size.width,
                (long)fg.effectiveUserInterfaceLayoutDirection, fg.alpha, objc_getAssociatedObject(fg, kLogoKey) != nil, [objc_getAssociatedObject(fg, kHoldKey) boolValue], objc_getAssociatedObject(fg, kHoldGaveUpKey) != nil, objc_getAssociatedObject(fg, kNoClockLayoutKey) != nil];
            UIView *lead = DMLeadingContainer(fg), *trail = DMTrailingContainer(fg);
            for (UIView *r in fg.subviews) {
                if (![NSStringFromClass([r class]) isEqualToString:@"UIView"]) continue;
                [m appendFormat:@"\n   region %@ laid out %@ shift %.1f%@%@:", NSStringFromCGRect(r.frame), NSStringFromCGRect(DMBarUntransformed(r)), r.transform.tx, r == lead ? @" LEADING" : @"", r == trail ? @" TRAILING" : @""];
                for (UIView *x in r.subviews) {
                    NSString *t = [x isKindOfClass:sv] ? [NSString stringWithFormat:@" \"%@\"", [(UILabel *)x text]] : @"";
                    [m appendFormat:@" %@%@ x %.0f..%.0f a %.2f%@;", NSStringFromClass([x class]), t, CGRectGetMinX([r convertRect:x.frame toView:fg]), CGRectGetMaxX([r convertRect:x.frame toView:fg]), x.alpha, x.hidden ? @" hidden" : @""];
                }
            }
            DMLog(m);
        }
        UIView *page1 = DMDesktopFindPageOne();
        UIView *scroll = page1.superview;
        NSMutableString *h = [NSMutableString stringWithFormat:@"[rtlinfo] home: page one %@ in %@ (offset %@, direction %ld, transform %@); lists:", page1 ? NSStringFromCGRect(page1.frame) : @"none",
            NSStringFromClass([scroll class]), scroll ? NSStringFromCGPoint(((UIScrollView *)scroll).contentOffset) : @"-", (long)scroll.effectiveUserInterfaceLayoutDirection, NSStringFromCGAffineTransform(scroll.transform)];
        id rfc = DMCall(DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager"), @"rootFolderController");
        NSArray *lists = DMCall(DMCall(rfc, @"folder"), @"lists");   // (the root folder's pages, in order: index 0 is page 1)
        for (UIView *l in scroll.subviews) {
            if (![l isKindOfClass:objc_getClass("SBIconListView")]) continue;
            id model = DMCall(l, @"model");
            NSUInteger idx = [lists isKindOfClass:[NSArray class]] && model ? [lists indexOfObjectIdenticalTo:model] : NSNotFound;
            [h appendFormat:@" %@ x %.0f%@ (page %@);", NSStringFromClass([l class]), l.frame.origin.x, l.hidden ? @" hidden" : @"", idx == NSNotFound ? @"?" : @(idx + 1)];
        }
        id rfv = DMCall(rfc, @"rootFolderView") ?: DMCall(rfc, @"folderView");
        for (NSString *selName in @[@"currentPageIndex", @"firstIconPageIndex", @"defaultPageIndex", @"leadingCustomViewPageIndex"]) {
            SEL q = NSSelectorFromString(selName);
            if ([rfv respondsToSelector:q]) [h appendFormat:@" %@ %ld;", selName, ((long (*)(id, SEL))objc_msgSend)(rfv, q)];
        }
        SEL atIdx = NSSelectorFromString(@"iconListViewAtIndex:");
        if ([rfv respondsToSelector:atIdx]) { UIView *l0 = ((id (*)(id, SEL, long))objc_msgSend)(rfv, atIdx, 0); [h appendFormat:@" iconListViewAtIndex:0 = %@ x %.0f;", NSStringFromClass([l0 class]), l0.frame.origin.x]; }
        DMLog(h);
        Class dockList = objc_getClass("SBFloatingDockIconListView");
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) containsString:@"FloatingDock"]) continue;
            NSMutableArray *todo = [NSMutableArray arrayWithObject:w];
            while (todo.count) {
                UIView *v = todo.lastObject; [todo removeLastObject];
                if (dockList && [v isKindOfClass:dockList]) {
                    NSMutableString *d = [NSMutableString stringWithFormat:@"[rtlinfo] dock list %@ direction %ld (icon: its place in the Dock's list, then x on the screen):", NSStringFromCGRect([v convertRect:v.bounds toView:nil]), (long)v.effectiveUserInterfaceLayoutDirection];
                    NSArray *icons = DMCall(DMCall(v, @"model"), @"icons");
                    for (UIView *iv in v.subviews) {
                        id icon = nil; @try { icon = [iv valueForKey:@"icon"]; } @catch (id e) {}
                        NSUInteger idx = icon && [icons isKindOfClass:[NSArray class]] ? [icons indexOfObjectIdenticalTo:icon] : NSNotFound;
                        [d appendFormat:@" %@ x %.0f;", idx == NSNotFound ? @"?" : @(idx), [iv convertRect:iv.bounds toView:nil].origin.x];
                    }
                    DMLog(d);
                    continue;
                }
                [todo addObjectsFromArray:v.subviews];
            }
        }
    }
    else if ([cmd isEqualToString:@"ccgrabber"]) {   // ccgrabber: Control Center's header line (Hide Grabber, MacCCGrabber) in the views CC keeps built -- laid out again, then read (CC not opened)
        Class hc = objc_getClass("CCUIHeaderPocketView");
        int n = 0;
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *todo = [NSMutableArray arrayWithObject:w];
            while (todo.count) {
                UIView *v = todo.lastObject; [todo removeLastObject];
                if (hc && [v isKindOfClass:hc]) {
                    [v setNeedsLayout]; [v layoutIfNeeded];
                    UIView *line = nil; @try { line = [v valueForKey:@"_headerLineView"]; } @catch (id e) {}
                    DMLog([NSString stringWithFormat:@"[ccgrabber] header in %@ (hidden window %d): line %@ hidden %d", NSStringFromClass([w class]), w.hidden, line ? NSStringFromClass([line class]) : @"none", line.hidden]);
                    n++; continue;
                }
                [todo addObjectsFromArray:v.subviews];
            }
        }
        if (!n) DMLog(@"[ccgrabber] no Control Center header built yet");
    }
    else if ([cmd hasPrefix:@"dockapplib_"]) {   // dockapplib_<0|1>: Settings' "Show App Library in Dock", the way its switch sets it (SBFloatingDockDefaults appLibraryEnabled; iPadOS 15 keeps it under another key than 16's SBAppLibraryInDockEnabled)
        id d = DMCall(DMCall(objc_getClass("SBDefaults"), @"localDefaults"), @"floatingDockDefaults");
        SEL get = NSSelectorFromString(@"appLibraryEnabled"), set = NSSelectorFromString(@"setAppLibraryEnabled:");
        if ([d respondsToSelector:get] && [d respondsToSelector:set]) {
            BOOL before = ((BOOL (*)(id, SEL))objc_msgSend)(d, get);
