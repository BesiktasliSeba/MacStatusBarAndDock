    else if ([cmd isEqualToString:@"alertgates"]) {   // alertgates: each gate of the engine warning / respring question (why an alert of ours is not showing; read-only)
        int lt = 0, bt = 0; uint64_t locked = 0, blank = 0;
        notify_register_check("com.apple.springboard.lockstate", &lt); notify_register_check("com.apple.springboard.hasBlankedScreen", &bt);
        if (lt) notify_get_state(lt, &locked);
        if (bt) notify_get_state(bt, &blank);
        id cs = MSBDAlertShared("SBCoverSheetPresentationManager");
        NSArray *acked = (__bridge_transfer NSArray *)CFPreferencesCopyValue(CFSTR("acknowledgedEngineWarnings"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        NSMutableString *libs = [NSMutableString string];
        for (NSString *lib in @[@"Aerial", @"Zetsu", @"MilkyWay4"]) { BOOL needed = NO; NSString *t = DMEngineWarningText(lib, @"", &needed); [libs appendFormat:@" %@ needed %d text %d;", lib, needed, t != nil]; }
        DMLog([NSString stringWithFormat:@"[alertgates] unlocked %d, lockstate %llu, blanked %llu, isUILocked %d, cover visible %d presented %d, busy %d, engine window %p, age %.1f s, acked %@,%@",
            DMScreenOnAndUnlocked(), locked, blank, MSBDAlertCallBool(MSBDAlertShared("SBLockScreenManager"), @"isUILocked"), MSBDAlertCallBool(cs, @"isVisible"), MSBDAlertCallBool(cs, @"isPresented"),
            MSBDAlertBusy(nil), gEngineWarningWindow, DMProcessAge(), acked, libs]);
    }
    else if ([cmd isEqualToString:@"screens"]) {   // screens: every UIScreen (bounds, scale, orientation) and which windows (hidden ones too) live on each (read-only; external display)
        NSArray<UIScreen *> *all = [UIScreen screens];
        NSMutableString *out = [NSMutableString stringWithFormat:@"[screens] %lu screen(s); main %p", (unsigned long)all.count, [UIScreen mainScreen]];
        for (NSUInteger i = 0; i < all.count; i++) {
            UIScreen *sc = all[i];
            NSString *disp = nil; @try { disp = [[sc valueForKey:@"displayIdentity"] description]; } @catch (NSException *e) { disp = @"-"; }
            [out appendFormat:@"\n  screen %lu %p bounds %@ native %@ scale %.1f/%.1f coordinateSpace bounds %@ maxFPS %ld mirrored %p identity %@", (unsigned long)i, sc,
                NSStringFromCGRect(sc.bounds), NSStringFromCGRect(sc.nativeBounds), sc.scale, sc.nativeScale, NSStringFromCGRect(sc.fixedCoordinateSpace.bounds), (long)sc.maximumFramesPerSecond, sc.mirroredScreen, disp];
        }
        for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:NO]) {
            NSUInteger idx = [all indexOfObjectIdenticalTo:w.screen];
            UIWindowScene *ws = w.windowScene;
            [out appendFormat:@"\n  %@ screen %@ level %.0f hidden %d alpha %.2f frame %@ scene %@ %@ orient %ld", NSStringFromClass([w class]), idx == NSNotFound ? @"?" : @(idx), w.windowLevel, w.hidden, w.alpha,
                NSStringFromCGRect(w.frame), ws ? NSStringFromClass([ws class]) : @"-", ws.session.persistentIdentifier ?: @"", ws ? (long)ws.interfaceOrientation : 0L];
        }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"axreducemotion_"]) {   // axreducemotion_<0|1>: Settings > Accessibility > Motion > Reduce Motion (the system setting itself, libAccessibility) -- for gesture tests; put it back
        void (*set)(BOOL) = (void (*)(BOOL))dlsym(RTLD_DEFAULT, "_AXSSetReduceMotionEnabled");
        BOOL (*get)(void) = (BOOL (*)(void))dlsym(RTLD_DEFAULT, "_AXSReduceMotionEnabled");
        if (!set) { void *ax = dlopen("/usr/lib/libAccessibility.dylib", RTLD_LAZY); set = ax ? (void (*)(BOOL))dlsym(ax, "_AXSSetReduceMotionEnabled") : NULL; get = ax ? (BOOL (*)(void))dlsym(ax, "_AXSReduceMotionEnabled") : NULL; }
        BOOL want = [[cmd substringFromIndex:15] boolValue];
        if (set) set(want);
        DMLog([NSString stringWithFormat:@"[debug] Reduce Motion %@ (%@)", want ? @"on" : @"off", set ? (get ? (get() ? @"reads on" : @"reads off") : @"set") : @"no setter"]);
    }
    else if ([cmd isEqualToString:@"winlist"]) {   // winlist: every visible SpringBoard window (class, level, frame, alpha) and its root view controller (read-only)
        NSMutableString *out = [NSMutableString stringWithString:@"[winlist]"];
        for (UIWindow *w in DMAllWindows()) if (!w.hidden)
            [out appendFormat:@"\n  %@ level %.0f frame %@ alpha %.2f root %@ presented %@", NSStringFromClass([w class]), w.windowLevel, NSStringFromCGRect(w.frame), w.alpha, w.rootViewController ? NSStringFromClass([w.rootViewController class]) : @"-", w.rootViewController.presentedViewController ? NSStringFromClass([w.rootViewController.presentedViewController class]) : @"-"];
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"images_"]) {   // images_<substring>: loaded dylibs in SpringBoard whose path contains it (read-only)
        NSString *want = [cmd substringFromIndex:7]; NSMutableString *out = [NSMutableString stringWithFormat:@"[images] matching %@:", want];
        for (uint32_t i = 0; i < _dyld_image_count(); i++) { const char *n = _dyld_get_image_name(i); if (n && strcasestr(n, want.UTF8String)) [out appendFormat:@" %s", n]; }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"nstate_"]) {   // nstate_<name>: read a Darwin notification state (MacPointer in pointeruid reports through these)
        int tok = 0; uint64_t v = 0;
        if (notify_register_check([cmd substringFromIndex:7].UTF8String, &tok) == NOTIFY_STATUS_OK) { notify_get_state(tok, &v); notify_cancel(tok); }
        DMLog([NSString stringWithFormat:@"[debug] state %@ = %llu (0x%llx)", [cmd substringFromIndex:7], v, v]);
    }
    else if ([cmd hasPrefix:@"prefint_"]) {   // prefint_<domain>|<key>|<n|x.y|del>: write (or remove) a number preference through cfprefsd (tests; with a "." it is stored as a float, as a Settings slider does)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"|"];
        if (q.count == 3) {
            CFPreferencesSetValue((__bridge CFStringRef)q[1], [q[2] isEqualToString:@"del"] ? NULL : (__bridge CFNumberRef)([q[2] containsString:@"."] ? @([q[2] floatValue]) : @([q[2] integerValue])), (__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize((__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[debug] %@ %@ = %@", q[0], q[1], q[2]]);
        }
    }
    else if ([cmd isEqualToString:@"ccsm"]) {   // ccsm: Control Center's Stage Manager button -- what its controller, its module and the setting say (debug, read-only)
        Class vcClass = objc_getClass("SBContinuousExposeModuleViewController");
        id sd = DMSwitcherDefaults();
        BOOL on = [sd respondsToSelector:NSSelectorFromString(@"chamoisWindowingEnabled")] ? ((BOOL (*)(id, SEL))objc_msgSend)(sd, NSSelectorFromString(@"chamoisWindowingEnabled")) : NO;
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"]) continue;
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                UIResponder *r = v.nextResponder;
                if (vcClass && [r isKindOfClass:vcClass]) {
                    UIViewController *vc = (UIViewController *)r;
                    BOOL sel = [vc respondsToSelector:NSSelectorFromString(@"isSelected")] ? ((BOOL (*)(id, SEL))objc_msgSend)(vc, NSSelectorFromString(@"isSelected")) : 9;
                    BOOL should = [vc respondsToSelector:NSSelectorFromString(@"_shouldShowToggleSelected")] ? ((BOOL (*)(id, SEL))objc_msgSend)(vc, NSSelectorFromString(@"_shouldShowToggleSelected")) : 9;
                    NSMutableArray *chain = [NSMutableArray array];
                    for (UIViewController *p = vc.parentViewController; p; p = p.parentViewController) {
                        NSString *d = NSStringFromClass([p class]);
                        if ([p respondsToSelector:NSSelectorFromString(@"contentModule")]) {
                            id m = ((id (*)(id, SEL))objc_msgSend)(p, NSSelectorFromString(@"contentModule"));
                            BOOL ms = [m respondsToSelector:NSSelectorFromString(@"isSelected")] ? ((BOOL (*)(id, SEL))objc_msgSend)(m, NSSelectorFromString(@"isSelected")) : 9;
                            d = [d stringByAppendingFormat:@"(module %@ selected %d)", NSStringFromClass([m class]), ms];
                        }
                        [chain addObject:d];
                    }
                    NSMutableArray *sub = [NSMutableArray array];
                    NSMutableArray *st2 = [NSMutableArray arrayWithObject:vc.view];
                    while (st2.count && sub.count < 30) {
                        UIView *u = st2.lastObject; [st2 removeLastObject]; [st2 addObjectsFromArray:u.subviews];
                        NSString *e = NSStringFromClass([u class]);
                        if ([u isKindOfClass:[UIControl class]]) e = [e stringByAppendingFormat:@"[sel %d]", ((UIControl *)u).selected];
                        [sub addObject:e];
                    }
                    DMLog([NSString stringWithFormat:@"[ccsm] setting %d; vc %@ selected %d shouldShowSelected %d; parents %@; views %@", on, NSStringFromClass([vc class]), sel, should,
                           [chain componentsJoinedByString:@" < "], [sub componentsJoinedByString:@" "]]);
                    continue;
                }
                [stack addObjectsFromArray:v.subviews];
            }
        }
    }
    else if ([cmd hasPrefix:@"prefarray_"]) {   // prefarray_<domain>|<key>|<a,b,c>: write an array of strings through cfprefsd (tests: put a list such as goApps back exactly)
        NSArray *q = [[cmd substringFromIndex:10] componentsSeparatedByString:@"|"];
        if (q.count == 3) {
            NSArray *items = [q[2] length] ? [q[2] componentsSeparatedByString:@","] : @[];
            CFPreferencesSetValue((__bridge CFStringRef)q[1], (__bridge CFArrayRef)items, (__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize((__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[debug] %@ %@ = %@", q[0], q[1], [items componentsJoinedByString:@", "]]);
        }
    }
    else if ([cmd hasPrefix:@"notify_"]) { notify_post([cmd substringFromIndex:7].UTF8String); DMLog([NSString stringWithFormat:@"[debug] posted %@", [cmd substringFromIndex:7]]); }   // notify_<name>: post that Darwin notification (what a Settings switch posts)
    else if ([cmd hasPrefix:@"prefdel_"]) {   // prefdel_<domain>|<key>: removes one stored setting (test clean-up: a test wrote it, the user never had it)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"|"];
        if (q.count == 2 && [q[0] length] && [q[1] length]) {
            CFPreferencesSetValue((__bridge CFStringRef)q[1], NULL, (__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize((__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[debug] prefdel: %@ %@ removed", q[0], q[1]]);
        }
    }
    else if ([cmd hasPrefix:@"audiosim_"]) {   // audiosim_<bundle,bundle,...> | audiosim_off: pretend these apps are playing (single-source tests, debug)
        extern NSArray<NSString *> *gDMAudioSim;
        NSString *list = [cmd substringFromIndex:9];
        gDMAudioSim = [list isEqualToString:@"off"] ? nil : ([list isEqualToString:@"none"] ? @[] : [list componentsSeparatedByString:@","]);
        DMLog([NSString stringWithFormat:@"[debug] audiosim: %@", gDMAudioSim ?: @"off (the system's list)"]);
    }
    else if ([cmd hasPrefix:@"ringer_"]) {   // ringer_0 / ringer_1: the ringer unmuted / muted through SpringBoard's ringer control, as Control Center does (debug)
        BOOL want = [[cmd substringFromIndex:7] boolValue];
        SEL set = NSSelectorFromString(@"setRingerMuted:");
        DMReadRingerState();
        if ([gRingerControl respondsToSelector:set]) ((void (*)(id, SEL, BOOL))objc_msgSend)(gRingerControl, set, want);
        DMLog([NSString stringWithFormat:@"[debug] ringer_%d (control %@)", want, gRingerControl ? @"found" : @"MISSING"]);
    }
    else if ([cmd isEqualToString:@"mutestate"]) {   // the mute icon in every status bar copy: shown or not, where, what colour (debug)
        DMReadRingerState();
        NSMutableString *out = [NSMutableString stringWithFormat:@"[mute] ringer muted %d, switch %d, Single Mute %@", gRingerMuted, gShowMuteIcon, MSBDOtherTweakDoing(kMSBDDupMuteIcon, YES) ? @"doing it" : @"no"];
        for (UIView *fg in gCopies.allObjects) {
            UIImageView *m = objc_getAssociatedObject(fg, kMuteIconKey);
            [out appendFormat:@"\n  %@ (window %@ hidden %d): icon %@", NSStringFromClass([fg.window class]), fg.window ? @"yes" : @"no", fg.window.hidden, m ? [NSString stringWithFormat:@"hidden %d frame %@ tint %@", m.hidden, NSStringFromCGRect(m.frame), m.tintColor] : @"none"];
        }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"audiomix_"]) {   // audiomix_0 / audiomix_1: Audio Mixing off / on, as the Audio menu's switch does (debug)
        BOOL on = [[cmd substringFromIndex:9] boolValue];
        CFPreferencesSetValue(CFSTR("mixAudio"), on ? kCFBooleanTrue : kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        DMLoadPrefs();
        DMLog([NSString stringWithFormat:@"[audio] Audio Mixing switched %@ (debug)", on ? @"on" : @"off"]);
        DMAudioSingleSourceUpdate(gAudioPlayingBundleIDs, YES);
    }
    else if ([cmd hasPrefix:@"audiovol_"]) {   // audiovol_<bundle>_<0..1>: set that app's Audio-menu slider, as dragging it does (debug)
        NSString *rest = [cmd substringFromIndex:9]; NSRange u = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (u.location != NSNotFound) { NSString *bid = [rest substringToIndex:u.location]; float v = [[rest substringFromIndex:u.location + 1] floatValue];
            DMSetAudioVolumeAndNotify(bid, v, YES); DMLog([NSString stringWithFormat:@"[debug] audiovol %@ = %.2f", bid, v]); }
    }
    else if ([cmd hasPrefix:@"audiostate_"]) {   // audiostate_<bundle>: the multiplier MixAudio in that app would apply now (debug)
        NSString *bid = [cmd substringFromIndex:11];
        uint64_t st = 0; int t = DMAudioVolumeToken(bid); if (t) notify_get_state(t, &st);
        DMLog([NSString stringWithFormat:@"[debug] audiostate %@: %@ (saved slider %.2f, silenced %d, in a call %d, heard %@)", bid, st ? [NSString stringWithFormat:@"%.2f", (st - 1) / 1000000.0] : @"never set (1.00)", DMAudioVolumeForBundle(bid), DMAudioIsSourceMuted(bid), DMAudioInCall(bid), gDMAudioSource]);
    }
    else if ([cmd hasPrefix:@"sysvol"]) {   // sysvol / sysvol_<0..1>: read / set the media volume (what the volume buttons change) -- keeps test audio quiet (debug)
        id avsc = DMCall(objc_getClass("AVSystemController"), @"sharedAVSystemController");
        SEL setSel = NSSelectorFromString(@"setVolumeTo:forCategory:"), getSel = NSSelectorFromString(@"getVolume:forCategory:");
        if (cmd.length > 7 && [avsc respondsToSelector:setSel]) ((BOOL (*)(id, SEL, float, id))objc_msgSend)(avsc, setSel, [[cmd substringFromIndex:7] floatValue], @"Audio/Video");
        float vol = -1;
        if ([avsc respondsToSelector:getSel]) ((BOOL (*)(id, SEL, float *, id))objc_msgSend)(avsc, getSel, &vol, @"Audio/Video");
        DMLog([NSString stringWithFormat:@"[debug] sysvol: media volume %.2f", vol]);
    }
    else if ([cmd isEqualToString:@"nowplaying"] || [cmd hasPrefix:@"mrcmd_"]) {   // nowplaying: the system's Now Playing app (the Lock Screen / Control Center player) and whether it plays -- pid and bundle only, never the track; mrcmd_<n>: send MediaRemote command n to it as the Control Center player does (0 play, 1 pause, 2 toggle) (debug)
        static void *mr; if (!mr) mr = dlopen("/System/Library/PrivateFrameworks/MediaRemote.framework/MediaRemote", RTLD_LAZY);
        void (*getPid)(dispatch_queue_t, void (^)(int)) = mr ? (void (*)(dispatch_queue_t, void (^)(int)))dlsym(mr, "MRMediaRemoteGetNowPlayingApplicationPID") : NULL;
        void (*getPlaying)(dispatch_queue_t, void (^)(Boolean)) = mr ? (void (*)(dispatch_queue_t, void (^)(Boolean)))dlsym(mr, "MRMediaRemoteGetNowPlayingApplicationIsPlaying") : NULL;
        Boolean (*send)(uint32_t, CFDictionaryRef) = mr ? (Boolean (*)(uint32_t, CFDictionaryRef))dlsym(mr, "MRMediaRemoteSendCommand") : NULL;
        if (!getPid || !getPlaying || !send) { DMLog(@"[nowplaying] MediaRemote functions missing"); return; }
        if ([cmd hasPrefix:@"mrcmd_"]) { uint32_t c = (uint32_t)[[cmd substringFromIndex:6] intValue]; Boolean ok = send(c, NULL); DMLog([NSString stringWithFormat:@"[nowplaying] command %u sent: %d", c, ok]); return; }
        getPid(dispatch_get_main_queue(), ^(int pid) {
            getPlaying(dispatch_get_main_queue(), ^(Boolean playing) {
                NSString *bid = nil;
                SEL pidSel = NSSelectorFromString(@"pid");
                for (id process in (NSArray *)DMCall(DMCall(objc_getClass("FBProcessManager"), @"sharedInstance"), @"allApplicationProcesses"))
                    if ([process respondsToSelector:pidSel] && ((int (*)(id, SEL))objc_msgSend)(process, pidSel) == pid) bid = [DMCall(process, @"bundleIdentifier") description];
                char name[64] = {0}; if (pid > 0) proc_name(pid, name, sizeof name);
                id avsc = DMCall(objc_getClass("AVSystemController"), @"sharedAVSystemController");
                id disp = [avsc respondsToSelector:NSSelectorFromString(@"attributeForKey:")] ? ((id (*)(id, SEL, id))objc_msgSend)(avsc, NSSelectorFromString(@"attributeForKey:"), @"AVSystemController_NowPlayingAppDisplayIDAttribute") : nil;
                DMLog([NSString stringWithFormat:@"[nowplaying] app pid %d (%s) %@, playing %d; audio controller says %@", pid, name, bid ?: @"-", playing, disp ?: @"-"]);
            });
        });
    }
    else if ([cmd isEqualToString:@"audiomenu"]) {   // audiomenu: open the status bar's Audio menu (MixAudio's per-app sliders)
        UIView *fg = nil;
        for (UIView *v in gCopies.allObjects) if (v.window && !v.window.hidden && v.bounds.size.width > 300) { fg = v; break; }
        UIButton *b = fg ? objc_getAssociatedObject(fg, kAudioButtonKey) : nil;
        DMLog([NSString stringWithFormat:@"[debug] audiomenu: button %@", b ? @"found" : @"missing (no Audio title showing)"]);
        if (b) DMOpenAudioMenu(b);
    }
    else if ([cmd isEqualToString:@"apple"]) {
        UIView *fg = nil;
        for (UIView *v in gCopies.allObjects) if (v.window && !v.window.hidden && v.bounds.size.width > 300) { fg = v; break; }
        UIButton *b = fg ? objc_getAssociatedObject(fg, kButtonKey) : nil;
        if (b) DMOpenMenu(b);
    }
    else if ([cmd hasPrefix:@"frames_"]) {   // frames_<count>_<interval ms>: save a burst of half-size screenshots to /tmp/msbframe-NN.png
        NSArray *parts = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        int count = [parts.firstObject intValue]; double gap = parts.count > 1 ? [parts[1] doubleValue] / 1000.0 : 0.15;
        for (int i = 0; i < count; i++) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * gap * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *snap = [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO];
            UIWindow *host = DMStatusBarWindow();
            if (!snap || !host) return;
            [host addSubview:snap];
            UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 0.5;
            UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:snap.bounds.size format:fmt];
            UIImage *img = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) { [snap drawViewHierarchyInRect:snap.bounds afterScreenUpdates:YES]; }];
            [snap removeFromSuperview];
            [UIImagePNGRepresentation(img) writeToFile:[NSString stringWithFormat:@"/tmp/msbframe-%02d.png", i] atomically:NO];
        });
    }
    else if ([cmd hasPrefix:@"flashwatch_"]) {   // flashwatch_<seconds>: log the screen's brightness ~30 times a second (a white flash on a dark app shows as a spike)
        DMWatchBrightness([[cmd substringFromIndex:11] doubleValue]);
    }
    else if ([cmd hasPrefix:@"whitewatch_"]) {   // whitewatch_<seconds>: log every big light-coloured view that appears on screen, per display frame
        DMWatchWhite([[cmd substringFromIndex:11] doubleValue]);
    }
    else if ([cmd hasPrefix:@"dockrec_"]) DMRecordDockRecents([[cmd substringFromIndex:8] doubleValue]);   // dockrec_<seconds>: the Dock's recents, per frame, on change
    else if ([cmd hasPrefix:@"arecord_"]) {   // arecord_<seconds>: log the on-screen (presentation) frame of every stage on each display frame
        DMRecordStages([[cmd substringFromIndex:8] doubleValue]);
    }
    else if ([cmd isEqualToString:@"tvshot"]) DMCaptureExternalDisplay();   // tvshot: what the external display (TV) shows -> /tmp/macstatusbar-tv.png (half size)
    else if ([cmd isEqualToString:@"sbdiag"]) DMSBDiagFlush();   // sbdiag: write the status bar diagnostic record now (untested iPadOS, or debug with /tmp/msb-diag-test)
    else if ([cmd isEqualToString:@"rawshot"]) {   // the framebuffer as it really is (UIKit's own screen capture, native orientation) -> /tmp/macstatusbar-raw.png
        // (_UICreateScreenUIImage is a Create function: the caller owns the image. Called through a plain UIImage-returning pointer, ARC retained it
        //  once more and it was never freed -- about 15 MB of SpringBoard memory per capture (904 MB on the M1 after a test run, 30 Sep). Taken as a
        //  CF object and handed to ARC exactly once.)
        CFTypeRef (*grab)(void) = (CFTypeRef (*)(void))dlsym(RTLD_DEFAULT, "_UICreateScreenUIImage");
        BOOL ok = NO; CGSize sz = CGSizeZero; BOOL got = NO;
        @autoreleasepool {
            UIImage *img = grab ? (UIImage *)CFBridgingRelease(grab()) : nil;
            got = img != nil; if (img) sz = img.size;
            ok = img && [UIImagePNGRepresentation(img) writeToFile:@"/tmp/macstatusbar-raw.png" atomically:NO];
        }
        DMLog([NSString stringWithFormat:@"[debug] raw screen capture %@ (%@)", ok ? @"written" : @"FAILED", got ? NSStringFromCGSize(sz) : @"no image"]);
    }
    else if ([cmd isEqualToString:@"dylibs"]) {   // dylibs: every tweak library loaded into SpringBoard (read-only) -- which window engines really load
        NSMutableArray *names = [NSMutableArray array];
        for (uint32_t i = 0; i < _dyld_image_count(); i++) {
            const char *p = _dyld_get_image_name(i);
            if (p && (strstr(p, "DynamicLibraries") || strstr(p, "TweakInject"))) [names addObject:[@(p) lastPathComponent]];
        }
        DMLog([NSString stringWithFormat:@"[dylibs] %lu tweak libraries: %@", (unsigned long)names.count, [names componentsJoinedByString:@" "]]);
    }
    else if ([cmd isEqualToString:@"kbfocus"]) {   // kbfocus: which host shows the keyboard, every keyboard host with its owner, and SpringBoard's keyboard focus (read-only)
        NSMutableString *out = [NSMutableString stringWithString:@"[kbfocus]"];
        UIView *shown = DMKeyboardPresentingHost();
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                if ([NSStringFromClass([v class]) isEqualToString:@"_UIKeyboardLayerHostView"]) {
                    id owner = DMKeyboardHostOwningScene(v);
                    Ivar pi = class_getInstanceVariable([v class], "_isPaired"), ti = class_getInstanceVariable([v class], "_keyboardPreferredHostIdentity");
                    BOOL paired = pi ? *(BOOL *)((uint8_t *)(__bridge void *)v + ivar_getOffset(pi)) : NO;
                    id pref = ti ? object_getIvar(v, ti) : nil;
                    [out appendFormat:@"\n  host %p in %@ (level %.1f) owner %@ paired %d preferred %@%@", v, NSStringFromClass([w class]), w.windowLevel, [owner valueForKey:@"identifier"], paired, pref, v == shown ? @"  <-- SHOWS THE KEYBOARD" : @""];
                    continue;
                }
                if ([NSStringFromClass([v class]) isEqualToString:@"_UIScenePresentationView"]) continue;
                [stack addObjectsFromArray:v.subviews];
            }
        }
        id kfc = DMKeyboardFocusController();
        int pid = [kfc respondsToSelector:NSSelectorFromString(@"presentingKeyboardProcessIdentifier")] ? ((int (*)(id, SEL))objc_msgSend)(kfc, NSSelectorFromString(@"presentingKeyboardProcessIdentifier")) : -1;
        id ext = [kfc respondsToSelector:NSSelectorFromString(@"externalSceneWithFocus")] ? DMCall(kfc, @"externalSceneWithFocus") : nil;
        Ivar tsi = kfc ? class_getInstanceVariable([kfc class], "_targetSceneForKeyboardFocusDeferring") : NULL;
        id target = tsi ? object_getIvar(kfc, tsi) : nil;
        [out appendFormat:@"\n  focus: presenting keyboard pid %d, external scene with focus %@, deferring target scene %@", pid, [ext valueForKey:@"identifier"], [target valueForKey:@"identifier"]];
        @try { [out appendFormat:@"\n  controller: %@", [kfc description]]; } @catch (id e) {}
        for (NSString *b in @[@"com.apple.mobilenotes", @"com.apple.mobilesafari"]) { SBApplication *a = DMAppForBundle(b); [out appendFormat:@"\n  pid of %@ = %d", b, a ? ((int (*)(id, SEL))objc_msgSend)(DMCall(a, @"processState"), NSSelectorFromString(@"pid")) : -1]; }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"kbrefocus_"]) {   // kbrefocus_<bundle>: ask SpringBoard to give keyboard focus to that app's scene (what a tap in it does)
        id scene = DMSceneForBundle([cmd substringFromIndex:10]);
        id kfc = DMKeyboardFocusController();
        SEL sel = NSSelectorFromString(@"userFocusRequestForScene:reason:");
        if (scene && [kfc respondsToSelector:sel]) ((void (*)(id, SEL, id, id))objc_msgSend)(kfc, sel, scene, @"MacStatusBar debug");
        DMLog([NSString stringWithFormat:@"[kbfocus] focus requested for %@ (scene %@)", [cmd substringFromIndex:10], [scene valueForKey:@"identifier"]]);
    }
    else if ([cmd isEqualToString:@"kbscenes"]) {   // kbscenes: which scenes Aerial's keyboard host is bound to, and every keyboard scene SpringBoard has (read-only)
        NSMutableString *out = [NSMutableString stringWithString:@"[kbscenes]"];
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
            for (UIView *v in w.subviews) {
                if (![NSStringFromClass([v class]) isEqualToString:@"_UIKeyboardLayerHostView"]) continue;
                for (NSString *n in @[@"_owningScene", @"_keyboardScene"]) {
                    Ivar iv = class_getInstanceVariable([v class], n.UTF8String);
                    id val = iv ? object_getIvar(v, iv) : nil;
                    id client = nil; @try { client = [val valueForKey:@"clientProcess"]; } @catch (id e) {}
                    [out appendFormat:@"\n  host %@ = %@ client %@", n, val ? [NSString stringWithFormat:@"%p %@", val, [val valueForKey:@"identifier"]] : @"nil", client];
                }
            }
        }
        id mgr = DMCall(objc_getClass("FBSceneManager"), @"sharedInstance");
        id all = nil; @try { all = [mgr valueForKey:@"scenes"]; } @catch (id e) {}
        if ([all respondsToSelector:@selector(countByEnumeratingWithState:objects:count:)])
            for (id sc in all) {
                NSString *ident = nil; @try { ident = [sc valueForKey:@"identifier"]; } @catch (id e) {}
                if (![ident.lowercaseString containsString:@"keyboard"]) continue;
                id client = nil; @try { client = [sc valueForKey:@"clientProcess"]; } @catch (id e) {}
                [out appendFormat:@"\n  scene %p %@ client %@", sc, ident, client];
            }
        else [out appendFormat:@"\n  (no scene list: %@)", NSStringFromClass([all class])];
        DMLog(out);
    }
    else if ([cmd isEqualToString:@"kblayers"]) {   // kblayers: the layer tree inside Aerial's keyboard window (class, frame, hidden, and the hosted context id of CALayerHosts), read-only
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
            NSMutableString *out = [NSMutableString stringWithString:@"[kblayers]"];
            __block void (^walk)(CALayer *, int) = nil;
            void (^walker)(CALayer *, int) = ^(CALayer *l, int d) {
                NSString *extra = @"";
                if ([l respondsToSelector:NSSelectorFromString(@"contextId")]) extra = [NSString stringWithFormat:@" contextId %u", ((unsigned int (*)(id, SEL))objc_msgSend)(l, NSSelectorFromString(@"contextId"))];
                [out appendFormat:@"\n%*s%@ %@ hidden %d opacity %.2f sublayers %lu%@", d * 2, "", NSStringFromClass([l class]), NSStringFromCGRect(l.frame), l.hidden, l.opacity, (unsigned long)l.sublayers.count, extra];
                if (d < 8) for (CALayer *c in l.sublayers) walk(c, d + 1);
            };
            walk = walker;
            walker(w.layer, 0);
            DMLog(out);
        }
    }
    else if ([cmd isEqualToString:@"thermal"]) {   // thermal: the device's thermal state (0 nominal, 1 fair, 2 serious, 3 critical) and battery temperature, read-only
        long state = (long)[NSProcessInfo processInfo].thermalState;
        double tempC = -1;
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        if (iokit) {
            CFMutableDictionaryRef (*matching)(const char *) = (CFMutableDictionaryRef (*)(const char *))dlsym(iokit, "IOServiceMatching");
            unsigned int (*getService)(unsigned int, CFDictionaryRef) = (unsigned int (*)(unsigned int, CFDictionaryRef))dlsym(iokit, "IOServiceGetMatchingService");
            CFTypeRef (*getProp)(unsigned int, CFStringRef, CFAllocatorRef, unsigned int) = (CFTypeRef (*)(unsigned int, CFStringRef, CFAllocatorRef, unsigned int))dlsym(iokit, "IORegistryEntryCreateCFProperty");
            int (*release)(unsigned int) = (int (*)(unsigned int))dlsym(iokit, "IOObjectRelease");
            if (matching && getService && getProp && release) {
                unsigned int svc = getService(0, matching("AppleSmartBattery"));   // (the matching dictionary is consumed)
                if (svc) {
                    CFTypeRef t = getProp(svc, CFSTR("Temperature"), kCFAllocatorDefault, 0);
                    if (t && CFGetTypeID(t) == CFNumberGetTypeID()) { int v = 0; CFNumberGetValue((CFNumberRef)t, kCFNumberIntType, &v); tempC = v / 100.0; }
                    if (t) CFRelease(t);
                    release(svc);
                }
            }
        }
        DMLog([NSString stringWithFormat:@"[thermal] state %ld (0 nominal, 1 fair, 2 serious, 3 critical), battery %.1f C, low power %d", state, tempC, [NSProcessInfo processInfo].isLowPowerModeEnabled]);
    }
    else if ([cmd isEqualToString:@"outsidetap"]) { extern void DMOutsideTouch(void); DMOutsideTouch(); }   // what a touch on the Home Screen / Dock outside the windows does
    else if ([cmd isEqualToString:@"a5swallow"]) { unlink("/tmp/msb-a5-heldoff"); gA5PrefsState = 1; DMAerial5SwallowPrefs(@"a5swallow trigger"); }   // hold Aerial 5.0's settings now (as when it becomes our engine)
    else if ([cmd isEqualToString:@"a5giveback"]) {   // give the user's own back now (as when it stops being our engine) and leave them (flag /tmp/msb-a5-heldoff) until a5swallow or the next SpringBoard start
        int fd = open("/tmp/msb-a5-heldoff", O_CREAT | O_WRONLY, 0644); if (fd >= 0) close(fd);
        gA5PrefsState = 2; DMAerial5GiveBackPrefs(@"a5giveback trigger");
    }
    else if ([cmd hasPrefix:@"a5pref_"]) {   // a5pref_<key>_<int|del>: set (or remove) one of Aerial 5.0's own settings and tell it to reload -- for testing
        NSString *rest = [cmd substringFromIndex:7];
        NSRange us = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (us.location != NSNotFound) {
            NSString *key = [rest substringToIndex:us.location], *val = [rest substringFromIndex:us.location + 1];
            CFStringRef domain = CFSTR("jp.uzra.aerial");
            if ([val isEqualToString:@"del"]) CFPreferencesSetAppValue((__bridge CFStringRef)key, NULL, domain);
            else CFPreferencesSetAppValue((__bridge CFStringRef)key, (__bridge CFPropertyListRef)@([val intValue]), domain);
            CFPreferencesAppSynchronize(domain);
            CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFSTR("jp.uzra.aerial/ReloadPrefs"), NULL, NULL, true);
            CFArrayRef keys = CFPreferencesCopyKeyList(domain, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[a5pref] %@ = %@ (reload posted); keys now: %@", key, val, (__bridge_transfer NSArray *)keys]);
        }
    }
    else if ([cmd hasPrefix:@"a5drag_"]) {   // a5drag_<bundle>: the window's recognisers and the drag decision for sample points
        UIView *stage = DMStageForBundle([cmd substringFromIndex:7]);
        if (stage) {
            NSMutableString *out = [NSMutableString string];
            for (UIGestureRecognizer *g in stage.gestureRecognizers) [out appendFormat:@" %@(enabled %d state %ld delegate %@)", NSStringFromClass([g class]), g.enabled, (long)g.state, NSStringFromClass([g.delegate class])];
            UIView *inner = DMStageInnerView(stage);
            CGSize S = stage.bounds.size; CGFloat top = inner ? inner.frame.origin.y : 13.0;
            NSMutableString *dec = [NSMutableString string];
            for (NSValue *v in @[[NSValue valueWithCGPoint:CGPointMake(S.width / 2, top / 2)], [NSValue valueWithCGPoint:CGPointMake(30, top / 2)], [NSValue valueWithCGPoint:CGPointMake(S.width / 2, top + 20)], [NSValue valueWithCGPoint:CGPointMake(S.width / 2, S.height / 2)], [NSValue valueWithCGPoint:CGPointMake(S.width / 2, S.height - 8)], [NSValue valueWithCGPoint:CGPointMake(3, S.height / 2)]])
                [dec appendFormat:@" %@=%@", NSStringFromCGPoint(v.CGPointValue), DMA5DragAllowedAt(stage, v.CGPointValue) ? @"drag" : @"no-drag"];
            DMLog([NSString stringWithFormat:@"[a5drag] %@ recognisers:%@ | scroll mask %ld | decisions:%@", [cmd substringFromIndex:7], out, (long)DMA5AerialDrag(stage).allowedScrollTypesMask, dec]);
        }
    }
    else if ([cmd hasPrefix:@"a5min_"]) {   // a5min_<bundle>: ask Aerial itself to minimize that window (its resolved minimize, identity transform), to test the chip catch
        UIView *stage = DMStageForBundle([cmd substringFromIndex:6]);
        SEL sel = DMAerialSel(@"minimizeStage");
        if (stage && gAerialMinimizeTakesTransform && [stage respondsToSelector:sel]) {
            DMLog([NSString stringWithFormat:@"[a5min] asking Aerial to minimize %@", [cmd substringFromIndex:6]]);
            ((void (*)(id, SEL, CGAffineTransform))objc_msgSend)(stage, sel, CGAffineTransformIdentity);
            DMLog(@"[a5min] Aerial's minimize returned");
        } else DMLog(@"[a5min] no stage or no resolved minimize");
    }
    else if ([cmd hasPrefix:@"a5state_"]) {   // a5state_<bundle>_<x>_<y>_<w>_<h>: write Aerial's remembered frame for the current screen shape (_landscapeFrame / _portraitFrame) -- experiment
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        if (q.count < 5) return;
        UIView *stage = DMStageForBundle(q[0]);
        CGSize sc = [UIScreen mainScreen].bounds.size;
        BOOL land = sc.width > sc.height;
        Ivar fr = stage ? class_getInstanceVariable([stage class], land ? "_landscapeFrame" : "_portraitFrame") : NULL;
        Ivar has = stage ? class_getInstanceVariable([stage class], land ? "_hasLandscapeState" : "_hasPortraitState") : NULL;
        if (!fr || !has || strncmp(ivar_getTypeEncoding(fr), "{CGRect", 7) || ivar_getTypeEncoding(has)[0] != 'B') { DMLog(@"[a5state] ivars missing or of another type"); return; }
        CGRect *slot = (CGRect *)((uint8_t *)(__bridge void *)stage + ivar_getOffset(fr));
        BOOL *hasSlot = (BOOL *)((uint8_t *)(__bridge void *)stage + ivar_getOffset(has));
        CGRect was = *slot;
        *slot = CGRectMake([q[1] doubleValue], [q[2] doubleValue], [q[3] doubleValue], [q[4] doubleValue]); *hasSlot = YES;
        Ivar tr = q.count > 5 ? class_getInstanceVariable([stage class], land ? "_landscapeTransform" : "_portraitTransform") : NULL;   // [_<scale>]: the remembered transform too
        if (tr && !strncmp(ivar_getTypeEncoding(tr), "{CGAffineTransform", 18)) { CGFloat k = [q[5] doubleValue]; *(CGAffineTransform *)((uint8_t *)(__bridge void *)stage + ivar_getOffset(tr)) = CGAffineTransformMakeScale(k, k); }
        DMLog([NSString stringWithFormat:@"[a5state] %@ %s %@ -> %@%@", q[0], land ? "_landscapeFrame" : "_portraitFrame", NSStringFromCGRect(was), NSStringFromCGRect(*slot), tr ? [NSString stringWithFormat:@" at scale %@", q[5]] : @""]);
    }
    else if ([cmd hasPrefix:@"a5allivars_"]) {   // a5allivars_<bundle>: every scalar / rect / object-class ivar of that stage (whole class chain up to UIView) -- read-only
        UIView *stage = DMStageForBundle([cmd substringFromIndex:11]);
        if (!stage) { DMLog(@"[a5allivars] no such window"); return; }
        NSMutableString *out = [NSMutableString stringWithFormat:@"[a5allivars] %@ %@:", [cmd substringFromIndex:11], NSStringFromCGRect(stage.frame)];
        for (Class c = [stage class]; c && c != [UIView class]; c = class_getSuperclass(c)) {
            unsigned n = 0; Ivar *ivs = class_copyIvarList(c, &n);
            for (unsigned i = 0; i < n; i++) {
                const char *t = ivar_getTypeEncoding(ivs[i]); if (!t) continue;
                uint8_t *p = (uint8_t *)(__bridge void *)stage + ivar_getOffset(ivs[i]);
                NSString *v = nil;
                if (t[0] == 'B' || t[0] == 'c' || t[0] == 'C') v = [NSString stringWithFormat:@"%d", *(uint8_t *)p];
                else if (t[0] == 'i' || t[0] == 'I') v = [NSString stringWithFormat:@"%d", *(int *)p];
                else if (t[0] == 'q' || t[0] == 'Q' || t[0] == 'l' || t[0] == 'L') v = [NSString stringWithFormat:@"%lld", *(long long *)p];
                else if (t[0] == 'd') v = [NSString stringWithFormat:@"%.2f", *(double *)p];
                else if (t[0] == 'f') v = [NSString stringWithFormat:@"%.2f", *(float *)p];
                else if (!strncmp(t, "{CGRect", 7)) v = NSStringFromCGRect(*(CGRect *)p);
                else if (!strncmp(t, "{CGSize", 7)) v = NSStringFromCGSize(*(CGSize *)p);
                else if (!strncmp(t, "{CGPoint", 8)) v = NSStringFromCGPoint(*(CGPoint *)p);
                else if (!strncmp(t, "{CGAffineTransform", 18)) v = NSStringFromCGAffineTransform(*(CGAffineTransform *)p);
                else if (t[0] == '{') v = [NSString stringWithFormat:@"<%s>", t];
                else if (t[0] == '@') { id o = object_getIvar(stage, ivs[i]); v = o ? ([o isKindOfClass:[NSNumber class]] || [o isKindOfClass:[NSValue class]] || [o isKindOfClass:[NSString class]] ? [o description] : NSStringFromClass([o class])) : @"nil"; }
                if (v) [out appendFormat:@" %s@%ld=%@", ivar_getName(ivs[i]), (long)ivar_getOffset(ivs[i]), v];
            }
            free(ivs);
        }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"a5holder_"]) {   // a5holder_<bundle>[_<ivar>_<0|1>]: the app holder's margins in that stage (+ lock/trim state, minus handle); with an ivar: EXPERIMENT, set that BOOL ivar, lay out again, measure after 0.4 s
        NSArray *parts = [[cmd substringFromIndex:9] componentsSeparatedByString:@"_"];
        UIView *stage = DMStageForBundle(parts[0]);
        if (!stage) { DMLog(@"[a5holder] no such window"); return; }
        void (^measure)(NSString *) = ^(NSString *when) {
            UIView *in = DMStageInnerView(stage); CGSize S = stage.bounds.size; CGRect h = in.frame;
            UIView *minus = DMStageValue(stage, @[@"_minusHandle"]);
            NSMutableString *iv = [NSMutableString string];
            for (NSString *n in @[@"_lockMode", @"_trimMode", @"_isTrimmingActive", @"_externalFrameMode", @"_minusHandleSwipeMode"]) {
                Ivar v = class_getInstanceVariable([stage class], n.UTF8String);
                if (v) [iv appendFormat:@" %@=%d", n, *(BOOL *)((uint8_t *)(__bridge void *)stage + ivar_getOffset(v))];
            }
            DMLog([NSString stringWithFormat:@"[a5holder] %@ %@: margins %.1f/%.1f/%.1f/%.1f (holder %@ transform %@, stage bounds %@ transform %@) minus handle %@ hidden %d alpha %.2f;%@", parts[0], when,
                   h.origin.y, h.origin.x, S.height - CGRectGetMaxY(h), S.width - CGRectGetMaxX(h), NSStringFromCGRect(h), NSStringFromCGAffineTransform(in.transform), NSStringFromCGSize(S), NSStringFromCGAffineTransform(stage.transform),
                   [minus isKindOfClass:[UIView class]] ? NSStringFromCGRect(minus.frame) : @"-", [minus isKindOfClass:[UIView class]] ? minus.hidden : -1, [minus isKindOfClass:[UIView class]] ? minus.alpha : -1.0, iv]);
        };
        measure(@"now");
        if (parts.count >= 3) {
            Ivar v = class_getInstanceVariable([stage class], [parts[1] hasPrefix:@"_"] ? [parts[1] UTF8String] : [[@"_" stringByAppendingString:parts[1]] UTF8String]);
            if (!v) { DMLog(@"[a5holder] no such ivar"); return; }
            *(BOOL *)((uint8_t *)(__bridge void *)stage + ivar_getOffset(v)) = [parts[2] intValue] != 0;
            [stage setNeedsLayout]; [stage layoutIfNeeded];
            measure(@"right after");
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ measure(@"0.4 s later"); });
        }
    }
    else if ([cmd hasPrefix:@"a5ivars_"]) {   // a5ivars_<bundle>: that window's BOOL/int ivars related to minimize and the bottom handle
        UIView *stage = DMStageForBundle([cmd substringFromIndex:8]);
        NSMutableString *out = [NSMutableString string];
        for (NSString *n in @[@"_isMinimized", @"_minusHandleSwipeMode", @"_minusHandleSwipeCloseOnUp", @"_lockMode", @"_trimMode"]) {
            Ivar iv = stage ? class_getInstanceVariable([stage class], n.UTF8String) : NULL;
            if (iv) [out appendFormat:@" %@=%d", n, *(BOOL *)((uint8_t *)(__bridge void *)stage + ivar_getOffset(iv))];
        }
        DMLog([NSString stringWithFormat:@"[a5ivars] %@:%@ frame %@ hidden %d", [cmd substringFromIndex:8], out, stage ? NSStringFromCGRect(stage.frame) : @"-", stage.hidden]);
    }
    else if ([cmd hasPrefix:@"a5strip_"]) {   // a5strip_<bundle>: what a touch in the middle of that window's title strip hits, and which pans would see it
        UIView *stage = DMStageForBundle([cmd substringFromIndex:8]);
        UIWindow *win = stage.window;
        if (stage && win) {
            UIView *inner = DMStageInnerView(stage);
            CGPoint p = [stage convertPoint:CGPointMake(stage.bounds.size.width / 2.0, (inner ? inner.frame.origin.y : 13.0) / 2.0) toView:win];
            UIView *hit = [win hitTest:p withEvent:nil];
            NSMutableString *recs = [NSMutableString string];
            for (UIView *v = hit; v; v = v.superview) for (UIGestureRecognizer *g in v.gestureRecognizers) if ([g isKindOfClass:[UIPanGestureRecognizer class]]) [recs appendFormat:@" %@@%@(enabled %d)", NSStringFromClass([g class]), NSStringFromClass([v class]), g.enabled];
            DMLog([NSString stringWithFormat:@"[a5strip] strip middle %@ hits %@ %@; pans on the way up:%@", NSStringFromCGPoint(p), NSStringFromClass([hit class]), hit.accessibilityIdentifier ?: @"", recs]);
        }
    }
    else if ([cmd hasPrefix:@"a5shots_"]) {   // a5shots_<bundle>: open it as an Aerial window and save half-size screenshots at set times after -> /tmp/a5shot-NN.png
        NSString *bundle = [cmd substringFromIndex:8];
        DMAerialTrigger(bundle, DMLayoutFrame(@"center"));
        NSArray *times = @[@0.1, @0.2, @0.3, @0.45, @0.6, @0.8, @1.0, @1.3, @1.7, @2.2, @3.0];
        CFTimeInterval t0 = CACurrentMediaTime();
        for (NSUInteger i = 0; i < times.count; i++) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)([times[i] doubleValue] * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *snap = [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO];
            UIWindow *host = DMStatusBarWindow();
            if (!snap || !host) return;
            [host addSubview:snap];
            UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 0.5;
            UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:snap.bounds.size format:fmt];
            UIImage *img = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) { [snap drawViewHierarchyInRect:snap.bounds afterScreenUpdates:YES]; }];
            [snap removeFromSuperview];
            [UIImagePNGRepresentation(img) writeToFile:[NSString stringWithFormat:@"/tmp/a5shot-%02lu.png", (unsigned long)i] atomically:NO];
            DMLog([NSString stringWithFormat:@"[a5shots] %02lu taken at %.2f s", (unsigned long)i, CACurrentMediaTime() - t0]);
        });
    }
    else if ([cmd hasPrefix:@"a5hit_"] || [cmd hasPrefix:@"a5press_"]) {   // a5hit_<bundle>_<0|1|2>: what a touch on that window's light would hit (+ its screen point); a5press_ also presses it if it is ours
        BOOL press = [cmd hasPrefix:@"a5press_"];
        NSString *rest = [cmd substringFromIndex:press ? 8 : 6];
        NSRange us = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        NSString *bundle = us.location != NSNotFound ? [rest substringToIndex:us.location] : rest;
        NSInteger which = us.location != NSNotFound ? [[rest substringFromIndex:us.location + 1] integerValue] : 0;
        UIView *stage = DMStageForBundle(bundle);
        DMStageLights *lights = stage ? objc_getAssociatedObject(stage, kStageLightsKey) : nil;
        UIButton *button = nil; for (UIView *v in lights.subviews) if ([v isKindOfClass:[UIButton class]] && v.tag == which) button = (UIButton *)v;
        UIWindow *win = stage.window;
        if (!button || !win) DMLog([NSString stringWithFormat:@"[a5hit] %@: no stage/lights/button (stage %d lights %d)", bundle, stage != nil, lights != nil]);
        else {
            CGPoint c = CGPointMake(CGRectGetMidX(button.bounds), CGRectGetMidY(button.bounds));
            CGPoint inWin = [button convertPoint:c toView:win];
            CGPoint onScreen = [win convertPoint:inWin toCoordinateSpace:win.screen.coordinateSpace];
            UIView *hit = [win hitTest:inWin withEvent:nil];
            BOOL ours = hit == button || [hit isDescendantOfView:button];
            NSMutableString *recs = [NSMutableString string];
            for (UIView *v = hit; v; v = v.superview) for (UIGestureRecognizer *g in v.gestureRecognizers) [recs appendFormat:@" %@@%@(cancels %d)", NSStringFromClass([g class]), NSStringFromClass([v class]), g.cancelsTouchesInView];
            DMLog([NSString stringWithFormat:@"[a5hit] %@ light %ld: window point %@ screen point %@ hits %@ (ours %d) hidden %d; recognizers on the way up:%@", bundle, (long)which, NSStringFromCGPoint(inWin), NSStringFromCGPoint(onScreen), NSStringFromClass([hit class]), ours, lights.hidden, recs]);
            if (press && ours) [button sendActionsForControlEvents:UIControlEventTouchUpInside];
        }
    }
    else if ([cmd hasPrefix:@"alight_"]) {   // alight_<0|1|2>: press red / yellow / green on the top Aerial stage
        UIView *stage = DMTopStage();
        if (stage) DMStageLightAction(stage, [[cmd substringFromIndex:7] integerValue]); else DMLog(@"[aerial] no stage for the light");
    }
    else if ([cmd isEqualToString:@"astages"]) {   // Aerial stages, back to front
        DMLog([NSString stringWithFormat:@"[aerial] AerialCore %d, window %@", objc_getClass("AerialCore") != nil, DMAerialWindow() ? NSStringFromCGRect(DMAerialWindow().frame) : @"none"]);
        for (UIView *s in DMAerialStages()) {
            NSMutableString *iv = [NSMutableString string];
            unsigned n = 0; Ivar *ivars = class_copyIvarList([s class], &n);
            for (unsigned i = 0; i < n; i++) { const char *ty = ivar_getTypeEncoding(ivars[i]); [iv appendFormat:@" %s:%s", ivar_getName(ivars[i]), ty ? ty : "?"]; }
            free(ivars);
            DMLog([NSString stringWithFormat:@"[aerial] stage %@ frame %@ hidden %d alpha %.2f minimized %d layer level %.1f", DMStageBundle(s), NSStringFromCGRect(s.frame), s.hidden, s.alpha, DMStageMinimized(s), DMAerialWindow().windowLevel]);
            static BOOL dumped = NO; if (!dumped) { dumped = YES; DMLog([NSString stringWithFormat:@"[aerial] AerialStage ivars:%@", iv]); }
        }
    }
    else if ([cmd hasPrefix:@"rmset_"]) {   // rmset_<0|1>: switch Settings > Accessibility > Motion > Reduce Motion (tests of the spring paths; give the user's value back afterwards)
        void *ax = dlopen("/usr/lib/libAccessibility.dylib", RTLD_LAZY);
        void (*set)(Boolean) = ax ? (void (*)(Boolean))dlsym(ax, "_AXSSetReduceMotionEnabled") : NULL;
        BOOL was = UIAccessibilityIsReduceMotionEnabled();
        if (set) set([[cmd substringFromIndex:6] intValue] != 0);
        DMLog([NSString stringWithFormat:@"[rmset] Reduce Motion was %d, asked %@ (%@)", was, [cmd substringFromIndex:6], set ? @"set" : @"_AXSSetReduceMotionEnabled not found"]);
    }
    else if ([cmd hasPrefix:@"a5tracenext_"]) {   // a5tracenext_<seconds>: like a5trace_, for the NEXT new Aerial 5.0 window, from the moment it is first seen
        DMInstallLayerTrace();
        gTraceNextSecs = MAX(0.5, [[cmd substringFromIndex:12] doubleValue]);
        DMLog([NSString stringWithFormat:@"[a5trace] armed: the next new window is traced for %.1f s", gTraceNextSecs]);
    }
    else if ([cmd hasPrefix:@"a5trace_"]) {   // a5trace_<bundle>_<seconds>: log the call stack of every position/bounds change of that stage's layer (see DMTraceLayerChange)
        NSString *rest = [cmd substringFromIndex:8];
        NSRange us = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (us.location == NSNotFound) return;
        UIView *stage = DMStageForBundle([rest substringToIndex:us.location]);
        if (!stage) { DMLog(@"[a5trace] no such window"); return; }
        DMInstallLayerTrace();
        gTraceLayer = stage.layer; gTraceCount = 0;
        gTraceUntil = CACurrentMediaTime() + [[rest substringFromIndex:us.location + 1] doubleValue];
        DMLog([NSString stringWithFormat:@"[a5trace] tracing %@ (%@) for %@ s", [rest substringToIndex:us.location], NSStringFromCGRect(stage.frame), [rest substringFromIndex:us.location + 1]]);
    }
    else if ([cmd hasPrefix:@"a5ident_"]) {   // a5ident_<bundle>: give that stage an identity transform again (repair after an experiment)
        UIView *stage = DMStageForBundle([cmd substringFromIndex:8]);
        if (stage) stage.transform = CGAffineTransformIdentity;
        DMLog([NSString stringWithFormat:@"[a5ident] %@ -> %@", [cmd substringFromIndex:8], stage ? NSStringFromCGRect(stage.frame) : @"no window"]);
    }
    else if ([cmd hasPrefix:@"a5setf_"]) {   // a5setf_<x>_<y>_<w>_<h>: set the top stage's frame with no animation and log where Aerial takes it (setter / layout / later) -- experiment
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        UIView *stage = q.count >= 5 ? DMStageForBundle(q[4]) : DMAerialStages().lastObject;   // optional 5th part: which app's window
        if (q.count < 4 || !stage) return;
        CGRect target = CGRectMake([q[0] doubleValue], [q[1] doubleValue], [q[2] doubleValue], [q[3] doubleValue]);
        DMLog([NSString stringWithFormat:@"[a5setf] %@ before %@ transform %@ | superview %@ bounds %@ transform %@ | window %@ bounds %@ transform %@", DMStageBundle(stage), NSStringFromCGRect(stage.frame), NSStringFromCGAffineTransform(stage.transform),
               NSStringFromClass([stage.superview class]), NSStringFromCGRect(stage.superview.bounds), NSStringFromCGAffineTransform(stage.superview.transform), NSStringFromClass([stage.window class]), NSStringFromCGRect(stage.window.bounds), NSStringFromCGAffineTransform(stage.window.transform)]);
        stage.frame = target;
        DMLog([NSString stringWithFormat:@"[a5setf] right after the setter: %@", NSStringFromCGRect(stage.frame)]);
        [stage.superview layoutIfNeeded];
        DMLog([NSString stringWithFormat:@"[a5setf] after a layout pass: %@", NSStringFromCGRect(stage.frame)]);
        for (NSNumber *t in @[@0.05, @0.3, @1.0]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(t.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            DMLog([NSString stringWithFormat:@"[a5setf] +%.2f s: %@", t.doubleValue, NSStringFromCGRect(stage.frame)]);
        });
    }
    else if ([cmd hasPrefix:@"alayout_"]) {   // alayout_<x>_<y>_<w>_<h>: put the top Aerial stage there (experiment)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        UIView *stage = DMAerialStages().lastObject;
        if (q.count < 4 || !stage) { DMLog(@"[aerial] no stage or bad args"); }
        else {
            CGRect target = CGRectMake([q[0] doubleValue], [q[1] doubleValue], [q[2] doubleValue], [q[3] doubleValue]);
            NSString *bid = DMStageBundle(stage);
            DMLog([NSString stringWithFormat:@"[aerial] moving stage %@ from %@ to %@", bid, NSStringFromCGRect(stage.frame), NSStringFromCGRect(target)]);
            if ([stage respondsToSelector:DMAerialSel(@"_bringStageToFrontIfNeeded")]) ((void (*)(id, SEL))objc_msgSend)(stage, DMAerialSel(@"_bringStageToFrontIfNeeded"));
            [UIView animateWithDuration:0.36 delay:0 usingSpringWithDamping:1.0 initialSpringVelocity:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{
                stage.frame = target;
                [stage layoutIfNeeded];
                if ([stage respondsToSelector:DMAerialSel(@"adjustContentScaleToHost")]) ((void (*)(id, SEL))objc_msgSend)(stage, DMAerialSel(@"adjustContentScaleToHost"));
            } completion:^(BOOL finished) { DMLog([NSString stringWithFormat:@"[aerial] stage frame now %@", NSStringFromCGRect(stage.frame)]); }];
        }
    }
    else if ([cmd hasPrefix:@"tapsysid_"]) {   // tapsysid_<hex sender>_<x>_<y>: tapsys_ with another sender ID (iOS 15 experiments)
        NSArray *q = [[cmd substringFromIndex:9] componentsSeparatedByString:@"_"];
        if (q.count >= 3) { gSysTouchSenderOverride = strtoull([q[0] UTF8String], NULL, 16); DMSysTap(CGPointMake([q[1] doubleValue], [q[2] doubleValue])); }
    }
    else if ([cmd hasPrefix:@"hidall"]) {   // hidall: every HID service (usage page/usage/product/transport/registry ID), to find the trackpad or mouse (read-only)
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        HIDClientRef2 (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        CFArrayRef (*copyServices)(HIDClientRef2) = dlsym(iokit, "IOHIDEventSystemClientCopyServices");
        CFTypeRef (*copyProp)(void *, CFStringRef) = dlsym(iokit, "IOHIDServiceClientCopyProperty");
        CFTypeRef (*regID)(void *) = dlsym(iokit, "IOHIDServiceClientGetRegistryID");
        HIDClientRef2 c = create ? create(kCFAllocatorDefault) : NULL;
        CFArrayRef list = (c && copyServices) ? copyServices(c) : NULL;
        NSMutableString *out = [NSMutableString stringWithFormat:@"[hidall] %ld services", list ? (long)CFArrayGetCount(list) : -1L];
        for (CFIndex i = 0; list && i < CFArrayGetCount(list); i++) {
            void *svc = (void *)CFArrayGetValueAtIndex(list, i);
            NSNumber *page = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsagePage"))), *usage = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsage")));
            id product = CFBridgingRelease(copyProp(svc, CFSTR("Product"))), transport = CFBridgingRelease(copyProp(svc, CFSTR("Transport")));
            NSNumber *rid = regID ? (__bridge NSNumber *)regID(svc) : nil;
            [out appendFormat:@"\n  page %@ usage %@ product %@ transport %@ registry 0x%llx", page, usage, product, transport, rid.unsignedLongLongValue];
        }
        if (list) CFRelease(list);
        if (c) CFRelease(c);
        DMLog(out);
    }
    else if ([cmd isEqualToString:@"ahinfo"]) DMAutoHideDebugInfo();   // ahinfo: the auto-hiding status bar's state and every bar copy it moves
    else if ([cmd hasPrefix:@"ptrfake_"]) {   // ptrfake_<x>_<y> | ptrfake_off: a stand-in pointer position for the auto-hiding status bar (screen points; debug)
        NSArray *a = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        gSBFakePointer = a.count >= 2 ? CGPointMake([a[0] doubleValue], [a[1] doubleValue]) : CGPointMake(-1, -1);
        DMLog([NSString stringWithFormat:@"[autohide] fake pointer %@", NSStringFromCGPoint(gSBFakePointer)]);
    }
    else if ([cmd isEqualToString:@"ptrpos"]) {   // ptrpos: backboardd's global pointer position (debug)
        id svc = DMCall(objc_getClass("BKSMousePointerService"), @"sharedInstance");
        CGPoint p = svc ? ((CGPoint (*)(id, SEL))objc_msgSend)(svc, sel_registerName("globalPointerPosition")) : CGPointZero;
        DMLog([NSString stringWithFormat:@"[ptrpos] %@ (service %p, orientation %ld)", NSStringFromCGPoint(p), svc, (long)DMRealInterfaceOrientation()]);
    }
    else if ([cmd hasPrefix:@"ptrseq_"]) {   // ptrseq_<dx>_<dy>_<count>_<senderhex>: <count> relative pointer events 16 ms apart (a steady push/move; debug)
        NSArray *a = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        if (a.count >= 4) {
            double dx = [a[0] doubleValue], dy = [a[1] doubleValue]; int count = MAX(1, MIN(200, [a[2] intValue]));
            NSString *sender = a[3];
            for (int i = 0; i < count; i++)
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.016 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                    DMRunTrigger([NSString stringWithFormat:@"ptrmove_%g_%g_%@", dx, dy, sender]);
                });
            DMLog([NSString stringWithFormat:@"[ptrseq] %d events of (%g, %g)", count, dx, dy]);
        }
    }
    else if ([cmd hasPrefix:@"ptrmove_"]) {   // ptrmove_<dx>_<dy>_<senderhex>[_<buttons>][_abs]: inject one relative pointer (mouse) event from that HID sender (debug, MacPointer tests)
        NSArray *a = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        if (a.count >= 3) {
            void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
            static HIDClientRef2 client; if (!client) { HIDClientRef2 (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate"); client = create ? create(kCFAllocatorDefault) : NULL; }
            BOOL absolute = [a.lastObject isEqualToString:@"abs"];
            void *(*mk)(CFAllocatorRef, uint64_t, double, double, double, uint32_t, uint32_t) = dlsym(iokit, absolute ? "IOHIDEventCreatePointerEvent" : "IOHIDEventCreateRelativePointerEvent");
            void (*setSender)(void *, uint64_t) = dlsym(iokit, "IOHIDEventSetSenderID");
            void (*sysDispatch)(HIDClientRef2, void *) = dlsym(iokit, "IOHIDEventSystemClientDispatchEvent");
            uint64_t sender = strtoull([a[2] UTF8String], NULL, 16);
            uint32_t buttons = a.count >= 4 && ![a[3] isEqualToString:@"abs"] ? (uint32_t)[a[3] intValue] : 0;
            void *ev = (mk && client) ? mk(kCFAllocatorDefault, mach_absolute_time(), [a[0] doubleValue], [a[1] doubleValue], 0, buttons, 0) : NULL;
            if (ev) { if (setSender && sender) setSender(ev, sender); sysDispatch(client, ev); CFRelease(ev); }
            DMLog([NSString stringWithFormat:@"[ptrmove] %@ (%@, sender 0x%llx, buttons %u): %@", [cmd substringFromIndex:8], absolute ? @"absolute" : @"relative", sender, buttons, ev ? @"sent" : @"not created"]);
        }
    }
    else if ([cmd isEqualToString:@"hidservices"]) {   // hidservices: every HID service the event system has on the digitizer usage page (13), with its registry ID (read-only)
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        HIDClientRef2 (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        CFArrayRef (*copyServices)(HIDClientRef2) = dlsym(iokit, "IOHIDEventSystemClientCopyServices");
        CFTypeRef (*copyProp)(void *, CFStringRef) = dlsym(iokit, "IOHIDServiceClientCopyProperty");
        CFTypeRef (*regID)(void *) = dlsym(iokit, "IOHIDServiceClientGetRegistryID");
        HIDClientRef2 c = create ? create(kCFAllocatorDefault) : NULL;
        CFArrayRef list = (c && copyServices) ? copyServices(c) : NULL;
        NSMutableString *out = [NSMutableString stringWithFormat:@"[hidservices] %ld services", list ? (long)CFArrayGetCount(list) : -1L];
        for (CFIndex i = 0; list && i < CFArrayGetCount(list); i++) {
            void *svc = (void *)CFArrayGetValueAtIndex(list, i);
            NSNumber *page = copyProp ? CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsagePage"))) : nil;
            if (page.intValue != 13) continue;
            NSNumber *usage = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsage")));
            id product = CFBridgingRelease(copyProp(svc, CFSTR("Product")));
            id builtIn = CFBridgingRelease(copyProp(svc, CFSTR("Built-In")));
            id display = CFBridgingRelease(copyProp(svc, CFSTR("DisplayIntegrated")));
            NSNumber *rid = regID ? (__bridge NSNumber *)regID(svc) : nil;
            [out appendFormat:@"\n  usage %@ product %@ built-in %@ display %@ registry 0x%llx", usage, product, builtIn, display, rid.unsignedLongLongValue];
        }
        if (list) CFRelease(list);
        if (c) CFRelease(c);
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"tapdown0_"]) {   // tapdown0_<x>_<y>: an injected tap whose DOWN comes at the touch screen's own (0, 0) and whose lift is at x, y (the iPadOS 16 glitch after a respring with no window open)
        NSArray *q = [[cmd substringFromIndex:9] componentsSeparatedByString:@"_"];
        if (q.count >= 2) {
            CGPoint p = CGPointMake([q[0] doubleValue], [q[1] doubleValue]);
            DMSysTouchReady(^{
                DMLog([NSString stringWithFormat:@"[touchsys] tap with its down at (0, 0), lift at %@", NSStringFromCGPoint(p)]);
                gDMSysTouchNativeZero = YES; DMSysTouch(p, DMTouchDown); gDMSysTouchNativeZero = NO;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(25 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(p, DMTouchUp); DMSysTouchSecondUp(p); });
            });
        }
    }
    else if ([cmd hasPrefix:@"tapjump_"]) {   // tapjump_<x>_<y>: an injected tap with one move report at the touch screen's own (0, 0) in the middle (the iPadOS 16 glitch that [touchfix] drops)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        if (q.count >= 2) {
            CGPoint p = CGPointMake([q[0] doubleValue], [q[1] doubleValue]);
            BOOL newID = q.count >= 3 && [q[2] isEqualToString:@"newid"];
            DMSysTouchReady(^{
                DMLog([NSString stringWithFormat:@"[touchsys] tap with a (0, 0) jump at %@%@", NSStringFromCGPoint(p), newID ? @" (the jump with a new finger identity)" : @""]);
                DMSysTouch(p, DMTouchDown);
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(40 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ gDMSysTouchNativeZero = YES; if (newID) gDMSysTouchIdentity = 3; DMSysTouch(p, DMTouchMove); gDMSysTouchNativeZero = NO; gDMSysTouchIdentity = 2; });
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(80 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTouch(p, DMTouchUp); DMSysTouchSecondUp(p); });
            });
        }
    }
    else if ([cmd hasPrefix:@"tapsys_"]) {   // tapsys_<x>_<y>: a system-wide injected tap (routed by backboardd to whatever app is under the point) -- see DMSysTouch
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        gSysTapHoldMs = q.count >= 3 ? [q[2] doubleValue] : 80;
        if (q.count >= 2) { CGPoint p = CGPointMake([q[0] doubleValue], [q[1] doubleValue]); DMSysTouchReady(^{ DMSysTap(p); }); }
    }
    else if ([cmd hasPrefix:@"tapsys2_"]) {   // tapsys2_<x>_<y>: two injected taps 220 ms apart (a double tap / double click, which two triggers can't send)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        gSysTapHoldMs = 60;
        if (q.count >= 2) { CGPoint p = CGPointMake([q[0] doubleValue], [q[1] doubleValue]); DMSysTouchReady(^{ DMSysTap(p); dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(220 * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMSysTap(p); }); }); }
    }
    else if ([cmd hasPrefix:@"dragsys_"]) {   // dragsys_<x1>_<y1>_<x2>_<y2>_<ms>[_<hold ms>]: a system-wide injected drag
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        if (q.count >= 5) { CGPoint a = CGPointMake([q[0] doubleValue], [q[1] doubleValue]), b = CGPointMake([q[2] doubleValue], [q[3] doubleValue]); double ms = [q[4] doubleValue], hold = q.count >= 6 ? [q[5] doubleValue] : 0, endHold = q.count >= 7 ? [q[6] doubleValue] : 0; DMSysTouchReady(^{ gSysDragEndHoldMs = endHold; DMSysDrag(a, b, ms, hold); }); }
    }
    else if ([cmd hasPrefix:@"tap_"]) {   // tap_<x>_<y>: inject a real digitizer touch-down+up at a screen point (UIScreen.mainScreen coordinates)
        NSArray *q = [[cmd substringFromIndex:4] componentsSeparatedByString:@"_"];
        if (q.count >= 2) DMInjectTap(CGPointMake([q[0] doubleValue], [q[1] doubleValue]));
    }
    else if ([cmd hasPrefix:@"drag_"]) {   // drag_<x1>_<y1>_<x2>_<y2>_<durationMs>: inject a real digitizer drag (down, paced moves, up)
        NSArray *q = [[cmd substringFromIndex:5] componentsSeparatedByString:@"_"];
        if (q.count >= 5) DMInjectDrag(CGPointMake([q[0] doubleValue], [q[1] doubleValue]), CGPointMake([q[2] doubleValue], [q[3] doubleValue]), [q[4] doubleValue]);
    }
    else if ([cmd isEqualToString:@"ctxtest"]) {   // which window CONTEXT would the render server give a tap? (this is what routes touches inside apps)
        Class serverClass = objc_getClass("CAWindowServer");
        id server = [serverClass respondsToSelector:NSSelectorFromString(@"serverIfRunning")] ? ((id (*)(id, SEL))objc_msgSend)((id)serverClass, NSSelectorFromString(@"serverIfRunning")) : nil;
        NSArray *displays = [server valueForKey:@"displays"];
        id display = displays.firstObject;
        SEL at = NSSelectorFromString(@"contextIdAtPosition:");
        SEL at2 = NSSelectorFromString(@"contextIdAtPosition:excludingContextIds:");
        DMLog([NSString stringWithFormat:@"[ctxtest] server %@ display %@ responds contextIdAtPosition: %d, ...excluding: %d", server ? @"ok" : @"missing", display ? NSStringFromClass([display class]) : @"-", [display respondsToSelector:at], [display respondsToSelector:at2]]);
        NSMutableString *ids = [NSMutableString string];
        for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES]) {
            unsigned cid = 0; @try { cid = ((unsigned (*)(id, SEL))objc_msgSend)(w, NSSelectorFromString(@"_contextId")); } @catch (id e) {}
            if (!w.hidden && cid) [ids appendFormat:@" %@=%u(level %.0f)", NSStringFromClass([w class]), cid, w.windowLevel];
        }
        DMLog([NSString stringWithFormat:@"[ctxtest] visible window contexts:%@", ids]);
        DMLog([NSString stringWithFormat:@"[ctxtest] menu window context %u, overlay %@ (background alpha %.3f)", gMenuWindow ? ((unsigned (*)(id, SEL))objc_msgSend)(gMenuWindow, NSSelectorFromString(@"_contextId")) : 0, gOverlay ? @"present" : @"NONE", gOverlay ? CGColorGetAlpha(gOverlay.backgroundColor.CGColor) : -1.0]);
        CGSize screen = [UIScreen mainScreen].bounds.size;   // 1194 x 834 landscape
        CGPoint pts[] = { CGPointMake(600, 400), CGPointMake(300, 700), CGPointMake(1100, 300) };
        for (int i = 0; i < 3 && display; i++) {
            CGPoint landscape = pts[i];
            CGPoint natives[2] = { CGPointMake(landscape.y, screen.width - landscape.x), CGPointMake(screen.height - landscape.y, landscape.x) };   // the two rotations into the portrait panel
            for (int m = 0; m < 2; m++) {
                unsigned cid = 0;
                if ([display respondsToSelector:at]) cid = ((unsigned (*)(id, SEL, CGPoint))objc_msgSend)(display, at, natives[m]);
                else if ([display respondsToSelector:at2]) cid = ((unsigned (*)(id, SEL, CGPoint, id))objc_msgSend)(display, at2, natives[m], nil);
                DMLog([NSString stringWithFormat:@"[ctxtest] point %@ (native mapping %d %@) -> context %u", NSStringFromCGPoint(landscape), m, NSStringFromCGPoint(natives[m]), cid]);
            }
        }
    }
    else if ([cmd isEqualToString:@"hittest"]) {   // where would a tap in the middle of the screen go while a menu is open?
        DMLog([NSString stringWithFormat:@"[hittest] overlay %@ in window %@ (level %.1f) overlay frame %@", gOverlay ? @"present" : @"NONE", gOverlay ? NSStringFromClass([gOverlay.window class]) : @"-", gOverlay.window.windowLevel, gOverlay ? NSStringFromCGRect(gOverlay.frame) : @"-"]);
        CGPoint pts[] = { CGPointMake(600, 400), CGPointMake(300, 700), CGPointMake(1100, 300) };
        NSArray<UIWindow *> *windows = [[UIWindow allWindowsIncludingInternalWindows:NO onlyVisibleWindows:YES] sortedArrayUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) { return a.windowLevel < b.windowLevel ? NSOrderedDescending : NSOrderedAscending; }];
        for (int i = 0; i < 3; i++) {
            for (UIWindow *w in windows) {
                if (w.hidden || w.alpha < 0.01 || ![w pointInside:[w convertPoint:pts[i] fromWindow:nil] withEvent:nil]) continue;
                UIView *hit = [w hitTest:[w convertPoint:pts[i] fromWindow:nil] withEvent:nil];
                if (hit) { DMLog([NSString stringWithFormat:@"[hittest] tap at %@ -> topmost taking it: window %@ (level %.1f) view %@ (%@)", NSStringFromCGPoint(pts[i]), NSStringFromClass([w class]), w.windowLevel, NSStringFromClass([hit class]), hit == gOverlay ? @"THE OVERLAY" : @"not the overlay"]); break; }
            }
        }
    }
    else if ([cmd isEqualToString:@"menurows"]) {   // menurows: every row of the open menu with its state (read-only)
        NSMutableArray *rows = [NSMutableArray array];
        NSMutableArray *stack = [NSMutableArray arrayWithObject:gOverlay ?: (UIView *)[UIView new]];
        while (stack.count) { UIView *v = stack.firstObject; [stack removeObjectAtIndex:0]; [stack addObjectsFromArray:v.subviews];
            if ([v isKindOfClass:[DMRow class]]) [rows addObject:[NSString stringWithFormat:@"%@%@%@", ((DMRow *)v).label.text, ((DMRow *)v).enabled ? @"" : @" (greyed)", ((DMRow *)v).checked ? @" (ticked)" : @""]]; }
        DMLog([NSString stringWithFormat:@"[menurows] %@", [rows componentsJoinedByString:@" | "]]);
    }
    else if ([cmd isEqualToString:@"winmenu"]) {
        UIView *fg = nil;
        for (UIView *v in gCopies.allObjects) if (v.window && !v.window.hidden && v.bounds.size.width > 300 && DMEffectiveAlpha(v) > 0.01) { fg = v; break; }
        UIButton *b = fg ? objc_getAssociatedObject(fg, kWinButtonKey) : nil;
        if (b) DMOpenWindowMenu(b); else DMLog(@"[debug] no Window button");
    }
    else if ([cmd isEqualToString:@"mwgrip"]) {   // mwgrip: the top MilkyWay window's resize handle -- its recognisers (and the window's), every subview (hidden too), and what a touch hits on a 4 pt grid (debug)
        UIView *w = DMTopWindow(), *h = nil;
        @try { h = [w valueForKey:@"sizeChanger"]; } @catch (id e) {}
        if (![h isKindOfClass:[UIView class]]) { DMLog(@"[mwgrip] no handle"); return; }
        NSMutableString *s = [NSMutableString stringWithFormat:@"[mwgrip] handle %@ frame %@ uie %d", NSStringFromClass([h class]), NSStringFromCGRect(h.frame), h.userInteractionEnabled];
        for (UIView *v = h; v; v = v.superview) for (UIGestureRecognizer *g in v.gestureRecognizers) [s appendFormat:@"\n  rec on %@: %@ enabled %d delegate %@ cancels %d delaysBegan %d", NSStringFromClass([v class]), g, g.enabled, NSStringFromClass([(NSObject *)g.delegate class]), g.cancelsTouchesInView, g.delaysTouchesBegan];
        for (UIView *sub in h.subviews) [s appendFormat:@"\n  sub %@ frame %@ hidden %d uie %d alpha %.2f", NSStringFromClass([sub class]), NSStringFromCGRect(sub.frame), sub.hidden, sub.userInteractionEnabled, sub.alpha];
        for (int y = 2; y < 32; y += 4) { [s appendFormat:@"\n  y %2d:", y]; for (int x = 2; x < 32; x += 4) { UIView *hit = [w.window hitTest:[h convertPoint:CGPointMake(x, y) toView:w.window] withEvent:nil]; [s appendFormat:@" %@", hit == h ? @"H" : hit == w ? @"W" : hit ? [NSStringFromClass([hit class]) substringToIndex:MIN((NSUInteger)4, NSStringFromClass([hit class]).length)] : @"-"]; } }
        DMLog(s);
    }
    else if ([cmd isEqualToString:@"winstate"]) {   // what MilkyWay knows about the top window's geometry
        UIView *w = DMTopWindow();
        if (!w) { DMLog(@"[winstate] no window"); }
        else {
            NSMutableString *s = [NSMutableString stringWithFormat:@"[winstate] window %@ frame %@ bounds %@ transform %@", [(AXWindowView *)w bundleIdentifier], NSStringFromCGRect(w.frame), NSStringFromCGRect(w.bounds), NSStringFromCGAffineTransform(w.transform)];
            for (NSString *key in @[@"contentViewFrame", @"oldFrame", @"prevFrame"]) {
                @try { id v = [w valueForKey:key]; [s appendFormat:@" | %@ %@", key, [v isKindOfClass:[NSValue class]] ? NSStringFromCGRect([v CGRectValue]) : v]; } @catch (id e) { [s appendFormat:@" | %@ ?", key]; }
            }
            for (NSString *key in @[@"contentView", @"mainView", @"titleBar", @"sizeChanger"]) {
                @try { UIView *v = [w valueForKey:key]; [s appendFormat:@" | %@ %@ frame %@ transform %@", key, NSStringFromClass([v class]), NSStringFromCGRect(v.frame), NSStringFromCGAffineTransform(v.transform)]; } @catch (id e) { [s appendFormat:@" | %@ ?", key]; }
            }
            {   // what is hosted inside: the presented layers and their sizes
                UIView *cv = nil; @try { cv = [w valueForKey:@"contentView"]; } @catch (id e) {}
                NSMutableString *tree = [NSMutableString string];
                NSMutableArray *stack = [NSMutableArray arrayWithObject:@[cv ?: [UIView new], @0]];
                while (stack.count) {
                    NSArray *entry = stack.lastObject; [stack removeLastObject];
                    UIView *v = entry[0]; int depth = [entry[1] intValue];
                    [tree appendFormat:@"\n      %*s%@ frame %@ bounds %@ transform %@ layer.bounds %@", depth * 2, "", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), NSStringFromCGRect(v.bounds), NSStringFromCGAffineTransform(v.transform), NSStringFromCGRect(v.layer.bounds)];
                    if (depth < 3) for (UIView *s in [v.subviews reverseObjectEnumerator]) [stack addObject:@[s, @(depth + 1)]];
                }
                [s appendString:tree];
            }
            @try {
                id scene = [w valueForKey:@"scene"];
                id settings = [scene valueForKey:@"settings"];
                [s appendFormat:@" | scene settings frame %@", [settings respondsToSelector:NSSelectorFromString(@"frame")] ? NSStringFromCGRect(((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame"))) : @"?"];
            } @catch (id e) {}
            DMLog(s);
        }
    }
    else if ([cmd hasPrefix:@"winpan"]) {   // winpan-<dx>-<dy>, e.g. winpan--300--100 is awkward, so: winpan dx dy written as winpan_m300_m100
        NSString *rest = [cmd substringFromIndex:[cmd hasPrefix:@"winpan_"] ? 7 : 6];
        NSArray *parts = [rest componentsSeparatedByString:@"_"];
        CGFloat dx = 0, dy = 0;
        if (parts.count == 2) {
            NSString *a = [parts[0] stringByReplacingOccurrencesOfString:@"m" withString:@"-"], *b = [parts[1] stringByReplacingOccurrencesOfString:@"m" withString:@"-"];
            dx = a.doubleValue; dy = b.doubleValue;
        }
        DMFakeResize(dx, dy);
    }
    else if ([cmd hasPrefix:@"winlayout_"]) DMWindowLayout([cmd substringFromIndex:10]);   // winlayout_<name>: fill/center/left/right/top/bottom/topleft/topright/bottomleft/bottomright/small/large — the same thing the Window menu rows do, for testing the Sileo queue bug's full-screen->windowed repro
    else if ([cmd isEqualToString:@"cards"]) {   // cards: the App Switcher's card list from every place it can be read (read-only)
        id co = DMSwitcherController();
        DMLog([NSString stringWithFormat:@"[cards] controller %@: %@", co ? NSStringFromClass([co class]) : @"none", [[DMSwitcherBundleIDs(co) allObjects] componentsJoinedByString:@", "]]);
        id rc = DMCall(co, @"recentAppLayoutsController");
        SEL inc = NSSelectorFromString(@"recentsIncludingHiddenAppLayouts:");
        for (int hidden = 0; hidden < 2; hidden++) if ([rc respondsToSelector:inc]) {
            NSArray *l = ((id (*)(id, SEL, BOOL))objc_msgSend)(rc, inc, (BOOL)hidden);
            NSMutableArray *b = [NSMutableArray array];
            for (id layout in l) for (id item in (DMCall(layout, @"allItems") ?: @[])) { NSString *bid = DMCall(item, @"bundleIdentifier"); if (bid) [b addObject:bid]; }
            DMLog([NSString stringWithFormat:@"[cards] %@ recents (hidden %d): %lu layouts: %@", NSStringFromClass([rc class]), hidden, (unsigned long)l.count, [b componentsJoinedByString:@", "]]);
        }
        DMLog([NSString stringWithFormat:@"[cards] running: %@", [[DMLiveRunningBundleIDs() allObjects] componentsJoinedByString:@", "]]);
    }
    else if ([cmd hasPrefix:@"scenes_"]) {   // scenes_<bundle>: every FrontBoard scene of that app (read-only)
        NSString *bid = [cmd substringFromIndex:7];
        id mgr = DMCall(objc_getClass("FBSceneManager"), @"sharedInstance");
        SEL q = NSSelectorFromString(@"scenesPassingTest:");
        NSArray *list = [mgr respondsToSelector:q] ? ((id (*)(id, SEL, id))objc_msgSend)(mgr, q, ^BOOL(id sc) { NSString *i = DMCall(sc, @"identifier"); return [i containsString:bid]; }) : nil;
        DMLog([NSString stringWithFormat:@"[scenes] %@: %lu FrontBoard scenes", bid, (unsigned long)list.count]);
        for (id sc in list) {
            id st = DMCall(sc, @"settings");
            NSString *pid = nil; @try { pid = [st valueForKey:@"persistenceIdentifier"]; } @catch (id e) {}
            BOOL fg = NO; @try { fg = [[st valueForKey:@"foreground"] boolValue]; } @catch (id e) {}
            CGRect f = CGRectZero; @try { f = [[st valueForKey:@"frame"] CGRectValue]; } @catch (id e) {}
            BOOL valid = YES; @try { valid = [[sc valueForKey:@"valid"] boolValue]; } @catch (id e) {}
            DMLog([NSString stringWithFormat:@"[scenes]   %@ fg %d valid %d frame %@ persistence %@", [DMCall(sc, @"identifier") stringByReplacingOccurrencesOfString:@"sceneID:" withString:@""], fg, valid, NSStringFromCGRect(f), pid]);
        }
    }
    else if ([cmd isEqualToString:@"ctxstate"]) {   // ctxstate: every window's presented view controller chain (how a Haptic Touch menu is presented), read-only
        UIWindow *in = nil; UIViewController *m = DMAnyContextMenuVC(&in);
        DMLog([NSString stringWithFormat:@"[ctxstate] menu seen by DMAnyContextMenuVC: %@ in %@, dismissing %d; waiting %lu", m ? NSStringFromClass([m class]) : @"none", in ? NSStringFromClass([in class]) : @"-", m.isBeingDismissed, (unsigned long)gCtxWaiting.count]);
        for (UIWindow *w in DMAllWindows()) {
            NSMutableString *chain = [NSMutableString string];
            UIViewController *vc = w.rootViewController;
            for (int n = 0; vc && n < 8; n++) { UIViewController *p2 = vc.presentedViewController; if (!p2 || p2 == vc) break; [chain appendFormat:@" -> %@%@", NSStringFromClass([p2 class]), p2.isBeingDismissed ? @"(dismissing)" : @""]; vc = p2; }
            BOOL menuView = NO;
            NSMutableArray *st = [NSMutableArray arrayWithObject:w];
            for (int n = 0; st.count && n < 4000 && !menuView; n++) { UIView *v = st.lastObject; [st removeLastObject]; if ([NSStringFromClass([v class]) containsString:@"ContextMenu"]) menuView = YES; [st addObjectsFromArray:v.subviews]; }
            if (chain.length || menuView) DMLog([NSString stringWithFormat:@"[ctxstate] %@ (level %.0f hidden %d) root %@%@%@", NSStringFromClass([w class]), w.windowLevel, w.hidden, NSStringFromClass([w.rootViewController class]), chain, menuView ? @" [has a ContextMenu view]" : @""]);
        }
    }
    else if ([cmd hasPrefix:@"gesturetree_"]) {   // gesturetree_<bundle>: interactions and gesture recognizers inside that app's Zetsu window (read-only)
        UIWindow *zw = DMZetsuWindowFor([cmd substringFromIndex:12]);
        NSMutableArray *st = zw ? [NSMutableArray arrayWithObject:zw] : [NSMutableArray array];
        for (int n = 0; st.count && n < 3000; n++) {
            UIView *v = st.firstObject; [st removeObjectAtIndex:0];
            NSMutableArray *bits = [NSMutableArray array];
            for (id<UIInteraction> i in v.interactions) [bits addObject:NSStringFromClass([(NSObject *)i class])];
            for (UIGestureRecognizer *g in v.gestureRecognizers) {
                NSString *d = [g description]; NSRange r = [d rangeOfString:@"action="];
                [bits addObject:[NSString stringWithFormat:@"%@%@%@", NSStringFromClass([g class]), g.enabled ? @"" : @"(off)", r.location != NSNotFound ? [@" " stringByAppendingString:[d substringWithRange:NSMakeRange(r.location, MIN((NSUInteger)90, d.length - r.location))]] : @""]];
            }
            if (bits.count) DMLog([NSString stringWithFormat:@"[gesturetree] %@ %@: %@", NSStringFromClass([v class]), NSStringFromCGRect([v convertRect:v.bounds toView:nil]), [bits componentsJoinedByString:@" | "]]);
            [st addObjectsFromArray:v.subviews];
        }
        DMLog([NSString stringWithFormat:@"[gesturetree] done (%@)", zw ? @"window found" : @"no Zetsu window"]);
    }
    else if ([cmd isEqualToString:@"previewguardtest"]) {   // previewguardtest: a menu preview target whose container is not in a window (the iPad 2 crash); with the guard it is replaced, without it UIKit raises (caught here)
        UIView *detached = [[UIView alloc] initWithFrame:CGRectMake(0, 0, 40, 40)];
        @try {
            UIPreviewTarget *t = [[UIPreviewTarget alloc] initWithContainer:detached center:CGPointMake(20, 20) transform:CGAffineTransformIdentity];
            DMLog([NSString stringWithFormat:@"[ctxmenu] test: preview target made, container %@ (in a window: %d)", NSStringFromClass([t.container class]), t.container.window != nil]);
        } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[ctxmenu] test: UIKit raised %@: %@", e.name, e.reason]); }
    }
    else if ([cmd hasPrefix:@"sceneid_"]) {   // sceneid_<bundle>: the scene object's own pointer identity + window ptr, to test whether a full-screen->windowed conversion swaps/recreates it (the Sileo queue bug's working theory)
        NSString *bid = [cmd substringFromIndex:8];
        id scene = DMSceneForBundle(bid);
        UIView *stage = DMStageForBundle(bid);
        id stageScene = nil;
        @try { stageScene = [stage valueForKey:@"scene"]; } @catch (id e) {}
        DMLog([NSString stringWithFormat:@"[sceneid] %@: DMSceneForBundle=%p stage=%p stage.scene=%p (equal to DMSceneForBundle: %d) DMStageScene=%p (%@)", bid, scene, stage, stageScene, scene == stageScene, DMStageScene(stage, bid), DMShortSceneID(DMStageScene(stage, bid))]);
    }
    else if ([cmd isEqualToString:@"sceneinfo"]) {   // the windowed app's scene and the front app's scene: orientation mode and frame
        void (^describe)(NSString *, id) = ^(NSString *label, id scene) {
            if (!scene) { DMLog([NSString stringWithFormat:@"[sceneinfo] %@: no scene", label]); return; }
            @try {
                id settings = [scene valueForKey:@"settings"];
                long long mode = -1; if ([settings respondsToSelector:NSSelectorFromString(@"interfaceOrientationMode")]) mode = ((long long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientationMode"));
                CGRect frame = [settings respondsToSelector:NSSelectorFromString(@"frame")] ? ((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame")) : CGRectZero;
                DMLog([NSString stringWithFormat:@"[sceneinfo] %@: %@ orientationMode %lld frame %@", label, [scene valueForKey:@"identifier"], mode, NSStringFromCGRect(frame)]);
            } @catch (id e) { DMLog([NSString stringWithFormat:@"[sceneinfo] %@: exception", label]); }
        };
        UIView *w = DMTopWindow();
        describe(@"windowed", w ? [w valueForKey:@"scene"] : nil);
        SBApplication *front = DMFrontApp();
        id mainScene = nil;
        for (NSString *k in @[@"mainScene", @"_mainScene", @"scene"]) { @try { mainScene = [front valueForKey:k]; } @catch (id e) {} if (mainScene) break; }
        describe(@"front app", mainScene);
    }
    else if ([cmd hasPrefix:@"frontscene_"]) {   // frontscene_<x>_<y>_<w>_<h>_<swap 0/1>: move the FULL-SCREEN app's scene to that frame (no MilkyWay window involved)
        NSArray *q = [[cmd substringFromIndex:11] componentsSeparatedByString:@"_"];
        NSString *bid = [DMFrontApp() bundleIdentifier];
        id scene = nil;
        scene = bid.length ? DMSceneForBundle(bid) : nil;
        if (q.count < 5 || !scene) { DMLog([NSString stringWithFormat:@"[frontscene] no scene for %@ (known: %lu)", bid, (unsigned long)gSceneByID.count]); }
        else {
            CGFloat w = [q[2] doubleValue], h = [q[3] doubleValue];
            CGRect frame = [q[4] boolValue] ? CGRectMake([q[0] doubleValue], [q[1] doubleValue], h, w) : CGRectMake([q[0] doubleValue], [q[1] doubleValue], w, h);
            BOOL ok = DMSetSceneFrame(scene, frame);
            DMLog([NSString stringWithFormat:@"[frontscene] %@ scene frame %@ sent=%d", bid, NSStringFromCGRect(frame), ok]);
        }
    }
    else if ([cmd hasPrefix:@"clsmethods_"]) {   // clsmethods_<Class>_<keyword>: selectors of that class (and its superclasses) containing the keyword
        NSArray *parts = [[cmd substringFromIndex:11] componentsSeparatedByString:@"_"];
        if (parts.count == 2) {
            for (Class c = objc_getClass([parts[0] UTF8String]); c && c != [NSObject class]; c = class_getSuperclass(c)) {
                unsigned n = 0; Method *ms = class_copyMethodList(c, &n);
                NSMutableArray *hits = [NSMutableArray array];
                for (unsigned i = 0; i < n; i++) { NSString *s = NSStringFromSelector(method_getName(ms[i])); if ([s rangeOfString:parts[1] options:NSCaseInsensitiveSearch].location != NSNotFound) [hits addObject:s]; }
                free(ms);
                if (hits.count) DMLog([NSString stringWithFormat:@"[clsmethods] %@: %@", NSStringFromClass(c), [hits componentsJoinedByString:@" "]]);
            }
        }
    }
    else if ([cmd isEqualToString:@"deacttest"]) {   // which bit is which deactivation reason
        UIView *w = DMTopWindow();
        id scene = w ? [w valueForKey:@"scene"] : nil;
        id settings = scene ? [scene valueForKey:@"settings"] : nil;
        SEL setter = NSSelectorFromString(@"setDeactivationReasons:");
        DMLog([NSString stringWithFormat:@"[deacttest] settings %@ responds %d", NSStringFromClass([settings class]), [settings respondsToSelector:setter]]);
        for (int bit = 0; bit < 40 && settings; bit++) {
            id m = [settings mutableCopy];
            if (![m respondsToSelector:setter]) break;
            ((void (*)(id, SEL, unsigned long long))objc_msgSend)(m, setter, 1ULL << bit);
            NSString *d = [NSString stringWithFormat:@"%@", m];
            NSRange r = [d rangeOfString:@"deactivationReasons = "];
            if (r.location != NSNotFound) DMLog([NSString stringWithFormat:@"[deacttest] bit %d (%llu) -> %@", bit, 1ULL << bit, [[d substringFromIndex:r.location] componentsSeparatedByString:@";"][0]]);
        }
    }
    else if ([cmd isEqualToString:@"modetest"]) {   // which number is which interfaceOrientationMode
        UIView *w = DMTopWindow();
        id scene = w ? [w valueForKey:@"scene"] : nil;
        id settings = scene ? [scene valueForKey:@"settings"] : nil;
        for (long long v = 0; v <= 4 && settings; v++) {
            id m = [settings mutableCopy];
            if (![m respondsToSelector:NSSelectorFromString(@"setInterfaceOrientationMode:")]) { DMLog(@"[modetest] no setter"); break; }
            ((void (*)(id, SEL, long long))objc_msgSend)(m, NSSelectorFromString(@"setInterfaceOrientationMode:"), v);
            NSString *d = [NSString stringWithFormat:@"%@", m];
            NSRange r = [d rangeOfString:@"interfaceOrientationMode = "];
            DMLog([NSString stringWithFormat:@"[modetest] %lld -> %@", v, r.location != NSNotFound ? [[d substringFromIndex:r.location] componentsSeparatedByString:@";"][0] : @"(not in description)"]);
        }
        for (NSNumber *n in @[@99, @100, @101, @102, @200]) {
            long long v = n.longLongValue;
            id m = [settings mutableCopy];
            ((void (*)(id, SEL, long long))objc_msgSend)(m, NSSelectorFromString(@"setInterfaceOrientationMode:"), v);
            NSString *d = [NSString stringWithFormat:@"%@", m];
            NSRange r = [d rangeOfString:@"interfaceOrientationMode = "];
            DMLog([NSString stringWithFormat:@"[modetest] %lld -> %@", v, r.location != NSNotFound ? [[d substringFromIndex:r.location] componentsSeparatedByString:@";"][0] : @"(not in description)"]);
        }
    }
    else if ([cmd hasPrefix:@"scenetest_"]) {   // scenetest_<w>_<h>[_<orientation>]: push a new frame to the top window's FBScene the way Aerial does
        NSArray *parts = [[cmd substringFromIndex:10] componentsSeparatedByString:@"_"];
        UIView *w = DMTopWindow();
        id scene = w ? [w valueForKey:@"scene"] : nil;
        if (!scene || parts.count < 2) { DMLog(@"[scene] no window/scene or bad args"); }
        else {
            CGRect frame = CGRectMake(0, 0, [parts[0] doubleValue], [parts[1] doubleValue]);
            NSMutableString *info = [NSMutableString stringWithFormat:@"[scene] %@ responds:", NSStringFromClass([scene class])];
            for (NSString *s in @[@"settings", @"clientSettings", @"updateSettings:", @"updateSettings:withTransitionContext:", @"updateSettings:withTransitionContext:completion:", @"mutableSettings", @"accessibilitySceneFrame"])
                [info appendFormat:@" %@=%d", s, [scene respondsToSelector:NSSelectorFromString(s)]];
            DMLog(info);
            @try {
                id settings = [scene valueForKey:@"settings"];
                id mutable = [settings mutableCopy];
                DMLog([NSString stringWithFormat:@"[scene] settings %@ mutable %@ frame before %@", NSStringFromClass([settings class]), NSStringFromClass([mutable class]), NSStringFromCGRect(((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame")))]);
                ((void (*)(id, SEL, CGRect))objc_msgSend)(mutable, NSSelectorFromString(@"setFrame:"), frame);
                if (parts.count > 2 && [mutable respondsToSelector:NSSelectorFromString(@"setInterfaceOrientation:")])
                    ((void (*)(id, SEL, long long))objc_msgSend)(mutable, NSSelectorFromString(@"setInterfaceOrientation:"), [parts[2] longLongValue]);
                SEL two = NSSelectorFromString(@"updateSettings:withTransitionContext:");
                SEL one = NSSelectorFromString(@"updateSettings:");
                if ([scene respondsToSelector:two]) { ((void (*)(id, SEL, id, id))objc_msgSend)(scene, two, mutable, nil); DMLog(@"[scene] updateSettings:withTransitionContext: sent"); }
                else if ([scene respondsToSelector:one]) { ((void (*)(id, SEL, id))objc_msgSend)(scene, one, mutable); DMLog(@"[scene] updateSettings: sent"); }
                else DMLog(@"[scene] no update selector");
            } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[scene] exception %@", e]); }
        }
    }
    else if ([cmd hasPrefix:@"scenefit_"]) {   // scenefit_<a>_<b>: scene frame a x b, content shown 1:1 (calibration)
        NSArray *parts = [[cmd substringFromIndex:9] componentsSeparatedByString:@"_"];
        UIView *w = DMTopWindow();
        id scene = w ? [w valueForKey:@"scene"] : nil;
        if (scene && parts.count == 2) {
            BOOL ok = DMSetSceneFrame(scene, CGRectMake(0, 0, [parts[0] doubleValue], [parts[1] doubleValue]));
            UIView *content = [w valueForKey:@"contentView"], *main = [w valueForKey:@"mainView"];
            content.transform = CGAffineTransformIdentity;
            content.frame = CGRectMake(0, 0, main.bounds.size.width, main.bounds.size.height);
            DMLog([NSString stringWithFormat:@"[scenefit] frame %@x%@ sent=%d, main %@", parts[0], parts[1], ok, NSStringFromCGSize(main.bounds.size)]);
        }
    }
    else if ([cmd isEqualToString:@"winrotate"]) {   // experiment: MilkyWay's own rotate
        UIView *w = DMTopWindow();
        if (w) { DMLog([NSString stringWithFormat:@"[mw] rotateWindow: on %@", NSStringFromCGRect(w.frame)]); ((void (*)(id, SEL, id))objc_msgSend)(w, NSSelectorFromString(@"rotateWindow:"), nil); }
    }
    else if ([cmd isEqualToString:@"winfit"]) { UIView *w = DMTopWindow(); if (w) DMFitWindowContent(w, YES); }
    else if ([cmd isEqualToString:@"winfitb"]) { UIView *w = DMTopWindow(); if (w) DMFitWindowContent(w, NO); }
    else if ([cmd isEqualToString:@"winupdate"]) {   // experiment: tell MilkyWay the content area changed
        UIView *w = DMTopWindow();
        UIView *main = w ? [w valueForKey:@"mainView"] : nil;
        if (main) {
            CGRect r = main.frame;
            DMLog([NSString stringWithFormat:@"[winstate] calling updateContentViewFrame: %@", NSStringFromCGRect(r)]);
            ((void (*)(id, SEL, CGRect))objc_msgSend)(w, NSSelectorFromString(@"updateContentViewFrame:"), r);
        }
    }
    else if ([cmd hasPrefix:@"layout-"]) DMWindowLayout([cmd substringFromIndex:7]);
    else if ([cmd isEqualToString:@"active"]) DMLog([NSString stringWithFormat:@"[debug] active app %@, front app %@, windows in front %d, top window %@", [DMActiveApp() bundleIdentifier], [DMFrontApp() bundleIdentifier], DMWindowsInFront(), [(AXWindowView *)DMTopWindow() bundleIdentifier]]);
    else if ([cmd isEqualToString:@"close"]) DMCloseOverlay();
    else if ([cmd isEqualToString:@"light"]) gDebugStyle = 1;
    else if ([cmd isEqualToString:@"dark"]) gDebugStyle = 2;
    else if ([cmd isEqualToString:@"system"]) gDebugStyle = 0;
    else if ([cmd hasPrefix:@"a5borigin_"]) {   // a5borigin_<bundle>_<oy>: EXPERIMENT: move the stage's bounds origin (its content shifts, its frame stays) and log where Aerial lays the holder out
        NSString *rest = [cmd substringFromIndex:10];
        NSRange us = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (us.location == NSNotFound) return;
        UIView *stage = DMStageForBundle([rest substringToIndex:us.location]);
        if (!stage) return;
        CGRect b = stage.bounds; b.origin.y = [[rest substringFromIndex:us.location + 1] doubleValue]; stage.bounds = b;
        [stage setNeedsLayout]; [stage layoutIfNeeded];
        __weak UIView *ws = stage;
        for (NSNumber *t in @[@0.0, @0.3, @1.5]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(t.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *st = ws; if (!st) return;
            UIView *in = DMStageInnerView(st);
            DMLog([NSString stringWithFormat:@"[a5borigin] +%.1f s: stage frame %@ bounds %@ holder %@ handles BL %@", t.doubleValue, NSStringFromCGRect(st.frame), NSStringFromCGRect(st.bounds), NSStringFromCGRect(in.frame), NSStringFromCGRect(((UIView *)DMStageValue(st, @[@"_handleBL"])).frame)]);
        });
    }
    else if ([cmd hasPrefix:@"smgeo_"]) {   // smgeo_<bundle>_<cx>_<cy>[_<w>_<h>]: Stage Manager -- move (and size) that window: normalized center / size
        NSArray *q = [[cmd substringFromIndex:6] componentsSeparatedByString:@"_"];
        if (q.count < 3) return;
        DMSMSetWindowGeometry(q[0], CGPointMake([q[1] doubleValue], [q[2] doubleValue]), q.count >= 5 ? CGSizeMake([q[3] doubleValue], [q[4] doubleValue]) : CGSizeZero);
    }
    else if ([cmd isEqualToString:@"smchrome"]) {   // smchrome: the title bar pass on every window card now, with why (debug)
        Class cc = objc_getClass("SBFluidSwitcherItemContainer");
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *todo = [NSMutableArray arrayWithObject:w];
            for (NSUInteger i = 0; i < todo.count && i < 3000; i++) {
                UIView *v = todo[i];
                if (cc && [v isKindOfClass:cc]) {
                    DMSMChrome(v);
                    UIView *bar = objc_getAssociatedObject(v, kSMBarKey);
                    DMLog([NSString stringWithFormat:@"[smchrome] card %@ (%@) id %@ window %@ frame %@ tr %@ -> bar %@", NSStringFromClass([v class]), DMSMCardBundle(v), v.accessibilityIdentifier, NSStringFromClass([v.window class]), NSStringFromCGRect(v.frame), NSStringFromCGAffineTransform(v.transform), bar ? (bar.hidden ? @"hidden" : NSStringFromCGRect(bar.frame)) : @"none"]);
                }
                [todo addObjectsFromArray:v.subviews];
            }
        }
    }
    else if ([cmd hasPrefix:@"smzoom_"]) DMSMToggleZoom([cmd substringFromIndex:7]);   // smzoom_<bundle>: the green button's Zoom toggle on that window
    else if ([cmd hasPrefix:@"smpolicy_"]) {   // smpolicy_<bundle>_<policy>: Stage Manager study -- request that window again with its attributes' sizing policy set to <policy> (2 = maximized) and size of a snap-to-grid window
        NSArray *q = [[cmd substringFromIndex:9] componentsSeparatedByString:@"_"];
        if (q.count < 2) return;
        DMSMRequestWindow(q[0], nil, [q[1] integerValue]);
    }
    else if ([cmd hasPrefix:@"smmenu_"]) {   // smmenu_<bundle>: Stage Manager study -- that window's "..." menu as it is now (titles, action selectors that are set)
        id vc = DMSMTopAffordanceFor([cmd substringFromIndex:7]);
        UIMenu *m = DMCall(vc, @"menu");
        NSMutableString *out = [NSMutableString stringWithFormat:@"[smmenu] %@: %@", [cmd substringFromIndex:7], vc ? @"" : @"no controller"];
        NSMutableArray *todo = [NSMutableArray array];
        if ([m isKindOfClass:[UIMenu class]]) [todo addObject:@[m, @0]];
        while (todo.count) {
            NSArray *e0 = todo.firstObject; [todo removeObjectAtIndex:0];
            for (UIMenuElement *e in ((UIMenu *)e0[0]).children) {
                [out appendFormat:@"\n  %*s%@ (%@)", [e0[1] intValue] * 2, "", e.title, NSStringFromClass([e class])];
                if ([e isKindOfClass:[UIMenu class]]) [todo addObject:@[e, @([e0[1] intValue] + 1)]];
            }
        }
        for (NSString *a in @[@"close", @"fullScreen", @"maximization", @"removeFromSet", @"addToSet", @"moveToDisplay", @"slideOver", @"splitView"]) {
            id act = DMCall(vc, [a stringByAppendingString:@"Action"]);
            [out appendFormat:@"\n  %@Action: %@", a, [act isKindOfClass:[UIAction class]] ? [(UIAction *)act title] : @"-"];
        }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"appvol_"]) {   // appvol_<bundle>_<0..1>: that app's volume in the Audio menu, as its slider sets it (MixAudio tests)
        NSString *rest = [cmd substringFromIndex:7]; NSRange u = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (u.location != NSNotFound) { NSString *b = [rest substringToIndex:u.location]; float v = [[rest substringFromIndex:u.location + 1] floatValue];
            DMSetAudioVolumeAndNotify(b, v, YES); DMLog([NSString stringWithFormat:@"[appvol] %@ -> %.2f", b, v]); }
    }
    else if ([cmd hasPrefix:@"smwin_"]) {   // smwin_<bundle>_<close|removeFromSet>: OUR window action, as a traffic-light tap runs it (DMSMWindowAction)
        NSArray *q = [[cmd substringFromIndex:6] componentsSeparatedByString:@"_"];
        if (q.count >= 2) DMLog([NSString stringWithFormat:@"[smwin] %@ %@: %@", q[0], q[1], DMSMWindowAction(q[0], q[1]) ? @"done" : @"not available"]);
    }
    else if ([cmd hasPrefix:@"smaction_"]) {   // smaction_<bundle>_<close|fullScreen|maximization|removeFromSet|addToSet|moveToDisplay>: Stage Manager study -- run that window's own "..." menu action
        NSArray *q = [[cmd substringFromIndex:9] componentsSeparatedByString:@"_"];
        if (q.count < 2) return;
        id vc = DMSMTopAffordanceFor(q[0]);
        id action = vc ? DMCall(vc, [q[1] stringByAppendingString:@"Action"]) : nil;
        DMLog([NSString stringWithFormat:@"[smaction] %@ %@: controller %@ action %@", q[0], q[1], vc ? @"found" : @"NOT found", action]);
        if ([action isKindOfClass:[UIAction class]]) DMSMRunAction(action, vc);
    }
    else if ([cmd hasPrefix:@"smopen_"]) {   // smopen_<bundle>_<x>_<y>[_<role>]: Stage Manager study -- open an app through a workspace transition with requested layout attributes (a copy of the front window's, center (x, y) normalized), in layout role <role> (default 1)
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        if (q.count < 3) return;
        NSString *bundle = q[0]; CGPoint c = CGPointMake([q[1] doubleValue], [q[2] doubleValue]);
        long role = q.count > 3 ? [q[3] integerValue] : 1;
        @try {
            id app = ((id (*)(id, SEL, id))objc_msgSend)(DMCall(objc_getClass("SBApplicationController"), @"sharedInstance"), NSSelectorFromString(@"applicationWithBundleIdentifier:"), bundle);
            id entity = app ? ((id (*)(id, SEL, id))objc_msgSend)([objc_getClass("SBDeviceApplicationSceneEntity") alloc], NSSelectorFromString(@"initWithApplicationForMainDisplay:"), app) : nil;
            id coord = DMCall(objc_getClass("SBMainSwitcherControllerCoordinator"), @"sharedInstance");
            id al = [DMCall(coord, @"recentAppLayouts") firstObject];
            id item = [[DMCall(al, @"itemsToLayoutAttributesMap") allKeys] firstObject];
            id base = item ? ((id (*)(id, SEL, id))objc_msgSend)(al, NSSelectorFromString(@"layoutAttributesForItem:"), item) : nil;
            id attrs = base ? ((id (*)(id, SEL, CGPoint))objc_msgSend)(base, NSSelectorFromString(@"attributesByModifyingNormalizedCenter:"), c) : nil;
            DMLog([NSString stringWithFormat:@"[smopen] %@ entity %@ role %ld attrs %@", bundle, NSStringFromClass([entity class]), role, [[attrs description] stringByReplacingOccurrencesOfString:@"\n" withString:@" "]]);
            if (!entity) return;
            id ws = DMCall(objc_getClass("SBMainWorkspace"), @"sharedInstance");
            void (^builder)(id) = ^(id req) {
                if ([req respondsToSelector:NSSelectorFromString(@"setEventLabel:")]) ((void (*)(id, SEL, id))objc_msgSend)(req, NSSelectorFromString(@"setEventLabel:"), @"MSBDStageStudyOpen");
                void (^ctxBlock)(id) = ^(id ctx) {
                    ((void (*)(id, SEL, id, long))objc_msgSend)(ctx, NSSelectorFromString(@"setEntity:forLayoutRole:"), entity, role);
                    if (attrs) ((void (*)(id, SEL, id, id))objc_msgSend)(ctx, NSSelectorFromString(@"setRequestedLayoutAttributes:forEntity:"), attrs, entity);
                };
                ((void (*)(id, SEL, id))objc_msgSend)(req, NSSelectorFromString(@"modifyApplicationContext:"), ctxBlock);
            };
            ((void (*)(id, SEL, id))objc_msgSend)(ws, NSSelectorFromString(@"requestTransitionWithBuilder:"), builder);
            DMLog(@"[smopen] transition requested");
        } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[smopen] refused: %@", e.reason]); }
    }
    else if ([cmd hasPrefix:@"smmove_"]) {   // smmove_<x>_<y>: Stage Manager study -- the front stage's first window moved to the normalized center (x, y) through the same request Stage Manager's own drags submit
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        if (q.count < 2) return;
        CGPoint c = CGPointMake([q[0] doubleValue], [q[1] doubleValue]);
        @try {
            id coord = DMCall(objc_getClass("SBMainSwitcherControllerCoordinator"), @"sharedInstance");
            id sc = DMCall(coord, @"_activeDisplaySwitcherController");
            id content = DMCall(sc, @"contentViewController");
            id al = [DMCall(coord, @"recentAppLayouts") firstObject];
            id item = [[DMCall(al, @"itemsToLayoutAttributesMap") allKeys] firstObject];
            id attrs = item ? ((id (*)(id, SEL, id))objc_msgSend)(al, NSSelectorFromString(@"layoutAttributesForItem:"), item) : nil;
            id moved = attrs ? ((id (*)(id, SEL, CGPoint))objc_msgSend)(attrs, NSSelectorFromString(@"attributesByModifyingNormalizedCenter:"), c) : nil;
            id newAl = moved ? ((id (*)(id, SEL, id, id))objc_msgSend)(al, NSSelectorFromString(@"appLayoutByModifyingLayoutAttributes:forItem:"), moved, item) : nil;
            id req = [objc_getClass("SBMutableSwitcherTransitionRequest") new];
            if (newAl) ((void (*)(id, SEL, id))objc_msgSend)(req, NSSelectorFromString(@"setAppLayout:"), newAl);
            SEL perform = NSSelectorFromString(@"switcherContentController:performTransitionWithRequest:gestureInitiated:");
            DMLog([NSString stringWithFormat:@"[smmove] coord %d sc %@ content %@ item %@ -> center %@ (was %@)", coord != nil, NSStringFromClass([sc class]), NSStringFromClass([content class]), DMCall(item, @"bundleIdentifier"), NSStringFromCGPoint(c), attrs ? NSStringFromCGPoint(((CGPoint (*)(id, SEL))objc_msgSend)(attrs, NSSelectorFromString(@"normalizedCenter"))) : @"-"]);
            if (newAl && content && [coord respondsToSelector:perform]) ((void (*)(id, SEL, id, id, BOOL))objc_msgSend)(coord, perform, content, req, NO);
            DMLog(@"[smmove] request submitted");
        } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[smmove] refused: %@", e.reason]); }
    }
#if DEBUG
    else if ([cmd isEqualToString:@"smfloor"]) DMSMDeskDebugFloor();   // smfloor: the switcher's Home Screen answers, content reasons, pass-through (read-only, SMDesktop.h)
#endif
    else if ([cmd hasPrefix:@"smdump"]) {   // smdump[_<n>]: Stage Manager study -- the first n (default 3) recent app layouts (stages) with their items' layout attributes and display ordinal (read-only)
        int n = [cmd hasPrefix:@"smdump_"] ? MAX(1, [[cmd substringFromIndex:7] intValue]) : 3;
        id coord = DMCall(objc_getClass("SBMainSwitcherControllerCoordinator"), @"sharedInstance");
        NSArray *layouts = DMCall(coord, @"recentAppLayouts");
        DMLog([NSString stringWithFormat:@"[smdump] %lu recent app layouts", (unsigned long)layouts.count]);
        int i = 0;
        for (id al in layouts) {
            if (i++ >= n) break;
            NSString *d = [[al description] stringByReplacingOccurrencesOfString:@"\n" withString:@" "];
            DMLog([NSString stringWithFormat:@"[smdump] #%d %@", i, d.length > 1500 ? [d substringToIndex:1500] : d]);
            NSDictionary *map = DMCall(al, @"itemsToLayoutAttributesMap");
            SEL roleSel = NSSelectorFromString(@"layoutRoleForItem:");
            for (id item in map) DMLog([NSString stringWithFormat:@"[smdump]    role %ld", [al respondsToSelector:roleSel] ? ((long (*)(id, SEL, id))objc_msgSend)(al, roleSel, item) : -1L]);
            for (id item in map) DMLog([NSString stringWithFormat:@"[smdump]    %@ (policy %ld) -> %@", DMCall(item, @"bundleIdentifier") ?: item, [map[item] respondsToSelector:NSSelectorFromString(@"sizingPolicy")] ? ((long (*)(id, SEL))objc_msgSend)(map[item], NSSelectorFromString(@"sizingPolicy")) : -1L, [[map[item] description] stringByReplacingOccurrencesOfString:@"\n" withString:@" "]]);
            for (id item in map) { DMSMAttributedSize sz = ((DMSMAttributedSize (*)(id, SEL))objc_msgSend)(map[item], NSSelectorFromString(@"attributedSize"));
                DMLog([NSString stringWithFormat:@"[smdump]    %@ size %@ type %lld of reference %@ (display %@)", DMCall(item, @"bundleIdentifier"), NSStringFromCGSize(sz.normalizedSize), sz.type, NSStringFromCGRect(sz.referenceBounds), DMCall(al, @"preferredDisplayIdentity")]); }
        }
    }
    else if ([cmd hasPrefix:@"stagemgr_"]) {   // stagemgr_<0|1|get>: read or set SpringBoard's Stage Manager setting (as Settings / Control Center would) -- tests the hold
        id sd = DMSwitcherDefaults();
        SEL get = NSSelectorFromString(@"chamoisWindowingEnabled"), set = NSSelectorFromString(@"setChamoisWindowingEnabled:");
        if (![sd respondsToSelector:get]) { DMLog(@"[stagemgr] no Stage Manager setting here"); return; }
        NSString *arg = [cmd substringFromIndex:9];
        if ([arg isEqualToString:@"forget"]) {   // (test clean-up: drop the remembered "the user had it on")
            CFPreferencesSetValue(CFSTR("stageManagerUserOn"), NULL, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        }
        else if ([arg hasPrefix:@"ever"] && [sd respondsToSelector:NSSelectorFromString(@"setChamoisEverEnabled:")])   // stagemgr_ever<0|1>: Apple's "ever enabled" mark (test the first switch-on)
            ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, NSSelectorFromString(@"setChamoisEverEnabled:"), [[arg substringFromIndex:4] boolValue]);
        else if (![arg isEqualToString:@"get"]) ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, set, [arg boolValue]);
        SEL ever = NSSelectorFromString(@"chamoisEverEnabled");
        DMLog([NSString stringWithFormat:@"[stagemgr] setting now %d (ever enabled %@)", ((BOOL (*)(id, SEL))objc_msgSend)(sd, get), DMBoolStr(sd, NSStringFromSelector(ever))]);
    }
    else if ([cmd hasPrefix:@"zflex_"]) {   // zflex_<bundle>: EXPERIMENT: lay the app out at its Zetsu window's content size (scene frame = content area, picture 1:1) instead of Zetsu's scaled full-screen picture
        NSString *b = [cmd substringFromIndex:6];
        UIWindow *w = DMZetsuWindowFor(b);
        UIView *host = nil; @try { host = [DMZetsuController(w) valueForKey:@"hosts"]; } @catch (id e) {}
        UIView *content = [host isKindOfClass:[UIView class]] ? host.subviews.firstObject : nil;
        id scene = DMSceneForBundle(b);
        if (!w || !content || !scene) { DMLog([NSString stringWithFormat:@"[zflex] %@: window %d content %d scene %d", b, w != nil, content != nil, scene != nil]); return; }
        CGRect r = [host convertRect:host.bounds toCoordinateSpace:w.screen.coordinateSpace];
        if (!gZetsuFlexFrames) gZetsuFlexFrames = [NSMutableDictionary dictionary];
        gZetsuFlexFrames[b] = [NSValue valueWithCGRect:r];
        BOOL ok = DMSetSceneFrame(scene, r);
        content.transform = CGAffineTransformIdentity;
        content.bounds = CGRectMake(0, 0, host.bounds.size.width, host.bounds.size.height);
        content.center = CGPointMake(host.bounds.size.width / 2.0, host.bounds.size.height / 2.0);
        DMLog([NSString stringWithFormat:@"[zflex] %@: scene frame %@ (%d), content %@ class %@", b, NSStringFromCGRect(r), ok, NSStringFromCGRect(content.frame), NSStringFromClass([content class])]);
    }
    else if ([cmd hasPrefix:@"real_"]) {   // real_<light0|light1|light2|bar|grip|content|gripl>_<bundle>[_<dx>_<dy>]: a REAL injected tap / drag on that part of that window (any engine), found from our own views
        NSArray *q = [[cmd substringFromIndex:5] componentsSeparatedByString:@"_"];
        if (q.count < 2) return;
        NSString *part = q[0], *bundle = q[1];
        CGFloat dx = q.count > 3 ? [q[2] doubleValue] : 0, dy = q.count > 3 ? [q[3] doubleValue] : 0;
        UIView *stage = DMStageForBundle(bundle);
        if (!stage) { DMLog([NSString stringWithFormat:@"[real] %@: no window", bundle]); return; }
        // (never tap where a window is not showing: a tap meant for a hidden window's title bar once hit the full-screen app behind it -- Reminders'
        // Edit button -- in the iPad 2 cross-test)
        if (stage.hidden || !stage.window || stage.window.hidden || DMEffectiveAlpha(stage) < 0.5 || DMStageMinimized(stage)) { DMLog([NSString stringWithFormat:@"[real] %@: its window is not showing: no tap", bundle]); return; }
        UIView *lights = objc_getAssociatedObject(stage, kStageLightsKey) ?: objc_getAssociatedObject(stage, kZetsuLightsKey);
        UIView *ref = nil; CGPoint local = CGPointZero;
        if ([part hasPrefix:@"light"]) { NSInteger n = [[part substringFromIndex:5] integerValue]; for (UIView *b in lights.subviews) if ([b isKindOfClass:[UIButton class]] && b.tag == n) ref = b; local = CGPointMake(ref.bounds.size.width / 2.0, ref.bounds.size.height / 2.0); }
        else if ([part isEqualToString:@"bar"]) { ref = lights; local = CGPointMake(lights.bounds.size.width + 120.0, lights.bounds.size.height / 2.0); }
        else if ([part isEqualToString:@"grip"] || [part isEqualToString:@"gripl"]) {
            BOOL l = [part isEqualToString:@"gripl"];
            ref = objc_getAssociatedObject(stage, l ? kA5GripBLKey : kA5GripBRKey) ?: objc_getAssociatedObject(stage, l ? kZetsuGripLKey : kZetsuGripRKey) ?: objc_getAssociatedObject(stage, l ? kStageGripBLKey : kStageGripBRKey);
            if (ref.subviews.count) { UIView *g = ref.subviews.firstObject; local = g.center; } else local = CGPointMake(ref.bounds.size.width / 2.0, ref.bounds.size.height / 2.0);
        }
        else if ([part isEqualToString:@"content"]) { ref = DMStageInnerView(stage); if (!ref) { @try { ref = [DMZetsuController((UIWindow *)stage) valueForKey:@"hosts"]; } @catch (id e) {} } local = CGPointMake(ref.bounds.size.width / 2.0, ref.bounds.size.height / 2.0); }
        if (![ref isKindOfClass:[UIView class]] || !ref.window) { DMLog([NSString stringWithFormat:@"[real] %@ %@: part not found", bundle, part]); return; }
        CGPoint p = [ref.window convertPoint:[ref convertPoint:local toView:nil] toCoordinateSpace:ref.window.screen.coordinateSpace];
        DMLog([NSString stringWithFormat:@"[real] %@ %@ at screen %@ %@", bundle, part, NSStringFromCGPoint(p), (dx || dy) ? [NSString stringWithFormat:@"dragged by %.0f,%.0f", dx, dy] : @"tapped"]);
        if (dx || dy) { CGPoint e = CGPointMake(p.x + dx, p.y + dy); DMSysTouchReady(^{ DMSysDrag(p, e, 450, 0); }); }
        else DMSysTouchReady(^{ DMSysTap(p); });
    }
    else if ([cmd hasPrefix:@"zclose_"]) { UIWindow *zw = DMZetsuWindowFor([cmd substringFromIndex:7]); if (zw) DMZetsuClose(zw); else DMLog(@"[zclose] no window"); }   // zclose_<bundle>: Zetsu's own close (the app keeps running)
    else if ([cmd isEqualToString:@"screenwake"]) {   // screenwake: turn the screen on (the second "wake" below is shadowed by the stages' one)
        SBBacklightController *bl = DMShared("SBBacklightController", @selector(sharedInstance));
        if ([bl respondsToSelector:@selector(turnOnScreenFullyWithBacklightSource:)]) [bl turnOnScreenFullyWithBacklightSource:1];
        DMLog(@"[debug] screen wake requested");
    }
    else if ([cmd hasPrefix:@"hidbutton_"]) {   // hidbutton_<page>_<usage>_<ms>: an injected HID button press (0x0c/0x40 = Home/Menu, 0x0c/0x30 = Power) -- wakes / unlocks for tests
        NSArray *q = [[cmd substringFromIndex:10] componentsSeparatedByString:@"_"];
        if (q.count < 2) return;
        uint32_t page = (uint32_t)strtoul([q[0] UTF8String], NULL, 16), usage = (uint32_t)strtoul([q[1] UTF8String], NULL, 16);
        double ms = q.count > 2 ? [q[2] doubleValue] : 90;
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        void *(*createKey)(CFAllocatorRef, uint64_t, uint32_t, uint32_t, int, uint32_t) = dlsym(iokit, "IOHIDEventCreateKeyboardEvent");
        void (*disp)(void *, void *) = dlsym(iokit, "IOHIDEventSystemClientDispatchEvent");
        void *(*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        static void *client = NULL; if (!client && create) client = create(kCFAllocatorDefault);
        if (!createKey || !disp || !client) return;
        void *down = createKey(kCFAllocatorDefault, mach_absolute_time(), page, usage, 1, 0);
        if (down) { disp(client, down); CFRelease(down); }
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{
            void *up = createKey(kCFAllocatorDefault, mach_absolute_time(), page, usage, 0, 0);
            if (up) { disp(client, up); CFRelease(up); }
        });
        DMLog([NSString stringWithFormat:@"[hid] button page 0x%x usage 0x%x pressed for %.0f ms", page, usage, ms]);
    }
    else if ([cmd isEqualToString:@"closeall"]) {   // closeall: every window closed the red light's way (the app is quit), any engine -- test set-up
        for (UIView *st in [DMAerialStages() copy]) { NSString *b = DMStageBundle(st); if (b.length) DMForceQuitBundle(b); }
        DMLog(@"[debug] closeall: every window's app quit");
    }
    else if ([cmd isEqualToString:@"fitcheck"]) {   // fitcheck: is every Fit to Window tile exactly in its slot? one line: ok/BAD + details (tests)
        NSMutableString *out = [NSMutableString string]; BOOL good = YES;
        for (NSString *b in gFitGroup) {
            UIView *st = DMStageForBundle(b); CGRect f = DMSlotFrame(b), cur = st.frame;
            BOOL ok = st && !CGRectIsNull(f) && fabs(f.origin.x - cur.origin.x) <= 1.0 && fabs(f.origin.y - cur.origin.y) <= 1.0 && fabs(f.size.width - cur.size.width) <= 1.0 && fabs(f.size.height - cur.size.height) <= 1.0;
            if (!ok) good = NO;
            [out appendFormat:@" %@=%@%@", [b componentsSeparatedByString:@"."].lastObject, gFitSlots[b], ok ? @"" : [NSString stringWithFormat:@"(BAD %@ want %@)", NSStringFromCGRect(cur), NSStringFromCGRect(f)]];
        }
        NSMutableString *others = [NSMutableString string];
        for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length && ![gFitGroup containsObject:b]) [others appendFormat:@" %@%@", [b componentsSeparatedByString:@"."].lastObject, DMStageMinimized(st) || st.hidden ? @"(min)" : @""]; }
        DMLog([NSString stringWithFormat:@"[fitcheck] %@ group %lu:%@ | not tiled:%@", good ? @"ok" : @"BAD", (unsigned long)gFitGroup.count, out, others]);
    }
    else if ([cmd hasPrefix:@"placewin_"]) {   // placewin_<bundle>_<layout name>: put THAT app's window at a layout (fill/center/left/...), whichever app is active -- test setups
        NSString *rest = [cmd substringFromIndex:9];
        NSRange us = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (us.location == NSNotFound) return;
        NSString *bundle = [rest substringToIndex:us.location], *name = [rest substringFromIndex:us.location + 1];
        UIView *stage = DMStageForBundle(bundle); CGRect target = DMLayoutFrame(name);
        if (!stage || CGRectIsNull(target)) { DMLog([NSString stringWithFormat:@"[placewin] %@: no window or no layout %@", bundle, name]); return; }
        DMFitGroupForget(bundle);
        DMSetStageIntent(stage, target);
        DMAerialMoveStage(stage, target, ^{ DMRememberStageFrame(stage); });
        DMLog([NSString stringWithFormat:@"[placewin] %@ -> %@ %@ (window %@)", bundle, name, NSStringFromCGRect(target), NSStringFromCGRect(DMLayoutFrameWindow(name))]);
    }
    else if ([cmd hasPrefix:@"a5host_"]) {   // a5host_<bundle>_<x>_<y>_<w>_<h>_<radius>_<masked>: EXPERIMENT: write the app holder's frame / corner radius / masked corners (w<=0: frame untouched), then log what Aerial leaves of it
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        if (q.count < 7) return;
        UIView *stage = DMStageForBundle(q[0]); UIView *in = stage ? DMStageInnerView(stage) : nil;
        if (!in) { DMLog(@"[a5host] no such window"); return; }
        CGRect f = CGRectMake([q[1] doubleValue], [q[2] doubleValue], [q[3] doubleValue], [q[4] doubleValue]);
        if (f.size.width > 50 && f.size.height > 50) in.frame = f;
        in.layer.cornerRadius = [q[5] doubleValue]; in.layer.maskedCorners = (CACornerMask)[q[6] integerValue];
        __weak UIView *wi = in;
        for (NSNumber *t in @[@0.0, @0.05, @0.3, @1.0, @3.0]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(t.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *v = wi; if (!v) return;
            DMLog([NSString stringWithFormat:@"[a5host] +%.2f s: holder %@ radius %.1f masked %lu clips %d", t.doubleValue, NSStringFromCGRect(v.frame), v.layer.cornerRadius, (unsigned long)v.layer.maskedCorners, v.clipsToBounds]);
        });
    }
    else if ([cmd hasPrefix:@"sysstyle_"]) {   // sysstyle_<1 light|2 dark>: the SYSTEM appearance (like Control Center's Dark Mode button), through SpringBoard's own arbiter singleton
        long long want = [[cmd substringFromIndex:9] longLongValue];
        Class c = objc_getClass("UIUserInterfaceStyleArbiter");
        id arb = [c respondsToSelector:@selector(sharedInstance)] ? ((id (*)(id, SEL))objc_msgSend)(c, @selector(sharedInstance)) : nil;
        SEL cur = NSSelectorFromString(@"currentStyle"), tog = NSSelectorFromString(@"toggleCurrentStyle");
        if (!arb || ![arb respondsToSelector:cur] || ![arb respondsToSelector:tog]) { DMLog(@"[sysstyle] no arbiter"); return; }
        long long now = ((long long (*)(id, SEL))objc_msgSend)(arb, cur);
        if (now != want && (want == 1 || want == 2)) ((void (*)(id, SEL))objc_msgSend)(arb, tog);
        DMLog([NSString stringWithFormat:@"[sysstyle] was %lld, wanted %lld -> now %lld", now, want, ((long long (*)(id, SEL))objc_msgSend)(arb, cur)]);
    }
    else if ([cmd isEqualToString:@"caps"]) {   // read-only: which sleep/lock related methods exist here (nothing is called)
        SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
        for (NSString *s in @[@"_simulateLockButtonPress", @"_simulateHomeButtonPress", @"_accessibilityLockDevice", @"lockDevice", @"_lockButtonDown:", @"_lockButtonUp:"])
            DMLog([NSString stringWithFormat:@"[caps] SpringBoard responds to %@: %d", s, [sb respondsToSelector:NSSelectorFromString(s)]]);
        for (NSString *cn in @[@"SBUserAgent", @"SBLockScreenManager", @"SBBacklightController", @"SBLockHardwareButton", @"SBLockHardwareButtonActions"]) {
            Class c = objc_getClass(cn.UTF8String);
            if (!c) { DMLog([NSString stringWithFormat:@"[caps] class %@ missing", cn]); continue; }
            NSMutableArray *names = [NSMutableArray array];
            for (int meta = 0; meta < 2; meta++) {
                unsigned n = 0; Method *ms = class_copyMethodList(meta ? object_getClass(c) : c, &n);
                for (unsigned i = 0; i < n; i++) {
                    NSString *m = NSStringFromSelector(method_getName(ms[i]));
                    for (NSString *k in @[@"lock", @"dim", @"sleep", @"shared", @"screenOff", @"turnOff", @"backlight"])
                        if ([m localizedCaseInsensitiveContainsString:k]) { [names addObject:[(meta ? @"+" : @"-") stringByAppendingString:m]]; break; }
                }
                free(ms);
            }
            DMLog([NSString stringWithFormat:@"[caps] %@: %@", cn, [names componentsJoinedByString:@" "]]);
        }
    }
    else if ([cmd hasPrefix:@"seq-"]) {   // seq-green | seq-window: run a transition and capture the screen at several moments
        NSString *what = [cmd substringFromIndex:4];
        NSArray *offsets = @[@0.05, @0.20, @0.35, @0.50, @0.70, @0.95, @1.25, @1.7];
        for (NSUInteger i = 0; i < offsets.count; i++) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)([offsets[i] doubleValue] * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIView *snap = [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO];
                UIWindow *host = DMStatusBarWindow();
                if (!snap || !host) return;
                [host addSubview:snap];
                UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 0.4;
                UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:snap.bounds.size format:fmt];
                UIImage *img = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) { [snap drawViewHierarchyInRect:snap.bounds afterScreenUpdates:YES]; }];
                [UIImagePNGRepresentation(img) writeToFile:[NSString stringWithFormat:@"/tmp/macstatusbar-seq-%lu.png", (unsigned long)i] atomically:YES];
                [snap removeFromSuperview];
            });
        }
        if ([what isEqualToString:@"green"]) DMLightAction(2);
        else if ([what isEqualToString:@"window"]) {
            NSString *bid = [[DMActiveApp() bundleIdentifier] length] ? [DMActiveApp() bundleIdentifier] : @"com.apple.Preferences";
            UIView *w = DMFindMilkyWayWindow(bid);
            if (w) ((void (*)(id, SEL, id))objc_msgSend)(w, NSSelectorFromString(@"maxButtonAction:"), nil);
        }
    }
    else if ([cmd isEqualToString:@"menuwins"] || [cmd isEqualToString:@"menubase"]) {   // report view classes that APPEAR after the baseline
        static NSMutableSet *baseline = nil;
        BOOL reset = [cmd isEqualToString:@"menubase"];
        if (reset || !baseline) baseline = [NSMutableSet set];
        NSMutableSet *now = [NSMutableSet set];
        for (UIWindow *w in DMAllWindows()) {
            if (w.hidden) continue;
            NSMutableArray *names = [NSMutableArray array];
            DMCollectClassNames(w, 0, names);
            [now addObject:[NSString stringWithFormat:@"WINDOW %@ level %.1f", NSStringFromClass([w class]), w.windowLevel]];
            for (NSString *n in names) [now addObject:[NSString stringWithFormat:@"%@ (level %.1f): %@", NSStringFromClass([w class]), w.windowLevel, n]];
        }
        if (!reset) {
            NSMutableSet *fresh = [now mutableCopy]; [fresh minusSet:baseline];
            int shown = 0;
            for (NSString *s in [[fresh allObjects] sortedArrayUsingSelector:@selector(compare:)]) if (shown++ < 25) DMLog([NSString stringWithFormat:@"[menuwins] NEW %@", s]);
        }
        [baseline unionSet:now];
        if (reset) DMLog(@"[menuwins] baseline recorded");
    }
    else if ([cmd isEqualToString:@"winmin"]) {   // press MilkyWay's own orange button on its first window
        Class viewClass = objc_getClass("AXWindowView");
        UIView *target = nil;
        for (UIView *v in DMMilkyWayLayer().subviews) if (viewClass && [v isKindOfClass:viewClass]) { target = v; break; }
        if (target) {
            DMLog([NSString stringWithFormat:@"[debug] pressing orange on %@ (frame before %@)", [(AXWindowView *)target bundleIdentifier], NSStringFromCGRect(target.frame)]);
            UIControl *orange = [target valueForKey:@"minButton"];   // a real press of the button, so its own target/action is what runs
            if ([orange isKindOfClass:[UIControl class]]) [orange sendActionsForControlEvents:UIControlEventTouchUpInside];
            else DMLog(@"[debug] no minButton control");
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                DMLog([NSString stringWithFormat:@"[debug] after orange: frame %@ hidden %d alpha %.2f, %lu windows, front %@", NSStringFromCGRect(target.frame), target.hidden, target.alpha, (unsigned long)DMMilkyWayWindowCount(), [DMFrontApp() bundleIdentifier]]);
            });
        } else DMLog(@"[debug] no window to press orange on");
    }
    else if ([cmd isEqualToString:@"methods"]) {   // list launch-related selectors of the classes that start apps
        for (NSString *cn in @[@"SBMainWorkspace", @"SBWorkspace", @"SBUIController", @"SBApplicationIcon", @"SBIcon", @"SBIconController", @"SBApplication", @"SBSceneManagerCoordinator", @"SBAppSwitcherController", @"SBMainSwitcherViewController", @"SBWorkspaceEntity", @"SBApplicationSceneEntity", @"SBWorkspaceTransitionRequest", @"SBMainWorkspaceTransitionRequest", @"SBLaunchAppWorkspaceTransaction", @"SBFluidSwitcherViewController"]) {
            Class c = objc_getClass(cn.UTF8String);
            if (!c) { DMLog([NSString stringWithFormat:@"[methods] %@ missing", cn]); continue; }
            for (int meta = 0; meta < 2; meta++) {
                unsigned n = 0;
                Method *ms = class_copyMethodList(meta ? object_getClass(c) : c, &n);
                NSMutableArray *names = [NSMutableArray array];
                for (unsigned i = 0; i < n; i++) {
                    NSString *s = NSStringFromSelector(method_getName(ms[i]));
                    if ([s rangeOfString:@"activate" options:NSCaseInsensitiveSearch].location != NSNotFound || [s rangeOfString:@"launch" options:NSCaseInsensitiveSearch].location != NSNotFound || [s rangeOfString:@"transitionRequest" options:NSCaseInsensitiveSearch].location != NSNotFound || [s rangeOfString:@"requestTransition" options:NSCaseInsensitiveSearch].location != NSNotFound || [s rangeOfString:@"openApp" options:NSCaseInsensitiveSearch].location != NSNotFound) [names addObject:s];
                }
                free(ms);
