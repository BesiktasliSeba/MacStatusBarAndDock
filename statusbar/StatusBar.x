        if ([avsc respondsToSelector:getCat]) ((BOOL (*)(id, SEL, float *, NSString *))objc_msgSend)(avsc, getCat, &media, @"Audio/Video");
        DMLog([NSString stringWithFormat:@"[debug] sysvol: active %.2f (%@), media %.2f", vol, name, media]);
    }
    else if ([cmd hasPrefix:@"mrcmd_"]) {   // mrcmd_<n>: MRMediaRemoteSendCommand(n) to the Now Playing app, what Control Center's player sends (0 play, 1 pause, 2 toggle) (debug)
        Boolean (*send)(uint32_t, CFDictionaryRef) = (Boolean (*)(uint32_t, CFDictionaryRef))dlsym(dlopen("/System/Library/PrivateFrameworks/MediaRemote.framework/MediaRemote", RTLD_LAZY), "MRMediaRemoteSendCommand");
        uint32_t c = (uint32_t)[[cmd substringFromIndex:6] intValue];
        Boolean ok = (send && c <= 2) ? send(c, NULL) : 0;
        DMLog([NSString stringWithFormat:@"[debug] mrcmd %u sent: %d", c, ok]);
    }
