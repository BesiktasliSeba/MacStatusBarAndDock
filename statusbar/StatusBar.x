        BOOL canvas = fabs(f.origin.x) < 0.5 && fabs(f.origin.y) < 0.5 && ((fabs(f.size.width - lo) < 0.5 && fabs(f.size.height - hi) < 0.5) || (fabs(f.size.width - hi) < 0.5 && fabs(f.size.height - lo) < 0.5));
