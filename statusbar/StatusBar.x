    else if ([cmd hasPrefix:@"orient3_"]) {   // orient3_<3|4>: try several ways of turning the interface, one after the other, logging the orientation after each
        long o = [[cmd substringFromIndex:8] integerValue];
        id mgr = DMCall(objc_getClass("SBOrientationLockManager"), @"sharedInstance");
        NSArray<void (^)(void)> *attempts = @[
            ^{ SEL sel = NSSelectorFromString(@"enableLockOverrideForReason:suggestOrientation:"); if ([mgr respondsToSelector:sel]) ((void (*)(id, SEL, id, long))objc_msgSend)(mgr, sel, @"macstatusbar-a", o); },
            ^{ SEL sel = NSSelectorFromString(@"setLockOverrideEnabled:forReason:"); if ([mgr respondsToSelector:sel]) ((void (*)(id, SEL, BOOL, id))objc_msgSend)(mgr, sel, YES, @"macstatusbar-b"); },
            ^{ @try { [[UIDevice currentDevice] setValue:@(o) forKey:@"orientation"]; } @catch (id e) {} },
