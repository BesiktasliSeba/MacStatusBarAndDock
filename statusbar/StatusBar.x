        __block void (^walk)(UIView *, int);
        void (^w2)(UIView *, int) = ^(UIView *v, int d) {
            NSString *extra = [v isKindOfClass:[UILabel class]] ? [NSString stringWithFormat:@" \"%@\" %@ %.1f", ((UILabel *)v).text, ((UILabel *)v).font.fontName, ((UILabel *)v).font.pointSize] : @"";
            if (d < 9) DMLog([NSString stringWithFormat:@"[ctxtree] %*s%@ %@ r%.1f a%.2f%@", d * 2, "", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.layer.cornerRadius, v.alpha, extra]);
            if (d < 9 && ![v isKindOfClass:[UILabel class]]) for (UIView *c in v.subviews) walk(c, d + 1);
