            if (w.hidden) continue;
            NSMutableArray *st = [NSMutableArray arrayWithObject:w];
            while (st.count && !menu) { UIView *v = st.lastObject; [st removeLastObject]; if ([NSStringFromClass([v class]) isEqualToString:@"_UIContextMenuView"]) { menu = v; inWin = w; } [st addObjectsFromArray:v.subviews]; }
            if (menu) break;
