        SEL add = NSSelectorFromString(@"_addLockOverrideReason:orientation:force:"), upd = NSSelectorFromString(@"updateLockOverrideForCurrentDeviceOrientation"), rm = NSSelectorFromString(@"_removeLockOverrideReason:");
        if ([mgr respondsToSelector:rm]) ((void (*)(id, SEL, id))objc_msgSend)(mgr, rm, @"macstatusbar-test2");
        if (o > 0 && [mgr respondsToSelector:add]) ((void (*)(id, SEL, id, long, BOOL))objc_msgSend)(mgr, add, @"macstatusbar-test2", o, YES);
