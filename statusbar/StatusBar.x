    cached = v && (CFGetTypeID(v) == CFBooleanGetTypeID() ? CFBooleanGetValue(v) : CFGetTypeID(v) == CFNumberGetTypeID() && [(__bridge NSNumber *)v boolValue]);
    if (v) CFRelease(v);
