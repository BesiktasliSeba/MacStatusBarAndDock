    }
    else if ([cmd isEqualToString:@"vcorient"]) {   // vcorient: each visible window's root view controller and the orientations it supports -- read-only
        for (UIWindow *w in DMAllWindows()) {
            if (w.hidden) continue;
            UIViewController *vc = w.rootViewController;
            unsigned long mask = vc ? (unsigned long)[vc supportedInterfaceOrientations] : 0;
            BOOL autorot = vc ? [vc shouldAutorotate] : NO;
            DMLog([NSString stringWithFormat:@"[vcorient] %@ level %.1f root %@ supported mask %lu autorotate %d", NSStringFromClass([w class]), w.windowLevel, vc ? NSStringFromClass([vc class]) : @"-", mask, autorot]);
        }
    }
    else if ([cmd isEqualToString:@"sceneorient"]) {   // sceneorient: every known app scene's orientation, foreground and the orientations its app says it supports -- read-only
        for (NSString *sid in [gSceneByID allKeys]) {
            id scene = gSceneByID[sid].scene; if (!scene) continue;
            id st = nil, cl = nil; @try { st = [scene valueForKey:@"settings"]; cl = [scene valueForKey:@"clientSettings"]; } @catch (id e) {}
            long o = [st respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(st, NSSelectorFromString(@"interfaceOrientation")) : -1;
            unsigned long mask = [cl respondsToSelector:NSSelectorFromString(@"supportedInterfaceOrientations")] ? ((unsigned long (*)(id, SEL))objc_msgSend)(cl, NSSelectorFromString(@"supportedInterfaceOrientations")) : 999;
            long co = [cl respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(cl, NSSelectorFromString(@"interfaceOrientation")) : -1;
            DMLog([NSString stringWithFormat:@"[sceneorient] %@: settings orientation %ld foreground %d, client orientation %ld supported mask %lu", sid, o, DMSettingsForeground(st), co, mask]);
        }
    }
    else if ([cmd isEqualToString:@"iconlayout"]) {   // iconlayout: the Home Screen's scroll views and icon lists (frames in the window, offsets) -- read-only
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBHomeScreenWindow"]) continue;
            DMLog([NSString stringWithFormat:@"[iconlayout] window frame %@ bounds %@ transform %@", NSStringFromCGRect(w.frame), NSStringFromCGRect(w.bounds), NSStringFromCGAffineTransform(w.transform)]);
            NSMutableArray *queue = [NSMutableArray arrayWithObject:w]; int n = 0;
            while (queue.count && n < 60) {
                UIView *v = queue[0]; [queue removeObjectAtIndex:0];
                NSString *c = NSStringFromClass([v class]);
                BOOL scroll = [v isKindOfClass:[UIScrollView class]], list = [c containsString:@"IconListView"] || [c containsString:@"RootFolderView"] || [c containsString:@"FolderView"];
                if ((scroll || list) && !v.hidden) {
                    n++;
                    CGRect inWin = [v convertRect:v.bounds toView:w];
                    NSString *extra = scroll ? [NSString stringWithFormat:@" offset %@ size %@ inset %@", NSStringFromCGPoint(((UIScrollView *)v).contentOffset), NSStringFromCGSize(((UIScrollView *)v).contentSize), NSStringFromUIEdgeInsets(((UIScrollView *)v).contentInset)] : @"";
                    DMLog([NSString stringWithFormat:@"[iconlayout] %@ %p frame %@ in window %@ alpha %.2f subviews %lu%@", c, v, NSStringFromCGRect(v.frame), NSStringFromCGRect(inWin), v.alpha, (unsigned long)v.subviews.count, extra]);
                    if ([c containsString:@"IconListView"] && v.subviews.count) {
                        NSMutableString *icons = [NSMutableString string];
                        for (UIView *iv in v.subviews) [icons appendFormat:@" (%.0f,%.0f %.0fx%.0f%@)", iv.frame.origin.x, iv.frame.origin.y, iv.frame.size.width, iv.frame.size.height, iv.hidden ? @" h" : @""];
                        DMLog([NSString stringWithFormat:@"[iconlayout]   icons (list transform %@):%@", NSStringFromCGAffineTransform(v.transform), icons]);
                    }
                    if ([c isEqualToString:@"SBIconListView"]) {   // the model's icon count and the rows / columns the list thinks are visible
                        NSUInteger count = 0; @try { count = [[v valueForKey:@"icons"] count]; } @catch (id e) {}
                        NSRange vr = {0, 0}, vc = {0, 0}; NSUInteger shown = 0;
                        if ([v respondsToSelector:NSSelectorFromString(@"visibleRowRange")]) vr = ((NSRange (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"visibleRowRange"));
                        if ([v respondsToSelector:NSSelectorFromString(@"visibleColumnRange")]) vc = ((NSRange (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"visibleColumnRange"));
                        if ([v respondsToSelector:NSSelectorFromString(@"numberOfDisplayedIconViews")]) shown = ((NSUInteger (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"numberOfDisplayedIconViews"));
                        DMLog([NSString stringWithFormat:@"[iconlayout]   model icons %lu, displayed icon views %lu, visible rows %@, visible columns %@", (unsigned long)count, (unsigned long)shown, NSStringFromRange(vr), NSStringFromRange(vc)]);
                    }
                }
                if (![c containsString:@"IconView"]) [queue addObjectsFromArray:v.subviews];
            }
        }
    }
    else if ([cmd isEqualToString:@"clocktree"]) { extern void DMClockTree(void); DMClockTree(); }
    else if ([cmd hasPrefix:@"wintree_"]) {   // wintree_<window class>: that window's view tree (transforms included)
        NSString *cls = [cmd substringFromIndex:8];
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:cls]) continue;
            DMLog([NSString stringWithFormat:@"[atree] ==== window %@ level %.1f frame %@ bounds %@ transform %@", cls, w.windowLevel, NSStringFromCGRect(w.frame), NSStringFromCGRect(w.bounds), NSStringFromCGAffineTransform(w.transform)]);
            DMDumpViewTree(w, 0);
        }
    }
    else if ([cmd hasPrefix:@"pilltf_"]) {   // pilltf_<scale>_<tx>_<ty>: transform of the hosted keyboard window (empirical placement of the pill)
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        if (q.count >= 3) for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBMedusaHostedKeyboardWindow"]) continue;
            CGFloat s = [q[0] doubleValue];
            w.transform = CGAffineTransformMake(s, 0, 0, s, [q[1] doubleValue], [q[2] doubleValue]);
            DMLog([NSString stringWithFormat:@"[pill] window transform %@ frame now %@", NSStringFromCGAffineTransform(w.transform), NSStringFromCGRect(w.frame)]);
        }
    }
    else if ([cmd hasPrefix:@"pillfx_"]) {   // pillfx_<w|c|h|off>: an obvious filter (invert) on the hosted keyboard's window / container / layer host, to see which level takes effect
        NSString *level = [cmd substringFromIndex:7];
        Class fc = objc_getClass("CAFilter");
        id inv = fc ? ((id (*)(id, SEL, id))objc_msgSend)((id)fc, NSSelectorFromString(@"filterWithType:"), @"colorInvert") : nil;
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBMedusaHostedKeyboardWindow"]) continue;
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            if ([level isEqualToString:@"w"]) w.layer.filters = @[inv];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                NSString *cn = NSStringFromClass([v class]);
                BOOL on = ![level isEqualToString:@"off"];
                if (([level isEqualToString:@"c"] && [cn isEqualToString:@"_UISceneLayerHostContainerView"]) || ([level isEqualToString:@"h"] && [cn isEqualToString:@"_UIContextLayerHostView"]) || [level isEqualToString:@"off"])
                    v.layer.filters = on ? @[inv] : nil;
                [stack addObjectsFromArray:v.subviews];
            }
            if ([level isEqualToString:@"off"]) w.layer.filters = nil;
            DMLog([NSString stringWithFormat:@"[pill] test filter %@ (inverter %@)", level, inv]);
        }
    }
    else if ([cmd hasPrefix:@"pillhide_"]) {   // pillhide_<0|1>: hide / show the hosted keyboard scene view (to see whether it draws the pill)
        BOOL hide = [[cmd substringFromIndex:9] boolValue];
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBMedusaHostedKeyboardWindow"]) continue;
            w.alpha = hide ? 0.0 : 1.0;
            DMLog([NSString stringWithFormat:@"[pill] medusa keyboard window alpha %.0f", w.alpha]);
        }
    }
    else if ([cmd isEqualToString:@"spotlight"]) {   // opens / closes Spotlight (its search field takes the keyboard)
        SpringBoard *sbApp = (SpringBoard *)[UIApplication sharedApplication];
        SEL s = NSSelectorFromString(@"_toggleSearch");
        if ([sbApp respondsToSelector:s]) ((void (*)(id, SEL))objc_msgSend)(sbApp, s);
    }
    else if ([cmd hasPrefix:@"cc_"]) {   // cc_1 / cc_0: Control Center down / up
        BOOL up = [[cmd substringFromIndex:3] boolValue];
        id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
        NSArray *names = up ? @[@"presentAnimated:", @"_presentAnimated:", @"presentAnimated:completion:"] : @[@"dismissAnimated:", @"_dismissAnimated:", @"dismissAnimated:completion:"];
        for (NSString *n in names) {
            SEL sel = NSSelectorFromString(n);
            if (![cc respondsToSelector:sel]) continue;
            DMLog([NSString stringWithFormat:@"[cc] %@ via %@", up ? @"presenting" : @"dismissing", n]);
            if ([n hasSuffix:@"completion:"]) ((void (*)(id, SEL, BOOL, id))objc_msgSend)(cc, sel, YES, nil); else ((void (*)(id, SEL, BOOL))objc_msgSend)(cc, sel, YES);
            break;
        }
    }
    else if ([cmd hasPrefix:@"ccscale_"]) {   // ccscale_<k>: set the Control Center panel scale live and re-apply (logs the sizes it finds)
        gCCScale = MIN(1.0, MAX(0.5, [[cmd substringFromIndex:8] doubleValue]));
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"]) continue;
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
                if ([NSStringFromClass([v class]) isEqualToString:@"SCContentView"]) {
                    DMScaleControlCenterPanel(v);
                    DMLog([NSString stringWithFormat:@"[ccscale] scale %.2f: container bounds %@ frame %@, content bounds %@", gCCScale, NSStringFromCGRect(v.superview.bounds), NSStringFromCGRect(v.superview.frame), NSStringFromCGRect(v.bounds)]);
                }
            }
        }
    }
    else if ([cmd hasPrefix:@"winhide_"]) {   // winhide_<window class>_<0|1>: hide (1) or show (0) every window of that class -- experiment, e.g. to see what is behind Aerial's layer
        NSString *rest = [cmd substringFromIndex:8];
        NSRange us = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (us.location == NSNotFound) return;
        NSString *cls = [rest substringToIndex:us.location]; BOOL hide = [[rest substringFromIndex:us.location + 1] boolValue];
        for (UIWindow *w in DMAllWindows()) if ([NSStringFromClass([w class]) isEqualToString:cls]) { w.hidden = hide; DMLog([NSString stringWithFormat:@"[winhide] %@ hidden %d", cls, hide]); }
    }
    else if ([cmd hasPrefix:@"wintf_"]) {   // wintf_<window class>_<a>_<b>_<c>_<d>: set that window's transform (rotation part) -- experiment
        NSArray *q = [[cmd substringFromIndex:6] componentsSeparatedByString:@"_"];
        if (q.count < 5) return;
        for (UIWindow *w in DMAllWindows()) if ([NSStringFromClass([w class]) isEqualToString:q[0]]) {
            w.transform = CGAffineTransformMake([q[1] doubleValue], [q[2] doubleValue], [q[3] doubleValue], [q[4] doubleValue], 0, 0);
            DMLog([NSString stringWithFormat:@"[wintf] %@ transform %@ frame %@ bounds %@", q[0], NSStringFromCGAffineTransform(w.transform), NSStringFromCGRect(w.frame), NSStringFromCGRect(w.bounds)]);
        }
    }
#if DEBUG
    else if ([cmd hasPrefix:@"scenecreate_"]) gSceneCreateLogs = [[cmd substringFromIndex:12] intValue];
#endif
    else if ([cmd hasPrefix:@"scenestack_"]) gSceneStackLogs = [[cmd substringFromIndex:11] intValue];
    else if ([cmd hasPrefix:@"swstack_"]) gSwitcherStackLogs = [[cmd substringFromIndex:8] intValue];   // swstack_<n>: log who creates the next n switcher transition events   // scenestack_<n>: log who sends the next n app-scene updates
    else if ([cmd hasPrefix:@"fit_"]) {   // fit_<0|1>: switch Fit to Window like its menu row (the 0.6 s watcher then spreads / tiles the windows)
        BOOL on = [[cmd substringFromIndex:4] boolValue];
        DMSetFitEnabled(on);
        DMLog([NSString stringWithFormat:@"[window] Fit to Window switched %@ (trigger)", on ? @"on" : @"off"]);
    }
    else if ([cmd hasPrefix:@"menurow_"]) {   // menurow_<title>: press the row with that title in the open menu (the real handler path)
        NSString *title = [[cmd substringFromIndex:8] stringByReplacingOccurrencesOfString:@"-" withString:@" "];
        NSMutableArray *stack = [NSMutableArray arrayWithObject:gOverlay ?: (UIView *)[UIView new]];
        BOOL found = NO;
        while (stack.count && !found) {
            UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
            if ([v isKindOfClass:[DMRow class]] && [((DMRow *)v).label.text isEqual:title] && ((DMRow *)v).handler) { ((DMRow *)v).handler(); found = YES; }
        }
        DMLog([NSString stringWithFormat:@"[menurow] %@: %@", title, found ? @"pressed" : @"not found"]);
    }
    else if ([cmd isEqualToString:@"aboutthis"]) {   // aboutthis: show the About This iPad panel
        UIView *h = DMMenuHost(); if (h) DMShowAbout(h);
    }
    else if ([cmd hasPrefix:@"sidechoice_"]) {   // sidechoice_<left|right>: press that half of the "which side?" prompt
        NSString *side = [cmd substringFromIndex:11];
        NSMutableArray<UIControl *> *panels = [NSMutableArray array];
        for (UIView *v in gOverlay.subviews) if ([v isKindOfClass:[UIControl class]]) [panels addObject:(UIControl *)v];
        UIControl *pick = panels.count >= 2 ? ([side isEqualToString:@"left"] ? panels[0] : ([side isEqualToString:@"right"] ? panels[1] : (panels.count >= 3 ? panels[2] : nil))) : nil;   // (sidechoice_nofit: the No Fit button)
        [pick sendActionsForControlEvents:UIControlEventTouchUpInside];
        DMLog([NSString stringWithFormat:@"[sidechoice] %@: %@", side, pick ? @"pressed" : @"no prompt"]);
    }
    else if ([cmd hasPrefix:@"a5burst_"]) {   // a5burst_<bundle>: open that app (the normal open path) and log, on EVERY display frame for 1 s, each new window's on-screen
        // state: presentation opacity and scale, whether our chrome is there and whether Aerial's own frosted material still shows -- the evidence for "Aerial's own look
        // shows first" (a frame with opacity > 0 and no chrome / Aerial's material is a frame of Aerial's look on screen).
        NSString *bundle = [cmd substringFromIndex:8];
        BOOL all = [bundle hasPrefix:@"all"];   // a5burst_all<seconds>: no app opened; every window watched (for turns, focus changes, minimize/restore)
        double secs = all && bundle.length > 3 ? [[bundle substringFromIndex:3] doubleValue] : 1.0;
        NSMutableSet *before = [NSMutableSet set]; if (!all) for (UIView *st in DMAerialStages()) [before addObject:[NSValue valueWithNonretainedObject:st]];
        CFTimeInterval t0 = CACurrentMediaTime();
        __block int n = 0, bad = 0;
        NSMutableArray<UIImage *> *pics = [NSMutableArray array];
        DMBlockLink *bl = [DMBlockLink new];
        bl.block = ^BOOL {
            CFTimeInterval t = CACurrentMediaTime() - t0;
            NSMutableString *info = [NSMutableString string];
            for (UIView *st in DMAerialStages()) {
                if ([before containsObject:[NSValue valueWithNonretainedObject:st]]) continue;
                if (!all && pics.count < 16 && n % 2 == 0) {   // every other frame: the window as drawn now (UIWindow's own coordinates: the whole Aerial window, 1/4 size)
                    UIWindow *aw = st.window;
                    UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 0.5;
                    CGSize sz = aw.bounds.size;
                    UIImage *img = [[[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(sz.width / 2, sz.height / 2) format:fmt] imageWithActions:^(UIGraphicsImageRendererContext *c) {
                        [[UIColor colorWithWhite:0.5 alpha:1] setFill]; UIRectFill(CGRectMake(0, 0, sz.width / 2, sz.height / 2));
                        [aw drawViewHierarchyInRect:CGRectMake(0, 0, sz.width / 2, sz.height / 2) afterScreenUpdates:NO]; }];
                    if (img) [pics addObject:img];
                }
                CALayer *pl = st.layer.presentationLayer;
                UIView *chrome = objc_getAssociatedObject(st, kA5ChromeKey);
                int effects = 0; for (UIView *v in st.subviews) if ([v isKindOfClass:[UIVisualEffectView class]] && !v.hidden) effects++;
                float op = pl ? pl.opacity : 0; for (UIView *v = st.superview; v && pl; v = v.superview) op *= v.layer.presentationLayer ? v.layer.presentationLayer.opacity : v.layer.opacity;
                UIView *hh = DMStageInnerView(st); CALayer *hpl = hh.layer.presentationLayer;
                BOOL aerialLook = op > 0.01 && !DMStageMinimized(st) && (!chrome || chrome.hidden || effects > 0 || (hpl && hpl.maskedCorners != 0 && hpl.cornerRadius > 0.5));
                if (aerialLook) bad++;
                {   // the app holder's corners (Aerial rounds it; our theme squares the top): radius / masked corners / our mask, and any rounded big view in it
                    UIView *in = DMStageInnerView(st);
                    [info appendFormat:@" holder r %.1f corners %lu mask %@ clips %d", in.layer.cornerRadius, (unsigned long)in.layer.maskedCorners, in.layer.mask ? @"yes" : @"no", in.layer.masksToBounds];
                    for (UIView *v in in.subviews) if (v.layer.cornerRadius > 0.5) [info appendFormat:@" sub %@ r %.1f corners %lu", NSStringFromClass([v class]), v.layer.cornerRadius, (unsigned long)v.layer.maskedCorners];
                    CALayer *ipl = in.layer.presentationLayer; if (ipl) [info appendFormat:@" (on screen r %.1f corners %lu)", ipl.cornerRadius, (unsigned long)ipl.maskedCorners];
                    NSMutableArray *q = [NSMutableArray arrayWithArray:st.subviews];
                    for (int k = 0; q.count && k < 40; k++) { UIView *v = q.firstObject; [q removeObjectAtIndex:0];
                        if (v.layer.cornerRadius > 0.5 && !v.hidden && v.bounds.size.width > 100) [info appendFormat:@" [%@ %@ r %.0f c %lu clip %d bg %@ id %@]", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.layer.cornerRadius, (unsigned long)v.layer.maskedCorners, v.clipsToBounds, v.backgroundColor ? @"y" : @"n", v.accessibilityIdentifier ?: @""];
                        if (v.subviews.count < 8) [q addObjectsFromArray:v.subviews]; }
                }
                [info appendFormat:@" | %@ opacity %.2f scale %.2f chrome %@ aerial-material %d%@", DMStageBundle(st), op, pl ? [[pl valueForKeyPath:@"transform.scale.x"] doubleValue] : -1,
                     chrome ? (chrome.hidden ? @"hidden" : @"yes") : @"NO", effects, aerialLook ? @"  <-- AERIAL'S LOOK ON SCREEN" : @""];
            }
            if (n < 70 && (!all || [info containsString:@"AERIAL'S LOOK"])) DMLog([NSString stringWithFormat:@"[a5burst] frame %d at %.3f s%@", n, t, info]);
            n++;
            if (t < secs) return YES;
            if (pics.count) {
                NSUInteger cols = 4, rows = (pics.count + cols - 1) / cols; CGSize cell = pics.firstObject.size;
                UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 1.0;
                UIImage *sheet = [[[UIGraphicsImageRenderer alloc] initWithSize:CGSizeMake(cell.width * cols, cell.height * rows) format:fmt] imageWithActions:^(UIGraphicsImageRendererContext *c) {
                    for (NSUInteger i = 0; i < pics.count; i++) [pics[i] drawAtPoint:CGPointMake((i % cols) * cell.width, (i / cols) * cell.height)]; }];
                [UIImagePNGRepresentation(sheet) writeToFile:@"/tmp/macstatusbar-burst.png" atomically:NO];
            }
            DMLog([NSString stringWithFormat:@"[a5burst] done: %d frames, %d with Aerial's own look on screen, %lu pictures", n, bad, (unsigned long)pics.count]);
            return NO;
        };
        [bl start];
        if (!all) DMOpenApp(bundle);
    }
    else if ([cmd isEqualToString:@"zgeo"]) {   // zgeo: every Zetsu window's geometry -- window, Zetsu's host and content (on screen), the flex frame we asked for, the scene's real settings
        for (UIWindow *w in DMZetsuWindows()) {
            NSString *b = DMZetsuWindowBundle(w);
            UIView *host = nil; @try { host = [DMZetsuController(w) valueForKey:@"hosts"]; } @catch (id e) {}
            UIView *content = [host isKindOfClass:[UIView class]] ? host.subviews.firstObject : nil;
            id<UICoordinateSpace> scr = w.screen.coordinateSpace;
            id sc = b.length ? DMSceneForBundle(b) : nil; id st = nil; @try { st = [sc valueForKey:@"settings"]; } @catch (id e) {}
            CGRect sf = [st respondsToSelector:NSSelectorFromString(@"frame")] ? ((CGRect (*)(id, SEL))objc_msgSend)(st, NSSelectorFromString(@"frame")) : CGRectNull;
            long so = [st respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(st, NSSelectorFromString(@"interfaceOrientation")) : -1;
            NSMutableString *layers = [NSMutableString string];
            NSMutableArray *q = [NSMutableArray arrayWithObject:content.layer ?: [CALayer layer]];
            for (int n = 0; q.count && n < 12; n++) { CALayer *l = q.firstObject; [q removeObjectAtIndex:0]; [layers appendFormat:@" %@%@ pos %@ mask %d delegate %@;", NSStringFromClass([l class]), NSStringFromCGRect(l.bounds), NSStringFromCGPoint(l.position), l.masksToBounds, NSStringFromClass([l.delegate class])]; [q addObjectsFromArray:l.sublayers ?: @[]]; }
            for (UIView *v = content.superview; v && v != w; v = v.superview) [layers appendFormat:@" <- %@ %@ clips %d", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.clipsToBounds];
            {   // what takes a touch at each grip (the view hit-tested there), and the order of the window's top-level views
                for (int side = 0; side < 2; side++) {
                    UIView *box = objc_getAssociatedObject(w, side == 0 ? kZetsuGripLKey : kZetsuGripRKey);
                    if (!box.superview) { [layers appendFormat:@" | grip %d: none", side]; continue; }
                    CGPoint c = [box convertPoint:CGPointMake(16, 16) toView:w];
                    UIView *hit = [w hitTest:c withEvent:nil];
                    [layers appendFormat:@" | grip %d at %@ (in %@, hidden %d alpha %.2f) -> hit %@", side, NSStringFromCGRect([box convertRect:box.bounds toView:w]), NSStringFromClass([box.superview class]), box.hidden, box.alpha, hit == box ? @"GRIP" : NSStringFromClass([hit class])];
                }
                UIView *root = objc_getAssociatedObject(w, kZetsuGripRKey) ? ((UIView *)objc_getAssociatedObject(w, kZetsuGripRKey)).superview : nil;
                for (UIView *v in root.subviews) [layers appendFormat:@" / %@%@%@", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.hidden ? @"(hidden)" : @""];
            }
            DMLog([NSString stringWithFormat:@"[zgeo] %@ window %@ | host on screen %@ bounds %@ | content bounds %@ t %@ center %@ class %@ | flex %@ | scene frame %@ orientation %ld | layers%@",
                   b, NSStringFromCGRect(w.frame), NSStringFromCGRect([host convertRect:host.bounds toCoordinateSpace:scr]), NSStringFromCGSize(host.bounds.size),
                   NSStringFromCGSize(content.bounds.size), NSStringFromCGAffineTransform(content.transform), NSStringFromCGPoint(content.center), NSStringFromClass([content class]),
                   gZetsuFlexFrames[b] ? NSStringFromCGRect(gZetsuFlexFrames[b].CGRectValue) : @"-", NSStringFromCGRect(sf), so, layers]);
        }
    }
    else if ([cmd hasPrefix:@"viewinfo_"]) {   // viewinfo_<Class>: the first such view anywhere, its subviews (2 levels) and superviews, with their look (debug)
        Class c = NSClassFromString([cmd substringFromIndex:9]);
        UIView *found = nil;
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *st = [NSMutableArray arrayWithObject:w];
            while (st.count && !found) { UIView *v = st.lastObject; [st removeLastObject]; if (c && [v isKindOfClass:c]) found = v; else [st addObjectsFromArray:v.subviews]; }
            if (found) break;
        }
        NSString *(^desc)(UIView *) = ^NSString *(UIView *v) {
            NSString *fx = [v isKindOfClass:[UIVisualEffectView class]] ? [((UIVisualEffectView *)v).effect description] : @"";
            return [NSString stringWithFormat:@"%@ %@ bg %@ a %.2f r %.1f clip %d shadow %.2f/%.0f %@", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), v.backgroundColor ?: @"-", v.alpha, v.layer.cornerRadius, v.clipsToBounds, v.layer.shadowOpacity, v.layer.shadowRadius, fx];
        };
        NSMutableString *o = [NSMutableString stringWithFormat:@"[viewinfo] %@", found ? desc(found) : @"none"];
        for (UIView *u = found.superview; u && o.length < 3000; u = u.superview) [o appendFormat:@"\n  up: %@", desc(u)];
        for (UIView *u in found.subviews) { [o appendFormat:@"\n  down: %@", desc(u)]; for (UIView *u2 in u.subviews) [o appendFormat:@"\n    down: %@", desc(u2)]; }
        DMLog(o);
    }
    else if ([cmd hasPrefix:@"kbled_"]) {   // kbled_<0|1>: the Caps Lock light of external keyboards (a harmless output report: keeps a Bluetooth keyboard's link awake; debug)
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        HIDClientRef2 (*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
        void (*match)(HIDClientRef2, CFDictionaryRef) = dlsym(iokit, "IOHIDEventSystemClientSetMatching");
        CFArrayRef (*copyServices)(HIDClientRef2) = dlsym(iokit, "IOHIDEventSystemClientCopyServices");
        CFTypeRef (*copyProp)(void *, CFStringRef) = dlsym(iokit, "IOHIDServiceClientCopyProperty");
        Boolean (*setProp)(void *, CFStringRef, CFTypeRef) = dlsym(iokit, "IOHIDServiceClientSetProperty");
        // (a fresh client every time: a kept one never saw a keyboard that connected after it was made, so the blink reached nothing)
        HIDClientRef2 c = create ? create(kCFAllocatorDefault) : NULL; if (c && match) match(c, (__bridge CFDictionaryRef)@{@"PrimaryUsagePage": @1, @"PrimaryUsage": @6});
        CFArrayRef list = (c && copyServices) ? copyServices(c) : NULL;
        BOOL on = [[cmd substringFromIndex:6] intValue] == 1;
        NSMutableString *o = [NSMutableString stringWithFormat:@"[kbled] %@:", on ? @"on" : @"off"];
        for (CFIndex i = 0; list && i < CFArrayGetCount(list); i++) {
            void *svc = (void *)CFArrayGetValueAtIndex(list, i);
            NSString *transport = CFBridgingRelease(copyProp(svc, CFSTR("Transport")));
            if (![transport containsString:@"Bluetooth"]) continue;
            Boolean ok = setProp ? setProp(svc, CFSTR("HIDCapsLockLED"), on ? kCFBooleanTrue : kCFBooleanFalse) : false;
            [o appendFormat:@" %@ -> %d", CFBridgingRelease(copyProp(svc, CFSTR("Product"))), ok];
        }
        [o appendFormat:@" (%ld keyboard services)", list ? (long)CFArrayGetCount(list) : -1L];
        if (list) CFRelease(list);
        if (c) CFRelease(c);
        DMLog(o);
    }
    else if ([cmd hasPrefix:@"scenefg_"]) {   // scenefg_<bundle>: that app's scenes we know and whether each is in the foreground (debug)
        NSString *b = [cmd substringFromIndex:8];
        NSMutableString *o = [NSMutableString stringWithFormat:@"[scenefg] %@:", b];
        for (NSString *sid in [gSceneByID allKeys]) {
            if (![sid containsString:b]) continue;
            id sc = gSceneByID[sid].scene; id st = nil; @try { st = [sc valueForKey:@"settings"]; } @catch (id e) {}
            [o appendFormat:@" %@ alive %d foreground %d;", sid, sc != nil, st ? DMSettingsForeground(st) : -1];
        }
        DMLog(o);
    }
    else if ([cmd isEqualToString:@"sbmem"]) DMLog([NSString stringWithFormat:@"[sbmem] SpringBoard footprint %.1f MB", DMFootprintBytes(getpid()) / 1048576.0]);   // sbmem: SpringBoard's memory now
    else if ([cmd isEqualToString:@"menutitles"]) {   // menutitles: every menu title on the screen, as "name x y" centres in screen points (for finger-tap stress tests)
        NSMutableString *o = [NSMutableString stringWithString:@"[menutitles]"];
        const void *keys[] = { kButtonKey, kAppButtonKey, kFileButtonKey, kEditButtonKey, kViewButtonKey, kGoButtonKey, kWinButtonKey, kAudioButtonKey, kSSHButtonKey, kVPNButtonKey, kWiFiButtonKey, kClockButtonKey };
        // (one name per key, in the same order: the list once had 9 names for 11 keys and read past its end -- an exception in SpringBoard)
        static const char *names[] = { "apple", "app", "file", "edit", "view", "go", "window", "audio", "ssh", "vpn", "wifi", "clock" };
        _Static_assert(sizeof(names) / sizeof(names[0]) == sizeof(keys) / sizeof(keys[0]), "menutitles: one name per key");
        for (UIView *fg in gCopies.allObjects) {
            if (!fg.window || fg.window.hidden || fg.hidden || DMEffectiveAlpha(fg) < 0.5) continue;
            for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
                UIButton *b = objc_getAssociatedObject(fg, keys[i]);
                if (!b || b.hidden || b.frame.size.width < 1.0) continue;
                CGRect r = DMTitleRectOnScreen(fg, b.frame);
                [o appendFormat:@" %s=%.0f,%.0f", names[i], CGRectGetMidX(r), CGRectGetMidY(r)];
            }
            break;
        }
        DMLog(o);
    }
    else if ([cmd isEqualToString:@"menucheck"]) {   // menucheck: regression check -- opens every status bar menu from every visible status bar copy, one after another
        // (0.5 s apart), and [menugeo] asserts each menu hangs directly under its title on the screen; ends with a PASS/FAIL count and the menu closed.
        NSMutableArray *jobs = [NSMutableArray array];
        const void *keys[] = { kButtonKey, kAppButtonKey, kFileButtonKey, kEditButtonKey, kViewButtonKey, kGoButtonKey, kWinButtonKey, kAudioButtonKey, kSSHButtonKey, kVPNButtonKey, kWiFiButtonKey };
        for (UIView *fg in gCopies.allObjects) {
            if (!fg.window || fg.window.hidden || fg.hidden || fg.alpha < 0.01) continue;
            for (unsigned i = 0; i < sizeof(keys) / sizeof(keys[0]); i++) {
                UIButton *b = objc_getAssociatedObject(fg, keys[i]);
                if (b && !b.hidden && b.frame.size.width > 1.0) [jobs addObject:b];
            }
        }
        gMenuCheckPass = gMenuCheckFail = 0;
        DMLog([NSString stringWithFormat:@"[menucheck] %lu menus to open", (unsigned long)jobs.count]);
        for (NSUInteger j = 0; j <= jobs.count; j++) {
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * j * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                DMRemoveOverlayNow();
                if (j == jobs.count) { DMLog([NSString stringWithFormat:@"[menucheck] done: %d PASS, %d FAIL", gMenuCheckPass, gMenuCheckFail]); return; }
                UIButton *b = jobs[j]; UIView *fg = b.superview;
                if (!fg) return;
                if (b == objc_getAssociatedObject(fg, kSSHButtonKey)) DMOpenSSHMenu(b);
                else if (b == objc_getAssociatedObject(fg, kVPNButtonKey)) DMOpenVPNMenu(b);
                else if (b == objc_getAssociatedObject(fg, kWiFiButtonKey)) DMOpenWiFiMenu(b);
                else DMOpenMenuForButton(b);
            });
        }
    }
#if DEBUG
    else if ([cmd hasPrefix:@"wifi"] && DMWiFiTrigger(cmd)) {}   // the Wi-Fi menu's tests (WiFiMenu.h)
#endif
    else if ([cmd isEqualToString:@"sshmenu"]) {   // sshmenu: open the menu of the SSH icon in the status bar
        for (UIView *fg in gCopies.allObjects) {
            UIButton *b = objc_getAssociatedObject(fg, kSSHButtonKey);
            if (b && fg.window && !fg.window.hidden) { DMOpenSSHMenu(b); break; }
        }
    }
    else if ([cmd hasPrefix:@"brightness_"]) {   // brightness_<0...1>: the screen brightness
        BOOL restore = [[cmd substringFromIndex:11] isEqualToString:@"restore"];   // brightness_restore: auto-brightness back on, a normal level
        double level = restore ? 0.66 : [[cmd substringFromIndex:11] doubleValue];
        void *bks = dlopen("/System/Library/PrivateFrameworks/BackBoardServices.framework/BackBoardServices", RTLD_LAZY);
        void (*setBrightness)(float, int) = bks ? dlsym(bks, "BKSDisplayBrightnessSet") : NULL;
        void (*setAuto)(int) = bks ? dlsym(bks, "BKSDisplayBrightnessSetAutoBrightnessEnabled") : NULL;
        if (setAuto && ([[NSFileManager defaultManager] fileExistsAtPath:@"/tmp/msb-brightness-autooff"] || restore)) setAuto(restore ? 1 : 0);   // (auto-brightness is left as the user has it, unless asked)
        if (setBrightness) setBrightness((float)level, 1);
        else [UIScreen mainScreen].brightness = level;
        DMLog([NSString stringWithFormat:@"[brightness] set to %.2f via %@ (now %.2f)", level, setBrightness ? @"BackBoardServices" : @"UIScreen", [UIScreen mainScreen].brightness]);
    }
    else if ([cmd hasPrefix:@"autobright_"]) {   // autobright_<0|1>: auto-brightness off / on (debug; to put back what the user had)
        void *bks = dlopen("/System/Library/PrivateFrameworks/BackBoardServices.framework/BackBoardServices", RTLD_LAZY);
        void (*setAuto)(int) = bks ? dlsym(bks, "BKSDisplayBrightnessSetAutoBrightnessEnabled") : NULL;
        int on = [[cmd substringFromIndex:11] intValue] == 1;
        if (setAuto) setAuto(on);
        DMLog([NSString stringWithFormat:@"[brightness] auto-brightness %@ (%d)", on ? @"on" : @"off", setAuto != NULL]);
    }
    else if ([cmd isEqualToString:@"savewindows"]) { DMSaveWindowState(); DMLog(@"[restore] state saved"); }
    else if ([cmd hasPrefix:@"unlockpass_"]) {   // unlockpass_<code>: unlock with the passcode (the owner gave it for testing on the second iPad)
        NSString *code = [cmd substringFromIndex:11];
        id mgr = DMSBManager("SBLockScreenManager");
        for (NSString *n in @[@"attemptUnlockWithPasscode:finishUIUnlock:", @"_attemptUnlockWithPasscode:finishUIUnlock:"]) {
            SEL sel = NSSelectorFromString(n);
            if (![mgr respondsToSelector:sel]) continue;
            BOOL ok = ((BOOL (*)(id, SEL, id, BOOL))objc_msgSend)(mgr, sel, code, YES);
            DMLog([NSString stringWithFormat:@"[unlock] %@ -> %d", n, ok]);
            break;
        }
    }
    else if ([cmd hasPrefix:@"devorient_"]) {   // devorient_<0..6>: fake the PHYSICAL device orientation in backboardd (the XCUITest rotation path) -- works with the iPad lying flat; 0 = back to the real sensor
        long o = [[cmd substringFromIndex:10] integerValue];
        void (*setAuto)(long) = (void (*)(long))dlsym(RTLD_DEFAULT, "BKSHIDServicesSetDeviceOrientationForAutomation");
        long (*getCur)(void) = (long (*)(void))dlsym(RTLD_DEFAULT, "BKSHIDGetCurrentDeviceOrientation");
        DMLog([NSString stringWithFormat:@"[devorient] set %ld: function %p, backboardd device orientation before %ld, UIDevice %ld", o, setAuto, getCur ? getCur() : -1, (long)[UIDevice currentDevice].orientation]);
        if (setAuto) setAuto(o);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            DMLog([NSString stringWithFormat:@"[devorient] after: backboardd %ld, UIDevice %ld, screen %@, statusBarOrientation %ld, aerial window %@", getCur ? getCur() : -1, (long)[UIDevice currentDevice].orientation,
                   NSStringFromCGSize([UIScreen mainScreen].bounds.size), ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation")), NSStringFromCGRect(DMAerialWindow().frame)]);
        });
    }
    else if ([cmd hasPrefix:@"sbrot_"]) {   // sbrot_reset: -[SpringBoard _resetForceRotate]. sbrot_<n> (_forceRotateToOrientation:withCompletion:) is DISABLED: it asserts
        // "Failed to force orientation" when a turn takes over 1 s, which crashed SpringBoard twice on the iPad 2 (iOS 16). Use rot_<n> instead.
        id app = [UIApplication sharedApplication];
        if ([[cmd substringFromIndex:6] isEqualToString:@"reset"]) {
            SEL s = NSSelectorFromString(@"_resetForceRotate");
            if ([app respondsToSelector:s]) ((void (*)(id, SEL))objc_msgSend)(app, s);
            DMLog([NSString stringWithFormat:@"[sbrot] reset (responds %d)", [app respondsToSelector:s]]);
        } else DMLog(@"[sbrot] disabled (it can crash SpringBoard): use rot_<1..4> / rot_off");
    }
    else if ([cmd hasPrefix:@"rot_"]) {   // rot_<1..4>: turn the screen with the user's rotation lock (unlock, 0.5 s, lock:o) -- works lying flat; rot_off: the user's own lock state back
        // (lock: while already locked, or in the same run-loop turn as unlock, does not turn anything). The user's lock state before the first rot_ is kept in
        // /tmp/msb-rot-userlock ("<locked> <orientation>") until rot_off.
        id mgr = DMCall(objc_getClass("SBOrientationLockManager"), @"sharedInstance");
        SEL lockSel = NSSelectorFromString(@"lock:"), unlockSel = NSSelectorFromString(@"unlock"), isLockedSel = NSSelectorFromString(@"isUserLocked"), userOSel = NSSelectorFromString(@"userLockOrientation");
        if (![mgr respondsToSelector:lockSel] || ![mgr respondsToSelector:unlockSel] || ![mgr respondsToSelector:isLockedSel]) { DMLog(@"[rot] no lock:/unlock on this build"); return; }
        NSString *arg = [cmd substringFromIndex:4];
        NSString *stateFile = @"/tmp/msb-rot-userlock";
        BOOL locked = ((BOOL (*)(id, SEL))objc_msgSend)(mgr, isLockedSel);
        long long userO = [mgr respondsToSelector:userOSel] ? ((long long (*)(id, SEL))objc_msgSend)(mgr, userOSel) : 0;
        if ([arg isEqualToString:@"off"]) {
            NSArray *saved = [[NSString stringWithContentsOfFile:stateFile encoding:NSUTF8StringEncoding error:nil] componentsSeparatedByString:@" "];
            BOOL wasLocked = saved.count == 2 && [saved[0] intValue] == 1; long long wasO = saved.count == 2 ? [saved[1] longLongValue] : 0;
            if (locked) ((void (*)(id, SEL))objc_msgSend)(mgr, unlockSel);
            if (wasLocked && wasO >= 1 && wasO <= 4)
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ ((void (*)(id, SEL, long long))objc_msgSend)(mgr, lockSel, wasO); });
            unlink(stateFile.UTF8String);
            DMLog([NSString stringWithFormat:@"[rot] off: the user's rotation lock back to %@", wasLocked ? [NSString stringWithFormat:@"locked (%lld)", wasO] : @"unlocked"]);
            // (Keyboard Phase: checked again 1.5 s later and put right if anything -- a late lock: from a turn asked just before -- changed it back)
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                BOOL nowLocked = ((BOOL (*)(id, SEL))objc_msgSend)(mgr, isLockedSel);
                if (nowLocked != wasLocked) {
                    if (wasLocked && wasO >= 1 && wasO <= 4) ((void (*)(id, SEL, long long))objc_msgSend)(mgr, lockSel, wasO); else ((void (*)(id, SEL))objc_msgSend)(mgr, unlockSel);
                    DMLog([NSString stringWithFormat:@"[rot] off: the lock was %@ again 1.5 s later: put back", nowLocked ? @"on" : @"off"]);
                } else DMLog([NSString stringWithFormat:@"[rot] off: verified, the user's lock is %@", nowLocked ? @"on" : @"off"]);
            });
            return;
        }
        long long o = [arg longLongValue];
        if (o < 1 || o > 4) return;
        if (access(stateFile.UTF8String, F_OK) != 0) [[NSString stringWithFormat:@"%d %lld", locked, userO] writeToFile:stateFile atomically:YES encoding:NSUTF8StringEncoding error:nil];
        if (locked) ((void (*)(id, SEL))objc_msgSend)(mgr, unlockSel);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            ((void (*)(id, SEL, long long))objc_msgSend)(mgr, lockSel, o);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                DMLog([NSString stringWithFormat:@"[rot] %lld: screen %@ statusBarOrientation %ld", o, NSStringFromCGSize([UIScreen mainScreen].bounds.size), ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"))]);
            });
        });
        DMLog([NSString stringWithFormat:@"[rot] %lld asked (was locked %d)", o, locked]);
        // Safety net (a test once left the iPad 2 locked in the wrong turn for the owner): 10 minutes after the last rot_ with no rot_off, the user's own
        // rotation lock state comes back by itself.
        static int rotGeneration = 0; int gen = ++rotGeneration;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(600 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (gen != rotGeneration || access(stateFile.UTF8String, F_OK) != 0) return;
            DMLog(@"[rot] 10 minutes after the last turn with no rot_off: the user's rotation lock back");
            DMRunTrigger(@"rot_off");
        });
    }
    else if ([cmd hasPrefix:@"uidevorient_"] || [cmd hasPrefix:@"sbdevorient_"]) {   // uidevorient_<n>: -[UIDevice setOrientation:animated:] (posts the device-orientation notification a real turn posts); sbdevorient_<n>: -[SpringBoard _setDeviceOrientation:animated:logMessage:]
        BOOL sb = [cmd hasPrefix:@"sbdevorient_"];
        long o = [[cmd substringFromIndex:sb ? 12 : 12] integerValue];
        long before = (long)[UIDevice currentDevice].orientation;
        if (sb) {
            SEL sel = NSSelectorFromString(@"_setDeviceOrientation:animated:logMessage:");
            id app = [UIApplication sharedApplication];
            if ([app respondsToSelector:sel]) ((void (*)(id, SEL, long, BOOL, id))objc_msgSend)(app, sel, o, YES, @"macstatusbar-test");
            DMLog([NSString stringWithFormat:@"[devorient] SpringBoard _setDeviceOrientation %ld (responds %d), UIDevice before %ld", o, [app respondsToSelector:sel], before]);
        } else {
            SEL sel = NSSelectorFromString(@"setOrientation:animated:");
