static BOOL DMLockUp(id mgr) { SEL sel = NSSelectorFromString(@"isUILocked"); return [mgr respondsToSelector:sel] && ((BOOL (*)(id, SEL))objc_msgSend)(mgr, sel); }
// mode 1: unlockUIFromSource:, 2: an unlock request through the manager, 3: startUIUnlockFromSource:, 4: request with force-alert off and no biometrics
// Every private selector is checked first; one missing (another iPadOS build) and nothing is called: the Lock Screen simply stays.
static BOOL DMTryUnlock(id mgr, int mode, int n) {
    if (mode == 1 || mode == 3) {
        SEL sel = NSSelectorFromString(mode == 1 ? @"unlockUIFromSource:withOptions:" : @"startUIUnlockFromSource:withOptions:");
        if (![mgr respondsToSelector:sel]) return NO;
        ((void (*)(id, SEL, int, id))objc_msgSend)(mgr, sel, n, nil);
        return YES;
    }
    Class rc = NSClassFromString(@"SBLockScreenUnlockRequest");
    SEL unlock = NSSelectorFromString(@"_unlockWithRequest:cancelPendingRequests:completion:");
    if (!rc || ![mgr respondsToSelector:unlock]) return NO;
    for (NSString *setter in @[@"setSource:", @"setIntent:", @"setName:", @"setWantsBiometricPresentation:", @"setForceAlertAuthenticationUI:"])
        if (![rc instancesRespondToSelector:NSSelectorFromString(setter)]) { DMLog([NSString stringWithFormat:@"[lock] SBLockScreenUnlockRequest has no -%@ here: the Lock Screen stays", setter]); return NO; }
    id req = [[rc alloc] init];
    if (!req) return NO;
    ((void (*)(id, SEL, long))objc_msgSend)(req, NSSelectorFromString(@"setSource:"), n);
    ((void (*)(id, SEL, long))objc_msgSend)(req, NSSelectorFromString(@"setIntent:"), mode == 4 ? 0 : 1);
    ((void (*)(id, SEL, id))objc_msgSend)(req, NSSelectorFromString(@"setName:"), @"MacStatusBar");
    ((void (*)(id, SEL, BOOL))objc_msgSend)(req, NSSelectorFromString(@"setWantsBiometricPresentation:"), NO);
    ((void (*)(id, SEL, BOOL))objc_msgSend)(req, NSSelectorFromString(@"setForceAlertAuthenticationUI:"), NO);
