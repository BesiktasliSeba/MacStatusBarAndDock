        id vc = DMCall(objc_getClass("SBMainSwitcherViewController"), @"sharedInstance");
        SEL sel = NSSelectorFromString(@"toggleMainSwitcherNoninteractivelyWithSource:animated:");
        DMLog([NSString stringWithFormat:@"[debug] switcher %lld: %@ responds %d", src, vc, [vc respondsToSelector:sel]]);
        if ([vc respondsToSelector:sel]) ((void (*)(id, SEL, long long, BOOL))objc_msgSend)(vc, sel, src, YES);
        else {   // iPadOS 16: the coordinator, per window scene
            id co = DMCall(objc_getClass("SBMainSwitcherControllerCoordinator"), @"sharedInstance");
            SEL sel16 = NSSelectorFromString(@"toggleMainSwitcherNoninteractivelyWithSource:animated:windowScene:");
            id scene = DMStatusBarWindow().windowScene;
            BOOL ok = [co respondsToSelector:sel16] && scene ? ((BOOL (*)(id, SEL, long long, BOOL, id))objc_msgSend)(co, sel16, src, YES, scene) : NO;
            DMLog([NSString stringWithFormat:@"[debug] switcher (iOS 16 coordinator %@, scene %@): %d", co, scene, ok]);
        }
    }
    else if ([cmd hasPrefix:@"fq_"]) {   // fq_<bundle id>: force quit an app the way the menu / a card swipe does
