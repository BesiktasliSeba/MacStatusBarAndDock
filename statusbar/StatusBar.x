static void DMSnapInvalidate(void);
static void DMSnapBegin(void);
static void DMSnapEnd(void);
// ---- battery: one screen-on/off gate for SpringBoard's periodic work ----
// With the screen off nothing of ours needs to watch anything: every repeating timer registered here (DMGateTimer) stops (its next fire date is put
// far away), the 0.25 s DMTick chain parks itself and the Aerial 5.0 per-frame watch pauses; all of it starts again the moment the screen comes on.
// The signal is SpringBoard's own "com.apple.springboard.hasBlankedScreen" (state 1 = blank).
static BOOL gDMScreenOff = NO, gDMTickParked = NO;
static NSHashTable<NSTimer *> *gDMGatedTimers = nil;
static void DMGateTimer(NSTimer *t) {
    if (!t) return;
    if (!gDMGatedTimers) gDMGatedTimers = [NSHashTable weakObjectsHashTable];
    [gDMGatedTimers addObject:t];
    if (gDMScreenOff) t.fireDate = [NSDate distantFuture];
}
static void DMAutoHideRefreshTimerIfStarted(void);
static void DMScreenPowerResume(void);
static void DMPruneSceneNotes(void);
static void DMTriggerPollWhileOff(void);
static void DMAerial5StartFrameWatcher(void);
static void DMWelcomeDismissForLock(void);
static void DMCloseOverlaysForScreenOff(void);   // (defined with DMCloseOverlay)
static void DMScreenPowerChanged(BOOL off) {
    if (off == gDMScreenOff) return;
    gDMScreenOff = off;
    if (off) DMWelcomeDismissForLock();   // (the welcome alert never waits on the Lock Screen)
    if (off) DMCloseOverlaysForScreenOff();   // (menus and panels too: a quick Face ID unlock showed the old menu for a moment, layering audit F11)
    for (NSTimer *t in gDMGatedTimers.allObjects) if (t.valid) t.fireDate = off ? [NSDate distantFuture] : [NSDate dateWithTimeIntervalSinceNow:0.05];
    if (!off) DMScreenPowerResume();
}
static void DMScreenPowerWatch(void) {
    static int token = 0; if (token) return;
    notify_register_dispatch("com.apple.springboard.hasBlankedScreen", &token, dispatch_get_main_queue(), ^(int t) {
        uint64_t st = 0; notify_get_state(t, &st);
        DMScreenPowerChanged(st != 0);
    });
    uint64_t st = 0; notify_get_state(token, &st); gDMScreenOff = st != 0;
}
// ---- Use Stock Status Bar (Settings > Status Bar; off by default): the whole run is one mode, decided in %ctor (a change needs a respring). ----
// On: none of our status bar, menus, windowing, engine integration or audio mixing runs (StockBar.h starts only what stays); the gates below are the
// few places shared code must also know it.
static BOOL gStockBar = NO;      // this SpringBoard runs with the stock status bar
static BOOL gStockStored = NO;   // the switch as stored now (a full run sees it turned on before its respring)
static BOOL DMStockBarPending(void) { return !gStockBar && gStockStored; }
static BOOL DMStockBarSwitch(void) {   // (missing = off: new installs and updaters keep the Mac status bar, no freeze needed)
    CFPreferencesAppSynchronize(MSB_DOMAIN);
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("stockStatusBar"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    BOOL on = v && CFGetTypeID(v) == CFBooleanGetTypeID() && CFBooleanGetValue(v);
    if (v) CFRelease(v);
    return on;
}
static void DMStockPendingChanged(void);
static void DMAutoHideDebugInfo(void);
static BOOL DMAutoHideLayout(void);
static BOOL DMAutoHideTopEdgeTouch(UITouch *touch) {   // a finger at the very top edge while windows may reach it (auto-hiding status bar)
    if (!touch.window || touch.type != UITouchTypeDirect || !DMAutoHideLayout()) return NO;
    CGPoint p = [touch.window convertPoint:[touch locationInView:touch.window] toCoordinateSpace:touch.window.screen.coordinateSpace];
    return p.y < 12.0;
}
static CGPoint gSBFakePointer;   // (auto-hiding status bar, debug stand-in pointer; defined there)
static BOOL gKbBarOnly = NO;   // a hardware keyboard is attached and only the app's input bar is in the keyboard picture (set by DMPlaceKeyboardPill)
static long gLastConfidentLandscapeOrientation;
static id DMCall(id obj, NSString *name) {
    SEL sel = NSSelectorFromString(name);
    if (!obj || ![obj respondsToSelector:sel]) return nil;
    return ((id (*)(id, SEL))objc_msgSend)(obj, sel);
}
// SpringBoard's managers (lock screen, backlight, Cover Sheet). iPadOS 17+: asked the way SpringBoard itself asks, +sharedInstanceIfExists -- the first
// +sharedInstance creates the manager and crashes on purpose when that is too early, and its -init can run our hooks again inside that same run-once
// block (issue #1: iPad 7, 18.2.1, the Mac status bar crashed at every respring). nil = not made yet. 15/16: +sharedInstance, as before.
static id DMSBManager(const char *cls) {
    Class c = objc_getClass(cls);
    if (!c) return nil;
    static int newOS = -1; if (newOS < 0) newOS = [NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 17;
    if (newOS) { SEL e = NSSelectorFromString(@"sharedInstanceIfExists"); if ([c respondsToSelector:e]) return ((id (*)(id, SEL))objc_msgSend)((id)c, e); }
    return DMCall(c, @"sharedInstance");
}
static NSString *DMBoolStr(id obj, NSString *name) {
    SEL sel = NSSelectorFromString(name);
    if (!obj || ![obj respondsToSelector:sel]) return @"n/a";
    return ((BOOL (*)(id, SEL))objc_msgSend)(obj, sel) ? @"Y" : @"N";
}

// Is Control Center on screen at all (presenting, open, or animating away)?
// Bug (reported): Control Center came down and went away by itself right after resprings, on both iPads. The [ccshow] log caught the cause on the M1:
// this check, called from the status bar's setAlpha: hook during startup, asked for +[SBControlCenterController sharedInstance] before SpringBoard had
// created Control Center, which made SpringBoard create it on the spot -- and creating it shows its window for a moment. Now the controller is only
// asked once SpringBoard has made the Control Center window on its own (our SBControlCenterWindow hook sets gCCWindowSeen); before that the answer is
// simply "not active".
static BOOL gCCWindowSeen = NO;
static BOOL DMControlCenterActive(void) {
    if (!gCCWindowSeen) return NO;
    id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
    return [DMBoolStr(cc, @"isPresented") isEqualToString:@"Y"] || [DMBoolStr(cc, @"isVisible") isEqualToString:@"Y"];
}

// The date as the status bar writes it ("Sat Sep 19"), in the user's locale.
static NSString *DMDateString(void) {
    static NSDateFormatter *formatter = nil;
    static NSString *format = nil;
    static NSString *want = nil; static unsigned wantGen = 0;   // (the format from the template: worked out again only when the region / language changes)
    if (!want || wantGen != gDMLocaleGen) {
        wantGen = gDMLocaleGen;
        want = [[NSDateFormatter dateFormatFromTemplate:@"EEEMMMd" options:0 locale:[NSLocale autoupdatingCurrentLocale]] stringByReplacingOccurrencesOfString:@"," withString:@""];
    }
    if (!formatter || ![want isEqualToString:format]) {
        formatter = [NSDateFormatter new];
        formatter.locale = [NSLocale autoupdatingCurrentLocale];
        formatter.dateFormat = want;
        format = want;
    }
    return [formatter stringFromDate:[NSDate date]];
}

// ---- passive watcher (only while /tmp/macstatusbar-watch exists): who hides or fades the status bar? ----
static BOOL DMWatching(void) {
    static time_t lastCheck = 0;
    static BOOL on = NO;
    time_t now = time(NULL);
    if (now != lastCheck) { lastCheck = now; on = DMTestFlag("/tmp/macstatusbar-watch"); }
    return on;
}

static void DMWatchLog(NSString *what, id view, double value) {
    static int budget = 600;
    if (budget <= 0 || !DMWatching()) return;
    budget--;
    NSArray *syms = [NSThread callStackSymbols];
    NSMutableArray *images = [NSMutableArray array];
    for (NSUInteger i = 2; i < syms.count && images.count < 7; i++) {
        NSMutableArray *parts = [NSMutableArray array];
        for (NSString *p in [syms[i] componentsSeparatedByString:@" "]) if (p.length) [parts addObject:p];
        if (parts.count >= 2) [images addObject:parts[1]];   // the image (SpringBoard, BigSurCenter.dylib, ...)
    }
    id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
    DMLog([NSString stringWithFormat:@"[watch] %@ %p -> %.2f  cc(P=%@ V=%@)  via %@", what, view, value,
           DMBoolStr(cc, @"isPresented"), DMBoolStr(cc, @"isVisible"), [images componentsJoinedByString:@" < "]]);
}


