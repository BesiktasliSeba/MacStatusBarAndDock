        id app = ((id (*)(id, SEL, id))objc_msgSend)(DMCall(objc_getClass("SBApplicationController"), @"sharedInstance"), NSSelectorFromString(@"applicationWithBundleIdentifier:"), bid);
        DMLog([NSString stringWithFormat:@"[debug] force quit %@ -> %@", bid, app]);
        if (app) DMForceQuit((SBApplication *)app);
    }
    else if ([cmd hasPrefix:@"library_"]) {   // library_<0|1>: App Library up / away (iOS 15: -presentLibraryAnimated:...; iOS 16: the calls the Dock's button uses)
        BOOL up = [[cmd substringFromIndex:8] boolValue];
        id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
        SEL sel = NSSelectorFromString(up ? @"presentLibraryAnimated:completion:" : @"dismissLibraryAnimated:completion:");
        SEL sel16 = NSSelectorFromString(up ? @"presentLibraryForIconManager:windowScene:animated:" : @"dismissLibraryForIconManager:windowScene:animated:");
        id mgr = DMCall(ic, @"iconManager"); id scene = DMStatusBarWindow().windowScene;
        DMLog([NSString stringWithFormat:@"[debug] app library %d: responds %d / 16: %d", up, [ic respondsToSelector:sel], [ic respondsToSelector:sel16]]);
        if ([ic respondsToSelector:sel]) ((void (*)(id, SEL, BOOL, id))objc_msgSend)(ic, sel, YES, nil);
        else if ([ic respondsToSelector:sel16] && mgr && scene) ((void (*)(id, SEL, id, id, BOOL))objc_msgSend)(ic, sel16, mgr, scene, YES);
    }
    else if ([cmd isEqualToString:@"libstate"]) {   // libstate: every App Library "is it showing" answer (read-only)
        id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
        id mgr = DMCall(ic, @"iconManager");
        NSMutableString *out = [NSMutableString stringWithFormat:@"DMLibraryVisible %d", DMLibraryVisible()];
        for (NSString *n in @[@"isOverlayLibraryViewVisible", @"isLibraryViewControllerVisible", @"isMainDisplayLibraryViewVisible", @"isOverlayTodayOrLibraryViewVisible", @"isTodayOverlaySpotlightVisible", @"isMainDisplayLibraryViewVisibilityTransitioning"])
            for (id o in @[ic ?: [NSNull null], mgr ?: [NSNull null]]) { SEL q = NSSelectorFromString(n); if ([o respondsToSelector:q]) [out appendFormat:@", %@.%@ %d", o == ic ? @"ic" : @"mgr", n, ((BOOL (*)(id, SEL))objc_msgSend)(o, q)]; }
        UIViewController *lib = nil; @try { lib = [mgr valueForKey:@"overlayLibraryViewController"]; } @catch (id e) {}
        [out appendFormat:@", overlayLibraryViewController %@ (view in window %d, hidden %d)", lib ? NSStringFromClass([lib class]) : @"nil", lib.viewIfLoaded.window != nil, lib.viewIfLoaded.hidden];
        DMLog([@"[libstate] " stringByAppendingString:out]);
    }
    else if ([cmd isEqualToString:@"winlist"]) {   // every window with its level, sorted: who is above whom
        NSArray *all = [DMAllWindows() sortedArrayUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) { return a.windowLevel < b.windowLevel ? NSOrderedAscending : (a.windowLevel > b.windowLevel ? NSOrderedDescending : NSOrderedSame); }];
        for (UIWindow *w in all) DMLog([NSString stringWithFormat:@"[winlist] %8.1f %-42@ hidden %d alpha %.2f frame %@", w.windowLevel, NSStringFromClass([w class]), w.hidden, w.alpha, NSStringFromCGRect(w.frame)]);
    }
    else if ([cmd isEqualToString:@"locknow"]) {   // actually locks the device (SBSLockDevice via SpringBoardServices, dlsym'd), for testing the Lock Screen
