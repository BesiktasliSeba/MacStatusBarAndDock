%hook SBBootDefaults
- (BOOL)dontLockAfterCrash {
    return DMSkipLockWanted() && DMNoPasscodeSet() ? YES : %orig;
}
%end
%end
static void DMSkipLockInit(void) {   // (only where SpringBoard has that switch, as a BOOL getter)
    Class c = objc_getClass("SBBootDefaults");
    Method m = c ? class_getInstanceMethod(c, NSSelectorFromString(@"dontLockAfterCrash")) : NULL;
    char ret[8] = {0};
    if (m) method_getReturnType(m, ret, sizeof(ret));
    if (!m || (ret[0] != 'B' && ret[0] != 'c')) { DMLog(@"[lock] -[SBBootDefaults dontLockAfterCrash] not found here: skip Lock Screen after respring is off"); return; }
    %init(SkipLock);
}
static void DMSkipLockAfterRespring(id mgr, BOOL locked) {
