        SEL get = NSSelectorFromString(@"attributeForKey:");
        if (!avsc || ![avsc respondsToSelector:get]) { DMLog(@"[audiosessions] no AVSystemController"); return; }
        for (NSString *k in @[@"PlayingSessionsDescriptionAttribute", @"AVSystemController_PlayingSessionsDescriptionAttribute", @"AVSystemController_AudioIsPlayingSomewhereAttribute",
                              @"AVSystemController_SomeClientIsPlayingLongFormAudioAttribute", @"AVSystemController_NowPlayingAppIsPlayingAttribute",
                              @"AVSystemController_NowPlayingAppDisplayIDAttribute", @"AVSystemController_SubscribeToNotificationsAttribute",
