        SEL removeReason = NSSelectorFromString(@"_removeLockOverrideReason:");
        SEL setEnabled = NSSelectorFromString(@"setLockOverrideEnabled:forReason:");
        SEL unlock = NSSelectorFromString(@"unlock");
        SEL resync = NSSelectorFromString(@"updateLockOverrideForCurrentDeviceOrientation");
        DMLog([NSString stringWithFormat:@"[orientunlock] available: _removeLockOverrideReason: %d, setLockOverrideEnabled:forReason: %d, unlock %d, updateLockOverrideForCurrentDeviceOrientation %d",
               [mgr respondsToSelector:removeReason], [mgr respondsToSelector:setEnabled], [mgr respondsToSelector:unlock], [mgr respondsToSelector:resync]]);
        // Every reason string any debug trigger in this file has ever used to add an override (orient_/orient2_/orient3_) -- confirmed live
        // (2026-09-23) that `unlock` and `setLockOverrideEnabled:NO forReason:` do NOT clear a reason-specific override despite responding to
        // both selectors; only calling `_removeLockOverrideReason:` with the EXACT reason string that added it actually clears it. Removing all
        // of them here regardless of which trigger is calling makes this a genuine "clear everything this file could possibly have set" reset.
