    static int told = 0; if (told++ < 40) DMLog([NSString stringWithFormat:@"[zflex] %@: frame %@ -> the window's content %@", [sid substringFromIndex:8], NSStringFromCGRect(f), NSStringFromCGRect(w)]);
    return copy;
}
// iPad 2 (2026-09-26): in a Zetsu window, Settings kept shrinking with black bars at the sides while scrolling up near the top of a page
// (portrait-size and wide windows alike, "Resize Apps to Fit Windows" on or off). Every touch-down in the window makes Zetsu call
// -[SpringBoard launchApplicationWithIdentifier:suspended:] and then, from a main-queue block, send the app its full-screen frame and put its
// content view back to its own "full-screen picture scaled into the window" layout (bounds 768 x 1024, transform host/screen per axis). The frame
// is corrected in the update itself (above), but the content view's scale landed on the screen until the watcher's next pass put it back (up to a
// few tenths of a second): the app, laid out at the window's size, drawn at half its width (measured: ~20 display frames per scroll). The main
// fix is DMZetsuContentView below (the picture's view does not take Zetsu's scale at all); this is the backstop for everything else in the window
// (its layer hosts, a picture view of another class): when such a full-screen frame is corrected, the window is put right again at the commit
// of that transaction and just before Core Animation commits (a run-loop observer ordered in front of the commit) for the next 0.25 s.
// Kill switch: /tmp/msb-zetsu-noprecommit. Verbose log: /tmp/msb-zflexlog.
static NSMutableSet<NSString *> *gZetsuPreCommitBundles;
static CFTimeInterval gZetsuPreCommitUntil;
static void DMZetsuPreCommitPass(NSString *via) {
    if (!gZetsuPreCommitBundles.count) return;
    BOOL diag = DMTestFlag("/tmp/msb-zflexlog");
    for (NSString *b in [gZetsuPreCommitBundles allObjects]) {
        UIWindow *w = DMZetsuWindowFor(b);
        if (!w || w.hidden || DMStageMinimized(w) || [objc_getAssociatedObject(w, kStageClosingKey) boolValue] || !gZetsuFlexFrames[b]) { [gZetsuPreCommitBundles removeObject:b]; continue; }
        UIView *host = nil; @try { host = [DMZetsuController(w) valueForKey:@"hosts"]; } @catch (id e) {}
        UIView *content = [host isKindOfClass:[UIView class]] ? host.subviews.firstObject : nil;
        if (!content) continue;
        CGSize hs = host.bounds.size, cs = content.bounds.size;
        BOOL scaled = !CGAffineTransformIsIdentity(content.transform) || fabs(cs.width - hs.width) > 0.5 || fabs(cs.height - hs.height) > 0.5;
        if (!scaled) continue;
        NSArray *anims = content.layer.animationKeys;
        [UIView performWithoutAnimation:^{ DMZetsuFixScale(w); }];
        if (anims.count) { [content.layer removeAllAnimations]; }
        static CFTimeInterval lastLog = 0; static int burst = 0;
        if (CACurrentMediaTime() - lastLog > 5.0) burst = 0;
        if (burst++ < 2 || diag) { lastLog = CACurrentMediaTime(); DMLog([NSString stringWithFormat:@"[zflex] %@: Zetsu scaled the window's content again (size %@, animations %lu): put back before it was drawn (%@)", b, NSStringFromCGSize(cs), (unsigned long)anims.count, via]); }
    }
}
static void DMZetsuFixBeforeCommit(NSString *bundle) {
    if (!bundle.length || DMTestFlag("/tmp/msb-zetsu-noprecommit")) return;
    if (!gZetsuPreCommitBundles) gZetsuPreCommitBundles = [NSMutableSet set];
    [gZetsuPreCommitBundles addObject:bundle];
    gZetsuPreCommitUntil = CACurrentMediaTime() + 0.25;
    {   // the transaction this update is part of: Zetsu re-scales the content view right after sending the update, in the same transaction
        static CFTimeInterval handlerAdded = 0;
        if (CACurrentMediaTime() - handlerAdded > 0.002 && [CATransaction respondsToSelector:NSSelectorFromString(@"addCommitHandler:forPhase:")]) {
            handlerAdded = CACurrentMediaTime();
            void (^handler)(void) = ^{ @try { DMZetsuPreCommitPass(@"at the commit"); } @catch (NSException *e) {} };
            @try { ((void (*)(id, SEL, id, int))objc_msgSend)([CATransaction class], NSSelectorFromString(@"addCommitHandler:forPhase:"), handler, 1); }   // 1 = kCATransactionPhasePreCommit
            @catch (NSException *e) {}
