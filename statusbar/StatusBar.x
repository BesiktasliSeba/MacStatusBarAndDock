// Stamps a synthetic IOHIDEvent digitizer event with the target window/scene context before it is handed
// to UIKit -- see the real-touch injection section below for the full explanation (matches Apple's own
// on-device UI test harness, WebKit's HIDEventGenerator.mm, which is the verified-real-device reference).
extern void BKSHIDEventSetDigitizerInfo(void *digitizerEvent, uint32_t contextID, uint8_t systemGestureIsPossible, uint8_t isSystemGestureStateChangeEvent, CFStringRef displayUUID, CFTimeInterval initialTouchTimestamp, float maxForce);
// Returns the (mutable) BKSHIDEventDigitizerAttributes object attached to a digitizer IOHIDEvent -- a
// SEPARATE layer of metadata from the raw IOHIDEvent fields, read-only-confirmed via `methsearch_` tonight
// to carry (among other things) a `pathAttributes` array of per-finger BKSHIDEventDigitizerPathAttributes,
// each with its OWN `hitTestLocation` distinct from the raw finger event's x/y. Declared `id` (not the real
// class, which this project does not import) so ordinary ObjC/KVC calls work on whatever it returns.
extern id BKSHIDEventGetDigitizerAttributes(void *digitizerEvent);

