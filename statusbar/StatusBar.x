        NSMutableSet *set = [NSMutableSet set];
        for (NSString *b in allMin) if (allMin[b].boolValue && ![b isEqualToString:front ?: @""]) [set addObject:b];
        @synchronized (gMinimizedOnlyLock) { gMinimizedOnlyApps = [set copy]; }
