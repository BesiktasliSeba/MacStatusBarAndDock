        // (2026-09-26, M1: Twitter's scene was held at {1110, 806}, the window opened in the bottom-right corner and distorted)
        NSValue *intent = st ? objc_getAssociatedObject(st, kStageIntentKey) : nil;
        if (intent && st.window && st.superview) {
            CGRect sf = [st.superview convertRect:intent.CGRectValue toView:nil];
            r = gAerialFlavor == 5 ? CGRectMake(sf.origin.x + 6.0, sf.origin.y + 24.0, MAX(0, sf.size.width - 12.0), MAX(0, sf.size.height - 25.0))
                                   : CGRectMake(sf.origin.x, sf.origin.y + 24.0, sf.size.width, MAX(0, sf.size.height - 24.0));
        }
        else if (in.window) r = [in convertRect:in.bounds toView:nil];
        else if (st.window) {   // (a cold launch has no layer host yet: the app area worked out from the window; 5.0 puts it 6 pt in from the sides and 24 pt below the top, 1 pt above the bottom, as its own scene frames show)
            CGRect sf = [st convertRect:st.bounds toView:nil];
            r = gAerialFlavor == 5 ? CGRectMake(sf.origin.x + 6.0, sf.origin.y + 24.0, MAX(0, sf.size.width - 12.0), MAX(0, sf.size.height - 25.0))
                                   : CGRectMake(sf.origin.x, sf.origin.y + 24.0, sf.size.width, MAX(0, sf.size.height - 24.0));   // (24 = kStageBarHeight, defined further down)
        }
        if (CGRectIsNull(r) || r.size.width < 50.0 || r.size.height < 50.0 || !isfinite(r.size.width) || !isfinite(r.size.height)) {
            DMLog([NSString stringWithFormat:@"[vetoframe] %@: no window frame to keep (content view %d, on screen %@)", bundle, in != nil, NSStringFromCGRect(r)]);
            return;
        }
        o = ((long (*)(id, SEL))objc_msgSend)(incoming, oriSel);
        if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 16) o = 1;   // (iPadOS 16 keeps window scenes at 1, frame as on the screen: see DMPortraitWindowSettings)
        else if (o == 3 || o == 4) r.size = CGSizeMake(r.size.height, r.size.width);
        f = r; source = intent ? @"where the window was placed" : @"the window on the screen";
    }
    if (!gVetoFrameHolds) gVetoFrameHolds = [NSMutableDictionary dictionary];
    gVetoFrameHolds[sid] = @{ @"frame": [NSValue valueWithCGRect:f], @"orientation": @(o), @"until": @(CACurrentMediaTime() + 1.0), @"bundle": [bundle copy] };
    DMLog([NSString stringWithFormat:@"[vetoframe] %@: kept in the foreground, so its window frame %@ (orientation %ld, from %@) is kept for 1 s", bundle, NSStringFromCGRect(f), o, source]);
}
// For every update: a full-screen frame for a scene under a hold becomes the window's frame.
static id DMVetoFrameHoldApply(id scene, id settings, NSString *sid) {
    if (!gVetoFrameHolds.count || !sid.length) return settings;
    NSDictionary *hold = gVetoFrameHolds[sid];
    if (!hold) return settings;
    if (CACurrentMediaTime() > [hold[@"until"] doubleValue] || !DMVetoFrameHoldAllowed(hold[@"bundle"])) { [gVetoFrameHolds removeObjectForKey:sid]; return settings; }
    SEL frameSel = NSSelectorFromString(@"frame"), setFrame = NSSelectorFromString(@"setFrame:"), setOri = NSSelectorFromString(@"setInterfaceOrientation:");
    if (![settings respondsToSelector:frameSel]) return settings;
    CGRect f = ((CGRect (*)(id, SEL))objc_msgSend)(settings, frameSel);
    if (!DMSceneFrameIsCanvas(f)) return settings;   // (a window-sized frame -- Aerial's own -- goes through as it is)
    id copy = [settings respondsToSelector:@selector(mutableCopy)] ? [settings mutableCopy] : nil;
    if (![copy respondsToSelector:setFrame] || ![copy respondsToSelector:setOri]) return settings;
    CGRect want = [hold[@"frame"] CGRectValue];
    ((void (*)(id, SEL, CGRect))objc_msgSend)(copy, setFrame, want);
    ((void (*)(id, SEL, long))objc_msgSend)(copy, setOri, [hold[@"orientation"] longValue]);
    copy = DMPortraitWindowSettings(scene, copy);   // (iPadOS 15: in line with the screen again if a turn changed it meanwhile)
    static CFTimeInterval lastLog = 0; static int burst = 0;
    if (CACurrentMediaTime() - lastLog > 1.0) burst = 0;
    if (burst++ < 3) DMLog([NSString stringWithFormat:@"[vetoframe] %@: full-screen frame %@ replaced by the window's %@", hold[@"bundle"], NSStringFromCGRect(f), NSStringFromCGRect(want)]);
    lastLog = CACurrentMediaTime();
    return copy;
}
#if DEBUG
// Debug: names the Objective-C method a code address is in (nearest method start in its image; read-only). Used by symbolize_<hex> and the scene
// update storm catcher.
static void DMSymbolize(unsigned long long a) {
    NSString *hex = [NSString stringWithFormat:@"%llx", a];
    Dl_info info; if (!a || !dladdr((void *)a, &info) || !info.dli_fname) { DMLog([NSString stringWithFormat:@"[symbolize] %@: no image", hex]); return; }
    unsigned int n = 0; const char **names = objc_copyClassNamesForImage(info.dli_fname, &n);
    uintptr_t best = 0; NSString *bestName = nil;
    for (unsigned int i = 0; i < n; i++) {
        Class c = objc_getClass(names[i]); if (!c) continue;
        for (int meta = 0; meta < 2; meta++) {
            Class k = meta ? object_getClass((id)c) : c;
            unsigned int mc = 0; Method *ms = class_copyMethodList(k, &mc);
            for (unsigned int j = 0; j < mc; j++) {
                uintptr_t imp = (uintptr_t)method_getImplementation(ms[j]);
                imp &= 0x0000000FFFFFFFFFULL;   // (strip pointer authentication bits)
                if (imp <= (a & 0x0000000FFFFFFFFFULL) && imp > best) { best = imp; bestName = [NSString stringWithFormat:@"%c[%s %s]", meta ? '+' : '-', names[i], sel_getName(method_getName(ms[j]))]; }
            }
            free(ms);
        }
    }
    free(names);
    DMLog([NSString stringWithFormat:@"[symbolize] %@ (%s) = %@ + %lu", hex, strrchr(info.dli_fname, '/') ? strrchr(info.dli_fname, '/') + 1 : info.dli_fname, bestName ?: @"?", (unsigned long)((a & 0x0000000FFFFFFFFFULL) - best)]);
}
#endif
// Scene update storm brake (iPad 2, iOS 16, Aerial 5.0, 27 Sep): a windowed YouTube got ~130 scene updates a second -- every one the same settings,
// with no transition, from SpringBoard's suspend transaction (-[SBSuspendedWorkspaceTransaction _childTransactionDidComplete:]) retrying against
// the window's kept foreground -- until the next respring. The app relaid itself out for each one: video and touches stuttered and the iPad drew
// about twice its normal power (1.7-2.5 A; 70% -> 52% in 12 min). An update without a transition that carries exactly the settings the scene
// already got changes nothing for the app, so past 10 of those within a second the rest are dropped; any real change, or any update with a
// transition, always goes through. iOS 15/16 only (17+ untested). Kill switch: /tmp/msb-nostormbrake.
static NSMutableDictionary<NSString *, id> *gStormLastSettings;
static NSMutableDictionary<NSString *, NSMutableArray<NSNumber *> *> *gStormSameTimes;
static NSMutableDictionary<NSString *, NSNumber *> *gStormDropped;
static BOOL DMStormBrakeDrops(id scene, id settings, id context) {
    if (DMNewOS() || !settings || DMTestFlag("/tmp/msb-nostormbrake")) return NO;
    NSString *sid = nil; @try { sid = [scene valueForKey:@"identifier"]; } @catch (id e) {}
    if (![sid hasPrefix:@"sceneID:"]) return NO;
    if (!gStormLastSettings) { gStormLastSettings = [NSMutableDictionary dictionary]; gStormSameTimes = [NSMutableDictionary dictionary]; gStormDropped = [NSMutableDictionary dictionary]; }
    id last = gStormLastSettings[sid];
    // (the scene's own current settings too: an update may reach it by another way than this hook -- the completion variant, or an engine's own
    // updater -- so "the same as the last one seen here" alone could drop a real change back to an earlier state)
    id current = nil; @try { current = [scene valueForKey:@"settings"]; } @catch (id e) {}
    BOOL same = !context && last && current && current != settings && [last isEqual:settings] && [current isEqual:settings];
    CFTimeInterval now = CACurrentMediaTime();
    if (!same) {
        id copy = nil; @try { copy = [settings copy]; } @catch (id e) {}
        if (copy) gStormLastSettings[sid] = copy; else [gStormLastSettings removeObjectForKey:sid];
        [gStormSameTimes removeObjectForKey:sid];
        NSInteger dropped = gStormDropped[sid].integerValue;
        if (dropped) { DMLog([NSString stringWithFormat:@"[storm] %@: brake released after %ld identical updates dropped", [sid substringFromIndex:8], (long)dropped]); [gStormDropped removeObjectForKey:sid]; }
        return NO;
    }
    NSMutableArray<NSNumber *> *times = gStormSameTimes[sid]; if (!times) { times = [NSMutableArray array]; gStormSameTimes[sid] = times; }
    [times addObject:@(now)];
    while (times.count && now - times[0].doubleValue > 1.0) [times removeObjectAtIndex:0];
    if (times.count <= 10) return NO;
    NSInteger dropped = gStormDropped[sid].integerValue + 1;
    gStormDropped[sid] = @(dropped);
    if (dropped == 1 || dropped % 1000 == 0) DMLog([NSString stringWithFormat:@"[storm] %@: over 10 identical updates within a second: dropping them (%ld so far)", [sid substringFromIndex:8], (long)dropped]);
    return YES;
}
#if DEBUG
// Debug (iPad 2, 27 Sep: a windowed YouTube got ~130 identical scene updates a second until the next respring, and lagged): when one scene gets more
// than 40 updates within a second, the caller of one of them is named, and the next 3 are traced with what they change (at most once every 10 s).
static NSMutableDictionary<NSString *, NSMutableArray<NSNumber *> *> *gSceneUpdateBursts;
static CFTimeInterval gSceneStormLogged = -100;
static void DMWatchSceneStorm(NSString *sid) {
    if (!sid.length) return;
    if (!gSceneUpdateBursts) gSceneUpdateBursts = [NSMutableDictionary dictionary];
    NSMutableArray<NSNumber *> *times = gSceneUpdateBursts[sid]; if (!times) { times = [NSMutableArray array]; gSceneUpdateBursts[sid] = times; }
    CFTimeInterval now = CACurrentMediaTime();
    [times addObject:@(now)];
    while (times.count && now - times[0].doubleValue > 1.0) [times removeObjectAtIndex:0];
    if (times.count <= 40 || now - gSceneStormLogged < 10.0) return;
    gSceneStormLogged = now;
    DMLog([NSString stringWithFormat:@"[storm] %@: %lu scene updates in the last second; callers:", sid, (unsigned long)times.count]);
    NSArray<NSNumber *> *ret = [NSThread callStackReturnAddresses];
    dispatch_async(dispatch_get_main_queue(), ^{ for (NSUInteger i = 1; i < ret.count && i < 9; i++) DMSymbolize(ret[i].unsignedLongLongValue); });
    if (gSceneStackLogs < 3) gSceneStackLogs = 3;
}
#endif
// iPadOS 17+ (untested versions): an iPad 7 on 18.2.1 crashed three times at every respring with the Mac status bar (issue #1): our scene hook below
// asked +[SBLockScreenManager sharedInstance] (DMScreenOnAndUnlocked) while SpringBoard was still starting up, or off the main thread where iOS 18
// may deliver scene updates. There, the hook stands aside in both cases and iOS updates the scene on its own (15/16: as before).
static BOOL DMSceneHookStandsAside(void) {
    return DMNewOS() && (![NSThread isMainThread] || DMStarting());
}
%hook FBScene
- (void)updateSettings:(id)settings withTransitionContext:(id)context completion:(id)completion {
    if (DMSceneHookStandsAside()) {
        %orig;
        return;
    }
    settings = DMHoldBackUnwantedForeground(self, settings, context);
    settings = DMZetsuFlexSettings(self, settings);
    settings = DMSaneSceneSettings(self, settings);
    {   // (the same frame hold as the veto in the method below, when this path keeps a window's scene in the foreground)
        id before = settings;
        settings = DMKeepWindowedSettings(self, settings, @"update with completion");
        if (settings != before && DMSettingsForeground(settings) && !DMSettingsForeground(before)) {
            NSString *sid = nil; @try { sid = [self valueForKey:@"identifier"]; } @catch (id e) {}
            id current = nil; @try { current = [self valueForKey:@"settings"]; } @catch (id e) {}
            NSString *windowed = nil;
            for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length && [sid containsString:b]) { windowed = b; break; } }
            if (windowed) DMVetoFrameHoldStart(self, sid, windowed, current, settings);
        }
    }
    settings = DMPortraitWindowSettings(self, settings);
    { NSString *holdID = nil; if (gVetoFrameHolds.count) { @try { holdID = [self valueForKey:@"identifier"]; } @catch (id e) {} } settings = DMVetoFrameHoldApply(self, settings, holdID); }
    %orig(settings, context, completion);
}
- (void)updateSettings:(id)settings withTransitionContext:(id)context {
    if (DMSceneHookStandsAside()) {
        %orig;
        return;
    }
    if (!gSceneByID) gSceneByID = [NSMutableDictionary dictionary];
    id incomingSettings = settings;   // (debug, scenestack_<n>: what SpringBoard sent, before our changes)
#if DEBUG
    if (DMTestFlag("/tmp/macstatusbar-debug")) { NSString *sid = nil; @try { sid = [self valueForKey:@"identifier"]; } @catch (id e) {} DMWatchSceneStorm(sid); }
#endif
    settings = DMZetsuHoldBackWhileLocked(self, settings, context);
    settings = DMHoldBackUnwantedForeground(self, settings, context);
    settings = DMZetsuFlexSettings(self, settings);
    settings = DMSaneSceneSettings(self, settings);
    settings = DMPortraitWindowSettings(self, settings);
    // SpringBoard sends the scenes of apps that are not in its layout to the background when the App Switcher closes or a full-screen app opens. A windowed
    // app is on the screen, so it stays in the foreground (a video keeps playing instead of pausing for a moment). Not while the screen is locked or off,
    // and not for a window that is being closed.
    if (context && [settings respondsToSelector:NSSelectorFromString(@"isForeground")] && !DMSettingsForeground(settings)) {
        NSString *sid = nil; @try { sid = [self valueForKey:@"identifier"]; } @catch (id e) {}
        id current = nil; @try { current = [self valueForKey:@"settings"]; } @catch (id e) {}
        if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[veto] %@: current foreground %d, screen on and unlocked %d, locking %d", sid, current ? DMSettingsForeground(current) : -1, DMScreenOnAndUnlocked(), CACurrentMediaTime() < gLockingUntil]);
        if (DMTestFlag("/tmp/macstatusbar-debug") && current && !DMSettingsForeground(current)) {
            NSMutableString *trace = [NSMutableString string]; NSArray *st = [NSThread callStackSymbols];
            for (NSUInteger i = 1; i < st.count && i < 16; i++) [trace appendFormat:@"\n      %@", st[i]];
            DMLog([NSString stringWithFormat:@"[veto] the scene was already in the background before this update; called from:%@", trace]);
        }
        // (the scene's own current settings are no help: on SpringBoard's path they already hold the new value when this runs)
        if ([sid hasPrefix:@"sceneID:"] && DMScreenOnAndUnlocked()) {
            NSString *windowed = nil;
            for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length && [sid containsString:b]) { windowed = b; break; } }
            BOOL closing = windowed && gFullFrameGuardBundle.length && [windowed isEqualToString:gFullFrameGuardBundle] && CACurrentMediaTime() < gFullFrameGuardUntil;
            if (windowed && DMStageMinimized(DMStageForBundle(windowed))) closing = YES;   // (minimized: its app may go to the background, see DMSyncMinimizedScenes)
            if (windowed && !closing && (!DMSceneAlive(self) || !DMSceneIsStageScene(self, windowed))) {   // (an extra scene of the app, or one that is ending)
                DMLog([NSString stringWithFormat:@"[scene] %@: scene %@ %@: may go to the background", windowed, DMShortSceneID(self), DMSceneAlive(self) ? @"is not the window's scene" : @"is ending"]);
                closing = YES;
            }
            id copy = windowed && !closing && !DMKeepFgShouldYield(self, sid, windowed) ? [settings mutableCopy] : nil;
            if ([copy respondsToSelector:NSSelectorFromString(@"setForeground:")]) {
                ((void (*)(id, SEL, BOOL))objc_msgSend)(copy, NSSelectorFromString(@"setForeground:"), YES);
                settings = copy;
                DMLog([NSString stringWithFormat:@"[scene] %@ is a window: kept in the foreground (SpringBoard tried to send it to the background, scene %@)", windowed, DMShortSceneID(self)]);
                DMVetoFrameHoldStart(self, sid, windowed, current, copy);
            }
        }
    }
    { NSString *holdID = nil; if (gVetoFrameHolds.count) { @try { holdID = [self valueForKey:@"identifier"]; } @catch (id e) {} } settings = DMVetoFrameHoldApply(self, settings, holdID); }
    if (gFullFrameGuardBundle.length && CACurrentMediaTime() < gFullFrameGuardUntil && [settings respondsToSelector:NSSelectorFromString(@"frame")]) {
        NSString *guardID = nil; @try { guardID = [self valueForKey:@"identifier"]; } @catch (id e) {}
        if ([guardID containsString:gFullFrameGuardBundle]) {
            CGSize screen = [UIScreen mainScreen].bounds.size;
            CGRect full = CGRectMake(0, 0, MIN(screen.width, screen.height), MAX(screen.width, screen.height));
            CGRect f = ((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame"));
            id copy = [settings respondsToSelector:@selector(mutableCopy)] ? [settings mutableCopy] : nil;
            if (!CGRectEqualToRect(f, full) && [copy respondsToSelector:NSSelectorFromString(@"setFrame:")]) {
                ((void (*)(id, SEL, CGRect))objc_msgSend)(copy, NSSelectorFromString(@"setFrame:"), full);
                settings = copy;
                DMLog([NSString stringWithFormat:@"[scene] guard: %@ update with frame %@ turned into the full screen", gFullFrameGuardBundle, NSStringFromCGRect(f)]);
            }
        }
    }
    if (!gSceneUpdateTime) gSceneUpdateTime = [NSMutableDictionary dictionary];
    @try { NSString *sid = [self valueForKey:@"identifier"]; if (sid.length) { { DMWeakScene *box = [DMWeakScene new]; box.scene = self; gSceneByID[sid] = box; } gSceneUpdateTime[sid] = @(CACurrentMediaTime()); } } @catch (id e) {}
    if (DMTestFlag("/tmp/macstatusbar-debug") && [settings respondsToSelector:NSSelectorFromString(@"frame")]) {
        NSString *sid = nil; @try { sid = [self valueForKey:@"identifier"]; } @catch (id e) {}
        if ([sid hasPrefix:@"sceneID:"]) {
            CGRect f = ((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame"));
            BOOL fg = [settings respondsToSelector:NSSelectorFromString(@"isForeground")] ? ((BOOL (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"isForeground")) : NO;
            long so = [settings respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientation")) : -1;
            DMLog([NSString stringWithFormat:@"[scene-upd] %@ frame %@ foreground %d orientation %ld %@", [sid substringFromIndex:8], NSStringFromCGRect(f), fg, so, context ? @"(with context)" : @""]);
            if (gSceneStackLogs > 0) {   // debug (trigger scenestack_<n>): who sends these updates
                gSceneStackLogs--;
                NSArray *st = [NSThread callStackSymbols]; NSMutableString *tr = [NSMutableString string];
                for (NSUInteger i = 1; i < st.count && i < 12; i++) [tr appendFormat:@"\n      %@", st[i]];
                DMLog([NSString stringWithFormat:@"[scene-upd] called from:%@", tr]);
                Class diffC = NSClassFromString(@"FBSSceneSettingsDiff"); SEL diffS = NSSelectorFromString(@"diffFromSettings:toSettings:");
                id current = nil; @try { current = [self valueForKey:@"settings"]; } @catch (id e) {}
                if ([diffC respondsToSelector:diffS]) {
                    id d1 = current ? ((id (*)(id, SEL, id, id))objc_msgSend)(diffC, diffS, current, incomingSettings) : nil;
                    id d2 = ((id (*)(id, SEL, id, id))objc_msgSend)(diffC, diffS, incomingSettings, settings);
                    DMLog([NSString stringWithFormat:@"[scene-upd] same object as current %d; current -> sent: %@\n  sent -> after our changes (%@): %@", current == incomingSettings, d1 ? [d1 description] : @"-", settings == incomingSettings ? @"untouched" : @"changed", [d2 description]]);
                }
            }
        }
    }
    static int logged = 0;
    SEL modeSel = NSSelectorFromString(@"interfaceOrientationMode");
    if (logged < 12 && DMTestFlag("/tmp/macstatusbar-debug") && [settings respondsToSelector:modeSel]) {
        long long mode = ((long long (*)(id, SEL))objc_msgSend)(settings, modeSel);
        NSString *scene = @"?"; @try { scene = [self valueForKey:@"identifier"]; } @catch (id e) {}
        NSMutableString *line = [NSMutableString stringWithFormat:@"[mode] %@ arrives with interfaceOrientationMode %lld (%@)", scene, mode, NSStringFromClass([settings class])];
        if (mode == 100 && logged < 3) {
            NSArray *stack = [NSThread callStackSymbols];
            for (NSUInteger i = 1; i < stack.count && i < 14; i++) [line appendFormat:@"\n      %@", stack[i]];
        }
        logged++;
        DMLog(line);
    }
    // MilkyWay leaves a windowed app's scene in "legacy" orientation mode (100), where the app ignores frame changes and keeps its
    // full-screen layout. Stock scenes (and Aerial's) are "alwaysAll" (2), which lets the app lay itself out for any frame. Keep it 2.
    SEL setMode = NSSelectorFromString(@"setInterfaceOrientationMode:");
    if (gFlexResize   // part of the flex-resize recipe (Settings > Mac Status Bar > Window Buttons)
        && [settings respondsToSelector:setMode] && [settings respondsToSelector:NSSelectorFromString(@"interfaceOrientationMode")]
        && ((long long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientationMode")) == 100) {
        ((void (*)(id, SEL, long long))objc_msgSend)(settings, setMode, 2);
        static int fixes = 0; if (fixes++ < 6) DMLog(@"[mode] legacy (100) changed to alwaysAll (2) on a scene update");
    }
    if (DMStormBrakeDrops(self, settings, context)) return;
    %orig;
}
// Aerial-parity fix: the only FBScene method Aerial itself hooks (confirmed by disassembly — every other Aerial/scene interaction is a
// plain message send, not a hook). A pure getter override, %orig always available as the fallback — same safe shape as every other
// %hook in this file (an existing method the OS already calls, on an object the OS already created, no alloc/init of anything).
// gAccessibilitySceneFrame is written at the single DMSetSceneFrame chokepoint above (windowing AND un-windowing both go through it,
// so a reset-to-full-screen naturally overwrites the entry with the full-screen frame rather than leaving a stale narrow one behind).
- (CGRect)accessibilitySceneFrame {
    CGRect real = %orig;
    @try {
        if (!gAccessibilitySceneFrame) return real;
        NSString *sid = [self valueForKey:@"identifier"];
        NSValue *tracked = sid.length ? gAccessibilitySceneFrame[sid] : nil;
        if (!tracked) return real;
        CGRect want = tracked.CGRectValue;
        if (CGRectEqualToRect(want, real)) return real;
        DMLog([NSString stringWithFormat:@"[scene] accessibilitySceneFrame override for %@: %@ -> %@", sid, NSStringFromCGRect(real), NSStringFromCGRect(want)]);
        return want;
    } @catch (id e) { return real; }
}
%end
static BOOL DMSetSceneFrame(id scene, CGRect frame) {
    @try {
        id settings = [scene valueForKey:@"settings"];
        id mutable = [settings mutableCopy];
        if (![mutable respondsToSelector:NSSelectorFromString(@"setFrame:")]) return NO;
        ((void (*)(id, SEL, CGRect))objc_msgSend)(mutable, NSSelectorFromString(@"setFrame:"), frame);
        // Aerial's scenes are in interfaceOrientationMode alwaysAll (2); MilkyWay's are "legacy" (100), where the app keeps its full-screen
        // layout and ignores frame changes.
        if ([mutable respondsToSelector:NSSelectorFromString(@"setInterfaceOrientationMode:")])
            ((void (*)(id, SEL, long long))objc_msgSend)(mutable, NSSelectorFromString(@"setInterfaceOrientationMode:"), 2);
        // Aerial's log shows each frame change followed by an update carrying a UIApplicationSceneTransitionContext; give ours one too.
        Class ctxClass = objc_getClass("UIApplicationSceneTransitionContext");
        id context = ctxClass ? [[ctxClass alloc] init] : nil;
        _logos_orig$_ungrouped$FBScene$updateSettings$withTransitionContext$((FBScene *)scene, NSSelectorFromString(@"updateSettings:withTransitionContext:"), mutable, context);
        // Aerial-parity fix (found by disassembling Aerial 3.0 offline): every place it sends a frame through the settings path above,
        // it ALSO, in the same breath, updates a private registry that its own -accessibilitySceneFrame hook (the only FBScene method
        // it hooks at all) reads from and returns instead of the real value when the two differ. This project's settings-path fix
        // alone (interfaceOrientationMode legacy->alwaysAll, above) was confirmed live to resize an app's CONTENT correctly but NOT to
        // update the app's own UIWindow.frame/.traitCollection (confirmed via MacAppBridge's own trait dump: windowScene.coordinateSpace.
        // bounds tracks the window correctly, but window.frame/.traitCollection stayed stuck at the full screen size regardless) — which
        // is exactly what would drive automatic UIKit split-view collapse for an app like Settings. Mirrors Aerial's two-part recipe
        // exactly: same chokepoint (every DMSetSceneFrame call, windowing and un-windowing alike, not just narrow ones), keyed by the
        // scene's own "identifier" property (an exact-match dictionary here, not Aerial's fuzzy containsString: on .description, since
        // this codebase already has a clean, known "sceneID:<bundle>[-suffix]" identifier format to key off directly).
        @try {
            NSString *sid = [scene valueForKey:@"identifier"];
            if (sid.length) {
                if (!gAccessibilitySceneFrame) gAccessibilitySceneFrame = [NSMutableDictionary dictionary];
                gAccessibilitySceneFrame[sid] = [NSValue valueWithCGRect:frame];
            }
        } @catch (id e) {}
        DMLog([NSString stringWithFormat:@"[scene] frame update sent with %@", context ? @"a transition context" : @"no context"]);
        return YES;
    } @catch (id e) { return NO; }
}
// ---- after an unlock: wake every window's app ----
// Locking sends every app to the background; a window's picture then goes black and its app does not come back by itself (Aerial's own
// answer is to minimize all windows on lock and restore them one by one afterwards). Windows stay as they are through a lock instead,
// so once the screen is unlocked each window's scene is brought back to the foreground and re-hosted.
static BOOL DMSetSceneForeground(id scene) {
    if (!DMSceneAlive(scene)) return NO;   // (never pull an ending scene back: see DMSceneAlive)
    @try {
        id settings = [scene valueForKey:@"settings"];
