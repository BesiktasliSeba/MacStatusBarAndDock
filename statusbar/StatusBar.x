        if (lockFn) lockFn(); else DMLog(@"[debug] SBSLockDevice not found");
    }
    else if ([cmd isEqualToString:@"lockstim"]) {   // what Aerial does when the screen locks: minimizeStage on every window (without locking the iPad)
