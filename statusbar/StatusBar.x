                v.transform = CGAffineTransformMake([q[0] doubleValue], 0, 0, [q[1] doubleValue], [q[2] doubleValue], [q[3] doubleValue]);
                DMLog([NSString stringWithFormat:@"[kbtf] host transform %@ frame %@ clips %d, window clips %d", NSStringFromCGAffineTransform(v.transform), NSStringFromCGRect(v.frame), v.clipsToBounds, w.clipsToBounds]);
            }
        }
    }
    else if ([cmd isEqualToString:@"kbprobe"]) {   // kbprobe: what the hosted keyboard scene in Aerial's keyboard window is made of
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
            {   // geometry of the whole tree
                NSMutableArray *g = [NSMutableArray arrayWithObject:@[w, @0]];
                while (g.count) {
                    NSArray *e = g.lastObject; [g removeLastObject];
                    UIView *v = e[0]; int d = [e[1] intValue];
                    DMLog([NSString stringWithFormat:@"[kbgeo] %*s%@ frame %@ bounds %@ tf %@ layerT %@", d * 2, "", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), NSStringFromCGRect(v.bounds), NSStringFromCGAffineTransform(v.transform), NSStringFromCGRect(v.layer.bounds)]);
                    for (UIView *s in [v.subviews reverseObjectEnumerator]) [g addObject:@[s, @(d + 1)]];
                }
            }
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
                NSString *cn = NSStringFromClass([v class]);
                if (![cn isEqualToString:@"_UIScenePresentationView"] && ![cn isEqualToString:@"_UIKeyboardLayerHostView"]) continue;
                NSMutableString *iv = [NSMutableString string];
                for (Class c = [v class]; c && c != [UIView class]; c = class_getSuperclass(c)) {
                    unsigned n = 0; Ivar *l = class_copyIvarList(c, &n);
                    for (unsigned i = 0; i < n; i++) { const char *t = ivar_getTypeEncoding(l[i]); [iv appendFormat:@" %@.%s:%s", NSStringFromClass(c), ivar_getName(l[i]), t ?: "?"]; }
                    free(l);
                }
                DMLog([NSString stringWithFormat:@"[kbprobe] %@ %p ivars:%@", cn, v, iv]);
                for (NSString *k in @[@"scene", @"_scene", @"presenter", @"_presenter", @"presentationManager", @"_presentationManager", @"sceneIdentifier", @"identifier", @"hostedScene"]) {
                    id val = nil; @try { val = [v valueForKey:k]; } @catch (id e) {}
                    if (val) DMLog([NSString stringWithFormat:@"[kbprobe]   %@ = %@ (%@)", k, NSStringFromClass([val class]), [[val description] length] > 300 ? [[val description] substringToIndex:300] : val]);
                }
            }
        }
    }
    else if ([cmd hasPrefix:@"kbscene_"]) {   // kbscene_<orientation>_<w>_<h>: give the keyboard scene that orientation and size (experiment)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
                if (![NSStringFromClass([v class]) isEqualToString:@"_UIScenePresentationView"]) continue;
                id scene = nil; for (NSString *k in @[@"scene", @"_scene"]) { @try { scene = [v valueForKey:k]; } @catch (id e) {} if (scene) break; }
                if (!scene || q.count < 3) { DMLog(@"[kbscene] no scene found or bad arguments"); continue; }
                @try {
                    id settings = [scene valueForKey:@"settings"];
                    id m = [settings mutableCopy];
                    DMLog([NSString stringWithFormat:@"[kbscene] scene %@ settings %@ orientation %ld frame %@", NSStringFromClass([scene class]), NSStringFromClass([settings class]), [settings respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"interfaceOrientation")) : -1L, [settings respondsToSelector:NSSelectorFromString(@"frame")] ? NSStringFromCGRect(((CGRect (*)(id, SEL))objc_msgSend)(settings, NSSelectorFromString(@"frame"))) : @"-"]);
                    ((void (*)(id, SEL, long))objc_msgSend)(m, NSSelectorFromString(@"setInterfaceOrientation:"), [q[0] integerValue]);
                    ((void (*)(id, SEL, CGRect))objc_msgSend)(m, NSSelectorFromString(@"setFrame:"), CGRectMake(0, 0, [q[1] doubleValue], [q[2] doubleValue]));
                    ((void (*)(id, SEL, id, id))objc_msgSend)(scene, NSSelectorFromString(@"updateSettings:withTransitionContext:"), m, nil);
                    DMLog(@"[kbscene] settings updated");
                } @catch (id e) { DMLog([NSString stringWithFormat:@"[kbscene] exception %@", e]); }
            }
        }
    }
    else if ([cmd hasPrefix:@"ccperf_"]) {   // ccperf_<opts>: present Control Center while timing every frame; opts: m = full-screen material off, v = panel blur off, n = nothing
        NSString *opts = [cmd substringFromIndex:7];
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"]) continue;
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
                NSString *cn = NSStringFromClass([v class]);
                if ([opts containsString:@"m"] && [cn isEqualToString:@"MTMaterialView"] && v.bounds.size.width > 1000.0) { v.hidden = YES; DMLog(@"[ccperf] full-screen material hidden"); }
                if ([opts containsString:@"v"] && [cn isEqualToString:@"UIVisualEffectView"] && v.bounds.size.width > 300.0) { v.hidden = YES; DMLog(@"[ccperf] panel blur hidden"); }
            }
        }
        DMWatchFrameGaps(2.4);
        id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
        if ([cc respondsToSelector:NSSelectorFromString(@"presentAnimated:")]) ((void (*)(id, SEL, BOOL))objc_msgSend)(cc, NSSelectorFromString(@"presentAnimated:"), YES);
    }
    else if ([cmd hasPrefix:@"ccrec_"]) {   // ccrec_<seconds>: log the Control Center window's big views frame by frame
        gCCRecorder = [DMCCRecorder new];
        gCCRecorder.start = CACurrentMediaTime(); gCCRecorder.until = gCCRecorder.start + [[cmd substringFromIndex:6] doubleValue]; gCCRecorder.last = [NSMutableDictionary dictionary];
        gCCRecorder.link = [CADisplayLink displayLinkWithTarget:gCCRecorder selector:@selector(tick:)];
        [gCCRecorder.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
        DMLog(@"[ccrec] start");
    }
    else if ([cmd hasPrefix:@"framegap_"]) {   // framegap_<seconds>: log every display frame that took much longer than it should (main thread stalls)
        DMWatchFrameGaps([[cmd substringFromIndex:9] doubleValue]);
    }
    else if ([cmd isEqualToString:@"screenwake"] || [cmd isEqualToString:@"wake"]) {   // screenwake / wake: turn the screen on (Phase 2b: "wake" used to be defined twice; the Aerial stage wake is now "wakestages")
        SBBacklightController *bl = DMShared("SBBacklightController", @selector(sharedInstance));
        if ([bl respondsToSelector:@selector(turnOnScreenFullyWithBacklightSource:)]) [bl turnOnScreenFullyWithBacklightSource:1];
        DMLog(@"[debug] screen wake requested");
    }
    else if ([cmd isEqualToString:@"wakestages"]) DMWakeAllStages(@"trigger");   // wakestages: wake every Aerial stage (was the shadowing "wake")
    else if ([cmd isEqualToString:@"appmin"]) DMMinimizeActiveApp();   // the app menu's Minimize
    else if ([cmd isEqualToString:@"fqall"]) DMForceQuitAll();
    else if ([cmd hasPrefix:@"atrigger_"]) {   // atrigger_<bundle id>: open that app as a window through Aerial directly (no toggle needed)
        CGRect target = DMLayoutFrame(@"center");
        DMLog([NSString stringWithFormat:@"[debug] atrigger %@", [cmd substringFromIndex:9]]);
        DMAerialTrigger([cmd substringFromIndex:9], target);
    }
    else if ([cmd hasPrefix:@"scenedesc_"]) {   // scenedesc_<bundle id>: the live scene's settings, in full
        id scene = DMSceneForBundle([cmd substringFromIndex:10]);
        @try { DMLog([NSString stringWithFormat:@"[scenedesc] %@ settings:\n%@\nclient settings:\n%@", [cmd substringFromIndex:10], [scene valueForKey:@"settings"], [scene respondsToSelector:NSSelectorFromString(@"clientSettings")] ? [scene valueForKey:@"clientSettings"] : @"(none)"]); } @catch (id e) { DMLog(@"[scenedesc] exception"); }
    }
    else if ([cmd hasPrefix:@"atree_"]) {   // atree_<bundle id>: that window's view tree
        UIView *s = DMStageForBundle([cmd substringFromIndex:6]);
        DMLog([NSString stringWithFormat:@"[atree] ==== %@", [cmd substringFromIndex:6]]);
        if (s) DMDumpViewTree(s, 0);
    }
    else if ([cmd isEqualToString:@"atree"] || [cmd isEqualToString:@"afix"]) {   // the top window's view tree (afix: first ask Aerial to fit the content to the window)
        UIView *s = DMTopStage();
        if ([cmd isEqualToString:@"afix"] && s) { SEL fit = DMAerialSel(@"adjustContentScaleToHost"); if ([s respondsToSelector:fit]) ((void (*)(id, SEL))objc_msgSend)(s, fit); [s setNeedsLayout]; [s layoutIfNeeded]; }
        if (s) DMDumpViewTree(s, 0);
    }
    else if ([cmd hasPrefix:@"hitwin_"]) {   // hitwin_<x>_<y>: which window (highest level first) and view a touch at that screen point would reach (debug)
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];
        CGPoint pt = CGPointMake([q.firstObject doubleValue], [q.lastObject doubleValue]);
        NSArray<UIWindow *> *ws = [[UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES] sortedArrayUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) { return a.windowLevel > b.windowLevel ? NSOrderedAscending : (a.windowLevel < b.windowLevel ? NSOrderedDescending : NSOrderedSame); }];
        NSMutableString *o = [NSMutableString stringWithFormat:@"[hitwin] %@:", NSStringFromCGPoint(pt)];
        int shown = 0;
        for (UIWindow *w in ws) {
            if (w.hidden || w.alpha < 0.01 || !w.userInteractionEnabled) continue;
            CGPoint lp = [w convertPoint:pt fromCoordinateSpace:w.screen.coordinateSpace];
            UIView *h = [w hitTest:lp withEvent:nil];
            if (!h) continue;
            [o appendFormat:@" | %@ (%.1f) -> %@", NSStringFromClass([w class]), w.windowLevel, NSStringFromClass([h class])];
            if (++shown >= 3) break;
        }
        DMLog(o);
    }
    else if ([cmd hasPrefix:@"pointhunt_"]) {   // pointhunt_<x>_<y>: small views around that screen point, with their chain of parents
        NSArray *q = [[cmd substringFromIndex:10] componentsSeparatedByString:@"_"];
        CGPoint pt = CGPointMake([q.firstObject doubleValue], [q.lastObject doubleValue]);
        for (UIWindow *w in DMAllWindows()) DMPointHunt(w, w, pt, @"");
        DMLog(@"[point] done");
    }
    else if ([cmd isEqualToString:@"arehost"] || [cmd isEqualToString:@"aensure"]) {   // try to wake every window's app: +[AerialCore rehost:] / -[AerialStage ensureSceneVisible]
        for (UIView *s in DMAerialStages()) {
            NSString *bid = DMStageBundle(s);
            if ([cmd isEqualToString:@"arehost"]) { ((void (*)(id, SEL, id))objc_msgSend)((id)objc_getClass("AerialCore"), DMAerialSel(@"rehost:"), bid); }
            else if ([s respondsToSelector:DMAerialSel(@"ensureSceneVisible")]) ((void (*)(id, SEL))objc_msgSend)(s, DMAerialSel(@"ensureSceneVisible"));
            DMLog([NSString stringWithFormat:@"[debug] %@ %@", cmd, bid]);
        }
    }
    else if ([cmd hasPrefix:@"swipe_"]) {   // swipe_<map>_<x0>_<y0>_<x1>_<y1>_<ms>_<hold ms>: OLD pre-fix drag trigger, kept only as an alias to `drag_`.
        // `map` and `hold` are no longer needed: the old system-wide IOHIDEventSystemClientDispatchEvent path this
        // used required guessing a native-sensor coordinate mapping (and never worked on the M1 at all -- see the
        // long comment above DMSendDigitizerPhase). Use `drag_<x1>_<y1>_<x2>_<y2>_<durationMs>` directly instead.
        NSArray *q = [[cmd substringFromIndex:6] componentsSeparatedByString:@"_"];
        if (q.count >= 6) {
            CGPoint a = CGPointMake([q[1] doubleValue], [q[2] doubleValue]), b = CGPointMake([q[3] doubleValue], [q[4] doubleValue]);
            DMLog([NSString stringWithFormat:@"[touch2] swipe_ is deprecated, forwarding to DMInjectDrag %@ -> %@", NSStringFromCGPoint(a), NSStringFromCGPoint(b)]);
            DMInjectDrag(a, b, [q[5] doubleValue]);
        }
    }
    else if ([cmd hasPrefix:@"classlist_"]) {   // classlist_<keyword>: the names of all classes containing it
        NSString *kw = [[cmd substringFromIndex:10] lowercaseString];
        unsigned n = 0; Class *all = objc_copyClassList(&n);
        NSMutableArray *names = [NSMutableArray array];
        for (unsigned i = 0; i < n; i++) { NSString *cn = NSStringFromClass(all[i]); if ([[cn lowercaseString] containsString:kw]) [names addObject:cn]; }
        free(all);
        [names sortUsingSelector:@selector(compare:)];
        DMLog([NSString stringWithFormat:@"[classes] %@: %@", kw, [names componentsJoinedByString:@" "]]);
    }
    else if ([cmd hasPrefix:@"sbget_"]) {   // sbget_<Class>_<selector>: [[Class sharedInstance] selector] as a number (BOOL / integer / pointer)
        NSArray *q = [[cmd substringFromIndex:6] componentsSeparatedByString:@"_"];
        if (q.count >= 2) {
            id inst = DMCall(objc_getClass([q[0] UTF8String]), @"sharedInstance");
            SEL sel = NSSelectorFromString(q[1]);
            if (inst && [inst respondsToSelector:sel]) DMLog([NSString stringWithFormat:@"[sbget] %@ %@ = %ld", q[0], q[1], ((long (*)(id, SEL))objc_msgSend)(inst, sel)]);
            else DMLog([NSString stringWithFormat:@"[sbget] %@ %@: %@", q[0], q[1], inst ? @"no such method" : @"no shared instance"]);
        }
    }
    else if ([cmd isEqualToString:@"hidewindows"]) {   // hidewindows: hide the window layer the way a stuck App Switcher gesture leaves it (tests the recovery)
        UIWindow *layer = DMWindowLayer(); layer.hidden = YES;
        DMLog(@"[debug] window layer hidden by hand");
    }
    else if ([cmd isEqualToString:@"cctexts"]) {   // cctexts: every label in the Control Center window (text, hidden, size, its enclosing tile)
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"SBControlCenterWindow"]) continue;
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
                if ([v isKindOfClass:[UILabel class]] && ((UILabel *)v).text.length) DMLog([NSString stringWithFormat:@"[cctext] \"%@\" hidden %d size %@ tile %@ (%@)", ((UILabel *)v).text, v.hidden, NSStringFromCGSize(v.bounds.size), NSStringFromClass([DMEnclosingTile(v) class]), NSStringFromClass([v.superview class])]);
            }
        }
        DMLog(@"[cctext] done");
    }
    else if ([cmd hasPrefix:@"bgscene_"]) {   // bgscene_<bundle>: send that app's scene to the background the way SpringBoard does (with a transition context); a window must refuse
        NSString *bid = [cmd substringFromIndex:8];
        id scene = DMSceneForBundle(bid);
        Class ctxClass = objc_getClass("UIApplicationSceneTransitionContext");
        id settings = [scene valueForKey:@"settings"];
        id copy = [settings mutableCopy];
        if (scene && [copy respondsToSelector:NSSelectorFromString(@"setForeground:")]) {
            ((void (*)(id, SEL, BOOL))objc_msgSend)(copy, NSSelectorFromString(@"setForeground:"), NO);
            ((void (*)(id, SEL, id, id))objc_msgSend)(scene, NSSelectorFromString(@"updateSettings:withTransitionContext:"), copy, ctxClass ? [[ctxClass alloc] init] : nil);
        }
        id after = [scene valueForKey:@"settings"];
        DMLog([NSString stringWithFormat:@"[debug] bgscene %@: scene %@, foreground now %d", bid, scene ? @"found" : @"NOT found", after ? DMSettingsForeground(after) : -1]);
    }
    else if ([cmd hasPrefix:@"hwkb_"]) {   // hwkb_<0|1>: pretend the hardware keyboard is gone / back, here and in every windowed app (their MacAppBridge, debug build)
        BOOL back = [cmd hasPrefix:@"hwkb_1"];
        gPretendNoHardwareKeyboard = !back;
        for (UIView *st in DMAerialStages()) {
            NSString *b = DMStageBundle(st); if (!b.length) continue;
            uint32_t hash = 2166136261u; for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
            char name[64]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.%s.%08x", back ? "hwon" : "hwoff", hash);
            notify_post(name);
        }
        DMLog([NSString stringWithFormat:@"[debug] hardware keyboard pretended %@", back ? @"back" : @"gone"]);
    }
    else if ([cmd hasPrefix:@"hwlist_"]) {   // hwlist_<bundle>: the app lists its keyboard methods with "hardware" in their name into its own tmp folder
        NSString *b = [cmd substringFromIndex:7];
        uint32_t hash = 2166136261u; for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
        char name[64]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.list.%08x", hash);
        notify_post(name);
    }
    else if ([cmd isEqualToString:@"kbstate"]) { gKbLogAgain = YES; }   // kbstate: log the keyboard state now, even if nothing changed
    else if ([cmd hasPrefix:@"keys_"]) DMKeysSpec([cmd substringFromIndex:5]);   // keys_<spec>: press keys like a hardware keyboard (see DMKeysSpec)
    else if ([cmd hasPrefix:@"btkb_"]) {   // btkb_list / btkb_off / btkb_on: list paired Bluetooth devices, or disconnect / connect the paired keyboard(s) only (Keyboard Phase tests)
        dlopen("/System/Library/PrivateFrameworks/BluetoothManager.framework/BluetoothManager", RTLD_LAZY);
        id bm = DMCall(objc_getClass("BluetoothManager"), @"sharedInstance");
        NSMutableArray *paired = [NSMutableArray array];
        for (NSString *sel in @[@"connectedDevices", @"pairedDevices"]) {   // (a device paired after SpringBoard started shows up in connectedDevices first)
            NSArray *l = [bm respondsToSelector:NSSelectorFromString(sel)] ? DMCall(bm, sel) : nil;
            for (id d in l) if (![paired containsObject:d]) [paired addObject:d];
        }
        NSString *what = [cmd substringFromIndex:5];
        if ([what hasPrefix:@"power"]) {   // btkb_power0 / btkb_power1: Bluetooth itself off / on (the only way to drop a Bluetooth LE keyboard from here)
            BOOL on = [what hasSuffix:@"1"];
            if ([bm respondsToSelector:NSSelectorFromString(@"setPowered:")]) ((void (*)(id, SEL, BOOL))objc_msgSend)(bm, NSSelectorFromString(@"setPowered:"), on);
            if ([bm respondsToSelector:NSSelectorFromString(@"setEnabled:")]) ((void (*)(id, SEL, BOOL))objc_msgSend)(bm, NSSelectorFromString(@"setEnabled:"), on);
            DMLog([NSString stringWithFormat:@"[btkb] Bluetooth switched %@", on ? @"on" : @"off"]);
            return;
        }
        for (id d in paired) {
            NSString *name = [d respondsToSelector:NSSelectorFromString(@"name")] ? DMCall(d, @"name") : @"?";
            unsigned major = [d respondsToSelector:NSSelectorFromString(@"majorClass")] ? ((unsigned (*)(id, SEL))objc_msgSend)(d, NSSelectorFromString(@"majorClass")) : 0;
            unsigned minor = [d respondsToSelector:NSSelectorFromString(@"minorClass")] ? ((unsigned (*)(id, SEL))objc_msgSend)(d, NSSelectorFromString(@"minorClass")) : 0;
            BOOL conn = [d respondsToSelector:NSSelectorFromString(@"connected")] ? ((BOOL (*)(id, SEL))objc_msgSend)(d, NSSelectorFromString(@"connected")) : NO;
            BOOL keyboard = (major == 0x500 && (minor & 0x40)) || [name.lowercaseString containsString:@"keyboard"];
            DMLog([NSString stringWithFormat:@"[btkb] %@ major 0x%x minor 0x%x connected %d keyboard %d", name, major, minor, conn, keyboard]);
            if (!keyboard) continue;
            if ([what isEqualToString:@"off"] && conn && [d respondsToSelector:NSSelectorFromString(@"disconnect")]) { ((void (*)(id, SEL))objc_msgSend)(d, NSSelectorFromString(@"disconnect")); DMLog([NSString stringWithFormat:@"[btkb] disconnecting %@", name]); }
            if ([what isEqualToString:@"on"] && !conn && [d respondsToSelector:NSSelectorFromString(@"connect")]) { ((void (*)(id, SEL))objc_msgSend)(d, NSSelectorFromString(@"connect")); DMLog([NSString stringWithFormat:@"[btkb] connecting %@", name]); }
        }
        if (!paired.count) DMLog(@"[btkb] BluetoothManager not available (or no devices)");
    }
    else if ([cmd hasPrefix:@"focusapp_"]) {   // focusapp_<bundle>: ask that app (its MacAppBridge, debug build) to focus a text field, so its keyboard comes up without a touch
        NSString *b = [cmd substringFromIndex:9];
        uint32_t hash = 2166136261u; for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
        char name[64]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.focus.%08x", hash);
        notify_post(name);
        DMLog([NSString stringWithFormat:@"[debug] focus asked of %@", b]);
    }
    else if ([cmd isEqualToString:@"swaphalfprompt"]) DMSwapHalfWithQuarter();   // the chooser overlay
    else if ([cmd hasPrefix:@"swapwin_"]) DMSwapWindows([[cmd substringFromIndex:8] isEqualToString:@"h"]);   // swapwin_h / swapwin_v: Swap Left and Right / Top and Bottom
    else if ([cmd hasPrefix:@"swaphalf_"] && DMSMEngine()) {   // (Stage Manager engine)
        NSString *hb = nil, *hs = nil; NSArray *qb = nil, *qs = nil; NSInteger i = [[cmd substringFromIndex:9] integerValue];
        if (DMSMHalfQuarterPlan(&hb, &hs, &qb, &qs) && i >= 0 && i < 2) DMSMApplyLayouts(@{hb: qs[i], qb[i]: hs}); else DMLog(@"[window] no half + two quarters to swap");
    }
    else if ([cmd hasPrefix:@"swaphalf_"]) {   // swaphalf_<0|1>: swap the half with that quarter at once
        UIView *half = nil; NSString *halfSlot = nil; NSArray<UIView *> *quarters = nil; NSArray<NSString *> *slots = nil;
        NSInteger i = [[cmd substringFromIndex:9] integerValue];
        if (DMHalfQuarterPlan(&half, &halfSlot, &quarters, &slots) && i >= 0 && i < 2) DMApplyHalfQuarterSwap(half, halfSlot, quarters[i], slots[i]); else DMLog(@"[window] no half + two quarters to swap");
    }
    else if ([cmd hasPrefix:@"simtouch_"]) {   // simtouch_<bundle>: simulate that app posting "touched" to SpringBoard (the debug MacAppBridge trigger only goes the other way)
        DMRaiseStageForBundle([cmd substringFromIndex:9]);
    }
    else if ([cmd hasPrefix:@"bridge_"]) {   // bridge_<action>_<bundle>: post "com.besiktasliseba.appbridge.<action>.<hash>" (debug bridge actions: traits, tap, focus, ...)
        NSRange us = [cmd rangeOfString:@"_" options:0 range:NSMakeRange(7, cmd.length - 7)];
        if (us.location != NSNotFound) {
            NSString *action = [cmd substringWithRange:NSMakeRange(7, us.location - 7)], *b = [cmd substringFromIndex:us.location + 1];
            uint32_t hash = 2166136261u; for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
            char name[96]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.%s.%08x", action.UTF8String, hash);
            notify_post(name);
            DMLog([NSString stringWithFormat:@"[debug] bridge %@ asked of %@", action, b]);
        }
    }
    else if ([cmd hasPrefix:@"ctxmenutest2_"]) {   // ctxmenutest2_<bundle>: like ctxmenutest_ but calls the OTHER context-menu delegate method,
        // -contextMenuInteraction:configurationForMenuAtLocation: (the one that BUILDS the base UIContextMenuConfiguration, vs. overrideSuggestedActionsForConfiguration:
        // which only edits an already-built one) -- read-only, same real-hook-chain-without-a-touch technique as ctxmenutest_, investigating which of the
        // two methods Zetsu's own Home Screen icon hook actually lives on.
        NSString *bundleID = [cmd substringFromIndex:13];
        Class iconViewClass = objc_getClass("SBIconView");
        Class dockWindowClass = objc_getClass("SBFloatingDockWindow");
        SEL iconSel = NSSelectorFromString(@"icon");
        NSMutableArray<UIView *> *matches = [NSMutableArray array];
        NSMutableArray<NSString *> *matchWindows = [NSMutableArray array];
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                [stack addObjectsFromArray:v.subviews];
                if (!iconViewClass || ![v isKindOfClass:iconViewClass] || ![v respondsToSelector:iconSel]) continue;
                id icon = ((id (*)(id, SEL))objc_msgSend)(v, iconSel);
                for (NSString *idKey in @[@"bundleIdentifier", @"applicationBundleID", @"leafIdentifier"]) {
                    if (![icon respondsToSelector:NSSelectorFromString(idKey)]) continue;
                    NSString *val = [icon valueForKey:idKey];
                    if ([val isEqualToString:bundleID]) { [matches addObject:v]; [matchWindows addObject:NSStringFromClass([w class])]; break; }
                }
            }
        }
        if (!matches.count) { DMLog([NSString stringWithFormat:@"[ctxmenutest2] %@: no live SBIconView found anywhere", bundleID]); }
        else {
            DMLog([NSString stringWithFormat:@"[ctxmenutest2] %@: found %lu icon view(s) in windows: %@", bundleID, (unsigned long)matches.count, [matchWindows componentsJoinedByString:@", "]]);
            SEL sel = NSSelectorFromString(@"contextMenuInteraction:configurationForMenuAtLocation:");
            for (NSUInteger i = 0; i < matches.count; i++) {
                UIView *found = matches[i];
                BOOL isDock = dockWindowClass && [found.window isKindOfClass:dockWindowClass];
                if (![found respondsToSelector:sel]) { DMLog([NSString stringWithFormat:@"[ctxmenutest2]   [%@]%@ does not respond to the selector", matchWindows[i], isDock ? @" (DOCK)" : @""]); continue; }
                id result = ((id (*)(id, SEL, id, CGPoint))objc_msgSend)(found, sel, nil, CGPointZero);
                DMLog([NSString stringWithFormat:@"[ctxmenutest2]   [%@]%@ result %@ class=%@", matchWindows[i], isDock ? @" (DOCK)" : @"", result, result ? NSStringFromClass([result class]) : @"nil"]);
                if ([result respondsToSelector:@selector(identifier)]) DMLog([NSString stringWithFormat:@"[ctxmenutest2]     identifier=%@", [result valueForKey:@"identifier"]]);
                // The identifier/description alone never shows the actual menu: that only exists inside the configuration's own `actionProvider`
                // block (public UIContextMenuConfiguration API since iOS 13), which builds the real UIMenu lazily. Calling it ourselves with an
                // empty suggested-elements array is the same as what UIKit itself would do right before presenting -- read-only, no alloc/init of
                // anything private: `actionProvider` is a public property, invoking a block we were already handed, and any UIMenu/UIAction the
                // block builds are ordinary public UIKit factory objects.
                if ([result respondsToSelector:NSSelectorFromString(@"actionProvider")]) {
                    UIContextMenuActionProvider provider = [result valueForKey:@"actionProvider"];
                    if (provider) {
                        UIMenu *menu = provider(@[]);
                        void (^dump)(UIMenu *, int) = nil;
                        __block void (^dumpRef)(UIMenu *, int) = nil;
                        dump = ^(UIMenu *m, int depth) {
                            DMLog([NSString stringWithFormat:@"[ctxmenutest2]     %*sUIMenu title=\"%@\" identifier=%@ options=%lu", depth * 2, "", m.title, m.identifier, (unsigned long)m.options]);
                            for (id el in m.children) {
                                if ([el isKindOfClass:[UIMenu class]]) { dumpRef(el, depth + 1); continue; }
                                NSString *title = [el respondsToSelector:@selector(title)] ? [el valueForKey:@"title"] : @"?";
                                NSString *subtitle = [el respondsToSelector:NSSelectorFromString(@"subtitle")] ? [el valueForKey:@"subtitle"] : nil;
                                NSInteger attrs = [el respondsToSelector:@selector(attributes)] ? [[el valueForKey:@"attributes"] integerValue] : -1;
                                DMLog([NSString stringWithFormat:@"[ctxmenutest2]       %*s- %@ title=\"%@\" subtitle=%@ attributes=%ld", depth * 2, "", NSStringFromClass([el class]), title, subtitle, (long)attrs]);
                            }
                        };
                        dumpRef = dump;
                        if (menu) dump(menu, 0); else DMLog(@"[ctxmenutest2]     actionProvider returned nil for an empty suggested-elements array");
                    } else DMLog(@"[ctxmenutest2]     actionProvider is nil");
                }
            }
        }
    }
    else if ([cmd isEqualToString:@"zflexscale"]) {   // DIAG: scale the front Zetsu window's content the way Zetsu does (the watcher puts it back): checks zflexwatch_
        for (UIWindow *w in DMZetsuAllWindows()) {
            if (w.hidden || DMStageMinimized(w)) continue;
            UIView *host = nil; @try { host = [DMZetsuController(w) valueForKey:@"hosts"]; } @catch (id e) {}
            UIView *c = [host isKindOfClass:[UIView class]] ? host.subviews.firstObject : nil;
            if (!c) continue;
            CGSize hs = host.bounds.size;
            c.bounds = CGRectMake(0, 0, 768, 1024); c.transform = CGAffineTransformMakeScale(hs.width / 768.0, hs.height / 1024.0);
            DMLog([NSString stringWithFormat:@"[zflexscale] %@ content scaled", DMZetsuWindowBundle(w)]);
        }
    }
    else if ([cmd hasPrefix:@"zflexwatch_"]) {   // zflexwatch_<seconds>: every display frame, what is really on screen (presentation layers) in each Zetsu window's app area: counts frames where the content is scaled or not the host's size
        double secs = [[cmd substringFromIndex:11] doubleValue]; if (secs <= 0 || secs > 30) secs = 5;
        CFTimeInterval end = CACurrentMediaTime() + secs;
        __block int frames = 0, bad = 0; __block NSMutableString *firstBad = [NSMutableString string];
        DMBlockLink *bl = [DMBlockLink new];
        bl.block = ^BOOL{
            frames++;
            for (UIWindow *w in DMZetsuAllWindows()) {
                if (w.hidden || DMStageMinimized(w)) continue;
                UIView *host = nil; @try { host = [DMZetsuController(w) valueForKey:@"hosts"]; } @catch (id e) {}
                if (![host isKindOfClass:[UIView class]]) continue;
                CALayer *hp = host.layer.presentationLayer ?: host.layer;
                for (UIView *c in host.subviews) {
                    // (an EMPTY picture view draws nothing: while the keyboard is up Zetsu adds a second one, scaled like its full-screen picture,
                    // for the keyboard -- whose host we move out into ZetsuKeyboard -- so it stays empty; counting it made every frame "bad", M1 26 Sep)
                    if (!c.subviews.count && !c.layer.sublayers.count) continue;
                    CALayer *cp = c.layer.presentationLayer ?: c.layer;
                    CGAffineTransform t = CATransform3DGetAffineTransform(cp.transform);
                    CGRect onScreen = CGRectApplyAffineTransform(CGRectMake(-cp.bounds.size.width * cp.anchorPoint.x, -cp.bounds.size.height * cp.anchorPoint.y, cp.bounds.size.width, cp.bounds.size.height), t);
                    onScreen.origin.x += cp.position.x; onScreen.origin.y += cp.position.y;
                    if (frames == 1 && firstBad.length < 400) [firstBad appendFormat:@" (first frame: %lu views, %@ %@ presentation %d)", (unsigned long)host.subviews.count, NSStringFromClass([c class]), NSStringFromCGRect(onScreen), c.layer.presentationLayer != nil];
                    // (Zetsu's scaled picture fills the window too -- bounds 768 x 1024 scaled down -- but the app inside it is laid out at the window's size,
                    // so it shows at a fraction of the window: the content's own bounds must be the window's size and unscaled)
                    Class lhc = objc_getClass("_UIContextLayerHostView");
                    if (lhc) for (UIView *lh in c.subviews) {
                        NSMutableArray *q = [NSMutableArray arrayWithObject:lh];
                        while (q.count) { UIView *x = q.lastObject; [q removeLastObject]; [q addObjectsFromArray:x.subviews];
                            if (![x isKindOfClass:lhc]) continue;
                            CALayer *xp = x.layer.presentationLayer ?: x.layer;
                            if (fabs(xp.bounds.size.width - hp.bounds.size.width) > 1.0 || fabs(xp.bounds.size.height - hp.bounds.size.height) > 1.0) {
                                bad++; if (firstBad.length < 600) [firstBad appendFormat:@" [frame %d layer host %@]", frames, NSStringFromCGSize(xp.bounds.size)];
                            }
                        }
                    }
                    if (!CGAffineTransformIsIdentity(t) || fabs(cp.bounds.size.width - hp.bounds.size.width) > 1.0 || fabs(cp.bounds.size.height - hp.bounds.size.height) > 1.0 || fabs(onScreen.origin.x) > 1.0 || fabs(onScreen.origin.y) > 1.0) {
                        bad++;
                        if (firstBad.length < 400) [firstBad appendFormat:@" [frame %d %@: %@ in %@]", frames, DMZetsuWindowBundle(w), NSStringFromCGRect(onScreen), NSStringFromCGSize(hp.bounds.size)];
                    }
                }
            }
            if (CACurrentMediaTime() < end) return YES;
            DMLog([NSString stringWithFormat:@"[zflexwatch] %d display frames, %d with a Zetsu app area not filling its window%@", frames, bad, firstBad]);
            return NO;
        };
        [bl start];
        DMLog([NSString stringWithFormat:@"[zflexwatch] watching %.0f s", secs]);
    }
    else if ([cmd hasPrefix:@"zetsuframe_"]) {   // zetsuframe_<w>_<h>: sets the live ZetsuWindow's frame to that size (origin kept), to test whether
        // Zetsu recomputes its own content scale transform to fit the new size (investigating the "looks weird/low-res" report -- its content is
        // rendered full native size then non-uniformly scaled to fit the window, confirmed via wintree_ZetsuWindow; testing whether a window sized
        // to the content's own native aspect ratio makes that scale uniform instead of stretching). Plain public frame property, no alloc/init.
        NSArray *q = [[cmd substringFromIndex:11] componentsSeparatedByString:@"_"];
        Class c = objc_getClass("ZetsuWindow");
        UIWindow *found = nil;
        if (c && q.count >= 2) for (UIWindow *w in DMAllWindows()) if ([w isKindOfClass:c] && !w.hidden) found = w;
        if (!found) { DMLog(@"[zetsuframe] no live visible ZetsuWindow found"); }
        else {
            CGRect f = found.frame;
            CGFloat newW = [q[0] doubleValue], newH = [q[1] doubleValue];
            found.frame = CGRectMake(f.origin.x, f.origin.y, newW, newH);
            DMLog([NSString stringWithFormat:@"[zetsuframe] resized %@ -> %@", NSStringFromCGRect(f), NSStringFromCGRect(found.frame)]);
        }
    }
    else if ([cmd hasPrefix:@"zetsuresize_"]) {   // REMOVED: it drove ZetsuAppController -ZetsuResizeAction: with a scripted DMFakePan, and that
        // CRASHED SpringBoard (2026-09-23, SIGABRT inside Zetsu's own CardShrink(ZetsuWindow*, bool): +[NSArray arrayWithObjects:count:] with a nil
        // object -- Zetsu reads something from the gesture/touch that a fake pan does not have). Never call Zetsu's resize handler from outside;
        // DMZetsuSetFrame resizes a Zetsu window from outside instead (window frame + content scale).
        DMLog(@"[zetsuresize] removed: it crashed SpringBoard inside Zetsu (see the source)");
    }
    else if ([cmd hasPrefix:@"zetsulaunch_"]) {   // zetsulaunch_<bundle>: open that app in a Zetsu window via Zetsu's own shortcut type
        DMZetsuLaunch([cmd substringFromIndex:12]);
    }
    else if ([cmd hasPrefix:@"zlight_"]) {   // zlight_<0|1|2>: the front Zetsu window's own red / yellow / green (what its title-bar buttons call)
        UIView *top = DMTopStage();
        if (!DMIsZetsuWindow(top)) DMLog(@"[zlight] no Zetsu window in front");
        else DMStageLightAction(top, [[cmd substringFromIndex:7] integerValue]);
    }
    else if ([cmd isEqualToString:@"zorient"]) {   // zorient: the screen's, the device's and each ZetsuWindow's orientation (+ the status bar over a game)
        id app = [UIApplication sharedApplication];
        NSMutableString *out = [NSMutableString stringWithFormat:@"[zorient] screen %ld (real %ld), device %ld, bar over %@;",
            ((long (*)(id, SEL))objc_msgSend)(app, NSSelectorFromString(@"activeInterfaceOrientation")), DMRealInterfaceOrientation(),
            (long)[UIDevice currentDevice].orientation, gBarOverHidingApp ?: @"-"];
        for (UIWindow *w in DMZetsuAllWindows()) [out appendFormat:@" %@ %ld hidden %d frame %@;", DMZetsuWindowBundle(w),
            [w respondsToSelector:NSSelectorFromString(@"_windowInterfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(w, NSSelectorFromString(@"_windowInterfaceOrientation")) : -1L,
            w.hidden, NSStringFromCGRect(w.frame)];
        DMLog(out);
    }
    else if ([cmd isEqualToString:@"zetsuinfo"]) {   // zetsuinfo: every ZetsuWindow (shown or not), back to front, with its state
        NSMutableString *out = [NSMutableString stringWithFormat:@"[zetsuinfo] installed %d, engine %d, order %@, top stage %@, windows own bar %d, windows:", DMZetsuInstalled(), (int)DMActiveEngine(),
            [gZetsuOrder componentsJoinedByString:@" < "], DMStageBundle(DMTopStage()), DMWindowsOwnStatusBar()];
        for (UIWindow *w in DMZetsuAllWindows()) {
            [out appendFormat:@"\n  %@", DMZetsuDescribe(w)];
            NSMutableArray *views = [NSMutableArray arrayWithObject:w];
            while (views.count) {
                UIView *v = views.lastObject; [views removeLastObject];
                [views addObjectsFromArray:v.subviews];
                for (UIGestureRecognizer *g in v.gestureRecognizers) [out appendFormat:@"\n    gesture on %@: %@", NSStringFromClass([v class]), g.description];
            }
        }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"impof_"]) {   // impof_<Class>_<selector>: where that method's code is (image + offset), for reading it in a disassembly -- read-only
        NSString *rest = [cmd substringFromIndex:6];
        NSRange r = [rest rangeOfString:@"_"];
        Class c = r.location != NSNotFound ? objc_getClass([[rest substringToIndex:r.location] UTF8String]) : Nil;
        SEL sel = r.location != NSNotFound ? NSSelectorFromString([rest substringFromIndex:r.location + 1]) : NULL;
        Method m = c && sel ? class_getInstanceMethod(c, sel) : NULL;
        if (!m && c && sel) m = class_getClassMethod(c, sel);
        IMP imp = m ? method_getImplementation(m) : NULL;
        Dl_info info; memset(&info, 0, sizeof info);
        if (imp) dladdr((const void *)imp, &info);
        DMLog([NSString stringWithFormat:@"[impof] %@: imp %p image %s offset 0x%lx", rest, imp, info.dli_fname ?: "?", imp && info.dli_fbase ? (unsigned long)((uintptr_t)imp - (uintptr_t)info.dli_fbase) : 0UL]);
    }
    else if ([cmd hasPrefix:@"iconinfo_"]) {   // iconinfo_<bundle>: every icon view of that app: where it is, its label accessory (iOS's beta/updated dot) and its small subviews (read-only)
        NSString *bundleID = [cmd substringFromIndex:9];
        Class iconViewClass = objc_getClass("SBIconView");
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                if (![v isKindOfClass:iconViewClass]) { [stack addObjectsFromArray:v.subviews]; continue; }
                id icon = [v respondsToSelector:NSSelectorFromString(@"icon")] ? DMCall(v, @"icon") : nil;
                NSString *bid = nil; @try { bid = [icon valueForKey:@"applicationBundleID"]; } @catch (id e) {}
                if (![bid isEqual:bundleID]) continue;
                long long cur = -1, shown = -1; BOOL allows = NO, hiddenAcc = NO;
                if ([v respondsToSelector:NSSelectorFromString(@"currentLabelAccessoryType")]) cur = ((long long (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"currentLabelAccessoryType"));
                if ([v respondsToSelector:NSSelectorFromString(@"displayedLabelAccessoryType")]) shown = ((long long (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"displayedLabelAccessoryType"));
                if ([v respondsToSelector:NSSelectorFromString(@"allowsLabelAccessoryView")]) allows = ((BOOL (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"allowsLabelAccessoryView"));
                if ([v respondsToSelector:NSSelectorFromString(@"isLabelAccessoryHidden")]) hiddenAcc = ((BOOL (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"isLabelAccessoryHidden"));
                NSMutableString *subs = [NSMutableString string];
                NSMutableArray *st2 = [NSMutableArray arrayWithArray:v.subviews];
                while (st2.count) {
                    UIView *u = st2.firstObject; [st2 removeObjectAtIndex:0];
                    [st2 addObjectsFromArray:u.subviews];
                    if (u.bounds.size.width > 30.0 && u.bounds.size.height > 30.0) continue;   // (small views only: dots, badges)
                    CGRect r = [u convertRect:u.bounds toView:v];
                    [subs appendFormat:@" | %@ %@ hidden %d alpha %.2f bg %@", NSStringFromClass([u class]), NSStringFromCGRect(r), u.hidden, u.alpha, u.backgroundColor];
                }
                id loc = nil; @try { loc = [v valueForKey:@"location"]; } @catch (id e) {}
                BOOL should = [v respondsToSelector:NSSelectorFromString(@"shouldShowLabelAccessoryView")] && ((BOOL (*)(id, SEL))objc_msgSend)(v, NSSelectorFromString(@"shouldShowLabelAccessoryView"));
                Method sm = class_getInstanceMethod([v class], NSSelectorFromString(@"shouldShowLabelAccessoryView")); Dl_info di = {0};
                if (sm) dladdr(ptrauth_strip((void *)method_getImplementation(sm), ptrauth_key_function_pointer), &di);
                DMLog([NSString stringWithFormat:@"[iconinfo] location %@, shouldShow %d (implemented in %s)", loc, should, di.dli_fname ?: "?"]);
                DMLog([NSString stringWithFormat:@"[iconinfo] %@ in %@ at %@ (window %@): label accessory current %lld displayed %lld allows %d hidden %d; small subviews:%@", bid, NSStringFromClass([v.superview class]), NSStringFromCGRect([v convertRect:v.bounds toView:nil]), NSStringFromClass([w class]), cur, shown, allows, hiddenAcc, subs]);
            }
        }
        DMLog(@"[iconinfo] done");
    }
    else if ([cmd hasPrefix:@"iconmenu_"] || [cmd hasPrefix:@"iconaction_"]) {   // iconmenu_<bundle>: titles in that app icon's long-press menu; iconaction_<bundle>_<Title-With-Dashes>: run that item's own handler (what a finger tap runs)
        BOOL run = [cmd hasPrefix:@"iconaction_"];
        NSString *rest = [cmd substringFromIndex:run ? 11 : 9];
        NSString *bundleID = rest, *title = nil;
        if (run) { NSRange us = [rest rangeOfString:@"_"]; if (us.location == NSNotFound) return; bundleID = [rest substringToIndex:us.location]; title = [[rest substringFromIndex:us.location + 1] stringByReplacingOccurrencesOfString:@"-" withString:@" "]; }
        Class iconViewClass = objc_getClass("SBIconView");
        SEL iconSel = NSSelectorFromString(@"icon");
        NSMutableArray<UIView *> *cands = [NSMutableArray array];
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                [stack addObjectsFromArray:v.subviews];
                if (!iconViewClass || ![v isKindOfClass:iconViewClass] || ![v respondsToSelector:iconSel] || !v.window) continue;
                id icon = ((id (*)(id, SEL))objc_msgSend)(v, iconSel);
                for (NSString *idKey in @[@"bundleIdentifier", @"applicationBundleID", @"leafIdentifier"])
                    if ([icon respondsToSelector:NSSelectorFromString(idKey)] && [[icon valueForKey:idKey] isEqual:bundleID]) { [cands addObject:v]; break; }
            }
        }
        UIView *found = nil; UIMenu *menu = nil;
        SEL sel = NSSelectorFromString(@"contextMenuInteraction:configurationForMenuAtLocation:");
        for (UIView *v in cands) {   // several copies of an icon can exist (Home Screen, Dock, App Library): the first one with a real menu
            id result = [v respondsToSelector:sel] ? ((id (*)(id, SEL, id, CGPoint))objc_msgSend)(v, sel, nil, CGPointZero) : nil;
            UIContextMenuActionProvider provider = [result respondsToSelector:NSSelectorFromString(@"actionProvider")] ? [result valueForKey:@"actionProvider"] : nil;
            UIMenu *m = provider ? provider(@[]) : nil;
            SEL endSel = NSSelectorFromString(@"contextMenuInteraction:willEndForConfiguration:animator:");   // as when a menu closes: otherwise the icon thinks its menu is still up and returns none next time
            if (result && [v respondsToSelector:endSel]) ((void (*)(id, SEL, id, id, id))objc_msgSend)(v, endSel, nil, result, nil);
            if (m.children.count) { found = v; menu = m; break; }
        }
        if (!found) { DMLog([NSString stringWithFormat:@"[iconmenu] %@: no icon view with a menu (%lu copies)", bundleID, (unsigned long)cands.count]); return; }
        NSMutableArray *titles = [NSMutableArray array];
        __block UIAction *hit = nil;
        __block void (^walk)(UIMenu *) = nil;
        void (^walker)(UIMenu *) = ^(UIMenu *m) {
            for (id el in m.children) {
                if ([el isKindOfClass:[UIMenu class]]) { walk(el); continue; }
                NSString *t = [el respondsToSelector:@selector(title)] ? [el valueForKey:@"title"] : nil;
                if (t && [el isKindOfClass:[UIAction class]]) {   // who made it: the image its handler block's code lives in
                    id h = nil; @try { h = [el valueForKey:@"handler"]; } @catch (id e) {}
                    struct { void *isa; int flags; int reserved; void *invoke; } *blk = (__bridge void *)h;
                    Dl_info di; const char *img = (blk && blk->invoke && dladdr(blk->invoke, &di) && di.dli_fname) ? strrchr(di.dli_fname, '/') : NULL;
                    [titles addObject:[NSString stringWithFormat:@"%@ [%s]", t, img ? img + 1 : "?"]];
                } else if (t) [titles addObject:t];
                if (title && [t isEqualToString:title] && [el isKindOfClass:[UIAction class]]) hit = el;
            }
        };
        walk = walker;
        if (menu) walker(menu);
        DMLog([NSString stringWithFormat:@"[iconmenu] %@ (%@): %@", bundleID, NSStringFromClass([found class]), [titles componentsJoinedByString:@" | "]]);
        if ([found respondsToSelector:NSSelectorFromString(@"applicationShortcutItems")]) {   // the shortcut items behind them: type and title
            NSMutableArray *its = [NSMutableArray array];
            for (id it in (DMCall(found, @"applicationShortcutItems") ?: @[])) [its addObject:[NSString stringWithFormat:@"%@ = \"%@\"", DMCall(it, @"type"), DMCall(it, @"localizedTitle")]];
            DMLog([NSString stringWithFormat:@"[iconmenu] shortcut items: %@", [its componentsJoinedByString:@" | "]]);
        }
        if (run) {
            UIActionHandler handler = hit ? [hit valueForKey:@"handler"] : nil;
            DMLog([NSString stringWithFormat:@"[iconmenu] running \"%@\": %@", title, handler ? @"found" : @"NOT found"]);
            if (handler) handler(hit);
        }
    }
    else if ([cmd hasPrefix:@"openapp_"]) DMOpenApp([cmd substringFromIndex:8]);   // openapp_<bundle>: open an app the way our menus do (debug)
    else if ([cmd hasPrefix:@"fopen_"]) [DMFinderFront() dm_openNamed:[cmd substringFromIndex:6]];   // fopen_<name>: open that item in the front Finder window, as a double click (debug)
    else if ([cmd isEqualToString:@"fview"]) [DMFinderFront() dm_toggleView];
    else if ([cmd hasPrefix:@"fdo_"]) [DMFinderFront() dm_debugDo:[cmd substringFromIndex:4]];   // fdo_<action>[:<arg>]: a file operation in the front Finder window (Finder.h -dm_debugDo:)
    else if ([cmd isEqualToString:@"fdump"]) [DMFinderFront() dm_dump];
    else if ([cmd hasPrefix:@"fshare_"]) [DMFinderFront() dm_shareNamed:[cmd substringFromIndex:7]];   // fshare_<name>: Share… for that item in the front Finder window (debug)
    else if ([cmd isEqualToString:@"fdismiss"]) [gNativeLayer.rootViewController dismissViewControllerAnimated:YES completion:nil];   // fdismiss: close what is presented over Finder (debug)   // fview: List <-> Icons in the front Finder window (debug)
    else if ([cmd hasPrefix:@"fnew_"]) DMFinderOpen([cmd substringFromIndex:5], YES);   // fnew_<path>: a new Finder window (debug)
#if DEBUG
    else if ([cmd hasPrefix:@"deskpref_"]) {   // deskpref_<0|1>: Show Desktop Icons off / on, as the Settings switch does
        CFPreferencesSetValue(CFSTR("desktopIcons"), [[cmd substringFromIndex:9] boolValue] ? kCFBooleanTrue : kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        notify_post("com.besiktasliseba.macstatusbar.finder.pref");
    }
    else if ([cmd hasPrefix:@"text_"]) {   // text_open:<path> | text_type:<text> | text_save | text_state | text_close: the front text window (debug)
        NSString *a = [cmd substringFromIndex:5]; DMTextWindow *tw = nil;
        for (DMNativeWindow *w in [gNativeWindows reverseObjectEnumerator]) if ([w isKindOfClass:[DMTextWindow class]]) { tw = (DMTextWindow *)w; break; }
        if ([a hasPrefix:@"open:"]) DMLog([NSString stringWithFormat:@"[text] test open: %d", DMTextWindowOpen([a substringFromIndex:5], ^{ DMLog(@"[text] test open: not a text file for the window"); })]);
        else if ([a hasPrefix:@"type:"]) [tw dm_debugType:[a substringFromIndex:5]];
        else if ([a isEqualToString:@"save"]) [tw dm_save];
        else if ([a isEqualToString:@"close"]) [tw close];
        else DMLog([NSString stringWithFormat:@"[text] test state: %@", tw ? [tw dm_debugState] : @"no text window"]);
    }
    else if ([cmd hasPrefix:@"desk_"]) { if (gDesktop) [gDesktop dm_debug:[cmd substringFromIndex:5]]; else DMLog(@"[desktop] test: no desktop"); }   // desk_<what>[:<arg>]: Desktop.h -dm_debug:
    else if ([cmd hasPrefix:@"fdlicon_"]) {   // fdlicon_<x>_<y>: is the Dock's Downloads stack a drop target at that screen point (Finder.h DMFDDownloadsIconAt)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        CGPoint sp = q.count >= 2 ? CGPointMake([q[0] doubleValue], [q[1] doubleValue]) : CGPointZero;
        Class c = NSClassFromString(@"DMDownloadsIconView");
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *todo = [NSMutableArray arrayWithObject:w];
            while (todo.count) { UIView *v = todo.lastObject; [todo removeLastObject]; [todo addObjectsFromArray:v.subviews];
                if (c && [v isKindOfClass:c]) DMLog([NSString stringWithFormat:@"[finder] test: stack icon in %@ (hidden %d alpha %.2f, window hidden %d) at %@", NSStringFromClass([w class]), v.hidden, v.alpha, w.hidden, NSStringFromCGRect([v convertRect:v.bounds toCoordinateSpace:w.screen.coordinateSpace])]); }
        }
        UIView *icon = DMFDDownloadsIconAt(sp);
        DMLog([NSString stringWithFormat:@"[finder] test: Downloads stack at %@: %@, folder %@", NSStringFromCGPoint(sp), icon ? @"yes" : @"no", icon ? (DMFDIconFolder(icon) ? @"named" : @"none") : @"-"]);
    }
#endif
    else if ([cmd hasPrefix:@"fwin"]) {   // fwin / fwin_<path>: a Finder window (debug)
        NSString *p = cmd.length > 5 ? [cmd substringFromIndex:5] : nil;
        DMFinderOpen(p, NO);
    }
    else if ([cmd hasPrefix:@"memdump_"]) {   // memdump_<image name suffix>_<hex offset>_<len> or memdump_@_<hex address>_<len>: copy loaded bytes to /tmp/msb-mem.bin (read-only; for offline disassembly)
        NSArray *q = [[cmd substringFromIndex:8] componentsSeparatedByString:@"_"];
        if (q.count < 3) return;
        uintptr_t base = 0;
        if (![q[0] isEqualToString:@"@"]) {
            for (uint32_t i = 0; i < _dyld_image_count(); i++) {
                const char *n = _dyld_get_image_name(i);
                if (n && [[NSString stringWithUTF8String:n] hasSuffix:[@"/" stringByAppendingString:q[0]]]) { base = (uintptr_t)_dyld_get_image_header(i); break; }
            }
            if (!base) { DMLog([NSString stringWithFormat:@"[memdump] image %@ not found", q[0]]); return; }
        }
        unsigned long long off = strtoull([q[1] UTF8String], NULL, 16);
        NSUInteger len = MIN((NSUInteger)[q[2] integerValue], (NSUInteger)65536);
        const void *p = (const void *)(base + (uintptr_t)off);
        Dl_info info; memset(&info, 0, sizeof info); dladdr(p, &info);
        if (!info.dli_fbase) { DMLog(@"[memdump] address is not inside a loaded image, refused"); return; }
        NSMutableData *md = [NSMutableData dataWithLength:len];
        if (!DMSafeRead((uintptr_t)p, md.mutableBytes, len)) { DMLog(@"[memdump] those bytes are not all readable, refused"); return; }
        [md writeToFile:@"/tmp/msb-mem.bin" atomically:NO];
        DMLog([NSString stringWithFormat:@"[memdump] %lu bytes at %p (image %s base %p, image offset 0x%lx, symbol %s)", (unsigned long)len, p, info.dli_fname, info.dli_fbase, (unsigned long)((uintptr_t)p - (uintptr_t)info.dli_fbase), info.dli_sname ?: "?"]);
    }
    else if ([cmd hasPrefix:@"decode_"]) {   // decode_<hex address>_<instruction count>: names what arm64 code references (selector stubs, class refs, strings) -- read-only, for reverse engineering
        NSArray *q = [[cmd substringFromIndex:7] componentsSeparatedByString:@"_"];   // decode_<hex address>_<n> or decode_<image name>_<hex offset>_<n>
        if (q.count < 2) return;
        uintptr_t start = (uintptr_t)strtoull([q[0] UTF8String], NULL, 16);
        if (q.count >= 3) {
            start = 0;
            for (uint32_t i = 0; i < _dyld_image_count(); i++) {
                const char *n = _dyld_get_image_name(i);
                if (n && [[NSString stringWithUTF8String:n] hasSuffix:[@"/" stringByAppendingString:q[0]]]) { start = (uintptr_t)_dyld_get_image_header(i) + (uintptr_t)strtoull([q[1] UTF8String], NULL, 16); break; }
            }
            if (!start) { DMLog(@"[decode] image not found"); return; }
            q = @[q[0], q[2]];
        }
        int count = MIN([q[1] intValue], 400);
        Dl_info si; memset(&si, 0, sizeof si);
        if (!dladdr((const void *)start, &si) || !si.dli_fbase) { DMLog(@"[decode] not inside an image, refused"); return; }
        uintptr_t regPage[32] = {0};
        NSString *(^describe)(uintptr_t) = ^NSString *(uintptr_t a) {
            Dl_info d; memset(&d, 0, sizeof d);
            if (!a || !dladdr((const void *)a, &d)) return @"(unmapped)";
            NSMutableString *s = [NSMutableString stringWithFormat:@"%s+0x%lx", d.dli_sname ?: "?", (unsigned long)(a - (uintptr_t)d.dli_saddr)];
            char c[64] = {0}; int ok = DMSafeRead(a, c, 60) || DMSafeRead(a, c, 8), n = 0;   // (copied through the kernel: an unmapped address is just "not a string")
            for (; ok && n < 60 && c[n]; n++) if (c[n] < 32 || c[n] > 126) { ok = 0; break; }
            if (ok && n > 2) [s appendFormat:@" str\"%.*s\"", n, c];
            return s;
        };
        NSMutableString *out = [NSMutableString stringWithFormat:@"[decode] %p (%s):", (void *)start, si.dli_fname];
        for (int i = 0; i < count; i++) {
            uintptr_t pc = start + 4 * i;
            uint32_t ins = 0;
            if (!DMSafeRead(pc, &ins, 4)) { [out appendFormat:@"\n  %lx: (unreadable)", (unsigned long)(pc - (uintptr_t)si.dli_fbase)]; break; }
            if ((ins & 0x9F000000) == 0x90000000) {   // adrp
                int rd = ins & 31; int64_t imm = ((int64_t)((ins >> 5) & 0x7FFFF) << 2) | ((ins >> 29) & 3);
                if (imm & (1LL << 20)) imm -= (1LL << 21);
                regPage[rd] = (pc & ~(uintptr_t)0xFFF) + (uintptr_t)(imm << 12);
            } else if ((ins & 0xFFC00000) == 0xF9400000) {   // ldr xT, [xN, #imm]
                int rn = (ins >> 5) & 31; uintptr_t a = regPage[rn] + ((ins >> 10) & 0xFFF) * 8;
                if (regPage[rn]) {
                    uintptr_t v = 0; DMSafeRead(a, &v, sizeof v);
                    [out appendFormat:@"\n  %lx: ldr x%d [%@] -> 0x%lx %@", (unsigned long)(pc - (uintptr_t)si.dli_fbase), (int)(ins & 31), describe(a), (unsigned long)v, v < 0x100000 ? @"" : describe(v)];
                }
            } else if ((ins & 0xFFC00000) == 0xB9800000 || (ins & 0xFFC00000) == 0xB9400000) {   // ldrsw / ldr w, [xN, #imm] (ivar offsets are 32-bit)
                int rn = (ins >> 5) & 31; uintptr_t a = regPage[rn] + ((ins >> 10) & 0xFFF) * 4;
                if (regPage[rn]) [out appendFormat:@"\n  %lx: ldr32 w%d [%@] -> %d", (unsigned long)(pc - (uintptr_t)si.dli_fbase), (int)(ins & 31), describe(a), ({ int32_t w = 0; DMSafeRead(a, &w, 4); w; })];
            } else if ((ins & 0xFFC00000) == 0x91000000) {   // add xD, xN, #imm
                int rn = (ins >> 5) & 31; uintptr_t a = regPage[rn] + ((ins >> 10) & 0xFFF);
                if (regPage[rn]) {
                    NSString *extra = @"";
                    Dl_info d2; memset(&d2, 0, sizeof d2);
                    if (dladdr((const void *)a, &d2)) { uintptr_t cstr = 0; DMSafeRead(a + 16, &cstr, sizeof cstr); Dl_info d3; memset(&d3, 0, sizeof d3); if (cstr && dladdr((const void *)cstr, &d3)) extra = [@" cfstr? " stringByAppendingString:describe(cstr)]; }
                    [out appendFormat:@"\n  %lx: add -> %@%@", (unsigned long)(pc - (uintptr_t)si.dli_fbase), describe(a), extra];
                    regPage[rn] = 0;
                }
            } else if ((ins & 0xFC000000) == 0x94000000 || (ins & 0xFC000000) == 0x14000000) {   // bl / b
                int64_t imm = ins & 0x3FFFFFF; if (imm & (1 << 25)) imm -= (1 << 26);
                uintptr_t t = pc + (uintptr_t)(imm * 4);
                NSString *what = describe(t);
                uint32_t s0 = 0, s1 = 0; DMSafeRead(t, &s0, 4); DMSafeRead(t + 4, &s1, 4);   // objc_msgSend$sel stub: adrp x1 ; ldr x1, [x1, #off]
                if ((s0 & 0x9F00001F) == 0x90000001 && (s1 & 0xFFC003FF) == 0xF9400021) {
                    int64_t im = ((int64_t)((s0 >> 5) & 0x7FFFF) << 2) | ((s0 >> 29) & 3); if (im & (1LL << 20)) im -= (1LL << 21);
                    uintptr_t selref = (t & ~(uintptr_t)0xFFF) + (uintptr_t)(im << 12) + ((s1 >> 10) & 0xFFF) * 8;
                    uintptr_t selp = 0; char sn[128] = {0};
                    if (DMSafeRead(selref, &selp, sizeof selp) && selp && (DMSafeRead(selp, sn, 127) || DMSafeRead(selp, sn, 32))) what = [NSString stringWithFormat:@"msgSend$%s", sn];
                }
                [out appendFormat:@"\n  %lx: %s %@", (unsigned long)(pc - (uintptr_t)si.dli_fbase), (ins & 0x80000000) ? "bl" : "b", what];
            }
        }
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"zetsuopen_"]) {   // zetsuopen_<bundle>: finds that app's real "Zetsu" Home Screen Haptic Touch action (built the
        // same way ctxmenutest2_ found it) and calls its own `handler` block directly -- `handler` is a plain public, readable UIAction property
        // (UIActionHandler, since iOS 13), so this invokes the EXACT closure UIKit itself would call on a real tap, not a reimplementation of
        // what it does. No alloc/init of anything Zetsu owns; Zetsu's own code does all the window creation, same as when the user taps it.
        NSString *bundleID = [cmd substringFromIndex:10];
        Class iconViewClass = objc_getClass("SBIconView");
        SEL iconSel = NSSelectorFromString(@"icon");
        UIView *found = nil;
        for (UIWindow *w in DMAllWindows()) {
            if ([NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) continue;   // Zetsu's item is Home-Screen-only, confirmed earlier
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count && !found) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                [stack addObjectsFromArray:v.subviews];
                if (!iconViewClass || ![v isKindOfClass:iconViewClass] || ![v respondsToSelector:iconSel]) continue;
                id icon = ((id (*)(id, SEL))objc_msgSend)(v, iconSel);
                for (NSString *idKey in @[@"bundleIdentifier", @"applicationBundleID", @"leafIdentifier"]) {
                    if (![icon respondsToSelector:NSSelectorFromString(idKey)]) continue;
                    if ([[icon valueForKey:idKey] isEqualToString:bundleID]) { found = v; break; }
                }
            }
        }
        if (!found) { DMLog([NSString stringWithFormat:@"[zetsuopen] %@: no live Home Screen SBIconView found", bundleID]); }
        else {
            SEL sel = NSSelectorFromString(@"contextMenuInteraction:configurationForMenuAtLocation:");
            id result = [found respondsToSelector:sel] ? ((id (*)(id, SEL, id, CGPoint))objc_msgSend)(found, sel, nil, CGPointZero) : nil;
            UIContextMenuActionProvider provider = [result respondsToSelector:NSSelectorFromString(@"actionProvider")] ? [result valueForKey:@"actionProvider"] : nil;
            UIMenu *menu = provider ? provider(@[]) : nil;
            __block UIAction *zetsuAction = nil;
            void (^find)(UIMenu *) = nil; __block void (^findRef)(UIMenu *) = nil;
            find = ^(UIMenu *m) {
                for (id el in m.children) {
                    if ([el isKindOfClass:[UIMenu class]]) { findRef(el); continue; }
                    if ([el respondsToSelector:@selector(title)] && [[el valueForKey:@"title"] isEqualToString:@"Zetsu"]) zetsuAction = el;
                }
            };
            findRef = find;
            if (menu) find(menu);
            if (!zetsuAction) { DMLog([NSString stringWithFormat:@"[zetsuopen] %@: no \"Zetsu\" action found in the built menu (menu %@)", bundleID, menu]); }
            else {
                UIActionHandler handler = [zetsuAction valueForKey:@"handler"];
                DMLog([NSString stringWithFormat:@"[zetsuopen] %@: found the Zetsu action, handler %@ -- invoking", bundleID, handler]);
                if (handler) handler(zetsuAction);
            }
        }
    }
    else if ([cmd hasPrefix:@"ctxmenutest_"]) {   // ctxmenutest_<bundle>: directly invokes -_contextMenuInteraction:overrideSuggestedActionsForConfiguration:
        // on a live Home Screen SBIconView for the given bundle, WITHOUT a real touch -- the hook bodies in AppSizeMenu.x/FolderMenu.x never
        // read the interaction/configuration parameters, only `self`, so a direct call exercises the exact same hook chain a real Haptic
        // Touch does (down to Apple's own %orig at the bottom), just skipping UIKit's own menu presentation at the end.
        // BUG FIXED: this used to stop at the FIRST matching icon view found across ALL windows -- for a Dock-only app, SpringBoard can still
        // keep a recycled/cached SBIconView instance around in SBHomeScreenWindow's own hierarchy even though it is never actually shown
        // there, so this could silently test the wrong instance and never really exercise the Dock's own icon view. Now logs which window
        // each candidate was found in, and specifically prefers one found inside SBFloatingDockWindow when testing a Dock app.
        NSString *bundleID = [cmd substringFromIndex:12];
        Class iconViewClass = objc_getClass("SBIconView");
        Class dockWindowClass = objc_getClass("SBFloatingDockWindow");
        SEL iconSel = NSSelectorFromString(@"icon");
        NSMutableArray<UIView *> *matches = [NSMutableArray array];
        NSMutableArray<NSString *> *matchWindows = [NSMutableArray array];
        for (UIWindow *w in DMAllWindows()) {
            NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject];
                [stack addObjectsFromArray:v.subviews];
                if (!iconViewClass || ![v isKindOfClass:iconViewClass] || ![v respondsToSelector:iconSel]) continue;
                id icon = ((id (*)(id, SEL))objc_msgSend)(v, iconSel);
                for (NSString *idKey in @[@"bundleIdentifier", @"applicationBundleID", @"leafIdentifier"]) {
                    if (![icon respondsToSelector:NSSelectorFromString(idKey)]) continue;
                    NSString *val = [icon valueForKey:idKey];
                    if ([val isEqualToString:bundleID]) { [matches addObject:v]; [matchWindows addObject:NSStringFromClass([w class])]; break; }
                }
            }
        }
        if (!matches.count) { DMLog([NSString stringWithFormat:@"[ctxmenutest] %@: no live SBIconView found anywhere", bundleID]); }
        else {
            DMLog([NSString stringWithFormat:@"[ctxmenutest] %@: found %lu icon view(s) in windows: %@", bundleID, (unsigned long)matches.count, [matchWindows componentsJoinedByString:@", "]]);
            SEL sel = @selector(_contextMenuInteraction:overrideSuggestedActionsForConfiguration:);
            for (NSUInteger i = 0; i < matches.count; i++) {
                UIView *found = matches[i];
                BOOL isDock = dockWindowClass && [found.window isKindOfClass:dockWindowClass];
                if (![found respondsToSelector:sel]) { DMLog([NSString stringWithFormat:@"[ctxmenutest]   [%@]%@ does not respond to the selector", matchWindows[i], isDock ? @" (DOCK)" : @""]); continue; }
                id result = ((id (*)(id, SEL, id, id))objc_msgSend)(found, sel, nil, nil);
                NSMutableString *out = [NSMutableString stringWithFormat:@"[ctxmenutest]   [%@]%@ result class=%@", matchWindows[i], isDock ? @" (DOCK)" : @"", NSStringFromClass([result class])];
                if ([result isKindOfClass:[NSArray class]]) {
                    [out appendFormat:@", count=%lu", (unsigned long)[(NSArray *)result count]];
                    for (id item in (NSArray *)result) [out appendFormat:@"\n     - %@ title=%@", NSStringFromClass([item class]), [item respondsToSelector:@selector(title)] ? [item valueForKey:@"title"] : nil];
                }
                DMLog(out);
            }
        }
    }
    else if ([cmd hasPrefix:@"asmtest_"]) {   // asmtest_<bundle>: reproduces AppSizeMenu.x's exact ASMSizeText logic here for a chosen bundle, to see the real values
        NSString *bundleID = [cmd substringFromIndex:8];
        Class proxyClass = NSClassFromString(@"LSApplicationProxy");
        SEL make = NSSelectorFromString(@"applicationProxyForIdentifier:");
        id proxy = (proxyClass && [(id)proxyClass respondsToSelector:make]) ? ((id (*)(id, SEL, id))objc_msgSend)((id)proxyClass, make, bundleID) : nil;
        if (!proxy) { DMLog([NSString stringWithFormat:@"[asmtest] %@: no proxy found", bundleID]); }
        else {
            id staticU = [proxy respondsToSelector:@selector(staticDiskUsage)] ? [proxy valueForKey:@"staticDiskUsage"] : nil;
            id dynamicU = [proxy respondsToSelector:@selector(dynamicDiskUsage)] ? [proxy valueForKey:@"dynamicDiskUsage"] : nil;
            DMLog([NSString stringWithFormat:@"[asmtest] %@: proxy found (%@), staticDiskUsage=%@ (%@), dynamicDiskUsage=%@ (%@)",
                   bundleID, NSStringFromClass([proxy class]), staticU, NSStringFromClass([staticU class]), dynamicU, NSStringFromClass([dynamicU class])]);
        }
    }
    else if ([cmd isEqualToString:@"appstoreupdates"]) DMAppStoreUpdates();   // the same thing "Check for Updates…" runs, for testing without navigating menus
    else if ([cmd isEqualToString:@"minimizeall"]) DMMinimizeAllWindows();   // the same thing "Minimize All Windows" runs, for testing without navigating menus
    else if ([cmd hasPrefix:@"iconlaunch_"]) {   // iconlaunch_<bundle>: launch the app the way an icon does (SBIcon launchFromLocation:context:), like an App Library or folder icon
        NSString *bid = [cmd substringFromIndex:11];
        id model = DMCall(DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager"), @"iconModel");
        id icon = ((id (*)(id, SEL, id))objc_msgSend)(model, NSSelectorFromString(@"applicationIconForBundleIdentifier:"), bid);
        SEL sel = NSSelectorFromString(@"launchFromLocation:context:");
        DMLog([NSString stringWithFormat:@"[debug] iconlaunch %@: icon %@ responds %d", bid, icon, [icon respondsToSelector:sel]]);
        if ([icon respondsToSelector:sel]) ((void (*)(id, SEL, id, id))objc_msgSend)(icon, sel, @"SBIconLocationAppLibrary", nil);
    }
    else if ([cmd isEqualToString:@"windowedstate"]) {   // windowedstate: the toggles and the windows
        DMLog([NSString stringWithFormat:@"[debug] windowedstate: engine %d, open as windows %d, fit %d, aerial toggle %d, stages %lu, front %@, level %.1f alpha %.2f hidden %d", (int)DMActiveEngine(), DMWindowedLaunchOn(), DMFitEnabled(), DMAerialToggleOn(), (unsigned long)DMAerialStages().count, [DMFrontApp() bundleIdentifier], DMWindowLayer().windowLevel, DMWindowLayer().alpha, DMWindowLayer().hidden]);
        for (UIView *st in DMAerialStages()) DMLog([NSString stringWithFormat:@"[debug]   stage %@ frame %@ hidden %d alpha %.2f minimized %d", DMStageBundle(st), NSStringFromCGRect(st.frame), st.hidden, st.alpha, DMStageMinimized(st)]);
    }
    else if ([cmd hasPrefix:@"unlocktry_"]) {   // unlocktry_<mode>_<source>
        NSArray *q = [[cmd substringFromIndex:10] componentsSeparatedByString:@"_"];
        id mgr = DMSBManager("SBLockScreenManager");
        if (q.count >= 2 && mgr) {
            int mode = [q[0] intValue], n = [q[1] intValue];
            DMLog([NSString stringWithFormat:@"[lock] try mode %d source %d: locked before %d", mode, n, DMLockUp(mgr)]);
            DMTryUnlock(mgr, mode, n);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMLog([NSString stringWithFormat:@"[lock] try mode %d source %d: locked after %d", mode, n, DMLockUp(mgr)]); });
        }
    }
    else if ([cmd hasPrefix:@"hookedby_"]) {   // hookedby_<dylib name part>: SpringBoard/FrontBoard/UIKit methods whose code lives in that dylib (i.e. it replaced them) -- read-only
        NSString *want = [cmd substringFromIndex:9];
        int found = 0;
        for (NSString *img in @[@"/System/Library/PrivateFrameworks/SpringBoard.framework/SpringBoard", @"/System/Library/PrivateFrameworks/SpringBoardHome.framework/SpringBoardHome",
                                @"/System/Library/PrivateFrameworks/FrontBoard.framework/FrontBoard", @"/System/Library/PrivateFrameworks/SpringBoardFoundation.framework/SpringBoardFoundation",
                                @"/System/Library/PrivateFrameworks/UIKitCore.framework/UIKitCore", @"/System/Library/PrivateFrameworks/FrontBoardServices.framework/FrontBoardServices"]) {
            unsigned int n = 0; const char **names = objc_copyClassNamesForImage(img.UTF8String, &n);
            for (unsigned int i = 0; i < n && found < 400; i++) {
                Class c = objc_getClass(names[i]); if (!c) continue;
                for (int meta = 0; meta < 2; meta++) {
                    Class k = meta ? object_getClass((id)c) : c;
                    unsigned int mc = 0; Method *ms = class_copyMethodList(k, &mc);
                    for (unsigned int j = 0; j < mc; j++) {
                        Dl_info info;
                        if (dladdr((void *)method_getImplementation(ms[j]), &info) && info.dli_fname && strstr(info.dli_fname, want.UTF8String)) {
                            found++;
                            DMLog([NSString stringWithFormat:@"[hookedby] %c[%s %s]", meta ? '+' : '-', names[i], sel_getName(method_getName(ms[j]))]);
                        }
                    }
                    free(ms);
                }
            }
            free(names);
        }
        DMLog([NSString stringWithFormat:@"[hookedby] %d method(s) run code from %@", found, want]);
    }
    else if ([cmd hasPrefix:@"stagescale_"]) {   // stagescale_<bundle>_<k>: give a window a lasting scale k (test for a window left scaled)
        NSArray *q = [[cmd substringFromIndex:11] componentsSeparatedByString:@"_"];
        UIView *st = q.count == 2 ? DMStageForBundle(q[0]) : nil; CGFloat k = [q.lastObject doubleValue];
        if (st && k > 0.1) { st.transform = CGAffineTransformMakeScale(k, k); DMLog([NSString stringWithFormat:@"[stagescale] %@ at %.2f, frame %@", q[0], k, NSStringFromCGRect(st.frame)]); }
    }
    else if ([cmd hasPrefix:@"appnote_"]) {   // appnote_<bundle>_<action>: post MacAppBridge's "<action>" notification to that app (e.g. viewtree: its windows and view frames, class names only)
        NSString *rest = [cmd substringFromIndex:8]; NSRange r = [rest rangeOfString:@"_" options:NSBackwardsSearch];
        if (r.location != NSNotFound) { DMPostAppBridgeAction([rest substringToIndex:r.location], [rest substringFromIndex:r.location + 1]); DMLog([NSString stringWithFormat:@"[appnote] %@", rest]); }
    }
    else if ([cmd hasPrefix:@"tintof_"]) {   // tintof_<bundle>: the accent colour that app published for its resize grips (read-only)
        NSString *b = [cmd substringFromIndex:7]; uint32_t hash = 2166136261u;
        for (const char *c = b.UTF8String; *c; c++) { hash ^= (uint8_t)*c; hash *= 16777619u; }
        char name[80]; snprintf(name, sizeof name, "com.besiktasliseba.appbridge.tint.%08x", hash);
        int t = 0; uint64_t st = 0; notify_register_check(name, &t); notify_get_state(t, &st); notify_cancel(t);
        DMLog([NSString stringWithFormat:@"[tintof] %@: valid %d rgba %llu %llu %llu %llu", b, (int)((st >> 32) & 1), (st >> 24) & 0xff, (st >> 16) & 0xff, (st >> 8) & 0xff, st & 0xff]);
    }
    else if ([cmd hasPrefix:@"stagetf_"]) {   // stagetf_<bundle>: a window's live transform, bounds, centre, frame and presentation (read-only)
        UIView *st = DMStageForBundle([cmd substringFromIndex:8]);
        CALayer *pl = st.layer.presentationLayer;
        CGAffineTransform t = st.transform;
        DMLog([NSString stringWithFormat:@"[stagetf] %@: transform [%.3f %.3f %.3f %.3f %.1f %.1f] bounds %@ center %@ frame %@ presentation %@ zooming %d", [cmd substringFromIndex:8], t.a, t.b, t.c, t.d, t.tx, t.ty, NSStringFromCGRect(st.bounds), NSStringFromCGPoint(st.center), NSStringFromCGRect(st.frame), pl ? NSStringFromCGRect(pl.frame) : @"-", st ? DMStageStillZooming(st) : -1]);
    }
    else if ([cmd hasPrefix:@"stormtest_"]) {   // stormtest_<bundle>: send that app's scene its own current settings 30 times without a transition (storm brake test)
        NSString *bundle = [cmd substringFromIndex:10]; id scene = nil;
        for (NSString *sid in gSceneByID) if ([sid containsString:bundle]) { scene = ((DMWeakScene *)gSceneByID[sid]).scene; if (scene) break; }
        id cur = nil; @try { cur = [scene valueForKey:@"settings"]; } @catch (id e) {}
        id m = [cur respondsToSelector:@selector(mutableCopy)] ? [cur mutableCopy] : nil;
        SEL up = NSSelectorFromString(@"updateSettings:withTransitionContext:");
        DMLog([NSString stringWithFormat:@"[stormtest] %@: scene %p, settings %@, copy equal %d", bundle, scene, NSStringFromClass([cur class]), m ? [[m copy] isEqual:m] : -1]);
        if (m && [scene respondsToSelector:up]) for (int i = 0; i < 30; i++) ((void (*)(id, SEL, id, id))objc_msgSend)(scene, up, [m mutableCopy], nil);
        DMLog([NSString stringWithFormat:@"[stormtest] %@: 30 sent", bundle]);
    }
    else if ([cmd hasPrefix:@"symbolize_"]) {   // symbolize_<hex>_<hex>...: name the Objective-C method each code address is in (nearest method start in its image) -- read-only
        for (NSString *hex in [[cmd substringFromIndex:10] componentsSeparatedByString:@"_"]) DMSymbolize(strtoull(hex.UTF8String, NULL, 16));
    }
    else if ([cmd hasPrefix:@"methodhunt_"]) {   // methodhunt_<Class>_<keyword>: the methods (instance and class) of a class and its superclasses whose name contains the keyword
        NSArray *q = [[cmd substringFromIndex:11] componentsSeparatedByString:@"_"];
        Class c = q.count >= 2 ? objc_getClass([q[0] UTF8String]) : Nil;
        NSString *kw = q.count >= 2 ? [q[1] lowercaseString] : @"";
        if (!c) DMLog([NSString stringWithFormat:@"[methods] class %@ not found", q.firstObject]);
        for (Class k = c; k; k = class_getSuperclass(k)) {
            for (int meta = 0; meta < 2; meta++) {
                unsigned n = 0; Method *l = class_copyMethodList(meta ? object_getClass(k) : k, &n);
                for (unsigned i = 0; i < n; i++) {
                    NSString *name = NSStringFromSelector(method_getName(l[i]));
                    if ([[name lowercaseString] containsString:kw]) DMLog([NSString stringWithFormat:@"[methods] %@ %@[%@ %@]", NSStringFromClass(c), meta ? @"+" : @"-", NSStringFromClass(k), name]);
                }
                free(l);
            }
        }
        DMLog(@"[methods] done");
    }
    else if ([cmd hasPrefix:@"classhunt_"]) {   // classhunt_<keyword>: every view whose class name contains it
        NSString *kw = [cmd substringFromIndex:10];
        for (UIWindow *w in DMAllWindows()) DMFindByClass(w, kw, 0, w);
        DMLog([NSString stringWithFormat:@"[class] search for \"%@\" done", kw]);
    }
    else if ([cmd hasPrefix:@"cover_"]) {   // cover_<0|1>: pull the Cover Sheet down / put it away
        BOOL up = [[cmd substringFromIndex:6] boolValue];
        id mgr = DMSBManager("SBCoverSheetPresentationManager");
        SEL sel = NSSelectorFromString(@"setCoverSheetPresented:animated:withCompletion:");
        DMLog([NSString stringWithFormat:@"[debug] cover sheet %d: manager %@ responds %d", up, mgr, [mgr respondsToSelector:sel]]);
        if ([mgr respondsToSelector:sel]) ((void (*)(id, SEL, BOOL, BOOL, id))objc_msgSend)(mgr, sel, up, YES, nil);
    }
    else if ([cmd hasPrefix:@"itap_"]) {   // itap_<bundle id>: what tapping that app's icon does (Aerial's toggle hooks -[SBIconView _handleTap])
        NSString *bid = [cmd substringFromIndex:5];
        id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
        id icon = ((id (*)(id, SEL, id))objc_msgSend)(DMCall(ic, @"model"), NSSelectorFromString(@"expectedIconForDisplayIdentifier:"), bid);
        id iv = nil;
        for (UIWindow *w in DMAllWindows()) if (!iv) iv = DMFindIconView(w, bid);
        DMLog([NSString stringWithFormat:@"[debug] itap %@: icon %@ view %@ toggle %d", bid, icon, iv, DMAerialToggleOn()]);
        if (DMTestFlag("/tmp/macstatusbar-hunt"))
            for (NSNumber *ms in @[@200, @450, @700, @950, @1200]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(ms.intValue * NSEC_PER_MSEC)), dispatch_get_main_queue(), ^{ DMWhiteHuntAll([NSString stringWithFormat:@"%d ms after the tap", ms.intValue]); });
        if ([iv respondsToSelector:NSSelectorFromString(@"_handleTap")]) ((void (*)(id, SEL))objc_msgSend)(iv, NSSelectorFromString(@"_handleTap"));
    }
    else if ([cmd hasPrefix:@"awindow_"]) {   // awindow_<bundle id>: our menus' windowed launch
        NSString *bid = [cmd substringFromIndex:8];
        BOOL opened;
        if (DMActiveEngine() == DMEngineMilkyWay) { DMLaunchAsWindow(bid); opened = YES; } else opened = DMWindowedLaunch(bid);
        DMLog([NSString stringWithFormat:@"[debug] awindow %@ -> %d", bid, opened]);
    }
    else if ([cmd isEqualToString:@"tapicon"]) {   // what tapping the Settings icon on the Home Screen calls
        id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
        id model = DMCall(ic, @"model");
        id icon = ((id (*)(id, SEL, id))objc_msgSend)(model, NSSelectorFromString(@"expectedIconForDisplayIdentifier:"), @"com.apple.Preferences");
        DMLog([NSString stringWithFormat:@"[debug] tapicon: icon %@", icon]);
        if (icon) ((void (*)(id, SEL, id, id))objc_msgSend)(icon, NSSelectorFromString(@"launchFromLocation:context:"), @"SBIconLocationRoot", nil);
    }
    else if ([cmd isEqualToString:@"closewindows"]) {
        UIWindow *layer = DMMilkyWayLayer();
        Class viewClass = objc_getClass("AXWindowView");
        for (UIView *v in [layer.subviews copy]) if (viewClass && [v isKindOfClass:viewClass]) [(AXWindowView *)v closeButtonAction:nil];
        DMLog(@"[debug] closed all MilkyWay windows");
        if (DMActiveEngine() == DMEngineAerial) for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length) { DMAerialClose(b); DMLog([NSString stringWithFormat:@"[debug] closed the Aerial window %@", b]); } }
    }
    else if ([cmd isEqualToString:@"togglewindows"]) DMToggleWindowsForward();
    else if ([cmd hasPrefix:@"surface_"]) DMLog([NSString stringWithFormat:@"[debug] surface %@: %d", [cmd substringFromIndex:8], DMSurfaceWindowForApp([cmd substringFromIndex:8])]);   // surface_<bundle>: what launching an app with a window does (un-minimize, bring forward)
    else if ([cmd hasPrefix:@"setwindowedlaunch_"]) {   // setwindowedlaunch_0 / setwindowedlaunch_1: for testing full-screen-launch repros without hunting through menus
        NSString *v = [cmd substringFromIndex:18];
        DMSetWindowedLaunch([v boolValue]);
        DMLog([NSString stringWithFormat:@"[debug] windowed launch set to %@", v]);
    }
    else if ([cmd hasPrefix:@"smcheck_"]) {   // smcheck_<none|selector|encoding|optional|hook|layout16|layout17>: the engine's self-check run again with that simulated difference (layoutNN: that layout engine's table; optional: -appLayoutByRemovingItemInLayoutRole: missing, as on 16.2-16.3) -- read-only, nothing changes
        NSString *sim = [cmd substringFromIndex:8];
        NSUInteger checked = 0;
        NSArray *opt = nil, *off = nil; NSDictionary *vars = nil; double sizedT = 0;   // (optional rows and variants: reported, never recorded -- smcheck_optional shows the iPadOS 16.2-16.3 case)
        NSArray *bad = DMSMCheckAPIFull([sim isEqualToString:@"none"] ? nil : sim, &checked, &opt, &off, NULL, &vars, &sizedT);
        NSArray *hooks = DMSMHooksNotInstalled(DMSMHookedIMPs(), [sim isEqualToString:@"hook"]);   // (the current IMPs against themselves: every hook "not installed" -- shows the comparison works)
        int gen = [sim hasPrefix:@"layout"] ? DMSMLayoutGenFor(sim) : DMSMLayoutGen();
        DMLog([NSString stringWithFormat:@"[smcheck] (trigger, simulating %@; layout engine table %@, the running engine's: %@) API: %lu checked, %lu different: %@ | optional not here: %@, features off: %@ | another iPadOS's way: %@ | hooks compared with themselves: %lu of %lu flagged", sim, DMSMLayoutName(gen), DMSMLayoutName(DMSMLayoutGen()), (unsigned long)checked,
               (unsigned long)bad.count, [bad componentsJoinedByString:@"; "], [opt componentsJoinedByString:@"; "] ?: @"", [off componentsJoinedByString:@"; "] ?: @"", [DMSMOtherWays(vars) componentsJoinedByString:@"; "] ?: @"", (unsigned long)hooks.count, (unsigned long)DMSMHookedIMPs().count]);
    }
    else if ([cmd hasPrefix:@"sbsettings_"]) DMOpenStatusBarSettings((uint32_t)[[cmd substringFromIndex:11] intValue]);   // sbsettings_<0|1|2>: Settings on our Status Bar page / Go apps / the Window Engine picker
    else if ([cmd hasPrefix:@"opennorm_"]) DMOpenApp([cmd substringFromIndex:9]);   // opennorm_<bundle>: the normal open path (unlike iconlaunch_, which bypasses windowed-launch entirely)
    else if ([cmd isEqualToString:@"dockclasses"]) {   // every registered class with "Dock" in its name, and its methods matching keywords relevant to keeping it visible/forward
        NSMutableString *out = [NSMutableString stringWithString:@"dock classes:"];
        int numClasses = objc_getClassList(NULL, 0);
        Class *classes = (Class *)malloc(sizeof(Class) * (unsigned long)numClasses);
        numClasses = objc_getClassList(classes, numClasses);
        NSArray<NSString *> *keywords = @[@"visible", @"show", @"hide", @"present", @"keep", @"assertion", @"interaction", @"dismiss", @"autohide", @"reveal", @"forward", @"raise"];
        for (int i = 0; i < numClasses; i++) {
            NSString *name = NSStringFromClass(classes[i]);
            if ([name rangeOfString:@"dock" options:NSCaseInsensitiveSearch].location == NSNotFound) continue;
            [out appendFormat:@"\n%@:", name];
            for (int meta = 0; meta < 2; meta++) {
                unsigned n = 0; Method *l = class_copyMethodList(meta ? object_getClass(classes[i]) : classes[i], &n);
                for (unsigned m = 0; m < n; m++) {
                    NSString *sel = NSStringFromSelector(method_getName(l[m]));
                    for (NSString *kw in keywords) if ([sel rangeOfString:kw options:NSCaseInsensitiveSearch].location != NSNotFound) { [out appendFormat:@"\n  %@%@", meta ? @"+" : @"-", sel]; break; }
                }
                free(l);
            }
        }
        free(classes);
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"classearch_"]) {   // classearch_<keyword>: every registered class whose NAME contains <keyword>, with its ivars — read-only, instantiates nothing, safe to reuse for any future search
        NSString *keyword = [cmd substringFromIndex:11];
        NSMutableString *out = [NSMutableString stringWithFormat:@"classes matching \"%@\":", keyword];
        int numClasses = objc_getClassList(NULL, 0);
        Class *classes = (Class *)malloc(sizeof(Class) * (unsigned long)numClasses);
        numClasses = objc_getClassList(classes, numClasses);
        for (int i = 0; i < numClasses; i++) {
            NSString *name = NSStringFromClass(classes[i]);
            if ([name rangeOfString:keyword options:NSCaseInsensitiveSearch].location == NSNotFound) continue;
            [out appendFormat:@"\n%@ (superclass %@)", name, NSStringFromClass(class_getSuperclass(classes[i])) ?: @"?"];
            unsigned n = 0; Ivar *ivars = class_copyIvarList(classes[i], &n);
            for (unsigned m = 0; m < n; m++) [out appendFormat:@"\n  ivar %s (%s)", ivar_getName(ivars[m]), ivar_getTypeEncoding(ivars[m])];
            free(ivars);
        }
        free(classes);
        DMLog(out);
    }
    else if ([cmd isEqualToString:@"smcorners"]) DMSMLogCorners();   // smcorners: each Stage Manager window card's corner state -- read-only
    else if ([cmd hasPrefix:@"smforward_"]) DMSMWindowsForward([[cmd substringFromIndex:10] boolValue]);   // smforward_1: Bring All to Front, _0: Send All to Back (test)
    else if ([cmd hasPrefix:@"openwin_"]) DMSetWindowedLaunch([[cmd substringFromIndex:8] boolValue]);   // openwin_0/1: Open Apps as Windows (test)
    else if ([cmd isEqualToString:@"smdisplays"]) {   // smdisplays: each screen's display configuration / identity, and each recent stage's display (read-only)
        for (UIScreen *sc in [UIScreen screens]) {
            id cfg = [sc respondsToSelector:NSSelectorFromString(@"displayConfiguration")] ? DMCall(sc, @"displayConfiguration") : nil;
            DMLog([NSString stringWithFormat:@"[smdisplays] screen %@ %@: configuration %@ identity %@", sc, NSStringFromCGRect(sc.bounds), [cfg class], cfg ? DMCall(cfg, @"identity") : nil]);
        }
        for (id al in DMCall(DMCall(objc_getClass("SBMainSwitcherControllerCoordinator"), @"sharedInstance"), @"recentAppLayouts")) {
            NSMutableArray *bs = [NSMutableArray array];
            for (id it in DMCall(al, @"itemsToLayoutAttributesMap")) [bs addObject:DMCall(it, @"bundleIdentifier") ?: @"?"];
            DMLog([NSString stringWithFormat:@"[smdisplays] stage %@ ordinal %ld identity %@", [bs componentsJoinedByString:@","], ((long (*)(id, SEL))objc_msgSend)(al, NSSelectorFromString(@"preferredDisplayOrdinal")), DMCall(al, @"preferredDisplayIdentity")]);
        }
    }
    else if ([cmd hasPrefix:@"smfull_"]) DMSMSetFullScreenInStage([cmd substringFromIndex:7], YES);   // smfull_<bundle>: that window full screen inside its stage (test)
    else if ([cmd hasPrefix:@"selhunt_"]) {   // selhunt_<keyword>: every method (instance and class) of every class in SpringBoard.framework whose name contains <keyword> -- read-only
        NSString *kw = [cmd substringFromIndex:8];
        NSMutableString *out = [NSMutableString stringWithFormat:@"[selhunt] %@:", kw];
        unsigned nc = 0;
        const char **names = objc_copyClassNamesForImage("/System/Library/PrivateFrameworks/SpringBoard.framework/SpringBoard", &nc);
        for (unsigned i = 0; i < nc; i++) {
            Class c = objc_getClass(names[i]);
            for (int meta = 0; meta < 2 && c; meta++) {
                Class k = meta ? object_getClass((id)c) : c;
                unsigned nm = 0; Method *ms = class_copyMethodList(k, &nm);
                for (unsigned j = 0; j < nm; j++) {
                    NSString *sel = NSStringFromSelector(method_getName(ms[j]));
                    if ([sel rangeOfString:kw options:NSCaseInsensitiveSearch].location != NSNotFound) [out appendFormat:@"\n  %c[%s %@]", meta ? '+' : '-', names[i], sel];
                }
                free(ms);
            }
        }
        free(names);
        DMLog(out);
    }
    else if ([cmd hasPrefix:@"methsearch_"]) {   // methsearch_<ExactClassName>: every instance method of that one class (name + full type encoding) — read-only, instantiates nothing
        Class c = objc_getClass([[cmd substringFromIndex:11] UTF8String]);
        NSMutableString *out = [NSMutableString stringWithFormat:@"methods of %@:", [cmd substringFromIndex:11]];
        if (!c) [out appendString:@"\nclass not found"];
        else {
            unsigned n = 0; Method *l = class_copyMethodList(c, &n);
            for (unsigned m = 0; m < n; m++) [out appendFormat:@"\n  -%@  (%s)", NSStringFromSelector(method_getName(l[m])), method_getTypeEncoding(l[m])];
            free(l);
        }
        DMLog(out);
    }
    // dockassertlevels was removed: it created and immediately discarded SBFloatingDockBehaviorAssertion instances in a tight loop to probe
    // valid "atLevel" values, and one of those discards crashed SpringBoard (SIGSEGV in objc_release while draining an autorelease pool —
    // confirmed by a real crash log). A private class's init not throwing is not proof it is safe to deallocate unused; do not recreate this.
    else if ([cmd isEqualToString:@"dockassertsig"]) {   // read-only: the real type encoding of every argument of SBFloatingDockBehaviorAssertion's init, so values are not guessed blind — safe, instantiates nothing
        Class c = objc_getClass("SBFloatingDockBehaviorAssertion");
        SEL sel = NSSelectorFromString(@"initWithFloatingDockController:visibleProgress:animated:gesturePossible:atLevel:reason:withCompletion:");
        NSMutableString *out = [NSMutableString stringWithString:@"assertion init signature:"];
        if (!c || ![c instancesRespondToSelector:sel]) { DMLog(@"dockassertsig: not found"); }
        else {
            NSMethodSignature *sig = [c instanceMethodSignatureForSelector:sel];
            [out appendFormat:@"\nreturn type: %s, arg count %lu", sig.methodReturnType, (unsigned long)sig.numberOfArguments];
            for (NSUInteger i = 0; i < sig.numberOfArguments; i++) [out appendFormat:@"\n  arg %lu: %s", (unsigned long)i, [sig getArgumentTypeAtIndex:i]];
            DMLog(out);
        }
    }
    else if ([cmd isEqualToString:@"dockcontroller"]) {   // where an SBFloatingDockController instance can be reached from (ivar search from a few likely roots)
        Class target = objc_getClass("SBFloatingDockController");
        NSMutableString *out = [NSMutableString stringWithString:@"dock controller search:"];
        if (!target) { DMLog(@"dockcontroller: class not found"); }
        else {
            NSArray<NSString *> *rootClassNames = @[@"SBIconController", @"SBHomeScreenController", @"SBWorkspaceHomeScreenController", @"SBFloatingDockWindow"];
            for (NSString *rootName in rootClassNames) {
                Class rc = objc_getClass(rootName.UTF8String);
                if (!rc) { [out appendFormat:@"\n%@: class not found", rootName]; continue; }
                id root = [rc respondsToSelector:@selector(sharedInstance)] ? ((id (*)(id, SEL))objc_msgSend)((id)rc, @selector(sharedInstance)) : nil;
                if (!root && [rootName isEqualToString:@"SBFloatingDockWindow"]) {
                    for (UIWindow *w in DMAllWindows()) if ([NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) { root = w; break; }
                }
                [out appendFormat:@"\n%@: root %@", rootName, root ? @"found" : @"NOT found"];
                if (!root) continue;
                // shallow ivar walk (depth 2), same idea as DockMagnification's App Library presenter search
                NSMutableArray *frontier = [NSMutableArray arrayWithObject:root];
                NSMutableSet *seen = [NSMutableSet set];
                for (int depth = 0; depth < 3 && frontier.count; depth++) {
                    NSMutableArray *next = [NSMutableArray array];
                    for (id obj in frontier) {
                        if (!obj || [seen containsObject:[NSValue valueWithNonretainedObject:obj]]) continue;
                        [seen addObject:[NSValue valueWithNonretainedObject:obj]];
                        for (Class c = [obj class]; c && c != [NSObject class]; c = class_getSuperclass(c)) {
                            unsigned count = 0; Ivar *ivars = class_copyIvarList(c, &count);
                            for (unsigned i = 0; i < count; i++) {
                                const char *type = ivar_getTypeEncoding(ivars[i]);
                                if (!type || type[0] != '@') continue;
                                id value = object_getIvar(obj, ivars[i]);
                                if (!value) continue;
                                if ([value isKindOfClass:target]) { [out appendFormat:@"\n  -> found via %@.%s (depth %d)", NSStringFromClass([obj class]), ivar_getName(ivars[i]), depth]; }
                                else if ([NSStringFromClass([value class]) hasPrefix:@"SB"]) [next addObject:value];
                            }
                            free(ivars);
                        }
                    }
                    frontier = next;
                }
            }
        }
        DMLog(out);
    }
    else if ([cmd isEqualToString:@"dockctrlstate"]) {   // read-only: reach the live SBFloatingDockController via SBIconController.sharedInstance._floatingDockController
        // (confirmed shortest path by the "dockcontroller" trigger above, depth 0) and log its own state getters. No alloc/init of
        // anything -- SBIconController's sharedInstance is a singleton accessor, the controller is an ivar it already owns, and every
        // method called here is a plain getter with no side effects. Sanity check before ever considering a mutating call on this object
        // (the exact class family behind both Safe Mode incidents tonight).
        Class icClass = objc_getClass("SBIconController");
        id ic = (icClass && [(id)icClass respondsToSelector:@selector(sharedInstance)]) ? ((id (*)(id, SEL))objc_msgSend)((id)icClass, @selector(sharedInstance)) : nil;
        id ctrl = ic ? DMFloatingDockController() : nil;
        if (!ctrl) { DMLog(@"[dockctrl] SBFloatingDockController not reachable"); }
        else {
            BOOL presented = [ctrl respondsToSelector:@selector(isFloatingDockPresented)] ? ((BOOL (*)(id, SEL))objc_msgSend)(ctrl, @selector(isFloatingDockPresented)) : NO;
            BOOL fully = [ctrl respondsToSelector:@selector(isFloatingDockFullyPresented)] ? ((BOOL (*)(id, SEL))objc_msgSend)(ctrl, @selector(isFloatingDockFullyPresented)) : NO;
            DMLog([NSString stringWithFormat:@"[dockctrl] found %@, isFloatingDockPresented=%d isFloatingDockFullyPresented=%d, floatingDockHeight %.1f", NSStringFromClass([ctrl class]), presented, fully, DMSpringBoardDockHeight()]);
        }
    }
    else if ([cmd isEqualToString:@"dockctrlpresent"]) {   // calls -presentFloatingDockIfDismissedAnimated:completionHandler: on the SAME live controller object above --
        // a single call, not a loop, with a plain empty completion block. This does NOT alloc/init an SBFloatingDockBehaviorAssertion
        // ourselves (the thing that crashed SpringBoard twice tonight): it asks the controller to manage its own assertion internally,
        // the same internal machinery it already uses correctly for folders/library/3D-touch menus over a full-screen app.
        Class icClass = objc_getClass("SBIconController");
        id ic = (icClass && [(id)icClass respondsToSelector:@selector(sharedInstance)]) ? ((id (*)(id, SEL))objc_msgSend)((id)icClass, @selector(sharedInstance)) : nil;
        id ctrl = ic ? DMFloatingDockController() : nil;
        SEL presentSel = @selector(presentFloatingDockIfDismissedAnimated:completionHandler:);
        if (!ctrl || ![ctrl respondsToSelector:presentSel]) { DMLog(@"[dockctrl] present: controller or selector not available"); }
        else {
            DMLog(@"[dockctrl] calling presentFloatingDockIfDismissedAnimated:YES completionHandler:...");
            ((void (*)(id, SEL, BOOL, id))objc_msgSend)(ctrl, presentSel, YES, ^{ DMLog(@"[dockctrl] present completion fired"); });
        }
    }
    else if ([cmd isEqualToString:@"dockctrldismiss"]) {   // counterpart: -dismissFloatingDockIfPresentedAnimated:completionHandler:, same object, same single-call pattern.
        Class icClass = objc_getClass("SBIconController");
        id ic = (icClass && [(id)icClass respondsToSelector:@selector(sharedInstance)]) ? ((id (*)(id, SEL))objc_msgSend)((id)icClass, @selector(sharedInstance)) : nil;
        id ctrl = ic ? DMFloatingDockController() : nil;
        SEL dismissSel = @selector(dismissFloatingDockIfPresentedAnimated:completionHandler:);
        if (!ctrl || ![ctrl respondsToSelector:dismissSel]) { DMLog(@"[dockctrl] dismiss: controller or selector not available"); }
        else {
            DMLog(@"[dockctrl] calling dismissFloatingDockIfPresentedAnimated:YES completionHandler:...");
            ((void (*)(id, SEL, BOOL, id))objc_msgSend)(ctrl, dismissSel, YES, ^{ DMLog(@"[dockctrl] dismiss completion fired"); });
        }
    }
    else if ([cmd isEqualToString:@"dumpwindows"]) {   // every real window (not internal ones like keyboards/effects): class, level, frame, hidden, alpha — for studying what keeps the Dock forward
        NSMutableString *out = [NSMutableString stringWithString:@"windows:"];
        for (UIWindow *w in DMAllWindows()) {
            [out appendFormat:@"\n%@ level=%.1f frame=%@ hidden=%d alpha=%.2f", NSStringFromClass([w class]), w.windowLevel, NSStringFromCGRect(w.frame), w.hidden, w.alpha];
        }
        DMLog(out);
    }
    else if ([cmd isEqualToString:@"levels"]) {
        UIWindow *l = DMMilkyWayLayer();
        DMLog([NSString stringWithFormat:@"[debug] MilkyWay layer level %.1f (desired %.1f), %lu windows, pinned %d, front %@", l.windowLevel, DMDesiredWindowLevel(), (unsigned long)DMMilkyWayWindowCount(), gWindowsPinnedForward, [DMFrontApp() bundleIdentifier]]);
    }
    else if ([cmd isEqualToString:@"windowshot"]) {   // MilkyWay's window layer -> /tmp/macstatusbar-window.png
        Class c = objc_getClass("AXPassthroughWindow");
        UIWindow *w = [c respondsToSelector:@selector(sharedInstance)] ? ((id (*)(id, SEL))objc_msgSend)((id)c, @selector(sharedInstance)) : nil;
        if (w) {
            UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 2.0;
            UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:w.bounds.size format:fmt];
            UIImage *img = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) { [[UIColor colorWithWhite:0.3 alpha:1] setFill]; UIRectFill(w.bounds); [w drawViewHierarchyInRect:w.bounds afterScreenUpdates:NO]; }];
            [UIImagePNGRepresentation(img) writeToFile:@"/tmp/macstatusbar-window.png" atomically:YES];
            DMLog([NSString stringWithFormat:@"[debug] window shot %@", NSStringFromCGRect(w.bounds)]);
        } else DMLog(@"[debug] no MilkyWay window layer");
    }
    else if ([cmd isEqualToString:@"screenshot"]) {   // does a screen snapshot view capture the app? -> /tmp/macstatusbar-screen.png
        UIView *snap = [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO];
        DMLog([NSString stringWithFormat:@"[debug] screen snapshot view %@ frame %@", NSStringFromClass([snap class]), NSStringFromCGRect(snap.frame)]);
        // LIVE-CONFIRMED BUG (2026-09-23): picking "whichever status bar copy window happens to be non-hidden first" can land on
        // SBMainSwitcherWindow (portrait bounds, rotated content) instead of the real upright UIStatusBarWindow — seen live as a
        // sideways screenshot with two MilkyWay windows open. DMStatusBarWindow() is the same explicit, correct lookup the cover
        // code already relies on for this exact reason (see its own comment): always use it here too, not a "first visible" guess.
        UIWindow *host = DMStatusBarWindow();
        if (snap && host) {
            [host addSubview:snap];
            UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat]; fmt.scale = 1.0;
            UIGraphicsImageRenderer *r = [[UIGraphicsImageRenderer alloc] initWithSize:snap.bounds.size format:fmt];
            UIImage *img = [r imageWithActions:^(UIGraphicsImageRendererContext *ctx) { [snap drawViewHierarchyInRect:snap.bounds afterScreenUpdates:YES]; }];
            [UIImagePNGRepresentation(img) writeToFile:@"/tmp/macstatusbar-screen.png" atomically:YES];
            [snap removeFromSuperview];
            DMLog(@"[debug] screen snapshot written");
        }
    }
    else if ([cmd isEqualToString:@"red"]) DMLightAction(0);
    else if ([cmd isEqualToString:@"orange"]) DMLightAction(1);
    else if ([cmd isEqualToString:@"green"]) DMLightAction(2);
    else if ([cmd isEqualToString:@"sleep"]) DMSleep();
    else if ([cmd isEqualToString:@"screen"]) {
        SBBacklightController *bl = DMShared("SBBacklightController", @selector(sharedInstance));
        DMLog([NSString stringWithFormat:@"[debug] screenIsOn=%d", [bl respondsToSelector:@selector(screenIsOn)] ? [bl screenIsOn] : -1]);
    }
    else if ([cmd isEqualToString:@"switch"]) {   // open Finder/app menu, then switch to Edit as a hover would
        UIView *fg = nil;
        for (UIView *v in gCopies.allObjects) if (v.window && !v.window.hidden && v.bounds.size.width > 300) { fg = v; break; }
        UIButton *a = fg ? objc_getAssociatedObject(fg, kAppButtonKey) : nil, *e = fg ? objc_getAssociatedObject(fg, kEditButtonKey) : nil;
        if (a && e) { DMOpenAppMenu(a); dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRemoveOverlayNow(); DMOpenMenuForButton(e); }); }
    }
}

// The frontmost app and the seconds change without the status bar laying out, so check
// four times a second and nudge every visible status bar copy when either changes.

// Debug aid (only if /tmp/macstatusbar-debug exists): save a picture of the visible status bar so the
// result can be checked without touching the iPad. Changes nothing on screen.
static void DMDebugSnapshot(void) {
    for (UIView *fg in gCopies.allObjects) {
        if (!fg.window || fg.window.hidden || fg.bounds.size.width < 300.0) continue;
        BOOL hidden = NO;
        for (UIView *x = fg; x; x = x.superview) if (x.hidden || x.alpha < 0.01) { hidden = YES; break; }
        if (hidden) continue;
        UIView *bar = gOverlay ? DMHostFor(fg) : fg.superview;   // whole screen area while a menu is open
        UIColor *tc = [(UILabel *)objc_getAssociatedObject(fg, kLogoKey) textColor];
        CGFloat r = 1, g = 1, b = 1;
        [tc getRed:&r green:&g blue:&b alpha:NULL];
        UIColor *bg = (0.299 * r + 0.587 * g + 0.114 * b > 0.5) ? [UIColor colorWithWhite:0.15 alpha:1] : [UIColor colorWithWhite:0.92 alpha:1];
        UIGraphicsImageRendererFormat *fmt = [UIGraphicsImageRendererFormat defaultFormat];
        fmt.scale = gOverlay ? 2.0 : 3.0;
        UIGraphicsImageRenderer *rend = [[UIGraphicsImageRenderer alloc] initWithSize:bar.bounds.size format:fmt];
        UIImage *img = [rend imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
            [bg setFill];
            UIRectFill(bar.bounds);
            if (![bar drawViewHierarchyInRect:bar.bounds afterScreenUpdates:NO]) [bar.layer renderInContext:ctx.CGContext];
        }];
        [UIImagePNGRepresentation(img) writeToFile:@"/tmp/macstatusbar-bar.png" atomically:YES];
        return;
    }
}



// While /tmp/macstatusbar-watch exists: log each status bar copy's visibility whenever it changes.
static void DMWatchState(void) {
    static NSMapTable *last = nil;
    if (!last) last = [NSMapTable weakToStrongObjectsMapTable];
    id cc = DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance");
    NSMutableString *ccwin = [NSMutableString string];
    for (UIWindow *w in DMAllWindows()) {
        NSString *n = NSStringFromClass([w class]);
        if ([n containsString:@"ControlCenter"] || [n containsString:@"CCUI"]) [ccwin appendFormat:@" %@(h%d a%.2f)", n, w.hidden, w.alpha];
    }
    NSString *ccState = [NSString stringWithFormat:@"cc[presented=%@ visible=%@ animating=%@]%@",
        DMBoolStr(cc, @"isPresented"), DMBoolStr(cc, @"isVisible"), DMBoolStr(cc, @"isTransitioning"), ccwin];
    for (UIView *fg in gCopies.allObjects) {
        if (!fg.window) continue;
        UIView *container = DMLeadingContainer(fg);
        UIView *timeL = container ? DMFirstStringView(container) : nil;
        UIView *dateL = container ? DMDateStringView(container) : nil;
        UILabel *appL = objc_getAssociatedObject(fg, kAppLabelKey);
        UIView *bar = fg.superview, *modern = bar.superview;
        NSMutableString *strs = [NSMutableString string];
        for (UIView *s in container.subviews)
            if ([s isKindOfClass:DMSBClass("_UIStatusBarStringView")])
                [strs appendFormat:@"%@[\"%@\" a%.2f h%d x%.0f w%.0f]", s == timeL ? @"T" : (s == dateL ? @"D" : @"?"),
                 [(UILabel *)s text], s.alpha, s.hidden, s.center.x, s.bounds.size.width];
        NSString *sig = [NSString stringWithFormat:@"strs{%@} %@ win(h%d a%.2f) fgW=%.0f fgA=%.2f/h%d barA=%.2f/h%d modernA=%.2f/h%d date(a%.2f h%d \"%@\") proxy(h%d \"%@\") app(h%d \"%@\")",
            strs, NSStringFromClass([fg.window class]), fg.window.hidden, fg.window.alpha, fg.bounds.size.width, fg.alpha, fg.hidden,
            bar.alpha, bar.hidden, modern.alpha, modern.hidden,
            dateL.alpha, dateL.hidden, [(UILabel *)dateL text],
            ((UILabel *)objc_getAssociatedObject(fg, kDateProxyKey)).hidden, ((UILabel *)objc_getAssociatedObject(fg, kDateProxyKey)).text,
            appL.hidden, appL.text];
        NSString *old = [last objectForKey:fg];
        NSString *full = [ccState stringByAppendingString:sig];
        if (![full isEqualToString:old]) {
            [last setObject:full forKey:fg];
            DMLog([NSString stringWithFormat:@"[watch] %p %@ %@", fg, ccState, sig]);
        }
    }
}


// While /tmp/macstatusbar-flash exists: every screen frame, log any change in what is really on screen
// for the date, our stand-in date and the app name (animated values, not the model ones).
static NSString *DMColorHex(UIColor *c) {
    CGFloat r = 0, g = 0, b = 0, al = 0;
    if (!c || ![c getRed:&r green:&g blue:&b alpha:&al]) { CGFloat w = 0; if (c && [c getWhite:&w alpha:&al]) r = g = b = w; else return @"-"; }
    return [NSString stringWithFormat:@"%02x%02x%02x", (int)(r * 255), (int)(g * 255), (int)(b * 255)];
}
static NSString *DMFlashDescribe(UIView *v, BOOL withText) {
    if (!v) return @"none";
    CGRect r = [v convertRect:v.bounds toView:nil];
    NSString *color = [v respondsToSelector:@selector(textColor)] ? DMColorHex([(UILabel *)v textColor]) : @"-";
    return [NSString stringWithFormat:@"a%.2f c%@ x%.0f y%.0f%@", DMEffectiveAlpha(v), color, r.origin.x, r.origin.y,
            withText ? [NSString stringWithFormat:@" \"%@\"", [(UILabel *)v text]] : @""];
}
@interface DMFlashRecorder : NSObject
- (void)frame:(CADisplayLink *)link;
@end
static CADisplayLink *gFlashLink = nil;
static NSMapTable *gFlashLast = nil;
@implementation DMFlashRecorder
- (void)frame:(CADisplayLink *)link {
    if (!gFlashLast) gFlashLast = [NSMapTable weakToStrongObjectsMapTable];
    for (UIView *fg in gCopies.allObjects) {
        if (!fg.window || fg.window.hidden || DMEffectiveAlpha(fg) < 0.02) { [gFlashLast removeObjectForKey:fg]; continue; }
        UIView *container = DMLeadingContainer(fg);
        UIView *timeL = container ? DMFirstStringView(container) : nil;
        UIView *dateL = container ? DMDateStringView(container) : nil;
        UIView *proxy = objc_getAssociatedObject(fg, kDateProxyKey);
        UIView *appL = objc_getAssociatedObject(fg, kAppLabelKey);
        CGFloat dateVis = MAX(dateL ? DMEffectiveAlpha(dateL) : 0.0, (proxy && DMEffectiveAlpha(proxy) > 0) ? DMEffectiveAlpha(proxy) : 0.0);
        NSString *sig = [NSString stringWithFormat:@"%@ | DATEVIS=%.2f | date[%@] | proxy[%@] | time[%@] | app[%@]",
            NSStringFromClass([fg.window class]), dateVis, DMFlashDescribe(dateL, YES), DMFlashDescribe(proxy, NO),
            DMFlashDescribe(timeL, NO), DMFlashDescribe(appL, YES)];
        if ([sig isEqualToString:[gFlashLast objectForKey:fg]]) continue;
        [gFlashLast setObject:sig forKey:fg];
        DMLog([NSString stringWithFormat:@"[frame %.3f] %p %@", link.timestamp, fg, sig]);
    }
}
@end
static void DMUpdateFlashRecorder(void) {
    BOOL want = DMTestFlag("/tmp/macstatusbar-flash");
    if (want && !gFlashLink) {
        gFlashLink = [CADisplayLink displayLinkWithTarget:[DMFlashRecorder new] selector:@selector(frame:)];
        [gFlashLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
        DMLog(@"[flash] recorder started");
    } else if (!want && gFlashLink) {
        [gFlashLink invalidate];
        gFlashLink = nil;
        DMLog(@"[flash] recorder stopped");
    }
}
#endif   // ===== end of the test machinery =====
static CGFloat DMEffectiveAlpha(UIView *v) {
    CGFloat a = 1.0;
    for (UIView *x = v; x; x = x.superview) {
        CALayer *pl = x.layer.presentationLayer ?: x.layer;
        a *= x.hidden ? 0.0 : pl.opacity;
        if (a < 0.001) return 0.0;
    }
    return a;
}
// ---- one clock while two status bars crossfade ----
// Opening an app over another gives two status bar copies for a moment (the old app's and the new app's) that crossfade. The old one is
// carried along by the app's zoom animation, so its clock sits some 40-50 pt away from the new one's and both show at once. While two
// copies are visible only the more opaque one draws the clock (time, date and the search icon); the other's is hidden.
@interface DMClockBalancer : NSObject
- (void)frame:(CADisplayLink *)link;
@end
static CADisplayLink *gBalanceLink = nil;
static NSMapTable<UIScreen *, UIView *> *gClockOwners = nil;   // per screen: the copy drawing the clock while two are visible there
static NSArray<UIView *> *DMVisibleCopies(void) {
    NSMutableArray *visible = [NSMutableArray array];
    for (UIView *fg in gCopies.allObjects)
        if (fg.window && !fg.window.hidden && fg.bounds.size.width > 300.0 && DMEffectiveAlpha(fg) > 0.02) [visible addObject:fg];
    return visible;
}
// The crossfade is between two copies on the SAME screen. With an external display connected (TrollPad) the TV has its own status bar copy,
// steadily visible next to the iPad's: balancing across screens took the clock away from one of them (the iPad showed no time or date at all
// while connected, 26 Sep). So copies are balanced per screen; a screen with one copy keeps its clock.
static NSArray<NSArray<UIView *> *> *DMCopiesByScreen(NSArray<UIView *> *visible) {
    NSMapTable<UIScreen *, NSMutableArray *> *groups = [NSMapTable strongToStrongObjectsMapTable];
    NSMutableArray *order = [NSMutableArray array];
    for (UIView *fg in visible) {
        UIScreen *sc = fg.window.screen ?: [UIScreen mainScreen];
        NSMutableArray *g = [groups objectForKey:sc];
        if (!g) { g = [NSMutableArray array]; [groups setObject:g forKey:sc]; [order addObject:g]; }
        [g addObject:fg];
    }
    return order;
}
static BOOL DMAnyScreenHasTwoCopies(NSArray<UIView *> *visible) {
    if (visible.count < 2) return NO;
    for (NSArray *g in DMCopiesByScreen(visible)) if (g.count >= 2) return YES;
    return NO;
}
static void DMSetClockSuppressed(UIView *fg, BOOL suppressed) {
    BOOL was = [objc_getAssociatedObject(fg, kClockSuppressedKey) boolValue];
    if (was == suppressed && !suppressed) return;   // nothing to restore
    objc_setAssociatedObject(fg, kClockSuppressedKey, suppressed ? @YES : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UIView *container = DMLeadingContainer(fg);
    UIView *timeL = container ? DMFirstStringView(container) : nil;
    CGFloat a = suppressed ? 0.0 : 1.0;
    ((UIView *)objc_getAssociatedObject(fg, kDateProxyKey)).alpha = a;
    ((UIView *)objc_getAssociatedObject(fg, kSpotIconKey)).alpha = a;
    ((UIView *)objc_getAssociatedObject(fg, kSpotButtonKey)).alpha = a;
    if (timeL) timeL.alpha = a;
}
// Battery (layering audit F2): the link is for the crossfade (~0.3 s). A steady state with two copies visible (a window over a full-screen app,
// the status bar over a game) kept it running every frame for as long as it lasted. Once the copies and their opacities have not changed for
// 0.5 s the link pauses with the clock left where it is; the 0.25 s tick (DMStartClockBalanceIfNeeded) restarts it when anything changes and
// gives the clock back when only one copy is left.
static NSString *gBalanceSig = nil;          // the copies and their opacities as last seen
static CFTimeInterval gBalanceSteadySince = 0;
static BOOL gBalancePaused = NO;             // paused while steady (the clocks stay as they were balanced)
static NSString *DMBalanceSignature(NSArray<UIView *> *visible) {
    NSMutableString *sig = [NSMutableString string];
    for (UIView *fg in visible) [sig appendFormat:@"%p:%.2f;", fg, DMEffectiveAlpha(fg)];
    return sig;
}
static void DMClockBalanceRestore(void) {   // back to a single status bar: give the clock back
    for (UIView *fg in gCopies.allObjects) DMSetClockSuppressed(fg, NO);
    [gClockOwners removeAllObjects];
    [gBalanceLink invalidate];
    gBalanceLink = nil;
    gBalancePaused = NO; gBalanceSig = nil;
    DMLog(@"[clock] one status bar again: clock restored");
}
@implementation DMClockBalancer
- (void)frame:(CADisplayLink *)link {
    NSArray<UIView *> *visible = DMVisibleCopies();
    if (!DMAnyScreenHasTwoCopies(visible)) { DMClockBalanceRestore(); return; }
    if (!gClockOwners) gClockOwners = [NSMapTable weakToWeakObjectsMapTable];
    for (NSArray<UIView *> *group in DMCopiesByScreen(visible)) {
        UIScreen *sc = group[0].window.screen ?: [UIScreen mainScreen];
        if (group.count < 2) { DMSetClockSuppressed(group[0], NO); [gClockOwners removeObjectForKey:sc]; continue; }   // (alone on its screen: its own clock)
        UIView *best = group[0];
        for (UIView *fg in group) if (DMEffectiveAlpha(fg) > DMEffectiveAlpha(best)) best = fg;
        UIView *owner = [gClockOwners objectForKey:sc];
        // keep the current owner unless another copy is clearly more opaque (no flicker when they are level)
        if (!owner || ![group containsObject:owner] || DMEffectiveAlpha(best) > DMEffectiveAlpha(owner) + 0.03) owner = best;
        if (owner != [gClockOwners objectForKey:sc]) { [gClockOwners setObject:owner forKey:sc]; DMLog([NSString stringWithFormat:@"[clock] two status bars: the clock is drawn by %p", owner]); }
        for (UIView *fg in group) DMSetClockSuppressed(fg, fg != owner);
    }
    NSString *sig = DMBalanceSignature(visible);
    CFTimeInterval now = CACurrentMediaTime();
    if (![sig isEqualToString:gBalanceSig]) { gBalanceSig = sig; gBalanceSteadySince = now; return; }
    if (now - gBalanceSteadySince >= 0.5) {
        [gBalanceLink invalidate];
        gBalanceLink = nil;
        gBalancePaused = YES;
        DMLog(@"[clock] two status bars, steady for 0.5 s: balancing paused (the tick resumes it on a change)");
    }
}
@end
#if DEBUG
void DMClockTree(void) {   // (debug, trigger clocktree: every view of each copy's clock area -- screen frame, alpha, hidden, text -- and the opacity of every ancestor)
    for (UIView *fg in gCopies.allObjects) {
        UIView *container = DMLeadingContainer(fg);
        NSMutableString *m = [NSMutableString stringWithFormat:@"[clocktree] copy %p in %@ effective %.2f; ancestors:", fg, NSStringFromClass([fg.window class]), DMEffectiveAlpha(fg)];
        for (UIView *x = fg; x; x = x.superview) { CALayer *pl = x.layer.presentationLayer ?: x.layer; [m appendFormat:@" %@(%.2f%@)", NSStringFromClass([x class]), pl.opacity, x.hidden ? @" hidden" : @""]; }
        DMLog(m);
        for (UIView *v in container.subviews) {
            NSString *text = [v respondsToSelector:@selector(text)] ? [(id)v text] : nil;
            DMLog([NSString stringWithFormat:@"[clocktree]    %@ screen %@ alpha %.2f hidden %d text %@", NSStringFromClass([v class]), NSStringFromCGRect([v convertRect:v.bounds toView:nil]), v.alpha, v.hidden, text ?: @"-"]);
            for (UIView *w in v.subviews) { NSString *t2 = [w respondsToSelector:@selector(text)] ? [(id)w text] : nil; DMLog([NSString stringWithFormat:@"[clocktree]       %@ screen %@ alpha %.2f hidden %d text %@", NSStringFromClass([w class]), NSStringFromCGRect([w convertRect:w.bounds toView:nil]), w.alpha, w.hidden, t2 ?: @"-"]); }
        }
    }
}
#endif
void DMClockDiag(void) {
    for (UIView *fg in gCopies.allObjects) {
        UIView *container = DMLeadingContainer(fg); UIView *timeL = container ? DMFirstStringView(container) : nil;
        DMLog([NSString stringWithFormat:@"[clockdiag] %p in %@ (level %.0f, hidden %d) width %.0f alpha %.2f effective %.2f suppressed %d time alpha %.2f text %@ (%@ hidden %d frame %@, container %@ subviews %lu)", fg, NSStringFromClass([fg.window class]), fg.window.windowLevel, fg.window.hidden, fg.bounds.size.width, fg.alpha, DMEffectiveAlpha(fg), [objc_getAssociatedObject(fg, kClockSuppressedKey) boolValue], timeL.alpha, [timeL respondsToSelector:@selector(text)] ? [(id)timeL text] : @"-", NSStringFromClass([timeL class]), timeL.hidden, NSStringFromCGRect(timeL.frame), NSStringFromClass([container class]), (unsigned long)container.subviews.count]);
    }
}
static void DMStartClockBalanceIfNeeded(void) {
    if (gBalanceLink) return;
    NSArray<UIView *> *visible = DMVisibleCopies();
    if (!DMAnyScreenHasTwoCopies(visible)) { if (gBalancePaused || gClockOwners.count) DMClockBalanceRestore(); return; }
    if (gBalancePaused && [DMBalanceSignature(visible) isEqualToString:gBalanceSig]) return;   // (still steady: stays paused)
    gBalancePaused = NO; gBalanceSig = nil;
    gBalanceLink = [CADisplayLink displayLinkWithTarget:[DMClockBalancer new] selector:@selector(frame:)];
    [gBalanceLink addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[clock] two status bars are visible: balancing the clock");
}

static NSString *gLastFront = nil;
static long gLastSecond = -1;
static BOOL DMSSHSessionActive(void) {
    int mib[3] = { CTL_KERN, KERN_PROC, KERN_PROC_ALL };
    size_t len = 0;
    if (sysctl(mib, 3, NULL, &len, NULL, 0) != 0 || len == 0) return NO;
    struct kinfo_proc *procs = malloc(len);
    if (!procs) return NO;
    BOOL found = NO;
    if (sysctl(mib, 3, procs, &len, NULL, 0) == 0) {
        size_t n = len / sizeof(struct kinfo_proc);
        for (size_t i = 0; i < n; i++) if (strcmp(procs[i].kp_proc.p_comm, "sshd") == 0) { found = YES; break; }
    }
    free(procs);
    return found;
}
// The SSH icon is shown while OpenSSH is switched on (the Mac Settings helper keeps that in a file), like the VPN icon while a VPN is on. Without
// that helper (no state file) it is shown while somebody is connected instead.
static BOOL DMSSHOn(void) {
    FILE *f = fopen("/var/jb/var/lib/sshtoggled-engines/ssh-state", "r");   // (the root helper's own state file since the hardening)
    if (!f) f = fopen("/var/jb/var/mobile/.sshtoggle-state", "r");   // (the old one, still written for one release)
    if (f) { int c = fgetc(f); fclose(f); return c == '1'; }
    // (no state file: the process-list scan is expensive -- it ran 4 times a second; its answer is kept for 10 s)
    static BOOL cached = NO; static CFTimeInterval at = -100;
    if (CACurrentMediaTime() - at > 10.0) { at = CACurrentMediaTime(); cached = DMSSHSessionActive(); }
    return cached;
}
// A VPN app (almost every one) sets itself up as a Network Extension tunnel provider, a separate config from Apple's own "Personal
// VPN" (NEVPNManager on its own only sees that classic kind). Asking every configured tunnel provider for its own connection status is how the real
// status bar's VPN glyph itself knows, and it also gives the provider's app: what "the connected VPN app" tapping the icon opens.
// The app behind a VPN tunnel. The tunnel config names its provider EXTENSION (e.g. com.example.vpn.PacketTunnel), which cannot be
// opened: "Open <app>" did nothing (28 Sep). The extension's containing app; else the longest prefix of the id that is an installed app
// (com.example.vpn); else nil (the menu then offers only VPN & Device Management). Cached per provider.
static NSString *DMVPNAppForProvider(NSString *provider) {
    if (!provider.length) return nil;
    static NSMutableDictionary<NSString *, NSString *> *cache = nil;
    @synchronized ([NSNull null]) {
        if (!cache) cache = [NSMutableDictionary dictionary];
        NSString *hit = cache[provider];
        if (hit) return hit.length ? hit : nil;
    }
    NSString *app = nil;
    Class pk = objc_getClass("LSPlugInKitProxy");
    SEL sel = NSSelectorFromString(@"pluginKitProxyForIdentifier:");
    id plugin = [pk respondsToSelector:sel] ? ((id (*)(id, SEL, id))objc_msgSend)(pk, sel, provider) : nil;
    id container = DMCall(plugin, @"containingBundle");
    if ([DMCall(container, @"bundleIdentifier") isKindOfClass:[NSString class]]) app = DMCall(container, @"bundleIdentifier");
    if (!app) {
        NSArray<NSString *> *parts = [provider componentsSeparatedByString:@"."];
        for (NSUInteger n = parts.count; n >= 2 && !app; n--) {
            NSString *candidate = [[parts subarrayWithRange:NSMakeRange(0, n)] componentsJoinedByString:@"."];
            if (DMCall(DMProxyForBundle(candidate), @"bundleURL")) app = candidate;   // (installed: an app proxy with a bundle)
        }
    }
    DMLog([NSString stringWithFormat:@"[vpn] tunnel provider %@ -> app %@", provider, app ?: @"none found"]);
    @synchronized ([NSNull null]) { cache[provider] = app ?: @""; }
    return app;
}
static void DMVPNRiskUpdate(BOOL busy) {
#if DEBUG
    if (gVPNFakeProvider) busy = YES;   // (tests: the fake VPN counts for the respring warning too)
#endif
    static BOOL last = NO; static long offAt = 0;
    if (last && !busy) offAt = (long)time(NULL);
    if (last != busy) DMLog([NSString stringWithFormat:@"[vpnwarn] VPN %@ (respring warning %@)", busy ? @"on / connecting / on demand" : @"off", busy ? @"armed" : @"for 2 more minutes"]);
    last = busy;
    MSBDVPNRiskPublish(busy, offAt);
}
static void DMRefreshVPNState(void) {
    void (^apply)(BOOL, NSString *, NSString *, NSString *, NEVPNManager *) = ^(BOOL active, NSString *bundleID, NSString *name, NSString *configName, NEVPNManager *manager) {
#if DEBUG
        if (gVPNFakeProvider) { active = YES; bundleID = DMVPNAppForProvider(gVPNFakeProvider); name = bundleID ? (DMCall(DMProxyForBundle(bundleID), @"localizedName") ?: bundleID) : nil; configName = name; manager = nil; }
#endif
        dispatch_async(dispatch_get_main_queue(), ^{
            // (nil-safe: with no VPN app both are nil, and [nil isEqualToString:nil] is NO -- that counted as a change every refresh, logging a line
            // and re-laying out every status bar copy every few seconds)
            BOOL sameApp = (gVPNAppBundleID == nil && bundleID == nil) || [gVPNAppBundleID isEqualToString:bundleID];
            BOOL changed = active != gVPNActive || !sameApp, was = gVPNActive;
            gVPNActive = active; gVPNAppBundleID = bundleID; gVPNAppName = name; gVPNConfigName = configName; gVPNManager = active ? manager : nil;
            if (changed) {
                DMLog([NSString stringWithFormat:@"[vpn] status bar icon %@ (%@)", active ? @"on" : @"off", bundleID ?: @"no app found"]);
                for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout];
                if (active && !was) for (UIView *fg in gCopies.allObjects) if (objc_getAssociatedObject(fg, kLogoKey)) DMStockVPNRecheck(fg);   // (iOS's badge out now that ours shows)
            }
        });
    };
    Class mgrClass = NSClassFromString(@"NETunnelProviderManager");
    if (![mgrClass respondsToSelector:@selector(loadAllFromPreferencesWithCompletionHandler:)]) {
        NEVPNManager *m = [NEVPNManager sharedManager];
        apply(m.connection.status == NEVPNStatusConnected, nil, nil, m.localizedDescription, m);
        return;
    }
    // (performance audit P3) The configured tunnel providers are loaded once (an XPC round trip to nehelper) and kept; their connections' status is
    // then read from the kept objects, which NetworkExtension keeps current. The list is loaded again when the VPN configuration changes (its
    // notification), and, with no VPN configured at all, at most once a minute as a safety net. A status change updates the icon at once.
    static NSArray<NETunnelProviderManager *> *kept = nil;
    static BOOL loading = NO, observing = NO;
    static CFTimeInterval loadedAt = -1000;
    void (^evaluate)(NSArray<NETunnelProviderManager *> *) = ^(NSArray<NETunnelProviderManager *> *managers) {
        // (for the respring warning, VPNRespring.h: any VPN on, on its way up or down, or on demand -- it reconnects at the respring)
        BOOL busy = NO;
        NSMutableArray<NEVPNManager *> *all = [NSMutableArray arrayWithArray:managers ?: @[]];
        [all addObject:[NEVPNManager sharedManager]];
        for (NEVPNManager *m in all) {
            NEVPNStatus st = m.connection.status;
            if (st == NEVPNStatusConnected || st == NEVPNStatusConnecting || st == NEVPNStatusReasserting || st == NEVPNStatusDisconnecting || (m.isEnabled && m.isOnDemandEnabled)) busy = YES;
        }
        dispatch_async(dispatch_get_main_queue(), ^{ DMVPNRiskUpdate(busy); });
        NETunnelProviderManager *connected = nil;
        for (NETunnelProviderManager *m in managers) if (m.connection.status == NEVPNStatusConnected || m.connection.status == NEVPNStatusConnecting) { connected = m; break; }
        if (!connected) { NEVPNManager *m = [NEVPNManager sharedManager]; apply(m.connection.status == NEVPNStatusConnected, nil, nil, m.localizedDescription, m); return; }
        NSString *bundleID = nil;
        if ([connected.protocolConfiguration respondsToSelector:@selector(providerBundleIdentifier)])
            bundleID = DMVPNAppForProvider(((NETunnelProviderProtocol *)connected.protocolConfiguration).providerBundleIdentifier);
        NSString *name = bundleID.length ? (DMCall(DMProxyForBundle(bundleID), @"localizedName") ?: connected.localizedDescription) : connected.localizedDescription;
        apply(connected.connection.status == NEVPNStatusConnected, bundleID, name, connected.localizedDescription, connected);
    };
    if (!observing) {
        observing = YES;
        [[NSNotificationCenter defaultCenter] addObserverForName:NEVPNConfigurationChangeNotification object:nil queue:[NSOperationQueue mainQueue] usingBlock:^(NSNotification *n) {
            kept = nil; DMRefreshVPNState();   // (a VPN added, removed or changed: the list again)
        }];
        [[NSNotificationCenter defaultCenter] addObserverForName:NEVPNStatusDidChangeNotification object:nil queue:[NSOperationQueue mainQueue] usingBlock:^(NSNotification *n) {
            DMRefreshVPNState();   // (connected / disconnected: from the kept list, no reload)
        }];
    }
    BOOL stale = !kept || (kept.count == 0 && CACurrentMediaTime() - loadedAt > 60.0);
    if (!stale) { evaluate(kept); return; }
    if (loading) return;
    loading = YES;
    [mgrClass loadAllFromPreferencesWithCompletionHandler:^(NSArray<NETunnelProviderManager *> *managers, NSError *error) {
        dispatch_async(dispatch_get_main_queue(), ^{ loading = NO; kept = managers ?: @[]; loadedAt = CACurrentMediaTime(); });
        evaluate(managers);
    }];
}
// Aerial 5.0: the rest of what the 3.0 hooks did, done from outside on the same tick (no Aerial class is hooked or subclassed):
//  - a new window: the full-screen guard is lifted, the windows come forward over a full-screen app, and once the app is attached the window is
//    cascaded / tiled (Fit to Window) exactly like on 3.0 (-initWithBundleID: / -layoutSubviews hooks there);
//  - an empty leftover content view Aerial leaves over a re-hosted app is hidden (-didAddSubview: hook there);
//  - a drag or resize by hand is seen through Aerial's own gesture recognizers' state (read only) and, when it ends, the new place is remembered,
//    the window leaves the tiling group and the window state is saved (-handlePan: / -handleResizeBR: hooks there);
//  - Aerial's window layer is kept at our level (it resets it to 1033; -setWindowLevel: hook there);
//  - a window that goes away (closed from Aerial's own menu, too) gives its app the full screen back (+closeAerialForBundle: hook there).
static const void *kA5SeenKey = &kA5SeenKey, *kA5AttachedKey = &kA5AttachedKey, *kA5GestureKey = &kA5GestureKey;
static NSMutableSet<NSString *> *gA5Bundles;
BOOL gRestoringWindowsFlag(void);
static void DMAerial5Lights(void);
// Aerial 5.0: our Mac window look, applied from outside on every tick (and a few quick extra passes right after a window appears). Nothing of
// Aerial's is replaced: its frosted frame is hidden and a plain view of ours (the "chrome": title-strip colour, rounded outline) sits behind
// everything at index 0; the app's holder gets the system base colour instead of white; Aerial's "..." menu and its white handles are hidden
// (the handles stay touchable at alpha 0.011, with our small grips drawn where the resizing corners are); a Mac-like shadow goes on the window.
// Every property is only written when it differs, so a pass that finds everything in place changes nothing (no flicker from re-asserting).
static const void *kA5RimKey = &kA5RimKey;
static const void *kA5ChromeKey = &kA5ChromeKey, *kA5GripBLKey = &kA5GripBLKey, *kA5GripBRKey = &kA5GripBRKey, *kA5VeilKey = &kA5VeilKey;
static int gA5Rewrites = 0;   // how often a styled window had to be styled again (Aerial re-applying its own look): logged once a minute
static void DMA5Set(UIView *v, BOOL hidden, CGFloat alpha) { if (v.hidden != hidden || fabs(v.alpha - alpha) > 0.001) gA5Rewrites++; if (v.hidden != hidden) v.hidden = hidden; if (fabs(v.alpha - alpha) > 0.001) v.alpha = alpha; }
// Is our view (the lights) covered by something the user could actually see? Aerial's layout pass puts its own hidden "..." button and its near-transparent
// grips back above our views each time; raising ours over them on every tick re-ran Aerial's layout, which re-sent the app its scene settings: a fight at
// tick rate that woke every windowed app ~4 times a second (iPad 2: [scene-upd] every 0.26 s per window, traced to these raises). Only a visible view
// (alpha > 0.05) above ours that overlaps it counts.
static BOOL DMA5ViewCovered(UIView *stage, UIView *v) {
    NSArray<UIView *> *subs = stage.subviews;
    NSUInteger at = [subs indexOfObjectIdenticalTo:v];
    for (NSUInteger i = (at == NSNotFound ? 0 : at + 1); i < subs.count; i++)
        if (!subs[i].hidden && subs[i].alpha > 0.05 && CGRectIntersectsRect(subs[i].frame, v.frame)) return YES;
    return NO;
}
// Aerial 5.0's resize handles are laid out by Aerial below the app, so with the 3.0 shape most of each one sits in the invisible margin under the
// window and only a thin band of it overlaps the window's corner (UIKit hit-testing follows the stage's draw offset, see DMA5StageShift). Each of our
// grips therefore sits in a 32 pt corner box of ours -- the size of Aerial 3.0's handle, over the window's corner -- that hands every touch it gets
// to Aerial's own handle: the whole corner resizes the window, with Aerial's own resize code and feel.
@interface DMA5GripBox : UIView <UIGestureRecognizerDelegate>
@property (nonatomic, weak) UIView *handle;
- (void)watchHandle;
@end
static char kA5GripDownKey, kA5GripTargetKey;
@implementation DMA5GripBox
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    UIView *h = self.handle;
    if (self.hidden || !h || h.hidden || !h.userInteractionEnabled || ![self pointInside:point withEvent:event]) return nil;
    return h;
}
// (set up once per handle, from the theme pass: our target on Aerial's resize recogniser, and a recogniser of ours that never recognises anything
// but notes where each finger goes down on the handle -- the touch reaches the handle directly or through this box)
- (void)watchHandle {
    UIView *h = self.handle;
    if (!h || objc_getAssociatedObject(h, &kA5GripTargetKey)) return;
    objc_setAssociatedObject(h, &kA5GripTargetKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    for (UIGestureRecognizer *g in h.gestureRecognizers) if ([g isKindOfClass:[UIPanGestureRecognizer class]]) [g addTarget:self action:@selector(resizeCatchUp:)];
    UIGestureRecognizer *note = [[UIGestureRecognizer alloc] initWithTarget:nil action:NULL];
    note.cancelsTouchesInView = NO; note.delaysTouchesBegan = NO; note.delaysTouchesEnded = NO; note.delegate = (id<UIGestureRecognizerDelegate>)self;
    [h addGestureRecognizer:note];
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)touch {
    UIView *stage = self.superview;
    if (stage.superview && g.view) objc_setAssociatedObject(g.view, &kA5GripDownKey, [NSValue valueWithCGPoint:[touch locationInView:stage.superview]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    return NO;
}
// Like a title-bar drag (DMA5DragGuard -dragTrace:), a corner resize used to lag the finger by Aerial's recogniser threshold (~10-13 pt): when the resize
// starts, the window's corner is moved once by the distance the finger already went (Aerial then goes on by deltas from there).
- (void)resizeCatchUp:(UIPanGestureRecognizer *)g {
    UIView *h = g.view, *stage = self.superview;
    static char kOffsetKey;
    if (!stage.superview) return;
    // Aerial sizes the window from where its recogniser started, which leaves out the distance the finger went before that (~10-13 pt): that
    // distance is added to the corner after each of Aerial's own steps (our target runs after Aerial's), so the corner stays under the finger.
    if (g.state == UIGestureRecognizerStateBegan) {
        NSValue *down = objc_getAssociatedObject(h, &kA5GripDownKey);
        objc_setAssociatedObject(h, &kA5GripDownKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        CGPoint now = [g locationInView:stage.superview];
        CGPoint d = down ? CGPointMake(now.x - down.CGPointValue.x, now.y - down.CGPointValue.y) : CGPointZero;
        objc_setAssociatedObject(g, &kOffsetKey, (hypot(d.x, d.y) >= 0.5 && hypot(d.x, d.y) <= 40) ? [NSValue valueWithCGPoint:d] : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    NSValue *dv = objc_getAssociatedObject(g, &kOffsetKey);
    if (DMTestFlag("/tmp/msb-a5-dragtrace")) DMLog([NSString stringWithFormat:@"[a5drag] resize trace state %ld location %@ stage %@ catch-up %@", (long)g.state, NSStringFromCGPoint([g locationInView:stage.superview]), NSStringFromCGRect(stage.frame), dv ? NSStringFromCGPoint(dv.CGPointValue) : @"-"]);
    if (!dv || g.state == UIGestureRecognizerStateBegan) return;
    CGPoint d = dv.CGPointValue;
    BOOL left = CGRectGetMidX(self.frame) < stage.bounds.size.width / 2;
    CGRect f = stage.frame;
    if (left) { f.origin.x += d.x; f.size.width -= d.x; } else f.size.width += d.x;
    f.size.height += d.y;
    if (f.size.width >= 200 && f.size.height >= 150) stage.frame = f;
    if (g.state != UIGestureRecognizerStateChanged) objc_setAssociatedObject(g, &kOffsetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
@end
// ---- Aerial 5.0: the window flies in out of the full-screen app, like on Aerial 3.0 (DMBeginStageEntrance) ----------------------------------------
// The status bar's green turns the full-screen app into a window. A picture of the full-screen app is taken first (DMStageCoverPrepare); when the new
// stage shows up it is made the size of the whole screen (its app area exactly the screen, the title bar above it, off the top), the picture goes over
// its app area and the cover goes away -- nothing on screen has changed -- and then the window springs into its place while the picture shrinks into
// the app area; the picture stays until the app has drawn at its window size (DMVeilCheck). Aerial's own fade-in is stopped. Our chrome, rim, grips
// and the veil keep their distance to the stage's edges by autoresizing, so they follow the same animation.
static void DMAerial5Theme(UIView *stage);
static UIEdgeInsets DMA5InsetsOf(UIView *stage);   // (defined with the theme)
static BOOL DMAerial5GestureLive(UIView *stage);
static const void *kA5EntranceTargetKey = &kA5EntranceTargetKey;   // where the fly-in entrance lands (NSValue CGRect)
static const void *kA5EntranceUntilKey = &kA5EntranceUntilKey;     // held there until (CACurrentMediaTime)
static const void *kA5EntranceSizeKey = &kA5EntranceSizeKey;       // for this screen size
static const void *kA5PutBackTimesKey = &kA5PutBackTimesKey;       // when the hold last put it back (the last 0.25 s)
static const void *kA5PutBackCountKey = &kA5PutBackCountKey;       // how often in this hold
// Called before every Core Animation commit (DMA5CatchNewStages): a window flying in (or just landed) that Aerial has moved or resized away from its
// entrance's target is put back before the change is ever drawn. The model frame goes back without an animation, so the running fly-in
// animation (from/to values of its own) goes on undisturbed; an animation Aerial added for its change is taken off.
static NSHashTable<UIView *> *gA5HeldStages = nil;   // the windows whose entrance frame is held (weak)
static void DMA5HoldEntranceFrame(UIView *stage) {
    NSValue *tv = objc_getAssociatedObject(stage, kA5EntranceTargetKey);
    if (!tv) { [gA5HeldStages removeObject:stage]; return; }
    NSNumber *until = objc_getAssociatedObject(stage, kA5EntranceUntilKey);
    NSValue *forSize = objc_getAssociatedObject(stage, kA5EntranceSizeKey);
    BOOL turned = forSize && !CGSizeEqualToSize(forSize.CGSizeValue, [UIScreen mainScreen].bounds.size);   // (the screen turned: that place was for the other shape)
    if (!until || turned || CACurrentMediaTime() > until.doubleValue || DMStageMinimized(stage) || [objc_getAssociatedObject(stage, kStageClosingKey) boolValue] || DMAerial5GestureLive(stage)) {
        [gA5HeldStages removeObject:stage];
        DMLog([NSString stringWithFormat:@"[aerial5] %@: placement hold ends (%@)", DMStageBundle(stage), turned ? @"the screen turned" : (!until || CACurrentMediaTime() > until.doubleValue) ? @"time" : (DMStageMinimized(stage) ? @"minimized" : (DMAerial5GestureLive(stage) ? @"gesture" : @"closing"))]);
        objc_setAssociatedObject(stage, kA5EntranceTargetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(stage, kA5EntranceUntilKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    if (!CGAffineTransformIsIdentity(stage.transform)) return;   // (Aerial's opening zoom from a Dock icon runs: its frame is not its place)
    CGRect want = tv.CGRectValue, f = stage.frame;
    if (fabs(f.origin.x - want.origin.x) < 0.5 && fabs(f.origin.y - want.origin.y) < 0.5 && fabs(f.size.width - want.size.width) < 0.5 && fabs(f.size.height - want.size.height) < 0.5) return;
    // Fight breaker: Aerial putting it somewhere again right after every put-back is not a one-off late pass (those come 1-4 times) -- holding on
    // would fight it on every frame, with a scene update to the app each time.
    CFTimeInterval tnow = CACurrentMediaTime();
    NSMutableArray<NSNumber *> *recent = objc_getAssociatedObject(stage, kA5PutBackTimesKey);
    if (!recent) { recent = [NSMutableArray array]; objc_setAssociatedObject(stage, kA5PutBackTimesKey, recent, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    [recent addObject:@(tnow)];
    while (recent.count && tnow - recent.firstObject.doubleValue > 0.25) [recent removeObjectAtIndex:0];
    int total = [objc_getAssociatedObject(stage, kA5PutBackCountKey) intValue] + 1;
    objc_setAssociatedObject(stage, kA5PutBackCountKey, @(total), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    CGRect aerialFit = DMA5AerialFit(want);
    if (recent.count >= 6 && !DMA5RectsClose(aerialFit, want) && DMA5RectsClose(f, aerialFit)) {   // (Aerial fits windows into the screen here, every time)
        long o = DMRealInterfaceOrientation();
        if (o >= 1 && o <= 4) gA5FitsInOrientation |= (uint8_t)(1 << o);
        CGRect keep = DMA5KeepableFrame(want);
        DMLog([NSString stringWithFormat:@"[aerial5] %@: Aerial fits every window into the screen inset by 20 pt in orientation %ld (after each change): held at %@ instead of %@, and the layouts keep inside it here", DMStageBundle(stage), o, NSStringFromCGRect(keep), NSStringFromCGRect(want)]);
        want = keep;
        objc_setAssociatedObject(stage, kA5EntranceTargetKey, [NSValue valueWithCGRect:want], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [recent removeAllObjects];
    } else if (recent.count >= 12 || total > 40) {   // (anything else Aerial keeps doing: given up, no storm)
        [gA5HeldStages removeObject:stage];
        DMLog([NSString stringWithFormat:@"[aerial5] %@: placement hold ends (Aerial moved it again %lu times in 0.25 s, %d in all: not fought over)", DMStageBundle(stage), (unsigned long)recent.count, total]);
        objc_setAssociatedObject(stage, kA5EntranceTargetKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(stage, kA5EntranceUntilKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        return;
    }
    DMAerial5SyncState(stage, want);   // (Aerial's remembered frame for this orientation is the one it puts back)
    BOOL entering = [objc_getAssociatedObject(stage, kStageEnteringKey) boolValue];
    NSMutableArray *keys = [NSMutableArray array];
    for (NSString *k in stage.layer.animationKeys ?: @[]) [keys addObject:k];
    DMLog([NSString stringWithFormat:@"[aerial5] %@: Aerial %@ it %@ -> %@ while %@: put back before it is drawn (layer animations: %@)", DMStageBundle(stage),
           CGSizeEqualToSize(f.size, want.size) ? @"moved" : @"resized", NSStringFromCGRect(want), NSStringFromCGRect(f), entering ? @"flying in" : @"just placed", [keys componentsJoinedByString:@","]]);
    [UIView performWithoutAnimation:^{ stage.frame = want; [stage layoutIfNeeded]; }];
}
void DMA5HoldEntranceFrameNow(UIView *stage) { DMA5HoldEntranceFrame(stage); }
static void DMA5HoldStageAt(UIView *stage, CGRect target, CFTimeInterval until) {
    if (!stage) return;
    objc_setAssociatedObject(stage, kA5EntranceTargetKey, [NSValue valueWithCGRect:target], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kA5EntranceUntilKey, @(until), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kA5EntranceSizeKey, [NSValue valueWithCGSize:[UIScreen mainScreen].bounds.size], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kA5PutBackTimesKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kA5PutBackCountKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (!gA5HeldStages) gA5HeldStages = [NSHashTable weakObjectsHashTable];
    [gA5HeldStages addObject:stage];
}
static void DMAerial5BeginEntrance(UIView *stage) {
    UIWindow *host = DMStatusBarWindow();
    UIView *snap = gVeilSnap;
    gVeilSnap = nil;
    if (!host || !snap || !gStageCover) return;
    CGRect target = stage.frame;
    NSString *bundle = DMStageBundle(stage);
    if (bundle.length && [gA5EntranceBundle isEqualToString:bundle] && CACurrentMediaTime() - gA5EntranceAt < 4.0 && !CGRectIsEmpty(gA5EntranceFrame)) {
        // the frame the Window menu asked for (Aerial may open the window at a frame of its own, e.g. the one it remembers for the app)
        if (!CGRectEqualToRect(target, gA5EntranceFrame)) DMLog([NSString stringWithFormat:@"[aerial5] %@: opened at %@, flies to the frame asked for %@", bundle, NSStringFromCGRect(target), NSStringFromCGRect(gA5EntranceFrame)]);
        target = gA5EntranceFrame;
    }
    gA5EntranceBundle = nil;
    // Held until shortly after the landing: Aerial's fit-to-screen pass comes ~0.15 s after the window appears and shrinks a window that reaches past
    // the screen's edges (Fill: 780 x 919 became 728 x 858, centred, iPad 2), which the landing then kept. Put back before each commit (DMA5HoldEntranceFrame).
    target = DMA5KeepableFrame(target);   // (see DMA5AerialFitsHere)
    if (!DMTestFlag("/tmp/msb-a5-nohold")) DMA5HoldStageAt(stage, target, CACurrentMediaTime() + 1.5);   // (debug kill switch: the old behaviour)
    if (DMTestFlag("/tmp/msb-a5-entrylog")) {   // (debug: the window's on-screen frame on every display frame of the entrance, 0.9 s)
        DMBlockLink *rec = [DMBlockLink new];
        __weak UIView *ws = stage; CFTimeInterval t0 = CACurrentMediaTime();
        rec.block = ^BOOL{
            UIView *s = ws; if (!s) return NO;
            CALayer *pl = s.layer.presentationLayer;
            DMLog([NSString stringWithFormat:@"[a5entry] +%.3f on screen %@ model %@", CACurrentMediaTime() - t0, pl ? NSStringFromCGRect(pl.frame) : @"-", NSStringFromCGRect(s.frame)]);
            return CACurrentMediaTime() - t0 < 0.9;
        };
        [rec start];
    }
    DMSetStageIntent(stage, target);
    CGSize sc = host.bounds.size, ss = snap.bounds.size;
    UIEdgeInsets m = DMA5InsetsOf(stage);
    CGRect full = DMA5StageFromWindow(CGRectMake(0, -kStageBarHeight, sc.width, sc.height + kStageBarHeight));
    DMAerial5SyncState(stage, target);
    UIView *veil = [[UIView alloc] initWithFrame:CGRectMake(m.left, m.top, full.size.width - m.left - m.right, full.size.height - m.top - m.bottom)];
    veil.accessibilityIdentifier = @"MSBVeil-entrance";
    veil.backgroundColor = gVeilColor ?: [UIColor systemBackgroundColor];
    veil.clipsToBounds = YES; veil.userInteractionEnabled = NO;
    veil.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    snap.layer.anchorPoint = CGPointZero;
    snap.frame = CGRectMake(0, 0, ss.width, ss.height);
    snap.transform = CGAffineTransformIdentity;
    [veil addSubview:snap];
    objc_setAssociatedObject(stage, kA5VeilKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // (the theme adds no veil of its own)
    objc_setAssociatedObject(stage, kStageVeilViewKey, veil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kStageCascadedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // placed by the entrance, not tiled again
    objc_setAssociatedObject(stage, kStageEnteringKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    DMAerial5Theme(stage);   // chrome, rim, grips in place before the first frame
    UIView *in = DMStageInnerView(stage);
    UIView *lights = objc_getAssociatedObject(stage, kStageLightsKey);
    if (in) [stage insertSubview:veil aboveSubview:in]; else if (lights) [stage insertSubview:veil belowSubview:lights]; else [stage addSubview:veil];
    UIView *chrome = objc_getAssociatedObject(stage, kA5ChromeKey), *rim = objc_getAssociatedObject(stage, kA5RimKey);
    if (MSBReduceMotion()) {
        // Reduce Motion: no flight out of the full screen. The window is put straight into the state the spring below ends in and fades in
        // while the full-screen picture under it fades out (the lights fade in where they are, DMDropLights).
        CGFloat cw = target.size.width - m.left - m.right, ch = target.size.height - m.top - m.bottom;
        CGFloat rx = cw / ss.width, ry = ch / (ss.height - kStageBarHeight);
        SEL rmScale = DMAerialSel(@"adjustContentScaleToHost");
        UIView *cover = gStageCover;
        [UIView performWithoutAnimation:^{
            [stage.layer removeAllAnimations];   // Aerial's own fade / scale-in
            stage.transform = CGAffineTransformIdentity;
            stage.frame = target;
            veil.frame = CGRectMake(m.left, m.top, cw, ch);
            [stage layoutIfNeeded];
            chrome.layer.cornerRadius = kMilkyWayCorner; rim.layer.cornerRadius = kMilkyWayCorner; veil.layer.cornerRadius = kMilkyWayCorner;
            snap.transform = CGAffineTransformMake(rx, 0, 0, ry, 0, -kStageBarHeight * ry);
            if ([stage respondsToSelector:rmScale]) ((void (*)(id, SEL))objc_msgSend)(stage, rmScale);
            stage.alpha = 0.0;
        }];
        [UIView animateWithDuration:kMSBRMDuration delay:0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionAllowUserInteraction
                         animations:^{ stage.alpha = 1.0; cover.alpha = 0.0; }
                         completion:^(BOOL finished) {
            if (cover && gStageCover == cover) DMStageCoverRemove();
            objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMRememberStageFrame(stage);
        }];
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); });   // safety
        if ([lights isKindOfClass:[UIView class]] && gShowWindowButtons) { lights.alpha = 0.0; DMDropLights(stage, lights); }
        DMLog([NSString stringWithFormat:@"[aerial5] %@: window fading in from full screen to %@ (Reduce Motion)", DMStageBundle(stage), NSStringFromCGRect(target)]);
        DMVeilCheck(stage, veil, CACurrentMediaTime());
        return;
    }
    [UIView performWithoutAnimation:^{
        [stage.layer removeAllAnimations];   // Aerial's own fade / scale-in
        stage.transform = CGAffineTransformIdentity;
        stage.alpha = 1.0;
        stage.frame = full;
        [stage layoutIfNeeded];
        chrome.layer.cornerRadius = 0.0; rim.layer.cornerRadius = 0.0; veil.layer.cornerRadius = 0.0;   // the full screen has square corners
    }];
    DMStageCoverRemove();   // the window now shows exactly what the cover showed
    CGFloat contentW = target.size.width - m.left - m.right, contentH = target.size.height - m.top - m.bottom;
    CGFloat ex = contentW / ss.width, ey = contentH / (ss.height - kStageBarHeight);
    SEL scaleSel = DMAerialSel(@"adjustContentScaleToHost");
    [UIView animateWithDuration:0.46 delay:0 usingSpringWithDamping:0.86 initialSpringVelocity:0
                        options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction animations:^{
        stage.frame = target;
        [stage layoutIfNeeded];
        chrome.layer.cornerRadius = kMilkyWayCorner; rim.layer.cornerRadius = kMilkyWayCorner; veil.layer.cornerRadius = kMilkyWayCorner;
        snap.transform = CGAffineTransformMake(ex, 0, 0, ey, 0, -kStageBarHeight * ey);   // the full-screen app's status bar strip goes under the title bar
        if ([stage respondsToSelector:scaleSel]) ((void (*)(id, SEL))objc_msgSend)(stage, scaleSel);
    } completion:^(BOOL finished) {
        objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMRememberStageFrame(stage);
    }];
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ objc_setAssociatedObject(stage, kStageEnteringKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); });   // safety
    if ([lights isKindOfClass:[UIView class]] && gShowWindowButtons) {   // the status bar's lights drop into the title bar, like on 3.0
        lights.alpha = 0.0;
        __weak UIView *wl = lights;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ UIView *l = wl; if (l) DMDropLights(stage, l); });
    }
    DMLog([NSString stringWithFormat:@"[aerial5] %@: window flying in from full screen to %@", DMStageBundle(stage), NSStringFromCGRect(target)]);
    DMVeilCheck(stage, veil, CACurrentMediaTime());
}
// Aerial 5.0's margins around the app inside a stage are NOT the same for every window: on the M1 (iOS 15) some windows measured 13/6/12/6 while
// the rest had 13/6/20/6, and a resize in progress measures in-between values (19.6, iPad 2). The one global value used to follow whichever window
// was themed last, so it flipped, and with it every layout's stage frame (window heights 668 / 676 on the M1), the chrome of every other window
// (drawn 8 pt off its app) and the "put back" checks. Now each window keeps its own measured margins for drawing its chrome (DMA5InsetsOf), and
// the standard margins that the layouts use (gA5Insets) change only when a settled measurement differs on windows of two different apps while no
// settled window still has the old value (an Aerial update that changes its layout) -- never because of one odd window.
static const void *kA5StageInsetsKey = &kA5StageInsetsKey;   // this window's own margins (NSValue UIEdgeInsets)
static const void *kA5InsetsNotedKey = &kA5InsetsNotedKey;   // the odd margins already logged for it
static BOOL DMA5InsetsSame(UIEdgeInsets a, UIEdgeInsets b) { return fabs(a.top - b.top) <= 0.25 && fabs(a.left - b.left) <= 0.25 && fabs(a.bottom - b.bottom) <= 0.25 && fabs(a.right - b.right) <= 0.25; }
static UIEdgeInsets DMA5InsetsOf(UIView *stage) {
    NSValue *v = stage ? objc_getAssociatedObject(stage, kA5StageInsetsKey) : nil;
    return v ? v.UIEdgeInsetsValue : gA5Insets;
}
static void DMA5NoteStageInsets(UIView *stage, UIEdgeInsets m, UIView *holder) {
    NSValue *prev = objc_getAssociatedObject(stage, kA5StageInsetsKey);
    BOOL stable = prev && DMA5InsetsSame(prev.UIEdgeInsetsValue, m);
    if (!stable) objc_setAssociatedObject(stage, kA5StageInsetsKey, [NSValue valueWithUIEdgeInsets:m], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (!stable || DMA5InsetsSame(m, gA5Insets)) return;
    // settled: the same on two passes, nothing moving it (no animation, gesture, entrance or opening zoom), the app not scaled inside it
    NSNumber *born = objc_getAssociatedObject(stage, kA5BornKey);
    if (!born || CACurrentMediaTime() - born.doubleValue < 1.0 || stage.layer.animationKeys.count || holder.layer.animationKeys.count || !CGAffineTransformIsIdentity(holder.transform)
        || !CGAffineTransformIsIdentity(stage.transform) || DMAerial5GestureLive(stage) || [objc_getAssociatedObject(stage, kStageEnteringKey) boolValue]) return;
    NSValue *noted = objc_getAssociatedObject(stage, kA5InsetsNotedKey);
    if (!noted || !DMA5InsetsSame(noted.UIEdgeInsetsValue, m)) {
        objc_setAssociatedObject(stage, kA5InsetsNotedKey, [NSValue valueWithUIEdgeInsets:m], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMLog([NSString stringWithFormat:@"[aerial5] %@: its own app holder margins are %.1f/%.1f/%.1f/%.1f, the standard ones %.1f/%.1f/%.1f/%.1f: its chrome follows its own, the layouts keep the standard (frame %@)",
               DMStageBundle(stage), m.top, m.left, m.bottom, m.right, gA5Insets.top, gA5Insets.left, gA5Insets.bottom, gA5Insets.right, NSStringFromCGRect(stage.frame)]);
    }
    NSMutableSet<NSString *> *agree = [NSMutableSet set];
    for (UIView *st in DMAerialStages()) {
        NSValue *v = objc_getAssociatedObject(st, kA5StageInsetsKey);
        if (!v || st.hidden || DMStageMinimized(st)) continue;
        if (DMA5InsetsSame(v.UIEdgeInsetsValue, gA5Insets)) return;   // a window still has the standard margins: they stay
        if (DMA5InsetsSame(v.UIEdgeInsetsValue, m) && DMStageBundle(st).length) [agree addObject:DMStageBundle(st)];
    }
    if (agree.count < 2) return;
    DMLog([NSString stringWithFormat:@"[aerial5] app holder margins are now %.1f/%.1f/%.1f/%.1f in every window (%lu apps; were %.1f/%.1f/%.1f/%.1f): the layouts use them",
           m.top, m.left, m.bottom, m.right, (unsigned long)agree.count, gA5Insets.top, gA5Insets.left, gA5Insets.bottom, gA5Insets.right]);
    gA5Insets = m;
}
static void DMAerial5Theme(UIView *stage) {
    if (gA5ThemeOff) return;
    BOOL dark = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
    UIColor *base = dark ? [UIColor blackColor] : [UIColor whiteColor];
    UIColor *bar = dark ? [UIColor colorWithWhite:0.19 alpha:1.0] : [UIColor colorWithWhite:0.91 alpha:1.0];
    BOOL minimized = [DMStageValue(stage, @[@"_isMinimized"]) boolValue];
    CGSize S = stage.bounds.size;
    // 1. Aerial's "..." menu: not wanted (the Window menu and our lights do its job)
    UIView *menu = DMStageValue(stage, @[@"_menuButton"]);
    if ([menu isKindOfClass:[UIView class]]) { DMA5Set(menu, YES, 0.0); if (menu.userInteractionEnabled) menu.userInteractionEnabled = NO; }
    // 2. the frame: Aerial's frosted material hidden, our chrome behind everything. The chrome IS the window, drawn like Aerial 3.0's: the 24 pt
    //    title bar right above the app, the app edge to edge under it, 12 pt continuous corners, a hairline -- see DMA5StageFromWindow for why it is
    //    smaller than the stage. It keeps its distance to the stage's edges by autoresizing, so it follows every animated move or resize of the stage
    //    in the same animation (a frame written from the tick lagged behind Aerial's animations).
    UIView *chrome = objc_getAssociatedObject(stage, kA5ChromeKey);
    UIView *in0 = DMStageInnerView(stage);
    if (in0 && !minimized && S.width > 150.0 && S.height > 150.0) {   // Aerial's own margins, measured (the same for every window; kept for the layouts)
        CGRect h = in0.frame;
        UIEdgeInsets m = UIEdgeInsetsMake(h.origin.y, h.origin.x, S.height - CGRectGetMaxY(h), S.width - CGRectGetMaxX(h));
        // (a brand-new stage can have its holder still filling it for a moment -- measured 0/0/0.4/0 once, and a Fit move made then used those
        // margins -- so only a real Aerial layout, with its strip and margins, counts)
        BOOL sane = m.top >= 5 && m.top <= 40 && m.left >= 1 && m.left <= 30 && m.bottom >= 5 && m.bottom <= 40 && m.right >= 1 && m.right <= 30;
        if (sane) DMA5NoteStageInsets(stage, m, in0);
    }
    for (UIView *v in stage.subviews) if ([v isKindOfClass:[UIVisualEffectView class]] && fabs(v.bounds.size.width - S.width) < 1.5 && fabs(v.bounds.size.height - S.height) < 1.5) {   // (Aerial rounds its size: 898.5 in a 898.85 stage)
        if (!minimized && !v.hidden) { v.hidden = YES; gA5Rewrites++; }
        if (minimized && v.hidden) v.hidden = NO;   // the minimized chip keeps Aerial's own look
    }
    CGFloat radius = kMilkyWayCorner;
    if (!chrome) {
        chrome = [[UIView alloc] init];
        chrome.userInteractionEnabled = NO;
        chrome.accessibilityIdentifier = @"MSBChrome";
        chrome.layer.cornerCurve = kCACornerCurveContinuous;
        chrome.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        objc_setAssociatedObject(stage, kA5ChromeKey, chrome, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMLog([NSString stringWithFormat:@"[aerial5] %@: Mac window theme applied (Aerial 3.0 shape, holder margins %.0f/%.0f/%.0f/%.0f)", DMStageBundle(stage), gA5Insets.top, gA5Insets.left, gA5Insets.bottom, gA5Insets.right]);
    }
    if (chrome.superview != stage || stage.subviews.firstObject != chrome) [stage insertSubview:chrome atIndex:0];
    UIEdgeInsets mi = DMA5InsetsOf(stage);   // (this window's own margins: they are not the same for every window, see DMA5NoteStageInsets)
    CGRect cf = CGRectMake(mi.left, mi.top - kStageBarHeight, S.width - mi.left - mi.right, S.height - mi.top - mi.bottom + kStageBarHeight);
    { CGRect c0 = chrome.frame; if (fabs(c0.origin.x - cf.origin.x) > 0.25 || fabs(c0.origin.y - cf.origin.y) > 0.25 || fabs(c0.size.width - cf.size.width) > 0.25 || fabs(c0.size.height - cf.size.height) > 0.25) chrome.frame = cf; }
    if (chrome.hidden != minimized) chrome.hidden = minimized;
    if (![chrome.backgroundColor isEqual:bar]) chrome.backgroundColor = bar;
    if (fabs(chrome.layer.cornerRadius - radius) > 0.01) chrome.layer.cornerRadius = radius;
    if (chrome.layer.borderWidth != 0.0) chrome.layer.borderWidth = 0.0;
    // the hairline goes on a rim of ours ABOVE the app (Aerial 3.0 draws it on the stage's own layer, over the content): on the chrome, under the
    // app, it only showed along the title bar (measured: 3.0's left/bottom edge pixel 64 on dark, ours 30)
    UIView *rim = objc_getAssociatedObject(stage, kA5RimKey);
    if (!rim) {
        rim = [[UIView alloc] init];
        rim.userInteractionEnabled = NO; rim.accessibilityIdentifier = @"MSBRim"; rim.backgroundColor = nil;
        rim.layer.cornerRadius = radius; rim.layer.cornerCurve = kCACornerCurveContinuous; rim.layer.borderWidth = 0.5;
        rim.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        objc_setAssociatedObject(stage, kA5RimKey, rim, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    { CGRect r0 = rim.frame; if (fabs(r0.origin.x - cf.origin.x) > 0.25 || fabs(r0.origin.y - cf.origin.y) > 0.25 || fabs(r0.size.width - cf.size.width) > 0.25 || fabs(r0.size.height - cf.size.height) > 0.25) rim.frame = cf; }
    if (rim.hidden != minimized) rim.hidden = minimized;
    if (in0) {
        NSArray *subs = stage.subviews; NSUInteger ii = [subs indexOfObjectIdenticalTo:in0], ri = [subs indexOfObjectIdenticalTo:rim];
        if (rim.superview != stage || ri == NSNotFound || ri < ii) [stage insertSubview:rim aboveSubview:in0];
    }
    CGColorRef border = (dark ? [UIColor colorWithWhite:1.0 alpha:0.16] : [UIColor colorWithWhite:0.0 alpha:0.14]).CGColor;
    if (!CGColorEqualToColor(rim.layer.borderColor, border)) rim.layer.borderColor = border;
    // 3. no shadow: Aerial 3.0's windows have none (measured on captures: the pixels right outside a 3.0 window are untouched); Aerial 5.0's own
    //    stage shadow is switched off while it is a window (a minimized chip keeps Aerial's look)
    CALayer *L = stage.layer;
    if (!minimized && L.shadowOpacity != 0.0f) L.shadowOpacity = 0.0f;
    // 3b. the app's corners: square at the top (right under the title bar), the window's 12 pt at the bottom. Aerial rounds its holder by 30 pt
    //     on every layout pass; its own radius is disarmed (no corners masked) and a mask of ours does the rounding (see DMA5SyncHostMask).
    if (in0 && !minimized && in0.layer.maskedCorners != 0) in0.layer.maskedCorners = 0;
    // 4. no white: the app's holder and any big plain view waiting for the app take the base colour
    UIView *inner = DMStageInnerView(stage);
    for (UIView *v in stage.subviews) {
        if (v == chrome || [v.accessibilityIdentifier hasPrefix:@"MSB"] || ![NSStringFromClass([v class]) isEqualToString:@"UIView"] || v.hidden) continue;
        if (v.bounds.size.width <= 200.0 || v.bounds.size.height <= 100.0 || !v.backgroundColor) continue;
        CGFloat a = 0; [v.backgroundColor getWhite:NULL alpha:&a];
        if (a < 0.5) continue;   // Aerial's near-transparent touch overlay stays as it is
        if (![v.backgroundColor isEqual:base]) { v.backgroundColor = base; gA5Rewrites++; }
    }
    // 5. Aerial's white handles: invisible but still touchable; our grips at the two resizing corners
    if (!minimized) {
        for (NSString *key in @[@"_handleBL", @"_handleBR", @"_handleTL", @"_handleTR", @"_minusHandle"]) {
            UIView *h = DMStageValue(stage, @[key]);
            if ([h isKindOfClass:[UIView class]] && !h.hidden && fabs(h.alpha - 0.011) > 0.001) { h.alpha = 0.011; gA5Rewrites++; }
        }
        for (int side = 0; side < 2; side++) {
            UIView *h = DMStageValue(stage, @[side == 0 ? @"_handleBL" : @"_handleBR"]);
            const void *key = side == 0 ? kA5GripBLKey : kA5GripBRKey;
            // the grip sits in a small holder of ours that keeps its distance to the window's bottom corner by autoresizing (so it moves with the
            // window in the same animation); where Aerial 3.0 has it: 12 pt in from the window's corner
            DMA5GripBox *box = objc_getAssociatedObject(stage, key);
            if (!box) {
                box = [[DMA5GripBox alloc] initWithFrame:CGRectMake(0, 0, 32.0, 32.0)];
                box.accessibilityIdentifier = @"MSBGrip";
                box.autoresizingMask = UIViewAutoresizingFlexibleTopMargin | (side == 0 ? UIViewAutoresizingFlexibleRightMargin : UIViewAutoresizingFlexibleLeftMargin);
                UIView *g = DMMakeResizeGrip(); g.userInteractionEnabled = NO;
                g.center = CGPointMake(side == 0 ? kMilkyWayCorner : 32.0 - kMilkyWayCorner, 32.0 - kMilkyWayCorner);   // 12 pt in from the corner, like 3.0
                g.transform = CGAffineTransformMakeRotation(side == 0 ? -M_PI_4 : M_PI_4);
                [box addSubview:g];
                objc_setAssociatedObject(stage, key, box, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            if (box.superview != stage) [stage addSubview:box];
            BOOL live = [h isKindOfClass:[UIView class]] && !h.hidden;
            if (box.handle != h) box.handle = [h isKindOfClass:[UIView class]] ? h : nil;
            [box watchHandle];
            if (box.hidden == live) box.hidden = !live;
            if (!live) continue;
            UIView *grip = box.subviews.firstObject;
            UIColor *gc = DMResizeGripColorFor(DMStageBundle(stage), dark);
            if (![grip.backgroundColor isEqual:gc]) grip.backgroundColor = gc;
            CGRect bf = CGRectMake(side == 0 ? cf.origin.x : CGRectGetMaxX(cf) - 32.0, CGRectGetMaxY(cf) - 32.0, 32.0, 32.0);
            if (fabs(box.frame.origin.x - bf.origin.x) > 0.25 || fabs(box.frame.origin.y - bf.origin.y) > 0.25) box.frame = bf;
        }
    } else {
        for (int i = 0; i < 2; i++) { UIView *g = objc_getAssociatedObject(stage, i == 0 ? kA5GripBLKey : kA5GripBRKey); if (g && !g.hidden) g.hidden = YES; }
    }
    // 6. the veil: covers the app from the moment its content is attached until it has drawn and settled (then fades), like 3.0
    if (inner && !objc_getAssociatedObject(stage, kA5VeilKey)) {
        objc_setAssociatedObject(stage, kA5VeilKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        if (!gRestoringWindowsFlag() && !DMTestFlag("/tmp/msb-a5-noveil")) {
            UIView *veil = [[UIView alloc] initWithFrame:inner.frame];
            veil.accessibilityIdentifier = @"MSBVeil-a5";
            veil.backgroundColor = [UIColor systemBackgroundColor];
            veil.userInteractionEnabled = NO;
            veil.layer.cornerRadius = kMilkyWayCorner; veil.layer.cornerCurve = kCACornerCurveContinuous; veil.layer.maskedCorners = kCALayerMinXMaxYCorner | kCALayerMaxXMaxYCorner; veil.clipsToBounds = YES;
            [stage insertSubview:veil aboveSubview:inner];
            objc_setAssociatedObject(veil, kVeilQuickKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(stage, kStageVeilViewKey, veil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMAerialMarkWorking();   // (Aerial made a window: it is activated, whatever the 3 s check sees later -- DMAerialCheckItWorked)
            DMLog([NSString stringWithFormat:@"[veil] %@: new Aerial 5.0 window veiled until the app has drawn", DMStageBundle(stage)]);
            DMVeilCheck(stage, veil, CACurrentMediaTime());
        }
    }
    // (the app area's own rounded corners are left to Aerial: it re-applies its 30 pt radius on every layout pass -- measured live, 8 resets in 0.1 s)
    UIView *veil = objc_getAssociatedObject(stage, kStageVeilViewKey);
    if (veil.superview == stage && inner && !CGRectEqualToRect(veil.frame, inner.frame)) veil.frame = inner.frame;
    if (veil.superview == stage && inner && (veil.layer.cornerRadius != kMilkyWayCorner || veil.layer.maskedCorners != (kCALayerMinXMaxYCorner | kCALayerMaxXMaxYCorner))) {   // the app's own shape (see 3b)
        veil.layer.cornerRadius = kMilkyWayCorner; veil.layer.cornerCurve = kCACornerCurveContinuous; veil.layer.maskedCorners = kCALayerMinXMaxYCorner | kCALayerMaxXMaxYCorner;
    }
    // the lights and grips stay on top
    DMStageLights *lights = objc_getAssociatedObject(stage, kStageLightsKey);
    if (lights && stage.subviews.lastObject != lights && DMA5ViewCovered(stage, lights)) [stage bringSubviewToFront:lights];
}
// ---- Aerial 5.0: a window moves by its title strip only (like 3.0 and MilkyWay) ----------------------------------------------------------------
// Aerial 5.0 drags a window with a pan recogniser on the whole stage, so a touch or scroll inside the app first nudged the window. Without
// hooking Aerial, each stage gets one extra recogniser of ours that never recognises anything: its delegate is asked about every touch that
// lands in the window before any recogniser sees it move, and uses that moment to switch Aerial's drag recogniser on (touch in the title strip
// above the app) or off (touch anywhere else). Aerial's recogniser is only switched back on if we were the ones who switched it off, so its own
// "lock window" mode keeps working. Trackpad two-finger scrolling never drags a window (its scroll types are cleared).
static const void *kA5DragGuardKey = &kA5DragGuardKey, *kA5DragOffByUsKey = &kA5DragOffByUsKey;
static char kA5DragDownKey;   // (on Aerial's drag recogniser: where the finger went down, see -dragTrace:)
static UIPanGestureRecognizer *DMA5AerialDrag(UIView *stage) {
    for (UIGestureRecognizer *g in stage.gestureRecognizers)
        if ([g isMemberOfClass:[UIPanGestureRecognizer class]] && g != objc_getAssociatedObject(stage, kA5DragGuardKey)) return (UIPanGestureRecognizer *)g;
    return nil;
}
static BOOL DMA5DragAllowedAt(UIView *stage, CGPoint p) {   // p in the stage's coordinates
    UIView *inner = DMStageInnerView(stage);
    CGFloat stripBottom = (inner ? inner.frame.origin.y : 13.0) + (DMA5MacGeometry() ? DMA5StageShift() : 0.0);   // (a touch is where things are drawn)
    CGFloat stripTop = DMA5MacGeometry() ? stripBottom - kStageBarHeight - 4.0 : -12.0;   // our 24 pt title bar (it reaches above the stage) / Aerial's own strip
    CGFloat titleShift = DMAutoHideTitleShiftOf(stage);   // (slid down with the auto-hiding status bar: the strip is where it is drawn)
    stripTop += titleShift; stripBottom += titleShift;
    return p.y >= stripTop && p.y < stripBottom + 2.0 && p.x >= 0 && p.x <= stage.bounds.size.width;   // the title strip (plus the touch slop above it)
}
@interface DMA5DragGuard : NSObject <UIGestureRecognizerDelegate>
+ (instancetype)shared;
@end
@implementation DMA5DragGuard
+ (instancetype)shared { static DMA5DragGuard *g; static dispatch_once_t once; dispatch_once(&once, ^{ g = [DMA5DragGuard new]; }); return g; }
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)guard shouldReceiveTouch:(UITouch *)touch {
    UIView *stage = guard.view;
    // Also the delegate of Aerial's own drag recogniser (it has none of its own): that one only ever gets touches in the title strip. Before, the
    // guard switched it off for a touch inside the app and back on at the next touch in the title strip -- but by then UIKit had already left the
    // switched-off recogniser out of that touch, so the first title-bar drag after touching the app did nothing (iPad 2: a drag after a resize).
    if (stage && guard != objc_getAssociatedObject(stage, kA5DragGuardKey)) {
        BOOL ok = DMTestFlag("/tmp/msb-a5-dragall") || DMA5DragAllowedAt(stage, [touch locationInView:stage]);
        if (ok && DMAutoHideTopEdgeTouch(touch)) ok = NO;   // (the top edge swipe for Notification Center / Control Center wins)
        if (ok && stage.superview) objc_setAssociatedObject(guard, &kA5DragDownKey, [NSValue valueWithCGPoint:[touch locationInView:stage.superview]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // where the finger went down
        return ok;
    }
    UIPanGestureRecognizer *drag = stage ? DMA5AerialDrag(stage) : nil;
    if (!drag || DMTestFlag("/tmp/msb-a5-dragall")) return NO;   // debug: Aerial's own behaviour
    CGPoint p = [touch locationInView:stage];
    BOOL allow = DMA5DragAllowedAt(stage, p);
    UIView *frontStage = nil; for (UIView *s2 in DMAerialStages()) if (!s2.hidden) frontStage = s2;
    if (frontStage && frontStage != stage) {   // a touch into a window that is not in front: it comes forward (the app gets the touch too)
        SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded");
        __weak UIView *weakStage = stage;
        dispatch_async(dispatch_get_main_queue(), ^{ UIView *st = weakStage; if (st && [st respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(st, front); });
        DMLog([NSString stringWithFormat:@"[a5drag] %@: touched while behind another window: brought to the front", DMStageBundle(stage)]);
    }
    // (the drag itself is gated by our delegate on Aerial's recogniser, below; an old switched-off state from before is undone)
    if ([objc_getAssociatedObject(stage, kA5DragOffByUsKey) boolValue]) { drag.enabled = YES; objc_setAssociatedObject(stage, kA5DragOffByUsKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    static int logged = 0;
    if (logged++ < 30) DMLog([NSString stringWithFormat:@"[a5drag] %@: touch at %@ -> window drag %@", DMStageBundle(stage), NSStringFromCGPoint(p), allow ? @"allowed (title strip)" : @"off (inside the window)"]);
    return NO;   // the guard itself never takes part in the touch
}
// (debug trace, only while /tmp/msb-a5-dragtrace exists: every event of Aerial's drag recogniser with the stage frame, to measure how closely a
// dragged window follows the finger)
- (void)dragTrace:(UIPanGestureRecognizer *)g {
    UIView *stage = g.view;
    // A window follows the finger exactly: Aerial moves it only by what the finger does after its drag recogniser has started, which is some 10-13 pt
    // after the finger went down (the recogniser's own threshold), so a title-bar drag used to fall that far behind (iPad 2: ~80% of a short drag).
    // When the drag starts, the window is moved once by that missed distance (Aerial goes on from wherever the window is: it moves by deltas).
    if (g.state == UIGestureRecognizerStateBegan && stage.superview) {
        NSValue *down = objc_getAssociatedObject(g, &kA5DragDownKey);
        objc_setAssociatedObject(g, &kA5DragDownKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        CGPoint now = [g locationInView:stage.superview];
        CGFloat dx = down ? now.x - down.CGPointValue.x : 0, dy = down ? now.y - down.CGPointValue.y : 0;
        if (down && hypot(dx, dy) > 0.5 && hypot(dx, dy) < 40) stage.center = CGPointMake(stage.center.x + dx, stage.center.y + dy);
    }
    // Like a macOS window under the menu bar, a window's title bar is kept below our status bar (a drag could take it up over the status bar:
    // stage y 0, the window's title bar drawn over the menu titles). Aerial moves by deltas, so it simply goes on from the kept position.
    if ((g.state == UIGestureRecognizerStateChanged || g.state == UIGestureRecognizerStateEnded) && stage.frame.origin.y < DMTopLimit() && DMA5MacGeometry()) {
        CGRect f = stage.frame; f.origin.y = DMTopLimit(); stage.frame = f;
    }
    if (!DMTestFlag("/tmp/msb-a5-dragtrace")) return;
    DMLog([NSString stringWithFormat:@"[a5drag] trace state %ld location %@ translation %@ stage origin %@", (long)g.state, NSStringFromCGPoint([g locationInView:stage.superview]), NSStringFromCGPoint([g translationInView:stage.superview]), NSStringFromCGPoint(stage.frame.origin)]);
}
@end
static void DMAerial5DragGuard(UIView *stage) {
    UIPanGestureRecognizer *drag = DMA5AerialDrag(stage);
    if (!drag) return;
    if (!objc_getAssociatedObject(drag, @selector(dragTrace:))) { [drag addTarget:[DMA5DragGuard shared] action:@selector(dragTrace:)]; objc_setAssociatedObject(drag, @selector(dragTrace:), @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    if (drag.delegate == nil) { drag.delegate = [DMA5DragGuard shared]; DMLog([NSString stringWithFormat:@"[a5drag] %@: Aerial's drag recogniser now only takes title-strip touches", DMStageBundle(stage)]); }
    if ([drag respondsToSelector:@selector(setAllowedScrollTypesMask:)] && drag.allowedScrollTypesMask != 0) drag.allowedScrollTypesMask = 0;
    if (objc_getAssociatedObject(stage, kA5DragGuardKey)) return;
    UIGestureRecognizer *guard = [[UIGestureRecognizer alloc] initWithTarget:nil action:NULL];
    guard.cancelsTouchesInView = NO; guard.delaysTouchesBegan = NO; guard.delaysTouchesEnded = NO;
    guard.delegate = [DMA5DragGuard shared];
    objc_setAssociatedObject(stage, kA5DragGuardKey, guard, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [stage addGestureRecognizer:guard];
    DMLog([NSString stringWithFormat:@"[a5drag] %@: title-strip-only dragging set up (Aerial's drag recogniser %p)", DMStageBundle(stage), drag]);
}
static void DMAerial5HideLeftovers(UIView *stage) {
    UIView *inner = DMStageInnerView(stage);
    if (!inner) return;
    for (UIView *v in stage.subviews) {
        if (v == inner || v.hidden || ![NSStringFromClass([v class]) isEqualToString:@"UIView"] || v.subviews.count || !v.backgroundColor) continue;
        if (v.bounds.size.width <= 300.0 || v.bounds.size.height <= 100.0 || [v.accessibilityIdentifier hasPrefix:@"MSB"]) continue;   // (our own chrome and veils are not leftovers)
        CGFloat a = 0; [v.backgroundColor getWhite:NULL alpha:&a];
        if (a < 0.5) continue;   // Aerial's own near-transparent touch overlay (alpha 0.01) is not a leftover
        DMLog([NSString stringWithFormat:@"[aerial5] %@: an empty leftover content view (%@) hidden", DMStageBundle(stage), NSStringFromCGRect(v.frame)]);
        v.hidden = YES; v.userInteractionEnabled = NO;
    }
}
static BOOL DMAerial5GestureLive(UIView *stage) {   // a pan (move) or a resize handle's pan of this window is in progress
    NSMutableArray *views = [NSMutableArray arrayWithObject:stage];
    [views addObjectsFromArray:stage.subviews];
    for (UIView *v in views) for (UIGestureRecognizer *g in v.gestureRecognizers) {
        if (![g isKindOfClass:[UIPanGestureRecognizer class]]) continue;
        if (g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged) return YES;
    }
    return NO;
}
// Locking the screen: Aerial minimizes every window to its round chip (3.0: our -minimizeStage hook ignored that). 5.0: the windows that were not
// minimized when the lock began are brought back after the unlock with Aerial's own restore (its resolved -restoreFromMinimize).
static const void *kA5MinStateKey = &kA5MinStateKey, *kA5MinSinceKey = &kA5MinSinceKey;
static const void *kA5ChipHiddenKey = &kA5ChipHiddenKey, *kA5LockHiddenKey = &kA5LockHiddenKey, *kA5GoodFrameKey = &kA5GoodFrameKey;
static CFTimeInterval gA5UnlockedAt = 0;   // when the screen was last unlocked (DMAerial5WatchLock)
static void DMAerial5WatchLock(void) {
    static int wasLocked = -1; static CFTimeInterval lockedAt = 0;
    CFTimeInterval now = CACurrentMediaTime();
    for (UIView *s in DMAerialStages()) {   // when each window last changed between minimized and not (Aerial minimizes them right as the lock starts)
        NSNumber *cur = @([DMStageValue(s, @[@"_isMinimized"]) boolValue]);
        if (![objc_getAssociatedObject(s, kA5MinStateKey) isEqual:cur]) {
            objc_setAssociatedObject(s, kA5MinStateKey, cur, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(s, kA5MinSinceKey, @(now), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    }
    id mgr = DMSBManager("SBLockScreenManager");
    int locked = DMLockUp(mgr) ? 1 : 0;
    if (wasLocked == -1) { wasLocked = locked; return; }
    if (locked == wasLocked) return;
    wasLocked = locked;
    if (locked) { lockedAt = now; return; }
    gA5UnlockedAt = now;
    CFTimeInterval since = lockedAt;
    // windows whose chip was caught while locking: they come back by themselves (our restore animation), never shown as chips
    for (UIView *s in DMAerialStages()) if ([objc_getAssociatedObject(s, kA5LockHiddenKey) boolValue]) {
        objc_setAssociatedObject(s, kA5LockHiddenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        __weak UIView *weakS = s;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *st = weakS; if (!st) return;
            DMLog([NSString stringWithFormat:@"[aerial5] %@: back after the unlock (it was never shown as a round icon)", DMStageBundle(st)]);
            DMRestoreStage(st);
        });
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        SEL restore = DMAerialSel(@"restoreFromMinimize");
        for (UIView *s in DMAerialStages()) {
            NSNumber *when = objc_getAssociatedObject(s, kA5MinSinceKey);
            if (![DMStageValue(s, @[@"_isMinimized"]) boolValue] || !when || when.doubleValue < since - 2.0 || s.hidden || ![s respondsToSelector:restore]) continue;
            DMLog([NSString stringWithFormat:@"[aerial5] %@ was minimized by the lock: restored", DMStageBundle(s)]);
            ((void (*)(id, SEL))objc_msgSend)(s, restore);
        }
    });
}
// ---- Aerial 5.0: never show its round minimized icon ("chip") -------------------------------------------------------------------------------
// However a window gets minimized by Aerial (its "..." menu, a swipe on its bottom handle, the screen locking, anything internal), the moment its
// _isMinimized flag turns on -- checked on every display frame -- the window is hidden (so the chip is never drawn, or at most for a frame), put in
// OUR minimized state (the same one the yellow light uses: it comes back from its app icon / the Dock / the Window menu), and Aerial is told to
// restore it with its own resolved -restoreFromMinimize, so Aerial's own state is "a normal window" again (behind our hide). A window caught while
// the screen is locked is brought back by itself after the unlock.
static NSHashTable<UIView *> *gA5StageCache;
static ptrdiff_t gA5MinOffset = -1;
static BOOL DMA5ChipFlag(UIView *stage) {
    if (gA5MinOffset < 0) { Ivar iv = class_getInstanceVariable([stage class], "_isMinimized"); gA5MinOffset = iv ? ivar_getOffset(iv) : 0; }
    if (gA5MinOffset <= 0) return NO;
    return *(BOOL *)((uint8_t *)(__bridge void *)stage + gA5MinOffset);
}
static void DMAerial5CatchChip(UIView *stage) {
    if (DMTestFlag("/tmp/msb-a5-allowchip")) return;   // debug: leave Aerial's chip alone
    BOOL locked = DMLockUp(DMSBManager("SBLockScreenManager"));
    if (!stage.hidden) stage.hidden = YES;   // first: never let the chip be seen
    objc_setAssociatedObject(stage, kStageHiddenKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // our minimized state
    objc_setAssociatedObject(stage, kA5ChipHiddenKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (locked) objc_setAssociatedObject(stage, kA5LockHiddenKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    // Right after an unlock Aerial minimizes the windows once more (M1, Phase 2b: 16 ms after our "back after the unlock" restore every window was
    // minimized again and stayed hidden): a window caught within 0.5 s of the unlock was open before the lock, so it comes back once more.
    BOOL justUnlocked = !locked && gA5UnlockedAt > 0 && CACurrentMediaTime() - gA5UnlockedAt < 0.5;
    if (justUnlocked) {
        __weak UIView *ws = stage;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *st = ws; if (!st || ![objc_getAssociatedObject(st, kA5ChipHiddenKey) boolValue]) return;
            DMLog([NSString stringWithFormat:@"[aerial5] %@: minimized again right after the unlock -> back", DMStageBundle(st)]);
            DMRestoreStage(st);
        });
    }
    DMLog([NSString stringWithFormat:@"[aerial5] %@: Aerial minimized it to its round icon%@ -> hidden and turned into our minimize", DMStageBundle(stage), locked ? @" (screen locking)" : (justUnlocked ? @" (just after the unlock)" : @"")]);
    // Aerial's own state goes back to "a window" once its shrink animation has finished (restoring earlier left the window at the chip's size:
    // the end of Aerial's animation set the chip frame after the restore -- seen live), then the window's real frame is checked and put back.
    SEL restore = DMAerialSel(@"restoreFromMinimize");
    __weak UIView *weakStage = stage;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *st = weakStage;
        if (st && DMA5ChipFlag(st) && [st respondsToSelector:restore]) ((void (*)(id, SEL))objc_msgSend)(st, restore);
    });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIView *st = weakStage;
        if (!st || DMA5ChipFlag(st)) return;
        NSValue *good = objc_getAssociatedObject(st, kStageIntentKey) ?: objc_getAssociatedObject(st, kA5GoodFrameKey);
        CGRect f = st.frame;
        if (good && (f.size.width < 150.0 || f.size.height < 150.0 || !CGRectEqualToRect(f, good.CGRectValue))) {
            [UIView performWithoutAnimation:^{ st.transform = CGAffineTransformIdentity; st.frame = good.CGRectValue; [st layoutIfNeeded]; }];
            DMRefitStageScene(st);
            DMLog([NSString stringWithFormat:@"[aerial5] %@: window frame put back to %@ after Aerial's restore (was %@)", DMStageBundle(st), NSStringFromCGRect(good.CGRectValue), NSStringFromCGRect(f)]);
        } else DMLog([NSString stringWithFormat:@"[aerial5] %@: Aerial's restore left it at %@", DMStageBundle(st), NSStringFromCGRect(f)]);
    });
    DMApplyWindowLevel();
}
// The app's corners in the Aerial 3.0 shape (see 3b in DMAerial5Theme): a mask layer of ours on Aerial's app holder, square on top, the window's
// 12 pt at the bottom. It is kept at the holder's size on every display frame; when the holder is resized inside an animation (a layout, a tile
// move, Aerial's own resize) the holder's running size animation is copied onto the mask, so both move together.
static const void *kA5MaskKey = &kA5MaskKey;
static void DMA5SyncHostMaskFor(UIView *stage, UIView *holder);
static int gA5FrameMutations = 0;   // (counts every change the frame watcher makes: its idle pause, DMA5FrameWatcher)
static void DMA5SyncHostMask(UIView *stage) { DMA5SyncHostMaskFor(stage, nil); }
static void DMA5SyncHostMaskFor(UIView *stage, UIView *holder) {
    BOOL on = DMA5MacGeometry() && !DMStageMinimized(stage) && ![objc_getAssociatedObject(stage, kA5ChipHiddenKey) boolValue];
    CATransform3D want = on ? CATransform3DMakeTranslation(0, DMA5StageShift(), 0) : CATransform3DIdentity;
    if (!CATransform3DEqualToTransform(stage.layer.sublayerTransform, want)) {
        [CATransaction begin]; [CATransaction setDisableActions:YES];
        stage.layer.sublayerTransform = want;
        [CATransaction commit];
        gA5FrameMutations++;
    }
    if (!on) return;
    UIView *in = holder ?: DMStageInnerView(stage);
    if (!in) return;
    CALayer *m = objc_getAssociatedObject(in, kA5MaskKey);
    if (!m) {
        m = [CALayer layer];
        m.anchorPoint = CGPointZero; m.position = CGPointZero;
        m.backgroundColor = [UIColor blackColor].CGColor;
        m.cornerRadius = kMilkyWayCorner; m.cornerCurve = kCACornerCurveContinuous;
        m.maskedCorners = kCALayerMinXMaxYCorner | kCALayerMaxXMaxYCorner;
        objc_setAssociatedObject(in, kA5MaskKey, m, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    CGSize b = in.layer.bounds.size;
    if (in.layer.mask != m) {
        static int told = 0;
        if (in.layer.mask && told++ < 5) DMLog([NSString stringWithFormat:@"[aerial5] %@: the app holder had another mask (%@): ours put back", DMStageBundle(stage), in.layer.mask]);
        [CATransaction begin]; [CATransaction setDisableActions:YES];
        m.bounds = CGRectMake(0, 0, b.width, b.height);
        in.layer.mask = m;
        [CATransaction commit];
        gA5FrameMutations++;
    }
    if (fabs(m.bounds.size.width - b.width) > 0.01 || fabs(m.bounds.size.height - b.height) > 0.01) {
        [CATransaction begin]; [CATransaction setDisableActions:YES];
        m.bounds = CGRectMake(0, 0, b.width, b.height);
        [CATransaction commit];
        gA5FrameMutations++;
        for (NSString *k in in.layer.animationKeys) {
            CAAnimation *a = [in.layer animationForKey:k];
            NSString *path = [a isKindOfClass:[CAPropertyAnimation class]] ? ((CAPropertyAnimation *)a).keyPath : nil;
            if ([path isEqualToString:@"bounds"] || [path hasPrefix:@"bounds.size"]) [m addAnimation:[a copy] forKey:k];
        }
    }
}
// Is any Aerial 5.0 window on screen? With every window minimized (hidden) there is nothing for the per-frame watcher to do, and a display link
// that keeps asking for frames kept the idle Home Screen waking SpringBoard (and the render server) 60 times a second (2026-09-25).
static BOOL DMA5AnyStageShowing(void) {
    for (UIView *st in gA5StageCache.allObjects) if (!st.hidden && st.window && st.alpha > 0.01) return YES;
    return NO;
}
@interface DMA5FrameWatcher : NSObject
- (void)tick:(CADisplayLink *)link;
- (void)frameBody:(CADisplayLink *)link keep:(BOOL)keepOverlay;
@end
// Idle pause (layering audit F2): with a window open the watcher ran every frame (60 Hz) even while nothing moved. Everything it corrects is
// changed by Aerial inside SpringBoard's run loop, and the pre-commit catcher (DMA5CatchNewStages -> DMA5WakeFrameWatcher) runs one pass before
// every commit, so while idle the per-frame link can rest: after 1 s in which the pass changed nothing and no window moved, resized, showed/hid or
// animated, the link pauses (gA5IdlePaused) and each pre-commit pass checks for activity, restarting the link on the first sign. /tmp/msb-a5-framekeep:
// the old per-frame behaviour (a fallback without a new build).
static BOOL gA5IdlePaused = NO;
static CFTimeInterval gA5LastActive = 0;
static NSString *DMA5ActivitySignature(void) {   // where the windows are and whether anything on them animates
    NSMutableString *sig = [NSMutableString string];
    for (UIView *st in gA5StageCache.allObjects) {
        UIView *in = DMStageInnerView(st);
        CGRect f = st.frame, ib = in.bounds;
        [sig appendFormat:@"%p %.1f %.1f %.1f %.1f %d %.2f %lu %.1f %.1f %lu;", st, f.origin.x, f.origin.y, f.size.width, f.size.height, st.hidden, st.alpha,
            (unsigned long)st.layer.animationKeys.count, ib.size.width, ib.size.height, (unsigned long)in.layer.animationKeys.count];
    }
    return sig;
}
static BOOL DMA5NoteActivity(void) {   // YES when something changed since the last look (the pass's own changes, or the windows)
    static int mutationsSeen = -1; static NSString *lastSig = nil;
    NSString *sig = DMA5ActivitySignature();
    BOOL active = gA5FrameMutations != mutationsSeen || ![sig isEqualToString:lastSig];
    mutationsSeen = gA5FrameMutations; lastSig = sig;
    return active;
}
@implementation DMA5FrameWatcher
- (void)tick:(CADisplayLink *)link {
    static BOOL keepOverlay = NO, keepFrames = NO; static CFTimeInterval checkedAt = -10;   // (debug flags: read once a second, not every frame)
    if (link.timestamp - checkedAt > 1.0) { checkedAt = link.timestamp; keepOverlay = DMTestFlag("/tmp/msb-a5-keepoverlay"); keepFrames = DMTestFlag("/tmp/msb-a5-framekeep"); }
    if (!gA5StageCache.count || gDMScreenOff || !DMA5AnyStageShowing()) { link.paused = YES; gA5IdlePaused = NO; return; }   // (nothing to watch: stopped until a window is on screen again, DMAerial5StartFrameWatcher / DMA5WakeFrameWatcher)
    DM_PERF("a5frame", [self frameBody:link keep:keepOverlay]);
    CFTimeInterval now = CACurrentMediaTime();
    if (DMA5NoteActivity() || keepFrames) gA5LastActive = now;
    else if (now - gA5LastActive > 1.0) {
        link.paused = YES; gA5IdlePaused = YES;
        static int told = 0; if (told++ < 20) DMLog(@"[aerial5] frame watch idle for 1 s: paused (a pass still runs before every commit)");
    }
}
- (void)frameBody:(CADisplayLink *)link keep:(BOOL)keepOverlay {
    static Ivar overlayIvar = NULL; static BOOL looked = NO;
    for (UIView *stage in gA5StageCache.allObjects) {
        DMA5SyncHostMask(stage);
        // Aerial 5.0 lays a near-transparent "interaction overlay" over the app of every window that is not in front, so the first touch only
        // brings the window forward: a background window could not be scrolled. Aerial 3.0 had the same overlay and our 3.0 styling hid it (as an
        // empty leftover view); here it is hidden on every display frame (Aerial shows it again whenever the front window changes), and a touch
        // into a background window brings it forward through our drag guard instead (DMA5DragGuard), while the app gets the touch as well.
        if (!keepOverlay) {
            if (!looked) { looked = YES; overlayIvar = class_getInstanceVariable([stage class], "_interactionOverlay"); }
            UIView *ov = overlayIvar ? object_getIvar(stage, overlayIvar) : nil;
            if ([ov isKindOfClass:[UIView class]] && (!ov.hidden || ov.userInteractionEnabled)) {
                ov.hidden = YES; ov.userInteractionEnabled = NO; gA5FrameMutations++;
                static int n = 0; if (n++ < 10) DMLog([NSString stringWithFormat:@"[a5drag] %@: Aerial's touch shield over a background window removed", DMStageBundle(stage)]);
            }
        }
        if ([objc_getAssociatedObject(stage, kA5ChipHiddenKey) boolValue]) {
            if (![objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) { objc_setAssociatedObject(stage, kA5ChipHiddenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); continue; }   // brought back by us
            if (!stage.hidden) { stage.hidden = YES; gA5FrameMutations++; }   // Aerial's restore must not show it again: it stays minimized our way
            continue;
        }
        if (DMA5ChipFlag(stage)) { DMAerial5CatchChip(stage); gA5FrameMutations++; }
    }
}
@end
static CADisplayLink *gA5FrameLink = nil;
static DMA5FrameWatcher *gA5FrameWatcher = nil;
static void DMAerial5StartFrameWatcher(void) {
    if (gStockBar) return;   // (stock status bar: no per-frame watch)
    CADisplayLink *link = gA5FrameLink;
    if (link) { if (link.paused && !gA5IdlePaused && gA5StageCache.count && !gDMScreenOff && DMA5AnyStageShowing()) { link.paused = NO; gA5LastActive = CACurrentMediaTime(); } return; }   // (idle-paused: the pre-commit pass wakes it)
    gA5FrameWatcher = [DMA5FrameWatcher new];
    link = [CADisplayLink displayLinkWithTarget:gA5FrameWatcher selector:@selector(tick:)];
    // (perf: capped at 60 frames a second. Uncapped it ran at 120 on the M1's ProMotion screen -- 1,200 passes per 10 s -- and a display link
    // that asks for every frame keeps the screen refreshing at 120 Hz while any window is open. 60 is what the 60 Hz iPads have always had.)
    link.preferredFramesPerSecond = 60;
    gA5FrameLink = link;
    [link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
    DMLog(@"[aerial5] per-frame watch for Aerial's round icon started");
}
// ---- Aerial 5.0's own settings, swallowed while it is our engine ----
// Requirement: "when Aerial 5.0 is our engine all its own customizations should be swallowed/ignored by our tweak". Everything a user can change in
// Aerial's Settings page (and through its icon menu) is held at the value our integration is built and tested for -- Aerial's own default,
// except three we need: its menu's Minimize off and its bottom handle in Resize Mode (both lead to Aerial's round chip otherwise), and "Use New
// Rotation Method" on for iOS 16 / off for iOS 15 (the other value draws the windows sideways; measured live with raw screen captures). The
// icon-menu items "Enable/Disable flex resize" and "Enable/Disable keyboard avoidance" are hidden, since the per-app state they change is
// neutralised anyway. Per-app state really lives in two files of Aerial's own, read only when SpringBoard starts (found live on the M1): the
// bundle-id arrays FlexResizeBlacklist.plist and KeyboardAvoidanceWhitelist.plist; the keys flexResizeDisabled_<id> / keyboardAvoidanceEnabled_<id>
// in its preferences only mirror its Settings switches (Aerial itself ignores them). Both are emptied.
// The user's own values are not thrown away: before the first change they are copied to kA5BackupDir (a full copy of Aerial's preferences as
// the user wants them, plus their two lists). A setting changed later in Aerial's own Settings page is recorded there as their new value before
// ours is put back. Everything is given back when Aerial 5.0 stops being our engine (another engine, windowing off, Mac Status Bar switched off)
// and, through the package's prerm script, when Mac Status Bar is removed. Applied at startup (before Aerial sets up its window) and whenever
// Aerial reloads its settings (jp.uzra.aerial/ReloadPrefs). Debug: /tmp/msb-a5-noprefs leaves Aerial's settings alone.
#define kA5Domain CFSTR("jp.uzra.aerial")
static NSString *const kA5DataDir = @"/var/jb/var/mobile/Library/Aerial";
static NSString *const kA5BackupDir = @"/var/jb/var/mobile/Library/Preferences/MacStatusBar-AerialUserSettings";
static NSArray<NSString *> *DMA5ListFiles(void) { return @[@"FlexResizeBlacklist.plist", @"KeyboardAvoidanceWhitelist.plist"]; }
static NSDictionary<NSString *, id> *DMA5WantedPrefs(void) {
    BOOL ios16 = [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}];
    return @{ @"useNewDesign": @YES, @"useNewRotationMethod": @(ios16), @"ccToggleAutoStage": @YES,
              @"minusHandleDefaultSwipeMode": @1, @"switcherGestureType": @0,
              @"contextMenu_showOpenApp": @YES, @"contextMenu_showMaximize": @YES, @"contextMenu_showMinimize": @NO, @"contextMenu_showSplitStage": @YES,
              @"contextMenu_showTrimMode": @YES, @"contextMenu_showLockStage": @YES, @"contextMenu_showClose": @YES,
              @"splitMenu_showUpperHalf": @YES, @"splitMenu_showLowerHalf": @YES, @"splitMenu_showUpperThird": @YES, @"splitMenu_showMiddleThird": @YES, @"splitMenu_showLowerThird": @YES,
              @"shortcut_openInAerial": @YES, @"shortcut_flexResize": @NO, @"shortcut_keyboardAvoidance": @NO, @"shortcut_removeState": @YES };
}
static BOOL DMA5IsPerAppKey(NSString *k) { return [k hasPrefix:@"flexResizeDisabled_"] || [k hasPrefix:@"keyboardAvoidanceEnabled_"]; }
static NSDictionary *DMA5CurrentPrefs(void) {
    CFPreferencesAppSynchronize(kA5Domain);
    CFDictionaryRef d = CFPreferencesCopyMultiple(NULL, kA5Domain, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    return d ? (__bridge_transfer NSDictionary *)d : @{};
}
static void DMA5SetPref(NSString *k, id v) { CFPreferencesSetAppValue((__bridge CFStringRef)k, (__bridge CFPropertyListRef)v, kA5Domain); }
// Mac Status Bar switched off in Choicy/iCleaner (not yet resprung): MacSettings' root helper has just given the engines their user's settings back and
// left this marker; until the respring we must not take them again (seen: Aerial's reload after the give-back made us hold them again at once).
// The same while the stock status bar is on, or switched on and waiting for its respring.
static BOOL DMBeingSwitchedOff(void) { return gStockBar || DMStockBarPending() || access("/var/jb/var/lib/sshtoggled-engines/msb-off-restored", F_OK) == 0; }
static void DMAerial5SwallowPrefs(NSString *why) {
    if (DMTestFlag("/tmp/msb-a5-noprefs")) return;
    if (DMBeingSwitchedOff()) { static int n; if (n++ < 3) DMLog(@"[aerial5prefs] Mac Status Bar is being switched off: Aerial's settings left as the user has them"); return; }
    if (access("/var/jb/Library/MobileSubstrate/DynamicLibraries/MacStatusBar.dylib", F_OK) != 0) return;   // being removed (its prerm gave the user's settings back): hands off until the respring
    NSFileManager *fm = [NSFileManager defaultManager];
    NSString *backupPrefs = [kA5BackupDir stringByAppendingPathComponent:@"jp.uzra.aerial.plist"];
    NSDictionary *cur = DMA5CurrentPrefs(), *wanted = DMA5WantedPrefs();
    BOOL haveBackup = [fm fileExistsAtPath:backupPrefs];
    NSMutableDictionary *user = haveBackup ? [[NSDictionary dictionaryWithContentsOfFile:backupPrefs] mutableCopy] : nil;
    if (!user) { user = [cur mutableCopy]; haveBackup = NO; }   // first time (or an unreadable copy): what is there now is the user's own setup
    NSDictionary *userBefore = haveBackup ? [user copy] : nil;
    NSMutableArray *recorded = [NSMutableArray array];
    if (haveBackup) {
        for (NSString *k in cur) {
            id v = cur[k], w = wanted[k];
            if (w && [v isEqual:w]) continue;   // still ours
            if (![user[k] isEqual:v]) { user[k] = v; [recorded addObject:k]; }   // changed in Aerial's own Settings since: that is the user's value now
        }
        for (NSString *k in [user allKeys]) if (!wanted[k] && !DMA5IsPerAppKey(k) && !cur[k]) [user removeObjectForKey:k];   // Aerial's own other keys: mirrored
    }
    [fm createDirectoryAtPath:kA5BackupDir withIntermediateDirectories:YES attributes:nil error:nil];
    NSMutableArray *emptied = [NSMutableArray array];
    for (NSString *name in DMA5ListFiles()) {   // the per-app lists: the user's apps are kept in the copy, Aerial's file is emptied
        NSString *path = [kA5DataDir stringByAppendingPathComponent:name], *saved = [kA5BackupDir stringByAppendingPathComponent:name];
        NSArray *now = [NSArray arrayWithContentsOfFile:path];
        if (!haveBackup && now) [now writeToFile:saved atomically:YES];
        else if (haveBackup && now.count) {
            NSMutableArray *merged = [[NSArray arrayWithContentsOfFile:saved] ?: @[] mutableCopy];
            for (id b in now) if (![merged containsObject:b]) [merged addObject:b];
            [merged writeToFile:saved atomically:YES];
        }
        if (now.count) { [@[] writeToFile:path atomically:YES]; [emptied addObject:[NSString stringWithFormat:@"%@ (%lu apps)", name, (unsigned long)now.count]]; }
    }
    if ((!userBefore || ![user isEqualToDictionary:userBefore]) && ![user writeToFile:backupPrefs atomically:YES])   // (written only when new or changed)
        DMLog([NSString stringWithFormat:@"[aerial5prefs] could NOT write the copy of the user's settings to %@: Aerial's settings are left alone", backupPrefs]);
    if (![fm fileExistsAtPath:backupPrefs]) return;   // never overwrite anything without a copy to give back
    NSMutableArray *held = [NSMutableArray array];
    for (NSString *k in wanted) if (![cur[k] isEqual:wanted[k]]) { DMA5SetPref(k, wanted[k]); [held addObject:[NSString stringWithFormat:@"%@ %@->%@", k, cur[k] ?: @"(default)", wanted[k]]]; }
    for (NSString *k in cur) if (DMA5IsPerAppKey(k)) { DMA5SetPref(k, nil); [held addObject:[NSString stringWithFormat:@"%@ removed", k]]; }
    if (held.count) {
        CFPreferencesAppSynchronize(kA5Domain);
        CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFSTR("jp.uzra.aerial/ReloadPrefs"), NULL, NULL, true);
    }
    DMLog([NSString stringWithFormat:@"[aerial5prefs] %@: %@%@%@", why, held.count ? [NSString stringWithFormat:@"held %@", [held componentsJoinedByString:@", "]] : @"all of Aerial's settings already at ours",
           recorded.count ? [NSString stringWithFormat:@"; user's own new values kept for later: %@", [recorded componentsJoinedByString:@", "]] : @"",
           emptied.count ? [NSString stringWithFormat:@"; emptied %@ (Aerial reads it when SpringBoard starts)", [emptied componentsJoinedByString:@", "]] : @""]);
}
static void DMAerial5GiveBackPrefs(NSString *why) {
    NSFileManager *fm = [NSFileManager defaultManager];
    NSString *backupPrefs = [kA5BackupDir stringByAppendingPathComponent:@"jp.uzra.aerial.plist"];
    if (![fm fileExistsAtPath:backupPrefs]) return;
    NSDictionary *user = [NSDictionary dictionaryWithContentsOfFile:backupPrefs];
    if (!user) { DMLog(@"[aerial5prefs] the copy of the user's Aerial settings is unreadable: left as it is"); return; }
    NSDictionary *cur = DMA5CurrentPrefs();
    for (NSString *k in cur) if (!user[k]) DMA5SetPref(k, nil);
    for (NSString *k in user) if (![cur[k] isEqual:user[k]]) DMA5SetPref(k, user[k]);
    CFPreferencesAppSynchronize(kA5Domain);
    for (NSString *name in DMA5ListFiles()) {
        NSString *path = [kA5DataDir stringByAppendingPathComponent:name];
        NSArray *saved = [NSArray arrayWithContentsOfFile:[kA5BackupDir stringByAppendingPathComponent:name]];
        if (saved) [saved writeToFile:path atomically:YES]; else [fm removeItemAtPath:path error:nil];
    }
    [fm removeItemAtPath:kA5BackupDir error:nil];
    CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), CFSTR("jp.uzra.aerial/ReloadPrefs"), NULL, NULL, true);
    DMLog([NSString stringWithFormat:@"[aerial5prefs] %@: the user's own Aerial settings are back (%lu keys; Aerial reads its per-app lists when SpringBoard starts)", why, (unsigned long)user.count]);
}
static void DMA5ReloadPrefsCallback(CFNotificationCenterRef c, void *o, CFStringRef n, const void *obj, CFDictionaryRef info) {
    static BOOL pending = NO;
    if (pending) return;
    pending = YES;   // Aerial's Settings page may write several keys in a row: one pass a moment later
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        pending = NO;
        if (gA5PrefsState == 1) DMAerial5SwallowPrefs(@"Aerial reloaded its settings");
    });
}
// Every tick: hold while Aerial 5.0 is our engine; give back once it has not been for 10 s in a row (not during startup, before the engine is known).
static void DMAerial5PrefsWatch(void) {
    if (DMStockBarPending()) return;   // (given back for the stock status bar: nothing held until the respring, see DMStockPendingChanged)
    static BOOL observing = NO;
    if (!observing) { observing = YES; CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(), NULL, DMA5ReloadPrefsCallback, CFSTR("jp.uzra.aerial/ReloadPrefs"), NULL, CFNotificationSuspensionBehaviorDeliverImmediately); }
    static CFTimeInterval notSince = 0;
    BOOL engaged = gAerialFlavor == 5 && DMActiveEngine() == DMEngineAerial;
    if (engaged) {
        notSince = 0;
        if (gA5PrefsState != 1 && !DMTestFlag("/tmp/msb-a5-heldoff")) { gA5PrefsState = 1; DMAerial5SwallowPrefs(@"Aerial 5.0 is our engine"); }
        return;
    }
    if (gA5PrefsState == 2 || (gAerialFlavor < 0 && objc_getClass("AerialCore"))) return;
    CFTimeInterval now = CACurrentMediaTime();
    if (notSince == 0) { notSince = now; return; }
    if (now - notSince < 10.0) return;
    gA5PrefsState = 2;
    DMAerial5GiveBackPrefs(@"Aerial 5.0 is not our engine any more");
}
// Zetsu and MilkyWay4, same rule as Aerial 5.0 above: while one of them is our engine, its own customisations are held at the values our
// integration is built and tested for, and the user's values are kept in a copy and given back when it stops being our engine (another engine picked,
// windowing off) -- 10 s later, like Aerial's. Both engines keep their settings in plain preference domains (Dopamine stores them under
// /var/jb/var/mobile/Library/Preferences):
//  - Zetsu (jp.dcsyhi.zetsu): kEnabled on (our Settings is what switches engines now; Zetsu's own "Enabled" off would leave the picked engine dead),
//    every other key at Zetsu's default -- that is kMenuStyle Style1 (1.6.4 added "Stage" as a third menu style: off), menu bar size/space/move/buttons,
//    split view, gestures, screenshot hiding (1.6.1). Its per-app state (kAPP_STATE, the per-app "hide menu bar" list) lives in jp.dcsyhi.zetsuothers,
//    which is emptied except kWelcome (so its welcome screen does not come back). Zetsu re-reads on jp.dcsyhi.zetsuprefs/prefsupdated.
//  - MilkyWay4 (jp.akusio.milkyway4.scalemode): TweakEnable on, darkmode on (the look our MilkyWay integration was built with), and the per-app lists
//    isScalingMode and isMedusa ("Force resize and rotate") emptied. MilkyWay reads them when SpringBoard starts, so they are held from %ctor too
//    (MacStatusBar loads before MilkyWay4 and Zetsu: alphabetical).
// Debug: /tmp/msb-engine-noprefs leaves both alone.
typedef struct { NSString *tag, *domain, *notify; } DMEngineDomain;
static NSString *DMEnginePrefsBackupDir(NSString *tag) { return [NSString stringWithFormat:@"/var/jb/var/mobile/Library/Preferences/MacStatusBar-%@UserSettings", tag]; }
static NSDictionary *DMDomainPrefs(NSString *domain) {
    CFPreferencesAppSynchronize((__bridge CFStringRef)domain);
    CFDictionaryRef d = CFPreferencesCopyMultiple(NULL, (__bridge CFStringRef)domain, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    return d ? (__bridge_transfer NSDictionary *)d : @{};
}
// Zetsu (and MilkyWay4) read their preference FILE directly (Zetsu: +dictionaryWithContentsOfFile: of its jbroot path, in its constructor -- and only
// install their hooks when kEnabled is on), and cfprefsd writes a CFPreferences change to disk only a little later: at a SpringBoard start the engine
// read the old file (Zetsu stayed disabled although kEnabled had just been set). So the file is written straight away too, with the same contents.
static void DMWriteDomainFile(NSString *domain, NSDictionary *contents) {
    NSString *path = [NSString stringWithFormat:@"/var/jb/var/mobile/Library/Preferences/%@.plist", domain];
    if (![contents writeToFile:path atomically:YES]) DMLog([NSString stringWithFormat:@"[engineprefs] could not write %@", path]);
}
// Hold `domain` at exactly `wanted` (every key not in it removed = the engine's default), recording the user's values in the backup first.
static void DMEngineHoldDomain(NSString *tag, NSString *domain, NSDictionary *wanted, NSString *notify, NSString *why) {
    if (DMTestFlag("/tmp/msb-engine-noprefs")) return;
    if (DMBeingSwitchedOff()) return;   // (see DMBeingSwitchedOff)
    if (access("/var/jb/Library/MobileSubstrate/DynamicLibraries/MacStatusBar.dylib", F_OK) != 0) return;   // being removed: hands off
    NSFileManager *fm = [NSFileManager defaultManager];
    NSString *dir = DMEnginePrefsBackupDir(tag), *backup = [dir stringByAppendingPathComponent:[domain stringByAppendingPathExtension:@"plist"]];
    NSDictionary *cur = DMDomainPrefs(domain);
    BOOL haveBackup = [fm fileExistsAtPath:backup];
    NSMutableDictionary *user = haveBackup ? [[NSDictionary dictionaryWithContentsOfFile:backup] mutableCopy] : nil;
    if (!user) { user = [cur mutableCopy]; haveBackup = NO; }
    NSMutableArray *recorded = [NSMutableArray array];
    if (haveBackup) for (NSString *k in cur) {   // a value that is not ours was set in the engine's own Settings since: that is the user's value now
        if (wanted[k] && [cur[k] isEqual:wanted[k]]) continue;
        if (![user[k] isEqual:cur[k]]) { user[k] = cur[k]; [recorded addObject:k]; }
    }
    if (!haveBackup || recorded.count) {   // (the copy is written only when it is new or changed, not on every pass)
        [fm createDirectoryAtPath:dir withIntermediateDirectories:YES attributes:nil error:nil];
        if (![user writeToFile:backup atomically:YES]) { DMLog([NSString stringWithFormat:@"[engineprefs] %@: could NOT keep a copy of the user's %@: left alone", tag, domain]); return; }
    }
    if (![fm fileExistsAtPath:backup]) { DMLog([NSString stringWithFormat:@"[engineprefs] %@: no copy of the user's %@: left alone", tag, domain]); return; }
    NSMutableArray *held = [NSMutableArray array];
    for (NSString *k in cur) if (!wanted[k]) { CFPreferencesSetAppValue((__bridge CFStringRef)k, NULL, (__bridge CFStringRef)domain); [held addObject:[NSString stringWithFormat:@"%@ removed", k]]; }
    for (NSString *k in wanted) if (![cur[k] isEqual:wanted[k]]) { CFPreferencesSetAppValue((__bridge CFStringRef)k, (__bridge CFPropertyListRef)wanted[k], (__bridge CFStringRef)domain); [held addObject:[NSString stringWithFormat:@"%@ %@->%@", k, cur[k] ?: @"(default)", wanted[k]]]; }
    if (held.count) {
        CFPreferencesAppSynchronize((__bridge CFStringRef)domain);
        DMWriteDomainFile(domain, wanted);
        if (notify) CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)notify, NULL, NULL, true);
    }
    if (held.count || recorded.count) DMLog([NSString stringWithFormat:@"[engineprefs] %@ %@ (%@): %@%@", tag, domain, why, held.count ? [held componentsJoinedByString:@", "] : @"already ours", recorded.count ? [NSString stringWithFormat:@"; user's new values kept for later: %@", [recorded componentsJoinedByString:@", "]] : @""]);
}
static BOOL DMEngineGiveBackDomain(NSString *tag, NSString *domain, NSString *notify) {
    NSString *backup = [DMEnginePrefsBackupDir(tag) stringByAppendingPathComponent:[domain stringByAppendingPathExtension:@"plist"]];
    if (![[NSFileManager defaultManager] fileExistsAtPath:backup]) return NO;
    NSDictionary *user = [NSDictionary dictionaryWithContentsOfFile:backup];
    if (!user) { DMLog([NSString stringWithFormat:@"[engineprefs] %@: the copy of the user's %@ is unreadable: left as it is", tag, domain]); return NO; }
    NSDictionary *cur = DMDomainPrefs(domain);
    for (NSString *k in cur) if (!user[k]) CFPreferencesSetAppValue((__bridge CFStringRef)k, NULL, (__bridge CFStringRef)domain);
    for (NSString *k in user) if (![cur[k] isEqual:user[k]]) CFPreferencesSetAppValue((__bridge CFStringRef)k, (__bridge CFPropertyListRef)user[k], (__bridge CFStringRef)domain);
    CFPreferencesAppSynchronize((__bridge CFStringRef)domain);
    DMWriteDomainFile(domain, user);
    [[NSFileManager defaultManager] removeItemAtPath:backup error:nil];
    if (notify) CFNotificationCenterPostNotification(CFNotificationCenterGetDarwinNotifyCenter(), (__bridge CFStringRef)notify, NULL, NULL, true);
    DMLog([NSString stringWithFormat:@"[engineprefs] %@: the user's own %@ is back (%lu keys)", tag, domain, (unsigned long)user.count]);
    return YES;
}
static void DMZetsuHoldPrefs(NSString *why) {
    DMEngineHoldDomain(@"Zetsu", @"jp.dcsyhi.zetsu", @{@"kEnabled": @YES}, @"jp.dcsyhi.zetsuprefs/prefsupdated", why);
    NSDictionary *others = DMDomainPrefs(@"jp.dcsyhi.zetsuothers");
    DMEngineHoldDomain(@"Zetsu", @"jp.dcsyhi.zetsuothers", others[@"kWelcome"] ? @{@"kWelcome": others[@"kWelcome"]} : @{}, @"jp.dcsyhi.zetsuprefs/prefsupdated", why);
}
static void DMMilkyWayHoldPrefs(NSString *why) {
    DMEngineHoldDomain(@"MilkyWay", @"jp.akusio.milkyway4.scalemode", @{@"TweakEnable": @YES, @"darkmode": @YES}, nil, why);
}
static void DMEnginePrefsGiveBack(NSString *engineTag, NSString *why) {
    BOOL any = NO;
    if ([engineTag isEqualToString:@"Zetsu"]) { any |= DMEngineGiveBackDomain(@"Zetsu", @"jp.dcsyhi.zetsu", @"jp.dcsyhi.zetsuprefs/prefsupdated"); any |= DMEngineGiveBackDomain(@"Zetsu", @"jp.dcsyhi.zetsuothers", @"jp.dcsyhi.zetsuprefs/prefsupdated"); }
    else any |= DMEngineGiveBackDomain(@"MilkyWay", @"jp.akusio.milkyway4.scalemode", nil);
    if (any) { [[NSFileManager defaultManager] removeItemAtPath:DMEnginePrefsBackupDir(engineTag) error:nil]; DMLog([NSString stringWithFormat:@"[engineprefs] %@ settings given back: %@", engineTag, why]); }
}
static long long DMPrefsFileSig(NSString *domain) {   // (the preference file's identity: inode, size and modification time)
    struct stat st;
    if (stat([NSString stringWithFormat:@"/var/jb/var/mobile/Library/Preferences/%@.plist", domain].fileSystemRepresentation, &st) != 0) return 0;
    return (long long)st.st_ino * 1000003LL + (long long)st.st_size * 7919LL + (long long)st.st_mtimespec.tv_sec * 1000LL + st.st_mtimespec.tv_nsec / 1000000;
}
// Every tick, like DMAerial5PrefsWatch: hold while that engine is ours (a tested build), give back after 10 s of not being ours. Nothing is decided in
// the first 12 s after SpringBoard starts (the engine libraries and the Aerial guard settle first).
static void DMEnginePrefsWatch(void) {
    if (DMStockBarPending()) return;   // (the same as DMAerial5PrefsWatch)
    if (CACurrentMediaTime() < 0) return;
    static CFTimeInterval started = 0;
    if (!started) started = CACurrentMediaTime();
    if (CACurrentMediaTime() - started < 12.0) return;
    DMEngine e = DMActiveEngine();
    static CFTimeInterval zNot = 0, mNot = 0, lastHold = 0;
    CFTimeInterval now = CACurrentMediaTime();
    BOOL z = e == DMEngineZetsu, m = e == DMEngineMilkyWay;
    // Every 5 s, but the full pass (cfprefsd reads, compare, writes only on a difference) only when the engine's preference file changed since the
    // last pass (its own Settings writes it) or once a minute as a safety net; otherwise one stat per file.
    if ((z || m) && now - lastHold > 5.0) {
        lastHold = now;
        static CFTimeInterval lastFull = 0; static long long lastSig = 0;
        long long sig = z ? DMPrefsFileSig(@"jp.dcsyhi.zetsu") * 31 + DMPrefsFileSig(@"jp.dcsyhi.zetsuothers") : DMPrefsFileSig(@"jp.akusio.milkyway4.scalemode");
        sig = sig * 2 + z;
        if (sig != lastSig || now - lastFull > 60.0) {
            lastSig = sig; lastFull = now;
            if (z) DMZetsuHoldPrefs(@"Zetsu is our engine"); else DMMilkyWayHoldPrefs(@"MilkyWay4 is our engine");
            lastSig = z ? DMPrefsFileSig(@"jp.dcsyhi.zetsu") * 31 + DMPrefsFileSig(@"jp.dcsyhi.zetsuothers") : DMPrefsFileSig(@"jp.akusio.milkyway4.scalemode");   // (after our own write)
            lastSig = lastSig * 2 + z;
        }
    }
    if (z) zNot = 0; else { if (!zNot) zNot = now; else if (now - zNot > 10.0 && zNot > 0) { zNot = -1; DMEnginePrefsGiveBack(@"Zetsu", @"Zetsu is not our engine"); } }
    if (m) mNot = 0; else { if (!mNot) mNot = now; else if (now - mNot > 10.0 && mNot > 0) { mNot = -1; DMEnginePrefsGiveBack(@"MilkyWay", @"MilkyWay4 is not our engine"); } }
}
// Aerial 5.0 on iOS 16 ("new rotation method") turns its own windows (AerialWindow, AerialKeyboardWindow) with a transform: bounds in the screen's shape,
// turn 0 / +90 / -90 / 180 deg for orientation 1 / 3 / 4 / 2 (read live in all four). Once, after a SpringBoard start in landscape 3, AerialWindow came up
// with landscape bounds but NO turn, so every window was drawn sideways (raw capture; 1 of 9 landscape starts). If a window's turn disagrees with the
// screen for more than 1.5 s, and the screen has not turned in the last 2 s (Aerial animates the turn itself), the turn Aerial would have set is set.
static void DMAerial5CheckWindowTurn(void) {
    if (gAerialFlavor != 5 || [NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16) return;
    static long lastO = 0; static CFTimeInterval orientChanged = 0, wrongSince = 0;
    long o = DMRealInterfaceOrientation();
    CFTimeInterval now = CACurrentMediaTime();
    if (o != lastO) { lastO = o; orientChanged = now; wrongSince = 0; return; }
    if (now - orientChanged < 2.0) return;
    CGAffineTransform want = o == 3 ? CGAffineTransformMake(0, 1, -1, 0, 0, 0) : (o == 4 ? CGAffineTransformMake(0, -1, 1, 0, 0, 0) : (o == 2 ? CGAffineTransformMake(-1, 0, 0, -1, 0, 0) : CGAffineTransformIdentity));
    CGSize screen = [UIScreen mainScreen].bounds.size;
    NSMutableArray<UIWindow *> *wrong = [NSMutableArray array];
    for (UIWindow *w in DMAllWindows()) {
        NSString *cn = NSStringFromClass([w class]);
        if (![cn isEqualToString:@"AerialWindow"] && ![cn isEqualToString:@"AerialKeyboardWindow"]) continue;
        CGSize b = w.bounds.size;
        if (fabs(b.width - screen.width) > 2.0 || fabs(b.height - screen.height) > 2.0) continue;   // bounds not in the screen's shape: not this case, left alone
        CGAffineTransform t = w.transform;
        if (fabs(t.a - want.a) > 0.01 || fabs(t.b - want.b) > 0.01 || fabs(t.c - want.c) > 0.01 || fabs(t.d - want.d) > 0.01) [wrong addObject:w];
    }
    if (!wrong.count) { wrongSince = 0; return; }
    if (wrongSince == 0) { wrongSince = now; return; }
    if (now - wrongSince < 1.5) return;
    wrongSince = 0;
    for (UIWindow *w in wrong) {
        DMLog([NSString stringWithFormat:@"[aerial5] %@ is not turned for orientation %ld (transform %@, frame %@): given Aerial's turn %@", NSStringFromClass([w class]), o, NSStringFromCGAffineTransform(w.transform), NSStringFromCGRect(w.frame), NSStringFromCGAffineTransform(want)]);
        w.transform = want;
    }
}
static void DMAerial5Watch(void);
void DMAerial5WatchNow(void) { DMAerial5Watch(); }
static const void *kA5BornKey = &kA5BornKey;   // when a new Aerial 5.0 window was first seen (CACurrentMediaTime)
static BOOL gA5CatchOn = NO;   // Aerial 5.0 is our engine and themed: the pre-commit catcher runs (set by DMAerial5Watch)
// How visible a new window already was when we first saw it: its on-screen (presentation) opacity and frame. Seen before its first commit there is no
// presentation layer yet -- nothing of Aerial's own look was ever on screen. (Debug log; the measure for "the theme shows up late".)
static void DMA5LogCatch(UIView *stage, NSString *how) {
    if (!DMTestFlag("/tmp/macstatusbar-debug")) return;
    CALayer *pl = stage.layer.presentationLayer;
    DMLog([NSString stringWithFormat:@"[a5catch] %@ first seen by the %@: on screen %@ (presentation opacity %.2f, model alpha %.2f, hidden %d) frame %@",
           DMStageBundle(stage), how, pl ? @"ALREADY" : @"not yet", pl ? pl.opacity : -1.0, stage.alpha, stage.hidden, NSStringFromCGRect(stage.frame)]);
}
// A new Aerial 5.0 window: seen once, placed, themed. Called from the pre-commit catcher (DMA5CatchNewStages, the same Core Animation transaction
// that added the stage, so its first frame on screen already has our look) and, as a fallback, from the 0.2 s watcher.
static void DMAerial5AdoptNewStage(UIView *stage) {
    if ([objc_getAssociatedObject(stage, kA5SeenKey) boolValue]) return;
    NSString *bundle = DMStageBundle(stage);
    objc_setAssociatedObject(stage, kA5SeenKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(stage, kA5BornKey, @(CACurrentMediaTime()), OBJC_ASSOCIATION_RETAIN_NONATOMIC);

    if (bundle.length && [gFullFrameGuardBundle isEqualToString:bundle]) gFullFrameGuardBundle = nil;   // the app is being windowed again
    { extern BOOL DMRestoreWantsHidden(NSString *); if (DMRestoreWantsHidden(bundle)) {   // (brought back minimized by the restore: never shown)
        stage.alpha = 0.0;
        __weak UIView *ws = stage;   // (safety: visible again after 3 s if it was not minimized meanwhile)
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ UIView *st = ws; if (st && st.alpha < 0.01 && !DMStageMinimized(st)) st.alpha = 1.0; });
    } }
    DMLog([NSString stringWithFormat:@"[aerial5] new window: %@", bundle]);
#if DEBUG
    if (gTraceNextSecs > 0) { gTraceLayer = stage.layer; gTraceCount = 0; gTraceUntil = CACurrentMediaTime() + gTraceNextSecs; gTraceNextSecs = 0; DMLog(@"[a5trace] tracing this new window"); }   // (debug: a5tracenext_)
#endif
    __weak UIView *weakNew = stage;   // a few quick passes while it fades in, so it never shows Aerial's own look first
    for (int i = 1; i <= 20; i++) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.03 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ UIView *st = weakNew; if (st) { DMAerial5Lights(); DMAerial5Theme(st); } });
    if (gRestoringWindowsFlag()) objc_setAssociatedObject(stage, kA5AttachedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // restored windows go back where they were
    else if (!stage.hidden && DMA5MacGeometry() && gVeilSnap && gStageCover && CACurrentMediaTime() - gVeilColorTime < 6.0) {   // out of the full-screen app
        DMAerial5BeginEntrance(stage);
        DMFitRejoinAfterFullScreen(bundle);   // the other tiles make room at the same time
    }
    else if (!stage.hidden) DMCascadeStage(stage);   // placed right away, while it fades in (see DMCascadeStage)
    if (DMFrontApp() && !stage.hidden) { gWindowsPinnedForward = YES; DMApplyWindowLevel(); DMLog(@"[lights] a new Aerial stage opened over a full-screen app: windows brought forward"); }
    DMAerial5HideLeftovers(stage);
    DMAerial5Theme(stage);
    // (the app's square top corners and its place under our title bar come from the per-frame mask sync, which only knew the stages of the last
    // 0.2 s tick: a new window showed Aerial's rounded app corners for ~0.35 s -- measured frame by frame with a5burst)
    if (!gA5StageCache) gA5StageCache = [NSHashTable weakObjectsHashTable];
    [gA5StageCache addObject:stage];
    DMA5SyncHostMask(stage);
    DMAerial5Lights();
}
// iPad 2 (2026-09-24, requirement: "Aerial's own look shows first, then ours is applied, clearly visible"): the 0.2 s watcher found a new window up to 0.2 s
// after Aerial added it, so its first frames were drawn with Aerial's own chrome. This run-loop observer runs right before Core Animation commits
// (order 1999000, just ahead of CA's own 2000000), finds a stage Aerial has just added and adopts/themes it in that same transaction, so the first
// frame on screen is already ours. For its first 0.6 s it is themed again before every commit (Aerial builds its chrome over several turns).
// No hook on Aerial's classes (Aerial 5.0 kills SpringBoard if they are hooked). Cheap: the Aerial window is cached and only its top 4 levels are walked.
// Off switch: /tmp/msb-a5-nocatch.
// Aerial's app holder while the app is still coming up: DMStageInnerView() only knows it once the scene's layer host is inside, but Aerial shows it
// (rounded 30 pt on all corners, filled black by our theme) from the window's first frame, ~0.5 s before that. Found by shape: a plain clipped, rounded
// UIView directly in the stage, not one of ours, covering the stage's app area.
static UIView *DMA5EarlyHolder(UIView *stage) {
    UIView *in = DMStageInnerView(stage);
    if (in) return in;
    CGSize S = stage.bounds.size;
    for (UIView *v in stage.subviews) {
        if (![NSStringFromClass([v class]) isEqualToString:@"UIView"] || [v.accessibilityIdentifier hasPrefix:@"MSB"]) continue;
        if (!v.clipsToBounds || v.layer.cornerRadius < 5.0) continue;
        if (v.bounds.size.width < S.width - 40.0 || v.bounds.size.height < S.height - 60.0) continue;
        return v;
    }
    return nil;
}
// A young window (its first 0.6 s): the app area in our shape -- Aerial's own rounding disarmed (no corners masked, as 3b of the theme does) and our
// mask (square top, 12 pt bottom) -- on the holder, early one included.
static void DMA5FixYoungStage(UIView *stage) {
    UIView *h = DMA5EarlyHolder(stage);
    if (!h || DMStageMinimized(stage)) return;
    if (h.layer.maskedCorners != 0) { [CATransaction begin]; [CATransaction setDisableActions:YES]; h.layer.maskedCorners = 0; [CATransaction commit]; }
    DMA5SyncHostMaskFor(stage, h);
}
// The watcher stands still while every window is minimized. A window that shows again (a restore, or Aerial showing one we keep minimized) is
// seen before its first frame is drawn, here (before every commit): the watcher's pass runs at once (it hides a window we keep minimized again
// and catches Aerial's round icon), then the watcher runs again while a window is on screen.
static void DMA5WakeFrameWatcher(void) {
    CADisplayLink *link = gA5FrameLink;
    if (!link || !link.paused || gDMScreenOff || !gA5StageCache.count) return;
    BOOL any = NO;
    for (UIView *st in gA5StageCache.allObjects) if (!st.hidden) { any = YES; break; }
    if (!any) return;
    static BOOL keepOverlay = NO; static CFTimeInterval checkedAt = -10;   // (before every commit: the flag is read once a second)
    CFTimeInterval now = CACurrentMediaTime();
    if (now - checkedAt > 1.0) { checkedAt = now; keepOverlay = DMTestFlag("/tmp/msb-a5-keepoverlay"); }
    [gA5FrameWatcher frameBody:link keep:keepOverlay];
    if (gA5IdlePaused) {   // (idle: a pass before this commit; the link runs again only when something moves or the pass changed something)
        if (!DMA5NoteActivity()) return;
        gA5IdlePaused = NO;
    }
    if (DMA5AnyStageShowing()) { link.paused = NO; gA5LastActive = now; }
}
static void DMA5CatchNewStages(void) {
    DMA5WakeFrameWatcher();
    if (gA5HeldStages) {   // (nil when no window is held: nothing is allocated on the ordinary commit)
        NSArray *held = gA5HeldStages.allObjects;
        for (UIView *st in held) DMA5HoldEntranceFrame(st);
        if (!gA5HeldStages.allObjects.count) gA5HeldStages = nil;
    }   // (its own list: the stage walk below can miss a new window)
    if (!gA5CatchOn) return;
    static __weak UIWindow *aw = nil; static CFTimeInterval lookedAt = 0, switchCheckedAt = 0; static BOOL off = NO;
    CFTimeInterval now = CACurrentMediaTime();
    static BOOL debug = NO; static int passes = 0; static double spent = 0; static CFTimeInterval tallyAt = 0;
    if (now - switchCheckedAt > 1.0) { switchCheckedAt = now; off = DMTestFlag("/tmp/msb-a5-nocatch"); debug = DMTestFlag("/tmp/macstatusbar-debug"); }
    if (off) return;
    if (debug) {   // (debug: what the catcher costs, every 30 s)
        if (tallyAt == 0) tallyAt = now;
        if (now - tallyAt > 30.0) { DMLog([NSString stringWithFormat:@"[a5catch] cost: %d passes in %.0f s, %.2f ms in total (%.1f us each)", passes, now - tallyAt, spent * 1000.0, passes ? spent * 1e6 / passes : 0]); passes = 0; spent = 0; tallyAt = now; }
        passes++;
    }
    CFTimeInterval began = now;
    @try {
    UIWindow *w = aw;
    if (!w) { if (now - lookedAt < 0.5) return; lookedAt = now; w = aw = DMAerialWindow(); if (!w) return; }
    // (layering audit F12) Aerial 5.0 cannot be hooked, and it puts its window back to 1033 when it rebuilds it (a new window, the return from the
    // App Switcher): the tick corrected that up to 0.25 s later, meanwhile the windows sat over an open Dock menu or a full-screen app they belong
    // behind. Checked here, before the commit that would show it: one comparison.
    if (gLayerLevelWant >= 0 && fabs(w.windowLevel - gLayerLevelWant) > 0.01) {
        static int told = 0; if (told++ < 20) DMLog([NSString stringWithFormat:@"[aerial5] window layer at %.1f, wanted %.1f: put back before the frame is shown", w.windowLevel, gLayerLevelWant]);
        DMApplyWindowLevel();
    }
    NSMutableArray *stages = [NSMutableArray array], *young = [NSMutableArray array];
    {   // the stages in the Aerial window's top 4 levels (DMCollectStages, with the class compared by pointer instead of by name: this runs before every commit)
        static Class stageClass = Nil; if (!stageClass) stageClass = objc_getClass("AerialStage");
        if (!stageClass) return;
        NSMutableArray *q = [NSMutableArray arrayWithObject:w]; NSMutableArray *next = [NSMutableArray array];
        for (int depth = 0; depth <= 4 && q.count; depth++) {
            for (UIView *v in q) { if ([v class] == stageClass) [stages addObject:v]; else if (depth < 4) [next addObjectsFromArray:v.subviews]; }
            NSMutableArray *t = q; q = next; next = t; [next removeAllObjects];
        }
    }
    for (UIView *st in stages) {
        if (![objc_getAssociatedObject(st, kA5SeenKey) boolValue]) { DMA5LogCatch(st, @"pre-commit catcher"); DMAerial5AdoptNewStage(st); DMA5FixYoungStage(st); [young addObject:st]; continue; }
        NSNumber *born = objc_getAssociatedObject(st, kA5BornKey);
        if (born && now - born.doubleValue < 0.6) { DMAerial5HideLeftovers(st); DMAerial5Theme(st); DMA5FixYoungStage(st); [young addObject:st]; }
    }
    // Aerial rounds the holder again inside the commit's own layout pass, after this observer: where Core Animation offers it, the young windows are
    // put right once more after layout, just before the commit is rendered (a pre-commit handler of this transaction).
    static BOOL hasHandlers = NO, checked = NO;
    if (!checked) { checked = YES; hasHandlers = [CATransaction respondsToSelector:NSSelectorFromString(@"addCommitHandler:forPhase:")]; DMLog([NSString stringWithFormat:@"[aerial5] pre-commit handlers %@", hasHandlers ? @"available" : @"not available"]); }
    if (young.count && hasHandlers) {
        NSArray *list = [young copy];
        void (^handler)(void) = ^{ for (UIView *st in list) DMA5FixYoungStage(st); };
        ((void (*)(id, SEL, id, int))objc_msgSend)([CATransaction class], NSSelectorFromString(@"addCommitHandler:forPhase:"), handler, 1);   // 1 = kCATransactionPhasePreCommit
    }
    } @catch (NSException *e) { static int told = 0; if (told++ < 3) DMLog([NSString stringWithFormat:@"[a5catch] exception %@", e]); }
    if (debug) spent += CACurrentMediaTime() - began;
}
static void DMA5InstallCatcher(void) {
    static CFRunLoopObserverRef obs = NULL;
    if (obs) return;
    obs = CFRunLoopObserverCreateWithHandler(kCFAllocatorDefault, kCFRunLoopBeforeWaiting | kCFRunLoopExit, true, 1999000, ^(CFRunLoopObserverRef o, CFRunLoopActivity a) { DMA5CatchNewStages(); });
    if (obs) { CFRunLoopAddObserver(CFRunLoopGetMain(), obs, kCFRunLoopCommonModes); DMLog(@"[aerial5] new windows are themed before their first frame (pre-commit catcher)"); }
}
// (perf step 9) The theme pass on the 0.25 s tick is skipped for a window whose look can't have changed: same size, same light/dark, same
// minimized state, same app view and number of subviews, same lights setting, same hidden state. It still runs fully at least once a second
// (Aerial re-sets some of its properties behind our back: those come back within a second at worst; the per-minute "property re-applies"
// count shows how often), for every window in its first 2 s, and with /tmp/msb-a5-themefull (debug builds, for comparisons).
static const void *kA5ThemeSigKey = &kA5ThemeSigKey, *kA5ThemeAtKey = &kA5ThemeAtKey;
static void DMAerial5ThemeIfChanged(UIView *stage) {
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *born = objc_getAssociatedObject(stage, kA5BornKey), *at = objc_getAssociatedObject(stage, kA5ThemeAtKey);
    CGSize S = stage.bounds.size; UIView *in = DMStageInnerView(stage);
    BOOL found = NO, minimized = DMBoolIvar(stage, "_isMinimized", &found);
    UIView *hl = DMStageValue(stage, @[@"_handleBL"]), *hr = DMStageValue(stage, @[@"_handleBR"]);   // (our grips follow Aerial's handles)
    NSString *sig = [NSString stringWithFormat:@"%.1f %.1f %d %d %p %lu %lu %d %d %d %d", S.width, S.height, DMSystemInterfaceStyle() == UIUserInterfaceStyleDark, minimized,
                     in, (unsigned long)stage.subviews.count, (unsigned long)in.subviews.count, gShowWindowButtons, stage.hidden,
                     [hl isKindOfClass:[UIView class]] ? (int)hl.hidden : 2, [hr isKindOfClass:[UIView class]] ? (int)hr.hidden : 2];
    BOOL young = !born || now - born.doubleValue < 2.0;
    if (!young && at && now - at.doubleValue < 1.0 && [sig isEqualToString:objc_getAssociatedObject(stage, kA5ThemeSigKey)] && !DMTestFlag("/tmp/msb-a5-themefull")) return;
    objc_setAssociatedObject(stage, kA5ThemeSigKey, sig, OBJC_ASSOCIATION_COPY_NONATOMIC);
    objc_setAssociatedObject(stage, kA5ThemeAtKey, @(now), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    DMAerial5Theme(stage);
}
// A window left shrunk: Aerial 5.0 remembers each app's window as a frame AND a transform, and brings both back when the app opens again.
// A window moved while it still zoomed open from its Dock icon (at ~0.3x) once got ~3.3x its size, and Aerial saved that with the 0.3x
// transform: from then on it reopened the app like that every time (2026-09-26, M1: Twitter drawn at window size but laid out for
// 3139 x 2207, so tiny and distorted, traffic lights too; its StageStates.plist entry: 3151 x 2232 at 0.299). A settled window that is
// bigger than the screen and scaled down to fit is given its real size at scale 1, and Aerial's remembered state is set to that too,
// so the saved state heals itself. (Aerial's own scaled apps are scaled UP or by a few percent, never a giant size scaled down.)
static const void *kScaledSinceKey = &kScaledSinceKey;
static void DMRepairShrunkenStage(UIView *stage) {
    if (gAerialFlavor != 5 || !stage || DMTestFlag("/tmp/msb-noshrunkfix")) return;
    CGAffineTransform t = stage.transform;
    CGSize b = stage.bounds.size, sc = [UIScreen mainScreen].bounds.size;
    CGFloat big = MAX(sc.width, sc.height) * 1.02;
    BOOL shrunk = !stage.hidden && fabs(t.b) < 0.001 && fabs(t.c) < 0.001 && fabs(t.a - t.d) < 0.001 && t.a > 0.05 && t.a < 0.9
                  && (b.width > big || b.height > big) && b.width * t.a <= sc.width + 1.0 && b.height * t.a <= sc.height + 1.0
                  && !DMStageMinimized(stage) && ![objc_getAssociatedObject(stage, kStageHiddenKey) boolValue] && ![objc_getAssociatedObject(stage, kStageClosingKey) boolValue];
    for (NSString *busy in @[@"_isMinimized", @"_isClosing", @"_isRemovingStage"]) {   // Aerial's own minimize / close animations: not ours to touch
        if (!shrunk) break;
        Ivar iv = class_getInstanceVariable([stage class], busy.UTF8String);
        const char *ty = iv ? ivar_getTypeEncoding(iv) : NULL;
        if (ty && (ty[0] == 'B' || ty[0] == 'c') && *((uint8_t *)(__bridge void *)stage + ivar_getOffset(iv))) shrunk = NO;
    }
    if (!shrunk || stage.layer.animationKeys.count) { if (!shrunk) objc_setAssociatedObject(stage, kScaledSinceKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); return; }
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *since = objc_getAssociatedObject(stage, kScaledSinceKey);
    if (!since) { objc_setAssociatedObject(stage, kScaledSinceKey, @(now), OBJC_ASSOCIATION_RETAIN_NONATOMIC); return; }
    if (now - since.doubleValue < 0.3) return;   // (still so, with nothing animating, a moment later: settled, not mid-zoom)
    objc_setAssociatedObject(stage, kScaledSinceKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    NSValue *intent = objc_getAssociatedObject(stage, kStageIntentKey);
    CGPoint c = stage.center;
    CGRect want = intent ? intent.CGRectValue : CGRectMake(c.x - b.width * t.a / 2.0, c.y - b.height * t.a / 2.0, b.width * t.a, b.height * t.a);
    if (!intent) want = DMFitInto(CGRectIntegral(want), DMLayoutFrame(@"fill"));
    DMLog([NSString stringWithFormat:@"[aerial5] %@: window left shrunk (size %@ at scale %.3f, Aerial's remembered state) -- set to %@ at scale 1",
           DMStageBundle(stage), NSStringFromCGSize(b), t.a, NSStringFromCGRect(want)]);
    DMAerial5SyncState(stage, want);   // (Aerial's remembered frame + transform: saved clean from now on)
    gStageFrameBypass = YES;
    [UIView performWithoutAnimation:^{
        stage.transform = CGAffineTransformIdentity;
        stage.frame = want;
        [stage layoutIfNeeded];
    }];
    gStageFrameBypass = NO;
    DMSetStageIntent(stage, want);
    SEL fit = DMAerialSel(@"adjustContentScaleToHost");
    if ([stage respondsToSelector:fit]) ((void (*)(id, SEL))objc_msgSend)(stage, fit);
    DMRefitStageScene(stage);
}
static void DMAerial5Watch(void) {
    if (gAerialFlavor != 5 || DMActiveEngine() != DMEngineAerial) { gA5CatchOn = NO; return; }
    gA5ThemeOff = DMTestFlag("/tmp/msb-a5-notheme");
    gA5CatchOn = !gA5ThemeOff;
    DMA5InstallCatcher();
    static CFTimeInterval lastReport = 0;
    if (CACurrentMediaTime() - lastReport > 60.0) { if (lastReport > 0) DMLog([NSString stringWithFormat:@"[aerial5] theme: %d property re-applies in the last minute", gA5Rewrites]); gA5Rewrites = 0; lastReport = CACurrentMediaTime(); }
    if (!DMTestFlag("/tmp/msb-a5-nolockrestore")) DM_PERF("a5w-lock", DMAerial5WatchLock());
    DM_PERF("a5w-frame", DMAerial5StartFrameWatcher());
    if (!gA5StageCache) gA5StageCache = [NSHashTable weakObjectsHashTable];
    // Idle trim (2026-09-25): with no window (DMWindowWorkNeeded: none for 3 s, so the passes that see the last window go have run) the per-window
    // part below rests, and the window turn check (~0.33 ms, most of this watcher's idle cost on the iPad 2) runs once a second instead of 4x: a
    // wrong turn after a start is then put right after ~2 s instead of 1.5 s, still before a window shows. The lock watch and the catcher run as
    // before. /tmp/msb-nowindowgate: every pass as before.
    BOOL windowWork = DMWindowWorkNeeded();
    static unsigned turnTick = 0;
    if (windowWork || ++turnTick % 4 == 0) DM_PERF("a5w-turn", DMAerial5CheckWindowTurn());
    if (!windowWork) return;
    [gA5StageCache removeAllObjects];
    for (UIView *st in DMAerialStages()) {
        [gA5StageCache addObject:st];
        DMRepairCollapsedStage(st);
        DMRepairShrunkenStage(st);
        // Aerial pulls a stage that starts left of the screen back to x 0 when the screen's traits change (light/dark, a turn). With the 3.0 shape a
        // window at the left edge has its stage 6 pt off screen on purpose (the invisible margin): such a small nudge of an unchanged size is put back.
        NSValue *intent = objc_getAssociatedObject(st, kStageIntentKey);
        if (DMA5MacGeometry() && intent && !DMAerial5GestureLive(st)) {
            CGRect want = intent.CGRectValue, f0 = st.frame;
            f0.origin.y -= DMAutoHideShiftOf(st);   // (the auto-hiding status bar's move is not a nudge)
            // (a sub-point difference is float rounding of the frame, not a nudge: it was "put back" 4 times a second forever -- iPad 2, y 30.666...664 vs ...686)
            BOOL nudged = fabs(f0.size.width - want.size.width) < 0.5 && fabs(f0.size.height - want.size.height) < 0.5 && (fabs(f0.origin.x - want.origin.x) > 0.01 || fabs(f0.origin.y - want.origin.y) > 0.01)
                          && fabs(f0.origin.x - want.origin.x) <= gA5Insets.left + 0.5 && fabs(f0.origin.y - want.origin.y) <= 0.5;
            if (nudged) DMEnforceStageFrame(st, @"Aerial's pull back onto the screen");
        }
        CGRect f = st.frame;
        if (!DMA5ChipFlag(st) && !st.hidden && f.size.width >= 150.0 && f.size.height >= 150.0 && CGAffineTransformIsIdentity(st.transform) && ![objc_getAssociatedObject(st, kA5ChipHiddenKey) boolValue])
            objc_setAssociatedObject(st, kA5GoodFrameKey, [NSValue valueWithCGRect:f], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    UIWindow *layer = DMAerialWindow();
    if (layer && layer.windowLevel != DMDesiredWindowLevel()) DMApplyWindowLevel();
    NSMutableSet<NSString *> *now = [NSMutableSet set];
    for (UIView *stage in DMAerialStages()) {
        NSString *bundle = DMStageBundle(stage);
        if (bundle.length) [now addObject:bundle];
        if (![objc_getAssociatedObject(stage, kA5SeenKey) boolValue]) {
            DMA5LogCatch(stage, @"0.2 s watcher");
            DMAerial5AdoptNewStage(stage);
        }
        DM_PERF("a5-leftovers", DMAerial5HideLeftovers(stage));
        DM_PERF("a5-theme", DMAerial5ThemeIfChanged(stage));
        if (!DMTestFlag("/tmp/msb-a5-dragall")) DM_PERF("a5-dragguard", DMAerial5DragGuard(stage));
        if (DMStageInnerView(stage) && ![objc_getAssociatedObject(stage, kA5AttachedKey) boolValue]) {
            objc_setAssociatedObject(stage, kA5AttachedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            __weak UIView *weakStage = stage;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ UIView *s = weakStage; if (s && !s.hidden) DMCascadeStage(s); });
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
                UIView *s = weakStage;
                if (s && !objc_getAssociatedObject(s, kStageIntentKey)) DMRememberStageFrame(s);   // its first settled place is the one to keep
            });
        }
        BOOL live = DMAerial5GestureLive(stage), was = [objc_getAssociatedObject(stage, kA5GestureKey) boolValue];
        if (live && !was) {
            objc_setAssociatedObject(stage, kA5GestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(stage, kStageGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        } else if (!live && was) {
            objc_setAssociatedObject(stage, kA5GestureKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(stage, kStageGestureKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMRememberStageFrame(stage);
            DMFitGroupForget(bundle);   // placed by hand: no longer tiled
            DMSaveWindowState();
            DMLog([NSString stringWithFormat:@"[aerial5] %@ moved/resized by hand to %@: remembered", bundle, NSStringFromCGRect(stage.frame)]);
        }
    }
    if (gA5Bundles) for (NSString *gone in gA5Bundles) if (![now containsObject:gone]) {
        DMLog([NSString stringWithFormat:@"[aerial5] window of %@ went away: its app gets the full screen back", gone]);
        DMFitGroupForget(gone);
        DMResetSceneFrameForBundle(gone);
    }
    gA5Bundles = now;
}
// Aerial 5.0: our traffic lights on its windows WITHOUT any hook (Aerial kills SpringBoard when its classes are hooked). Each tick the stages are
// found through the view hierarchy and given the same DMStageLights view the 3.0 styling uses, as a plain subview in the thin strip above the
// app (Aerial 5.0 leaves 13 pt there; its own "..." menu sits in the middle of it and stays). Being a subview, the lights move, resize and
// disappear with the window by themselves; the tick only (re)places them and hides them while the window is minimized or too small.
static const CGFloat kA5LightsX = 18.0;   // clear of the window's rounded top-left corner
static void DMAerial5Lights(void) {
    if (gAerialFlavor != 5 || DMActiveEngine() != DMEngineAerial || !DMWindowWorkNeeded()) return;
    for (UIView *stage in DMAerialStages()) {
        DMStageLights *lights = objc_getAssociatedObject(stage, kStageLightsKey);
        if (!gShowWindowButtons) { lights.hidden = YES; continue; }
        if (!lights) {
            lights = [[DMStageLights alloc] initWithStage:stage];
            objc_setAssociatedObject(stage, kStageLightsKey, lights, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [stage addSubview:lights];
            DMLog([NSString stringWithFormat:@"[aerial5] traffic lights added to %@", DMStageBundle(stage)]);
        }
        if (lights.superview != stage) [stage addSubview:lights];
        CGSize size = stage.bounds.size;
        UIView *inner = DMStageInnerView(stage);
        CGFloat top = inner ? inner.frame.origin.y : 13.0;   // the strip above the app
        // Only real changes are written: this runs every tick, and a write here marked Aerial's stage as needing layout, whose layout pass sends the
        // app its scene settings again -- every windowed app was woken about 4 times a second for nothing (log on iPad 2: [scene-upd] every 0.26 s,
        // traced to this function).
        BOOL hide = size.width < 160.0 || size.height < 120.0 || DMStageMinimized(stage) || [objc_getAssociatedObject(stage, kStageClosingKey) boolValue];
        if (lights.hidden != hide) lights.hidden = hide;
        CGRect f = DMA5MacGeometry() ? CGRectMake(gA5Insets.left + 4.0, top - kStageBarHeight, 3 * kLightCell, kStageBarHeight)   // in the title bar, where Aerial 3.0 has them
                                     : CGRectMake(kA5LightsX, top / 2.0 - kStageBarHeight / 2.0, 3 * kLightCell, kStageBarHeight), cur = lights.frame;
        f.origin.y += DMAutoHideTitleShiftOf(stage);   // (the auto-hiding status bar has slid this title bar down for a moment)
        if (fabs(cur.origin.x - f.origin.x) > 0.25 || fabs(cur.origin.y - f.origin.y) > 0.25 || fabs(cur.size.width - f.size.width) > 0.25 || fabs(cur.size.height - f.size.height) > 0.25) lights.frame = f;
        if (stage.subviews.lastObject != lights && DMA5ViewCovered(stage, lights)) [stage bringSubviewToFront:lights];   // (see DMA5ViewCovered)
    }
}
// ---- an installed window engine that cannot be used: tell the user once (2026-09-24) ----
// For each window engine whose library is installed: a build we have not tested (its Mach-O UUIDs are not on our lists), or MilkyWay4 on iPadOS 16
// (it only works on 15). Such an engine runs plain, without any of our window features, so a stock-looking alert says exactly what to do. Shown once per
// engine + version (the acknowledgement is kept in our preferences, key acknowledgedEngineWarnings), a few seconds after SpringBoard starts, once the
// screen is unlocked. Debug: /tmp/msb-enginewarn-test (an engine name) treats that installed engine as untested.
static NSString *DMEngineWarningText(NSString *lib, NSString *version, BOOL *needed) {
    *needed = NO;
    NSString *file = [NSString stringWithFormat:@"/var/jb/usr/lib/TweakInject/%@.dylib", lib];
    if (access(file.fileSystemRepresentation, F_OK) != 0) return nil;
    BOOL ios16 = [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}];
#if DEBUG
    NSString *forced = [[NSString stringWithContentsOfFile:@"/tmp/msb-enginewarn-test" encoding:NSUTF8StringEncoding error:nil] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
#else
    NSString *forced = nil;
#endif
    if ([lib isEqualToString:@"MilkyWay4"] && ios16) {
        *needed = YES;
        return @"MilkyWay4 only works on iPadOS 15, so MacStatusBar&Dock can't use it on this iPad. Uninstall MilkyWay4 in Sileo, and choose Aerial or Zetsu in Settings > Status Bar > Window Engine.";
    }
    BOOL tested;
    if ([lib isEqualToString:@"Aerial"]) tested = MSBDEngineFileTested(@"Aerial", file);
    else tested = DMEngineBuildTested(lib);
    if ([forced isEqualToString:lib]) tested = NO;
    if (tested) return nil;
    *needed = YES;
    NSString *name = [lib isEqualToString:@"MilkyWay4"] ? @"MilkyWay4" : lib;
    NSString *want = [lib isEqualToString:@"Aerial"] ? @"Aerial 3.0 or 5.0" : ([lib isEqualToString:@"Zetsu"] ? @"Zetsu 1.6.6 or 1.6.2" : @"MilkyWay4 0.1.1");
    return [NSString stringWithFormat:@"%@ %@ hasn't been tested with MacStatusBar&Dock, so its windows won't get the Mac window features. Install %@ in Sileo, or choose another engine in Settings > Status Bar > Window Engine.",
            name, version.length ? version : @"(this version)", want];
}
static UIWindow *gEngineWarningWindow;
static BOOL gEngineRespringAsk = NO;   // two engines loaded at start AND the root helper has just switched the extra one off (see DMTickBody)
static BOOL gEngineAskWaiting = NO;    // two engines loaded: waiting (up to 40 s) for the helper to say whether it changed anything
static BOOL gEngineAskNone = NO;       // no engine loaded at start although windowing is on (the helper may switch the default one on: asked the same way)
static BOOL gEngineAskSMBack = NO;     // Stage Manager picked and usable again, the stand-in engine still loaded (the helper switches it off: asked the same way)
static void DMCheckEngineWarnings(void) {
    static BOOL done = NO; static CFTimeInterval started = 0;
    if (done || gEngineWarningWindow) return;
    if (!started) started = CACurrentMediaTime();
    if (CACurrentMediaTime() - started < 8.0 || !DMScreenOnAndUnlocked() || MSBDAlertLockedOrCovered()) return;   // (never shown over the Lock Screen or Notification Center)
    NSArray *acked = (__bridge_transfer NSArray *)CFPreferencesCopyValue(CFSTR("acknowledgedEngineWarnings"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (![acked isKindOfClass:[NSArray class]]) acked = @[];
    NSDictionary *packages = @{@"Aerial": @"jp.uzra.aerial", @"Zetsu": @"jp.dcsyhi.zetsu", @"MilkyWay4": @"jp.akusio.milkyway4"};
    static NSMutableDictionary<NSString *, NSString *> *versions = nil; static struct timespec statusTime;   // (dpkg's status file read once per change)
    struct stat st; struct timespec nowTime = stat("/var/jb/var/lib/dpkg/status", &st) == 0 ? st.st_mtimespec : (struct timespec){0, 0};
    if (!versions || nowTime.tv_sec != statusTime.tv_sec || nowTime.tv_nsec != statusTime.tv_nsec) { versions = [NSMutableDictionary dictionary]; statusTime = nowTime; }
    for (NSString *lib in @[@"Aerial", @"Zetsu", @"MilkyWay4"]) {
        if (access([NSString stringWithFormat:@"/var/jb/usr/lib/TweakInject/%@.dylib", lib].fileSystemRepresentation, F_OK) != 0) continue;   // (not installed: nothing to warn about, dpkg not read)
        if (!versions[lib]) versions[lib] = DMPackageVersion(packages[lib]) ?: @"";
        NSString *version = versions[lib];
        NSString *key = [NSString stringWithFormat:@"%@ %@", lib, version];
        BOOL needed = NO;
        NSString *text = DMEngineWarningText(lib, version, &needed);
        if (!needed || [acked containsObject:key]) continue;
        if (MSBDAlertBusy(nil)) return;   // (another alert of ours is up: this one waits its turn, AlertQueue.h)
        UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();
        gEngineWarningWindow = w;
        UIAlertController *a = [UIAlertController alertControllerWithTitle:[NSString stringWithFormat:@"%@ Can't Be Used", [lib isEqualToString:@"MilkyWay4"] ? @"MilkyWay4" : lib] message:text preferredStyle:UIAlertControllerStyleAlert];
        [a addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) {
            NSArray *now = (__bridge_transfer NSArray *)CFPreferencesCopyValue(CFSTR("acknowledgedEngineWarnings"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            NSMutableArray *m = [now isKindOfClass:[NSArray class]] ? [now mutableCopy] : [NSMutableArray array];
            if (![m containsObject:key]) [m addObject:key];
            CFPreferencesSetValue(CFSTR("acknowledgedEngineWarnings"), (__bridge CFArrayRef)m, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[enginewarn] %@: acknowledged", key]);
            gEngineWarningWindow.hidden = YES; gEngineWarningWindow = nil;   // (the next warning, if any, on a later tick)
        }]];
        [w.rootViewController presentViewController:a animated:YES completion:nil];
        MSBDAlertCloseOnLock(w, ^{   // (never over the Lock Screen: put away, and shown again after the unlock -- it was not acknowledged)
            if (gEngineWarningWindow == w) gEngineWarningWindow = nil;
            DMLog([NSString stringWithFormat:@"[enginewarn] %@: put away for the Lock Screen (again after the unlock)", key]);
        });
        DMLog([NSString stringWithFormat:@"[enginewarn] %@: shown (%@)", key, text]);
        return;
    }
    if (gEngineRespringAsk) {   // (two engines loaded at start; MacSettings' helper has just switched the extra one off in Choicy or iCleaner Pro)
        if (MSBDAlertBusy(nil)) return;   // (another alert of ours is up: this one waits its turn)
        gEngineRespringAsk = NO;
        UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();
        gEngineWarningWindow = w;
        BOOL choicy = access("/var/jb/usr/lib/TweakInject/ChoicySB.dylib", F_OK) == 0 || access("/var/jb/usr/lib/TweakInject/Choicy.dylib", F_OK) == 0;
        BOOL smUnsupported = [gEnginePref isEqualToString:@"stagemanager"] && gSMCheckDone && !gSMCheckOK;   // (picked, but its self-check failed here)
        NSString *msg = gEngineAskSMBack ? [NSString stringWithFormat:@"Stage Manager can be the window engine on this iPadOS version now. The engine that stood in for it is switched off in %@; Stage Manager takes over after a respring.", choicy ? @"Choicy" : @"iCleaner Pro"]
                      : gEngineAskNone && DMWindowingEnabled() && smUnsupported ? [NSString stringWithFormat:@"Stage Manager can't be the window engine on this iPadOS version yet. The default engine is now switched on in %@ and loads after a respring.", choicy ? @"Choicy" : @"iCleaner Pro"]
                      : gEngineAskNone && DMWindowingEnabled() ? [NSString stringWithFormat:@"No window engine was loaded. The one to use is now switched on in %@ and loads after a respring.", choicy ? @"Choicy" : @"iCleaner Pro"]
                      : DMWindowingEnabled() ? [NSString stringWithFormat:@"More than one window engine loaded. The extra one is now switched off in %@ and stops loading after a respring.", choicy ? @"Choicy" : @"iCleaner Pro"]
                                             : [NSString stringWithFormat:@"Windowing is off, so the window engines are now switched off in %@ and stop loading after a respring.", choicy ? @"Choicy" : @"iCleaner Pro"];
        UIAlertController *a = [UIAlertController alertControllerWithTitle:@"Respring to Finish Switching Engines" message:msg preferredStyle:UIAlertControllerStyleAlert];
        [a addAction:[UIAlertAction actionWithTitle:@"Later" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { gEngineWarningWindow.hidden = YES; gEngineWarningWindow = nil; }]];
        [a addAction:[UIAlertAction actionWithTitle:@"Respring" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) { gEngineWarningWindow.hidden = YES; gEngineWarningWindow = nil; DMRespringChecked(); }]];
        [w.rootViewController presentViewController:a animated:YES completion:nil];
        MSBDAlertCloseOnLock(w, ^{   // (its Respring button must never work over the Lock Screen: put away, and asked again after the unlock)
            if (gEngineWarningWindow == w) gEngineWarningWindow = nil;
            gEngineRespringAsk = YES;
            DMLog(@"[engine] respring question put away for the Lock Screen (asked again after the unlock)");
        });
        DMLog(gEngineAskNone ? @"[engine] no engine loaded and the helper switched one on: asked to respring" : @"[engine] two engines loaded and the helper switched one off: asked to respring");
        return;
    }
    if (gEngineAskWaiting && CACurrentMediaTime() - started < 40.0) return;   // (the helper's answer may still come)
    done = YES;
}
// ---- Welcome (2026-09-25): a one-time alert after a FIRST install ------------------------------------------------------------------------------
// The root helper decides at install time (sshtoggled --welcome-check, first thing in the postinst): only a first install gets the file
// welcome-pending; an upgrade (or old settings of ours / the old packages) is marked welcomeShown silently. It is shown once SpringBoard has started,
// unlocked, on the Home Screen with nothing else up (no app full screen or window in front, Control Center, App Switcher, App Library, Spotlight,
// Notification Center, a menu of ours or another alert of ours); otherwise it waits (checked once a second from the tick). Once shown -- either
// button, or put away any other way (locking) -- welcomeShown is set and it never comes back. When it is not (or no longer) needed the whole check
// is one test of a flag. Not on untested iPadOS versions ("Enable Anyway"): the welcome is for supported installs. Presented like the engine
// warnings above (a UIAlertController on its own window at alert level: SpringBoard's own alert-item queue would need a subclass of a private class).
// Debug builds: /tmp/msb-welcome-test forces it once per write of the file (for devices that already have our settings).
#define MSBD_WELCOME_DOMAIN CFSTR("com.besiktasliseba.macstatusbaranddock")
#define MSBD_WELCOME_PENDING "/var/jb/var/lib/macstatusbaranddock/welcome-pending"
#define MSBD_OPENPAGE_STATE "com.besiktasliseba.macstatusbaranddock.openstatusbarpage"   // (Settings opens the Status Bar page: StatusBarSettingsRow.x)
static UIWindow *gWelcomeWindow;
static int gWelcomeState = 0;   // 0 not looked at yet, 1 waiting for the right moment, 2 done (shown, or not needed)
static BOOL DMWelcomePref(CFStringRef key) {
    CFPreferencesAppSynchronize(MSBD_WELCOME_DOMAIN);
    CFPropertyListRef v = CFPreferencesCopyValue(key, MSBD_WELCOME_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    BOOL on = v && CFGetTypeID(v) == CFBooleanGetTypeID() && CFBooleanGetValue(v);
    if (v) CFRelease(v);
    return on;
}
static void DMWelcomeSetPref(CFStringRef key, CFPropertyListRef value) {
    CFPreferencesSetValue(key, value, MSBD_WELCOME_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    CFPreferencesSynchronize(MSBD_WELCOME_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
}
// Opens an app full screen whatever the window engine would do: a window of it goes full screen the way its green light does it, otherwise a plain
// full-screen launch (gForceFullScreenLaunch: not turned into a window, "Open Apps as Windows" or not).
static void DMOpenAppFullScreen(NSString *bundleID) {
    DMEngine e = DMActiveEngine();
    UIView *stage = (e == DMEngineAerial || e == DMEngineZetsu) ? DMStageForBundle(bundleID) : nil;
    UIView *mw = e == DMEngineMilkyWay ? DMFindMilkyWayWindow(bundleID) : nil;
    DMLog([NSString stringWithFormat:@"[welcome] open %@ full screen (%@)", bundleID, stage || mw ? @"from its window" : @"launch"]);
    if (stage) DMStageLightAction(stage, 2);
    else if (mw) DMExpandWindowToFullScreen((AXWindowView *)mw, bundleID, nil);
    else DMOpenFullScreen(bundleID);
}
// A Settings link from another part of ours (the Dock's "Downloads From…", 2026-09-25): Settings is opened full screen first -- in a window it
// shows no sidebar, so the page's row could not be shown selected -- and the link is opened once Settings is in front (then it only moves to
// the page; a link opened before that could be turned into a window by our windowed launch). With "Open Apps as Windows" on, Settings opens as a
// window like every other launch (2026-09-26): launched through the link (our windowed launch makes the window), then the link again.
static void DMOpenSettingsLinkFullScreen(NSString *link, int attempt) {
    BOOL windowed = DMWindowedLaunchOn();
    BOOL front = [[DMFrontApp() bundleIdentifier] isEqualToString:@"com.apple.Preferences"];
    if (windowed && attempt > 0 && !front) {   // (a window never counts as the front app: its window being there is what counts)
        DMEngine e = DMActiveEngine();
        front = (e == DMEngineAerial || e == DMEngineZetsu) ? DMStageForBundle(@"com.apple.Preferences") != nil
              : e == DMEngineMilkyWay ? DMFindMilkyWayWindow(@"com.apple.Preferences") != nil : NO;
    }
    if (attempt == 0 && windowed) {   // (the launch makes the window; a link opened while Settings is still starting is dropped, so
        DMLog([NSString stringWithFormat:@"[settingslink] %@: Settings as a window first", link]);   //  it is opened again once Settings is in front)
        if (!front) DMOpenURL(link, [NSString stringWithFormat:@"settings link %@ (launch as a window)", link]);
    } else if (attempt == 0) {
        DMLog([NSString stringWithFormat:@"[settingslink] %@: Settings full screen first", link]);
        if (!front) DMOpenAppFullScreen(@"com.apple.Preferences");
    }
    if (front || attempt >= 30) { DMOpenURL(link, [NSString stringWithFormat:@"settings link %@ (Settings in front %d)", link, front]); return; }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMOpenSettingsLinkFullScreen(link, attempt + 1); });
}
static void DMWelcomeClose(NSString *how, BOOL putAway) {   // putAway: the alert is still up (not closed by one of its buttons)
    if (!gWelcomeWindow) return;
    UIViewController *root = gWelcomeWindow.rootViewController;
    if (putAway && root.presentedViewController) [root dismissViewControllerAnimated:NO completion:nil];
    gWelcomeWindow.hidden = YES; gWelcomeWindow = nil;
    DMLog([NSString stringWithFormat:@"[welcome] closed: %@", how]);
}
static void DMWelcomeDismissForLock(void) { if (gWelcomeWindow) DMWelcomeClose(@"locked (counts as dismissed)", YES); }   // (never over the Lock Screen)
static BOOL DMCoverSheetShown(void) {
    id cs = DMSBManager("SBCoverSheetPresentationManager");
    return [DMBoolStr(cs, @"isPresented") isEqualToString:@"Y"] || [DMBoolStr(cs, @"isVisible") isEqualToString:@"Y"];
}
static NSString *DMWelcomeBlocker(void) {   // why not now (nil: the Home Screen is showing, unlocked, nothing else up)
    if (DMProcessAge() < 10.0) return @"SpringBoard starting";
    if (!DMScreenOnAndUnlocked()) return @"locked or screen off";
    if (DMCoverSheetShown()) return @"Notification Center / Lock Screen";
    if (DMActiveApp()) return @"an app in front";
    if (DMSwitcherVisible()) return @"App Switcher";
    if (DMControlCenterActive()) return @"Control Center";
    if (DMLibraryVisible()) return @"App Library";
    if (DMSpotlightShown()) return @"Spotlight";
    if ((gMenuWindow && !gMenuWindow.hidden) || DMExtMenuVisible()) return @"a menu";
    if (gEngineWarningWindow || gRestoringWindows || MSBDAlertBusy(nil)) return @"another alert / window restore";
    return nil;
}
// Our Status Bar page in Settings, full screen (the welcome alert's "Take Me There", and the crash guard's notice: loader/CrashNotice.m).
__attribute__((visibility("default"))) void MSBDOpenStatusBarPage(void) {
    static int token = 0;   // (Settings reads the time of the request and opens our page, once, if it is recent)
    if (!token) notify_register_check(MSBD_OPENPAGE_STATE, &token);
    notify_set_state(token, (uint64_t)time(NULL));
    notify_post(MSBD_OPENPAGE_STATE);
    DMOpenAppFullScreen(@"com.apple.Preferences");
}
// For the crash guard's notice (loader/CrashNotice.m, which has no hooks): YES while the welcome alert's checks say "not now" (a menu or alert of
// ours, an app or window in front, Control Center, ...), or the welcome alert itself is up.
__attribute__((visibility("default"))) BOOL MSBDHomeScreenBusy(void) {
    return gWelcomeWindow != nil || DMWelcomeBlocker() != nil;
}
static void DMCheckWelcome(void) {
    static int n = 0;
    if (gWelcomeWindow) {   // shown: put away if the Lock Screen or Notification Center comes over it
        if (!DMScreenOnAndUnlocked() || DMCoverSheetShown()) DMWelcomeClose(@"Lock Screen / Notification Center (counts as dismissed)", YES);
        return;
    }
    BOOL forced = NO;
#if DEBUG
    static time_t testStamp = 0;
    if (++n % 4 == 0) {
        struct stat st;
        if (stat("/tmp/msb-welcome-test", &st) == 0 && st.st_mtime != testStamp) {
            if (!testStamp) {
                CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("welcomeTestStamp"), MSBD_WELCOME_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
                if (v && CFGetTypeID(v) == CFNumberGetTypeID()) CFNumberGetValue((CFNumberRef)v, kCFNumberLongType, &testStamp);
                if (v) CFRelease(v);
            }
            forced = st.st_mtime != testStamp;
        }
    }
    if (!forced && gWelcomeState == 2) return;
#else
    if (gWelcomeState == 2) return;
    if (++n % 4) return;   // (once a second)
#endif
    if (!forced && gWelcomeState == 0) {
        struct stat st;
        BOOL pending = stat(MSBD_WELCOME_PENDING, &st) == 0 && S_ISREG(st.st_mode);
        if (!pending || DMWelcomePref(CFSTR("welcomeShown")) || !MSBDVersionTested()) {
            gWelcomeState = 2;
            DMLog([NSString stringWithFormat:@"[welcome] not needed (%@)", !pending ? @"not a first install" : (MSBDVersionTested() ? @"shown before" : @"untested iPadOS version")]);
            return;
        }
        gWelcomeState = 1;
    }
#if DEBUG
    if (!forced && n % 4) return;   // (once a second)
#endif
    NSString *blocker = DMWelcomeBlocker();
    if (blocker) {
        static NSString *logged = nil;
        if (![blocker isEqualToString:logged]) { logged = blocker; DMLog([NSString stringWithFormat:@"[welcome] waiting: %@", blocker]); }
        return;
    }
    gWelcomeState = 2;
    DMWelcomeSetPref(CFSTR("welcomeShown"), kCFBooleanTrue);   // (set as it appears: whatever happens next, it is never shown again)
#if DEBUG
    if (forced) {
        struct stat st;
        if (stat("/tmp/msb-welcome-test", &st) == 0) {
            testStamp = st.st_mtime;
            long stamp = (long)testStamp; CFNumberRef num = CFNumberCreate(NULL, kCFNumberLongType, &stamp);
            DMWelcomeSetPref(CFSTR("welcomeTestStamp"), num); CFRelease(num);
        }
        unlink("/tmp/msb-welcome-test");   // (only works if mobile made it; the stamp covers the rest)
    }
#endif
    UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();   // (marked: other alerts of ours wait for it)
    gWelcomeWindow = w;
    UIAlertController *a = [UIAlertController alertControllerWithTitle:@"Welcome to your new iPad" message:@"Check out Settings for exciting customizations." preferredStyle:UIAlertControllerStyleAlert];
    [a addAction:[UIAlertAction actionWithTitle:@"Dismiss" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { DMWelcomeClose(@"Dismiss", NO); }]];
    UIAlertAction *go = [UIAlertAction actionWithTitle:@"Take Me There" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) {
        DMWelcomeClose(@"Take Me There", NO);
        MSBDOpenStatusBarPage();
    }];
    [a addAction:go];
    a.preferredAction = go;
    [w.rootViewController presentViewController:a animated:YES completion:nil];
    DMLog([NSString stringWithFormat:@"[welcome] shown%@", forced ? @" (test file)" : @""]);
}
// ---- External display notice (2026-09-26): once ever, when a TV becomes a screen of its own while windowing is on -----------------------------
// iPadOS 16 with an extended display (TrollPad's external display option, or Stage Manager): the TV gets SpringBoard's own UI and our status bar,
// but the window engines' windows stay on the iPad. A one-time note says so and how to use apps on the TV. Only when a status bar copy of ours is
// really on another screen (plain mirroring -- the only kind on iPadOS 15 -- has none), windowing is on and an engine runs (never in the stock
// mode: this is the full mode's tick). Waits while locked, the Cover Sheet, Control Center, the App Switcher, a menu or another alert of ours is up;
// put away on lock like every alert of ours (AlertQueue.h). The pref is set as it appears: it never comes back. Debug: `extnotice_show`/`_reset`.
static UIWindow *gExtNoticeWindow;
static BOOL DMExtDisplayConnected(void) {
    for (UIView *fg in gCopies.allObjects) if (fg.window && DMExternalScreenOf(fg)) return YES;
    return NO;
}
static void DMCheckExtDisplayNotice(void) {
    static int state = 0;   // 0 not looked at yet, 1 not shown yet, 2 done (shown before, or not for this iPad)
    static int n = 0;
    BOOL forced = gExtNoticeForce;
    if (gExtNoticeWindow || (state == 2 && !forced)) return;
    if (++n % 4 && !forced) return;   // (once a second)
    if (state == 0) {
        if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 || DMWelcomePref(CFSTR("extDisplayNoticeShown"))) { state = 2; if (!forced) return; }
        else state = 1;
    }
    if (!forced) {
        if (!DMExtDisplayConnected() || !DMWindowingEnabled() || DMActiveEngine() == DMEngineNone) return;
        if (DMSMEngine()) return;   // (its text is about the other engines: Stage Manager's windows do move between displays)
        NSString *blocker = nil;
        if (DMProcessAge() < 10.0) blocker = @"SpringBoard starting";
        else if (!DMScreenOnAndUnlocked() || DMCoverSheetShown() || MSBDAlertLockedOrCovered()) blocker = @"locked or covered";
        else if (DMSwitcherVisible() || DMControlCenterActive()) blocker = @"App Switcher / Control Center";
        else if (gOverlay) blocker = @"a menu";
        else if (gWelcomeWindow || gEngineWarningWindow || gRestoringWindows || MSBDAlertBusy(nil)) blocker = @"another alert / window restore";
        if (blocker) {
            static NSString *logged = nil;
            if (![blocker isEqualToString:logged]) { logged = blocker; DMLog([NSString stringWithFormat:@"[extnotice] waiting: %@", blocker]); }
            return;
        }
    }
    gExtNoticeForce = NO;
    state = 2;
    DMWelcomeSetPref(CFSTR("extDisplayNoticeShown"), kCFBooleanTrue);   // (set as it appears: whatever happens next, it is never shown again)
    UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();   // (marked: other alerts of ours wait for it; on the iPad)
    gExtNoticeWindow = w;
    UIAlertController *a = [UIAlertController alertControllerWithTitle:@"External Display"
        message:@"To use windowed apps on this display, open them from its App Library. Apps opened from the Dock or Spotlight open on the iPad, and windows can't be moved between displays yet. For apps anywhere on this display, turn off Enable Windowing in Settings > Status Bar and use Stage Manager."
        preferredStyle:UIAlertControllerStyleAlert];
    void (^close)(NSString *) = ^(NSString *how) {
        if (!gExtNoticeWindow) return;
        gExtNoticeWindow.hidden = YES; gExtNoticeWindow = nil;
        DMLog([NSString stringWithFormat:@"[extnotice] closed: %@", how]);
    };
    [a addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { close(@"OK"); }]];
    [a addAction:[UIAlertAction actionWithTitle:@"Open Settings" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) { close(@"Open Settings"); MSBDOpenStatusBarPage(); }]];
    [w.rootViewController presentViewController:a animated:YES completion:nil];
    MSBDAlertCloseOnLock(w, ^{ gExtNoticeWindow = nil; DMLog(@"[extnotice] put away: locked (counts as shown)"); });
    DMLog([NSString stringWithFormat:@"[extnotice] shown%@", forced ? @" (debug trigger)" : @""]);
}
// ---- Stage Manager engine notice (1.1.0, 2026-09-29): once ever, on an UPDATE on iPadOS 16 -----------------------------------------------------
// Stage Manager became a window engine in 1.1.0. Existing iPadOS 16 users hear about it once, on the Home Screen with nothing else up (the welcome's
// waits, DMWelcomeBlocker): where this iPad can run Stage Manager (common/StageManagerAvailable.h) with Choose Engine (Settings > Status Bar, where
// Window Engine is) or Not Now; where it can't, that TrollPad turns it on (OK only). Not when Stage Manager is already the engine, never on iPadOS
// 15, never after a first install (the root helper marks it shown there: new installs start on Stage Manager). The pref is set as it appears.
// Debug: `smnotice_show` (now, whatever the conditions) / `smnotice_reset`.
static UIWindow *gSMEngineNoticeWindow;
static void DMCheckSMEngineNotice(void) {
    static int state = 0;   // 0 not looked at yet, 1 not shown yet, 2 done
    static int n = 0;
    BOOL forced = gSMEngineNoticeForce;
    if (gSMEngineNoticeWindow || (state == 2 && !forced)) return;
    if (++n % 4 && !forced) return;   // (once a second)
    if (state == 0 && !forced) {
        struct stat st;
        BOOL firstInstall = stat(MSBD_WELCOME_PENDING, &st) == 0;
        if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 || DMWelcomePref(CFSTR("stageManagerEngineNoticeShown")) || firstInstall
            || !MSBDVersionTested() || [gEnginePref isEqualToString:@"stagemanager"]) { state = 2; return; }
        // (Stage Manager is here but the engine's self-check failed on this iPadOS: nothing to offer -- not marked shown, so an update that
        //  supports this version can still show it)
        if (MSBDStageManagerAvailable() && gSMCheckDone && !gSMCheckOK) { state = 2; DMLog(@"[smnotice] not shown: the engine is not supported on this iPadOS version"); return; }
        state = 1;
    }
    if (!forced) {
        if (DMProcessAge() < 30.0) return;
        // (logic test F4: 17 s after a respring it came up over windows Aerial was still restoring: it waits for the restore, then for the
        //  welcome's own "Home Screen, nothing in front")
        NSString *blocker = gWelcomeWindow ? @"the welcome" : (gRestoringWindows ? @"windows being restored" : DMWelcomeBlocker());
        if (blocker) {
            static NSString *logged = nil;
            if (![blocker isEqualToString:logged]) { logged = blocker; DMLog([NSString stringWithFormat:@"[smnotice] waiting: %@", blocker]); }
            return;
        }
    }
    gSMEngineNoticeForce = NO;
    state = 2;
    DMWelcomeSetPref(CFSTR("stageManagerEngineNoticeShown"), kCFBooleanTrue);   // (set as it appears: whatever happens next, it is never shown again)
    BOOL available = MSBDStageManagerAvailable();
    UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();
    gSMEngineNoticeWindow = w;
    UIAlertController *a = [UIAlertController alertControllerWithTitle:@"New: Stage Manager Window Engine"
        message:available
            ? @"MacStatusBar&Dock can now use iPadOS's own Stage Manager as its window engine, with Mac-style windows, traffic lights and window menus."
            : @"MacStatusBar&Dock can now use iPadOS's own Stage Manager as its window engine. This iPad doesn't have Stage Manager: TrollPad can turn it on, and then Stage Manager appears in Settings > Status Bar > Window Engine."
        preferredStyle:UIAlertControllerStyleAlert];
    void (^close)(NSString *) = ^(NSString *how) {
        if (!gSMEngineNoticeWindow) return;
        gSMEngineNoticeWindow.hidden = YES; gSMEngineNoticeWindow = nil;
        DMLog([NSString stringWithFormat:@"[smnotice] closed: %@", how]);
    };
    if (available) {
        [a addAction:[UIAlertAction actionWithTitle:@"Not Now" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { close(@"Not Now"); }]];
        UIAlertAction *choose = [UIAlertAction actionWithTitle:@"Choose Engine" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) { close(@"Choose Engine");
            // (windows minimized first: logic test F4 -- Settings opening full screen made Fit to Window re-tile a window over the picker)
            BOOL windows = DMVisibleWindowCount() > 0;
            if (windows) DMMinimizeAllWindows();
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((windows ? 0.8 : 0.0) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMOpenStatusBarSettings(2); });   // (straight to the Window Engine picker)
        }];
        [a addAction:choose];
        a.preferredAction = choose;
    } else [a addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { close(@"OK"); }]];
    [w.rootViewController presentViewController:a animated:YES completion:nil];
    MSBDAlertCloseOnLock(w, ^{ gSMEngineNoticeWindow = nil; DMLog(@"[smnotice] put away: locked (counts as shown)"); });
    DMLog([NSString stringWithFormat:@"[smnotice] shown (%@)%@", available ? @"Stage Manager available" : @"needs TrollPad", forced ? @" (debug trigger)" : @""]);
}
// Aerial installed but not activated yet (Aerial 5.0 checks its license in its own Settings page and then resprings; until then it opens no
// windows, DMAerialCheckItWorked): apps quietly opened full screen and nothing said why (2026-09-26). Now a note says so and leads to
// Aerial's page, once per SpringBoard run in which it is seen (after the activation's respring Aerial works and it never comes again).
static UIWindow *gAerialNoteWindow;
static void DMCheckAerialNote(void) {
    if (!gAerialNotePending || gAerialNoteWindow) return;
    if (!DMScreenOnAndUnlocked() || DMCoverSheetShown() || MSBDAlertLockedOrCovered() || DMSwitcherVisible() || DMControlCenterActive() || gOverlay
        || gWelcomeWindow || gEngineWarningWindow || gExtNoticeWindow || gRestoringWindows || MSBDAlertBusy(nil)) return;
    gAerialNotePending = NO;
    UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();
    gAerialNoteWindow = w;
    UIAlertController *a = [UIAlertController alertControllerWithTitle:@"Aerial Isn't Active Yet"
        message:@"Aerial opens windows only after it has been activated in its own settings. Until then, apps open full screen. Open Aerial's settings, activate it, and let it respring."
        preferredStyle:UIAlertControllerStyleAlert];
    void (^close)(NSString *) = ^(NSString *how) {
        if (!gAerialNoteWindow) return;
        gAerialNoteWindow.hidden = YES; gAerialNoteWindow = nil;
        DMLog([NSString stringWithFormat:@"[aerialnote] closed: %@", how]);
    };
    [a addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { close(@"OK"); }]];
    [a addAction:[UIAlertAction actionWithTitle:@"Open Aerial Settings" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) {
        close(@"Open Aerial Settings");
        DMOpenURL(@"prefs:root=Aerial", @"Aerial's settings (not activated note)");
    }]];
    [w.rootViewController presentViewController:a animated:YES completion:nil];
    MSBDAlertCloseOnLock(w, ^{ gAerialNoteWindow = nil; DMLog(@"[aerialnote] put away: locked"); });
    DMLog(@"[aerialnote] shown");
}
// Control Center's Stage Manager button does nothing while our window engine runs (DMStageManagerHeldNow): the first time it is tapped, a one-time
// note says why and how to get it, once Control Center has closed (the same waits as the external display note). The pref is set as it appears.
static BOOL gStageNotePending = NO;
static UIWindow *gStageNoteWindow;
static void DMCheckStageManagerNote(void) {
    if (!gStageNotePending || gStageNoteWindow) return;
    if (DMWelcomePref(CFSTR("stageManagerNoteShown"))) { gStageNotePending = NO; return; }
    if (!DMScreenOnAndUnlocked() || DMCoverSheetShown() || MSBDAlertLockedOrCovered() || DMSwitcherVisible() || DMControlCenterActive() || gOverlay
        || gWelcomeWindow || gEngineWarningWindow || gExtNoticeWindow || gRestoringWindows || MSBDAlertBusy(nil)) return;
    gStageNotePending = NO;
    DMWelcomeSetPref(CFSTR("stageManagerNoteShown"), kCFBooleanTrue);
    UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0); DMSnapInvalidate();
    gStageNoteWindow = w;
    UIAlertController *a = [UIAlertController alertControllerWithTitle:@"Stage Manager Is Off"
        message:@"Stage Manager stays off while windowing is on. To use it, turn off Enable Windowing in Settings > Status Bar."
        preferredStyle:UIAlertControllerStyleAlert];
    void (^close)(NSString *) = ^(NSString *how) {
        if (!gStageNoteWindow) return;
        gStageNoteWindow.hidden = YES; gStageNoteWindow = nil;
        DMLog([NSString stringWithFormat:@"[stagemgr] note closed: %@", how]);
    };
    [a addAction:[UIAlertAction actionWithTitle:@"OK" style:UIAlertActionStyleCancel handler:^(UIAlertAction *act) { close(@"OK"); }]];
    [a addAction:[UIAlertAction actionWithTitle:@"Open Settings" style:UIAlertActionStyleDefault handler:^(UIAlertAction *act) { close(@"Open Settings"); MSBDOpenStatusBarPage(); }]];
    [w.rootViewController presentViewController:a animated:YES completion:nil];
    MSBDAlertCloseOnLock(w, ^{ gStageNoteWindow = nil; DMLog(@"[stagemgr] note put away: locked (counts as shown)"); });
    DMLog(@"[stagemgr] one-time note shown: Stage Manager is off while windowing is on");
}
static void DMTickBody(void);
#if DEBUG
static CFTimeInterval gIdleQuietUntil = 0;   // (debug, idleexp_quiet: the tick and the 0.2 s watcher skip their work until then)
#endif
static void DMTick(void) {
#if DEBUG
    if (CACurrentMediaTime() < gIdleQuietUntil) { dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMTick(); }); return; }
#endif
    CFTimeInterval began = CACurrentMediaTime();
    DMSnapBegin();
    DM_PERF("tick", DMTickBody());
    DMSnapEnd();
    double ms = (CACurrentMediaTime() - began) * 1000.0;
    if (ms > 15.0 && DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[perf] DMTick took %.1f ms", ms]);
}
static void DMTickBody(void) {
    DMCheckEngineWarnings();
    DMCheckWelcome();
    DMCheckExtDisplayNotice();
    DMCheckSMEngineNotice();
    DMCheckStageManagerNote();
    DMCheckAerialNote();
    DM_PERF("t-today", DMWatchTodayView());
    { static int n = 0; if (++n % 10 == 1 && DMProcessAge() > 8.0) DMApplyHomeScreenTodayPage(); }   // (~every 2 s once SpringBoard is up: the Home Screen may be rebuilt)
    static BOOL engineLogged = NO;   // once per SpringBoard start: which engine is picked, and which engine libraries really loaded (engine exclusivity check)
    if (!engineLogged && CACurrentMediaTime() > 0) {
        engineLogged = YES;
        NSMutableArray *loaded = [NSMutableArray array];
        for (uint32_t i = 0; i < _dyld_image_count(); i++) {
            const char *p = _dyld_get_image_name(i);
            if (!p || !(strstr(p, "DynamicLibraries") || strstr(p, "TweakInject"))) continue;
            NSString *n = [[@(p) lastPathComponent] stringByDeletingPathExtension];
            if ([@[@"Aerial", @"MilkyWay4", @"MilkyWay3SubModule", @"Zetsu"] containsObject:n]) [loaded addObject:n];
        }
        DMLog([NSString stringWithFormat:@"[engine] picked %@; engine libraries loaded in SpringBoard: %@%@", gEnginePref ?: @"(default)", loaded.count ? [loaded componentsJoinedByString:@" "] : @"none", ([loaded containsObject:@"Aerial"] + ([loaded containsObject:@"MilkyWay4"] || [loaded containsObject:@"MilkyWay3SubModule"]) + [loaded containsObject:@"Zetsu"]) > 1 ? @" -- MORE THAN ONE ENGINE LOADED" : @""]);
        // MacSettings' root helper keeps the other engines from loading, in Choicy or (without it) through iCleaner Pro's renames; it re-reads the
        // choice itself -- the picked engine, or the default when none is picked (see MacSettings/sshtoggled/main.m). Asked at every start, which
        // also covers an engine update that brought a disabled engine back. If a second engine really loaded this time AND the helper then really
        // switched one off (it says so, naming this SpringBoard), the user is asked once to respring (DMCheckEngineWarnings).
        NSUInteger engines = [loaded containsObject:@"Aerial"] + ([loaded containsObject:@"MilkyWay4"] || [loaded containsObject:@"MilkyWay3SubModule"]) + [loaded containsObject:@"Zetsu"];
        // (Also when NO engine loaded while windowing is on: e.g. the user denied the default engine in Choicy themselves with none picked, so the
        //  helper switches the next one on -- without a respring the iPad would have no windows and nothing would say why.)
        // (none installed at all -- no engine library, not even one switched off -- then the helper can't switch one on: nothing to wait for)
        BOOL anyEngineFile = NO;
        for (NSString *lib in @[@"Aerial", @"MilkyWay4", @"Zetsu"]) for (NSString *ext in @[@"dylib", @"disabled"])
            if (access([NSString stringWithFormat:@"/var/jb/usr/lib/TweakInject/%@.%@", lib, ext].fileSystemRepresentation, F_OK) == 0) anyEngineFile = YES;
        gEngineAskNone = engines == 0 && DMWindowingEnabled() && anyEngineFile && !DMSMEnginePicked();   // (Stage Manager as the engine: none of them is meant to load)
        // (Stage Manager picked and its self-check passes again -- an update that supports this iPadOS -- while the default engine that stood in
        //  for it still loaded: the helper switches that one off, and the user is asked the same way)
        gEngineAskSMBack = engines >= 1 && [gEnginePref isEqualToString:@"stagemanager"] && gSMCheckOK && DMWindowingEnabled();
        if ((engines > 1 || gEngineAskNone || gEngineAskSMBack) && access("/var/jb/usr/libexec/sshtoggled", X_OK) == 0) {
            gEngineAskWaiting = YES;
            static int changedToken = 0;
            notify_register_dispatch("com.besiktasliseba.msb.engines.changed", &changedToken, dispatch_get_main_queue(), ^(int t) {
                uint64_t pid = 0; notify_get_state(t, &pid);
                if (pid != (uint64_t)getpid()) return;
                gEngineRespringAsk = YES; gEngineAskWaiting = NO;
                DMLog(gEngineAskNone ? @"[engine] the helper switched an engine on" : @"[engine] the helper switched the extra engine off");
            });
        }
        notify_post("com.besiktasliseba.msb.engines.apply");
    }
    NSString *realBid = [DMFrontApp() bundleIdentifier] ?: @"";
    static NSString *gLastReal = nil;
    BOOL realChanged = ![realBid isEqualToString:gLastReal ?: @""];
    gLastReal = realBid;
    NSString *bid = [DMActiveApp() bundleIdentifier] ?: @"";   // the active app: the topmost window's app while windows are in front
    BOOL frontChanged = ![bid isEqualToString:gLastFront ?: @""];
    gLastFront = bid;
    // (the same app going full screen -> window (the green light) or back keeps the front app, but its traffic lights move between the status
    // bar and the window: without a layout here the status bar kept its full-screen lights until the next minute, M1 portrait, 26 Sep)
    static BOOL lastOwn = NO;
    BOOL ownNow = DMWindowsOwnStatusBar(), ownChanged = ownNow != lastOwn;
    lastOwn = ownNow;
    long second = (long)[[NSDate date] timeIntervalSince1970];
    long stamp = gShowSeconds ? second : second / 60;   // seconds tick each second, otherwise each minute
    BOOL secondChanged = stamp != gLastSecond;
    gLastSecond = stamp;
    if (realChanged) {
        gWindowsPinnedForward = NO; gFullScreenActivatedBundle = nil;
        // A full-screen app came to the front and the windows went behind it: an app in a window that was typing puts its keyboard away (it stayed
        // over the full-screen app, belonging to a window nobody could see).
        if (realBid.length && gWindowsBehindApps && DMActiveEngine() != DMEngineNone) {
            UIView *host = DMKeyboardPresentingHost();
            if (host && [NSStringFromClass([host.window class]) isEqualToString:@"AerialKeyboardWindow"]) {
                DMResignWindowedKeyboards(nil);
                DMLog([NSString stringWithFormat:@"[focus] %@ came to the front over the windows: the windows' keyboard put away", realBid]);
            }
        }
        // Tells DockMagnification's Downloads panel to close itself if it is open: switching to a different front app (very often a full-
        // screen one) out from under an open panel left it in a stale state (anchored to a Dock icon that is no longer the reason it is
        // being looked at). Simplest correct trigger: this already-computed "the real frontmost app changed" flag, not a narrower "just
        // went full screen" check — any real app switch is a reasonable moment to close it, not only that one case.
        notify_post("com.besiktasliseba.dockmagnification/frontAppChanged");
    }
    {   // a new (or newly raised) window on top clears the full-screen app's reclaimed status bar too, the same as a tap on that window would
        BOOL stageEngine = DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu;
        UIView *top = !DMWindowWorkNeeded() ? nil : (stageEngine ? DMTopStage() : DMTopWindow());
        NSString *topBundle = top ? (stageEngine ? DMStageBundle(top) : [(AXWindowView *)top bundleIdentifier]) : nil;
        static NSString *gLastTop = nil;
        if (![topBundle isEqualToString:gLastTop]) { gLastTop = topBundle; if (topBundle.length) gFullScreenActivatedBundle = nil; }
    }
    if (gDockMenuOpen) {   // never stay lowered if the menu is gone
        BOOL present = NO;
        for (UIWindow *w in DMAllWindows())
            if ([NSStringFromClass([w class]) isEqualToString:@"SBFloatingDockWindow"]) {
                NSMutableArray *names = [NSMutableArray array];
                DMCollectClassNames(w, 0, names);
                if ([names containsObject:@"_UIContextMenuContainerView"]) present = YES;   // (any Dock: with an external display there are two)
            }
        if (!present) { gDockMenuOpen = NO; DMLog(@"[lights] dock menu gone (safety reset)"); }
    }
    if (gHomeMenuOpen) {   // never stay faded if the Home Screen icon menu is gone
        BOOL present = NO;
        for (UIWindow *w in DMAllWindows())
            if ([NSStringFromClass([w class]) isEqualToString:@"SBHomeScreenWindow"]) {
                NSMutableArray *names = [NSMutableArray array];
                DMCollectClassNames(w, 0, names);
                if ([names containsObject:@"_UIContextMenuContainerView"]) present = YES;
            }
        if (!present) { gHomeMenuOpen = NO; DMLog(@"[lights] Home Screen icon menu gone (safety reset)"); DMSyncWindowFade(); }
    }
    DM_PERF("t-level", DMApplyWindowLevel());
    DMStartClockBalanceIfNeeded();
    DM_PERF("t-save", DMSaveWindowState());
    // DEVELOPMENT AID: while /tmp/macstatusbar-dim exists the screen is held at its lowest brightness (a respring puts it back up)
    if (DMTestFlag("/tmp/macstatusbar-dim") && [UIScreen mainScreen].brightness > 0.02) {
        void *bks = dlopen("/System/Library/PrivateFrameworks/BackBoardServices.framework/BackBoardServices", RTLD_LAZY);
        void (*setBrightness)(float, int) = bks ? dlsym(bks, "BKSDisplayBrightnessSet") : NULL;
        void (*setAuto)(int) = bks ? dlsym(bks, "BKSDisplayBrightnessSetAutoBrightnessEnabled") : NULL;
        if (setAuto) setAuto(0);
        if (setBrightness) setBrightness(0.0f, 1);
    }
    static int sshTick = 0;   // (perf step 8: the SSH state file is read once a second, not on every 0.25 s tick; the icon follows <= 1 s later)
    BOOL sshNow = (sshTick++ % 4 == 0) ? DMSSHOn() : gSSHActive, sshChanged = sshNow != gSSHActive;
    if (sshChanged) { gSSHActive = sshNow; DMLog([NSString stringWithFormat:@"[ssh] status bar icon %@", sshNow ? @"on" : @"off"]); }
    { static int vpnTick = 0; if (vpnTick++ % 15 == 0) DMRefreshVPNState(); }   // asks NetworkExtension, so not every 0.2 s tick
    {   // Dock recent apps: an app used in a window counts as used, like a full-screen one (DockMagnification puts it in the Dock's recents)
        static NSString *lastTopWindow = nil;
        UIView *topStage = DMWindowWorkNeeded() ? DMTopStage() : nil;
        NSString *tb = topStage ? DMStageBundle(topStage) : nil;
        if (tb.length && ![tb isEqualToString:lastTopWindow ?: @""] && DMScreenOnAndUnlocked()) {
            void (*note)(NSString *) = (void (*)(NSString *))dlsym(RTLD_DEFAULT, "DMDockNoteWindowedApp");
            if (note) note(tb);
        }
        lastTopWindow = [tb copy];
    }
    // (perf: with seconds shown, only the time changes most seconds. The time label uses tabular digits, so its width stays the same within a
    // minute: its text is set directly instead of re-laying out the whole status bar every second (~3.5 ms each on the M1). A new minute, a
    // front app change, the SSH icon, or a label that is not set up yet (no tabular font) still get the full layout.)
    static long lastMinute = -1;
    BOOL minuteChanged = second / 60 != lastMinute;
    lastMinute = second / 60;
    // (the seconds switch just changed, e.g. turned on in Settings: the label is still sized for the old text, so the first ticks after it must be
    // full layouts, or the longer "10:23:45 AM" overflows its old width and the AM is pushed right and cut off: iPad 2, landscape, 26 Sep)
    static BOOL lastShowSeconds = NO; static int fullTicksLeft = 0;
    if (gShowSeconds != lastShowSeconds) { lastShowSeconds = gShowSeconds; fullTicksLeft = 3; secondChanged = YES; }
    BOOL mustFull = fullTicksLeft > 0; if (mustFull) fullTicksLeft--;
    if (secondChanged && gShowSeconds && !mustFull && !minuteChanged && !frontChanged && !ownChanged && !sshChanged && !DMTestFlag("/tmp/msb-fullsecondlayout")) DM_PERF("t-secfast", {
        NSString *clockText = DMTimeString();
        BOOL allSet = YES;
        for (UIView *fg in gCopies.allObjects) {
            if (!fg.window || fg.window.hidden) continue;
            UIView *container = DMLeadingContainer(fg);
            UIView *tl = container ? DMFirstStringView(container) : nil;
            UIFont *tabular = tl ? objc_getAssociatedObject(tl, kTabularFontKey) : nil;
            if (![tl isKindOfClass:[UILabel class]] || !tabular || ![((UILabel *)tl).font isEqual:tabular]) { allSet = NO; break; }
            if (((UILabel *)tl).text.length != clockText.length) { allSet = NO; break; }   // (a different length needs a new width: full layout)
            if (![((UILabel *)tl).text isEqualToString:clockText]) ((UILabel *)tl).text = clockText;
        }
        if (allSet) secondChanged = NO;
    });
    if (frontChanged || ownChanged || secondChanged || sshChanged) {
        for (UIView *fg in gCopies.allObjects) {
            if ((frontChanged || ownChanged) && fg.window) [(_UIStatusBarForegroundView *)fg dm_layoutLogo];   // now, even if not on screen
            if (fg.window && !fg.window.hidden) [fg setNeedsLayout];
        }
        if (frontChanged) DMLog([NSString stringWithFormat:@"[front] now \"%@\"", bid.length ? bid : @"(home screen)"]);
    }
    if (frontChanged && bid.length) DMSMSetMinimized(bid, NO);   // (Stage Manager engine: a minimized window in front again, by any path, is a window again)
    if (frontChanged) DMLightGroupsRefresh();   // (window lights: colored on the active app's window only)
    static BOOL ccWasActive = NO;
    BOOL ccActive = DMControlCenterActive();
    if (ccWasActive && !ccActive) {
        for (UIView *fg in gCopies.allObjects) {
            UIView *modern = fg.superview.superview;
            NSNumber *intended = modern ? objc_getAssociatedObject(modern, kIntendedAlphaKey) : nil;
            if (!intended) continue;
            objc_setAssociatedObject(modern, kIntendedAlphaKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (fabs(modern.alpha - intended.doubleValue) > 0.01) {
                DMLog([NSString stringWithFormat:@"[keepbar] Control Center closed: applying the held-back alpha %.2f", intended.doubleValue]);
                modern.alpha = intended.doubleValue;
            }
        }
    }
    ccWasActive = ccActive;
    // A menu, dialog or chooser left open (the Fit "Where should ... go?" question stayed on top of the App Switcher until its 12 s deadline, iPad 2)
    // goes away when the App Switcher, Control Center or the Lock Screen comes up, like menus on a Mac when Mission Control opens. Seen on two ticks
    // in a row (0.5 s), so a passing reading during an app's opening never closes one; Spotlight closes them too. The Today View drop-down closes too: it is an overlay in our
    // menu window like the menus (it sat on top of the App Switcher); the Lock Screen's Today View is the Cover Sheet's own page, never an overlay.
    // Closing the Fit question this way applies the default arrangement, as any other close does.
    {
        static int systemUITicks = 0;
        NSString *systemUI = nil;
        if (gOverlay) {
            if (DMSwitcherVisible()) systemUI = @"the App Switcher";
            else if (ccActive) systemUI = @"Control Center";
            else if (DMLockUp(DMSBManager("SBLockScreenManager"))) systemUI = @"the Lock Screen";
            else if (DMSpotlightShown()) systemUI = @"Spotlight";   // (layering audit F11: the menu stayed open behind Spotlight and was still there after)
            else if (DMCoverSheetShown()) systemUI = @"Notification Center";   // (pulled down while unlocked: it is not "locked"; layering audit #10)
        }
        if (gOverlay || gKbLowered) DMMenuKeyboardOrder();
        if (!systemUI) systemUITicks = 0;
        // (a switcher transition event to mode 2, or Control Center's own window, is not a passing reading: one tick is enough there; the Today
        // panel sat over the App Switcher / Control Center for ~0.6 s with two, M1 26 Sep)
        // (Control Center at once only while it is really presented: during its dismissal it still reads "visible" for ~0.3 s, and a menu opened
        // then must not close on the next tick -- two ticks there, like any passing reading; layering audit #11)
        else if ((++systemUITicks >= 2 || (gEnvMode == 2 && DMSwitcherVisible())
                  || (ccActive && [DMBoolStr(DMCall(objc_getClass("SBControlCenterController"), @"sharedInstance"), @"isPresented") isEqualToString:@"Y"]))
                 && !DMTestFlag("/tmp/msb-overlay-keep")) {
            systemUITicks = 0;
            DMLog([NSString stringWithFormat:@"[overlay] %@ came up while a menu or question was open: closed", systemUI]);
            DMCloseOverlay();
        }
    }
    {   // the Dock above any window that overlaps it, and back to its own level when none does (Dock part: DMDockReassertLevel, layering audit F4)
        static void (*reassert)(BOOL) = NULL; static int lookups = 0;
        if (!reassert && lookups++ % 20 == 0) reassert = (void (*)(BOOL))dlsym(RTLD_DEFAULT, "DMDockReassertLevel");   // (the Dock part may load later, or not at all)
        static int idle = 0;   // (no window: once a second only, to put back a Dock left raised; idle cost trimmed like the rest of the tick)
        // (a software keyboard up counts as system UI too: the floor, 1034, would sit above a windowed app's keyboard on MilkyWay4, 1033, and
        // Zetsu, 1003, and cover its middle keys -- the Dock keeps its own level while one is up; layering audit #1)
        if (reassert && (DMWindowWorkNeeded() || ++idle % 4 == 0)) reassert(DMSwitcherVisible() || ccActive || gSoftKeyboardH > 100.0);
    }
#if DEBUG
    DMCheckTrigger();
    DMUpdateFlashRecorder();
    if (DMWatching()) DMWatchState();
#endif
    static int snapTick = 0;
    DM_PERF("t-a5lights", DMAerial5Lights());   // Aerial 5.0 only (no-op otherwise)
    DM_PERF("t-a5watch", DMAerial5Watch());    // Aerial 5.0 only (no-op otherwise)
    DMAerial5PrefsWatch();   // Aerial 5.0's own settings: held while it is our engine, given back otherwise
    DMEnginePrefsWatch();   // Zetsu's and MilkyWay4's own settings: the same
#if DEBUG
    if (++snapTick % 12 == 0 && DMTestFlag("/tmp/macstatusbar-snapshots")) DMDebugSnapshot();
#else
    (void)snapTick;
#endif   // its own flag: rendering the PNG costs ~50 ms on the main thread, which stutters every animation
    DM_PERF("t-minscenes", DMSyncMinimizedScenes());
    { static int pruneTick = 0; if (++pruneTick % 120 == 0) DMPruneSceneNotes(); if (pruneTick % 20 == 0) DMAutoHideRefreshTimerIfStarted(); }   // (every 30 s; the auto-hide setting every 5 s, for a change made without Settings' notification)
    if (gDMScreenOff) {   // (screen off: the chain rests until it comes on, DMScreenPowerChanged)
        gDMTickParked = YES;
#if DEBUG
        if (DMTestFlag("/tmp/macstatusbar-debug")) DMTriggerPollWhileOff();   // (debug builds only: test triggers still work, once a second)
#endif
        return;
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{ DMTick(); });
}
// Growth: the per-scene notes are dropped when their scene is gone (they were never removed: one entry per scene ever seen).
static void DMPruneSceneNotes(void) {
    NSMutableSet *alive = [NSMutableSet set];
    for (NSString *sid in [gSceneByID allKeys]) { if (gSceneByID[sid].scene) [alive addObject:sid]; else [gSceneByID removeObjectForKey:sid]; }
    CFTimeInterval now = CACurrentMediaTime();
    for (NSString *sid in [gSceneUpdateTime allKeys]) if (![alive containsObject:sid] && now - gSceneUpdateTime[sid].doubleValue > 60.0) [gSceneUpdateTime removeObjectForKey:sid];
    for (NSString *sid in [gSaneSceneFrames allKeys]) if (![alive containsObject:sid]) [gSaneSceneFrames removeObjectForKey:sid];
    for (NSString *sid in [gKeepFgFlood allKeys]) if (![alive containsObject:sid]) [gKeepFgFlood removeObjectForKey:sid];
    for (NSString *sid in [gAccessibilitySceneFrame allKeys]) if (![alive containsObject:sid]) [gAccessibilitySceneFrame removeObjectForKey:sid];
    if (gVeilSnap && !gStageCover && CACurrentMediaTime() - gVeilColorTime > 10.0) gVeilSnap = nil;   // (a transition's picture, long finished)
}
#if DEBUG
static void DMTriggerPollWhileOff(void) {
    static BOOL polling = NO; if (polling) return; polling = YES;
    __block void (^poll)(void);
    poll = ^{
        if (!gDMScreenOff || !DMTestFlag("/tmp/macstatusbar-debug")) { polling = NO; poll = nil; return; }
        DMCheckTrigger();
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), poll);
    };
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), poll);
}
#endif
static void DMScreenPowerResume(void) {   // (the screen came on: see DMScreenPowerChanged)
    gDMAudioCheckNow = YES;   // (which app is heard is checked again on the first tick, audio audit F10)
    if (gDMTickParked) { gDMTickParked = NO; DMTick(); }
    DMAerial5StartFrameWatcher();
}

// The Home Screen's own Today View (a right swipe on the first page): on iPadOS 15 without "Keep on Home Screen" it is not a page of the icon
// list (SBRootFolderController reports that page hidden already) but an overlay (SBHomeScreenOverlayController) that SpringBoard only allows
// while -[SBIconController allowsHomeScreenOverlay] says so. While the clock opens the Today View it says no, so the swipe does nothing (like on
// a Mac, where the widgets come from the clock). The App Library is a different overlay and is not affected.
@interface SBIconController : UIViewController
@end
%hook SBIconController
- (BOOL)allowsHomeScreenOverlay {
    return gClockOpensToday ? NO : %orig;
}
%end

// ===== optional: no Cover Sheet pull-down from the pointer at the top edge ===
// The Cover Sheet's gesture delegate keeps separate recognizers for touch (presentGestureRecognizer) and for the
// pointer (indirectPresentGestureRecognizer). Refusing to let the pointer one begin stops pushing the pointer against
// the top edge from pulling the Cover Sheet down, while a finger swipe from the top and clicking the status bar
// icons still work. Only the "present" gesture is blocked, not the dismiss one.
@interface SBCoverSheetSystemGesturesDelegate : NSObject
- (UIGestureRecognizer *)indirectPresentGestureRecognizer;
@end

// Its own group, so the stock status bar keeps it too (StockBar.h: DMPointerPullInit, with its own reader of the one setting).
%group PointerPull
%hook SBCoverSheetSystemGesturesDelegate
- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)gr {
    UIGestureRecognizer *indirect = [self respondsToSelector:@selector(indirectPresentGestureRecognizer)] ? [self indirectPresentGestureRecognizer] : nil;   // (a private selector: guarded)
    if (!gStockBar && gr != nil && indirect && gr == indirect && DMAutoHideHandlePointerPull()) return NO;   // auto-hiding status bar: the push shows our bar instead (like macOS)
    if (gBlockPointerPull && gr != nil && indirect && gr == indirect) return NO;
    BOOL r = %orig;
    if (DMTestFlag("/tmp/msb-cs-trace")) DMLog([NSString stringWithFormat:@"[cstrace] shouldBegin %@ -> %d", gr, r]);
    return r;
}
%end
%end
static void DMPointerPullInit(void) { static BOOL done; if (done) return; done = YES; %init(PointerPull); }

// The three dots at the top centre of full-screen apps (iPadOS's multitasking button) are SpringBoard's own _SBTopAffordanceView. With the
// setting on they are kept hidden (and cannot be touched); off, they behave as usual.
@interface _SBTopAffordanceView : UIView
@end
static const void *kDotsTouchOffKey = &kDotsTouchOffKey;
// iPadOS 17+ (untested versions; a tester on 18.7.2 crashed with Split View & Slide Over on): the dots are driven by new classes there, so this hook
// stands aside and they behave as on a stock iPad (15/16: as before).
static BOOL DMDotsHookOff(void) { static int off = -1; if (off < 0) off = [NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 17; return off; }
%hook _SBTopAffordanceView
- (void)layoutSubviews {
    %orig;
    gDotsAffordance = (UIView *)self;   // (recorded on every version: the status bar's hit test uses it to let taps on the dots through)
    if (DMDotsHookOff()) return;
    UIView *v = (UIView *)self;
    if (gHideMultitaskingDots) { gDotsOwnChange = YES; v.hidden = YES; gDotsOwnChange = NO; v.userInteractionEnabled = NO; objc_setAssociatedObject(v, kDotsTouchOffKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    else if (objc_getAssociatedObject(v, kDotsTouchOffKey)) { v.userInteractionEnabled = YES; objc_setAssociatedObject(v, kDotsTouchOffKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }   // (switched off: tappable again)
}
- (void)setHidden:(BOOL)hidden {
    if (DMDotsHookOff()) {
        %orig;
        return;
    }
    if (!gDotsOwnChange) objc_setAssociatedObject(self, kDotsWantHiddenKey, @(hidden), OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // (what SpringBoard asked for: given back when the switch goes off)
    %orig(gHideMultitaskingDots ? YES : hidden);
}
- (void)setAlpha:(CGFloat)alpha {
    if (DMDotsHookOff()) {
        %orig;
        return;
    }
    if (!gDotsOwnChange) objc_setAssociatedObject(self, kDotsWantAlphaKey, @(alpha), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    %orig(gHideMultitaskingDots ? 0.0 : alpha);
}
%end

// (see DMStageManagerHeldNow; iPadOS 16 only: the class is looked for before the group is started)
%group StageManagerButton
%hook SBContinuousExposeModuleViewController
- (void)_toggleSelected {
    if (DMStageManagerHeldNow()) {
        CFPreferencesSetValue(CFSTR("stageManagerUserOn"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        DMLog(@"[stagemgr] Control Center's Stage Manager button tapped while our window engine runs: not switched on (it comes on when windowing is off)");
        gStageNotePending = YES;   // (the one-time note, after Control Center closes: DMCheckStageManagerNote)
        return;
    }
    %orig;
}
%end
%end
// Control Center's module bundle may load after us (Control Center is built a while after a respring): hooked as soon as its class exists
// ---- Stage Manager switched off with windows in front: SpringBoard's own reaction waits (1.3.4, the 11:58 abort) ----
// Whoever writes the switch-off -- our watcher, the root helper when Mac Status Bar is switched off or removed, Control Center's button, iPadOS
// Settings -- SpringBoard's handler (-[SBFluidSwitcherViewController _chamoisWindowingUIEnabledDefaultChangeHandler]) reacts at once: with an app in
// front it makes a transition that keeps roles 1-2 and empties 5-9, and with a stage of three windows its Dosido modifier does not find the stage
// among the app layouts and SpringBoard aborts (reproduced on the iPad 2, 16.7.7: the published 1.3.3's engine switch, 13:18:56; a write of the
// key by another process, as the root helper does, 13:24:50). While Stage Manager is or was our engine, that handler waits when it would switch
// off with more than one window in front, and runs when it is safe -- no app in front (the Home Screen: no transition) or one window -- from the
// watcher's tick; if the setting is back on by then (our engine switched it on again), there is nothing left to do. Elsewhere it runs as Apple's.
static void (*o_SMDefaultChange)(id, SEL);
static NSHashTable *gSMOffWaiting;   // (switcher view controllers whose switch-off waits; weak)
// The switcher's state for the handler: the setting now, its windowing UI now, its layout state's environment (3 = an app in front) and windows.
static BOOL DMSMSwitcherState(id vc, BOOL *settingOn, BOOL *uiOn, BOOL *appMode, NSUInteger *windows) {
    @try {
        id sd = DMSwitcherDefaults();
        id sc = DMCall(vc, @"switcherController");
        id state = DMCall(DMCall(vc, @"layoutContext"), @"layoutState");
        SEL get = NSSelectorFromString(@"chamoisWindowingEnabled"), ui = NSSelectorFromString(@"isChamoisWindowingUIEnabled"), mode = NSSelectorFromString(@"unlockedEnvironmentMode");
        if (!sd || !sc || !state || !DMSMSigOK(sd, get, DMSMSigBool(), "chamoisWindowingEnabled") || !DMSMSigOK(sc, ui, DMSMSigBool(), "isChamoisWindowingUIEnabled") || !DMSMSigOK(state, mode, DMSMSigTime(), "unlockedEnvironmentMode")) return NO;
        *settingOn = ((BOOL (*)(id, SEL))objc_msgSend)(sd, get);
        *uiOn = ((BOOL (*)(id, SEL))objc_msgSend)(sc, ui);
        *appMode = ((long long (*)(id, SEL))objc_msgSend)(state, mode) == 3;
        id els = DMCall(state, @"elements");
        *windows = [els respondsToSelector:@selector(count)] ? [els count] : 0;
        return YES;
    } @catch (NSException *e) { return NO; }
}
static BOOL DMSMOursForSwitchOff(void) {   // (Stage Manager's UI went on for our engine in this SpringBoard: SMEngineAPI.h, DMSMOwnsStageUIWith)
    if (gSMOwnsStageUI) return YES;
    CFPropertyListRef mine = CFPreferencesCopyValue(CFSTR("stageManagerOnForEngine"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (mine) CFRelease(mine);
    return DMSMOwnsStageUIWith(DMSMEngine(), mine != NULL);
}
static void DMSMDefaultChangeHook(id self, SEL _cmd) {
    BOOL settingOn = YES, uiOn = YES, appMode = NO; NSUInteger windows = 0;
    BOOL known = DMSMSwitcherState(self, &settingOn, &uiOn, &appMode, &windows);
    BOOL waiting = [gSMOffWaiting containsObject:self];
    int step = DMSMHandlerStep(known, waiting || DMSMOursForSwitchOff(), settingOn, uiOn, appMode, windows);
    if (step == DMSMHandlerWait) {
        if (!gSMOffWaiting) gSMOffWaiting = [NSHashTable weakObjectsHashTable];
        if (!waiting) DMLog([NSString stringWithFormat:@"[stagemgr] Stage Manager switched off with %lu windows in front: SpringBoard's own switch waits until no app is in front or one window is", (unsigned long)windows]);
        [gSMOffWaiting addObject:self];
        DM_FEATURE_MARK("sm-off-waits");
        return;
    }
    [gSMOffWaiting removeObject:self];
    if (step == DMSMHandlerSkip) { DMLog(@"[stagemgr] Stage Manager's setting is as SpringBoard shows it: nothing to switch"); return; }   // (a switch-off undone before it ran)
    if (known && !settingOn && uiOn && DMSMOursForSwitchOff()) DMSMFlattenStages(@"Stage Manager is switched off");   // (no stage of several windows left behind for the switcher without Stage Manager)
    o_SMDefaultChange(self, _cmd);
}
static void DMSMInstallOffWait(void) {
    static BOOL done = NO;
    if (done) return;
    done = YES;
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 || !objc_getClass("SBSwitcherChamoisSettings")) return;   // (no Stage Manager here)
    Class c = objc_getClass("SBFluidSwitcherViewController");
    SEL s = NSSelectorFromString(@"_chamoisWindowingUIEnabledDefaultChangeHandler");
    Method m = c ? class_getInstanceMethod(c, s) : NULL;
    if (!m || ![DMSMSigOfMethod(m) isEqualToString:DMSMSigVoid()]) { DMLog(@"[stagemgr] SpringBoard's Stage Manager switch handler is not as expected here: left as Apple has it"); return; }
    MSHookMessageEx(c, s, (IMP)DMSMDefaultChangeHook, (IMP *)&o_SMDefaultChange);
    DMLog(@"[stagemgr] SpringBoard's Stage Manager switch waits while windows would be dropped (Stage Manager as our engine)");
}
// The watcher's tick: a waiting switch-off runs once it is safe (or is dropped when the setting is on again: the hook sees nothing to switch).
static void DMSMRunWaitingOff(void) {
    if (!gSMOffWaiting.count) return;
    for (id vc in [gSMOffWaiting allObjects]) {
        BOOL settingOn = YES, uiOn = YES, appMode = NO; NSUInteger windows = 0;
        if (DMSMSwitcherState(vc, &settingOn, &uiOn, &appMode, &windows) && !settingOn && uiOn && DMSMEngineOffStep(10, YES, YES, appMode, windows) == DMSMOffWait) continue;
        DMLog([NSString stringWithFormat:@"[stagemgr] the waiting Stage Manager switch runs now (setting %d, %@, %lu window(s))", settingOn, appMode ? @"an app in front" : @"no app in front", (unsigned long)windows]);
        ((void (*)(id, SEL))objc_msgSend)(vc, NSSelectorFromString(@"_chamoisWindowingUIEnabledDefaultChangeHandler"));   // (through the hook: runs or drops)
    }
}
void DMInitStageManagerButtonHook(void) {
    static BOOL done = NO;
    if (done || !objc_getClass("SBContinuousExposeModuleViewController")) return;
    done = YES;
    %init(StageManagerButton);
    DMLog(@"[stagemgr] Control Center's Stage Manager button hooked");
}

// DEVELOPMENT AID (kept in every build while the owner wants it: "after every respring, go straight to the Home Screen"): while /tmp/macstatusbar-skiplock exists
//  - the screen is kept awake (the idle timer is reset every few seconds), so the iPad never times out and locks in the middle of testing
//    (a locked iPad needs Face ID / the passcode, which nothing can bypass), and
//  - whenever the lock screen is up while the device is still authenticated (for instance right after a respring), it is dismissed at once.
#if DM_LOCK_BYPASS
static int DMKeybagLockState(void) {   // MobileKeyBag: 0 = unlocked, 1 = locked (passcode needed), 2 = passcode off, 3 = ?
    static int (*fn)(CFDictionaryRef) = NULL;
    static BOOL tried = NO;
    if (!tried) {
        tried = YES;
        void *h = dlopen("/System/Library/PrivateFrameworks/MobileKeyBag.framework/MobileKeyBag", RTLD_LAZY);
        if (h) fn = (int (*)(CFDictionaryRef))dlsym(h, "MKBGetDeviceLockState");
    }
    return fn ? fn(NULL) : -1;
}
static void DMSkipLockTick(int n) {
    if (DMTestFlag("/tmp/macstatusbar-skiplock")) {
        id sb = [UIApplication sharedApplication];
        if (n % 8 == 0) for (NSString *name in @[@"resetIdleTimerAndUndim", @"_resetIdleTimerAndUndim"]) {
            SEL s = NSSelectorFromString(name);
            if ([sb respondsToSelector:s]) { ((void (*)(id, SEL))objc_msgSend)(sb, s); break; }
        }
        id mgr = DMSBManager("SBLockScreenManager");
        SEL lockedSel = NSSelectorFromString(@"isUILocked");
        BOOL locked = [mgr respondsToSelector:lockedSel] && ((BOOL (*)(id, SEL))objc_msgSend)(mgr, lockedSel);
        if (locked) {
            id backlight = DMSBManager("SBBacklightController");
            SEL onSel = NSSelectorFromString(@"screenIsOn");
            BOOL screenOn = [backlight respondsToSelector:onSel] && ((BOOL (*)(id, SEL))objc_msgSend)(backlight, onSel);
            id auth = DMCall(objc_getClass("SBFUserAuthenticationController"), @"sharedInstance");
            SEL a1 = NSSelectorFromString(@"isAuthenticated"), a2 = NSSelectorFromString(@"hasAuthenticatedAtLeastOnceSinceBoot"), a3 = NSSelectorFromString(@"_isInBioUnlockState");
            int isAuth = [auth respondsToSelector:a1] ? (int)((BOOL (*)(id, SEL))objc_msgSend)(auth, a1) : -1;
            int once = [auth respondsToSelector:a2] ? (int)((BOOL (*)(id, SEL))objc_msgSend)(auth, a2) : -1;
            int bio = [auth respondsToSelector:a3] ? (int)((BOOL (*)(id, SEL))objc_msgSend)(auth, a3) : -1;
            if (n % 4 == 0 || n < 6) DMLog([NSString stringWithFormat:@"[skiplock] tick %d: lock screen is up (keybag %d, screen on %d, authenticated %d, authenticated-since-boot %d, bio-unlock-state %d), dismissing", n, DMKeybagLockState(), screenOn, isAuth, once, bio]);
            SEL unlock = NSSelectorFromString(@"unlockUIFromSource:withOptions:");   // the call that worked before; _finishUIUnlock... CRASHES SpringBoard
            if ([mgr respondsToSelector:unlock]) ((void (*)(id, SEL, int, id))objc_msgSend)(mgr, unlock, 1, nil);
        }
    }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSkipLockTick(n + 1); });
}
#endif


// With windowing switched off, Aerial's own Control Center toggle ("open new apps as windows") must not work either: for the moment an icon
// is tapped the toggle is seen as off, and put back right after.
%group WindowingOff
%hook SBIconView
- (void)_handleTap {
    if ([gEnginePref isEqualToString:@"off"] && DMAerialInstalled() && DMAerialToggleOn()) {
        CFPreferencesSetAppValue(CFSTR("AerialEnabled"), kCFBooleanFalse, CFSTR("com.uzra.aerial"));
        CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
        %orig;
        CFPreferencesSetAppValue(CFSTR("AerialEnabled"), kCFBooleanTrue, CFSTR("com.uzra.aerial"));
        CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
        return;
    }
    %orig;
}
%end
%end

// ===== Mac-style notification banners (M1 pipeline task 3, 2026-09-24; our own clean-room replacement for "Destra") =================================
// The system banner is kept (so tapping it, long-pressing it for actions/reply, and the system's own security when locked all stay exactly as
// they are); only where it sits and how it moves and looks change, macOS-style:
//  - top right, just below our status bar, 360 pt wide (BNContentViewController decides a banner's frame: _presentedFrameForViewController:... and
//    _dismissedFrame...; we move those frames), sliding in from and out to the right instead of dropping from the top;
//  - swipe it to the right to dismiss it (our own pan; the system's vertical drag is left alone for vertical drags);
//  - with a pointer: hovering shows a Close (x) button at its top-left corner and an Options button at its top right (Options = the same actions
//    platter a long press opens);
//  - a slightly smaller macOS corner radius and a hairline edge.
// Only notification banners are touched (their view controller is an NCNotification... one), never the other system banners/HUDs.
// Settings > Status Bar > Notifications > Mac-Style Banners (on by default; live).
@interface BNContentViewController : UIViewController
- (id)_presentableForGestureInView:(UIView *)view;
- (void)_dismissPresentable:(id)presentable withReason:(NSString *)reason animated:(BOOL)animated userInfo:(id)userInfo;
@end
static BOOL DMBannersOn(void) {
    static BOOL on = YES; static CFTimeInterval readAt = -10;
    if (CACurrentMediaTime() - readAt > 2.0) {
        readAt = CACurrentMediaTime(); on = YES;
        CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("macBanners"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (v) { if (CFGetTypeID(v) == CFBooleanGetTypeID()) on = CFBooleanGetValue(v); CFRelease(v); }
        if (on && MSBDOtherTweakDoing(kMSBDDupBanners, YES)) on = NO;   // (Destra is showing Mac-style banners: ours steps aside, OtherTweaks.h)
    }
    return on;
}
static BOOL DMIsNotificationBannerVC(id vc);
// a banner, not the full-screen actions platter a long press (or Options) opens from it: that one keeps the system's own frame
static BOOL DMIsBannerFrame(id vc, CGRect systemFrame, CGRect cb) { return DMIsNotificationBannerVC(vc) && systemFrame.size.height < cb.size.height * 0.6 && systemFrame.size.width < cb.size.width; }
static BOOL DMIsNotificationBannerVC(id vc) {
    for (UIViewController *c = vc; c; c = c.childViewControllers.firstObject) if ([NSStringFromClass([c class]) hasPrefix:@"NCNotification"]) return YES;
    return [NSStringFromClass([vc class]) hasPrefix:@"NCNotification"];
}
static const CGFloat kDMBannerWidth = 360, kDMBannerRight = 10, kDMBannerTop = 24 + 8;   // (24 = our status bar)
// (a right-to-left language: mirrored -- top left, in from and out to the left, a leftward swipe, the Close button at the top right -- as the
//  clock and its Today panel are at the left end of the menu bar there, 1.3.3)
static BOOL DMBannerRTL(void) { static int v = -1; if (v < 0) v = [UIApplication sharedApplication].userInterfaceLayoutDirection == UIUserInterfaceLayoutDirectionRightToLeft; return v == 1; }
static CGRect DMBannerPresentedFrame(CGRect stock, CGRect cb) {
    CGFloat w = MIN(kDMBannerWidth, cb.size.width - 2 * kDMBannerRight);
    CGFloat x = DMBannerRTL() ? CGRectGetMinX(cb) + kDMBannerRight : CGRectGetMaxX(cb) - w - kDMBannerRight;
    return CGRectMake(x, CGRectGetMinY(cb) + kDMBannerTop, w, stock.size.height);
}
static CGRect DMBannerDismissedFrame(CGRect stock, CGRect cb) {
    CGRect p = DMBannerPresentedFrame(stock, cb);
    p.origin.x = DMBannerRTL() ? CGRectGetMinX(cb) - p.size.width - 24 : CGRectGetMaxX(cb) + 24;   // off the right edge (the shadow too); the left one mirrored
    return p;
}
static BNContentViewController *DMBannerContentController(UIView *v) {
    for (UIResponder *r = v; r; r = r.nextResponder) if ([r isKindOfClass:objc_getClass("BNContentViewController")]) return (BNContentViewController *)r;
    return nil;
}
static void DMBannerDismissWithReason(UIView *bannerView, BOOL animated, NSString *reason);
static void DMBannerDismiss(UIView *bannerView, BOOL animated) { DMBannerDismissWithReason(bannerView, animated, @"BNBannerRevocationReasonDragDismissal"); }
static void DMBannerDismissWithReason(UIView *bannerView, BOOL animated, NSString *reason) {
    BNContentViewController *c = DMBannerContentController(bannerView);
    id presentable = [c respondsToSelector:@selector(_presentableForGestureInView:)] ? [c _presentableForGestureInView:bannerView] : nil;
    DMLog([NSString stringWithFormat:@"[banner] dismiss (%@): controller %@ presentable %@", animated ? @"animated" : @"after the swipe", c ? @"yes" : @"no", presentable ? NSStringFromClass([presentable class]) : @"none"]);
    if (presentable && [c respondsToSelector:@selector(_dismissPresentable:withReason:animated:userInfo:)]) [c _dismissPresentable:presentable withReason:reason animated:animated userInfo:nil];
}
static BOOL DMInBannerWindow(UIView *v) { return [NSStringFromClass([v.window class]) isEqualToString:@"SBBannerWindow"]; }

@interface DMBannerHelper : NSObject <UIGestureRecognizerDelegate>
@property (nonatomic, weak) UIView *banner;
@property (nonatomic, strong) UIButton *closeButton, *optionsButton;
@end
@implementation DMBannerHelper
- (UIButton *)roundButton:(NSString *)symbol title:(NSString *)title {
    UIButton *b = [UIButton buttonWithType:UIButtonTypeSystem];
    UIVisualEffectView *fx = [[UIVisualEffectView alloc] initWithEffect:[UIBlurEffect effectWithStyle:UIBlurEffectStyleSystemMaterial]];
    fx.userInteractionEnabled = NO; fx.clipsToBounds = YES; fx.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
    [b addSubview:fx]; [b sendSubviewToBack:fx];
    if (symbol) {   // (a plain image view above the blur: a system button's own image view ended up under it)
        UIImageView *iv = [[UIImageView alloc] initWithImage:[[UIImage systemImageNamed:symbol withConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:9 weight:UIImageSymbolWeightBold]] imageWithRenderingMode:UIImageRenderingModeAlwaysTemplate]];
        iv.tintColor = [UIColor labelColor]; iv.contentMode = UIViewContentModeCenter; iv.userInteractionEnabled = NO;
        iv.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
        [b addSubview:iv];
    }
    if (title) { [b setTitle:title forState:UIControlStateNormal]; b.titleLabel.font = [UIFont systemFontOfSize:12 weight:UIFontWeightMedium]; }
    b.tintColor = [UIColor labelColor];
    b.layer.borderWidth = 0.5; b.layer.borderColor = [UIColor colorWithWhite:0.5 alpha:0.35].CGColor;
    b.alpha = 0;
    return b;
}
- (void)install:(UIView *)banner {
    self.banner = banner;
    UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(pan:)];
    pan.delegate = self; pan.cancelsTouchesInView = YES;
    [banner addGestureRecognizer:pan];
    UIHoverGestureRecognizer *hover = [[UIHoverGestureRecognizer alloc] initWithTarget:self action:@selector(hover:)];
    [banner addGestureRecognizer:hover];
    self.closeButton = [self roundButton:@"xmark" title:nil];
    [self.closeButton addTarget:self action:@selector(close) forControlEvents:UIControlEventTouchUpInside];
    self.optionsButton = [self roundButton:nil title:@"Options"];
    [self.optionsButton addTarget:self action:@selector(options) forControlEvents:UIControlEventTouchUpInside];
    [banner addSubview:self.closeButton]; [banner addSubview:self.optionsButton];
    [self layout];
}
- (void)layout {
    UIView *b = self.banner; if (!b) return;
    self.closeButton.frame = CGRectMake(DMBannerRTL() ? b.bounds.size.width - 13 : -7, -7, 20, 20);
    for (UIView *sv in self.closeButton.subviews) sv.frame = self.closeButton.bounds;
    self.closeButton.layer.cornerRadius = 10; ((UIView *)self.closeButton.subviews.firstObject).layer.cornerRadius = 10;
    CGSize t = [self.optionsButton.titleLabel sizeThatFits:CGSizeMake(200, 20)];
    self.optionsButton.frame = CGRectMake(DMBannerRTL() ? 8 : b.bounds.size.width - t.width - 20 - 8, 8, t.width + 20, 22);
    self.optionsButton.layer.cornerRadius = 11; for (UIView *v in self.optionsButton.subviews) if ([v isKindOfClass:[UIVisualEffectView class]]) v.layer.cornerRadius = 11;
    [b bringSubviewToFront:self.closeButton]; [b bringSubviewToFront:self.optionsButton];
}
- (void)hover:(UIHoverGestureRecognizer *)g {
    BOOL show = g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged;
    [self layout];
    [UIView animateWithDuration:0.15 animations:^{ self.closeButton.alpha = show ? 1 : 0; self.optionsButton.alpha = show ? 1 : 0; }];
}
- (void)close { DMBannerDismiss(self.banner, YES); }
- (void)options {   // the actions platter, as a long press would open it
    UIViewController *vc = nil;
    for (UIResponder *r = self.banner; r; r = r.nextResponder) if ([r isKindOfClass:objc_getClass("NCNotificationShortLookViewController")]) { vc = (UIViewController *)r; break; }
    SEL longLook = NSSelectorFromString(@"_presentLongLookForScrollAnimated:completion:");
    DMLog([NSString stringWithFormat:@"[banner] options: %@", vc ? @"opening the actions platter" : @"no short-look controller"]);
    if ([vc respondsToSelector:longLook]) ((void (*)(id, SEL, BOOL, id))objc_msgSend)(vc, longLook, YES, nil);
}
- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)g {
    if (![g isKindOfClass:[UIPanGestureRecognizer class]] || !DMBannersOn()) return NO;
    CGPoint v = [(UIPanGestureRecognizer *)g velocityInView:self.banner];
    return (DMBannerRTL() ? v.x < 0 : v.x > 0) && fabs(v.x) > fabs(v.y) * 1.2;   // rightward swipes only (leftward, right-to-left); vertical drags stay the system's
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)o { return NO; }
- (void)pan:(UIPanGestureRecognizer *)g {
    UIView *b = self.banner; if (!b) return;
    CGFloat dir = DMBannerRTL() ? -1.0 : 1.0;   // (the way out: right, or left in a right-to-left language)
    CGFloat tx = MAX(0, dir * [g translationInView:b.superview].x);
    if (g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged) { b.transform = CGAffineTransformMakeTranslation(dir * tx, 0); b.alpha = MAX(0.3, 1 - tx / 400.0); return; }
    CGFloat vx = dir * [g velocityInView:b.superview].x;
    if (g.state == UIGestureRecognizerStateEnded && (tx > 90 || vx > 600)) {
        BOOL rm = MSBReduceMotion();   // (Reduce Motion: it fades where the finger left it instead of sliding out -- 1.3.3, audit L-5)
        [UIView animateWithDuration:rm ? kMSBRMDuration : 0.2 delay:0 options:rm ? UIViewAnimationOptionCurveEaseInOut : UIViewAnimationOptionCurveEaseIn animations:^{ if (!rm) b.transform = CGAffineTransformMakeTranslation(dir * (b.bounds.size.width + 60), 0); b.alpha = 0; }
                         completion:^(BOOL f) { DMBannerDismiss(b, NO); dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ b.transform = CGAffineTransformIdentity; b.alpha = 1; }); }];
    } else {
        MSBAnimate(0.3, 0, 0.8, 0, ^{ b.transform = CGAffineTransformIdentity; b.alpha = 1; }, nil);   // (Reduce Motion: eases back, no bounce)
    }
}
@end
static const void *kDMBannerHelperKey = &kDMBannerHelperKey;
static void DMBannerDebug(NSString *what) {
    DMBannerHelper *h = nil;
    for (UIWindow *w in DMAllWindows()) {
        if (w.hidden || ![NSStringFromClass([w class]) isEqualToString:@"SBBannerWindow"]) continue;
        NSMutableArray *st = [NSMutableArray arrayWithObject:w];
        while (st.count && !h) { UIView *v = st.lastObject; [st removeLastObject]; h = objc_getAssociatedObject(v, kDMBannerHelperKey); [st addObjectsFromArray:v.subviews]; }
    }
    DMLog([NSString stringWithFormat:@"[banner] debug %@: %@", what, h ? @"banner found" : @"no banner on screen"]);
    if ([what isEqualToString:@"close"]) [h close];
    else if ([what isEqualToString:@"options"]) [h options];
    else if ([what isEqualToString:@"hover"]) { [h layout]; h.closeButton.alpha = 1; h.optionsButton.alpha = 1; }
}

%group MacBanners
%hook BNContentViewController
- (CGRect)_presentedFrameForViewController:(id)vc withContainerBounds:(CGRect)cb {
    CGRect r = %orig;
    if (!DMBannersOn() || !DMIsBannerFrame(vc, r, cb)) return r;
    CGRect f = DMBannerPresentedFrame(r, cb);
    // the system measured the banner for its own (wider) width: measure it again for ours, so a third line of text is not cut off
    SEL measure = NSSelectorFromString(@"preferredContentSizeWithPresentationSize:containerSize:");
    CGSize fit = [vc respondsToSelector:measure] ? ((CGSize (*)(id, SEL, CGSize, CGSize))objc_msgSend)(vc, measure, CGSizeMake(f.size.width, cb.size.height), cb.size) : CGSizeZero;
#if DEBUG
    static CFTimeInterval lastLog; if (CACurrentMediaTime() - lastLog > 1.0) { lastLog = CACurrentMediaTime(); DMLog([NSString stringWithFormat:@"[banner] frame %@ (system %@, measured %@)", NSStringFromCGRect(f), NSStringFromCGRect(r), NSStringFromCGSize(fit)]); }
#endif
    if (fit.height > f.size.height && fit.height < 400) f.size.height = ceil(fit.height);
    return f;
}
- (CGRect)_dismissedFrameForViewController:(id)vc withContainerBounds:(CGRect)cb {
    CGRect r = %orig;
    if (!DMBannersOn() || !DMIsBannerFrame(vc, r, cb)) return r;
    return DMBannerDismissedFrame(r, cb);
}
- (CGRect)_dismissedFrameWithPaddingForViewController:(id)vc withContainerBounds:(CGRect)cb {
    CGRect r = %orig;
    if (!DMBannersOn() || !DMIsBannerFrame(vc, r, cb)) return r;
    return DMBannerDismissedFrame(r, cb);
}
- (BOOL)gestureRecognizerShouldBegin:(UIGestureRecognizer *)g {   // a rightward swipe is ours (DMBannerHelper), not the system's drag
    if (DMBannersOn() && [g isKindOfClass:[UIPanGestureRecognizer class]]) {
        CGPoint v = [(UIPanGestureRecognizer *)g velocityInView:g.view];
        // (only on a notification banner: other banners -- an incoming call, Siri, AirPods -- keep every drag of their own)
        BOOL onNotification = NO;
        for (UIView *h = [g.view hitTest:[g locationInView:g.view] withEvent:nil]; h && h != g.view; h = h.superview)
            if ([NSStringFromClass([h class]) isEqualToString:@"NCNotificationShortLookView"]) { onNotification = YES; break; }
        if (onNotification && v.x > 0 && fabs(v.x) > fabs(v.y) * 1.2) return NO;
    }
    return %orig;
}
- (void)_dismissPresentable:(id)presentable withReason:(NSString *)reason animated:(BOOL)animated userInfo:(id)userInfo {
#if DEBUG
    DMLog([NSString stringWithFormat:@"[banner] system dismissal: reason %@ animated %d presentable %@", reason, animated, NSStringFromClass([presentable class])]);
#endif
    %orig;
}
%end
%hook NCNotificationShortLookViewController
- (unsigned long long)_maximumNumberOfSecondaryTextLinesForProvidedStaticContent {   // banners: up to 4 lines of text, like macOS (the system stops at 2)
    unsigned long long n = %orig;
    if (!DMBannersOn() || n >= 4) return n;
    id dg = [(id)self respondsToSelector:@selector(delegate)] ? ((id (*)(id, SEL))objc_msgSend)((id)self, @selector(delegate)) : nil;   // a banner's is SpringBoard's banner destination
    return [NSStringFromClass([dg class]) containsString:@"BannerDestination"] ? 4 : n;
}
%end
// A banner tapped while apps open as windows: the app opens in a window, which (unlike a full-screen launch) does not make SpringBoard put its
// overlays away, so the banner used to stay up until its timer. It is put away like after a full-screen launch.
%hook NCNotificationViewController
- (void)_executeDefaultAction:(BOOL)animated {
    %orig;
    id dg = [(id)self respondsToSelector:@selector(delegate)] ? ((id (*)(id, SEL))objc_msgSend)((id)self, @selector(delegate)) : nil;
    if (!DMBannersOn() || ![NSStringFromClass([dg class]) containsString:@"BannerDestination"]) return;
    __weak UIView *v = ((UIViewController *)self).viewIfLoaded;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (v.window) DMBannerDismissWithReason(v, YES, @"dismissOverlays"); });
}
%end
%hook NCNotificationShortLookView
- (void)layoutSubviews {
    %orig;
    UIView *v = (UIView *)self;
    if (!DMInBannerWindow(v)) return;
    DMBannerHelper *h = objc_getAssociatedObject(v, kDMBannerHelperKey);
    if (!DMBannersOn()) { h.closeButton.hidden = YES; h.optionsButton.hidden = YES; return; }
    if (!h) { h = [DMBannerHelper new]; objc_setAssociatedObject(v, kDMBannerHelperKey, h, OBJC_ASSOCIATION_RETAIN_NONATOMIC); [h install:v]; }
    h.closeButton.hidden = NO; h.optionsButton.hidden = NO;
    [h layout];
    // macOS look: a 14 pt continuous corner and a hairline edge on the platter (the material and the shadow stay the system's)
    for (UIView *sub in v.subviews) if ([NSStringFromClass([sub class]) isEqualToString:@"PLPlatterView"]) {
        if ([sub respondsToSelector:@selector(setCornerRadius:)]) ((void (*)(id, SEL, CGFloat))objc_msgSend)(sub, @selector(setCornerRadius:), 14.0);
        sub.layer.borderWidth = 0.5;
        sub.layer.borderColor = [UIColor colorWithWhite:1.0 alpha:(v.traitCollection.userInterfaceStyle == UIUserInterfaceStyleDark ? 0.14 : 0.45)].CGColor;
        sub.layer.cornerRadius = 14.0; sub.layer.cornerCurve = kCACornerCurveContinuous;
    }
}
%end
%end
static void DMBannersInit(void) { static BOOL done; if (done) return; done = YES; %init(MacBanners); }
// ===== end Mac-style notification banners ============================================================================================================

// ===== MacPointer bridge (M1 pipeline C6, 2026-09-24) ===========================================================================================
// The Mac pointer is drawn by MacPointer inside pointeruid (macpointer/MacPointer.x), which is sandboxed: it cannot read our preferences, and it does
// not know the interface orientation or which app is in front. SpringBoard publishes all of that as Darwin notification states and posts
// "com.besiktasliseba.macpointer.changed" whenever something changes: config (bit 0 = Pointer Style Mac, bit 3 = Use Pointer Control Style, bits 8-15 = old size setting, unused), orient (1-4), hide
// (1 = Virtual Mac is in front and "Hide in Virtual Mac" is on). It also publishes "com.besiktasliseba.macpointer.device" (1 = a trackpad or mouse is
// attached; MacSettings shows its Settings "Pointer" row only then) with "com.besiktasliseba.macpointer.device.changed".
static BOOL gDMPointerAttached = NO;   // a trackpad or mouse is attached (DMPointerDeviceCheck; read by the auto-hiding status bar)
static void DMPointerBridgeSchedule(void);
static BOOL DMAutoHidePref(void);   // (the auto-hiding status bar's switch, below)
static void DMPointerDeviceApply(uint64_t attached) {   // (main queue)
    static uint64_t last = UINT64_MAX; static int tDevice;
    gDMPointerAttached = attached == 1;
    if (attached != last) {
        last = attached;
        if (!tDevice) notify_register_check("com.besiktasliseba.macpointer.device", &tDevice);
        notify_set_state(tDevice, attached);
        notify_post("com.besiktasliseba.macpointer.device.changed");
        DMLog([NSString stringWithFormat:@"[pointer] trackpad or mouse attached: %llu", attached]);
    }
    DMPointerBridgeSchedule();   // (no pointer: the bridge ticks slowly; one attached: every 0.25 s again)
}
// Is a trackpad or mouse attached? The system's own answer first (SpringBoard's pointer manager: what decides that the pointer is shown -- covers
// trackpads, mice, the Magic Keyboard and keyboards with a built-in trackpad that are one HID service, like the iPad 2's Bluetooth keyboard). Only
// if it cannot be asked, the HID services are scanned (on a background queue: touchpad 13/12 and mouse 1/2 usages, not built in). (Performance
// audit P4: the scan used to run every time and its answer was then thrown away.)
static void DMPointerDeviceCheck(void) {
    id mgr = DMCall([UIApplication sharedApplication], @"mousePointerManager");
    SEL sel = NSSelectorFromString(@"isHardwarePointingDeviceAttached");
    if ([mgr respondsToSelector:sel]) { DMPointerDeviceApply(((BOOL (*)(id, SEL))objc_msgSend)(mgr, sel) ? 1 : 0); return; }
    static dispatch_queue_t q; static void *client;
    if (!q) q = dispatch_queue_create("com.besiktasliseba.macpointer.device", DISPATCH_QUEUE_SERIAL);
    dispatch_async(q, ^{
        void *iokit = dlopen("/System/Library/Frameworks/IOKit.framework/IOKit", RTLD_LAZY);
        CFArrayRef (*copyServices)(void *) = dlsym(iokit, "IOHIDEventSystemClientCopyServices");
        CFTypeRef (*copyProp)(void *, CFStringRef) = dlsym(iokit, "IOHIDServiceClientCopyProperty");
        if (!client) {
            void *(*create)(CFAllocatorRef) = dlsym(iokit, "IOHIDEventSystemClientCreate");
            void (*setMatchingMultiple)(void *, CFArrayRef) = dlsym(iokit, "IOHIDEventSystemClientSetMatchingMultiple");
            client = create ? create(kCFAllocatorDefault) : NULL;
            if (client && setMatchingMultiple) setMatchingMultiple(client, (__bridge CFArrayRef)@[@{@"PrimaryUsagePage": @13, @"PrimaryUsage": @12}, @{@"PrimaryUsagePage": @1, @"PrimaryUsage": @2}]);
        }
        if (!client || !copyServices || !copyProp) return;
        CFArrayRef list = copyServices(client);
        uint64_t attached = 0;
        for (CFIndex i = 0; list && i < CFArrayGetCount(list); i++) {
            void *svc = (void *)CFArrayGetValueAtIndex(list, i);
            NSNumber *page = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsagePage"))), *usage = CFBridgingRelease(copyProp(svc, CFSTR("PrimaryUsage")));
            NSNumber *builtIn = CFBridgingRelease(copyProp(svc, CFSTR("Built-In")));
            if (builtIn.boolValue) continue;
            if ((page.intValue == 13 && usage.intValue == 12) || (page.intValue == 1 && usage.intValue == 2)) { attached = 1; break; }
            // A keyboard with a built-in trackpad can be one HID service whose primary usage is the keyboard (iPad 2: "Bluetooth Keyboard"): its
            // pointer is only in its list of usages.
            NSArray *pairs = CFBridgingRelease(copyProp(svc, CFSTR("DeviceUsagePairs")));
            BOOL pointer = NO;
            if ([pairs isKindOfClass:[NSArray class]]) for (NSDictionary *d in pairs) {
                if (![d isKindOfClass:[NSDictionary class]]) continue;
                int pg = [d[@"DeviceUsagePage"] intValue], us = [d[@"DeviceUsage"] intValue];
                if ((pg == 1 && (us == 1 || us == 2)) || (pg == 13 && (us == 5 || us == 12))) { pointer = YES; break; }
            }
            static BOOL toldPairs = NO;
            if (!toldPairs && page.intValue == 1 && usage.intValue == 6) { toldPairs = YES; DMLog([NSString stringWithFormat:@"[pointer] keyboard service usages: %@", pairs]); }
            if (pointer) { attached = 1; break; }
        }
        if (list) CFRelease(list);
        dispatch_async(dispatch_get_main_queue(), ^{ DMPointerDeviceApply(attached); });
    });
}
static BOOL gDMPointerPrefsStale = YES;
static void DMPointerBridgeTick(void) {
    static int tConfig, tOrient, tHide; static uint64_t lastConfig = UINT64_MAX, lastOrient = UINT64_MAX, lastHide = UINT64_MAX;
    if (!tConfig) { notify_register_check("com.besiktasliseba.macpointer.config", &tConfig); notify_register_check("com.besiktasliseba.macpointer.orient", &tOrient); notify_register_check("com.besiktasliseba.macpointer.hide", &tHide); }
    static CFTimeInterval lastPrefs = 0; static uint64_t config = 1 | (100 << 8); static BOOL hideInVM = YES;
    if (gDMPointerPrefsStale || CACurrentMediaTime() - lastPrefs > 30.0) {
        gDMPointerPrefsStale = NO;   // preferences: every 30 s as a safety net (and at once after a change: the prefsChanged notification, DMPointerBridgeStart)
        lastPrefs = CACurrentMediaTime();
        BOOL on = YES; double size = 1.0;   // Pointer Style: "mac" (default) or "ipados" (the stock round pointer)
        CFPreferencesAppSynchronize(MSB_DOMAIN);
        CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("pointerStyle"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (v) { if (CFGetTypeID(v) == CFStringGetTypeID()) on = ![(__bridge NSString *)v isEqualToString:@"ipados"]; CFRelease(v); }
        v = CFPreferencesCopyValue(CFSTR("macPointerSize"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (v) { if (CFGetTypeID(v) == CFNumberGetTypeID()) CFNumberGetValue((CFNumberRef)v, kCFNumberDoubleType, &size); CFRelease(v); }
        v = CFPreferencesCopyValue(CFSTR("macPointerHideInVirtualMac"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        hideInVM = YES; if (v) { if (CFGetTypeID(v) == CFBooleanGetTypeID()) hideInVM = CFBooleanGetValue(v); CFRelease(v); }
        BOOL useAX = NO;   // (Use Pointer Control Style, off by default: the classic Mac pointer)
        v = CFPreferencesCopyValue(CFSTR("macPointerUseAXStyle"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (v) { if (CFGetTypeID(v) == CFBooleanGetTypeID()) useAX = CFBooleanGetValue(v); CFRelease(v); }
        uint64_t pct = (uint64_t)llround(MAX(0.5, MIN(2.0, size)) * 100.0);
        config = (on ? 1 : 0) | (pct << 8) | (DMAutoHideActive() ? 4 : 0) | (useAX ? 8 : 0);   // (bit 2: the auto-hiding status bar wants to know where the pointer is; bit 3: Use Pointer Control Style)
    }
    config = (config & ~(uint64_t)4) | (DMAutoHideActive() ? 4 : 0);
    uint64_t orient = (uint64_t)DMRealInterfaceOrientation();
    NSString *front = [DMFrontApp() bundleIdentifier];
    uint64_t hide = (hideInVM && [front isEqualToString:@"com.mac.virtual"]) ? 1 : 0;
    BOOL changed = NO;
    if (config != lastConfig) { lastConfig = config; notify_set_state(tConfig, config); changed = YES; }
    if (orient != lastOrient && orient >= 1 && orient <= 4) { lastOrient = orient; notify_set_state(tOrient, orient); changed = YES; }
    if (hide != lastHide) { lastHide = hide; notify_set_state(tHide, hide); changed = YES; }
    if (changed) notify_post("com.besiktasliseba.macpointer.changed");
    static CFTimeInterval lastDeviceCheck = -10;
    if (CACurrentMediaTime() - lastDeviceCheck > 1.9) { lastDeviceCheck = CACurrentMediaTime(); DMPointerDeviceCheck(); }   // every 2 s, at either pace
}
// The bridge's pace (performance audit P4): every 0.25 s while a trackpad or mouse is attached (or the auto-hiding status bar is on), otherwise
// once a second -- its per-tick work (orientation, front app, settings for MacPointer) matters only with a pointer, and the 2 s device check still
// sees one being attached as soon as before.
static NSTimer *gDMPointerTimer = nil;
static void DMPointerBridgeSchedule(void) {
    if (!gDMPointerTimer) return;   // (not started yet: DMPointerBridgeStart makes the first one)
    NSTimeInterval want = (gDMPointerAttached || DMAutoHidePref()) ? 0.25 : 1.0;
    if (gDMPointerTimer.valid && fabs(gDMPointerTimer.timeInterval - want) < 0.01) return;
    [gDMPointerTimer invalidate];
    gDMPointerTimer = [NSTimer timerWithTimeInterval:want repeats:YES block:^(NSTimer *timer) { DMPointerBridgeTick(); }];
    gDMPointerTimer.tolerance = want * 0.2;   // (perf step 10: shared wakeups)
    DMGateTimer(gDMPointerTimer);
    [[NSRunLoop mainRunLoop] addTimer:gDMPointerTimer forMode:NSRunLoopCommonModes];
}
static void DMPointerBridgeStart(void) {
    static BOOL started; if (started) return; started = YES;
    gDMPointerTimer = [NSTimer timerWithTimeInterval:0.25 repeats:YES block:^(NSTimer *timer) { DMPointerBridgeTick(); }];
    gDMPointerTimer.tolerance = 0.05;   // (perf step 10: shared wakeups; the DMTick chain's dispatch_after already gets a default leeway of a tenth of its 0.25 s)
    DMGateTimer(gDMPointerTimer);
    static int prefsToken;   // a Settings change applies at once (not only at the next 2 s preferences read)
    notify_register_dispatch("com.besiktasliseba.macstatusbar/prefsChanged", &prefsToken, dispatch_get_main_queue(), ^(int tok) { gDMPointerPrefsStale = YES; DMPointerBridgeTick(); DMPointerBridgeSchedule(); });
    [[NSRunLoop mainRunLoop] addTimer:gDMPointerTimer forMode:NSRunLoopCommonModes];
    DMPointerBridgeTick();
}
// ===== end MacPointer bridge =====================================================================================================================

// ===== Auto-hiding status bar (M1 pipeline 2026-09-24; requirement: macOS "Automatically hide and show the menu bar", POINTER ONLY) =========================
// Settings > Status Bar > "Automatically Hide and Show the Status Bar" (off by default: then nothing here does anything). Only while a trackpad or mouse
// is attached (without one the bar always shows) and never on the Lock Screen or Cover Sheet. Hidden, the bar is moved up off the screen (a
// translation of each status bar copy -- SpringBoard animates their alpha and turns them, never moves them). Pushing the pointer against the top edge
// shows it (the pointer's Cover Sheet pull-down recogniser is where that push is seen; with auto-hide on it shows our bar instead, like macOS);
// when the pointer has left the bar and no menu is open, it hides again after a moment. Tiles gain the 24 pt (DMTopLimit 0), windows touching the
// top edge move down with the bar and back (a translation of the window view only -- no scene resize; reversible mid-way). The hide/show code
// (DMStatusBarSetHidden) is shared with a future "long press hides the bar" option.
static CFTimeInterval gAutoHideReadAt = -10;
static BOOL DMAutoHidePref(void) {
    static BOOL on = NO;
    if (CACurrentMediaTime() - gAutoHideReadAt > 1.0) {
        gAutoHideReadAt = CACurrentMediaTime(); on = NO;
        CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("autoHideStatusBar"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (v) { if (CFGetTypeID(v) == CFBooleanGetTypeID()) on = CFBooleanGetValue(v); CFRelease(v); }
    }
    return on && !gStockBar;   // (the stock status bar never hides)
}
static BOOL DMAutoHideLayout(void) { return DMAutoHidePref() && (gDMPointerAttached || (gSBFakePointer.y >= 0 && DMTestFlag("/tmp/macstatusbar-debug"))); }   // (debug: a ptrfake_ stand-in pointer counts as attached, for tests without a real one)   // tiles use the top 24 pt (not tied to the Lock Screen: no re-tile at each lock/unlock)
static BOOL DMAutoHideActive(void) {   // the bar may hide right now
    if (!DMAutoHideLayout()) return NO;
    id lm = DMSBManager("SBLockScreenManager");
    return !DMLockUp(lm);
}
static CGFloat DMTopLimit(void) { return DMAutoHideLayout() ? 0.0 : 23.0; }   // (tiles and the window clamps: under the status bar, or the top edge)
static BOOL gSBHidden = NO;                    // the bar is hidden right now
static BOOL gSBPointerInBar = NO;              // the pointer is over the bar (hover)
static CFTimeInterval gSBLastExit = 0, gSBRevealedAt = 0, gSBTurnAt = -10;
static const void *kSBShiftKey = &kSBShiftKey, *kSBHoverKey = &kSBHoverKey, *kSBShiftTyKey = &kSBShiftTyKey, *kSBShiftFrameKey = &kSBShiftFrameKey;   // (shift: how far we moved it; ty: the transform we left)
// Each status bar copy's UIStatusBar_Modern. Hidden, its CONTENT is moved up with the layer's sublayerTransform: SpringBoard and our own layout keep
// setting the bar views' frames (a view transform was undone at once: seen), but nothing touches a sublayer transform. UIKit's hit-testing ignores it,
// so a hidden bar also stops taking touches (userInteractionEnabled off) -- a tap at the top edge then reaches what is below.
static NSArray<UIView *> *DMStatusBarsToMove(void) {
    NSMutableArray *out = [NSMutableArray array];
    for (UIView *fg in gCopies.allObjects) {
        UIView *modern = fg.superview.superview;
        if (!modern || !([NSStringFromClass([modern class]) hasPrefix:@"UIStatusBar"] || (DMSBUseSTUI() && DMSBIs(NSStringFromClass([modern class]), "UIStatusBar_Modern")))) modern = fg.superview;
        if (modern && modern.window && ![out containsObject:modern]) [out addObject:modern];
    }
    return out;
}
static void DMStatusBarApplyOffset(UIView *b, CGFloat dy, BOOL animated) {
    CATransform3D want = CATransform3DMakeTranslation(0, dy, 0);
    if (CATransform3DEqualToTransform(b.layer.sublayerTransform, want)) return;
    if (animated) {
        CABasicAnimation *a = [CABasicAnimation animationWithKeyPath:@"sublayerTransform"];
        a.fromValue = [NSValue valueWithCATransform3D:(b.layer.presentationLayer ?: b.layer).sublayerTransform];
        a.toValue = [NSValue valueWithCATransform3D:want];
        a.duration = 0.25; a.timingFunction = [CAMediaTimingFunction functionWithName:kCAMediaTimingFunctionEaseInEaseOut];
        [b.layer addAnimation:a forKey:@"msbAutoHide"];
    }
    [CATransaction begin]; [CATransaction setDisableActions:YES]; b.layer.sublayerTransform = want; [CATransaction commit];
    b.userInteractionEnabled = dy == 0;
}
@interface DMStatusBarHover : NSObject
+ (instancetype)shared;
- (void)hover:(UIHoverGestureRecognizer *)g;
@end
@implementation DMStatusBarHover
+ (instancetype)shared { static DMStatusBarHover *h; static dispatch_once_t once; dispatch_once(&once, ^{ h = [DMStatusBarHover new]; }); return h; }
- (void)hover:(UIHoverGestureRecognizer *)g {
    BOOL inside = g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged;
    if (inside != gSBPointerInBar) { gSBPointerInBar = inside; if (!inside) gSBLastExit = CACurrentMediaTime(); }
}
@end
// A window moved down with the bar keeps our translation only while nobody else moves it. When a drag or resize of it starts (the pointer or a finger
// moves on its title bar or handle -- SpringBoard only ever sees those touches, the app's own content goes to the app), the translation is turned
// into a real position first (same place on screen), so the engine's drag works on a plain frame; that window then stays where it was put.
static const void *kSBBakeKey = &kSBBakeKey;
static void DMAutoHideSetTitleShift(UIView *st, CGFloat want, BOOL animated);
static void DMAutoHideDropBakeRecognizer(UIView *st) {
    UIGestureRecognizer *r = objc_getAssociatedObject(st, kSBBakeKey);
    if (!r) return;
    objc_setAssociatedObject(st, kSBBakeKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    dispatch_async(dispatch_get_main_queue(), ^{ [r.view removeGestureRecognizer:r]; });   // (not from inside its own touch handling)
}
static void DMAutoHideBake(UIView *st, NSString *why) {
    DMAutoHideDropBakeRecognizer(st);
    CGFloat tshift = DMAutoHideTitleShiftOf(st);
    if (tshift > 0) {   // step 2: the window moves down to its slid title bar (under the finger), which goes back into it
        DMAutoHideSetTitleShift(st, 0, NO);
        [UIView performWithoutAnimation:^{ st.center = CGPointMake(st.center.x, st.center.y + tshift); }];
        NSArray *zs = objc_getAssociatedObject(st, kZetsuBarStartKey);   // (our Zetsu title-bar drag already started: it goes on from the moved window)
        if (zs.count == 2) objc_setAssociatedObject(st, kZetsuBarStartKey, @[[NSValue valueWithCGRect:CGRectOffset([zs[0] CGRectValue], 0, tshift)], zs[1]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMLog([NSString stringWithFormat:@"[autohide] %@: moved down to its title bar (%@)", DMStageBundle(st), why]);
        return;
    }
    CGFloat shift = [objc_getAssociatedObject(st, kSBShiftKey) doubleValue];
    if (shift == 0) return;
    objc_setAssociatedObject(st, kSBShiftKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(st, kSBShiftTyKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(st, kSBShiftFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (fabs(st.transform.ty) < 0.5) return;   // (already gone: its engine reset the transform)
    [st.layer removeAnimationForKey:@"transform"];
    [UIView performWithoutAnimation:^{
        st.transform = CGAffineTransformTranslate(st.transform, 0, -shift);
        st.center = CGPointMake(st.center.x, st.center.y + shift);
    }];
    DMLog([NSString stringWithFormat:@"[autohide] %@: the status bar's move made its own (%@)", DMStageBundle(st), why]);
}
static void DMAutoHideUnshift(UIView *st) {   // (before something places the window afresh: the translation just goes)
    DMAutoHideDropBakeRecognizer(st);
    CGFloat shift = [objc_getAssociatedObject(st, kSBShiftKey) doubleValue];
    if (shift == 0) return;
    objc_setAssociatedObject(st, kSBShiftKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(st, kSBShiftTyKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(st, kSBShiftFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (fabs(st.transform.ty - shift) > 0.5 && fabs(st.transform.ty) < 0.5) return;   // (already gone: the engine reset it)
    [UIView performWithoutAnimation:^{ st.transform = CGAffineTransformTranslate(st.transform, 0, -shift); }];
}
@interface DMShiftBakeRecognizer : UIGestureRecognizer <UIGestureRecognizerDelegate>
@property (nonatomic) CGPoint start;
@end
@implementation DMShiftBakeRecognizer
- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { self.start = [touches.anyObject locationInView:nil]; }
- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event {
    CGPoint p = [touches.anyObject locationInView:nil];
    if (hypot(p.x - self.start.x, p.y - self.start.y) < 2.0) return;
    if (self.view) DMAutoHideBake(self.view, @"a drag or resize started");
    self.state = UIGestureRecognizerStateFailed;
}
- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { self.state = UIGestureRecognizerStateFailed; }
- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { self.state = UIGestureRecognizerStateFailed; }
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b { return YES; }
@end
// ---- step 2: only the title bar slides (Aerial 5.0 and 3.0, MilkyWay4 and Zetsu) ----
// With these engines a window at the top stays completely still when the bar shows: only its title bar (traffic lights, drag strip) slides down the
// bar's height with the bar, in lockstep, covering the app's top strip for a moment, and back up when the bar hides. The status bar's window is kept
// above the windows while auto-hide gives them the top edge (DMAutoHideKeepBarAbove), so the bar covers the title bar's old place.
// Aerial 5.0: the title bar is drawn by the window's background view (ours); a copy of its top strip slides with our lights over the app.
// MilkyWay4: its own title bar view slides (its buttons and drag area move with it: touches follow a view's transform).
static const void *kSBTitleShiftKey = &kSBTitleShiftKey, *kSBTitleCoverKey = &kSBTitleCoverKey, *kSBPartFrameKey = &kSBPartFrameKey;
static BOOL DMAutoHideTitleOnly(void) { return DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineMilkyWay || DMActiveEngine() == DMEngineZetsu; }
static CGFloat DMAutoHideTitleShiftOf(UIView *stage) { return stage ? [objc_getAssociatedObject(stage, kSBTitleShiftKey) doubleValue] : 0.0; }
static CGRect DMAutoHideCoverFrame(UIView *st, UIView **bgOut) {   // Aerial 5.0: the title strip of the window's background view
    UIView *bg = nil; for (UIView *v in st.subviews) if ([v.accessibilityIdentifier isEqualToString:@"MSB"]) { bg = v; break; }
    UIView *inner = DMStageInnerView(st);
    if (bgOut) *bgOut = bg;
    if (!bg || !inner) return CGRectNull;
    return CGRectMake(bg.frame.origin.x, inner.frame.origin.y - kStageBarHeight, bg.frame.size.width, kStageBarHeight);
}
static NSArray<UIView *> *DMAutoHideTitleParts(UIView *st, BOOL create) {
    NSMutableArray *parts = [NSMutableArray array];
    if (DMActiveEngine() == DMEngineMilkyWay) {
        UIView *bar = nil; @try { bar = [st valueForKey:@"titleBar"]; } @catch (id e) {}
        if ([bar isKindOfClass:[UIView class]]) [parts addObject:bar];
        return parts;
    }
    if (DMActiveEngine() == DMEngineZetsu) {   // Zetsu: its title bar (ZetsuMenu), which holds our lights
        UIView *menu = nil; @try { menu = [DMZetsuController((UIWindow *)st) valueForKey:@"menu"]; } @catch (id e) {}
        if ([menu isKindOfClass:[UIView class]]) [parts addObject:menu];
        return parts;
    }
    if (!DMA5MacGeometry()) {   // Aerial 3.0: its own title strip (the drag area and the bar drawn under it, both across the top 24 pt) and our lights
        for (UIView *v in st.subviews) {
            // (its own place: without the slide we may have given it)
            if (v.hidden || fabs(v.frame.origin.y - v.transform.ty) > 0.5 || fabs(v.frame.size.height - kStageBarHeight) > 1.0 || v.frame.size.width < st.bounds.size.width - 1.0) continue;
            [parts addObject:v];
        }
        // Aerial 3.0's strip views take no touches themselves (the stage under them does), so over the app's top strip a touch fell through to
        // the app: a clear catcher of ours slides with them and keeps those touches in the window (its drag works from there).
        UIView *catcher = objc_getAssociatedObject(st, kSBTitleCoverKey);
        if (!catcher && create) {
            catcher = [[UIView alloc] initWithFrame:CGRectMake(0, 0, st.bounds.size.width, kStageBarHeight)];
            catcher.backgroundColor = [UIColor colorWithWhite:0 alpha:0.011]; catcher.userInteractionEnabled = YES; catcher.hidden = YES;
            SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
            if ([catcher.layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(catcher.layer, opaque, YES);
            UIView *inner3 = DMStageInnerView(st);
            if (inner3) [st insertSubview:catcher aboveSubview:inner3]; else [st addSubview:catcher];
            objc_setAssociatedObject(st, kSBTitleCoverKey, catcher, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (catcher) {
            if (fabs(catcher.bounds.size.width - st.bounds.size.width) > 0.5) { CGAffineTransform t = catcher.transform; catcher.transform = CGAffineTransformIdentity; catcher.frame = CGRectMake(0, 0, st.bounds.size.width, kStageBarHeight); catcher.transform = t; }
            [parts addObject:catcher];
        }
        UIView *lights3 = objc_getAssociatedObject(st, kStageLightsKey);
        if (lights3) { [parts addObject:lights3]; if (catcher && lights3.superview == st) [st bringSubviewToFront:lights3]; }
        return parts;
    }
    UIView *cover = objc_getAssociatedObject(st, kSBTitleCoverKey), *bg = nil;
    CGRect cf = DMAutoHideCoverFrame(st, &bg);
    if (!cover && create && !CGRectIsNull(cf)) {
        cover = [[UIView alloc] initWithFrame:cf];
        cover.userInteractionEnabled = YES;   // (touches on the slid title bar are the window's: they must not reach the app below it)
        cover.hidden = YES;
        [st insertSubview:cover aboveSubview:DMStageInnerView(st)];
        objc_setAssociatedObject(st, kSBTitleCoverKey, cover, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (cover && bg) {
        cover.backgroundColor = bg.backgroundColor;
        cover.layer.cornerRadius = bg.layer.cornerRadius; cover.layer.cornerCurve = kCACornerCurveContinuous;
        cover.layer.maskedCorners = kCALayerMinXMinYCorner | kCALayerMaxXMinYCorner;
        [parts addObject:cover];
    }
    UIView *lights = objc_getAssociatedObject(st, kStageLightsKey);
    if (lights) [parts addObject:lights];
    return parts;
}
static void DMAutoHideSetTitleShift(UIView *st, CGFloat want, BOOL animated) {
    CGFloat cur = DMAutoHideTitleShiftOf(st);
    if (fabs(want - cur) < 0.25) return;
    NSArray<UIView *> *parts = DMAutoHideTitleParts(st, want > 0);
    UIView *cover = objc_getAssociatedObject(st, kSBTitleCoverKey);
    if (want > 0 && DMActiveEngine() != DMEngineAerial) for (UIView *p in parts) if (p.superview) [p.superview bringSubviewToFront:p];   // (over the app's content)
    if (want > 0 && cover && !DMA5MacGeometry()) cover.hidden = NO;   // (Aerial 3.0's clear catcher)
    else if (want > 0 && cover) {   // (its place and look first, then shown under the title bar's old place)
        CGRect cf = DMAutoHideCoverFrame(st, NULL);
        if (!CGRectIsNull(cf) && cover.hidden) { [UIView performWithoutAnimation:^{ cover.transform = CGAffineTransformIdentity; cover.frame = cf; cover.transform = CGAffineTransformMakeTranslation(0, cur); }]; }
        cover.hidden = NO;
    }
    objc_setAssociatedObject(st, kSBTitleShiftKey, want > 0 ? @(want) : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (DMTestFlag("/tmp/macstatusbar-debug")) { NSMutableString *pl = [NSMutableString string]; for (UIView *p in parts) [pl appendFormat:@" %@%@", NSStringFromClass([p class]), NSStringFromCGRect(p.frame)]; DMLog([NSString stringWithFormat:@"[autohide] %@ title parts ->%.0f:%@", DMStageBundle(st), want, pl]); }
    void (^apply)(void) = ^{
        for (UIView *p in parts) {
            p.transform = CGAffineTransformMakeTranslation(0, want);
            objc_setAssociatedObject(p, kSBPartFrameKey, want > 0 ? [NSValue valueWithCGRect:p.frame] : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    };
    void (^done)(BOOL) = ^(BOOL finished) { if (DMAutoHideTitleShiftOf(st) == 0) cover.hidden = YES; };
    if (animated) [UIView animateWithDuration:0.25 delay:0 options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionCurveEaseInOut animations:apply completion:done];
    else { [UIView performWithoutAnimation:apply]; done(YES); }
    if (want > 0 && !objc_getAssociatedObject(st, kSBBakeKey)) {   // (a drag of the slid title bar: see DMAutoHideBake)
        DMShiftBakeRecognizer *r = [[DMShiftBakeRecognizer alloc] initWithTarget:nil action:nil];
        r.cancelsTouchesInView = NO; r.delaysTouchesBegan = NO; r.delaysTouchesEnded = NO; r.delegate = r;
        [st addGestureRecognizer:r];
        objc_setAssociatedObject(st, kSBBakeKey, r, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}
// An engine laying its title bar out again (MilkyWay does, on its own layout passes) puts it back at its old place on screen: slid down again.
static void DMAutoHideKeepTitlesDown(void) {
    for (UIView *st in DMAerialStages()) {
        CGFloat shift = DMAutoHideTitleShiftOf(st);
        if (shift == 0) continue;
        for (UIView *p in DMAutoHideTitleParts(st, NO)) {
            if ([p.layer animationForKey:@"transform"] || [p.layer animationForKey:@"position"]) continue;
            if (fabs(p.transform.ty - shift) > 0.25) p.transform = CGAffineTransformMakeTranslation(0, shift);
            NSValue *was = objc_getAssociatedObject(p, kSBPartFrameKey);
            if (was && fabs(p.frame.origin.y - was.CGRectValue.origin.y) > 0.5 && fabs(p.frame.origin.y + shift - was.CGRectValue.origin.y) < 0.5) {
                CGRect f = p.frame; f.origin.y += shift; p.frame = f;   // (re-laid at its old place: down again)
            }
            // an engine putting the app's content above the slid title bar again (Zetsu does after its options menu): the title bar back on top
            if (p != objc_getAssociatedObject(st, kSBTitleCoverKey) && p.superview && p.superview.subviews.lastObject != p && DMActiveEngine() != DMEngineAerial) [p.superview bringSubviewToFront:p];
            if (p == objc_getAssociatedObject(st, kSBTitleCoverKey) && DMA5MacGeometry()) {   // the window was resized: the copy follows its width
                CGRect cf = DMAutoHideCoverFrame(st, NULL);
                if (!CGRectIsNull(cf)) { cf.origin.y += shift; if (!CGRectEqualToRect(p.frame, cf)) p.frame = cf; }
            }
            objc_setAssociatedObject(p, kSBPartFrameKey, [NSValue valueWithCGRect:p.frame], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
    }
}
// The status bar's window above the windows while auto-hide gives them the top edge (SpringBoard keeps it below them: a window at the top edge
// would cover the bar). Hidden, the bar has nothing there to touch or see, so touches still reach the windows.
static const void *kSBRaisedFromKey = &kSBRaisedFromKey;
static void DMAutoHideKeepBarAbove(BOOL on) {
    UIWindow *layer = DMActiveEngine() == DMEngineZetsu ? nil : DMWindowLayer();
    CGFloat above = MAX(layer ? layer.windowLevel : 0.0, DMActiveEngine() == DMEngineZetsu ? kZetsuFrontLevel : 0.0) + 0.5;
    for (UIView *b in DMStatusBarsToMove()) {
        UIWindow *w = b.window;
        if (!w || !DMSBIs(NSStringFromClass([w class]), "UIStatusBarWindow")) continue;
        NSNumber *from = objc_getAssociatedObject(w, kSBRaisedFromKey);
        if (on && w.windowLevel < above) {
            if (!from) objc_setAssociatedObject(w, kSBRaisedFromKey, @(w.windowLevel), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            w.windowLevel = above;
            DMLog([NSString stringWithFormat:@"[autohide] status bar window raised to %.1f (above the windows)", above]);
        } else if (!on && from) {
            if (fabs(w.windowLevel - above) < 0.01 || w.windowLevel > from.doubleValue) w.windowLevel = from.doubleValue;
            objc_setAssociatedObject(w, kSBRaisedFromKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            DMLog([NSString stringWithFormat:@"[autohide] status bar window back to %.1f", from.doubleValue]);
        }
    }
}
// Moves the windows touching the top edge down by the bar's height (show) or back (hide). Also used after Fit places windows afresh while the bar shows.
static void DMStatusBarMoveWindows(BOOL show, CGFloat h, BOOL animated) {
    NSMutableArray *stages = [NSMutableArray array];
    BOOL titleOnly = DMAutoHideTitleOnly();
    NSUInteger titles = 0;
    for (UIView *st in DMAerialStages()) {
        if (titleOnly) {   // step 2: the window stays, its title bar slides (a window left moved down from before is put back first)
            if (DMAutoHideShiftOf(st) > 0) DMAutoHideUnshift(st);
            CGFloat top = st.frame.origin.y, cur = DMAutoHideTitleShiftOf(st);
            CGFloat want = (show && !st.hidden && !DMStageMinimized(st) && top < 23.0) ? MAX(0.0, h - MAX(0.0, top)) : 0.0;
            if (fabs(want - cur) < 0.25) continue;
            if (want > 0 && [objc_getAssociatedObject(st, kStageGestureKey) boolValue]) continue;   // (not mid-drag)
            DMAutoHideSetTitleShift(st, want, animated);
            titles++;
            continue;
        }
        if (st.hidden || DMStageMinimized(st)) continue;
        CGFloat shift = [objc_getAssociatedObject(st, kSBShiftKey) doubleValue];
        CGFloat top = st.frame.origin.y - shift;   // (its own place, without our shift)
        CGFloat want = show && top < 23.0 ? MAX(0.0, h - top) : 0.0;
        if (fabs(want - shift) < 0.25) continue;
        if (show && [st.layer animationKeys].count && ![st.layer animationForKey:@"transform"]) continue;   // (being placed or turned right now: next time)
        BOOL busy = NO;   // (not while the user drags or resizes it: its title bar or handle is in use)
        NSMutableArray *views = [NSMutableArray arrayWithObject:st];
        for (NSUInteger k = 0; k < views.count && k < 60 && !busy; k++) {
            UIView *v = views[k];
            for (UIGestureRecognizer *g in v.gestureRecognizers) if (g.state == UIGestureRecognizerStateBegan || g.state == UIGestureRecognizerStateChanged) { busy = YES; break; }
            if (k < 12) [views addObjectsFromArray:v.subviews];
        }
        if (!busy) [stages addObject:st];
    }
    if (titles) DMLog([NSString stringWithFormat:@"[autohide] %lu title bars %@", (unsigned long)titles, show ? @"slid down with the bar" : @"slid back up"]);
    if (!stages.count) return;
    void (^move)(void) = ^{
        for (UIView *st in stages) {
            CGFloat shift = [objc_getAssociatedObject(st, kSBShiftKey) doubleValue], top = st.frame.origin.y - shift;
            CGFloat want = show && top < 23.0 ? MAX(0.0, h - top) : 0.0;
            st.transform = CGAffineTransformTranslate(st.transform, 0, want - shift);
            objc_setAssociatedObject(st, kSBShiftKey, want > 0 ? @(want) : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(st, kSBShiftTyKey, want > 0 ? @(st.transform.ty) : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(st, kSBShiftFrameKey, want > 0 ? [NSValue valueWithCGRect:st.frame] : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (want == 0) DMAutoHideDropBakeRecognizer(st);
            if (want > 0 && !objc_getAssociatedObject(st, kSBBakeKey)) {
                DMShiftBakeRecognizer *r = [[DMShiftBakeRecognizer alloc] initWithTarget:nil action:nil];
                r.cancelsTouchesInView = NO; r.delaysTouchesBegan = NO; r.delaysTouchesEnded = NO; r.delegate = r;
                [st addGestureRecognizer:r];
                objc_setAssociatedObject(st, kSBBakeKey, r, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
        }
    };
    if (animated) [UIView animateWithDuration:0.25 delay:0 options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionCurveEaseInOut animations:move completion:nil];
    else [UIView performWithoutAnimation:move];
    DMLog([NSString stringWithFormat:@"[autohide] %lu windows %@", (unsigned long)stages.count, show ? @"moved down with the bar" : @"moved back up"]);
}
static CGFloat DMStatusBarHeightForMove(void) {
    CGFloat h = 24.0;
    for (UIView *b in DMStatusBarsToMove()) h = MAX(h, MIN(40.0, b.bounds.size.height));
    return h;
}
// While the bar is hidden, a 6 pt strip stays along the top edge, in a window of its own just above the windows' layer (the status bar's own window
// is below the windows): a finger swipe down from the top edge lands on it -- as it would on the bar -- instead of on a window's title bar there, so
// Notification Center / Control Center come down as usual (starting on a window's title bar, the pull began and then sprang back: seen). The strip
// does nothing itself; the pointer never needs it (at the edge the bar comes back).
static UIWindow *gSBEdgeWindow = nil;
static UIView *gSBEdgeStrip = nil;
static UIView *DMEdgeWindowHitTest(id self, SEL _cmd, CGPoint p, UIEvent *e) {
    if (!gSBEdgeStrip || gSBEdgeStrip.hidden || !gSBHidden) return nil;
    CGPoint q = [(UIView *)self convertPoint:p toView:gSBEdgeStrip];
    return [gSBEdgeStrip pointInside:q withEvent:e] ? gSBEdgeStrip : nil;
}
static void DMAutoHideTouchStrip(BOOL on) {
    if (DMTestFlag("/tmp/msb-nostrip")) on = NO;   // (debug: without the strip)
    if (on && !gSBEdgeWindow) {
        @try {
            Class base = objc_getClass("SBMainScreenActiveInterfaceOrientationWindow");
            SEL initRole = NSSelectorFromString(@"initWithRole:debugName:");
            if (!base || ![base instancesRespondToSelector:initRole]) return;
            Class sub = objc_getClass("MSBEdgeWindow");
            if (!sub) {
                sub = objc_allocateClassPair(base, "MSBEdgeWindow", 0);
                class_addMethod(sub, @selector(hitTest:withEvent:), (IMP)DMEdgeWindowHitTest, "@@:{CGPoint=dd}@");
                objc_registerClassPair(sub);
            }
            UIWindow *w = ((id (*)(id, SEL, id, id))objc_msgSend)([sub alloc], initRole, @"SBFTraitsParticipantRoleRecordingIndicator", @"MacStatusBarTopEdge"); DMSnapInvalidate();
            w.backgroundColor = [UIColor clearColor];
            w.hidden = YES;
            UIView *strip = [[UIView alloc] initWithFrame:CGRectMake(0, 0, w.bounds.size.width, 6.0)];
            strip.backgroundColor = [UIColor colorWithWhite:0 alpha:0.011];   // (not quite clear: the render server then counts it as there)
            strip.autoresizingMask = UIViewAutoresizingFlexibleWidth;
            SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
            if ([strip.layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(strip.layer, opaque, YES);
            [w addSubview:strip];
            gSBEdgeWindow = w; gSBEdgeStrip = strip;
        } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[autohide] top-edge window: exception %@", e]); return; }
    }
    if (!gSBEdgeWindow) return;
    if (on) {
        UIWindow *layer = DMActiveEngine() == DMEngineZetsu ? nil : DMWindowLayer();
        gSBEdgeWindow.windowLevel = MAX(layer ? layer.windowLevel + 1.0 : 0.0, kMenuWindowLevel - 5.0);
        gSBEdgeStrip.frame = CGRectMake(0, 0, gSBEdgeWindow.bounds.size.width, 6.0);
    }
    gSBEdgeWindow.hidden = !on;
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[autohide] top-edge touch strip %@ (window level %.0f, %@)", on ? @"on" : @"off", gSBEdgeWindow.windowLevel, NSStringFromCGRect(gSBEdgeStrip.frame)]);
}
static void DMStatusBarSetHidden(BOOL hide, NSString *why) {
    if (hide == gSBHidden) return;
    DMAutoHideTouchStrip(hide);
    gSBHidden = hide;
    if (!hide) gSBRevealedAt = CACurrentMediaTime();
    NSArray *bars = DMStatusBarsToMove();
    CGFloat h = DMStatusBarHeightForMove();
    [UIView animateWithDuration:0.25 delay:0 options:UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionCurveEaseInOut animations:^{
        for (UIView *b in bars) DMStatusBarApplyOffset(b, hide ? -h : 0.0, YES);
    } completion:nil];
    // windows: moved down only while auto-hide gives them the top 24 pt (otherwise they are below the bar anyway: nothing to move)
    // windows: moved down only while the bar may hide (on the Lock Screen / Cover Sheet the windows are left exactly as they are: moving them there
    // made SpringBoard close a Notification Center being pulled down; seen)
    if (DMAutoHideActive() || hide) DMStatusBarMoveWindows(!hide && DMAutoHideLayout(), h, YES);
    DMLog([NSString stringWithFormat:@"[autohide] status bar %@ (%@; %lu bar copies)", hide ? @"hidden" : @"shown", why, (unsigned long)bars.count]);
}
// Fit placing windows afresh (a re-tile, a new window, a turn): our translations go first, and come back for the new places while the bar shows.
static void DMAutoHideBeforeRetile(void) { for (UIView *st in DMAerialStages()) DMAutoHideUnshift(st); }
static void DMAutoHideAfterRetile(void) {
    if (!gSBHidden && DMAutoHideLayout()) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.45 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!gSBHidden && DMAutoHideLayout()) DMStatusBarMoveWindows(YES, DMStatusBarHeightForMove(), YES);
    });
}
static CGFloat DMAutoHideShiftOf(UIView *stage) { return stage ? [objc_getAssociatedObject(stage, kSBShiftKey) doubleValue] : 0.0; }
static void DMAutoHideNoteFrame(UIView *stage) { if (objc_getAssociatedObject(stage, kSBShiftFrameKey)) objc_setAssociatedObject(stage, kSBShiftFrameKey, [NSValue valueWithCGRect:stage.frame], OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
static BOOL DMAutoHideHandlePointerPull(void) {   // the pointer pushed against the top edge
    if (DMTestFlag("/tmp/macstatusbar-debug")) { static CFTimeInterval lastLog; if (CACurrentMediaTime() - lastLog > 0.5) { lastLog = CACurrentMediaTime(); DMLog([NSString stringWithFormat:@"[autohide] pointer pull at the top edge (active %d, hidden %d)", DMAutoHideActive(), gSBHidden]); } }
    if (!DMAutoHideActive()) return NO;
    if (gSBHidden) DMStatusBarSetHidden(NO, @"pointer pushed against the top edge");
    gSBRevealedAt = CACurrentMediaTime();
    return YES;   // (no Cover Sheet pull-down while auto-hide is on, like macOS)
}
// Where the pointer is: backboardd's global pointer position (BKSMousePointerService, one small XPC query on a background queue per 0.1 s tick, only
// while auto-hide is active). It is in the screen's native portrait space; turned into the current orientation's points and sorted into zones:
// 1 = at the top edge (the pointer stops ~5 pt short of the very edge; 6 pt also keeps clear of the traffic lights of a window at the top, centred ~10 pt down), 2 = over the bar, 3 = below it, 0 = unknown.
// (MacPointer in pointeruid cannot tell: its pointer view never moves -- the render server places it.)
static uint64_t gSBZone = 0;
static CFTimeInterval gSBZoneAt = 0;
static CGPoint gSBFakePointer = {-1, -1};   // debug: ptrfake_<x>_<y> stands in for the real position (screen points; ptrfake_off ends it)
static void DMAutoHideSetZone(uint64_t z) {
    if (z == gSBZone) return;
    gSBZone = z; gSBZoneAt = CACurrentMediaTime();
    if (z == 1 && gSBHidden && DMAutoHideActive()) DMStatusBarSetHidden(NO, @"the pointer reached the top edge");
    if (z == 1 || z == 2) gSBRevealedAt = MAX(gSBRevealedAt, CACurrentMediaTime() - 0.5);
}
static CGFloat DMAutoHidePointerY(CGPoint n) {   // native portrait point -> y in the current orientation
    CGRect fixed = [UIScreen mainScreen].fixedCoordinateSpace.bounds;
    switch (DMRealInterfaceOrientation()) {
        case 3: return fixed.size.width - n.x;    // (landscape, Home on the right / docked in the Magic Keyboard)
        case 4: return n.x;
        case 2: return fixed.size.height - n.y;
        default: return n.y;
    }
}
static void DMAutoHidePollPointer(void) {
    if (gSBFakePointer.y >= 0) { CGFloat y = gSBFakePointer.y; DMAutoHideSetZone(y <= 6.0 ? 1 : (y <= 26.0 ? 2 : 3)); return; }
    static dispatch_queue_t q; static BOOL busy;
    if (busy) return;
    if (!q) q = dispatch_queue_create("com.besiktasliseba.macstatusbar.pointerpos", DISPATCH_QUEUE_SERIAL);
    Class c = objc_getClass("BKSMousePointerService");
    if (!c || ![c respondsToSelector:@selector(sharedInstance)]) return;
    busy = YES;
    dispatch_async(q, ^{
        id svc = ((id (*)(id, SEL))objc_msgSend)(c, @selector(sharedInstance));
        SEL sel = sel_registerName("globalPointerPosition");
        CGPoint p = [svc respondsToSelector:sel] ? ((CGPoint (*)(id, SEL))objc_msgSend)(svc, sel) : CGPointMake(-1, -1);
        dispatch_async(dispatch_get_main_queue(), ^{
            busy = NO;
            if (p.x < 0 || p.y < 0) { DMAutoHideSetZone(0); return; }
            CGFloat y = DMAutoHidePointerY(p);
            DMAutoHideSetZone(y <= 6.0 ? 1 : (y <= 26.0 ? 2 : 3));
        });
    });
}
static void DMAutoHideWatchZones(void) {}
// Windows at the top that Fit is not tiling: up to the edge when auto-hide gives the 24 pt, back under the bar when it takes them back; a full-height
// one also grows / shrinks by that much (its bottom stays). Checked every second while auto-hide is on (a window restored after a respring, or put back
// by its engine a moment later, is caught too); at most 4 moves per window and mode, so nothing fights the engine forever.
static const void *kSBRetopKey = &kSBRetopKey, *kSBWasTopKey = &kSBWasTopKey;   // (was at the top edge before a turn)
static void DMAutoHideRetopAll(BOOL layout, BOOL tiled, BOOL modeChanged) {
    CGFloat bottom = -1;
    for (UIView *st in DMAerialStages()) {
        if (modeChanged) objc_setAssociatedObject(st, kSBRetopKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        int tries = [objc_getAssociatedObject(st, kSBRetopKey) intValue];
        if (tries >= 4) continue;   // (the engine keeps putting it back: left alone)
        if (st.hidden || DMStageMinimized(st) || (tiled && [gFitGroup containsObject:DMStageBundle(st) ?: @""])) continue;
        // (a Zetsu window IS a UIWindow, whose -window is nil: it counts as on screen itself -- it was skipped here, so a Zetsu window moved into
        // the top 24 pt stayed there, over the bar, after auto-hide went off: seen on the iPad 2)
        UIWindow *host = [st isKindOfClass:[UIWindow class]] ? (UIWindow *)st : st.window;
        if (!host || [st.layer animationKeys].count) continue;   // (not while it is animating in: next time)
        if (bottom < 0) bottom = CGRectGetMaxY(DMUsableArea());
        CGRect f = st.frame, was = f;
        f.origin.y -= DMAutoHideShiftOf(st);
        BOOL fullHeight = CGRectGetMaxY(f) > bottom - 3.0;   // (reaching the usable bottom, or below it behind the Dock)
        BOOL wasTop = [objc_getAssociatedObject(st, kSBWasTopKey) boolValue] && CACurrentMediaTime() - gSBTurnAt > 1.2;
        if (wasTop) objc_setAssociatedObject(st, kSBWasTopKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        // (a turn scales a window's place: one that was at the top goes back to it. A full-height window keeps its bottom where the usable area
        // ends, not lower: an engine may already have taken our move into its frame)
        if (layout && (fabs(f.origin.y - 23.5) < 2.0 || (wasTop && f.origin.y > 0.5 && f.origin.y < 60.0))) { if (fullHeight) f.size.height = MAX(bottom, CGRectGetMaxY(f) - f.origin.y); f.origin.y = 0; }
        else if (!layout && f.origin.y < 22.0) { if (fullHeight) f.size.height = MAX(bottom, CGRectGetMaxY(f)) - 23.0; f.origin.y = 23.0; }
        else continue;
        if (CGRectEqualToRect(f, was)) continue;
        objc_setAssociatedObject(st, kSBRetopKey, @(tries + 1), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMAutoHideUnshift(st);
        DMAerialMoveStage(st, f, nil);
        DMLog([NSString stringWithFormat:@"[autohide] %@ %@ to %@", DMStageBundle(st), layout ? @"up to the top edge" : @"back under the bar", NSStringFromCGRect(f)]);
    }
}
static void DMAutoHideTick(void) {   // every 0.1 s
    static BOOL wasActive = NO, wasLayout = NO;
    BOOL active = DMAutoHideActive(), layout = DMAutoHideLayout();
    if (active != wasActive) {
        wasActive = active;
        DMLog([NSString stringWithFormat:@"[autohide] %@ (pointer %@)", active ? @"on" : @"off", gDMPointerAttached ? @"attached" : @"not attached"]);
        if (!active) DMStatusBarSetHidden(NO, @"auto-hide off, no pointer, or the Lock Screen");
        gSBLastExit = CACurrentMediaTime();
    }
    // An engine that sets a window's transform itself (a turn of the screen, its own animations) wipes our move: then our note of it goes too, and
    // the window is moved again for the bar that shows (otherwise hiding the bar later would move it up by a shift it no longer has).
    BOOL lost = NO;
    for (UIView *st in active ? DMAerialStages() : @[]) {
        NSNumber *ty = objc_getAssociatedObject(st, kSBShiftTyKey);
        if (!ty) continue;
        NSValue *fr = objc_getAssociatedObject(st, kSBShiftFrameKey);
        BOOL tyLost = fabs(st.transform.ty - ty.doubleValue) >= 0.5 && ![st.layer animationForKey:@"transform"];
        // (its engine placed it anew while our move was in its transform: the frame it set is where it wants the window on screen)
        BOOL placed = !tyLost && fr && (fabs(st.frame.origin.x - fr.CGRectValue.origin.x) > 0.5 || fabs(st.frame.origin.y - fr.CGRectValue.origin.y) > 0.5 || fabs(st.frame.size.height - fr.CGRectValue.size.height) > 0.5);
        if (!tyLost && !placed) continue;
        CGFloat shift = [objc_getAssociatedObject(st, kSBShiftKey) doubleValue];
        objc_setAssociatedObject(st, kSBShiftKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(st, kSBShiftTyKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(st, kSBShiftFrameKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMAutoHideDropBakeRecognizer(st);
        if (placed) { CGRect f = st.frame; [UIView performWithoutAnimation:^{ st.transform = CGAffineTransformTranslate(st.transform, 0, -shift); st.frame = f; }]; }
        DMLog([NSString stringWithFormat:@"[autohide] %@: its engine %@: our move forgotten", DMStageBundle(st), placed ? @"placed the window anew" : @"reset the window's transform"]);
        lost = YES;
    }
    if (lost && !gSBHidden && layout) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (!gSBHidden && DMAutoHideLayout()) DMStatusBarMoveWindows(YES, DMStatusBarHeightForMove(), YES);
    });
    if (layout != wasLayout) {
        wasLayout = layout;
        if (!layout) DMStatusBarMoveWindows(NO, 0, NO);   // (nothing stays moved down)
        BOOL tiled = DMFitEnabled() && gFitGroup.count >= 2;
        if (tiled) DMApplyGroupSlots(nil);   // tiles take (or give back) the 24 pt, once
        DMAutoHideRetopAll(layout, tiled, YES);
    }
    static CFTimeInterval lastRetop = 0;   // windows that turn up later (restored after a respring, opened by the engine at its remembered place)
    if (layout && active && CACurrentMediaTime() - lastRetop > 1.0) {
        lastRetop = CACurrentMediaTime();
        DMAutoHideRetopAll(YES, DMFitEnabled() && gFitGroup.count >= 2, NO);
        if (!gSBHidden && CACurrentMediaTime() - gSBTurnAt > 1.5) DMStatusBarMoveWindows(YES, DMStatusBarHeightForMove(), YES);   // (the bar shows: windows at the top below it, also ones that just came; not mid-turn)
    }
    DMAutoHideKeepBarAbove(layout);
    DMAutoHideKeepTitlesDown();
    if (!active) { gSBZone = 0; return; }
    if (DMScreenOnAndUnlocked()) DMAutoHidePollPointer();   // (polled only while auto-hide is on, a pointer is attached and the screen is on and unlocked)
    for (UIView *b in DMStatusBarsToMove()) {   // hover watching on every bar copy; a new copy hidden like the others
        if (!objc_getAssociatedObject(b, kSBHoverKey)) {
            UIHoverGestureRecognizer *hv = [[UIHoverGestureRecognizer alloc] initWithTarget:[DMStatusBarHover shared] action:@selector(hover:)];
            [b addGestureRecognizer:hv];
            objc_setAssociatedObject(b, kSBHoverKey, hv, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (gSBHidden) DMStatusBarApplyOffset(b, -MAX(24.0, b.bounds.size.height), NO);   // (a new copy: hidden like the others)
    }
    CFTimeInterval now = CACurrentMediaTime();
    BOOL pointerAtBar = gSBZone == 1 || gSBZone == 2 || gSBPointerInBar;
    CFTimeInterval leftAt = MAX(gSBLastExit, gSBZone == 3 || gSBZone == 0 ? gSBZoneAt : 0);
    if (!gSBHidden && !pointerAtBar && !gOverlay && now - leftAt > 0.7 && now - gSBRevealedAt > 1.0) DMStatusBarSetHidden(YES, @"the pointer left the bar");
}
// The 0.1 s tick only runs while the setting is on (off by default: then nothing of this runs at all). Switched off, it runs on for 1.5 s so the
// bar, the windows and the tiles settle back (DMAutoHideTick's "off" transition), then stops. Checked at start and on every preferences change.
static NSTimer *gAutoHideTimer = nil;
static void DMAutoHideRefreshTimer(void) {
    gAutoHideReadAt = -10;   // (read the preference again now)
    BOOL on = DMAutoHidePref();
    if (on && !gAutoHideTimer) {
        gAutoHideTimer = [NSTimer timerWithTimeInterval:0.1 repeats:YES block:^(NSTimer *timer) { DMAutoHideTick(); }];
        [[NSRunLoop mainRunLoop] addTimer:gAutoHideTimer forMode:NSRunLoopCommonModes];
        DMGateTimer(gAutoHideTimer);
        if (gDMScreenOff) gAutoHideTimer.fireDate = [NSDate distantFuture];
        DMLog(@"[autohide] setting on: its tick started");
    } else if (!on && gAutoHideTimer) {
        NSTimer *t = gAutoHideTimer; gAutoHideTimer = nil;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            if (gAutoHideTimer != t) { [t invalidate]; DMLog(@"[autohide] setting off: its tick stopped"); }
        });
    }
}
static BOOL gAutoHideStarted = NO;
static void DMAutoHideStart(void) {
    if (gAutoHideStarted) return; gAutoHideStarted = YES;
    DMAutoHideWatchZones();
    DMAutoHideRefreshTimer();
}
static void DMAutoHideRefreshTimerIfStarted(void) { if (gAutoHideStarted) DMAutoHideRefreshTimer(); }
static void DMAutoHideDebugInfo(void) {
    NSMutableString *o = [NSMutableString stringWithFormat:@"[ahinfo] pref %d layout %d active %d hidden %d zone %llu inBar %d copies %lu", DMAutoHidePref(), DMAutoHideLayout(), DMAutoHideActive(), gSBHidden, gSBZone, gSBPointerInBar, (unsigned long)gCopies.count];
    for (UIView *b in DMStatusBarsToMove()) {
        CALayer *l = b.layer, *p = l.presentationLayer;
        [o appendFormat:@"\n  %@ in %@ (hidden %d, level %.0f) alpha %.2f hidden %d sub ty %.1f pres ty %.1f anims %@ superview %@ frame %@", NSStringFromClass([b class]), NSStringFromClass([b.window class]), b.window.hidden, b.window.windowLevel, b.alpha, b.hidden, l.sublayerTransform.m42, p ? p.sublayerTransform.m42 : -999, [[l animationKeys] componentsJoinedByString:@","], NSStringFromClass([b.superview class]), NSStringFromCGRect(b.frame)];
    }
    for (UIView *st in DMAerialStages()) [o appendFormat:@"\n  stage %@ frame %@ shift %.1f ty %.1f title %.1f", DMStageBundle(st), NSStringFromCGRect(st.frame), DMAutoHideShiftOf(st), st.transform.ty, DMAutoHideTitleShiftOf(st)];
    DMLog(o);
}
// A turn of the screen: the engines read each window's frame to fit it to the new screen. Our moves (in the windows' transforms) would be read as
// part of it, so they go first; the windows are moved again for the bar once the turn has settled (the 1 s pass in DMAutoHideTick).
%hook SpringBoard
- (void)noteInterfaceOrientationChanged:(long long)o duration:(double)duration updateMirroredDisplays:(BOOL)mirrored force:(BOOL)force logMessage:(id)message {
    if (o != DMRealInterfaceOrientation() && DMAutoHideLayout()) {
        for (UIView *st in DMAerialStages()) {
            if (DMAutoHideShiftOf(st) > 0) objc_setAssociatedObject(st, kSBWasTopKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            objc_setAssociatedObject(st, kSBRetopKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // (a new shape: new tries)
        }
        DMAutoHideBeforeRetile(); gSBTurnAt = CACurrentMediaTime();
        DMLog([NSString stringWithFormat:@"[autohide] the screen turns to %lld: moves taken back first", o]);
    }
    %orig;
}
%end
// ---- banners for apps whose windows are all minimized (engine-independent; SpringBoard's side, no engine hooked) ----
// iOS asks an app in the foreground what to do with its own notification (-[UNSApplicationLauncher willPresentNotification:forBundleIdentifier:
// withCompletionHandler:]); most apps answer "nothing", so no banner. A window minimized to the Dock keeps its app in the foreground (Aerial 5.0 insists
// on that), so its notifications vanished. When every window of the app is minimized and it is not the full-screen app, the app is not asked: the
// answer is "banner, list, sound, badge" -- exactly what a background app gets -- and our Mac-style banner shows as usual.
@interface UNSApplicationLauncher : NSObject
@end
%hook UNSApplicationLauncher
- (void)willPresentNotification:(id)notification forBundleIdentifier:(NSString *)bundleID withCompletionHandler:(id)handler {
    // (this runs on the notification server's own queue, not the main thread: nothing of SpringBoard's is asked here -- a first version called
    // DMFrontApp() and crashed SpringBoard -- only the snapshot the main thread keeps, DMSyncMinimizedScenes)
    BOOL minimizedOnly = NO;
    if (bundleID.length && handler) { @synchronized (gMinimizedOnlyLock) { minimizedOnly = [gMinimizedOnlyApps containsObject:bundleID]; } }
    if (!minimizedOnly) {
        %orig;
        return;
    }
    DMLog([NSString stringWithFormat:@"[banner] %@: its windows are minimized: shown like a background app's notification", bundleID]);
    ((void (^)(unsigned long))handler)(16 | 8 | 2 | 1);   // banner | list | sound | badge
}
%end
// ===== end auto-hiding status bar ================================================================================================================

// ===== macOS-style Haptic Touch menus (M1 pipeline task 4, 2026-09-24; theme only) ===============================================================
// SpringBoard's long-press menus (Home Screen and Dock icons, folders, widgets) use UIKit's own context menu views. Made to look like our status bar
// menus / a macOS menu, ADAPTIVE (2026-09-25): compact Mac rows (30 pt, 14 pt text) while a trackpad or mouse is attached; roomier rows for a
// finger otherwise (40 pt, 15 pt text; a keyboard alone counts as finger use). Everything at native resolution: native font sizes and a smaller
// symbol configuration (never a scale transform: that blurred icons and text). The size is decided once per menu, when it first lays out (kept on
// its _UIContextMenuListView), so an open menu never jumps; the next menu after a connect/disconnect uses the new size. Nothing about what the rows
// do changes; only SpringBoard's own menus are touched (Mac Status Bar runs there only).
// Debug: /tmp/msb-fakeptr = act as if a pointer were attached (debug builds only).
typedef struct { CGFloat rowH, title, subtitle, symbol, top, bottom, leading, iconX; } DMCtxMetrics;
static const DMCtxMetrics kCtxCompact = { 30.0, 14.0, 11.0, 13.0, 20.0, -9.5, 12.0, -22.0 };
static const DMCtxMetrics kCtxFinger  = { 40.0, 15.0, 12.0, 15.0, 25.5, -14.5, 14.0, -25.0 };
static const CGFloat kCtxMaxRowH = 40.0;   // (the taller of the two: rows at or under it may be ours)
static const void *kCtxCompactKey = &kCtxCompactKey;
static const void *kCtxLeadKey = &kCtxLeadKey;   // (on a row's title-stack leading constraint: @[UIKit's own constant, the one set here])
static const CGFloat kCtxSignedLead = 20.0;      // (UIKit's title inset past this leaves room for a sign before the title; a plain row's is under it)
// Settings > Status Bar > App Menus > Haptic Touch Menus: Mac (the default) or Stock (iPadOS's own menus, 28 Sep). Read at most every 2 s, so a
// change applies to the next menu. (debug: /tmp/msb-ctx-stock = the stock look, to compare)
static BOOL DMContextMenuTheme(void) {
    static BOOL on = YES; static CFTimeInterval readAt = -10;
    if (CACurrentMediaTime() - readAt > 2.0) {
        readAt = CACurrentMediaTime(); on = YES;
        CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("contextMenuStyle"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (v) { if (CFGetTypeID(v) == CFStringGetTypeID()) on = CFStringCompare((CFStringRef)v, CFSTR("stock"), 0) != kCFCompareEqualTo; CFRelease(v); }
    }
    return on && !DMTestFlag("/tmp/msb-ctx-stock");
}
static BOOL DMCtxPointerNow(void) {
    if (DMTestFlag("/tmp/msb-fakeptr")) return YES;
    id mgr = DMCall([UIApplication sharedApplication], @"mousePointerManager");   // (the same answer as the Pointer row / DMPointerDeviceCheck)
    SEL s = NSSelectorFromString(@"isHardwarePointingDeviceAttached");
    if ([mgr respondsToSelector:s]) return ((BOOL (*)(id, SEL))objc_msgSend)(mgr, s);
    return gDMPointerAttached;
}
static DMCtxMetrics DMCtxMetricsFor(UIView *v) {   // the menu's size, decided the first time one of its views asks
    UIView *list = v;
    Class lc = objc_getClass("_UIContextMenuListView");
    while (list && !(lc && [list isKindOfClass:lc])) list = list.superview;
    static __weak UIView *lastList = nil;   // (a row being made for a menu that is up but not yet in it -- a long menu scrolling -- uses that menu's size)
    if (!list && lastList.window) list = lastList;
    NSNumber *n = list ? objc_getAssociatedObject(list, kCtxCompactKey) : nil;
    if (!n) {
        n = @(DMCtxPointerNow());
        if (list) {
            objc_setAssociatedObject(list, kCtxCompactKey, n, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            lastList = list;
            DMLog([NSString stringWithFormat:@"[ctxmenu] a menu opens: %@ rows", n.boolValue ? @"compact (pointer)" : @"finger"]);
        }
    }
    return n.boolValue ? kCtxCompact : kCtxFinger;
}
static const void *kCtxSizedKey = &kCtxSizedKey;
static UIImage *DMCtxSizedPicture(UIImage *img, CGFloat factor) {
    NSArray *cached = objc_getAssociatedObject(img, kCtxSizedKey);
    if (cached.count == 2 && fabs([cached[0] doubleValue] - factor) < 0.001) return cached[1];
    CGFloat sc = img.scale > 0 ? img.scale : 1.0;
    CGSize s = CGSizeMake(round(img.size.width * factor * sc) / sc, round(img.size.height * factor * sc) / sc);
    if (s.width < 1.0 || s.height < 1.0) return img;
    UIGraphicsImageRendererFormat *f = [UIGraphicsImageRendererFormat defaultFormat];
    f.scale = sc; f.opaque = NO;
    UIImage *r = [[[UIGraphicsImageRenderer alloc] initWithSize:s format:f] imageWithActions:^(UIGraphicsImageRendererContext *ctx) {
        CGContextSetInterpolationQuality(ctx.CGContext, kCGInterpolationHigh);
        [img drawInRect:CGRectMake(0, 0, s.width, s.height)];
    }];
    r = r ? [r imageWithRenderingMode:img.renderingMode] : img;
    objc_setAssociatedObject(img, kCtxSizedKey, @[@(factor), r], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    return r;
}
static BOOL DMCtxHasSubtitle(UIView *cell) {   // a row showing a subtitle under its title (two labels with text in its stack)
    NSMutableArray *todo = [NSMutableArray arrayWithObject:cell];
    for (NSUInteger i = 0; i < todo.count && i < 12; i++) {
        UIView *v = todo[i];
        if ([v isKindOfClass:[UIStackView class]]) {
            int n = 0;
            for (UIView *l in ((UIStackView *)v).arrangedSubviews) if ([l isKindOfClass:[UILabel class]] && !l.hidden && ((UILabel *)l).text.length) n++;
            return n > 1;
        }
        [todo addObjectsFromArray:v.subviews];
    }
    return NO;
}
%group MacContextMenus
%hook _UIContextMenuCell
- (UICollectionViewLayoutAttributes *)preferredLayoutAttributesFittingAttributes:(UICollectionViewLayoutAttributes *)a {
    UICollectionViewLayoutAttributes *r = %orig;
    if (!DMContextMenuTheme()) return r;
    if (DMCtxHasSubtitle((UIView *)self)) return r;   // (a row with a second line keeps UIKit's height: both lines need it)
    CGFloat h = DMCtxMetricsFor((UIView *)self).rowH;
    CGRect f = r.frame;
    if (f.size.height > h && f.size.height < 90.0) { f.size.height = h; r.frame = f; }
    return r;
}
%end
%hook _UIContextMenuCellContentView
- (void)layoutSubviews {
    UIView *me = (UIView *)self;
    BOOL mine = DMContextMenuTheme() && me.bounds.size.height <= kCtxMaxRowH + 0.5;   // (a row we shortened; others left alone)
    DMCtxMetrics m = mine ? DMCtxMetricsFor(me) : kCtxFinger;
    if (mine && me.bounds.size.height > m.rowH + 0.5) mine = NO;
    if (mine) {
        // the row's own constraints (read on the device): the text's first baseline below the top, its last baseline above the bottom, the
        // leading inset, the symbol centred in from the right -- set for the row height and font above (baseline = middle + half the cap height)
        for (NSLayoutConstraint *k in me.constraints) {
            BOOL stack = [k.firstItem isKindOfClass:[UIStackView class]], image = [k.firstItem isKindOfClass:[UIImageView class]];
            CGFloat want = k.constant;
            if (stack && k.firstAttribute == NSLayoutAttributeFirstBaseline && k.secondAttribute == NSLayoutAttributeTop) want = m.top;
            else if (stack && k.firstAttribute == NSLayoutAttributeLastBaseline && k.secondAttribute == NSLayoutAttributeBottom) want = m.bottom;
            else if (stack && k.firstAttribute == NSLayoutAttributeLeading && k.secondAttribute == NSLayoutAttributeLeading) {
                // (a row with a sign before its title -- iPadOS 15 puts a submenu's chevron there: Share… on a desktop icon -- has a wider inset of
                //  UIKit's, kept: the title went over the sign, 1.3.1 logic test. UIKit's own value is the one it set, unless it is still ours)
                NSArray *rec = objc_getAssociatedObject(k, kCtxLeadKey);
                CGFloat stock = (rec.count == 2 && fabs(k.constant - [rec[1] doubleValue]) < 0.01) ? [rec[0] doubleValue] : k.constant;
                want = stock > kCtxSignedLead ? stock : m.leading;
                if (want == stock && rec.count != 2) DMLog([NSString stringWithFormat:@"[ctxmenu] a row with a sign before its title keeps UIKit's inset (%.1f)", stock]);
                objc_setAssociatedObject(k, kCtxLeadKey, @[@(stock), @(want)], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            }
            else if (image && k.firstAttribute == NSLayoutAttributeCenterX && k.secondAttribute == NSLayoutAttributeTrailing) want = m.iconX;
            if (fabs(k.constant - want) > 0.01) k.constant = want;
        }
        for (UIView *v in me.subviews) {
            if ([v isKindOfClass:[UIStackView class]]) {
                BOOL first = YES;
                for (UIView *l in ((UIStackView *)v).arrangedSubviews) if ([l isKindOfClass:[UILabel class]]) {
                    UILabel *lab = (UILabel *)l; CGFloat want = first ? m.title : m.subtitle; first = NO;
                    if (fabs(lab.font.pointSize - want) > 0.1) lab.font = [lab.font fontWithSize:want];
                }
            }
        }
    }
    %orig;
}
// The row's symbol size: UIKit asks this for the configuration it gives the row's symbol image view (a font-sized one); the point size is replaced by
// the menu's own, so the symbol is drawn at that size natively (vector art: sharp at any size). Pictures: -setImage: below.
- (UIImageSymbolConfiguration *)_iconSymbolConfigurationForCurrentTraitsUsingBoldFont:(BOOL)bold {
    UIImageSymbolConfiguration *c = %orig;
    if (!DMContextMenuTheme() || ![c isKindOfClass:[UIImageSymbolConfiguration class]]) return c;
    UIImageSymbolConfiguration *size = [UIImageSymbolConfiguration configurationWithPointSize:DMCtxMetricsFor((UIView *)self).symbol];
    return [c configurationByApplyingConfiguration:size] ?: c;
}
// The row's image as it is handed over. A symbol that brings its own size (it ignores the configuration above) is re-made at the menu's size. A
// picture (a tweak's or an app's PNG icon: Force Quit, Launch Without Tweaks) is redrawn once at the menu's size with high-quality filtering, so
// it is shown pixel for pixel like the symbols (a scaled view would resample it at every frame and look soft).
- (void)setImage:(UIImage *)image {
    if (DMContextMenuTheme() && image) {
        CGFloat pt = DMCtxMetricsFor((UIView *)self).symbol;
        UIImage *sized = nil;
        if (image.isSymbolImage) sized = [image imageByApplyingSymbolConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:pt]];
        else if (image.size.width <= 40.0 && image.size.height <= 40.0) sized = DMCtxSizedPicture(image, pt / 17.0);   // (17 pt: the stock symbol size)
        if (sized) image = sized;
    }
    %orig(image);
}
%end
%hook _UIContextMenuListView
- (void)layoutSubviews {
    %orig;
    if (!DMContextMenuTheme()) return;
    for (UIView *v in ((UIView *)self).subviews) {
        if (fabs(v.layer.cornerRadius - 13.0) < 0.6) v.layer.cornerRadius = 10.0;
        for (UIView *c in v.subviews) if (fabs(c.layer.cornerRadius - 13.0) < 0.6) c.layer.cornerRadius = 10.0;
    }
}
%end
%end
// iPadOS 15 names for the two hooks above (checked on the M1, 15.6.1): the symbol configuration is -_symbolConfigurationForCurrentTraitsUsingBoldFont:
// and the row's picture arrives through -setTrailingImage: (the icon sits at the trailing end; there is no -setImage:). Same work, installed only
// where these selectors exist.
static UIImage *DMCtxSizedRowImage(UIView *row, UIImage *image) {
    if (!DMContextMenuTheme() || !image) return image;
    CGFloat pt = DMCtxMetricsFor(row).symbol;
    UIImage *sized = nil;
    if (image.isSymbolImage) sized = [image imageByApplyingSymbolConfiguration:[UIImageSymbolConfiguration configurationWithPointSize:pt]];
    else if (image.size.width <= 40.0 && image.size.height <= 40.0) sized = DMCtxSizedPicture(image, pt / 17.0);
    return sized ?: image;
}
%group MacContextMenus15
%hook _UIContextMenuCellContentView
- (UIImageSymbolConfiguration *)_symbolConfigurationForCurrentTraitsUsingBoldFont:(BOOL)bold {
    UIImageSymbolConfiguration *c = %orig;
    if (!DMContextMenuTheme() || ![c isKindOfClass:[UIImageSymbolConfiguration class]]) return c;
    UIImageSymbolConfiguration *size = [UIImageSymbolConfiguration configurationWithPointSize:DMCtxMetricsFor((UIView *)self).symbol];
    return [c configurationByApplyingConfiguration:size] ?: c;
}
- (void)setTrailingImage:(UIImage *)image {
    %orig(DMCtxSizedRowImage((UIView *)self, image));
}
%end
%end
// iPad 2 crash (2026-09-25 00:50, Safe Mode): SIGABRT from an NSException in -[UIPreviewTarget initWithContainer:center:transform:], thrown while a
// Haptic Touch menu was dismissing (-[_UIContextMenuPresentationAnimation _targetedPreviewForDismissalAnimation], Reduce Motion path): the view the
// menu came from had just left its window (a window minimized or resized at that moment -- Zetsu's own long-press menu on a full-screen game's window).
// UIKit requires the preview's container to be in a window and raises otherwise. In SpringBoard such a container is replaced by the window the menu
// is shown in (or the key window), so the menu just fades out at the same spot instead of taking SpringBoard down. A container that is in a window is
// untouched.
static UIView *DMPreviewFallbackContainer(void) {
    UIWindow *best = nil;
    for (UIWindow *w in DMAllWindows()) {
        if (w.hidden || w.alpha < 0.01) continue;
        NSString *cn = NSStringFromClass([w class]);
        if ([cn containsString:@"ContextMenu"]) return w;   // (the menu's own window, if it has one)
        if (!best && ![cn containsString:@"Keyboard"] && w.bounds.size.width > 300.0) best = w;   // (otherwise the backmost full-size one)
    }
    return best ?: DMAllWindows().firstObject;
}
%group PreviewTargetGuard
// Prevention, for a window that is torn down while a menu from it is still up (Zetsu closes its window by replacing the window's root view
// controller at the end of its close animation -- the 00:50 crash stack): the menu is closed first, without animation, while the view it came
// from is still in the window, so UIKit's own teardown finds nothing left to dismiss.
%hook UIWindow
- (void)setRootViewController:(UIViewController *)root {
    UIViewController *old = self.rootViewController;
    if (old && old != root) {
        UIViewController *menu = DMContextMenuVCInWindow(self);
        if (menu && !menu.isBeingDismissed && menu.presentingViewController) {
            DMLog([NSString stringWithFormat:@"[ctxmenu] %@ is replacing its root view controller with a menu up: the menu (%@) is closed first", NSStringFromClass([self class]), NSStringFromClass([menu class])]);
            [menu.presentingViewController dismissViewControllerAnimated:NO completion:nil];
        }
    }
    %orig;
}
%end
%hook UIPreviewTarget
- (instancetype)initWithContainer:(UIView *)container center:(CGPoint)center transform:(CGAffineTransform)transform {
    if (!container || !container.window) {
        UIView *fallback = DMPreviewFallbackContainer();
        static int told = 0; if (told++ < 20) DMLog([NSString stringWithFormat:@"[ctxmenu] a menu preview's container %@ is not in a window: %@ used instead (UIKit would raise)", container ? NSStringFromClass([container class]) : @"(nil)", fallback ? NSStringFromClass([fallback class]) : @"(none)"]);
        if (fallback) return %orig(fallback, center, transform);
    }
    return %orig;
}
- (instancetype)initWithContainer:(UIView *)container center:(CGPoint)center {
    if (!container || !container.window) {
        UIView *fallback = DMPreviewFallbackContainer();
        static int told = 0; if (told++ < 20) DMLog([NSString stringWithFormat:@"[ctxmenu] a menu preview's container %@ is not in a window: %@ used instead (UIKit would raise)", container ? NSStringFromClass([container class]) : @"(nil)", fallback ? NSStringFromClass([fallback class]) : @"(none)"]);
        if (fallback) return %orig(fallback, center);
    }
    return %orig;
}
%end
%end
// Debug (trigger scenecreate_<n>): which code creates the next n FrontBoard scenes -- the images on the call stack (read-only; logs only).
// The hooks are installed in debug builds only (DMContextMenusInit).
static void DMLogSceneCreator(NSString *what) {
    if (gSceneCreateLogs <= 0) return;
    gSceneCreateLogs--;
    NSMutableArray *imgs = [NSMutableArray array];
    NSArray<NSNumber *> *addrs = [NSThread callStackReturnAddresses];
    for (NSUInteger i = 1; i < addrs.count && imgs.count < 16; i++) {
        Dl_info di; if (!dladdr((void *)addrs[i].unsignedLongValue, &di) || !di.dli_fname) continue;
        const char *sl = strrchr(di.dli_fname, '/'); NSString *n = [NSString stringWithUTF8String:sl ? sl + 1 : di.dli_fname];
        if (di.dli_sname) n = [n stringByAppendingFormat:@"(%s)", di.dli_sname];
        if (![imgs.lastObject isEqual:n]) [imgs addObject:n];
    }
    DMLog([NSString stringWithFormat:@"[scenecreate] %@ <- %@", what, [imgs componentsJoinedByString:@" < "]]);
}
%group SceneCreateDebug
%hook FBSceneManager
- (id)createSceneWithDefinition:(id)d initialParameters:(id)p {
    id r = %orig;
    DMLogSceneCreator(DMCall(r, @"identifier"));
    return r;
}
- (id)createSceneWithIdentifier:(id)i parameters:(id)p clientProvider:(id)c transitionContext:(id)t {
    id r = %orig;
    DMLogSceneCreator(i);
    return r;
}
- (id)createSceneWithIdentifier:(id)i settings:(id)st initialClientSettings:(id)cs clientProvider:(id)c transitionContext:(id)t {
    id r = %orig;
    DMLogSceneCreator(i);
    return r;
}
- (id)createSceneWithDefinition:(id)d {
    id r = %orig;
    DMLogSceneCreator(DMCall(r, @"identifier"));
    return r;
}
%end
%end

// ===== our status bar over an app that hides the status bar (a game) while a window is in front of it ===========================================
// Requested (2026-09-25): a full-screen game hides the status bar; with a window brought over it there was no menu bar and no traffic lights for
// that window. While a window is in front of such an app, SpringBoard is told the app's status bar is NOT hidden, so it draws its status bar (ours) over
// the app again; when the app takes the focus back (a tap on it), no window is in front any more, or the app leaves, it is hidden again. Only
// SpringBoard's answer changes (-[SBDeviceApplicationSceneStatusBarStateProvider_Base statusBarHidden]); nothing is sent to the app, so its own layout
// (its scene settings) does not change. Off switch: /tmp/msb-nogamebar.
static NSHashTable *gHiddenBarProviders = nil;    // SpringBoard's status bar state providers that answered "hidden" (weak)
static BOOL DMBarProviderIsFor(id p, NSString *bundle) {
    if (!bundle.length || ![p respondsToSelector:NSSelectorFromString(@"statusBarSceneIdentifier")]) return NO;
    id sid = DMCall(p, @"statusBarSceneIdentifier");
    if (![sid isKindOfClass:[NSString class]]) return NO;
    return [sid containsString:[NSString stringWithFormat:@":%@-", bundle]] || [sid hasSuffix:bundle];   // ("sceneID:<bundle>-default")
}
static BOOL DMBarHiddenAnswer(id provider, BOOL hidden) {
    if (!hidden) return NO;
    if (!gHiddenBarProviders) gHiddenBarProviders = [NSHashTable weakObjectsHashTable];
    [gHiddenBarProviders addObject:provider];
    if (gBarOverHidingApp && DMBarProviderIsFor(provider, gBarOverHidingApp)) return NO;
    return YES;
}
static void DMBarHiddenChanged(NSString *bundle) {   // tells SpringBoard's observers (the app's scene view) to read the answer again
    SEL s = NSSelectorFromString(@"sceneWithIdentifier:didChangeStatusBarHiddenTo:withAnimation:");
    SEL en = NSSelectorFromString(@"enumerateObserversWithBlock:");
    NSUInteger told = 0;
    for (id p in gHiddenBarProviders.allObjects) {
        if (!DMBarProviderIsFor(p, bundle) || ![p respondsToSelector:en]) continue;
        id sid = DMCall(p, @"statusBarSceneIdentifier");
        BOOL hidden = ((BOOL (*)(id, SEL))objc_msgSend)(p, @selector(statusBarHidden));
        NSMutableArray *observers = [NSMutableArray array];
        void (^collect)(id) = ^(id o) { if (o && ![observers containsObject:o]) [observers addObject:o]; };
        ((void (*)(id, SEL, id))objc_msgSend)(p, en, collect);
        id all = [p respondsToSelector:NSSelectorFromString(@"_allObservers")] ? DMCall(p, @"_allObservers") : nil;   // (iOS 15: the block above found none)
        if ([all respondsToSelector:@selector(allObjects)]) for (id o in [all allObjects]) collect(o);
        else if ([all isKindOfClass:[NSArray class]]) for (id o in all) collect(o);
        if (DMTestFlag("/tmp/macstatusbar-debug")) {
            NSMutableArray *cls = [NSMutableArray array]; for (id o in observers) [cls addObject:NSStringFromClass([o class])];
            DMLog([NSString stringWithFormat:@"[gamebar] provider %@ (%@): observers %@, all %@", NSStringFromClass([p class]), sid, cls, NSStringFromClass([all class])]);
        }
        for (id o in observers) {
            id target = o;
            if (![target respondsToSelector:s]) { @try { target = [o valueForKey:@"observer"]; } @catch (id e) { target = nil; } }   // (an observer record)
            if (![target respondsToSelector:s]) continue;
            ((void (*)(id, SEL, id, BOOL, long long))objc_msgSend)(target, s, sid, hidden, 1);
            told++;
        }
    }
    DMLog([NSString stringWithFormat:@"[gamebar] %@: status bar %@ (%lu observers told)", bundle, [gBarOverHidingApp isEqualToString:bundle] ? @"shown over the app (a window is in front of it)" : @"back to the app's own choice", (unsigned long)told]);
}
static void DMWatchBarOverHidingApp(void) {   // every tick
    NSString *want = nil;
    NSString *fb = [DMFrontApp() bundleIdentifier];
    if (fb.length && gHiddenBarProviders.count && !DMTestFlag("/tmp/msb-nogamebar") && DMActiveEngine() != DMEngineNone
        && ![gFullScreenActivatedBundle isEqualToString:fb]   // (the app was tapped: it has the focus)
        && DMFullScreenAppInFront() && DMVisibleWindowCount() > 0
        && DMDesiredWindowLevel() > kMilkyWayBackLevel + 0.01   // (the windows are in front of it, not behind)
        && !DMSwitcherVisible() && !gWindowsHiddenForLibrary) want = fb;
    if ([want ?: @"" isEqualToString:gBarOverHidingApp ?: @""]) return;
    NSString *old = gBarOverHidingApp;
    gBarOverHidingApp = [want copy];
    if (old.length) DMBarHiddenChanged(old);
    if (want.length) DMBarHiddenChanged(want);
}
%group GameStatusBar
%hook SBDeviceApplicationSceneStatusBarStateProvider_Base
- (BOOL)statusBarHidden {
    BOOL hidden = %orig;
    return DMBarHiddenAnswer(self, hidden);
}
%end
%end

// ===== FrontBoard's scene monitor released without being invalidated =============================================================================
// The recurring iPad 2 Safe Mode (EXC_BREAKPOINT in -[FBSceneMonitor dealloc]: the Reminders, Clock-on-unlock and WhatsApp crashes, and 2026-09-25 05:58
// when Settings, just restored into a Zetsu window after a respring, was killed during Zetsu's launch burst): FrontBoard asserts that a scene monitor was
// invalidated before it goes away. Zetsu keeps one per window (ZetsuAppController -sceneMonitor) and can drop it without invalidating it when the app
// dies at the wrong moment. A monitor that reaches -dealloc still valid is invalidated first (FrontBoard's own call), then released as usual.
// Off switch: /tmp/msb-nomonitorguard.
%group SceneMonitorGuard
%hook FBSceneMonitor
- (void)dealloc {
    static ptrdiff_t off = -2;
    if (off == -2) { Ivar iv = class_getInstanceVariable(objc_getClass("FBSceneMonitor"), "_invalidated"); off = iv ? ivar_getOffset(iv) : -1; }
    if (off >= 0 && !*((BOOL *)((uint8_t *)(__bridge void *)self + off)) && !DMTestFlag("/tmp/msb-nomonitorguard")
        && [(id)self respondsToSelector:@selector(invalidate)]) {
        NSString *sid = nil; @try { sid = [(id)self valueForKey:@"_sceneID"]; } @catch (id e) {}
        DMLog([NSString stringWithFormat:@"[monitorguard] a scene monitor for %@ was released without being invalidated: invalidated first (FrontBoard would abort)", sid ?: @"?"]);
        @try { [(id)self performSelector:@selector(invalidate)]; } @catch (id e) {}
    }
    %orig;
}
%end
%end

static void DMContextMenusInit(void) {
    static BOOL done; if (done) return; done = YES;
    if (objc_getClass("_UIContextMenuCell")) %init(MacContextMenus);
    {   // (iPadOS 15: the same symbol / picture sizing under that version's method names)
        Class cv = objc_getClass("_UIContextMenuCellContentView");
        if (cv && ![cv instancesRespondToSelector:NSSelectorFromString(@"_iconSymbolConfigurationForCurrentTraitsUsingBoldFont:")]
            && [cv instancesRespondToSelector:NSSelectorFromString(@"_symbolConfigurationForCurrentTraitsUsingBoldFont:")]
            && [cv instancesRespondToSelector:NSSelectorFromString(@"setTrailingImage:")]) %init(MacContextMenus15);
    }
    if (objc_getClass("UIPreviewTarget") && !DMTestFlag("/tmp/msb-nopreviewguard")) %init(PreviewTargetGuard);
    if (objc_getClass("SBDeviceApplicationSceneStatusBarStateProvider_Base") && !gStockBar) %init(GameStatusBar);   // (our bar over games: not with the stock one)
    if (objc_getClass("FBSceneMonitor")) %init(SceneMonitorGuard);
#if DEBUG
    if (objc_getClass("FBSceneManager")) %init(SceneCreateDebug);
#endif
}
// ===== end macOS-style Haptic Touch menus =========================================================================================================

#if DEBUG
// Debug (trigger idleprobe): why the screen keeps drawing on an idle Home Screen. Logs our per-frame watchers' state, every layer in every visible
// window that has an animation running (with its duration / repeat count), and how often the main run loop wakes over 3 s.
static void DMIdleProbeLayer(CALayer *l, NSString *win, int depth, int *lines) {
    if (*lines > 80 || depth > 40) return;
    NSArray *keys = l.animationKeys;
    if (keys.count) {
        NSMutableArray *d = [NSMutableArray array];
        for (NSString *k in keys) {
            CAAnimation *a = [l animationForKey:k];
            NSString *path = [a isKindOfClass:[CAPropertyAnimation class]] ? ((CAPropertyAnimation *)a).keyPath : @"-";
            [d addObject:[NSString stringWithFormat:@"%@(%@ %@ dur %.2f repeat %.0f speed %.1f begin %.1f)", k, NSStringFromClass([a class]), path, a.duration, a.repeatCount, a.speed, a.beginTime]];
        }
        id del = l.delegate;
        UIView *v = [del isKindOfClass:[UIView class]] ? del : nil;
        NSString *chain = @"";
        for (UIView *u = v.superview; u && chain.length < 160; u = u.superview) chain = [chain stringByAppendingFormat:@" < %@", NSStringFromClass([u class])];
        DMLog([NSString stringWithFormat:@"[idle] %@: %@ (%@) frame %@ hidden %d: %@%@", win, NSStringFromClass([l class]), del ? NSStringFromClass([del class]) : @"-", NSStringFromCGRect(l.frame), l.hidden, [d componentsJoinedByString:@", "], chain]);
        (*lines)++;
    }
    for (CALayer *c in [l.sublayers copy]) DMIdleProbeLayer(c, win, depth + 1, lines);
}
static void DMIdleWindowBisect(NSUInteger i, NSArray<UIWindow *> *list) {
    if (!list) {
        NSMutableArray *l = [NSMutableArray array];
        for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES]) [l addObject:w];
        list = l;
    }
    if (i >= list.count) { DMLog(@"[idle] window bisect done"); return; }
    UIWindow *w = list[i];
    __block int wakes = 0;
    CFRunLoopObserverRef obs = CFRunLoopObserverCreateWithHandler(kCFAllocatorDefault, kCFRunLoopAfterWaiting, true, 0, ^(CFRunLoopObserverRef o, CFRunLoopActivity a) { wakes++; });
    BOOL wasHidden = w.hidden;
    w.hidden = YES;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ CFRunLoopAddObserver(CFRunLoopGetMain(), obs, kCFRunLoopCommonModes); });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        CFRunLoopRemoveObserver(CFRunLoopGetMain(), obs, kCFRunLoopCommonModes); CFRelease(obs);
        w.hidden = wasHidden;
        DMLog([NSString stringWithFormat:@"[idle] without %@ (level %.0f): %.0f wakes/s", NSStringFromClass([w class]), w.windowLevel, wakes / 2.0]);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMIdleWindowBisect(i + 1, list); });
    });
}
// Debug (trigger idlesample_<seconds>): what the main thread is doing while the Home Screen sits idle. A background thread suspends the main
// thread every 2 ms, records its program counter and frame-pointer chain into a preallocated buffer (nothing is allocated while it is
// suspended), and resumes it. Samples whose top frame is the kernel wait (mach_msg) are idle and skipped; the rest are grouped by stack and
// the most common are logged, symbolised with dladdr afterwards.
#define DM_SAMPLE_MAX 6000
#define DM_SAMPLE_DEPTH 24
static uintptr_t gSampleFrames[DM_SAMPLE_MAX][DM_SAMPLE_DEPTH];
static int gSampleDepth[DM_SAMPLE_MAX];
static mach_port_t gSampleMainThread = MACH_PORT_NULL;
static uintptr_t gSampleStackHi = 0, gSampleStackLo = 0;   // (the main thread's stack, noted in %ctor)
static NSString *DMSampleSym(uintptr_t a) {
    Dl_info i; if (!dladdr((void *)a, &i)) return [NSString stringWithFormat:@"%lx", (unsigned long)a];
    const char *img = i.dli_fname ? strrchr(i.dli_fname, '/') : NULL; img = img ? img + 1 : (i.dli_fname ?: "?");
    return [NSString stringWithFormat:@"%s`%s+%lu", img, i.dli_sname ?: "?", (unsigned long)(a - (uintptr_t)(i.dli_saddr ?: i.dli_fbase))];
}
static void DMIdleSampleEx(double seconds, BOOL fromHere);
static void DMIdleSample(double seconds) { DMIdleSampleEx(seconds, NO); }
// (debug, trigger hangwatch_<s>) for <s> seconds: a background watcher pings the main thread every 0.25 s; when it has not answered for 1.5 s
// (SpringBoard hung), the main thread's stacks are sampled for 1 s and logged from the background (the main thread cannot log then). Once.
static void DMHangWatch(double seconds) {
    __block volatile double lastSeen = CACurrentMediaTime();
    double limit = gHangWatchLimit; gHangWatchLimit = 1.5;
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
        CFTimeInterval end = CACurrentMediaTime() + seconds;
        BOOL fired = NO;
        while (CACurrentMediaTime() < end && !fired) {
            dispatch_async(dispatch_get_main_queue(), ^{ lastSeen = CACurrentMediaTime(); });
            usleep(limit < 1.0 ? 50000 : 250000);
            if (CACurrentMediaTime() - lastSeen > limit) { fired = YES; DMLog([NSString stringWithFormat:@"[hangwatch] the main thread has not answered for %.2f s: sampling it", limit]); DMIdleSampleEx(1.0, YES); }
        }
        if (!fired) DMLog(@"[hangwatch] done: no hang");
    });
}
static void DMIdleSampleEx(double seconds, BOOL fromHere) {
    if (!gSampleMainThread) return;
    mach_port_t main = gSampleMainThread;
    uintptr_t stackHi = gSampleStackHi, stackLo = gSampleStackLo;
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INTERACTIVE, 0), ^{
        int n = 0, total = 0, idle = 0;
        CFTimeInterval end = CACurrentMediaTime() + seconds;
        while (CACurrentMediaTime() < end && n < DM_SAMPLE_MAX) {
            usleep(2000);
            if (thread_suspend(main) != KERN_SUCCESS) break;
            arm_thread_state64_t st; mach_msg_type_number_t cnt = ARM_THREAD_STATE64_COUNT;
            if (thread_get_state(main, ARM_THREAD_STATE64, (thread_state_t)&st, &cnt) == KERN_SUCCESS) {
                int d = 0;
#if __DARWIN_OPAQUE_ARM_THREAD_STATE64   // (raw fields, only stripped: no authentication that could trap)
                void *pc = st.__opaque_pc, *lr0 = st.__opaque_lr; uintptr_t fp = (uintptr_t)st.__opaque_fp;
#else
                void *pc = (void *)st.__pc, *lr0 = (void *)st.__lr; uintptr_t fp = (uintptr_t)st.__fp;
#endif
                gSampleFrames[n][d++] = (uintptr_t)ptrauth_strip(pc, ptrauth_key_asia);
                gSampleFrames[n][d++] = (uintptr_t)ptrauth_strip(lr0, ptrauth_key_asia);
                fp = (uintptr_t)ptrauth_strip((void *)fp, ptrauth_key_asda);
                while (fp >= stackLo && fp + 16 <= stackHi && !(fp & 7) && d < DM_SAMPLE_DEPTH) {   // (only inside the main thread's stack)
                    uintptr_t *f = (uintptr_t *)fp;
                    uintptr_t next = f[0], lr = (uintptr_t)ptrauth_strip((void *)f[1], ptrauth_key_asia);
                    if (!lr) break;
                    gSampleFrames[n][d++] = lr;
                    if (next <= fp) break;
                    fp = next;
                }
                gSampleDepth[n] = d; n++;
            }
            thread_resume(main);
            total++;
        }
        NSMutableDictionary<NSString *, NSNumber *> *counts = [NSMutableDictionary dictionary];
        NSMutableDictionary<NSString *, NSNumber *> *frames = [NSMutableDictionary dictionary];   // every frame (not only the top) that shows up in busy samples
        for (int k = 0; k < n; k++) {
            NSString *top = DMSampleSym(gSampleFrames[k][0]);
            if ([top containsString:@"mach_msg_trap"] || [top containsString:@"mach_msg2_trap"]) { idle++; continue; }
            NSMutableArray *parts = [NSMutableArray array];
            NSMutableSet *seen = [NSMutableSet set];
            for (int j = 0; j < gSampleDepth[k]; j++) {
                NSString *sym = DMSampleSym(gSampleFrames[k][j]);
                if (j < 14) [parts addObject:sym];
                NSRange plus = [sym rangeOfString:@"+" options:NSBackwardsSearch];
                NSString *fn = plus.location != NSNotFound ? [sym substringToIndex:plus.location] : sym;
                if (![seen containsObject:fn]) { [seen addObject:fn]; frames[fn] = @(frames[fn].intValue + 1); }
            }
            NSString *key = [parts componentsJoinedByString:@" < "];
            counts[key] = @(counts[key].intValue + 1);
        }
        NSArray *byCount = [counts keysSortedByValueUsingComparator:^NSComparisonResult(NSNumber *a, NSNumber *b) { return [b compare:a]; }];
        NSArray *fnByCount = [frames keysSortedByValueUsingComparator:^NSComparisonResult(NSNumber *a, NSNumber *b) { return [b compare:a]; }];
        NSMutableString *out = [NSMutableString stringWithFormat:@"[sample] %.1f s: %d samples, %d idle (in mach_msg), %d busy\n", seconds, total, idle, n - idle];
        for (NSUInteger k = 0; k < MIN(fnByCount.count, (NSUInteger)60); k++) [out appendFormat:@"[sample] fn %@ x%@\n", fnByCount[k], frames[fnByCount[k]]];
        for (NSUInteger k = 0; k < MIN(byCount.count, (NSUInteger)25); k++) [out appendFormat:@"[sample] stack x%@: %@\n", counts[byCount[k]], byCount[k]];
        if (fromHere) DMLog(out); else dispatch_async(dispatch_get_main_queue(), ^{ DMLog(out); });
    });
}
// Debug (trigger idlechanges_<seconds>): which layers change while the Home Screen sits idle. CALayer's setters are hooked once, at runtime, and
// count (main thread only, real changes only) per layer class / view class for the given time; the busiest are logged.
static CFTimeInterval gChangesUntil = 0;
static NSMutableDictionary<NSString *, NSNumber *> *gChanges;
static void DMCountChange(CALayer *l, const char *what) {
    if (CACurrentMediaTime() > gChangesUntil || !pthread_main_np()) return;
    id d = l.delegate;
    NSString *owner = d ? NSStringFromClass([d class]) : @"-";
    NSString *sup = @"";
    if ([d isKindOfClass:[UIView class]]) { UIView *v = d; sup = [NSString stringWithFormat:@" in %@ < %@ (%@)", NSStringFromClass([v.superview class]), NSStringFromClass([v.superview.superview class]), NSStringFromClass([v.window class])]; }
    else if (l.superlayer) { id sd = l.superlayer.delegate; sup = [NSString stringWithFormat:@" in layer of %@", sd ? NSStringFromClass([sd class]) : NSStringFromClass([l.superlayer class])]; }
    NSString *k = [NSString stringWithFormat:@"%s %@/%@%@", what, NSStringFromClass([l class]), owner, sup];
    gChanges[k] = @(gChanges[k].intValue + 1);
}
static void (*oc_setPosition)(id, SEL, CGPoint); static void hc_setPosition(CALayer *self, SEL c, CGPoint p) { if (CACurrentMediaTime() < gChangesUntil && !CGPointEqualToPoint(self.position, p)) DMCountChange(self, "position"); oc_setPosition(self, c, p); }
static void (*oc_setBounds)(id, SEL, CGRect); static void hc_setBounds(CALayer *self, SEL c, CGRect r) { if (CACurrentMediaTime() < gChangesUntil && !CGRectEqualToRect(self.bounds, r)) DMCountChange(self, "bounds"); oc_setBounds(self, c, r); }
static void (*oc_setOpacity)(id, SEL, float); static void hc_setOpacity(CALayer *self, SEL c, float o) { if (CACurrentMediaTime() < gChangesUntil && self.opacity != o) DMCountChange(self, "opacity"); oc_setOpacity(self, c, o); }
static void (*oc_setHidden)(id, SEL, BOOL); static void hc_setHidden(CALayer *self, SEL c, BOOL h) { if (CACurrentMediaTime() < gChangesUntil && self.hidden != h) DMCountChange(self, "hidden"); oc_setHidden(self, c, h); }
static void (*oc_setTransform)(id, SEL, CATransform3D); static void hc_setTransform(CALayer *self, SEL c, CATransform3D t) { if (CACurrentMediaTime() < gChangesUntil && !CATransform3DEqualToTransform(self.transform, t)) DMCountChange(self, "transform"); oc_setTransform(self, c, t); }
static void (*oc_setContents)(id, SEL, id); static void hc_setContents(CALayer *self, SEL c, id x) { if (CACurrentMediaTime() < gChangesUntil && self.contents != x) DMCountChange(self, "contents"); oc_setContents(self, c, x); }
static void (*oc_setNeedsDisplay)(id, SEL); static void hc_setNeedsDisplay(CALayer *self, SEL c) { DMCountChange(self, "setNeedsDisplay"); oc_setNeedsDisplay(self, c); }
static void (*oc_setNeedsLayout)(id, SEL); static void hc_setNeedsLayout(CALayer *self, SEL c) { DMCountChange(self, "setNeedsLayout"); oc_setNeedsLayout(self, c); }
static void (*oc_addAnimation)(id, SEL, id, id); static void hc_addAnimation(CALayer *self, SEL c, CAAnimation *a, NSString *k) { if (CACurrentMediaTime() < gChangesUntil) DMCountChange(self, [[NSString stringWithFormat:@"addAnimation(%@ %@)", k, [a isKindOfClass:[CAPropertyAnimation class]] ? ((CAPropertyAnimation *)a).keyPath : NSStringFromClass([a class])] UTF8String]); oc_addAnimation(self, c, a, k); }
static void (*oc_setBackgroundColor)(id, SEL, CGColorRef); static void hc_setBackgroundColor(CALayer *self, SEL c, CGColorRef x) { if (CACurrentMediaTime() < gChangesUntil && !CGColorEqualToColor(self.backgroundColor, x)) DMCountChange(self, "backgroundColor"); oc_setBackgroundColor(self, c, x); }
static void (*oc_setFilters)(id, SEL, id); static void hc_setFilters(CALayer *self, SEL c, id x) { if (CACurrentMediaTime() < gChangesUntil) DMCountChange(self, "filters"); oc_setFilters(self, c, x); }
static void DMIdleChanges(double seconds) {
    static BOOL hooked; if (!hooked) {
        hooked = YES; Class L = [CALayer class];
        MSHookMessageEx(L, @selector(setPosition:), (IMP)hc_setPosition, (IMP *)&oc_setPosition);
        MSHookMessageEx(L, @selector(setBounds:), (IMP)hc_setBounds, (IMP *)&oc_setBounds);
        MSHookMessageEx(L, @selector(setOpacity:), (IMP)hc_setOpacity, (IMP *)&oc_setOpacity);
        MSHookMessageEx(L, @selector(setHidden:), (IMP)hc_setHidden, (IMP *)&oc_setHidden);
        MSHookMessageEx(L, @selector(setTransform:), (IMP)hc_setTransform, (IMP *)&oc_setTransform);
        MSHookMessageEx(L, @selector(setContents:), (IMP)hc_setContents, (IMP *)&oc_setContents);
        MSHookMessageEx(L, @selector(setNeedsDisplay), (IMP)hc_setNeedsDisplay, (IMP *)&oc_setNeedsDisplay);
        MSHookMessageEx(L, @selector(setNeedsLayout), (IMP)hc_setNeedsLayout, (IMP *)&oc_setNeedsLayout);
        MSHookMessageEx(L, @selector(addAnimation:forKey:), (IMP)hc_addAnimation, (IMP *)&oc_addAnimation);
        MSHookMessageEx(L, @selector(setBackgroundColor:), (IMP)hc_setBackgroundColor, (IMP *)&oc_setBackgroundColor);
        MSHookMessageEx(L, NSSelectorFromString(@"setFilters:"), (IMP)hc_setFilters, (IMP *)&oc_setFilters);
    }
    gChanges = [NSMutableDictionary dictionary];
    gChangesUntil = CACurrentMediaTime() + seconds;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((seconds + 0.2) * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        NSArray *keys = [gChanges keysSortedByValueUsingComparator:^NSComparisonResult(NSNumber *a, NSNumber *b) { return [b compare:a]; }];
        NSMutableString *out = [NSMutableString stringWithFormat:@"[changes] %.1f s: %lu kinds\n", seconds, (unsigned long)keys.count];
        for (NSUInteger k = 0; k < MIN(keys.count, (NSUInteger)40); k++) [out appendFormat:@"[changes] x%@ %@\n", gChanges[keys[k]], keys[k]];
        DMLog(out);
    });
}
// Debug: how many frames the render server (backboardd) draws per second (CARenderServerGetFrameCounter; 0 if it cannot be asked).
static uint32_t DMRenderFrames(void) {
    static uint32_t (*fn)(mach_port_t); static BOOL tried;
    if (!tried) { tried = YES; fn = (uint32_t (*)(mach_port_t))dlsym(RTLD_DEFAULT, "CARenderServerGetFrameCounter"); }
    return fn ? fn(MACH_PORT_NULL) : 0;
}
// Debug (trigger rsframes_<seconds>): render server frames per second over that time.
static void DMRenderFramesLog(double seconds, NSString *what) {
    uint32_t a = DMRenderFrames(); CFTimeInterval t0 = CACurrentMediaTime();
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(seconds * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        uint32_t b = DMRenderFrames();
        DMLog([NSString stringWithFormat:@"[rsframes] %@: %.1f frames/s (%u over %.1f s)", what ?: @"", (b - a) / (CACurrentMediaTime() - t0), b - a, CACurrentMediaTime() - t0]);
    });
}
// Debug (trigger idleexp_rswindows): each visible window hidden for 2.5 s in turn, render server frames counted (what keeps backboardd drawing)
static void DMIdleRenderBisect(NSUInteger i, NSArray<UIWindow *> *list) {
    if (!list) { NSMutableArray *l = [NSMutableArray array]; for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES]) [l addObject:w]; list = l; }
    if (i >= list.count) { DMLog(@"[rsframes] window bisect done"); return; }
    UIWindow *w = list[i]; BOOL was = w.hidden; w.hidden = YES;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        DMRenderFramesLog(2.0, [NSString stringWithFormat:@"without %@ (level %.0f)", NSStringFromClass([w class]), w.windowLevel]);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            w.hidden = was;
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMIdleRenderBisect(i + 1, list); });
        });
    });
}
static void DMIdleProbe(void) {
    DMLog([NSString stringWithFormat:@"[idle] a5 frame watcher %@ (%lu windows cached), clock balancer %@ (%lu visible bars), drawn watches %lu, startup watcher %@, flash recorder %@",
           gA5FrameLink ? (gA5FrameLink.paused ? @"paused" : @"RUNNING") : @"none", (unsigned long)gA5StageCache.count, gBalanceLink ? @"RUNNING" : @"none",
           (unsigned long)DMVisibleCopies().count, (unsigned long)gDrawnWatches.count, gStartupLink ? @"RUNNING" : @"none", gFlashLink ? @"RUNNING" : @"none"]);
    for (UIView *st in gA5StageCache.allObjects) DMLog([NSString stringWithFormat:@"[idle] a5 window %@: hidden %d, in a window %d, alpha %.2f", DMStageBundle(st), st.hidden, st.window != nil, st.alpha]);
    for (CADisplayLink *l in gDMLinks.keyEnumerator.allObjects) if (!l.paused)
        DMLog([NSString stringWithFormat:@"[idle] display link RUNNING (%ld fps wanted) target? added by: %@", (long)l.preferredFramesPerSecond, [gDMLinks objectForKey:l]]);
    int lines = 0;
    for (UIWindow *w in [UIWindow allWindowsIncludingInternalWindows:YES onlyVisibleWindows:YES])
        DMIdleProbeLayer(w.layer, [NSString stringWithFormat:@"%@ (level %.0f)", NSStringFromClass([w class]), w.windowLevel], 0, &lines);
    DMLog([NSString stringWithFormat:@"[idle] %d animated layers listed", lines]);
    __block int wakes = 0, timers = 0, sources = 0;
    static double stamps[1200]; __block int nStamps = 0;
    CFRunLoopObserverRef obs = CFRunLoopObserverCreateWithHandler(kCFAllocatorDefault, kCFRunLoopAfterWaiting | kCFRunLoopBeforeTimers | kCFRunLoopBeforeSources, true, 0,
        ^(CFRunLoopObserverRef o, CFRunLoopActivity a) {
            if (a == kCFRunLoopAfterWaiting) { wakes++; if (nStamps < 1200) stamps[nStamps++] = CACurrentMediaTime(); }
            else if (a == kCFRunLoopBeforeTimers) timers++; else sources++;
        });
    CFRunLoopAddObserver(CFRunLoopGetMain(), obs, kCFRunLoopCommonModes);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        CFRunLoopRemoveObserver(CFRunLoopGetMain(), obs, kCFRunLoopCommonModes);
        CFRelease(obs);
        DMLog([NSString stringWithFormat:@"[idle] main run loop over 3 s: %d wakes (%.0f/s), %d passes, %d source passes", wakes, wakes / 3.0, timers, sources]);
        int hist[8] = {0}; const double edges[7] = {2, 6, 7.5, 9.5, 15, 18, 40};   // ms: <2, 2-6, 6-7.5, 7.5-9.5 (120 Hz), 9.5-15, 15-18 (60 Hz), 18-40, >40
        for (int k = 1; k < nStamps; k++) { double d = (stamps[k] - stamps[k - 1]) * 1000.0; int b = 0; while (b < 7 && d >= edges[b]) b++; hist[b]++; }
        DMLog([NSString stringWithFormat:@"[idle] gaps between wakes (ms): <2 %d, 2-6 %d, 6-7.5 %d, 7.5-9.5 %d, 9.5-15 %d, 15-18 %d, 18-40 %d, >40 %d", hist[0], hist[1], hist[2], hist[3], hist[4], hist[5], hist[6], hist[7]]);
    });
}
#endif
// Native windows (NativeWindow.h): a touch in one makes it active, one in an app makes them inactive; the active one has the hardware keys first.
// Pointer scrolling over a native window (iPad 2, iPadOS 16, 1 Oct): the scroll events reach SpringBoard's -sendEvent:, but the window server
// names SpringBoard's system gesture window (above our layer) as the one under the pointer, so UIKit gave the scroll to that window and Finder's
// list never scrolled with a mouse. Here the event is taken to the scroll view under the pointer directly, with the event's own delta (the
// user's scroll direction applied), turned from the screen's fixed orientation into the list's, kept within its content.
static BOOL DMNativeScrollEvent(UIEvent *event) {
    UIWindow *layer = gNativeLayer;
    SEL locSel = @selector(locationInView:), adjSel = NSSelectorFromString(@"_adjustedAcceleratedDeltaInView:");
    if (!layer || layer.alpha < 0.01 || ![event respondsToSelector:locSel] || ![event respondsToSelector:adjSel]) return NO;
    // (faded out for the App Switcher / App Library / an icon menu: the scroll is theirs -- logic test H1, 1 Oct)
    if (gNativeAway || !gNativeRotator || gNativeRotator.alpha < 0.01 || !gNativeRotator.userInteractionEnabled) return NO;
    // (only when UIKit won't deliver it itself, and only in the one case seen: the window server named SpringBoard's system gesture window (iPad 2).
    //  Where it names our layer -- the M1's trackpad on iOS 15 scrolled Finder fine -- UIKit's own scrolling, with its momentum, is left alone; where
    //  it names anything else (Notification Center, Control Center, the switcher, a menu window) the scroll is that window's.)
    SEL wsSel = NSSelectorFromString(@"_windowServerHitTestWindow");
    if (![event respondsToSelector:wsSel]) return NO;
    UIWindow *named = ((id (*)(id, SEL))objc_msgSend)(event, wsSel);
    if (named == layer || (named && ![NSStringFromClass([named class]) isEqualToString:@"_UISystemGestureWindow"])) return NO;
    CGPoint p = ((CGPoint (*)(id, SEL, id))objc_msgSend)(event, locSel, layer);
    CGPoint sp = [layer convertPoint:p toCoordinateSpace:layer.screen.coordinateSpace];
    if (DMNativeWindowTaking(sp, layer.windowLevel)) return NO;   // (a window of SpringBoard's above the layer takes that point: the Dock, a menu, an alert)
    UIView *hit = DMNativeLayerHitTest(layer, @selector(hitTest:withEvent:), p, nil);
    if (!hit) return NO;
    BOOL inWindow = NO;
    for (UIView *v = hit; v && v != layer; v = v.superview) if ([v isKindOfClass:[DMNativeWindow class]]) { inWindow = YES; break; }
    if (!inWindow && !(gOverlay && [gOverlay isDescendantOfView:layer]) && !layer.rootViewController.presentedViewController) return NO;   // (a Finder item menu in the layer, or its modal)
    UIScrollView *sv = nil;
    for (UIView *v = hit; v && v != layer; v = v.superview) if ([v isKindOfClass:[UIScrollView class]] && ((UIScrollView *)v).scrollEnabled) { sv = (UIScrollView *)v; break; }
    if (!sv) return YES;   // (over a native window (or its modal) but nothing scrollable there: the scroll is ours, nothing moves)
    // (the delta in the LAYER's space, turned into the scroll view's by UIKit's own point conversion: the layer keeps its portrait bounds and the
    //  content is turned inside it, and a delta asked for the scroll view itself came out sideways -- 3,0 for a wheel turn, iPad 2 1 Oct)
    CGVector dl = ((CGVector (*)(id, SEL, id))objc_msgSend)(event, adjSel, layer);
    // (the delta comes in the screen's FIXED (hardware, portrait) orientation: a vertical wheel turn read 9.7,0 in landscape on the iPad 2, the
    //  layer and the list sharing one space -- so it is turned from the fixed coordinate space into the list's)
    id<UICoordinateSpace> fixed = layer.screen.fixedCoordinateSpace;
    CGPoint a = [sv convertPoint:CGPointZero fromCoordinateSpace:fixed], b = [sv convertPoint:CGPointMake(dl.dx, dl.dy) fromCoordinateSpace:fixed];
    CGVector d = CGVectorMake(b.x - a.x, b.y - a.y);
    if (!isfinite(d.dx) || !isfinite(d.dy)) return YES;   // (a NaN offset would throw in CALayer: SpringBoard -- logic test L1)
    UIEdgeInsets in = sv.adjustedContentInset;
    CGFloat maxY = MAX(-in.top, sv.contentSize.height + in.bottom - sv.bounds.size.height), maxX = MAX(-in.left, sv.contentSize.width + in.right - sv.bounds.size.width);
    CGPoint o = sv.contentOffset;
    o.y = MIN(maxY, MAX(-in.top, o.y - d.dy));
    o.x = MIN(maxX, MAX(-in.left, o.x - d.dx));
    if (!CGPointEqualToPoint(o, sv.contentOffset)) [sv setContentOffset:o animated:NO];
#if DEBUG
    { static CFTimeInterval last = 0; if (DMTestFlag("/tmp/macstatusbar-debug") && CACurrentMediaTime() - last > 0.5) { last = CACurrentMediaTime();
        DMLog([NSString stringWithFormat:@"[scroll] %@ delta %.1f,%.1f (layer %.1f,%.1f) -> offset %@", NSStringFromClass([sv class]), d.dx, d.dy, dl.dx, dl.dy, NSStringFromCGPoint(o)]); } }
#endif
    return YES;
}
%group DMNativeHooks
%hook SpringBoard
- (void)sendEvent:(UIEvent *)event {
    if ((long)event.type == 10 && gNativeLayer && !gNativeLayer.hidden && DMNativeScrollEvent(event)) return;   // (UIEventTypeScroll: a mouse wheel / trackpad over a native window)
    if (event.type == UIEventTypeTouches && ((gNativeLayer && !gNativeLayer.hidden) || gDesktop))
        for (UITouch *t in event.allTouches) if (t.phase == UITouchPhaseBegan) {
            if (gNativeLayer && !gNativeLayer.hidden) DMNativeTouchBegan(t);
            if (gDesktop) [gDesktop dm_touchBegan:t];   // (a touch away from the desktop's icons ends its selection, as a click elsewhere on a Mac)
            break;
        }
    if (event.type == UIEventTypeTouches && gDesktop) [gDesktop dm_event:event];   // (a finger that opened a desktop icon's menu and moves on: the icon's drag)
    %orig;
}
- (void)pressesBegan:(NSSet<UIPress *> *)presses withEvent:(UIPressesEvent *)event {
    if (gNativeActive) for (UIPress *p in presses) if (DMNativeHandlePress(p)) return;
    if (!gNativeActive && gDesktop && [gDesktop dm_hasKeys]) for (UIPress *p in presses) if (p.key && [gDesktop dm_handleKey:p.key]) return;   // (the desktop was clicked last)
    %orig;
}
%end
// An app icon tapped (the Dock, the Home Screen) while a native window is active: that app comes forward, as a Dock click does on a Mac -- also the
// app that was already in front when Finder became active, which the front-app watcher (DMNativeTick) can't see change (M1 30 Sep: Notes' Dock
// icon left Finder in front).
%hook SBIconView
- (void)_handleTap {
    if (gNativeActive) {
        NSString *b = nil; @try { b = [[self valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {}
        if ([b isKindOfClass:[NSString class]] && b.length) { DMLog([NSString stringWithFormat:@"[native] app icon tapped (%@): native windows inactive", b]); DMNativeSetActive(nil); }
    }
    %orig;
}
%end
%end
// Native windows and Stage Manager (iPadOS 16). SpringBoard's system gestures see every touch -- also the ones UIKit gives our layer -- through
// the system gesture window, and Stage Manager's window gestures (SBFluidSwitcherGestureManager) only ask what window CARD lies under the
// finger, knowing nothing of a window above the cards: a tap in Finder brought the app under it forward (tapToBringItemContainerForward),
// a drag in Finder over an app's top edge moved that app (_unpinSplitViewApplicationGestureRecognizer) and cancelled Finder's touch, a
// corner resize resized the app below (iPad 2, 30 Sep). A touch that starts on a native window is that window's: those gestures never receive
// it. The multi-finger pinch to Home stays (it works anywhere). The Home / App Switcher swipes start at the screen's bottom edge, which a native
// window never covers (it stays above the Dock) -- a swipe starting on Finder next to the Dock opened the App Switcher, so they are left out too.
static BOOL DMNativeSystemGestureStays(id manager, UIGestureRecognizer *g) {
    static const char *keep[] = { "_fluidScrunchGestureRecognizer", "_indirectFloatingAppScrunchGestureRecognizer" };
    for (size_t i = 0; i < sizeof(keep) / sizeof(keep[0]); i++) {
        Ivar iv = class_getInstanceVariable(object_getClass(manager), keep[i]);
        if (iv && object_getIvar(manager, iv) == g) return YES;
    }
    return NO;
}
%group DMNativeSysGestures   // (only where SpringBoard has these: see %ctor)
%hook SBFluidSwitcherGestureManager
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)g shouldReceiveTouch:(UITouch *)touch {
    DMNativeWindow *w = DMNativeWindowForTouch(touch, NULL);
    if (w && !DMNativeSystemGestureStays(self, g)) {
        static __weak UITouch *told;
        if (told != touch && DMTestFlag("/tmp/macstatusbar-debug")) { told = touch; DMLog([NSString stringWithFormat:@"[native] a touch on %@: Stage Manager's window gestures (%@...) left out", w.title, g.name ?: NSStringFromClass([g class])]); }
        return NO;
    }
    return %orig;
}
// The screen-edge pulls (the Stage Manager strip on the left, Slide Over on the right, Home at the bottom) near a native window's title bar or
// resize corner: that drag is the window's -- a zoomed Finder's left resize corner lies 10 pt from the screen edge, and the edge pull took the
// drag (iPad 2 30 Sep). Elsewhere in a native window the edge pulls stay as they are.
- (BOOL)grabberTongue:(id)tongue shouldReceiveTouch:(UITouch *)touch {
    BOOL chrome = NO;
    if (DMNativeWindowForTouch(touch, &chrome) && chrome) {
        if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog(@"[native] a drag on a native window's title bar / corner: the screen-edge pull left out");
        return NO;
    }
    return %orig;
}
%end
// An inactive native window sits behind the app windows; where no app window covers it, the switcher's full-screen content view still answered the
// hit test (it lies above the layer): the first touch on Finder only made it active, the tap / drag / button itself went nowhere (iPad 2 30 Sep).
// There the switcher window lets the touch through to the native window, as a Mac's first click on a window both activates it and acts.
%hook SBMainSwitcherWindow
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    UIView *h = %orig;
    static BOOL inside = NO;
    UIWindow *me = (UIWindow *)self;
    if (!h || !event || inside || !gNativeLayer || gNativeLayer.hidden || gNativeLayer.windowLevel >= me.windowLevel) return h;
    if (h != me && h != me.rootViewController.view && ![NSStringFromClass([h class]) isEqualToString:@"SBFluidSwitcherContentView"]) return h;   // (an app window: its own)
    inside = YES;
    DMNativeWindow *w = DMNativeWindowAtScreenPoint([me convertPoint:point toCoordinateSpace:(me.screen ?: [UIScreen mainScreen]).coordinateSpace]);
    inside = NO;
    return w ? nil : h;
}
%end
// The Dock's window answers touches in a band ~18 pt ABOVE its platter (its swipe-up area): a resize from Finder's bottom corner next to the Dock
// went to the Dock and opened the App Switcher, and the bottom of a Finder window reaching the Dock could not be tapped (iPad 2 30 Sep). Above the
// platter, where an active native window is, the touch is the window's; the Dock keeps its platter, its icons (magnified ones reach higher) and
// the Downloads panel (the Dock window is raised over everything while it is open).
%hook SBFloatingDockWindow
- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
    UIView *h = %orig;
    UIWindow *me = (UIWindow *)self;
    if (!h || !event || !gNativeActive || me.windowLevel > 1000.0) return h;
    for (UIView *v = h; v && v != me; v = v.superview) if ([NSStringFromClass([v class]) containsString:@"IconView"]) return h;
    UIView *platter = nil;
    NSMutableArray<UIView *> *todo = [NSMutableArray arrayWithObject:me];
    Class pc = objc_getClass("SBFloatingDockPlatterView");
    for (int depth = 0; depth < 6 && todo.count && !platter && pc; depth++) {
        NSMutableArray *next = [NSMutableArray array];
        for (UIView *v in todo) { if ([v isKindOfClass:pc]) { platter = v; break; } [next addObjectsFromArray:v.subviews]; }
        todo = next;
    }
    if (!platter || platter.hidden) return h;
    id<UICoordinateSpace> scr = (me.screen ?: [UIScreen mainScreen]).coordinateSpace;
    CGPoint sp = [me convertPoint:point toCoordinateSpace:scr];
    if (sp.y >= CGRectGetMinY([platter convertRect:platter.bounds toCoordinateSpace:scr])) return h;
    return DMNativeWindowAtScreenPoint(sp) ? nil : h;
}
%end
%end
// Settings > Mac Status Bar > Finder: on, Finder's windows, menus, Go menu places and Dock icon are there and its hooks are installed (once, at
// the start or when switched on -- no respring either way); off, every Finder window closes and nothing opens one (the hooks, if installed, only
// look at native windows: with none they do nothing). The Dock hides its Finder icon itself (it reads the same switch).
static BOOL DMFinderPrefOn(void) {
    CFPreferencesAppSynchronize(MSB_DOMAIN);
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("finderEnabled"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    BOOL on = !v || (CFGetTypeID(v) == CFBooleanGetTypeID() ? CFBooleanGetValue(v) : (CFGetTypeID(v) == CFNumberGetTypeID() ? [(__bridge NSNumber *)v boolValue] : YES));
    if (v) CFRelease(v);
    return on;
}
static void DMFinderApplyPref(void) {
    static BOOL hooked = NO;
    BOOL on = DMFinderPrefOn() && !DMCtorSkip("finder");
    if (on && !hooked) {
        hooked = YES;
        %init(DMNativeHooks);   // (native windows: touches and keys, NativeWindow.h)
        if ([objc_getClass("SBFluidSwitcherGestureManager") instancesRespondToSelector:@selector(gestureRecognizer:shouldReceiveTouch:)]) %init(DMNativeSysGestures);
        DMFinderDockInit();     // (the Dock's Finder icon: its taps, and Finder's window count for its dot)
    }
    DMDesktopApplyPref();   // (Show Desktop Icons: the same notification -- the tick puts the desktop up or takes it away)
    if (on == gFinderOn) return;
    gFinderOn = on;
    DMLog([NSString stringWithFormat:@"[finder] Finder %@", on ? @"on" : @"off: its windows close"]);
    if (!on) for (DMNativeWindow *w in [gNativeWindows copy]) { [w close]; [gNativeWindows removeObjectIdenticalTo:w]; }
    if (!on) DMNativeApplyLevel();
}
#include "StockBar.h"   // "Use Stock Status Bar": the start that runs instead of everything below
// Untested iPadOS (17+ with Enable Anyway, common/Diag.h): which of our hooked methods do not exist on this iOS -- a hook on a missing method is
// simply skipped, so these are features that silently do nothing. Only the parts running in SpringBoard (statusbar/, dock/). Names only.
#include "../common/HookList.h"
#include "../common/Diag.h"
static void DMDiagHooks(void) {
    if (!MSBDDiagEnabled()) return;
    NSMutableArray *noClass = [NSMutableArray array], *noMethod = [NSMutableArray array];
    NSUInteger checked = 0;
    for (size_t i = 0; i < sizeof(kMSBDHookList) / sizeof(kMSBDHookList[0]); i++) {
        const char *file = kMSBDHookList[i][3];
        if (strncmp(file, "statusbar/", 10) != 0 && strncmp(file, "dock/", 5) != 0) continue;
        checked++;
        const char *cn = DMSBNameC(kMSBDHookList[i][0]);   // (a status bar hook: the class it really went on -- 17+: SystemStatusUI's)
        Class c = objc_getClass(cn);
        NSString *name = [NSString stringWithFormat:@"%s%s[%s %s]", kMSBDHookList[i][2], "", cn, kMSBDHookList[i][1]];
        if (!c) { if (![noClass containsObject:@(cn)]) [noClass addObject:@(cn)]; continue; }
        SEL sel = sel_registerName(kMSBDHookList[i][1]);
        BOOL has = kMSBDHookList[i][2][0] == '+' ? [c respondsToSelector:sel] : [c instancesRespondToSelector:sel];
        if (!has) [noMethod addObject:name];
    }
    NSOperatingSystemVersion v = [NSProcessInfo processInfo].operatingSystemVersion;
    MSBDDiagWrite(@"Hooks", [NSString stringWithFormat:@"iPadOS %ld.%ld.%ld: %lu hooks checked\nmissing methods (%lu): %@\nmissing classes (%lu): %@",
        (long)v.majorVersion, (long)v.minorVersion, (long)v.patchVersion, (unsigned long)checked,
        (unsigned long)noMethod.count, [noMethod componentsJoinedByString:@", "], (unsigned long)noClass.count, [noClass componentsJoinedByString:@", "]]);
    // (the status bar's own record: once the bar has had time to lay out, and once more later -- DMSBDiagFlush)
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(20.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSBDiagFlush(); });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(90.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSBDiagFlush(); });
}
// ---- Stage Manager as the engine: the parts that act (DMSMEngine) ----
// The window's own "..." menu action (SBTopAffordanceViewController: closeAction, removeFromSetAction = Minimize, maximizationAction = Enter Full
// Screen, moveToDisplayAction, ...). NO when that window or action is not there (the caller then does what it did before).
// Windows we minimized (Stage Manager keeps each in a hidden stage of its own): never "the desktop" when an app joins it -- logic test F2: a
// minimized window came back with the next app launched from the Home Screen. A window leaves the set when it is opened again or closed.
static NSMutableSet<NSString *> *gSMMinimized;
static BOOL DMSMIsMinimized(NSString *bundle) { return bundle && [gSMMinimized containsObject:bundle]; }
static void DMSMSetMinimized(NSString *bundle, BOOL on) {
    if (!bundle.length) return;
    if (!gSMMinimized) gSMMinimized = [NSMutableSet set];
    if (on) [gSMMinimized addObject:bundle]; else [gSMMinimized removeObject:bundle];
}
static BOOL DMSMWindowAction(NSString *bundleID, NSString *name) {
    BOOL close = [name isEqualToString:@"close"], minimize = [name isEqualToString:@"removeFromSet"];
    id own = (close || minimize) ? DMSMStageOf(bundleID) : nil;
    BOOL last = own && [DMSMStageItemsMap(own) count] == 1 && own == DMSMFrontStage() && DMFrontApp();
    id vc = DMSMTopAffordanceFor(bundleID);
    id action = vc ? DMCall(vc, [name stringByAppendingString:@"Action"]) : nil;
    DMLog([NSString stringWithFormat:@"[smengine] %@ on %@: %@%@", name, bundleID, [action isKindOfClass:[UIAction class]] ? [(UIAction *)action title] : @"not available", last ? @" (the desktop's last window)" : @""]);
    // The desktop's last window: the Home Screen FIRST, as on a Mac. Closing or minimizing it while it was shown made Stage Manager bring up an
    // older hidden stage (a minimized window, a full-screen app sent away), which we then joined and sent home 0.35 s later -- a visible flash,
    // and the closed window stayed a hidden one (logic test SM-7 / F2b). Minimizing the last window IS going Home (its stage stays, hidden); a
    // close runs once the Home Screen is up, on a stage no longer shown, so Stage Manager has nothing to bring up.
    if (last && minimize) {
        DMSMSetMinimized(bundleID, YES);
        DMLog([NSString stringWithFormat:@"[smengine] %@: the desktop's last window minimized -- the Home Screen", bundleID]);
        DMMinimize();
        return YES;
    }
    if (![action isKindOfClass:[UIAction class]]) return NO;
    if (last && close) {
        DMLog([NSString stringWithFormat:@"[smengine] %@: the desktop's last window closes -- the Home Screen first", bundleID]);
        DMMinimize();
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            DMSMSetMinimized(bundleID, NO);
            // (a window's own Close does nothing once its stage is no longer shown -- tested 07:10: the stage stayed and came back with the next
            // app. Its stage holds only this window: it is taken out of the switcher, the way a close ends; the app is left running, as with Close)
            id st = DMSMStageOf(bundleID);
            BOOL alone = NO; NSDictionary *m = DMSMStageItemsMap(st);
            for (id it in m) if ([DMSMItemBundle(it) isEqual:bundleID]) alone = m.count == 1;
            id sw = DMSwitcherController();
            if (alone && [sw respondsToSelector:@selector(_deleteAppLayoutsMatchingBundleIdentifier:)]) {
                ((void (*)(id, SEL, id))objc_msgSend)(sw, @selector(_deleteAppLayoutsMatchingBundleIdentifier:), bundleID);
                DMLog([NSString stringWithFormat:@"[smengine] %@ closed from the Home Screen (its stage taken out)", bundleID]);
            } else {
                DMSMRunAction(action, vc);
                DMLog([NSString stringWithFormat:@"[smengine] %@ closed from the Home Screen (its own Close)", bundleID]);
            }
        });
        return YES;
    }
    DMSMSetMinimized(bundleID, minimize);
    DMSMRunAction(action, vc);
    return YES;
}
// ---- displays (the TV): every Stage Manager request goes to the display its window is on ----------------------------------------------------------
// Each stage knows its display (SBAppLayout -preferredDisplayIdentity). Every request here used to name the iPad (initWithApplicationForMainDisplay:,
// -requestTransitionWithBuilder:) and the most recent stage: a window on the TV touched, moved or laid out went back to the iPad.
static id DMSMIdentityOfScreen(UIScreen *sc) {
    id cfg = [sc respondsToSelector:NSSelectorFromString(@"displayConfiguration")] ? DMCall(sc, @"displayConfiguration") : nil;
    return cfg ? DMCall(cfg, @"identity") : nil;
}
static BOOL DMSMIsMainIdentity(id identity) {
    return !identity || [identity isEqual:DMSMIdentityOfScreen([UIScreen mainScreen])];
}
// Force quit of an app whose window is in a stage NOT on screen (another Mac Switcher desktop, the stage left for the Home Screen): its own Close
// needs the window shown (no affordance: "close ... not available"), and killing the process left its item in that stage -- Stage Manager brought
// the window back, the app started again, when the stage came (iPad 2, 4 Oct). Its item is taken out of each such stage in the switcher's model
// (Apple's -appLayoutByRemovingItemInLayoutRole:, the model's replaceAppLayout:withAppLayout:, as DMSMFlattenStages does) -- only on the iPad's own
// display, never the stage on screen, and only when Stage Manager's result is whole (one window fewer, it gone, a primary kept); a stage where it
// is alone is deleted by the force quit's own clean-up. Returns how many stages lost it.
static int DMSMTakeOutOfHiddenStages(NSString *bundle) {
    if (!DMSMEngine() || !bundle.length) return 0;
    // (iPadOS 16.0-16.3 have no -appLayoutByRemovingItemInLayoutRole: -- new in 16.4, an optional check row since 1.3.3: the item stays in its hidden
    //  stage there, as before; asking anyway would only record the missing method as a runtime failure in the verdict)
    if (!DMSMRowPassed("SBAppLayout", "appLayoutByRemovingItemInLayoutRole:")) {
        DMLog([NSString stringWithFormat:@"[smengine] force quit %@: stages not on screen are left as they are here (no -appLayoutByRemovingItemInLayoutRole: before iPadOS 16.4)", bundle]);
        return 0;
    }
    id shown = DMFrontApp() ? DMSMFrontStage() : nil;
    int n = 0;
    for (id al in [DMSMRecentStages() copy]) {
        if ((shown && [al isEqual:shown]) || !DMSMIsMainIdentity(DMSMStageDisplayIdentity(al))) continue;
        NSDictionary *m = DMSMStageItemsMap(al);
        if (m.count < 2) continue;
        id mine = nil;
        for (id it in m) if ([DMSMItemBundle(it) isEqualToString:bundle]) mine = it;
        long long role = 0;
        if (!mine || !DMSMStageRoleOfItem(al, mine, &role) || role <= 0) continue;
        id next = DMSMStageWithoutRole(al, role);
        NSDictionary *nm = next ? DMSMStageItemsMap(next) : nil;
        BOOL primary = NO, still = NO;
        for (id it in nm) { long long r = 0; if (DMSMStageRoleOfItem(next, it, &r) && r == 1) primary = YES; if ([DMSMItemBundle(it) isEqualToString:bundle]) still = YES; }
        if (!next || next == al || nm.count + 1 != m.count || still || !primary) {
            DMLog([NSString stringWithFormat:@"[smengine] force quit %@: left in its hidden stage (Stage Manager's stage without it was not whole: %lu of %lu windows, primary %d)", bundle, (unsigned long)nm.count, (unsigned long)m.count, primary]);
            continue;
        }
        if (DMSMReplaceStage(al, next)) { n++; DM_FEATURE_MARK("sm-force-quit-hidden-stage"); DMLog([NSString stringWithFormat:@"[smengine] force quit %@: taken out of a stage not on screen (role %lld; %lu window(s) stay in it)", bundle, role, (unsigned long)nm.count]); }
    }
    return n;
}
static id DMSMStageOf(NSString *bundle) {   // (the most recent stage holding that app, on whichever display)
    for (id al in DMSMRecentStages())
        for (id it in DMSMStageItemsMap(al)) if ([DMSMItemBundle(it) isEqual:bundle]) return al;
    return DMSMFrontStage();
}
static id DMSMFrontStageOnDisplay(id identity) {   // (the most recent stage on that display)
    for (id al in DMSMRecentStages()) {
        id i = DMSMStageDisplayIdentity(al);
        if (DMSMIsMainIdentity(identity) ? DMSMIsMainIdentity(i) : [i isEqual:identity]) return al;
    }
    return nil;
}
static id DMSMNewEntity(NSString *bundle, id identity) {   // (an app entity for that display)
    id app = DMSMApplication(bundle);
    if (!app) return nil;
    if (!DMSMIsMainIdentity(identity)) {
        id smc = DMCall(objc_getClass("SBSceneManagerCoordinator"), @"sharedInstance");
        SEL forDisp = NSSelectorFromString(@"sceneManagerForDisplayIdentity:");
        id provider = [smc respondsToSelector:forDisp] && DMSMSigOK(smc, forDisp, DMSMSigObjObj(), "sceneManagerForDisplayIdentity:") ? ((id (*)(id, SEL, id))objc_msgSend)(smc, forDisp, identity) : nil;
        if (provider) return DMSMEntityNew(app, provider, identity);
    }
    return DMSMEntityNew(app, nil, nil);
}
static id DMSMEntityIn(id stage, NSString *bundle) {   // (the entity of that app's window in its stage, on the stage's display -- Apple's own helper)
    id identity = DMSMStageDisplayIdentity(stage);
    if (!DMSMIsMainIdentity(identity))
        for (id it in DMSMStageItemsMap(stage))
            if ([DMSMItemBundle(it) isEqual:bundle]) { id e = DMSMEntityForItem(it, identity); if (e) return e; }
    return DMSMNewEntity(bundle, identity);
}
// ---- a window's place as Stage Manager reads it, fitted into the desktop of its screen (SMFit.h, Mac test tools/test-smfit.sh) ------------------------
// The card area of a screen's desktop (u: DMSMUsableAreaFor..., the window area under the menu bar, above the Dock): under our title bar as well;
// behindDock: down to the screen's bottom edge (a window the user dragged behind the Dock keeps that place, gSMBehindDock).
static CGRect DMSMCardDesk(CGRect u, CGSize scr, BOOL behindDock) {
    CGFloat top = CGRectGetMinY(u) + kSMBarH, bottom = behindDock ? scr.height : CGRectGetMaxY(u);
    return CGRectMake(CGRectGetMinX(u), top, CGRectGetWidth(u), bottom - top);
}
// A window's attributes made to fit the screen of `identity` as it is NOW: the size read in points of its OWN reference rectangle (Stage Manager reads
// a size as a fraction of the reference kept with the attributes, not of the screen -- a window made in portrait keeps portrait's after a turn, so
// it came back 737 pt tall into the 649 pt landscape desktop and Stage Manager kept its bottom above the Dock by pushing its top 40 pt above the
// screen: no title bar, no traffic lights, iPad 2 3 Oct), at most the desktop, all of it inside (DMSMFitInDesk: when too big, top and left edges
// win), handed over as fractions of THIS screen. Full-screen attributes (policy 2), sizes Stage Manager works out itself and attributes that fit
// already are returned as they are (no rewrite). bundle: for the log.
static id DMSMAttrsFitScreen(id attrs, id identity, BOOL behindDock, NSString *bundle) {
    if (!DMSMIsAttrs(attrs) || DMSMPolicyOf(attrs) == 2) return attrs;
    DMSMAttributedSize sz; CGPoint c;
    if (!DMSMAttrAttributedSize(attrs, &sz) || !DMSMAttrCenter(attrs, &c)) return attrs;
    CGSize scr = CGSizeZero;
    CGRect u = DMSMUsableAreaForIdentity(identity, &scr);
    if (scr.width < 1.0 || scr.height < 1.0 || CGRectIsEmpty(u) || CGRectIsNull(u)) return attrs;
    CGSize pts = DMSMFitSizeInPoints(sz.normalizedSize, sz.referenceBounds, sz.type, scr), was = pts;
    if (pts.width <= 0 || pts.height <= 0) return attrs;   // (a size Stage Manager works out itself: its grid caps it, _nearestGridSizeForSize)
    CGPoint cp = CGPointMake(c.x * scr.width, c.y * scr.height), wasC = cp;
    if (!DMSMFitInDesk(&pts, &cp, DMSMCardDesk(u, scr, behindDock))) return attrs;
    DMSMAttributedSize ns = sz;
    ns.normalizedSize = CGSizeMake(pts.width / scr.width, pts.height / scr.height); ns.type = 0;
    ns.referenceBounds = CGRectMake(0, 0, scr.width, scr.height);
    id a = DMSMAttrWith(attrs, ns, CGPointMake(cp.x / scr.width, cp.y / scr.height), DMSMPolicyOf(attrs), -1);
    if (!a) return attrs;   // (refused: as it was -- Stage Manager's constraint still keeps the top edge inside, DMSMConstrainEdges16)
    DM_FEATURE_MARK("sm-fit-screen");
    DMLog([NSString stringWithFormat:@"[sm] %@: window fitted to the screen as it is now: %.0f x %.0f pt at %.0f, %.0f (size %@ of reference %@) -> %.0f x %.0f pt at %.0f, %.0f",
        bundle ?: @"?", was.width, was.height, wasC.x - was.width / 2.0, wasC.y - was.height / 2.0, NSStringFromCGSize(sz.normalizedSize), NSStringFromCGRect(sz.referenceBounds),
        pts.width, pts.height, cp.x - pts.width / 2.0, cp.y - pts.height / 2.0]);
    return a;
}
// Every window a plan names (@[entity, role, attributes] each) fitted to the screen it is asked on -- the one place where our requests and launch
// plans hand windows to Stage Manager (DMSMRequestOn below and the launch plans of DMSMJoinDesktop): a
// window coming back from full screen, from another desktop or from a hidden stage after a turn is never asked for bigger than the desktop.
static NSArray<NSArray *> *DMSMPlanFitted(id identity, NSArray<NSArray *> *plan) {
    NSMutableArray *out = nil;
    for (NSUInteger i = 0; i < plan.count; i++) {
        NSArray *row = plan[i];
        if (![row isKindOfClass:[NSArray class]] || row.count != 3) return plan;   // (malformed: the plan check refuses it as it is)
        id b = DMCall(DMCall(row[0], @"application"), @"bundleIdentifier");
        NSString *bundle = [b isKindOfClass:[NSString class]] ? b : nil;
        id a = DMSMAttrsFitScreen(row[2], identity, bundle && [gSMBehindDock containsObject:bundle], bundle);
        if (a == row[2]) continue;
        if (!out) out = [plan mutableCopy];
        out[i] = @[row[0], row[1], a];
    }
    return out ?: plan;
}
// The iPad turned: the stages NOT on screen (minimized windows, the stage left for the Home Screen) keep the other shape's sizes too, and Stage
// Manager brings them back by itself later -- a minimized Settings opened again in landscape came back at portrait's 461 x 870 pt, its bottom and
// resize corners past the screen's edge. Their windows are fitted to the new shape now, in the app switcher's model only (no request): iPadOS
// 16.7.7 changes the stage in place and hands the same object back; a new object is put in its place (replaceAppLayout:withAppLayout:, as when
// another engine takes over, DMSMFlattenStages). onScreen: the stage whose windows the turn handler asked for itself.
static void DMSMFitHiddenStages(id onScreen) {
    if (!DMSMEngine()) return;
    int n = 0;
    for (id al in [DMSMRecentStages() copy]) {
        if ((onScreen && [al isEqual:onScreen]) || !DMSMIsMainIdentity(DMSMStageDisplayIdentity(al))) continue;
        NSDictionary *m = DMSMStageItemsMap(al);
        id st = al; BOOL fitted = NO;
        for (id it in m) {
            NSString *b = DMSMItemBundle(it);
            id f = DMSMAttrsFitScreen(m[it], nil, b && [gSMBehindDock containsObject:b], b);
            if (f == m[it]) continue;
            id ns = DMSMStageWithAttrs(st, f, it);
            if (ns) { st = ns; fitted = YES; }
        }
        if (fitted && (st == al || DMSMReplaceStage(al, st))) n++;   // (the same object: changed in place, nothing to replace)
    }
    if (n) { DM_FEATURE_MARK("sm-turn-fit-hidden"); DMLog([NSString stringWithFormat:@"[sm] the iPad turned: %d stage(s) not on screen fitted to the new shape (in the model)", n]); }
}
// A workspace transition on the display of `identity` naming these windows (DMSMRequestPlan, SMEngineAPI.h: the whole plan checked first).
static BOOL DMSMRequestOn(id identity, NSString *label, NSArray<NSArray *> *plan, NSSet<NSNumber *> *allowed, id frontEntity) {
    return DMSMRequestPlan(identity, DMSMIsMainIdentity(identity), label, DMSMPlanFitted(identity, plan), allowed, frontEntity);
}
// The window a transition brings forward is also the stage's frontmost -- the one with keyboard focus, which Stage Manager credits the next
// touches to. Only the order (lastInteractionTime) was set before: after a return from full screen Settings was in front but Clock kept the focus,
// and the next drag in Settings bumped Clock. (DMSMCtxMarkFrontmost, passed as each plan's front entity)
// A new stage with the app full screen (from the Home Screen, apps not opening as windows). template: any window's attributes, re-made full screen.
static BOOL DMSMOpenFullScreenStage(NSString *bundle, id template, id identity) {
    DMSMAttributedSize sz;
    if (!template || !DMSMAttrAttributedSize(template, &sz)) return NO;
    sz.normalizedSize = CGSizeMake(1.0, 1.0); sz.type = 3;
    id a = DMSMAttrWith(template, sz, CGPointMake(0.5, 0.5), 2, -1);
    id entity = DMSMNewEntity(bundle, identity);
    if (!a || !entity) return NO;
    if (!DMSMRequestOn(identity, nil, @[@[entity, @1, a]], [NSSet setWithObject:@1], entity)) return NO;
    DMLog([NSString stringWithFormat:@"[smengine] %@ opened full screen (apps do not open as windows)", bundle]);
    return YES;
}
// An app opened from the Home Screen or the Dock while a stage is on screen joins that stage as another window (like opening an app on a Mac),
// instead of Stage Manager's own "a new stage for every app". Layout roles: 1 primary, 2 side, 5 "additional side 0", 6 the next (study notes).
// NO (the normal launch) when no stage is on screen, the app is already on the stage (the tap brings it forward), or the stage is full.
static const long kSMNewWindowRoles[] = {1, 2, 5, 6};   // (the roles a window joining a stage takes, first free first -- read on 16.7.7)
static NSSet<NSNumber *> *DMSMNewWindowRoles(void) { return [NSSet setWithObjects:@1, @2, @5, @6, nil]; }
static BOOL gSMSkipFitAsk = NO;   // (the launch after the Fit question: not asked again)
static BOOL DMSMAddToStage(NSString *bundle, UIView *from) {   // from: the icon tapped (its display: the iPad or the TV)
    DM_FEATURE_MARK("sm-add-to-stage");
    if (!DMSMEngine() || !bundle.length || DMTestFlag("/tmp/msb-sm-noadd")) return NO;
    BOOL windowed = DMWindowedLaunchOn();   // (Window menu > Open Apps as Windows: off = the app opens full screen, in front of the windows)
    id identity = DMSMIdentityOfScreen(from.window.screen ?: [UIScreen mainScreen]);
    BOOL main = DMSMIsMainIdentity(identity);
    SBApplication *front = DMFrontApp();
    id al = DMSMFrontStageOnDisplay(identity);   // (the stage on the display the icon was tapped on)
    NSDictionary *map = DMSMStageItemsMap(al);
    NSMutableSet *inStage = [NSMutableSet set];
    for (id item in map) { NSString *b = DMSMItemBundle(item); if (b) [inStage addObject:b]; }
    if (!main && !al) return NO;   // (nothing on the TV yet: Stage Manager opens the app there itself)
    if (!main) {   // (the TV's stage only when it is on the TV now -- after a respring the TV desktop is empty while the old stage is still on record, and an
                   //  app added to that stage never appeared: then Stage Manager opens the app on the TV itself)
        BOOL shown = NO;
        for (id it in map) {
            UIView *card = DMSMCardFor(DMSMItemBundle(it));
            if (card && [DMSMIdentityOfScreen(card.window.screen) isEqual:identity]) { shown = YES; break; }
        }
        if (!shown) return NO;
    }
    if (main && !front) {   // (the Home Screen: a new stage, as usual -- full screen when apps do not open as windows)
        if (windowed || !map.count) return NO;
        return DMSMOpenFullScreenStage(bundle, map[map.allKeys.firstObject], identity);
    }
    if (main && ![inStage containsObject:[front bundleIdentifier]]) return NO;
    if ([inStage containsObject:bundle]) {   // (already in the stage: forward; full screen it stays)
        DMSMBringToFront(bundle);
        return YES;
    }
    // Fit to Window with two tiles: the third window is asked about BEFORE its app starts (the other engines' order, DMPromptBeforeLaunch). Launched
    // first, it opened while the question was up and could end up behind the two tiles, needing another tap in the Dock (iPad 2, 29 Sep).
    if (main && windowed && !gSMSkipFitAsk && DMFitEnabled() && map.count == 2 && gSMFitSlots.count == 2 && ![gSMFreeWindows containsObject:bundle]
        && !(gSidePromptCtx && ![gSidePromptCtx[@"decided"] boolValue])) {
        NSString *leftB = nil, *rightB = nil;
        for (NSString *b in inStage) { NSString *slot = gSMFitSlots[b]; if ([slot isEqualToString:@"left"]) leftB = b; else if ([slot isEqualToString:@"right"]) rightB = b; }
        if (leftB && rightB) {
            DM_FEATURE_MARK("sm-fit-ask-before-launch");
            DMLog([NSString stringWithFormat:@"[sm] Fit to Window: asking where %@ goes before launching it", bundle]);
            NSString *newB = [bundle copy];
            DMPromptForSideApply(nil, newB, leftB, rightB, ^(NSString *side) {
                if ([side isEqualToString:@"none"]) {   // No Fit: it opens free, in the middle; the two tiles stay
                    if (!gSMFreeWindows) gSMFreeWindows = [NSMutableSet set];
                    [gSMFreeWindows addObject:newB];
                } else if ([side isEqualToString:@"left"]) gSMFitSlots = [@{newB: @"topleft", leftB: @"bottomleft", rightB: @"right"} mutableCopy];
                else if ([side isEqualToString:@"right"]) gSMFitSlots = [@{newB: @"topright", rightB: @"bottomright", leftB: @"left"} mutableCopy];
                else gSMFitSlots = nil;   // (no choice: the default arrangement, newest first)
                gSMSkipFitAsk = YES;
                BOOL added = DMSMAddToStage(newB, from);
                gSMSkipFitAsk = NO;
                if (!added) DMOpenApp(newB);   // (not added to the stage: the normal launch, joined by DMSMJoinDesktop)
                // (once its window is there: tiled with the others, or centred when it is free)
                __block int tries = 0;
                __block void (^wait)(void);
                void (^w)(void) = ^{
                    if ([DMSMWindowBundles() containsObject:newB]) {
                        if ([gSMFreeWindows containsObject:newB]) DMSMApplyLayoutsIn(@{newB: @"center"}, DMSMFrontStage());
                        else DMSMFitTick(YES);
                        wait = nil; return;
                    }
                    if (++tries > 40) { wait = nil; return; }
                    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), wait);
                };
                wait = w;
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), wait);
            });
            return YES;
        }
    }
    // (layout roles read from a stage: 1 primary, 2 side, 5 "additional side 0", 6 the next; 4 is the centre window -- turned into an additional side)
    // (the first role no window of the stage has -- a table indexed by the window count assumed Stage Manager's roles are contiguous, C7)
    long role = 0;
    if (map.count < 4) {
        NSMutableSet *used = [NSMutableSet set];
        for (id it in map) { long long r = 0; if (!DMSMStageRoleOfItem(al, it, &r)) return NO; [used addObject:@(r)]; }   // (roles unreadable: the normal launch)
        for (size_t i = 0; i < sizeof(kSMNewWindowRoles) / sizeof(kSMNewWindowRoles[0]); i++) if (![used containsObject:@(kSMNewWindowRoles[i])]) { role = kSMNewWindowRoles[i]; break; }
    }
    if (!role) return NO;   // (full: the launch joins the desktop in DMSMJoinDesktop, the oldest window left out)
    id entity = DMSMNewEntity(bundle, identity);
    if (!entity) return NO;
    // In front, like a new window on a Mac: the newest interaction time of the stage + 1 (Stage Manager orders windows by it), cascaded down and
    // right from the front window (Stage Manager's auto-layout still has the last word on the exact spot).
    id frontAttrs = nil; long newest = 0;
    for (id item in map) {
        long t = DMSMAttrTimeOr(map[item], 0);
        if (t >= newest) { newest = t; frontAttrs = map[item]; }
    }
    id attrs = DMSMJoinAttributes(bundle, frontAttrs, windowed, newest, al);   // (its own last place, or cascaded above the Dock; full screen when apps do not open as windows)
    if (!attrs) return NO;   // (refused: the normal launch -- DMSMJoinDesktop then decides)
    if (!DMSMRequestOn(identity, @"MSBDStageAdd", @[@[entity, @(role), attrs]], DMSMNewWindowRoles(), entity)) { DMLog([NSString stringWithFormat:@"[smengine] adding %@ refused", bundle]); return NO; }
    if (!windowed) DMSMDismissOtherFullScreen(al, bundle);
    DMLog([NSString stringWithFormat:@"[smengine] %@ added to the stage of %@ (role %ld, %lu window(s) there before)%@", bundle, main ? [front bundleIdentifier] : @"the TV", role, (unsigned long)map.count, main ? @"" : @" [external display]"]);
    return YES;
}
// The stage on screen and one of its windows: its item, attributes and layout role (1 primary, 2 side, 4.. additional sides). nil when not there.
// (the stage on the iPad's own screen: the most recent stage overall can be the TV's -- menu bar, lights and full-screen checks are the iPad's, C3)
static id DMSMFrontStage(void) {
    id main = DMSMFrontStageOnDisplay(DMSMIdentityOfScreen([UIScreen mainScreen]));
    return main ?: [DMSMRecentStages() firstObject];
}
static id DMSMItemFor(id stage, NSString *bundle, id *attrsOut) {
    NSDictionary *map = DMSMStageItemsMap(stage);
    for (id item in map) if ([DMSMItemBundle(item) isEqual:bundle]) { if (attrsOut) *attrsOut = map[item]; return item; }
    return nil;
}
// Asks for a window of the stage on screen again, with these attributes (attrs), or with its current ones given sizing policy `policy` (>= 0), through
// the workspace transition an app launch uses (the app in its layout role; setRequestedLayoutAttributes:forEntity:). YES when requested.
static BOOL DMSMRequestWindow(NSString *bundle, id attrs, long policy) {
    id stage = DMSMStageOf(bundle), current = nil;
    id item = DMSMItemFor(stage, bundle, &current);
    if (!item) return NO;
    long long role = DMSMRoleOr(stage, item, 0);
    if (role <= 0) role = 1;
    if (!attrs) attrs = current;
    if (policy >= 0) attrs = DMSMAttrWithSizingPolicy(attrs, policy);
    id entity = DMSMEntityIn(stage, bundle);   // (on the display the stage is on: the TV's windows stay there)
    if (!entity || !attrs) return NO;
    if (!DMSMRequestOn(DMSMStageDisplayIdentity(stage), nil, @[@[entity, @(role), attrs]], nil, entity)) { DMLog([NSString stringWithFormat:@"[smengine] request for %@ refused", bundle]); return NO; }
    DMLog([NSString stringWithFormat:@"[smengine] %@ requested again (role %lld): %@", bundle, role, [[attrs description] stringByReplacingOccurrencesOfString:@"\n" withString:@" "]]);
    return YES;
}
// Zoom that toggles, like a Mac's green button: Stage Manager's own Zoom (maximizationAction) only maximizes, and a maximized window asked for again
// keeps its size. So the attributes a window had before Zoom are kept, and the second press puts them back into the stage (the switcher model's
// replaceAppLayout:withAppLayout:) and asks for the window again. A window maximized before we saw it gets the size of another, un-maximized window.
static NSMutableDictionary<NSString *, id> *gSMPreZoom;
static void DMSMForgetApp(NSString *bundle) { if (bundle.length) [gSMPreZoom removeObjectForKey:bundle]; }
// Full screen INSIDE the stage (as with our other engines: the full-screen app is one of the stage's items, maximized over the whole screen; the
// other windows stay in the stage, in front of or behind it by interaction order) -- not Stage Manager's "Enter Full Screen", which moved the app
// into a stage of its own where no window could come over it.
// The attributes a window joining the desktop gets: its own last window size/place if it has one (a window restored from minimize came back at
// the front window's size, logic test SM-8), else cascaded from the front window, kept ABOVE the Dock (new windows reached under it, SM-2);
// full screen when apps do not open as windows. newest: the stage's newest interaction time (the window goes in front).
static id DMSMJoinAttributes(NSString *bundle, id frontAttrs, BOOL windowed, long newest, id stage) {   // stage: the one it joins (its screen and Dock)
    id own = nil;
    id ownStage = DMSMStageOf(bundle);
    NSDictionary *om = DMSMStageItemsMap(ownStage);
    for (id it in om) if ([DMSMItemBundle(it) isEqual:bundle]) own = om[it];
    if (own && DMSMPolicyOf(own) == 2 && windowed && gSMPreZoom[bundle]) own = gSMPreZoom[bundle];   // (full screen by our green button: its window size from before)
    id base = (own && (DMSMPolicyOf(own) != 2 || !windowed)) ? own : (frontAttrs ?: own);   // (no front window: its own attributes, re-made a window below)
    if (!base) {   // (nothing to start from -- an app with no stage left, on an empty desktop: new attributes, the default window below)
        base = DMSMAttrNew();
        if (base) DMLog([NSString stringWithFormat:@"[smjoin] %@: new window attributes (no earlier window)", bundle]);
    }
    if (!base) return nil;
    // (what Stage Manager has, read through the checked wrappers: a size or center it can't give sensibly counts as none -- the default window)
    DMSMAttributedSize sz = { CGSizeZero, CGRectZero, 0 };
    CGPoint c = CGPointMake(0.5, 0.48);
    BOOL haveSize = DMSMAttrAttributedSize(base, &sz), haveCenter = DMSMAttrCenter(base, &c);
    if (!haveCenter) c = CGPointMake(0.5, 0.48);
    long policy = windowed ? 0 : 2;
    if (!windowed) { sz.normalizedSize = CGSizeMake(1.0, 1.0); sz.type = 3; c = CGPointMake(0.5, 0.5); }
    else {
        BOOL dflt = !haveSize || DMSMPolicyOf(base) == 2 || sz.type == 3 || sz.normalizedSize.width <= 0 || sz.normalizedSize.height <= 0;
        BOOL cascaded = !dflt && base != own && haveCenter;
        CGPoint from = c;   // (the front window's center, before the cascade)
        if (cascaded) c = CGPointMake(c.x + 0.05, c.y + 0.06);   // (cascaded from the front window)
        // Worked out in points of the screen it joins and handed over as fractions of THAT screen, its reference set to it. Stage Manager reads a size
        // as a fraction of the reference rectangle kept WITH the attributes, and this used to set the reference only when there was none: the 0.6 x 0.72
        // default, meant for the screen as it is, kept the full-screen attributes' portrait reference in landscape and came out 461 x 737 pt in the
        // 649 pt desktop -- its top 40 pt above the screen, no title bar or traffic lights (iPad 2, 3 Oct: Settings back from full screen with green).
        // Its own size and a front window's (cascade) are read through their own reference (SMFit.h). Inside the usable desktop of the screen it joins:
        // under the menu bar and title bar, above that screen's Dock (logic test F8: a window joining a TV stage was clamped with the iPad's).
        CGSize scr = CGSizeZero;
        CGRect u = DMSMUsableAreaForStage(stage, &scr);
        if (scr.width > 0 && scr.height > 0) {
            CGSize pts = dflt ? CGSizeMake(0.6 * scr.width, 0.72 * scr.height) : DMSMFitSizeInPoints(sz.normalizedSize, sz.referenceBounds, 0, scr);
            CGPoint cp = dflt ? CGPointMake(0.5 * scr.width, 0.48 * scr.height) : CGPointMake(c.x * scr.width, c.y * scr.height);
            if (!CGRectIsEmpty(u) && !CGRectIsNull(u)) DMSMFitInDesk(&pts, &cp, DMSMCardDesk(u, scr, NO));   // (a desktop too small to hold a window -- never seen -- leaves it as it is)
            // The cascade steps on until the new window is clear of every window of the desktop, not only the front one (SMFit.h DMSMCascadeClear):
            // a front window in the bottom-right corner sent the cascade back onto it (Clock, Books and Maps on one spot), and a window at the cascade
            // spot was covered exactly (App Store on Settings, 1.3.5 logic test M1).
            CGPoint fromPt = CGPointMake(from.x * scr.width, from.y * scr.height);
            if (cascaded && !CGRectIsEmpty(u) && !CGRectIsNull(u)) {
                CGPoint taken[16]; int nTaken = 0;
                taken[nTaken++] = fromPt;
                NSDictionary *sm = DMSMStageItemsMap(stage);
                for (id it in sm) {
                    CGPoint oc;
                    if (nTaken < 16 && ![DMSMItemBundle(it) isEqual:bundle] && DMSMAttrCenter(sm[it], &oc)) taken[nTaken++] = CGPointMake(oc.x * scr.width, oc.y * scr.height);
                }
                int stepTaken = DMSMCascadeClear(fromPt, CGSizeMake(0.05 * scr.width, 0.06 * scr.height), DMSMCardDesk(u, scr, NO), taken, nTaken, &pts, &cp);
                if (stepTaken != 0) DMLog([NSString stringWithFormat:@"[smjoin] %@: the cascade spot was taken -- %@", bundle, stepTaken == 99 ? @"no clear spot, left at the first one" : [NSString stringWithFormat:@"step %d (%@)", abs(stepTaken), stepTaken > 0 ? @"down and right" : @"up and left"]]);
            }
            sz.normalizedSize = CGSizeMake(pts.width / scr.width, pts.height / scr.height);
            sz.referenceBounds = CGRectMake(0, 0, scr.width, scr.height);
            c = CGPointMake(cp.x / scr.width, cp.y / scr.height);
        } else if (dflt) { sz.normalizedSize = CGSizeMake(0.6, 0.72); c = CGPointMake(0.5, 0.48); }
        sz.type = 0;
    }
    return DMSMAttrWith(base, sz, c, policy, MAX(0L, newest + 1));   // (nil if any part is refused: never half-made attributes)
}
// One full-screen app at a time, as with our other engines (iOS): another app going full screen in the stage sends the previous one away
// (minimized out of the stage, like a full-screen app left for another).
static void DMSMDismissOtherFullScreen(id stage, NSString *keep) {
    NSDictionary *map = DMSMStageItemsMap(stage);
    for (id it in map) {
        NSString *b = DMSMItemBundle(it);
        if (b.length && ![b isEqualToString:keep] && DMSMPolicyOf(map[it]) == 2) {
            DMLog([NSString stringWithFormat:@"[smengine] %@ goes full screen: the previous full-screen app %@ leaves the stage", keep, b]);
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.35 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSMWindowAction(b, @"removeFromSet"); });
        }
    }
}
static BOOL DMSMSetFullScreenInStage(NSString *bundle, BOOL front) {
    id stage = DMSMStageOf(bundle), attrs = nil;   // (its own stage, on whichever display)
    id item = DMSMItemFor(stage, bundle, &attrs);
    DMSMAttributedSize sz;
    if (!item || !attrs || !DMSMAttrAttributedSize(attrs, &sz)) return NO;
    sz.normalizedSize = CGSizeMake(1.0, 1.0); sz.type = 3;   // (3 = full width and height)
    long newest = 0;
    if (front) for (id it in DMSMStageItemsMap(stage)) newest = MAX(newest, (long)DMSMAttrTimeOr(DMSMStageItemsMap(stage)[it], 0));
    id a = DMSMAttrWith(attrs, sz, CGPointMake(0.5, 0.5), 2, front ? newest + 1 : -1);
    if (!a) return NO;
    id newStage = DMSMStageWithAttrs(stage, a, item);
    if (newStage) DMSMReplaceStage(stage, newStage);
    DMSMDismissOtherFullScreen(stage, bundle);
    BOOL ok = DMSMRequestWindow(bundle, a, -1);
    // (seen once on the iPad 2 with the TV on: the request asked for maximized and Stage Manager kept the window at snap-to-grid; not reproduced
    //  since -- if it comes back, the log has the state it happened in)
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        id st = DMSMStageOf(bundle), now = nil;
        if (!DMSMItemFor(st, bundle, &now) || DMSMPolicyOf(now) == 2) return;
        DMLog([NSString stringWithFormat:@"[smengine] full screen for %@ NOT taken: now %@ on %@ (%lu windows), most recent stage on %@", bundle,
            [[now description] stringByReplacingOccurrencesOfString:@"\n" withString:@" "], DMSMStageDisplayIdentity(st),
            (unsigned long)[DMSMStageItemsMap(st) count], DMSMStageDisplayIdentity([DMSMRecentStages() firstObject])]);
    });
    return ok;
}
static long DMSMPolicyOf(id attrs) {
    return (long)DMSMPolicyOr(attrs, 0);
}
static NSString *DMSMFullScreenBundle(void) {   // (the stage's full-screen app, if it has one)
    NSDictionary *map = DMSMStageItemsMap(DMSMFrontStage());
    for (id it in map) if (DMSMPolicyOf(map[it]) == 2) return DMSMItemBundle(it);
    return nil;
}
static BOOL DMSMFrontIsFullScreen(void) {   // (the front window is the full-screen app: its menu bar lights, inward green arrows)
    NSString *front = DMSMFrontWindowBundle(), *full = DMSMFullScreenBundle();
    return front.length && [front isEqualToString:full];
}
static BOOL DMSMWindowsBehindFullScreen(void) { return DMSMFrontIsFullScreen(); }
// Bring All to Front / Send All to Back: the full-screen app's place in the stage's order -- behind every window, or in front of them all.
static BOOL DMSMRequestStageOrder(id stage, NSDictionary *timeByItem, id frontItem);
static void DMSMWindowsForward(BOOL forward) {
    DM_FEATURE_MARK("sm-send-all-to-back");
    // One request that names every window of the stage with its new place in the order (logic review L1: a model change plus one window asked
    // for again moved nothing, or only that one window, over the full-screen app).
    id stage = DMSMFrontStage();
    NSString *full = DMSMFullScreenBundle();
    NSDictionary *map = DMSMStageItemsMap(stage);
    if (!full.length || map.count < 2) return;
    long lo = LONG_MAX, hi = 0; id fullItem = nil, topItem = nil; long topT = -1;
    for (id it in map) {
        long t = DMSMAttrTimeOr(map[it], 0);
        lo = MIN(lo, t); hi = MAX(hi, t);
        if ([DMSMItemBundle(it) isEqualToString:full]) fullItem = it;
        else if (t > topT) { topT = t; topItem = it; }
    }
    if (!fullItem) return;
    NSMutableDictionary *times = [NSMutableDictionary dictionary];
    if (forward) {   // Bring All to Front: the full-screen app behind every window, the top window in front
        times[fullItem] = @(MAX(0L, lo - 1));
        if (topItem) times[topItem] = @(hi + 1);
    } else times[fullItem] = @(hi + 1);   // Send All to Back: the full-screen app over them all
    DMSMRequestStageOrder(stage, times, forward ? topItem : fullItem);
}
// Every window of the stage asked for in one transition, in its role with its attributes -- interaction times changed where given -- and the
// front one marked frontmost.
static BOOL DMSMRequestStageOrder(id stage, NSDictionary *timeByItem, id frontItem) {
    NSDictionary *map = DMSMStageItemsMap(stage);
    NSMutableArray *plan = [NSMutableArray array]; id frontEntity = nil;
    for (id it in map) {
        id a = map[it];
        NSNumber *t = timeByItem[it];
        if (t) a = DMSMAttrWithLastInteractionTime(a, t.longLongValue);
        long long role = DMSMRoleOr(stage, it, 0);
        id e = DMSMEntityIn(stage, DMSMItemBundle(it));
        if (!e || !a || role <= 0) return NO;
        [plan addObject:@[e, @(role), a]];
        if (it == frontItem) frontEntity = e;
    }
    if (!DMSMRequestOn(DMSMStageDisplayIdentity(stage), nil, plan, nil, frontEntity)) { DMLog(@"[sm] order refused"); return NO; }
    DMLog([NSString stringWithFormat:@"[sm] order of %lu windows requested", (unsigned long)plan.count]);
    return YES;
}
static BOOL DMSMToggleZoom(NSString *bundle) {
    DM_FEATURE_MARK("sm-zoom-toggle");
    id stage = DMSMStageOf(bundle), attrs = nil;   // (its own stage, on whichever display)
    id item = DMSMItemFor(stage, bundle, &attrs);
    if (!item || !attrs) return NO;
    long long policy = 0;
    if (!DMSMAttrSizingPolicy(attrs, &policy)) return NO;
    if (!gSMPreZoom) gSMPreZoom = [NSMutableDictionary dictionary];
    if (policy != 2) {   // (2 = maximized) green = native full screen (our standard); its old place and size are kept for the way back
        gSMPreZoom[bundle] = attrs;
        return DMSMSetFullScreenInStage(bundle, YES);   // (full screen inside the stage: the other windows can come over it, as with our other engines)
    }
    id back = gSMPreZoom[bundle];   // (its own size before full screen; none known: the default below -- copying another window's size made
                                    //  SofaScore a 1024 x 283 strip, logic test SM-5)
    // (its place from before full screen made to fit the screen as it is NOW: the iPad may have turned while it was full screen -- a window made in
    //  portrait came back 737 pt tall into landscape, its title bar above the screen, iPad 2 3 Oct)
    if (back) back = DMSMAttrsFitScreen(back, DMSMStageDisplayIdentity(stage), [gSMBehindDock containsObject:bundle], bundle);
    if (!back) {   // (a window size of its own, between the menu bar and the Dock -- the same rule as every window joining the desktop)
        long t = (long)DMSMAttrTimeOr(attrs, 1);
        back = DMSMJoinAttributes(bundle, attrs, YES, t - 1, stage);
        DMLog([NSString stringWithFormat:@"[smengine] zoom back on %@: no size of its own known, a default window", bundle]);
    }
    if (!back) return NO;
    {   // (in front, where the user is: the attributes from before full screen carried their old interaction time, so the window came back behind
        //  windows opened meanwhile while keeping the keyboard focus -- logic review L2)
        NSDictionary *m = DMSMStageItemsMap(stage);
        long newest = 0; for (id it in m) newest = MAX(newest, (long)DMSMAttrTimeOr(m[it], 0));
        back = DMSMAttrWithLastInteractionTime(back, newest + 1);
    }
    if (!back) return NO;
    id newStage = DMSMStageWithAttrs(stage, back, item);
    BOOL replaced = newStage && DMSMReplaceStage(stage, newStage);
    [gSMPreZoom removeObjectForKey:bundle];
    DMLog([NSString stringWithFormat:@"[smengine] zoom back on %@: model %@ replaced", bundle, replaced ? @"" : @"NOT"]);
    DMSMRequestWindow(bundle, back, -1);
    return YES;
}
// Moves / resizes a window of the stage on screen: its attributes changed in the stage model (replaceAppLayout:withAppLayout:), then the window
// asked for again (DMSMRequestWindow) so the stage lays itself out with it. center: normalized (NaN = keep); size: normalized (0 = keep).
static BOOL DMSMSetWindowGeometry(NSString *bundle, CGPoint center, CGSize size) {
    id stage = DMSMStageOf(bundle), attrs = nil;   // (its own stage, on whichever display)
    id item = DMSMItemFor(stage, bundle, &attrs);
    if (!item || !attrs) return NO;
    id a = attrs;
    if (!isnan(center.x)) a = DMSMAttrWithCenter(a, center);   // (refused when not finite / far outside the screen: nothing moves)
    if (a && size.width > 0) {
        DMSMAttributedSize sz;
        if (!DMSMAttrAttributedSize(a, &sz)) return NO;
        sz.normalizedSize = size; sz.type = 0;
        // (sizes are fractions of the reference rectangle kept with the window: the screen its stage is on -- a window moved to the TV still carried
        //  the iPad's, and "half the TV" came out as half the iPad's width)
        CGSize scr = CGSizeZero; DMSMUsableAreaForStage(stage, &scr);
        if (scr.width > 0) sz.referenceBounds = CGRectMake(0, 0, scr.width, scr.height);
        a = DMSMAttrWithSize(a, sz);
        a = a ? DMSMAttrWithSizingPolicy(a, DMTestFlag("/tmp/msb-sm-policy1") ? 1 : 0) : nil;
    }
    if (!a) return NO;
    id newStage = DMSMStageWithAttrs(stage, a, item);
    if (!newStage || !DMSMReplaceStage(stage, newStage)) return NO;
    return DMSMRequestWindow(bundle, a, -1);
}
// ---- Stage Manager engine: our Mac window chrome on every window (title bar, traffic lights, drag to move) ----
// A Stage Manager window is a card (SBFluidSwitcherItemContainer) in SBMainSwitcherWindow. Our title bar is a plain view added to the card ABOVE its
// content (y -24), laid out when the card lays itself out (no timer); the stage keeps the room for it (_statusBarHeight). The card's own hit test
// is widened to the bar. Hidden when the window is full screen or scaled (the App Switcher).
@interface SBFluidSwitcherItemContainer : UIView
@end
@interface SBTopAffordanceDotsView : UIButton
@end
@interface SBReusableSnapshotItemContainer : UIView
@end
static NSString *DMSMCardBundle(UIView *card) {   // "card:<bundle id>:<scene id>"
    NSString *ident = card.accessibilityIdentifier;
    if (![ident hasPrefix:@"card:"]) return nil;
    NSArray *p = [ident componentsSeparatedByString:@":"];
    return p.count > 1 ? p[1] : nil;
}
static void DMSMBringToFront(NSString *bundle) {   // (newest interaction time in the stage -> in front, keyboard focus with it)
    id stage = DMSMStageOf(bundle), attrs = nil;   // (its own stage, on whichever display)
    if (!DMSMItemFor(stage, bundle, &attrs)) return;
    NSDictionary *map = DMSMStageItemsMap(stage);
    long long newest = 0; for (id item in map) newest = MAX(newest, DMSMAttrTimeOr(map[item], 0));
    long long mine = 0;
    if (!DMSMAttrLastInteractionTime(attrs, &mine) || mine >= newest) return;
    id a = DMSMAttrWithLastInteractionTime(attrs, newest + 1);
    if (a) DMSMRequestWindow(bundle, a, -1);
}
@interface DMSMTitleBar : UIView
@property (nonatomic, copy) NSString *bundle;
@property (nonatomic, strong) UILabel *title;
@property (nonatomic, strong) NSArray<UIButton *> *lights;
@property (nonatomic, weak) UIView *card;
@end
static CFTimeInterval gSMDragUntil = 0;   // (a title-bar drag in progress, and 1 s after: the stage area reaches the screen bottom, _stageAreaForModel)
@implementation DMSMTitleBar
- (instancetype)initWithFrame:(CGRect)f {
    if ((self = [super initWithFrame:f])) {
        self.layer.cornerRadius = kSMCornerR; self.layer.cornerCurve = kCACornerCurveContinuous;
        self.layer.maskedCorners = kCALayerMinXMinYCorner | kCALayerMaxXMinYCorner;
        self.backgroundColor = [UIColor colorWithDynamicProvider:^UIColor *(UITraitCollection *t) { return t.userInterfaceStyle == UIUserInterfaceStyleDark ? [UIColor colorWithRed:0.110 green:0.110 blue:0.118 alpha:1] : [UIColor colorWithWhite:0.965 alpha:1]; }];   // (the top of most apps: #1C1C1E dark, #F6F6F6 light -- no band between bar and window)
        _title = [UILabel new];
        _title.font = [UIFont systemFontOfSize:13.0 weight:UIFontWeightSemibold];
        _title.textColor = [UIColor secondaryLabelColor];
        _title.textAlignment = NSTextAlignmentCenter;
        _title.hidden = YES;   // (no app name in the title bar, as with every engine: the menu bar says which app it is)
        [self addSubview:_title];
        NSMutableArray *ls = [NSMutableArray array];
        for (int i = 0; i < 3; i++) {
            UIButton *b = [UIButton buttonWithType:UIButtonTypeCustom];
            b.tag = i;
            UIView *dot = DMMakeLightDot(i, NO, NULL);
            dot.center = CGPointMake(10.0, 10.0);
            [b addSubview:dot];
            [b addTarget:self action:@selector(dm_light:) forControlEvents:UIControlEventTouchUpInside];
            b.pointerInteractionEnabled = YES;
            [self addSubview:b]; [ls addObject:b];
        }
        _lights = ls;
        UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:self action:@selector(dm_pan:)];
        [self addGestureRecognizer:pan];
        UITapGestureRecognizer *tap = [[UITapGestureRecognizer alloc] initWithTarget:self action:@selector(dm_tap:)];
        [self addGestureRecognizer:tap];
        __weak DMSMTitleBar *weakSelf = self;   // (grey on an inactive window, symbols on hover or press: the shared light behaviour)
        NSMutableArray *dots = [NSMutableArray array];
        for (UIButton *b in ls) [dots addObject:b.subviews.firstObject];
        DMLightGroupAttach(self, ls, dots, ^NSString *{ return weakSelf.bundle; });
    }
    return self;
}
- (void)layoutSubviews {
    [super layoutSubviews];
    CGFloat w = self.bounds.size.width;
    for (UIButton *b in _lights) b.frame = CGRectMake(8.0 + b.tag * 20.0, (kSMBarH - 20.0) / 2.0, 20.0, 20.0);
    _title.frame = CGRectMake(72.0, 0, MAX(0, w - 144.0), kSMBarH);   // (no light refresh here: every frame of a resize, logic review P1 -- the
}                                                                     //  lights follow front changes and card changes, DMSMChrome)
- (void)dm_updateLights {
    BOOL front = [_bundle isEqualToString:DMSMFrontWindowBundle()];
    [objc_getAssociatedObject(self, kLightGroupKey) apply];
    _title.textColor = front ? [UIColor labelColor] : [UIColor secondaryLabelColor];
}
- (void)dm_light:(UIButton *)b {
    DMLog([NSString stringWithFormat:@"[smchrome] %@ light %ld", _bundle, (long)b.tag]);
    if (b.tag == 0) DMSMWindowAction(_bundle, @"close");
    else if (b.tag == 1) DMSMWindowAction(_bundle, @"removeFromSet");
    else DMSMToggleZoom(_bundle);
}
- (void)dm_tap:(UITapGestureRecognizer *)g { DMSMBringToFront(_bundle); }
- (void)dm_pan:(UIPanGestureRecognizer *)g {
    // (the drag's end is handled first, whatever became of the window: a failed drag, or one whose window went away meanwhile, left the area at
    //  full height for an hour -- logic review L4)
    if (g.state == UIGestureRecognizerStateFailed || ((g.state == UIGestureRecognizerStateEnded || g.state == UIGestureRecognizerStateCancelled) && (!_card || !_card.superview)))
        gSMDragUntil = 0;
    UIView *card = _card; UIView *sup = card.superview;
    if (!card || !sup) return;
    CGPoint t = [g translationInView:sup];
    if (g.state == UIGestureRecognizerStateBegan) { gSMDragUntil = CACurrentMediaTime() + 3600.0; DMSMBringToFront(_bundle); }
    if (g.state == UIGestureRecognizerStateChanged) card.transform = CGAffineTransformMakeTranslation(t.x, t.y);
    if (g.state == UIGestureRecognizerStateEnded || g.state == UIGestureRecognizerStateCancelled) {
        gSMDragUntil = CACurrentMediaTime() + 1.0;
        {   // (put behind the Dock by hand, or not: recorded now, not guessed later from sizes -- logic review R2)
            UIScreen *scn = card.window.screen ?: [UIScreen mainScreen];
            CGRect onScreen = [card convertRect:card.bounds toCoordinateSpace:scn.coordinateSpace];
            NSNumber *dock = gSMDockHeightBySize[NSStringFromCGSize(scn.bounds.size)];
            CGFloat line = scn.bounds.size.height - (dock ? dock.doubleValue : 117.0) - 2.0;
            if (!gSMBehindDock) gSMBehindDock = [NSMutableSet set];
            if (_bundle.length) { if (CGRectGetMaxY(onScreen) + t.y > line + 4.0) [gSMBehindDock addObject:_bundle]; else [gSMBehindDock removeObject:_bundle]; }
        }
        CGPoint c = CGPointMake(card.center.x + t.x, card.center.y + t.y);
        CGSize b = sup.bounds.size;
        card.transform = CGAffineTransformIdentity;
        card.center = c;   // (in place at once; the stage then lays itself out there)
        if (b.width > 0 && b.height > 0) DMSMSetWindowGeometry(_bundle, CGPointMake(c.x / b.width, c.y / b.height), CGSizeZero);
        DMLog([NSString stringWithFormat:@"[smchrome] %@ moved by %@", _bundle, NSStringFromCGPoint(t)]);
    }
}
@end
static NSHashTable *gSMBars;   // (our title bars: their lights follow the front window)
static UIView *DMSMCardFor(NSString *bundle) {   // (the card of that app's window on screen, from our title bars: no view walk)
    for (DMSMTitleBar *bar in gSMBars) {
        UIView *card = bar.card;
        if (card.window && !card.window.hidden && card.alpha > 0.01 && [DMSMCardBundle(card) isEqualToString:bundle]) return card;
    }
    return nil;
}
static NSArray<NSString *> *DMSMWindowBundles(void) {
    NSMutableOrderedSet<NSString *> *out = [NSMutableOrderedSet orderedSet];
    for (DMSMTitleBar *bar in gSMBars) {
        UIView *card = bar.card;
        NSString *b = card ? DMSMCardBundle(card) : nil;
        if (b && card.window && !card.window.hidden && card.alpha > 0.01 && !DMSMCardIsFullSize(card)) [out addObject:b];   // (windows only: not a full-screen app)
    }
    return out.array;
}
// For the Dock's running dots (RunningIndicator.m, via dlsym): the apps with a window or a full-screen card showing in the Stage Manager engine.
// After a respring Stage Manager puts the windows back before iPadOS has started their apps again (iPad 2, 2 Oct: Messages and Sileo on screen,
// no process), so "running" alone left those Dock icons without a dot. Other engines: nil (their windows are the running apps').
// The one force quit, for ForceQuitMenu's row in the app icons' menus too (it finds this with dlsym): the app's window closed the way its window engine
// does it first -- with the Stage Manager engine only that window leaves its stage, also from a stage not on screen -- then the app killed and its
// switcher card removed where it is alone. ForceQuitMenu killed the app and deleted every layout holding it: every other window of the Stage
// Manager desktop went with it (1.3.5 logic test H1, iPad 2: Maps and Clock lost with a Settings force quit from its icon).
__attribute__((visibility("default"))) void MSBDForceQuitApp(NSString *bundleID) { DM_FEATURE_MARK("force-quit-one-path"); DMForceQuitBundle(bundleID); }
__attribute__((visibility("default"))) NSSet<NSString *> *MSBDAppsWithWindows(void) {
    if (!DMSMEngine()) return nil;
    NSMutableSet<NSString *> *out = [NSMutableSet set];
    for (DMSMTitleBar *bar in gSMBars.allObjects) {
        UIView *card = bar.card;
        NSString *b = card ? DMSMCardBundle(card) : nil;
        if (b && card.window && !card.window.hidden && card.alpha > 0.01) [out addObject:b];
    }
    return out;
}
void DMSMRefreshBars(void) {
    DMLightGroupsRefresh();   // (the active app as the lights see it, first: every bar's lights from it)
    for (DMSMTitleBar *b in gSMBars.allObjects) { [b dm_updateLights]; [b.card setNeedsLayout]; if (b.card) DMSMReapplyGrabbers(b.card); }
    // (the window order changed: which full-screen card's status bar copy is the menu bar may have too)
    for (UIView *fg in gCopies.allObjects) {
        if (![NSStringFromClass([fg.window class]) isEqualToString:@"SBMainSwitcherWindow"]) continue;
        [(_UIStatusBarForegroundView *)fg dm_layoutLogo];
        if (DMSMInFullScreenCard(fg) && fg.alpha < 1.0) { gDMHoldOwnAlpha = YES; fg.alpha = 1.0; gDMHoldOwnAlpha = NO; }
    }
}
// ---- one piece: our title bar and Apple's window card --------------------------------------------------------------------------------------------
// The card's page view rounds all four corners (its content clip, SBAsymmetricalCornerRadiusWrapperView, and its shadow follow its maskedCorners),
// which left a notch of wallpaper under each end of our bar, and its shadow wrapped the window only. While our bar is on a card: only the bottom
// corners are rounded (the bar has the top ones, at the card's own radius), and the shadow view reaches up over the bar -- one shape, one shadow.
@interface SBAppSwitcherPageView : UIView
- (void)setMaskedCorners:(unsigned long long)m;
- (unsigned long long)maskedCorners;
@end
static char kSMAppleCornersKey;
static UIView *DMSMCardOfView(UIView *v) {
    Class cc = objc_getClass("SBFluidSwitcherItemContainer");
    while (v && !(cc && [v isKindOfClass:cc])) v = v.superview;
    return v;
}
static BOOL DMSMCardHasBar(UIView *card) {
    UIView *bar = card ? objc_getAssociatedObject(card, kSMBarKey) : nil;
    return bar && !bar.hidden && [bar isDescendantOfView:card];
}
static SBAppSwitcherPageView *DMSMPageViewOf(UIView *card) {
    Class pc = objc_getClass("SBAppSwitcherPageView");
    NSMutableArray<UIView *> *todo = [NSMutableArray arrayWithArray:card.subviews];
    for (NSUInteger depth = 0; depth < 4 && todo.count; depth++) {
        NSMutableArray *next = [NSMutableArray array];
        for (UIView *v in todo) { if (pc && [v isKindOfClass:pc]) return (SBAppSwitcherPageView *)v; [next addObjectsFromArray:v.subviews]; }
        todo = next;
    }
    return nil;
}
static char kSMShapedKey;
static void DMSMShapeCard(UIView *card, UIView *bar) {   // (on a change of the bar: corners and shadow again, and the bar at the card's radius)
    SBAppSwitcherPageView *page = DMSMPageViewOf(card);
    objc_setAssociatedObject(card, &kSMShapedKey, page && bar ? @YES : nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // (a card whose page is built later is shaped then)
    if (!page) return;
    NSNumber *apple = objc_getAssociatedObject(page, &kSMAppleCornersKey);
    [page setMaskedCorners:apple ? apple.unsignedLongLongValue : [page maskedCorners]];   // (the hook below decides)
    [page setNeedsLayout];
}
// A finger in a window that is not the front one brings it forward, as a click does on a Mac (Stage Manager itself only did it for a tap: a
// drag or scroll in a background window scrolled it and left another window active). It happens when the finger LIFTS: bringing it forward is a
// workspace transition, and one started while the finger was down broke the app's touch (a scroll in Clock's list became a tap that opened an
// alarm). A pointer's scroll does not activate (a Mac's doesn't either).
// Which window the touch is for is SpringBoard's own hit test, top window first -- the Dock, the menu bar or a menu above a window keep theirs.
static __weak UITouch *gSMPendingTouch;
static NSString *gSMPendingBundle;
// The view a touch is for, top window first. UIKit's own choice when it made one in a real window: the touch's window and view (a touch UIKit gave
// the Dock, the menu bar, a menu or Control Center stays theirs). Only when it went to the system gesture window (or none): OUR hit test, over the
// windows that can hold a window card or sit above one -- with the touch's real event. It used to hit-test EVERY SpringBoard window with no event
// (review S5: native M1/M2 SpringBoard has windows the iPad 2 never had -- Pencil hover, the Stage Manager strip -- whose hit tests may rely on it).
static UIView *DMSMTouchTarget(UITouch *x, UIEvent *event, UIScreen *screen, CGPoint p) {
    UIWindow *tw = x.window;
    NSString *twc = tw ? NSStringFromClass([tw class]) : nil;
    if (tw && ![twc isEqualToString:@"_UISystemGestureWindow"]) {
        UIView *v = x.view;
        if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[smtouch] UIKit: %@ > %@", twc, NSStringFromClass([v class])]);
        return v;
    }
    // (the windows a window card lives in or that can sit above one on 16.7.7: the switcher, the Dock, the status bar, Control Center, the Cover
    //  Sheet, banners, alerts, SpringBoard's own keyboards -- and ours: menus, panels, questions, alerts (MSB... / DM... / plain UIWindow))
    static NSSet<NSString *> *known;
    if (!known) known = [NSSet setWithObjects:@"SBMainSwitcherWindow", @"SBFloatingDockWindow", @"UIStatusBarWindow", @"SBControlCenterWindow", @"SBCoverSheetWindow",
                         @"SBBannerWindow", @"SBMedusaHostedKeyboardWindow", @"SBHomeScreenWindow", @"SBSwitcherWindow", @"UITextEffectsWindow", @"UIRemoteKeyboardWindow", nil];
    if (DMSBUseSTUI() && ![known containsObject:DMSBName("UIStatusBarWindow")]) known = [known setByAddingObject:DMSBName("UIStatusBarWindow")];   // (iPadOS 17+: SBStatusBarWindow)
    NSMutableArray<UIWindow *> *wins = [NSMutableArray array];
    for (UIWindow *w in DMAllWindows()) {
        if (w.hidden || w.alpha < 0.01 || !w.userInteractionEnabled || (w.screen ?: [UIScreen mainScreen]) != screen) continue;   // (the touched screen's, L3)
        NSString *wc = NSStringFromClass([w class]);
        BOOL ours = [w class] == [UIWindow class] || [wc hasPrefix:@"MSB"] || [wc hasPrefix:@"DM"];
        BOOL above = [wc containsString:@"Alert"] || [wc containsString:@"Banner"] || [wc containsString:@"TransientOverlay"];
        if (ours || above || [known containsObject:wc]) [wins addObject:w];
    }
    [wins sortUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) { return a.windowLevel > b.windowLevel ? NSOrderedAscending : (a.windowLevel < b.windowLevel ? NSOrderedDescending : NSOrderedSame); }];
    UIView *hit = nil;
    for (UIWindow *w in wins) {
        hit = [w hitTest:[w convertPoint:p fromCoordinateSpace:screen.coordinateSpace] withEvent:event];
        if (hit) break;
    }
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[smtouch] %@: ours over %lu windows > %@ in %@", twc ?: @"no window", (unsigned long)wins.count, NSStringFromClass([hit class]), NSStringFromClass([hit.window class])]);
    return hit;
}
static void DMSMActivateOnTouch(UIEvent *event) {
    DM_FEATURE_MARK("sm-activate-on-touch");
    for (UITouch *x in event.allTouches) {
        if (x.type != UITouchTypeDirect) continue;
        if (x.phase == UITouchPhaseBegan && !gSMPendingTouch) {
            if (!gSMBars.count) return;
            UIScreen *screen = x.window.screen ?: [UIScreen mainScreen];
            CGPoint p = [x.window convertPoint:[x locationInView:x.window] toCoordinateSpace:screen.coordinateSpace];
            // (a key tap is never a touch in the window under the keyboard -- the keyboard is drawn by the app, so SpringBoard's hit test found the
            //  card below it: that window came forward and the keyboard closed, logic test K2)
            if (gSMKeyboardShown && screen == [UIScreen mainScreen] && CGRectContainsPoint(gSMKeyboardFrame, p)) continue;
            // (not in the App Switcher, and not a Home Screen swipe from the bottom edge: a card swiped away or a stage left for Home came back,
            //  logic review L7)
            if (DMSwitcherVisible() || p.y > screen.bounds.size.height - 24.0) continue;
            UIView *hit = DMSMTouchTarget(x, event, screen, p);
            // (a touch on our own title bar is the title bar's: its lights close or minimize the window, its tap and drag bring it forward
            //  themselves -- activating it here as well brought a closed or minimized window straight back, logic review L8)
            BOOL onBar = NO; for (UIView *v = hit; v; v = v.superview) if ([v isKindOfClass:[DMSMTitleBar class]]) { onBar = YES; break; }
            if (onBar) continue;
            UIView *card = DMSMCardOfView(hit);
            NSString *bundle = card ? DMSMCardBundle(card) : nil;
            if (!bundle.length || [bundle isEqualToString:DMSMFrontWindowBundle()]) continue;
            gSMPendingTouch = x; gSMPendingBundle = bundle;
        } else if (x == gSMPendingTouch && (x.phase == UITouchPhaseEnded || x.phase == UITouchPhaseCancelled)) {
            NSString *bundle = gSMPendingBundle;
            gSMPendingTouch = nil; gSMPendingBundle = nil;
            if (x.phase == UITouchPhaseCancelled || [bundle isEqualToString:DMSMFrontWindowBundle()]) continue;   // (a tap Stage Manager already took, or a cancelled touch)
            if (DMSwitcherVisible() || !DMFrontApp()) continue;   // (the App Switcher or the Home Screen came up meanwhile, L7)
            dispatch_async(dispatch_get_main_queue(), ^{ DMSMBringToFront(bundle); DMLog([NSString stringWithFormat:@"[smengine] %@ brought forward by a touch in it", bundle]); });
        }
    }
}
// ---- several windows at once: the Window menu's Fit to Window and Swap rows, with Stage Manager as the engine ----------------------------------------
// Each open window's frame on the screen (the card and our title bar), by app: the same frames the layouts are compared with (DMSlotNameForFrame).
// The stage the Window menu acts on: the active window's (on the iPad or the TV) -- logic test F7: swap rows counted every screen's windows and
// then acted on the iPad's stage only.
static id DMSMWorkingStage(void) {
    NSString *front = DMSMFrontWindowBundle();
    return front.length ? DMSMStageOf(front) : DMSMFrontStage();
}
// A window frame's layout slot on its stage's own screen (DMSlotNameForFrame measures against the iPad).
static NSString *DMSMSlotNameForFrameIn(CGRect f, id stage) {
    CGSize scr = CGSizeZero;
    CGRect u = DMSMUsableAreaForStage(stage, &scr);
    for (NSString *name in @[@"left", @"right", @"top", @"bottom", @"topleft", @"topright", @"bottomleft", @"bottomright"]) {
        CGRect t = DMLayoutFrameInArea(name, u, scr);
        if (CGRectIsNull(t)) continue;
        if (fabs(t.origin.x - f.origin.x) < 16.0 && fabs(t.origin.y - f.origin.y) < 16.0 && fabs(t.size.width - f.size.width) < 16.0 && fabs(t.size.height - f.size.height) < 16.0) return name;
    }
    return nil;
}
static NSDictionary<NSString *, NSValue *> *DMSMOpenWindowFrames(void) {   // (the working stage's windows only)
    NSMutableDictionary *out = [NSMutableDictionary dictionary];
    NSMutableSet *inStage = [NSMutableSet set];
    for (id it in DMSMStageItemsMap(DMSMWorkingStage())) { NSString *b = DMSMItemBundle(it); if (b) [inStage addObject:b]; }
    for (NSString *b in DMSMWindowBundles()) {
        if (![inStage containsObject:b]) continue;
        UIView *card = DMSMCardFor(b);
        if (!card) continue;
        CGRect c = [card convertRect:card.bounds toCoordinateSpace:(card.window.screen ?: [UIScreen mainScreen]).coordinateSpace];
        out[b] = [NSValue valueWithCGRect:CGRectMake(c.origin.x, c.origin.y - kSMBarH, c.size.width, c.size.height + kSMBarH)];
    }
    return out;
}
// The usable desktop of the screen a stage is on: the iPad's (DMUsableArea), or the TV's -- under its menu bar, above ITS Dock (Stage Manager's own
// Dock height for that screen size, from the stage-area pass), so TV windows no longer reach under the TV's Dock.
static CGRect DMSMUsableAreaForIdentity(id identity, CGSize *screenOut);
static CGRect DMSMUsableAreaForStage(id stage, CGSize *screenOut) { return DMSMUsableAreaForIdentity(DMSMStageDisplayIdentity(stage), screenOut); }
static CGRect DMSMUsableAreaForIdentity(id identity, CGSize *screenOut) {   // (the same for the display a plan is asked on)
    if (!DMSMIsMainIdentity(identity)) {
        for (UIScreen *sc in [UIScreen screens]) {
            if (![DMSMIdentityOfScreen(sc) isEqual:identity]) continue;
            CGSize size = sc.bounds.size;
            NSNumber *dock = gSMDockHeightBySize[NSStringFromCGSize(size)];
            CGFloat dh = dock ? dock.doubleValue : round(size.height * 0.2), top = 24.0;
            if (screenOut) *screenOut = size;
            return CGRectMake(0, top, size.width, MAX(100.0, size.height - dh - 2.0 - top));
        }
    }
    if (screenOut) *screenOut = [UIScreen mainScreen].bounds.size;
    // (the top where Stage Manager's stage area has it: its status bar height raised to our menu bar's 24 pt, our title bar below that -- the
    //  _statusBarHeight hook, also while the bar hides itself. DMUsableArea starts at 23 for the other engines' tiles: Fit tiles and windows placed
    //  from there stood 1 pt above the stage area, their title bars a point under the menu bar, and Stage Manager's constraint moved them again)
    CGRect u = DMUsableArea();
    if (CGRectGetMinY(u) < 24.0) u = CGRectMake(u.origin.x, 24.0, u.size.width, MAX(100.0, CGRectGetMaxY(u) - 24.0));
    return u;
}
// Attributes placing a window at a layout on its stage's screen (the whole window; the card is under our title bar).
static id DMSMAttrsForLayoutIn(id attrs, NSString *name, id stage) {
    CGSize scr = CGSizeZero;
    CGRect u = DMSMUsableAreaForStage(stage, &scr);
    CGRect w = DMLayoutFrameInArea(name, u, scr);
    DMSMAttributedSize sz;
    if (!attrs || CGRectIsNull(w) || scr.width < 1 || scr.height < 1 || !DMSMAttrAttributedSize(attrs, &sz)) return nil;
    CGRect c = CGRectMake(w.origin.x, w.origin.y + kSMBarH, w.size.width, w.size.height - kSMBarH);
    sz.normalizedSize = CGSizeMake(c.size.width / scr.width, c.size.height / scr.height); sz.type = 0;
    sz.referenceBounds = CGRectMake(0, 0, scr.width, scr.height);   // (fractions of this screen, see DMSMSetWindowGeometry)
    return DMSMAttrWith(attrs, sz, CGPointMake(CGRectGetMidX(c) / scr.width, CGRectGetMidY(c) / scr.height), 0, -1);   // (nil if refused: not finite, no size)
}
// Every window of the stage to its layout in ONE workspace transition that names each window in its role with its new attributes (the requested
// attributes are what places a window -- -appLayoutByModifyingLayoutAttributes:forItem: returned the stage unchanged): the windows move together.
static BOOL DMSMApplyLayouts(NSDictionary<NSString *, NSString *> *bundleToLayout) { return DMSMApplyLayoutsIn(bundleToLayout, DMSMWorkingStage()); }
static BOOL DMSMApplyLayoutsIn(NSDictionary<NSString *, NSString *> *bundleToLayout, id stage) {
    for (NSString *b in bundleToLayout) [gSMBehindDock removeObject:b];   // (placed by a layout: no longer behind the Dock)
    NSDictionary *map = DMSMStageItemsMap(stage);
    if (!map.count || !bundleToLayout.count) return NO;
    NSMutableArray *plan = [NSMutableArray array];   // [entity, role, attrs]
    id frontEntity = nil; long long newest = LLONG_MIN;
    for (id it in map) {
        NSString *b = DMSMItemBundle(it);
        id a = map[it];
        NSString *name = bundleToLayout[b];
        if (name) { id na = DMSMAttrsForLayoutIn(a, name, stage); if (na) a = na; }
        long long role = DMSMRoleOr(stage, it, 0);
        id e = DMSMEntityIn(stage, b);
        if (!e || role <= 0) return NO;
        [plan addObject:@[e, @(role), a]];
        long long t = DMSMAttrTimeOr(a, 0);
        if (t > newest) { newest = t; frontEntity = e; }
    }
    if (!DMSMRequestOn(DMSMStageDisplayIdentity(stage), nil, plan, nil, frontEntity)) { DMLog(@"[sm] layouts refused"); return NO; }
    DMLog([NSString stringWithFormat:@"[sm] layouts applied to %lu windows", (unsigned long)bundleToLayout.count]);
#if DEBUG
    if (DMTestFlag("/tmp/msb-sm-animsample")) {   // (debug: does a layout request glide or jump? the first window's on-screen frame every 50 ms)
        NSString *b0 = bundleToLayout.allKeys.firstObject;
        for (int i = 0; i <= 16; i++) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIView *card = DMSMCardFor(b0);
            CALayer *pl = card.layer.presentationLayer ?: card.layer;
            CGRect f = card ? [card.superview.layer convertRect:pl.frame toLayer:card.window.layer] : CGRectNull;
            DMLog([NSString stringWithFormat:@"[animsample] %@ t=%.2f %@ anims %lu", b0, i * 0.05, NSStringFromCGRect(f), (unsigned long)card.layer.animationKeys.count]);
        });
    }
#endif
    return YES;
}
// Fit to Window: the desktop's windows tiled like our other engines' (2: halves, 3: a half and two quarters, 4: quarters; newest first) -- again
// whenever the set of windows changes (one opens, closes, is minimized), not while the user moves one. force: now (the switch was turned on).
// The arrangement Fit to Window keeps (app -> layout slot) and the windows left out of it (No Fit), like the other engines' gFitSlots/gFreeWindows.
// Windows that went full screen, and the arrangement they left: coming back from full screen is not a new window (it was asked about as a
// third window again), it takes its tile back.
static NSMutableSet<NSString *> *gSMFitWentFull;
static NSDictionary<NSString *, NSString *> *gSMFitSlotsBeforeFull;
static void DMSMFitTick(BOOL force) {
    static NSArray *lastSet = nil;
    if (!DMSMEngine() || !DMFitEnabled()) { lastSet = nil; return; }
    // (the Home Screen in front: no stage is shown -- the most recent one is only kept, hidden. Nothing is read or asked then: the arrangement
    //  stays for when its windows come back, and a layout request for the hidden stage brought it to the front over the Home Screen -- iPad 2,
    //  4 Oct: on the Home Screen a swipe up from the bottom edge, which SpringBoard answers by showing the stage's cards for the gesture, had the
    //  hidden stage tiled again in the default arrangement (its chosen one was dropped when the Home Screen came: no windows on screen) and its
    //  windows came up; mac-switcher-sm 72241a7)
    if (!DMFrontApp()) return;
    {   // (which windows are full screen now: their tiles are kept for their return)
        NSDictionary *fm = DMSMStageItemsMap(DMSMFrontStage());
        for (id it in fm) if (DMSMPolicyOf(fm[it]) == 2) {
            NSString *b = DMSMItemBundle(it);
            if (!b || [gSMFitWentFull containsObject:b]) continue;
            if (!gSMFitWentFull) gSMFitWentFull = [NSMutableSet set];
            [gSMFitWentFull addObject:b];
            if (gSMFitSlots[b]) gSMFitSlotsBeforeFull = [gSMFitSlots copy];
        }
    }
    if (DMSMFrontIsFullScreen()) { lastSet = nil; return; }
    if (gSidePromptCtx && ![gSidePromptCtx[@"decided"] boolValue]) return;   // (the side question is up: nothing moves until it is answered)
    NSDictionary *map = DMSMStageItemsMap(DMSMFrontStage());
    NSSet *onScreen = [NSSet setWithArray:DMSMWindowBundles()];
    NSMutableArray *items = [NSMutableArray array];
    for (id it in map) if ([onScreen containsObject:DMSMItemBundle(it)] && DMSMPolicyOf(map[it]) != 2) [items addObject:it];
    [items sortUsingComparator:^NSComparisonResult(id a, id b) {
        long ta = DMSMAttrTimeOr(map[a], 0), tb = DMSMAttrTimeOr(map[b], 0);
        return ta > tb ? NSOrderedAscending : (ta < tb ? NSOrderedDescending : NSOrderedSame);
    }];
    NSMutableArray *bundles = [NSMutableArray array];
    for (id it in items) { NSString *b = DMSMItemBundle(it); if (b && ![gSMFreeWindows containsObject:b]) [bundles addObject:b]; }
    for (NSString *b in [gSMFreeWindows allObjects]) if (![onScreen containsObject:b]) [gSMFreeWindows removeObject:b];   // (closed: forgotten)
    // (the screen's shape is part of the set: the iPad turned, the tiles are laid out again -- logic review R1)
    NSArray *set = [[bundles sortedArrayUsingSelector:@selector(compare:)] arrayByAddingObject:NSStringFromCGSize([UIScreen mainScreen].bounds.size)];
    if (!force && [set isEqualToArray:lastSet ?: @[]]) return;
    NSArray *before = lastSet;
    lastSet = set;
    if (bundles.count < 2) { gSMFitSlots = nil; return; }
    // A third window joining two tiles: asked where it goes, as with the other engines (Where should ... go? left / right / No Fit)
    // Back from full screen: its old arrangement again when it covers these windows, and never the third-window question for it
    NSString *returning = nil;
    for (NSString *b in bundles) if ([gSMFitWentFull containsObject:b]) returning = b;
    if (returning) {
        [gSMFitWentFull removeObject:returning];
        NSDictionary *old = gSMFitSlotsBeforeFull; gSMFitSlotsBeforeFull = nil;
        if (old.count == bundles.count && [[NSSet setWithArray:old.allKeys] isEqualToSet:[NSSet setWithArray:bundles]]) gSMFitSlots = [old mutableCopy];
        DMLog([NSString stringWithFormat:@"[sm] Fit to Window: %@ back from full screen -- %@", returning, gSMFitSlots.count == bundles.count ? @"its tile again" : @"the default arrangement"]);
    }
    for (NSString *b in [gSMFitWentFull allObjects]) if (![onScreen containsObject:b]) [gSMFitWentFull removeObject:b];   // (closed meanwhile)
    if (!returning && bundles.count == 3 && gSMFitSlots.count == 2 && !force) {
        NSString *newB = nil, *leftB = nil, *rightB = nil;
        for (NSString *b in bundles) { NSString *slot = gSMFitSlots[b]; if (!slot) newB = b; else if ([slot isEqualToString:@"left"]) leftB = b; else if ([slot isEqualToString:@"right"]) rightB = b; }
        if (newB && leftB && rightB && ![before containsObject:newB]) {
            DM_FEATURE_MARK("sm-fit-third-window-question");
            DMLog([NSString stringWithFormat:@"[sm] Fit to Window: asking where %@ goes", newB]);
            DMSMBringToFront(newB);   // (opened some other way -- Spotlight, a link: in front while the question is up, not behind the two tiles)
            DMPromptForSideApply(nil, newB, leftB, rightB, ^(NSString *side) {
                if ([side isEqualToString:@"none"]) {   // No Fit: in the middle, left out of Fit to Window; the two tiles stay
                    if (!gSMFreeWindows) gSMFreeWindows = [NSMutableSet set];
                    [gSMFreeWindows addObject:newB];
                    DMSMApplyLayoutsIn(@{newB: @"center"}, DMSMFrontStage());
                    DMLog([NSString stringWithFormat:@"[sm] Fit to Window: %@ free in the middle (No Fit)", newB]);
                    return;
                }
                if ([side isEqualToString:@"left"]) gSMFitSlots = [@{newB: @"topleft", leftB: @"bottomleft", rightB: @"right"} mutableCopy];
                else if ([side isEqualToString:@"right"]) gSMFitSlots = [@{newB: @"topright", rightB: @"bottomright", leftB: @"left"} mutableCopy];
                else gSMFitSlots = nil;   // (no choice: the default arrangement, newest first)
                DMSMFitTick(YES);
            });
            return;
        }
    }
    // Keep the chosen arrangement while it covers exactly these windows; otherwise the default one, newest first.
    NSMutableDictionary *plan = [NSMutableDictionary dictionary];
    BOOL keep = gSMFitSlots.count == bundles.count;
    for (NSString *b in bundles) if (!gSMFitSlots[b]) keep = NO;
    if (keep) [plan addEntriesFromDictionary:gSMFitSlots];
    else {
        NSArray *slots = DMDefaultSlotNames(MIN((NSUInteger)4, bundles.count));
        for (NSUInteger i = 0; i < bundles.count && i < slots.count; i++) plan[bundles[i]] = slots[i];
        gSMFitSlots = [plan mutableCopy];
    }
    DMLog([NSString stringWithFormat:@"[sm] Fit to Window: %lu windows tiled%@", (unsigned long)plan.count, keep ? @" (the chosen arrangement)" : @""]);
    DMSMApplyLayoutsIn(plan, DMSMFrontStage());   // (the iPad's desktop, the one counted above)
}
static void DMSMLogCorners(void) {
        for (DMSMTitleBar *bar in gSMBars) {
            UIView *card = bar.card; if (!card.window) continue;
            SBAppSwitcherPageView *page = DMSMPageViewOf(card);
            NSMutableString *o = [NSMutableString stringWithFormat:@"[smcorners] %@ bar %d r %.1f; page %p masked %llu layer r %.1f m %lu", DMSMCardBundle(card), !bar.hidden, bar.layer.cornerRadius, page, page ? [page maskedCorners] : 0, page.layer.cornerRadius, (unsigned long)page.layer.maskedCorners];
            for (UIView *v in page.subviews) [o appendFormat:@" | %@ layer r %.1f m %lu clips %d", NSStringFromClass([v class]), v.layer.cornerRadius, (unsigned long)v.layer.maskedCorners, v.clipsToBounds];
            DMLog(o);
        }
}
// Our resize grips on a window card (Settings > Resize Handles = Mac): the two bottom corners, as with our other engines; Stage Manager's own
// grabbers (white, and the ones that pop up on a touch) stay invisible -- SBAppResizeGrabberView below. Apple's resize gesture stays.
static char kSMGripLKey, kSMGripRKey;
static void DMSMPlaceGrips(UIView *card, NSString *bundle, BOOL show) {
    BOOL dark = card.traitCollection.userInterfaceStyle == UIUserInterfaceStyleDark;
    for (int side = 0; side < 2; side++) {
        char *key = side == 0 ? &kSMGripLKey : &kSMGripRKey;
        UIView *grip = objc_getAssociatedObject(card, key);
        if (!show || gSMAppleHandles) { grip.hidden = YES; continue; }
        if (!grip) {
            grip = DMMakeResizeGrip();
            objc_setAssociatedObject(card, key, grip, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            [card addSubview:grip];
        }
        CGFloat W = card.bounds.size.width, H = card.bounds.size.height, c = kSMCornerR;
        grip.hidden = NO;
        grip.backgroundColor = DMResizeGripColorFor(bundle, dark);
        grip.transform = CGAffineTransformMakeRotation(side == 0 ? -M_PI_4 : M_PI_4);   // "/" bottom-left, "\" bottom-right
        grip.center = CGPointMake(side == 0 ? c : W - c, H - c);
        [card bringSubviewToFront:grip];
    }
}
static void DMSMChrome(UIView *card) {
    DMSMTitleBar *bar = objc_getAssociatedObject(card, kSMBarKey);
    if (DMSMEngine()) {   // (the app's own status bar copy is our menu bar only while the card is full screen: on a change, walk the card once and re-apply)
        static char kFullKey;
        BOOL fullNow = DMSMInFullScreenCard(card);
        NSNumber *was = objc_getAssociatedObject(card, &kFullKey);
        if (!was || was.boolValue != fullNow) {
            objc_setAssociatedObject(card, &kFullKey, @(fullNow), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
            if (was) {
                Class fgc = DMSBClass("_UIStatusBarForegroundView");
                NSMutableArray<UIView *> *todo = [NSMutableArray arrayWithObject:card];
                while (todo.count) {
                    UIView *v = todo.lastObject; [todo removeLastObject];
                    if (fgc && [v isKindOfClass:fgc]) { [(_UIStatusBarForegroundView *)v dm_layoutLogo]; if (fullNow && v.alpha < 1.0) { gDMHoldOwnAlpha = YES; v.alpha = 1.0; gDMHoldOwnAlpha = NO; } continue; }
                    [todo addObjectsFromArray:v.subviews];
                }
            }
        }
    }
    NSString *bundle = DMSMCardBundle(card);
    BOOL want = DMSMEngine() && bundle && !DMTestFlag("/tmp/msb-sm-nochrome") && [NSStringFromClass([card.window class]) isEqualToString:@"SBMainSwitcherWindow"];
    if (want) {   // (full screen: no title bar, like a Mac window in full screen; scaled: the App Switcher shows it)
        CGAffineTransform tr = card.transform;
        BOOL full = DMSMCardIsFullSize(card);   // (both sides: a full-width window -- Top Half -- is still a window)
        // (scaled in the App Switcher only: a background window Stage Manager shrinks is still a window with its bar -- one lost its bar that way)
        BOOL scaled = gEnvMode == 2 && (fabs(tr.a - 1.0) > 0.02 || fabs(card.layer.presentationLayer.transform.m11 - 1.0) > 0.05);
        if (full || scaled) want = NO;
    }
    if (!want) {
        BOOL wasShown = bar && !bar.hidden;
        bar.hidden = YES;
        DMSMPlaceGrips(card, nil, NO);
        if (wasShown) DMSMShapeCard(card, nil);
        return;
    }
    BOOL wasShown = bar && !bar.hidden;
    if (!bar) {
        bar = [[DMSMTitleBar alloc] initWithFrame:CGRectZero];
        objc_setAssociatedObject(card, kSMBarKey, bar, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [card addSubview:bar];
        if (!gSMBars) gSMBars = [NSHashTable weakObjectsHashTable];
        [gSMBars addObject:bar];
    }
    // (this runs on every layout of the card -- every frame of a drag or an animation: only what changed is redone; the lights follow the front
    //  window through DMSMRefreshBars, logic test 29 Sep P2)
    BOOL bundleChanged = ![bar.bundle isEqualToString:bundle];
    bar.card = card; bar.bundle = bundle; bar.hidden = NO;
    if (!wasShown || !objc_getAssociatedObject(card, &kSMShapedKey)) DMSMShapeCard(card, bar);
    static char kSMLaidSizeKey;
    NSValue *laid = objc_getAssociatedObject(card, &kSMLaidSizeKey);
    BOOL sizeChanged = !laid || !CGSizeEqualToSize(laid.CGSizeValue, card.bounds.size);
    if (sizeChanged) objc_setAssociatedObject(card, &kSMLaidSizeKey, [NSValue valueWithCGSize:card.bounds.size], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (!wasShown || sizeChanged || bundleChanged) DMSMPlaceGrips(card, bundle, YES);
    CGRect f = CGRectMake(0, -kSMBarH, card.bounds.size.width, kSMBarH);
    if (!CGRectEqualToRect(bar.frame, f)) bar.frame = f;
    if (card.subviews.lastObject != bar && card.subviews.lastObject != objc_getAssociatedObject(card, &kSMGripRKey)) [card bringSubviewToFront:bar];
    if (!wasShown || bundleChanged) [bar dm_updateLights];
}
static void DMSMJoinStageAsked(id ctx, NSArray<NSArray *> *asked);   // (SMDesktop.h: SpringBoard's own transitions with roles set)
static void DMSMJoinDesktop(id ctx) {
    DM_FEATURE_MARK("sm-join-desktop");
    // Atomic (review S2): the whole rewrite -- every window's entity, role and attributes -- is planned and checked first (DMSMPlanValid), and only
    // then written into Apple's context (DMSMWritePlan, which empties what it wrote if a write fails). Any refusal on the way returns with the
    // context untouched: the launch goes on as Stage Manager's own (a new stage).
    if (DMSMCtxIsOurs(ctx)) return;   // (our own plan, or a request of ours: as we wrote it)
    // Roles set by SpringBoard itself (the App Switcher's card of a minimized window, Cmd-Tab, Stage Manager's drag and drop, the strip): another
    // stage is being asked for -- it joins the desktop instead of showing alone, where that is what it is (SMDesktop.h, SMDeskJoin.h).
    NSMutableArray<NSArray *> *asked = [NSMutableArray array];
    for (long r = 1; r <= 6; r++) {
        BOOL readable = NO;
        id e = DMSMCtxEntityForRole(ctx, r, &readable);
        if (!readable) return;   // (refused: DMSMAPIFail said why)
        if (e) [asked addObject:@[@(r), e]];
    }
    if (asked.count) { DMSMJoinStageAsked(ctx, asked); return; }
    id act = [ctx respondsToSelector:NSSelectorFromString(@"activatingEntity")] ? DMCall(ctx, @"activatingEntity") : nil;
    if (!DMSMIsEntity(act)) return;   // (the Home Screen, nothing -- or not an app's entity)
    NSString *bundle = DMCall(DMCall(act, @"application"), @"bundleIdentifier");
    id identity = DMCall(ctx, @"displayIdentity");
    if (![bundle isKindOfClass:[NSString class]] || !bundle.length || !DMSMIsMainIdentity(identity)) return;
    DMSMSetMinimized(bundle, NO);   // (opened again: no longer a minimized window)
    // The desktop = the most recent stage on the iPad that still has a window which is not minimized (logic test F2a: the most recent stage was
    // a minimized window's hidden stage, and it came back with the app); minimized windows are left out of what joins.
    id desk = nil; NSMutableDictionary *map = nil;
    for (id al in DMSMRecentStages()) {
        if (!DMSMIsMainIdentity(DMSMStageDisplayIdentity(al))) continue;
        NSDictionary *all = DMSMStageItemsMap(al);
        NSMutableDictionary *shown = [NSMutableDictionary dictionary];
        for (id it in all) if (!DMSMIsMinimized(DMSMItemBundle(it))) shown[it] = all[it];
        if (shown.count) { desk = al; map = shown; break; }
    }
    NSMutableArray *plan = [NSMutableArray array];   // [entity, role, attrs], the launching app last
    NSString *what = nil;
    id dismissFullIn = nil;   // (full screen launch: the stage whose previous full-screen app then leaves -- only once the plan is written)
    if (!map.count) {
        // An empty desktop: the app opens as Open Apps as Windows says, never at whatever Stage Manager remembered -- as a WINDOW (its own last window
        // size, else the default window; 1.1.0: an app once in full screen, like Safari, came back full screen from then on), or FULL SCREEN, as from
        // the Home Screen while a stage is on record (DMSMOpenFullScreenStage, which needs a window to copy and so never covered this case): a window
        // Stage Manager remembered from the other orientation came back 379 x 921 pt in the 649 pt landscape desktop, 200 pt past the screen's bottom
        // edge, its resize corners out of reach (iPad 2, 1.3.2 logic test)
        BOOL windowed = DMWindowedLaunchOn();
        id attrs = DMSMJoinAttributes(bundle, nil, windowed, 0, nil);
        if (!attrs) { DMLog([NSString stringWithFormat:@"[smjoin] %@: no desktop to join (a new stage, Stage Manager's own size)", bundle]); return; }
        [plan addObject:@[act, @1, attrs]];
        what = [NSString stringWithFormat:@"[smjoin] %@: a new desktop, opened %@", bundle, windowed ? @"as a window" : @"full screen (apps do not open as windows)"];
    } else {
        for (id it in map) if ([DMSMItemBundle(it) isEqual:bundle]) { DMLog([NSString stringWithFormat:@"[smjoin] %@: already on the desktop", bundle]); return; }   // (already on the desktop: Stage Manager brings it forward)
        BOOL windowed = DMWindowedLaunchOn();
        NSArray *items = [map.allKeys sortedArrayUsingComparator:^NSComparisonResult(id a, id b) {   // (newest first)
            long long ta = DMSMAttrTimeOr(map[a], 0), tb = DMSMAttrTimeOr(map[b], 0);
            return ta > tb ? NSOrderedAscending : (ta < tb ? NSOrderedDescending : NSOrderedSame);
        }];
        if (items.count > 3) items = [items subarrayWithRange:NSMakeRange(0, 3)];   // (a 5th app: the oldest window is left out)
        id front = items.firstObject;
        long long newest = 0;
        if (!DMSMAttrLastInteractionTime(map[front], &newest)) return;
        id attrs = DMSMJoinAttributes(bundle, map[front], windowed, (long)newest, desk);
        if (!attrs) return;
        NSSet<NSNumber *> *allowed = DMSMNewWindowRoles();
        NSMutableSet *used = [NSMutableSet set];
        NSMutableArray *kept = [NSMutableArray array];
        for (id it in items) {
            long long role = 0;
            if (!DMSMStageRoleOfItem(desk, it, &role)) return;
            if (role == 4 || ![allowed containsObject:@(role)]) role = 0;   // (the centre role, or one we never give: a side role below)
            id e = DMSMEntityIn(desk, DMSMItemBundle(it));
            if (!e) return;
            [kept addObject:@[e, @(role), map[it]]];
            if (role > 0) [used addObject:@(role)];
        }
        long (^freeRole)(void) = ^long { for (size_t i = 0; i < sizeof(kSMNewWindowRoles) / sizeof(kSMNewWindowRoles[0]); i++) if (![used containsObject:@(kSMNewWindowRoles[i])]) { [used addObject:@(kSMNewWindowRoles[i])]; return kSMNewWindowRoles[i]; } return 0; };
        for (NSArray *k in kept) {
            long role = [k[1] longValue] ?: freeRole();
            if (!role) return;
            [plan addObject:@[k[0], @(role), k[2]]];
        }
        long mine = freeRole();
        if (!mine) return;
        [plan addObject:@[act, @(mine), attrs]];
        dismissFullIn = windowed ? nil : desk;
        what = [NSString stringWithFormat:@"[smengine] %@ joins the desktop (role %ld, %lu window(s) kept%@)%@", bundle, mine, (unsigned long)kept.count, map.count > 3 ? @", the oldest left out" : @"", windowed ? @"" : @" full screen"];
    }
    // (every window of the plan inside the desktop as it is now -- the desktop's own windows too: a stage left while the iPad turned kept the other
    //  shape's sizes, SMFit.h)
    NSArray<NSArray *> *toWrite = DMSMPlanFitted(identity, plan);
    NSString *why = nil;
    if (!DMSMPlanValid(toWrite, DMSMNewWindowRoles(), &why)) { DMSMAPIFail(@"joining the desktop", [NSString stringWithFormat:@"%@: plan refused, context left as it was (%@)", bundle, why]); return; }
#if DEBUG
    gSMSimulateWriteFail = DMTestFlag("/tmp/msb-sm-simulate-writefail") ? (int)toWrite.count - 1 : -1;   // (debug: the last write throws -- the roll-back)
#endif
    BOOL ok = DMSMWritePlan(ctx, toWrite, act);
#if DEBUG
    gSMSimulateWriteFail = -1;
#endif
    if (ok && dismissFullIn) DMSMDismissOtherFullScreen(dismissFullIn, bundle);
    DMLog(ok ? what : [NSString stringWithFormat:@"[smjoin] %@: writing the plan failed, context emptied again (a new stage)", bundle]);
}
%group SMEngine
// A background window comes forward when the finger lifts (DMSMActivateOnTouch). In the release build too: it was only called from the debug
// build's own sendEvent: hook, so the feature never shipped in 1.1.0/1.1.1 (logic test K1).
%hook SpringBoard
- (void)sendEvent:(UIEvent *)event {
    if (event.type == UIEventTypeTouches && DMSMEngine()) DMSMActivateOnTouch(event);
    %orig;
}
%end
%hook SBIconView
- (void)_handleTap {
    NSString *bundle = nil; @try { bundle = [[self valueForKey:@"icon"] valueForKey:@"applicationBundleID"]; } @catch (id e) {}
    if ([bundle isKindOfClass:[NSString class]] && DMSMAddToStage(bundle, (UIView *)self)) return;
    %orig;
}
%end
// Free placement, like a Mac: Stage Manager's auto-layout re-spaces, compacts, centres the group, snaps to edges and pushes covered windows to a
// visible edge -- a window put somewhere (by us or a drag) did not stay there. Only its first step stays: windows are kept inside the stage area
// (_constrainModel...). debug: /tmp/msb-sm-applelayout = Apple's full layout, to compare.
static BOOL DMSMFree(void) { return DMSMEngine() && !DMTestFlag("/tmp/msb-sm-applelayout"); }
// Stage Manager's recent-stages strip: our engine has none (the Dock is where apps are; prefersStripHidden keeps it hidden) -- but a swipe in from the
// left edge still revealed it (iPad 2, 3 Oct: every recent stage, the other Mac Switcher desktops' windows too, and the stage on screen squeezed
// aside for it). The gesture's own gate answers NO while our engine runs. Optional (not in the start-up check): a gate of another name or signature
// on another iPadOS leaves the strip's gesture as Apple has it, and says so.
static BOOL (*o_SMStripRevealBegin)(id, SEL, id);
static BOOL DMSMStripRevealBegin(id self, SEL _cmd, id g) {
    if (DMSMFree()) { DM_FEATURE_MARK("sm-no-strip-reveal"); return NO; }
    return o_SMStripRevealBegin(self, _cmd, g);
}
// With the strip's gesture held off, the same swipe in from the left edge went on to Stage Manager's window drag (the split-view "unpin" recognizer,
// which is also how every window is moved by its title bar, so it stays): a window touching the left edge -- ours may, Fit's left tile does;
// Apple's keep 48 pt away -- was dragged off by the swipe (iPad 2: App Store's tile ended behind Books). A drag that STARTS in the strip's edge
// zone (20 pt) is refused while our engine runs: the edge swipe does nothing, as on a Mac.
// (1.3.x port of the 1.4 branch's strip gate, without its Mac Switcher parts: the tap-forward / live-resize gates under the Mac Switcher's view)
static BOOL (*o_SMUnpinBegin)(id, SEL, id);
static BOOL DMSMUnpinBegin(id self, SEL _cmd, id g) {
    if (DMSMFree() && [g isKindOfClass:[UIPanGestureRecognizer class]] && ((UIGestureRecognizer *)g).view) {
        UIPanGestureRecognizer *pan = g;
        CGPoint now = [pan locationInView:pan.view], moved = [pan translationInView:pan.view];
        UIScreen *scr = pan.view.window.screen ?: [UIScreen mainScreen];
        CGPoint start = [pan.view convertPoint:CGPointMake(now.x - moved.x, now.y - moved.y) toCoordinateSpace:scr.coordinateSpace];
        if (start.x <= 20.0) { DM_FEATURE_MARK("sm-no-edge-window-drag"); return NO; }
    }
    return o_SMUnpinBegin(self, _cmd, g);
}
// While one of our menus is open, Stage Manager's tap that brings a window forward does not begin: a tap on a Window menu row over another window
// also brought that window forward first, and the menu's layout then went to it (1.3.4 logic test P1, iPad 2: "Bottom Left" for Settings moved
// Clock). The menu takes the touch, as a Mac menu does. (1.4's gate here also holds it under the Mac Switcher's view: combine them on merge.)
static BOOL DMSMOurMenuOpen(void) { return (gMenuWindow && !gMenuWindow.hidden && gOverlay) || DMExtMenuVisible(); }
static BOOL (*o_SMTapForwardBegin)(id, SEL, id);
static BOOL DMSMTapForwardBegin(id self, SEL _cmd, id g) {
    if (DMSMFree() && DMSMOurMenuOpen()) { DM_FEATURE_MARK("sm-menu-tap-not-forward"); return NO; }
    return o_SMTapForwardBegin(self, _cmd, g);
}
// (the same at touch-down: the recogniser is asked whether it begins only when the tap ends -- by then a row's action may have closed the menu; a
//  touch that starts while one of our menus is open never reaches it. 1.3.5 logic test R2-N1)
static BOOL (*o_SMTapForwardTouch)(id, SEL, id, id);
static BOOL DMSMTapForwardTouch(id self, SEL _cmd, id g, id touch) {
    if (DMSMFree() && DMSMOurMenuOpen()) return NO;
    return o_SMTapForwardTouch(self, _cmd, g, touch);
}
static void DMSMHookStripReveal(void) {
    static BOOL done = NO;
    if (done) return;
    done = YES;
    Class gm = objc_getClass("SBFluidSwitcherGestureManager");
    {   // (the tap-forward gate: on its own, a signature of another kind leaves Apple's gesture as it is)
        SEL tf = NSSelectorFromString(@"_shouldBeginTapToBringItemContainerForwardGesture:");
        Method mtf = gm ? class_getInstanceMethod(gm, tf) : NULL;
        if (mtf && [DMSMSigOfMethod(mtf) isEqualToString:DMSMExpect(@encode(BOOL), @encode(id), NULL)]) MSHookMessageEx(gm, tf, (IMP)DMSMTapForwardBegin, (IMP *)&o_SMTapForwardBegin);
        else DMLog(@"[smengine] Stage Manager's tap-to-front gesture is not as expected here: menus over windows leave it as Apple has it");
        SEL tt = NSSelectorFromString(@"_shouldTapToBringItemContainerForward:receiveTouch:");
        Method mtt = gm ? class_getInstanceMethod(gm, tt) : NULL;
        if (mtt && [DMSMSigOfMethod(mtt) isEqualToString:DMSMExpect(@encode(BOOL), @encode(id), @encode(id), NULL)]) MSHookMessageEx(gm, tt, (IMP)DMSMTapForwardTouch, (IMP *)&o_SMTapForwardTouch);
    }
    SEL s = NSSelectorFromString(@"_shouldBeginContinuousExposeStripRevealGesture:"), u = NSSelectorFromString(@"_shouldBeginSplitViewApplicationUnpinGesture:");
    NSString *want = DMSMExpect(@encode(BOOL), @encode(id), NULL);
    Method m = gm ? class_getInstanceMethod(gm, s) : NULL, mu = gm ? class_getInstanceMethod(gm, u) : NULL;
    // (each gate on its own: iPadOS 16.0 has the window drag's but not the strip's selector -- the drag gate was skipped with it, 1.3.5 logic test L5)
    if (mu && [DMSMSigOfMethod(mu) isEqualToString:want]) MSHookMessageEx(gm, u, (IMP)DMSMUnpinBegin, (IMP *)&o_SMUnpinBegin);
    if (!m || ![DMSMSigOfMethod(m) isEqualToString:want]) { DMLog([NSString stringWithFormat:@"[smengine] the strip's reveal gesture is not as expected here: left as Apple has it%@", o_SMUnpinBegin ? @" (no window drag starts in its edge zone)" : @""]); return; }
    MSHookMessageEx(gm, s, (IMP)DMSMStripRevealBegin, (IMP *)&o_SMStripRevealBegin);
    DMLog([NSString stringWithFormat:@"[smengine] the strip's reveal gesture is held off while Stage Manager is the engine%@", o_SMUnpinBegin ? @" (and no window drag starts in its edge zone)" : @""]);
}
// Stage Manager keeps overlapping windows 48 pt short of each screen edge (and above its Dock): with our engine a window may be as big as the screen
// (Fill Screen, a window dragged to the edges), like a Mac window.
// The "recent stages" strip on the left: every Stage Manager layout pass asks the switcher (SBSwitcherModifier -prefersStripHidden forwards to
// it) -- the one source; the settings' _shouldPreferStripHidden... alone arrived as NO and the strip came back wherever windows left room for it
// (Apple's own test automation switches this same flag: setChamoisPrefersStripHidden). Our engine has no strip: the Dock is where apps are.
// The Dock with Apple's windows in an app (-[SBFullScreenContinuousExposeSwitcherModifier shouldConfigureInAppDockHiddenAssertion], SpringBoard.framework
// 0x308d34, iPad 2 16.7.7): hidden while the switcher thinks the software keyboard is up, or while the stage's windows together are taller than
// the screen minus the Dock (117.4) and its margin (15.5), whatever their place; else the "hide Dock" preference. Both misfire with our engine:
//  - "keyboard up" was set with no keyboard anywhere after a respring (fixed at its source: -_updateSoftwareKeyboardVisibleWithKeyboardShowing: below);
//  - the height rule assumes Apple's own layout; two windows tiled above the Dock span more than that and hid it.
// Our engine, like a Mac: the Dock stays, except while an app's keyboard is really on screen (Apple's flag, made reliable below), in native full
// screen (a maximized window in the stage), or when the preference hides it.
static BOOL DMSMStageHasFullScreenWindow(void) {
    NSDictionary *map = DMSMStageItemsMap(DMSMFrontStage());
    for (id it in map) {
        id a = map[it];
        if (DMSMPolicyOf(a) == 2) return YES;
    }
    return NO;
}
%hook SBFullScreenContinuousExposeSwitcherModifier
- (BOOL)shouldConfigureInAppDockHiddenAssertion {
    BOOL apple = %orig;
    if (!DMSMFree()) return apple;
    id me = self;
    SEL pref = NSSelectorFromString(@"prefersDockHidden");
    BOOL prefers = [me respondsToSelector:pref] && DMSMSigOK(me, pref, DMSMSigBool(), "prefersDockHidden") && ((BOOL (*)(id, SEL))objc_msgSend)(me, pref);
    SEL kbSel = NSSelectorFromString(@"isSoftwareKeyboardVisible");
    BOOL appleKeyboard = [me respondsToSelector:kbSel] && DMSMSigOK(me, kbSel, DMSMSigBool(), "isSoftwareKeyboardVisible") && ((BOOL (*)(id, SEL))objc_msgSend)(me, kbSel);
    // (full screen of THIS modifier's stage -- the one on its own screen: with the iPad's stage only, the TV's Dock stayed over a full-screen TV app)
    BOOL full = NO;
    Ivar fsl = class_getInstanceVariable([me class], "_fullScreenAppLayout");
    id own = fsl ? object_getIvar(me, fsl) : nil;
    if (own) { NSDictionary *om = DMSMStageItemsMap(own); for (id it in om) if (DMSMPolicyOf(om[it]) == 2) full = YES; }
    else full = DMSMStageHasFullScreenWindow();
    BOOL keyboard = appleKeyboard;   // (Apple's flag, set only for a keyboard really shown: see _updateSoftwareKeyboardVisible... below)
    BOOL r = keyboard || full || prefers;
    if (DMTestFlag("/tmp/macstatusbar-debug")) {
        static NSString *last;
        NSString *line = [NSString stringWithFormat:@"[sm] in-app Dock hidden %d (keyboard %d, full screen %d, preference %d; Apple said %d)", r, keyboard, full, prefers, apple];
        if (![line isEqualToString:last]) { last = line; DMLog(line); }
    }
    return r;
}
%end
%hook SBFluidSwitcherViewController
// Root of the Dock hiding with no keyboard: SpringBoard sets "software keyboard visible" from UIKeyboardDidChangeUIPosition == 3 (docked) alone. UIKit
// posts that when a window gets focus after a respring with no keyboard at all, and before a real keyboard's willShow (10 ms later); the flag then
// stayed set until some keyboard showed and hid. Our engine: the flag is set only once a keyboard really announced itself (willShow) and cleared by
// willHide -- the willShow sets it itself, so SpringBoard's own change handling decides the Dock again.
// Only a DOCKED on-screen keyboard counts (logic test K3): the full width of the screen, down to its bottom edge and taller than the bar that is
// all that shows with a hardware keyboard -- that bar, a floating or a split keyboard leave the Dock alone, as Apple does.
- (void)_keyboardWillShow:(id)n {
    CGRect f = CGRectZero;
    if ([n isKindOfClass:[NSNotification class]]) { NSValue *v = ((NSNotification *)n).userInfo[UIKeyboardFrameEndUserInfoKey]; if ([v isKindOfClass:[NSValue class]]) f = v.CGRectValue; }
    CGSize scr = [UIScreen mainScreen].bounds.size;
    BOOL docked = f.size.width >= scr.width - 1.0 && CGRectGetMaxY(f) >= scr.height - 1.0 && f.size.height > 150.0;
    gSMKeyboardShown = docked;
    gSMKeyboardFrame = docked ? f : CGRectZero;
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog([NSString stringWithFormat:@"[sm] keyboard will show: %@ (docked %d)", NSStringFromCGRect(f), docked]);
    %orig;
    SEL upd = NSSelectorFromString(@"_updateSoftwareKeyboardVisibleWithKeyboardShowing:");
    id me = self;
    if (DMSMFree() && docked && [me respondsToSelector:upd]) ((void (*)(id, SEL, BOOL))objc_msgSend)(me, upd, YES);
}
- (void)_keyboardWillHide:(id)n {
    gSMKeyboardShown = NO; gSMKeyboardFrame = CGRectZero;
    if (DMTestFlag("/tmp/macstatusbar-debug")) DMLog(@"[sm] keyboard will hide");
    %orig;
}
- (void)_updateSoftwareKeyboardVisibleWithKeyboardShowing:(BOOL)showing {
    %orig(DMSMFree() ? (showing && gSMKeyboardShown) : showing);
}
- (BOOL)prefersStripHidden {
    return DMSMFree() ? YES : %orig;
}
%end
// The container the attributes lay out in. Never through -containerBounds: on iPadOS 16.0 (20A8372, the M2 iPad Pro's factory build, Stage Manager
// switched on by hand) SpringBoard crashed inside it when our getter hooks below called it during a layout pass (issue #2, 1.1.3 frames
// symbolicated: the call in -maximumWindowWidthForOverlapping). Its backing ivar is read instead, only where it is a CGRect (16.5 and later);
// otherwise the largest connected screen -- these values only raise Stage Manager's caps, and each window is still kept inside its own screen
// by the stage area (_stageAreaForModel) and the size rounding (_nearestGridSizeForSize, capped to the bounds it is given).
static CGRect DMSMContainerBoundsOf(id attrs) {
    static Ivar iv; static dispatch_once_t once;
    dispatch_once(&once, ^{
        Class c = objc_getClass("SBSwitcherChamoisLayoutAttributes");
        Ivar i = c ? class_getInstanceVariable(c, "_containerBounds") : NULL;
        const char *t = i ? ivar_getTypeEncoding(i) : NULL;
        if (t && strncmp(t, "{CGRect=", 8) == 0) iv = i;
    });
    if (attrs && iv && [attrs isKindOfClass:objc_getClass("SBSwitcherChamoisLayoutAttributes")]) {
        CGRect r; memcpy(&r, (const char *)(__bridge const void *)attrs + ivar_getOffset(iv), sizeof r);
        if (isfinite(r.size.width) && isfinite(r.size.height) && r.size.width >= 100.0 && r.size.height >= 100.0 && r.size.width < 20000.0 && r.size.height < 20000.0) return r;
    }
    CGRect best = [UIScreen mainScreen].bounds;
    for (UIScreen *sc in [UIScreen screens]) if (sc.bounds.size.width * sc.bounds.size.height > best.size.width * best.size.height) best = sc.bounds;
    return best;
}
// Our engine's stage area, from Apple's (r) for a screen of `b` with this Dock height: one rule for both layout engines (iPadOS 16's
// -_stageAreaForModel:..., 17's -stageAreaForSpace:configuration:). Also records each screen's Dock height (gSMDockHeightBySize).
static CGRect DMSMOurStageArea(CGRect r, CGRect b, double dock, BOOL strip, BOOL dh) {
    if (dock > 0 && !CGRectIsEmpty(b)) {   // (each display's Dock height as Stage Manager lays out with it: the TV's layouts end above the TV's Dock)
        if (!gSMDockHeightBySize) gSMDockHeightBySize = [NSMutableDictionary dictionary];
        gSMDockHeightBySize[NSStringFromCGSize(b.size)] = @(dock);
    }
    // Our engine: the whole desktop is the stage -- no room kept for the (hidden) recent-stages strip on the left or for the Dock at the bottom
    // (a window may sit behind the Dock, as on a Mac); the top stays Apple's (menu bar + our title bar, see _statusBarHeight).
    // The bottom: above this screen's Dock while the Dock shows, so every window Stage Manager places itself (a new stage's first window at its
    // default size, a remembered stage, the switcher, Spotlight, links) ends above it -- logic test F1 (a report from use): the first window of a new
    // stage came up under the Dock. Apple's own area only ends 48 pt above the screen edge (it hides the Dock over windows; our Dock stays). While
    // a window is being dragged by its title bar (and a moment after, while its new place is laid out) the area reaches the screen's bottom edge:
    // a window can be put behind the Dock by hand, as on a Mac.
    CGRect apple = r;
    // (a full-screen layout -- Apple gives it the whole screen -- is left exactly as Apple has it: 1.1.0 shortened it to end above the Dock too,
    //  and a full-screen Safari came up 648 pt tall with its top cut off, iPad 2 29 Sep 08:09)
    BOOL fullScreenLayout = CGRectEqualToRect(CGRectIntegral(r), CGRectIntegral(b));
    if (DMSMFree() && !fullScreenLayout && !CGRectIsEmpty(r) && !CGRectIsEmpty(b)) {
        BOOL dragging = CACurrentMediaTime() < gSMDragUntil;
        CGFloat line = CGRectGetMaxY(b) - dock - 2.0;
        // (a window put behind the Dock by hand keeps its place: the next layout pass kept every window inside the area and pulled it up.
        //  Which windows those are is recorded when a title-bar drag ends -- guessing it from sizes misfired after a turn, logic review R2)
        BOOL behind = NO;
        if (!dragging && !dh && dock > 0 && gSMBehindDock.count) {
            for (id al in DMSMRecentStages()) {
                BOOL onThis = DMSMIsMainIdentity(DMSMStageDisplayIdentity(al)) == CGSizeEqualToSize(b.size, [UIScreen mainScreen].bounds.size);
                if (!onThis) continue;
                for (id it in DMSMStageItemsMap(al)) if ([gSMBehindDock containsObject:DMSMItemBundle(it)]) { behind = YES; break; }
                break;
            }
        }
        CGFloat bottom = (dh || dock <= 0 || dragging || behind) ? CGRectGetMaxY(b) : line;
        r = CGRectMake(CGRectGetMinX(b), CGRectGetMinY(r), CGRectGetWidth(b), MAX(100.0, bottom - CGRectGetMinY(r)));
    }
    static NSString *last;
    NSString *line = [NSString stringWithFormat:@"[sm] stage area %@ (Apple's %@, bounds %@, dock %.0f, strip hidden %d, dock hidden %d)", NSStringFromCGRect(r), NSStringFromCGRect(apple), NSStringFromCGRect(b), dock, strip, dh];
    if (![line isEqualToString:last]) { last = line; DMLog(line); }
    return r;
}
%hook SBSwitcherChamoisLayoutAttributes
// (the window sizes Stage Manager allows, a list of widths and one of heights ~10 pt apart up to 48 pt short of the edges; a size is rounded to them.
//  Our engine: every whole point up to the screen size -- one cached list per length, so exact sizes cost nothing)
static NSArray<NSNumber *> *DMSMFineGrid(NSArray *orig, CGFloat full) {
    static NSMutableDictionary<NSString *, NSArray *> *cache;
    if (![orig isKindOfClass:[NSArray class]] || orig.count == 0 || !isfinite(full) || full < 100.0 || full > 20000.0) return orig;
    // (only a list of numbers, as on 16.7.7: anything else -- boxed values, objects of another kind -- is Apple's as it is; a KVC @min over it
    //  threw inside Stage Manager's layout pass, review S6)
    CGFloat lo = CGFLOAT_MAX;
    for (id x in orig) { if (![x isKindOfClass:[NSNumber class]]) return orig; lo = MIN(lo, [x doubleValue]); }
    if (!isfinite(lo) || lo < 1.0 || lo > full) return orig;
    NSString *key = [NSString stringWithFormat:@"%.0f-%.0f", lo, full];
    NSArray *hit = cache[key];
    if (hit) return hit;
    NSMutableArray *a = [NSMutableArray arrayWithCapacity:(NSUInteger)(full - lo + 1)];
    for (CGFloat v = ceil(lo); v <= full; v += 1.0) [a addObject:@(v)];
    if (!cache) cache = [NSMutableDictionary dictionary];
    cache[key] = a;
    DMLog([NSString stringWithFormat:@"[sm] size grid %.0f..%.0f (Apple's: %lu sizes, %@ .. %@)", lo, full, (unsigned long)orig.count, orig.firstObject, orig.lastObject]);
    return a;
}
- (double)stageOccludedAppScale {   // (a covered background window shrank: on a Mac windows keep their size)
    return DMSMFree() ? 1.0 : %orig;
}
- (double)stageOcclusionDodgingPeekScale {
    return DMSMFree() ? 1.0 : %orig;
}
- (double)maximumWindowWidthForOverlapping {
    double v = %orig;
    if (!DMSMFree()) return v;
    CGRect b = DMSMContainerBoundsOf(self);
    return MAX(v, CGRectGetWidth(b));
}
- (double)maximumWindowHeightWithDock {
    double v = %orig;
    if (!DMSMFree()) return v;
    CGRect b = DMSMContainerBoundsOf(self);
    return MAX(v, CGRectGetHeight(b));
}
%end
// Stage Manager's own resize grabbers (a luma-dodge pill in each corner, shown at the bottom and popping up on a touch): with our handles never
// visible; with Stage Manager's and Tint Resize Handles, drawn in the app's tint instead of white (a tinted view in place of the pill, inside the
// grabber's own corner-arc shape).
@interface SBAppResizeGrabberView : UIView
@end
static char kSMGrabberTintKey;
static char kSMGrabberAppleAlphaKey;
static void DMSMReapplyGrabbers(UIView *card) {   // (Settings > Resize Handles changed: each grabber shown as Apple last asked, or hidden)
    UIView *page = DMSMPageViewOf(card);
    for (UIView *g in page.subviews) {
        if (![NSStringFromClass([g class]) isEqualToString:@"SBAppResizeGrabberView"]) continue;
        NSNumber *a = objc_getAssociatedObject(g, &kSMGrabberAppleAlphaKey);
        g.alpha = a ? a.doubleValue : g.alpha;   // (through the hook: 0 with our handles)
        [g setNeedsLayout];
    }
}
// Every launch joins the desktop (logic test SM-1): an app opened from Spotlight, a notification, a link, our menus, the Home Screen or as a 5th
// window came in as the transition's "activating" app with no layout roles, and Stage Manager made it a stage of its own -- every open window
// vanished into the (hidden) strip. Here, as the transition is finalized: an app activated on the iPad's screen, with no roles set, while the
// desktop (the most recent stage there) has windows and not this app, is added to that desktop instead -- the windows keep their roles and places
// (at most three kept: the oldest of four is left out, minimized as it were), the app joins as a window (DMSMJoinAttributes) in front.
// Our own requests set roles, so they pass untouched. debug /tmp/msb-sm-ctxlog: each context logged.
%hook SBWorkspaceApplicationSceneTransitionContext
- (void)finalize {
    id me = self;
    if (DMSMFree()) {
        @try { DMSMJoinDesktop(me); } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[smengine] joining the desktop failed: %@", e.reason]); }
    }
    %orig;
}
%end
// Which corners a FINGER may resize a window from: Stage Manager allows only the trailing bottom corner for touch (the pointer may use any), and its
// live-resize gesture refuses a touch anywhere else (-[SBFluidSwitcherGestureManager _shouldLiveResizeItemContainerGestureWithTouch:receiveTouch:]
// reads this, SpringBoard.framework +0x605a20, 16.7.7). Our resize handles are drawn in BOTH bottom corners, like our other engines', so the left
// one did nothing (iPad 2, 29 Sep): with our handles, both bottom corners take a touch.
%hook SBFluidSwitcherItemContainer
- (unsigned long long)allowedTouchResizeCorners {
    unsigned long long c = %orig;
    if (DMSMFree() && !gSMAppleHandles && c) { DM_FEATURE_MARK("sm-resize-both-corners"); c |= UIRectCornerBottomLeft | UIRectCornerBottomRight; }
    return c;
}
%end
%hook SBAppResizeGrabberView
- (void)setAlpha:(CGFloat)a {
    objc_setAssociatedObject(self, &kSMGrabberAppleAlphaKey, @(a), OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // (what Apple wants: back when the style changes)
    %orig((DMSMEngine() && !gSMAppleHandles) ? 0.0 : a);
}
- (void)layoutSubviews {
    %orig;
    if (!DMSMEngine()) return;
    UIView *me = (UIView *)self;
    if (!gSMAppleHandles && me.alpha > 0) me.alpha = 0;
    UIView *pill = nil;
    for (UIView *v in me.subviews) if ([NSStringFromClass([v class]) containsString:@"Pill"]) pill = v;
    UIView *tint = objc_getAssociatedObject(me, &kSMGrabberTintKey);
    UIView *card = DMSMCardOfView(me);
    BOOL dark = me.traitCollection.userInterfaceStyle == UIUserInterfaceStyleDark;
    UIColor *tc = card ? DMResizeGripColorFor(DMSMCardBundle(card), dark) : nil;
    BOOL tinted = tc && ![tc isEqual:DMResizeGripColor(dark)];   // (an app with no tint of its own keeps Apple's white arc)
    BOOL want = gSMAppleHandles && gTintGrips && pill && card && tinted;
    pill.hidden = want;
    if (!want) { tint.hidden = YES; return; }
    if (!tint) {
        tint = [UIView new]; tint.userInteractionEnabled = NO;
        CAShapeLayer *arc = [CAShapeLayer layer];
        arc.fillColor = nil; arc.lineWidth = 4.0; arc.lineCap = kCALineCapRound;
        [tint.layer addSublayer:arc];
        objc_setAssociatedObject(me, &kSMGrabberTintKey, tint, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        [me addSubview:tint];
    }
    tint.hidden = NO;
    tint.frame = me.bounds;
    // (Apple's grabber: a quarter circle hugging the window's corner -- its centre is the grabber's corner that points into the window)
    UIView *page = me.superview;
    BOOL right = me.center.x > page.bounds.size.width / 2.0, bottom = me.center.y > page.bounds.size.height / 2.0;
    CGFloat w = me.bounds.size.width, h = me.bounds.size.height, r = MIN(w, h) - 3.0;
    CGPoint c = CGPointMake(right ? 0 : w, bottom ? 0 : h);
    CGFloat start = right ? (bottom ? 0 : -M_PI_2) : (bottom ? M_PI_2 : M_PI);
    CAShapeLayer *arc = (CAShapeLayer *)tint.layer.sublayers.firstObject;
    arc.frame = tint.bounds;
    arc.path = [UIBezierPath bezierPathWithArcCenter:c radius:r startAngle:start endAngle:start + M_PI_2 clockwise:YES].CGPath;
    arc.strokeColor = [tc colorWithAlphaComponent:0.95].CGColor;
}
%end
%hook SBAppSwitcherPageView
- (void)setMaskedCorners:(unsigned long long)m {
    objc_setAssociatedObject(self, &kSMAppleCornersKey, @(m), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (DMSMEngine() && DMSMCardHasBar(DMSMCardOfView((UIView *)self))) m &= (kCALayerMinXMaxYCorner | kCALayerMaxXMaxYCorner);   // (bottom corners only: the bar has the top ones)
    %orig(m);
}
- (void)layoutSubviews {
    %orig;
    if (!DMSMEngine()) return;
    UIView *me = (UIView *)self;
    if (!DMSMCardHasBar(DMSMCardOfView(me))) return;
    unsigned long long top = kCALayerMinXMinYCorner | kCALayerMaxXMinYCorner;
    if ([self maskedCorners] & top) [self setMaskedCorners:[self maskedCorners]];   // (the page was built after our bar: its top corners now, via the hook above)
    Class sc = objc_getClass("SBAppSwitcherPageShadowView");
    for (UIView *v in me.subviews) if (sc && [v isKindOfClass:sc]) {   // (one shadow for bar and window)
        CGRect want = CGRectMake(0, -kSMBarH, me.bounds.size.width, me.bounds.size.height + kSMBarH);
        if (!CGRectEqualToRect(v.frame, want)) v.frame = want;
    }
}
%end
%hook SBFluidSwitcherItemContainer
- (void)layoutSubviews {
    %orig;
    DMSMChrome((UIView *)self);
}
%end
%hook SBReusableSnapshotItemContainer   // (the window card class overrides -layoutSubviews without passing through the one above)
- (void)layoutSubviews {
    %orig;
    DMSMChrome((UIView *)self);
}
// (a new card lays itself out before it is named "card:<app>:..." -- the bar comes when it gets its name, or enters a window)
- (void)setAccessibilityIdentifier:(NSString *)ident {
    %orig;
    UIView *me = (UIView *)self;
    dispatch_async(dispatch_get_main_queue(), ^{ DMSMChrome(me); });
}
- (void)didMoveToWindow {
    %orig;
    if (((UIView *)self).window) DMSMChrome((UIView *)self);
}
// the card's touch area includes our title bar above it
- (BOOL)pointInside:(CGPoint)p withEvent:(UIEvent *)e {
    UIView *bar = objc_getAssociatedObject(self, kSMBarKey);
    if (bar && !bar.hidden && CGRectContainsPoint(bar.frame, p)) return YES;
    return %orig;
}
- (UIView *)hitTest:(CGPoint)p withEvent:(UIEvent *)e {
    UIView *bar = objc_getAssociatedObject(self, kSMBarKey);
    if (bar && !bar.hidden && CGRectContainsPoint(bar.frame, p)) return [bar hitTest:[self convertPoint:p toView:bar] withEvent:e] ?: bar;
    return %orig;
}
%end
// Apple's "..." window menu dots: our title bar and traffic lights do their work
%hook SBTopAffordanceDotsView
- (void)setAlpha:(CGFloat)a {
    %orig(DMSMEngine() && !DMTestFlag("/tmp/msb-sm-nochrome") ? 0.0 : a);
}
%end
%hook SBSwitcherChamoisSettings
// the stage starts below the top bar: ours is 24 pt (iPadOS's is 20), so windows at the top edge are not under it
- (CGFloat)_statusBarHeight {
    CGFloat h = %orig;
    static BOOL logged; if (!logged) { logged = YES; DMLog([NSString stringWithFormat:@"[smengine] Stage Manager's status bar height %.1f", h]); }
    return DMSMEngine() ? MAX(h, 24.0) + (DMTestFlag("/tmp/msb-sm-nochrome") ? 0.0 : kSMBarH) : h;   // (+ our title bar above each window)
}
// no recent-stages strip on the left: like a Mac, other apps are in the Dock (minimized windows too)
- (BOOL)_shouldPreferStripHiddenForWindowScene:(id)scene interfaceOrientation:(long long)o {
    return DMSMEngine() && !DMTestFlag("/tmp/msb-sm-strip") ? YES : %orig;
}
%end
%end
// The size grid of 16.1 and later (the "size grid" group's lists variant): the window size lists and the snap to them -- installed only where the
// self-check chose it (16.0 rounds sizes with a grid object instead: SMGrid160; 1.3.4 logic test L3).
%group SMGridLists
%hook SBSwitcherChamoisLayoutAttributes
- (id)gridWidths {
    id v = %orig;
    if (!DMSMFree()) return v;
    return DMSMFineGrid(v, CGRectGetWidth(DMSMContainerBoundsOf(self)));
}
- (id)gridHeights {
    id v = %orig;
    if (!DMSMFree()) return v;
    return DMSMFineGrid(v, CGRectGetHeight(DMSMContainerBoundsOf(self)));
}
%end
%hook SBSwitcherChamoisSettings
// (sizes snap to Stage Manager's grid of window sizes; with our engine a window keeps the size it is given, like a Mac window -- inside the screen)
- (CGSize)_nearestGridSizeForSize:(CGSize)size gridWidths:(id)gw gridHeights:(id)gh bounds:(CGRect)b {
    CGSize o = %orig;
    if (!DMSMFree() || size.width <= 0 || size.height <= 0) return o;
    CGFloat maxW = CGRectGetWidth(b) > 0 ? CGRectGetWidth(b) : size.width;
    CGFloat maxH = CGRectGetHeight(b) > 0 ? CGRectGetHeight(b) : size.height;
    // (and no taller than the stage area, which ends above this screen's Dock: a new window at Stage Manager's own size, 672 pt in landscape, is
    //  taller than the area once the Dock is up, and Stage Manager kept its bottom above the Dock by pushing its top under the menu bar -- the
    //  title bar and traffic lights hidden, iPad 2 29 Sep 21:12, Reynard)
    NSNumber *dock = gSMDockHeightBySize[NSStringFromCGSize(b.size)];
    if (dock.doubleValue > 0 && CGRectGetHeight(b) > 0) maxH = MIN(maxH, CGRectGetHeight(b) - dock.doubleValue - 2.0 - (24.0 + kSMBarH));
    CGSize r = CGSizeMake(MIN(size.width, maxW), MIN(size.height, maxH));
    static int logged = 0;
    if (logged < 3) {
        logged++;
        DMLog([NSString stringWithFormat:@"[sm] grid size %@ -> kept %@ (the grid: %@)", NSStringFromCGSize(size), NSStringFromCGSize(r), NSStringFromCGSize(o)]);
    }
    return r;
}
%end
%end
// iPadOS 16's layout engine (SBChamoisOverlappingController): SMLayout161 (16.1+'s pass) and SMLayout16 (what every 16.x shares), below.
// Apple's auto-layout (-_modelByPerformingAutoLayoutForModel:...stageInset:, SpringBoard.framework 0x12ad90, iPad 2 16.7.7): after the two
// centering steps, when nothing is being dragged, a stage with ONE window gets that window's center y set to the middle of the stage area
// (inline code: items.count == 1 -> centerForItem: -> setCenter:{x, midY(stage area)} forItem:). That is why a lone window never kept the height it
// was put at (Left Half 60 pt low). Our engine: that one setCenter keeps the window's own y. The flag is set by the horizontal-centering step, which
// runs right before it, and cleared when the pass ends.
static BOOL gSMLoneCenterNext = NO;
static BOOL gSMLoneCenterBoth = NO;   // (iPadOS 16.0's pass centres the lone window's x too: then both are kept -- %group SMLayout160)
// iPadOS 16.1+'s layout pass (the "auto layout" group's 16.1 variant: the tested one, always chosen on 16.1 and later): installed only where the
// self-check chose it, so on 16.0 nothing is hooked that is not there (16.0's own pass: SMLayout160; 1.3.4 logic test L3).
%group SMLayout161
%hook SBChamoisOverlappingController
- (CGRect)_stageAreaForModel:(id)m chamoisLayoutAttributes:(id)a floatingDockHeight:(double)dock bounds:(CGRect)b prefersStripHidden:(BOOL)strip prefersDockHidden:(BOOL)dh widthThresholdToHideContinuousExposeStrip:(double)w {
    CGRect r = %orig;
    return DMSMOurStageArea(r, b, dock, strip, dh);
}
- (id)_modelByPerformingAutoLayoutForModel:(id)m chamoisLayoutAttributes:(id)a draggingItem:(id)d modelBeforeDragging:(id)b floatingDockHeight:(double)dock bounds:(CGRect)r screenScale:(double)sc prefersStripHidden:(BOOL)sh prefersDockHidden:(BOOL)dh stageInset:(UIEdgeInsets)inset {
    gSMLoneCenterNext = NO;
    id out = %orig;
    gSMLoneCenterNext = NO;
    return out;
}
- (void)_compactSpacingHorizontallyForModel:(id)m withColumns:(id)c chamoisLayoutAttributes:(id)a {
    if (!DMSMFree()) %orig;
}
- (void)_compactSpacingVerticallyForModel:(id)m withColumns:(id)c chamoisLayoutAttributes:(id)a {
    if (!DMSMFree()) %orig;
}
- (void)_expandSpacingHorizontallyForModel:(id)m withColumns:(id)c modelBeforeDragging:(id)b chamoisLayoutAttributes:(id)a draggingItem:(id)d stageArea:(CGRect)r {
    if (!DMSMFree()) %orig;
}
- (void)_expandSpacingVerticallyForModel:(id)m withColumns:(id)c chamoisLayoutAttributes:(id)a stageArea:(CGRect)r {
    if (!DMSMFree()) %orig;
}
- (void)_horizontallyCenterModel:(id)m stageArea:(CGRect)r {
    if (!DMSMFree()) %orig;
    else gSMLoneCenterNext = YES;
}
- (void)_verticallyCenterModel:(id)m withColumns:(id)c stageArea:(CGRect)r {
    if (!DMSMFree()) %orig;
}
- (void)_dodgeFullyOccludedWindowsToNearestVisibleEdgeInModel:(id)m chamoisLayoutAttributes:(id)a draggingItem:(id)d bounds:(CGRect)r {
    if (!DMSMFree()) %orig;
}
%end
%end
// iPadOS 16's layout engine, the parts every 16.x has under these names (snap, the lone window's centre): installed with SMEngine when the
// self-check picked the 16 table (DMSMLayoutGen).
%group SMLayout16
%hook SBChamoisOverlappingController
- (void)_snapPositionToNearestEdgesIfNecessary:(id)m draggingItem:(id)d {
    if (!DMSMFree()) %orig;
}
%end
@interface SBMutableChamoisOverlappingModel : NSObject
@end
%hook SBMutableChamoisOverlappingModel
- (void)setCenter:(CGPoint)c forItem:(id)item {
    if (gSMPostPass160 && DMSMFree()) {   // (iPadOS 16.0's group shift after its layout pass -- SMEngineAPI.h, DMSMShift160X: the window keeps its x)
        SEL get = NSSelectorFromString(@"centerForItem:");
        if (DMSMSigOK(self, get, DMSMSigCenterFor(), "centerForItem:")) c.x = DMSMShift160X(YES, c.x, ((CGPoint (*)(id, SEL, id))objc_msgSend)(self, get, item).x);
    }
    if (gSMLoneCenterNext && DMSMFree()) {   // (the lone-window re-centering, see above: keep the y the window has -- and on iPadOS 16.0 the x too)
        BOOL both = gSMLoneCenterBoth;
        gSMLoneCenterNext = NO; gSMLoneCenterBoth = NO;
        SEL get = NSSelectorFromString(@"centerForItem:");
        if (DMSMSigOK(self, get, DMSMSigCenterFor(), "centerForItem:")) {   // (checked at start too; a coordinate that is not a number is not kept)
            CGPoint own = ((CGPoint (*)(id, SEL, id))objc_msgSend)(self, get, item);
            if (isfinite(own.y)) c.y = own.y;
            if (both && isfinite(own.x)) c.x = own.x;
        }
    }
    %orig(c, item);
}
%end
%end
// iPadOS 16: Stage Manager's own step that keeps every window inside the stage area (-[SBChamoisOverlappingController _constrainModelVertically:
// toStageArea:] / ...Horizontally:) keeps a window TALLER than the area with its bottom on the area's bottom: its top goes above the area, under the
// menu bar, our title bar and traffic lights out of reach (iPad 2, 3 Oct: Settings back from full screen, 737 pt tall in the 649 pt landscape area,
// its top at -40). Our engine's rule, as in the iPadOS 17 pass (DMSMClampCenter): the TOP edge wins -- such a window starts at the area's top and
// reaches down behind the Dock; too wide, its LEFT edge (the traffic lights) wins. Our own requests never ask for a window bigger than the desktop
// (DMSMPlanFitted); this rule is for the windows Stage Manager brings back by itself (a stage kept from the other shape: one left hidden while the
// iPad turned, the App Switcher). Full-screen-sized windows are Apple's (SMFit.h DMSMFitEdgesWin). Optional (not in the start-up check): another
// name or signature on another iPadOS leaves Apple's step as it is, and says so.
static void (*o_SMConstrainV)(id, SEL, id, CGRect), (*o_SMConstrainH)(id, SEL, id, CGRect);
static void DMSMConstrainEdges16(id m, CGRect area, int vertical) {
    if (!DMSMFree() || !DMSMRectSane(area)) return;
    SEL itemsS = NSSelectorFromString(@"items"), sizeS = NSSelectorFromString(@"sizeForItem:"), centerS = NSSelectorFromString(@"centerForItem:");
    SEL setS = NSSelectorFromString(@"setCenter:forItem:"), contS = NSSelectorFromString(@"containerBounds");
    if (!DMSMSigOK(m, itemsS, DMSMSigObj(), "items") || !DMSMSigOK(m, sizeS, DMSMSigSizeFor(), "sizeForItem:") || !DMSMSigOK(m, centerS, DMSMSigCenterFor(), "centerForItem:")
        || !DMSMSigOK(m, setS, DMSMSigSetCenter(), "setCenter:forItem:")) return;
    CGSize container = CGSizeZero;
    if (DMSMSigOK(m, contS, DMSMSigRect(), "containerBounds")) { CGRect cb = ((CGRect (*)(id, SEL))objc_msgSend)(m, contS); if (DMSMRectSane(cb)) container = cb.size; }
    if (!(container.width > 0) || !(container.height > 0)) return;   // (no container known: a full-screen window can't be told apart -- Apple's step as it is)
    id items = ((id (*)(id, SEL))objc_msgSend)(m, itemsS);
    NSArray *list = [items isKindOfClass:[NSArray class]] ? [(NSArray *)items copy] : [items isKindOfClass:[NSOrderedSet class]] ? [(NSOrderedSet *)items array]
                  : [items isKindOfClass:[NSSet class]] ? [(NSSet *)items allObjects] : nil;   // (a copy: the centers change while we go through them)
    for (id it in list) {
        CGSize s = ((CGSize (*)(id, SEL, id))objc_msgSend)(m, sizeS, it);
        CGPoint c = ((CGPoint (*)(id, SEL, id))objc_msgSend)(m, centerS, it), was = c;
        if (!DMSMFitEdgesWin(&c, s, area, container, vertical)) continue;
        BOOL lone = gSMLoneCenterNext; gSMLoneCenterNext = NO;   // (our move is not the lone window's re-centring, which our setCenter: hook keeps out)
        ((void (*)(id, SEL, CGPoint, id))objc_msgSend)(m, setS, c, it);
        gSMLoneCenterNext = lone;
        DM_FEATURE_MARK("sm-top-edge-wins");
        static int logged = 0;
        if (logged < 30) { logged++; DMLog([NSString stringWithFormat:@"[sm] %@ (%.0f x %.0f pt) bigger than the stage area %@: %@ edge kept inside, center %@ -> %@", DMSMItemBundle(it) ?: @"a window", s.width, s.height, NSStringFromCGRect(area), vertical ? @"top" : @"left", NSStringFromCGPoint(was), NSStringFromCGPoint(c)]); }
    }
}
static void DMSMConstrainV16(id self, SEL _cmd, id m, CGRect area) { o_SMConstrainV(self, _cmd, m, area); DMSMConstrainEdges16(m, area, 1); }
static void DMSMConstrainH16(id self, SEL _cmd, id m, CGRect area) { o_SMConstrainH(self, _cmd, m, area); DMSMConstrainEdges16(m, area, 0); }
static void DMSMHookConstrain16(void) {
    static BOOL done = NO;
    if (done) return;
    done = YES;
    Class oc = objc_getClass("SBChamoisOverlappingController"), mc = objc_getClass("SBMutableChamoisOverlappingModel");
    SEL v = NSSelectorFromString(@"_constrainModelVertically:toStageArea:"), h = NSSelectorFromString(@"_constrainModelHorizontally:toStageArea:");
    NSString *want = DMSMExpect(@encode(void), @encode(id), @encode(CGRect), NULL);
    Method mv = oc ? class_getInstanceMethod(oc, v) : NULL, mh = oc ? class_getInstanceMethod(oc, h) : NULL;
    // (the model's readers and writer as the rule uses them, on the mutable model Apple's pass works on)
    Method ms = mc ? class_getInstanceMethod(mc, NSSelectorFromString(@"sizeForItem:")) : NULL, mcf = mc ? class_getInstanceMethod(mc, NSSelectorFromString(@"centerForItem:")) : NULL;
    Method mset = mc ? class_getInstanceMethod(mc, NSSelectorFromString(@"setCenter:forItem:")) : NULL, mit = mc ? class_getInstanceMethod(mc, NSSelectorFromString(@"items")) : NULL;
    Method mcb = mc ? class_getInstanceMethod(mc, NSSelectorFromString(@"containerBounds")) : NULL;   // (tells a full-screen window, which the rule leaves alone)
    BOOL model = ms && mcf && mset && mit && mcb && [DMSMSigOfMethod(ms) isEqualToString:DMSMSigSizeFor()] && [DMSMSigOfMethod(mcf) isEqualToString:DMSMSigCenterFor()]
              && [DMSMSigOfMethod(mset) isEqualToString:DMSMSigSetCenter()] && [DMSMSigOfMethod(mit) isEqualToString:DMSMSigObj()]
              && [DMSMSigOfMethod(mcb) isEqualToString:DMSMSigRect()];
    if (!model || !mv || !mh || ![DMSMSigOfMethod(mv) isEqualToString:want] || ![DMSMSigOfMethod(mh) isEqualToString:want]) {
        DMLog(@"[smengine] Stage Manager's stage-area constraint is not as expected here: windows bigger than the stage area are kept as Apple keeps them");
        return;
    }
    MSHookMessageEx(oc, v, (IMP)DMSMConstrainV16, (IMP *)&o_SMConstrainV);
    MSHookMessageEx(oc, h, (IMP)DMSMConstrainH16, (IMP *)&o_SMConstrainH);
    DMLog(@"[smengine] a window bigger than the stage area keeps its top and left edges inside (title bar and traffic lights on the screen)");
}
#include "SMDesktop.h"   // (the Home Screen behind the windows, one desktop for SpringBoard's own transitions: 4 Oct, sm-desktop)
// The windows' corner radius (Stage Manager's own: rounder than a Mac window): under whichever name this iPadOS has (stageCornerRaddii, sic,
// through 17; stageCornerRadii from 18.2 -- kSMNeeds' alt name, DMSMCornerRadiusSelector).
%group SMCornerRaddii
%hook SBSwitcherChamoisLayoutAttributes
- (double)stageCornerRaddii {   // (sic) the windows' corner radius
    return DMSMFree() ? kSMCornerR : %orig;
}
%end
%end
%group SMCornerRadii
%hook SBSwitcherChamoisLayoutAttributes
- (double)stageCornerRadii {
    return DMSMFree() ? kSMCornerR : %orig;
}
%end
%end
// iPadOS 16.0's layout pass (sm-160; installed only where the check chose the "auto layout" group's 16.0 variant). The same steps as 16.1's under other
// names and argument lists -- decompiled from 20A371 and 20A5349b, -[SBChamoisOverlappingController modelForPreferredModel:initialStageFrame:
// layoutAttributes:draggingItem:modelBeforeDragging:]: snap, keep inside the stage frame, compact and expand the spacing, centre vertically and
// horizontally, a lone window centred on the stage frame (x and y here, 16.1+ only y), dodge. The stage frame is -[SBDisplayItemLayoutAttributesCalculator
// initialStageFrameForAppLayout:...] (16.1+: -_stageAreaForModel:...): ours, full width under the menu bar, above this screen's Dock. After the pass
// the 16.0 calculator moves the whole group sideways toward the middle when it lies right of the centred place (not zero with a full-width frame:
// 1.3.4 logic test, decoded from its block) -- held off for our engine, the windows keep their x (SMEngineAPI.h, DMSMShift160X; the bounding box
// here, the centres in SMLayout16's -setCenter:forItem:). Snap and the lone window's centre are hooked in SMLayout16 (same names on 16.0). Never run
// on a device: Settings says "untested".
%group SMLayout160
%hook SBDisplayItemLayoutAttributesCalculator
- (CGRect)initialStageFrameForAppLayout:(id)al containerOrientation:(long long)o chamoisLayoutAttributes:(id)a floatingDockHeight:(double)dock screenScale:(double)sc bounds:(CGRect)b prefersStripHidden:(BOOL)strip prefersDockHidden:(BOOL)dh {
    CGRect r = %orig;
    return DMSMOurStageArea(r, b, dock, strip, dh);
}
- (id)_appLayoutByPerformingAutoLayoutIfNeededInAppLayout:(id)al containerOrientation:(long long)o chamoisLayoutAttributes:(id)a floatingDockHeight:(double)dock screenScale:(double)sc draggingItem:(id)d overlappingModelBeforeDragging:(id)b bounds:(CGRect)r prefersStripHidden:(BOOL)strip prefersDockHidden:(BOOL)dh {
    DMSMCalc160Enter();   // (its layout pass, then the group shift: DMSMPass160End marks the pass over)
    id out = %orig;
    DMSMCalc160Exit();
    return out;
}
%end
%hook SBChamoisOverlappingModel
- (void)setBoundingBox:(CGRect)box {
    if (gSMPostPass160 && DMSMFree()) {   // (16.0's group shift: the bounding box keeps its x, as its windows do)
        SEL get = NSSelectorFromString(@"boundingBox");
        if (DMSMSigOK(self, get, DMSMSigRect(), "boundingBox")) {
            CGRect cur = ((CGRect (*)(id, SEL))objc_msgSend)(self, get);
            CGFloat x = DMSMShift160X(YES, box.origin.x, cur.origin.x);
            static int logged = 0;
            if (x != box.origin.x && logged < 3) { logged++; DMLog([NSString stringWithFormat:@"[sm] iPadOS 16.0's group shift held off: the windows keep their x (%.1f pt asked)", box.origin.x - x]); }
            box.origin.x = x;
        }
    }
    %orig(box);
}
%end
%hook SBChamoisOverlappingController
- (id)modelForPreferredModel:(id)m initialStageFrame:(CGRect)f layoutAttributes:(id)a draggingItem:(id)d modelBeforeDragging:(id)b {
    gSMLoneCenterNext = NO; gSMLoneCenterBoth = NO;
    DMSMPass160Begin();
    id out = %orig;
    gSMLoneCenterNext = NO; gSMLoneCenterBoth = NO;
    DMSMPass160End();   // (inside the calculator: its group shift comes next)
    return out;
}
- (void)_compactSpacingHorizontallyForModel:(id)m withColumns:(id)c layoutAttributes:(id)a {
    if (!DMSMFree()) %orig;
}
- (void)_compactSpacingVerticallyForModel:(id)m withColumns:(id)c layoutAttributes:(id)a {
    if (!DMSMFree()) %orig;
}
- (void)_expandSpacingHorizontallyForModel:(id)m withColumns:(id)c previousResolvedModelIfAny:(id)p layoutAttributes:(id)a draggingItem:(id)d {
    if (!DMSMFree()) %orig;
}
- (void)_expandSpacingVerticallyForModel:(id)m withColumns:(id)c layoutAttributes:(id)a {
    if (!DMSMFree()) %orig;
}
- (void)_horizontallyCenterModel:(id)m {
    if (!DMSMFree()) %orig;
    else { gSMLoneCenterNext = YES; gSMLoneCenterBoth = YES; }   // (the lone window's centring right after: keep its own place)
}
- (void)_verticallyCenterModel:(id)m withColumns:(id)c {
    if (!DMSMFree()) %orig;
}
- (void)_dodgeFullyOccludedWindowsToNearestVisibleEdgeInModel:(id)m layoutAttributes:(id)a draggingItem:(id)d {
    if (!DMSMFree()) %orig;
}
%end
%end
// iPadOS 16.0's size grid (sm-160; "size grid" chose its 16.0 variant): sizes are rounded by -[SBDisplayItemLayoutGrid nearestGridSizeForProposedSize:...]
// (16.1+: the gridWidths / gridHeights lists and -_nearestGridSizeForSize:..., hooked in SMEngine). Our engine: a window keeps the size it is given,
// from Apple's smallest grid size up to the bounds, and no taller than the stage area above this screen's Dock -- as on 16.1+.
%group SMGrid160
%hook SBDisplayItemLayoutGrid
- (CGSize)nearestGridSizeForProposedSize:(CGSize)size inBounds:(CGRect)b contentOrientation:(long long)o layoutRestrictionInfo:(id)info screenScale:(double)sc chamoisLayoutAttributes:(id)a {
    CGSize g = %orig;
    if (!DMSMFree() || !isfinite(size.width) || !isfinite(size.height) || size.width <= 0 || size.height <= 0) return g;
    CGSize mn = CGSizeZero;
    SEL minSel = NSSelectorFromString(@"minGridSizeForBounds:contentOrientation:layoutRestrictionInfo:screenScale:chamoisLayoutAttributes:");
    if (DMSMSigOK(self, minSel, DMSMSigMinGrid(), "minGridSizeForBounds:")) mn = ((CGSize (*)(id, SEL, CGRect, long long, id, double, id))objc_msgSend)(self, minSel, b, o, info, sc, a);
    CGFloat maxW = CGRectGetWidth(b) > 0 ? CGRectGetWidth(b) : size.width, maxH = CGRectGetHeight(b) > 0 ? CGRectGetHeight(b) : size.height;
    NSNumber *dock = gSMDockHeightBySize[NSStringFromCGSize(b.size)];
    if (dock.doubleValue > 0 && CGRectGetHeight(b) > 0) maxH = MIN(maxH, CGRectGetHeight(b) - dock.doubleValue - 2.0 - (24.0 + kSMBarH));
    CGSize r = CGSizeMake(MIN(size.width, maxW), MIN(size.height, maxH));
    if (isfinite(mn.width) && isfinite(mn.height)) r = CGSizeMake(MAX(r.width, mn.width), MAX(r.height, mn.height));
    static int logged = 0;
    if (logged < 3) { logged++; DMLog([NSString stringWithFormat:@"[sm] grid size %@ -> kept %@ (16.0's grid: %@)", NSStringFromCGSize(size), NSStringFromCGSize(r), NSStringFromCGSize(g)]); }
    return r;
}
%end
%end
// ---- iPadOS 17's layout engine (SBContinuousExposeAutoLayoutController) -------------------------------------------------------------------------
// iPadOS 17 replaced SBChamoisOverlappingController / SBMutableChamoisOverlappingModel (the hooks of SMLayout16) with an auto-layout controller
// working on a "space" of "items" (SMEngineAPI.h). NOT RUN ON A DEVICE BY US: written from the 17.0.3 runtime headers (MTACS) and the 17.6.1
// decompile (SuperChaoM/iPhone15-3_17.6.1_21G101_Restore, SpringBoard.framework). What that decompile shows the 17 pass does:
//  -spaceByPerformingAutoLayoutWithSpace:previousSpace:configuration:options: -- with a previous space: (options & 1) new windows go to the stage's
//   left edge, vertically centred, and the whole group is re-centred; or, one window fewer than before (3+), the rest is compacted, dodged and the
//   group re-centred. Then -_performAutoLayoutWithSpace:configuration:stageInset: and bookkeeping (stage area, bounding box, strip visibility,
//   compacted frames for the switcher, peeking items).
//  -_performAutoLayoutWithSpace:... -- every window's center kept inside the container inset by the screen edge padding; windows with no place
//   (0,0) centred; ONE window "in its default position" centred in the stage area (the 16 lone-window re-centring, now x and y); otherwise snap to
//   edges and centre, dodge fully covered windows, scale anchors, and (covered windows peeking) the pass again with insets.
// Our engine keeps windows where they were put, like a Mac (as SMLayout16 does on 16):
//  - the stage area: the same rule as 16 (DMSMOurStageArea), with the bounds and Dock height from the configuration;
//  - no previous space handed to the pass (both of its re-arranging branches are skipped; nil is what Apple's own window-drag modifier passes);
//  - compaction, dodging and snapping skipped;
//  - the lone window keeps its place (its "default position" flag hidden from that one pass, then put back as it was);
//  - windows kept inside OUR stage area instead of the padded container (as 16 kept them inside the stage area): full-width windows, the top below
//    the menu bar and our title bar. A full-screen-sized window, a new window with no place yet, and anything unreadable: Apple's result as it is.
// Everything read or written through SMEngineAPI.h's checked wrappers; a refusal leaves Apple's pass alone. Diagnostics: DMSM17DiagSoon.
static unsigned gSM17Count[8];   // (how often each part acted, for the diagnostics record: 0 stage area, 1 no previous space, 2 compaction skipped,
                                 //  3 dodge skipped, 4 snap skipped, 5 lone window kept, 6 windows kept inside our stage area, 7 passes)
static NSString *gSM17LastArea;
static void DMSM17Note(int k) { if (k >= 0 && k < 8 && gSM17Count[k] < 1000) { gSM17Count[k]++; if (gSM17Count[k] == 1 || gSM17Count[k] == 50) DMSM17DiagSoon(); } }
static __thread int gSM17Depth = 0;   // (_performAutoLayout... runs itself again for peeking windows: only the outer pass is adjusted)
%group SMLayout17
%hook SBContinuousExposeAutoLayoutController
- (CGRect)stageAreaForSpace:(id)space configuration:(id)cfg {
    CGRect r = %orig;
    CGRect b; double dock = 0;
    // (the configuration unreadable, or Apple's area not a rectangle: Apple's area as it is)
    if (!DMSMRectSane(r) || !DMSMCfgBounds(cfg, &b) || !DMSMCfgDock(cfg, &dock)) return r;
    BOOL strip = DMSMCfgChamoisFlag(cfg, @"prefersStripHidden"), dh = DMSMCfgChamoisFlag(cfg, @"prefersDockHidden");
    CGRect o = DMSMOurStageArea(r, b, dock, strip, dh);
    if (!DMSMRectSane(o)) return r;
    if (!CGRectEqualToRect(o, r)) DMSM17Note(0);
    if (gSM17Count[0] < 20) {
        NSString *l = [NSString stringWithFormat:@"stage area %@ (Apple's %@, bounds %@, dock %.1f, strip hidden %d, dock hidden %d)", NSStringFromCGRect(o), NSStringFromCGRect(r), NSStringFromCGRect(b), dock, strip, dh];
        if (![l isEqualToString:gSM17LastArea]) { gSM17LastArea = l; DMSM17DiagSoon(); }
    }
    return o;
}
- (id)spaceByPerformingAutoLayoutWithSpace:(id)space previousSpace:(id)prev configuration:(id)cfg options:(unsigned long long)opt {
    if (!DMSMFree() || !prev) return %orig;
    DMSM17Note(1);
    if (DMTestFlag("/tmp/macstatusbar-debug") && gSM17Count[1] <= 3) DMLog([NSString stringWithFormat:@"[sm17] auto-layout without the previous space (options %llu): no re-centring of the group", opt]);
    return %orig(space, nil, cfg, opt);
}
- (CGRect)_performAutoLayoutWithSpace:(id)space configuration:(id)cfg stageInset:(UIEdgeInsets)inset {
    if (!DMSMFree() || gSM17Depth > 0) {
        gSM17Depth++;
        CGRect inner = %orig;
        gSM17Depth--;
        return inner;
    }
    DMSM17Note(7);
    NSArray *items = DMSMSpaceItems(space);
    CGRect container = CGRectZero;
    BOOL haveContainer = DMSMCfgBounds(cfg, &container);
    // (each window's place and size before Apple's pass; none for a window with no place yet (0,0), or a full-screen-sized one)
    NSMutableArray *before = [NSMutableArray array];
    for (id it in items) {
        CGPoint p; CGSize z;
        BOOL keep = haveContainer && DMSMItemPosition(it, &p) && DMSMItemSize(it, &z) && !(p.x == 0 && p.y == 0)
                 && !(z.width >= container.size.width - 1.0 && z.height >= container.size.height - 1.0);
        [before addObject:keep ? @[it, [NSValue valueWithCGPoint:p], [NSValue valueWithCGSize:z]] : [NSNull null]];
    }
    // the lone window keeps its place: Apple centres ONE window that is "in its default position"; hidden from this pass only
    id lone = nil;
    if (items.count == 1 && before.firstObject != [NSNull null]) {
        BOOL def = NO;
        if (DMSMItemInDefaultPosition(items.firstObject, &def) && def && DMSMItemSetInDefaultPosition(items.firstObject, NO)) lone = items.firstObject;
    }
    gSM17Depth++;
    CGRect area = %orig;
    gSM17Depth--;
    if (lone) { DMSMItemSetInDefaultPosition(lone, YES); DMSM17Note(5); }
    // every window inside our stage area (what Apple's pass returns: the area of -stageAreaForSpace:, ours), not the padded container
    if (DMSMRectSane(area)) {
        int moved = 0;
        for (id e in before) {
            if (e == [NSNull null]) continue;
            NSArray *en = e;
            CGPoint want = DMSMClampCenter([en[1] CGPointValue], [en[2] CGSizeValue], area), now;
            if (!DMSMItemPosition(en[0], &now) || (fabs(now.x - want.x) < 0.5 && fabs(now.y - want.y) < 0.5)) continue;
            if (DMSMItemSetPosition(en[0], want)) moved++;
        }
        if (moved) DMSM17Note(6);
        if (DMTestFlag("/tmp/macstatusbar-debug") && moved && gSM17Count[6] <= 10) DMLog([NSString stringWithFormat:@"[sm17] %d window(s) kept at their place inside the stage area %@", moved, NSStringFromCGRect(area)]);
    }
    return area;
}
- (void)_compactSpacingBetweenItemsInSpace:(id)space configuration:(id)cfg {
    if (DMSMFree()) { DMSM17Note(2); return; }
    %orig;
}
- (void)dodgeFullyOccludedWindowsToNearestVisibleEdgeForSpace:(id)space configuration:(id)cfg {
    if (DMSMFree()) { DMSM17Note(3); return; }
    %orig;
}
- (void)snapPositionToNearestEdgesIfNecessaryForSpace:(id)space stageArea:(CGRect)area configuration:(id)cfg {
    if (DMSMFree()) { DMSM17Note(4); return; }
    %orig;
}
%end
%end
// iPadOS 17 (untested, "Enable Anyway" on): what the engine's check found and what the 17 layout hooks did, as a diagnostics record for Report a
// Problem (common/Diag.h, "StageManager"; names and numbers only). A release build writes no log, so this is how a tester's report tells us whether
// the 17 port works. Written 2 s after a change (at most every 2 s); counts stop at 1000, so the record settles.
static NSUInteger gSMChecked;
static NSArray<NSString *> *gSMCheckBad;
static void DMSM17DiagWrite(void) {
    if (!MSBDDiagEnabled() || DMSMLayoutGen() != 17) return;
    NSOperatingSystemVersion v = [NSProcessInfo processInfo].operatingSystemVersion;
    NSMutableString *t = [NSMutableString stringWithFormat:@"iPadOS %ld.%ld.%ld (%@), layout engine table %@\n", (long)v.majorVersion, (long)v.minorVersion, (long)v.patchVersion, MSBDOSBuild() ?: @"?", DMSMLayoutName(17)];
    [t appendFormat:@"check: %@, %lu checked\n", gSMCheckOK ? @"passed" : gSMCheckDone ? @"FAILED" : @"not run", (unsigned long)gSMChecked];
    if (gSMCheckBad.count) [t appendFormat:@"missing/different (%lu): %@\n", (unsigned long)gSMCheckBad.count, [[gSMCheckBad subarrayWithRange:NSMakeRange(0, MIN(gSMCheckBad.count, (NSUInteger)12))] componentsJoinedByString:@"; "]];
    [t appendFormat:@"engine on %d, free placement %d\n", DMSMEngine(), DMSMFree()];
    [t appendFormat:@"acted: stage area %u, no previous space %u, compaction skipped %u, dodge skipped %u, snap skipped %u, lone window kept %u, kept inside area %u, passes %u\n",
        gSM17Count[0], gSM17Count[1], gSM17Count[2], gSM17Count[3], gSM17Count[4], gSM17Count[5], gSM17Count[6], gSM17Count[7]];
    if (gSM17LastArea) [t appendFormat:@"last %@\n", gSM17LastArea];
    if (gSMAPIFailures.count) [t appendFormat:@"refused (%lu): %@\n", (unsigned long)gSMAPIFailures.count, [[gSMAPIFailures.array subarrayWithRange:NSMakeRange(0, MIN(gSMAPIFailures.count, (NSUInteger)8))] componentsJoinedByString:@"; "]];
    MSBDDiagWrite(@"StageManager", t);
}
static void DMSM17DiagSoon(void) {
    if (DMSMLayoutGen() != 17 || !MSBDDiagEnabled()) return;
    static BOOL pending;
    if (pending) return;
    pending = YES;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ pending = NO; DMSM17DiagWrite(); });
}
// The start-up self-check (SMEngineAPI.h): once, in %ctor, before anything of the engine runs. Every class, method and signature the engine and its
// hooks use (kSMNeeds); only if all are there as expected are the hooks installed, and then checked to have gone in. Otherwise the engine stays
// off for this run (DMSMEngine() NO: the default engine, Stage Manager not switched on for us), and the verdict tells the root helper and Settings.
// Where Stage Manager can't run at all (iPadOS 15, no Stage Manager, no TrollPad) nothing is checked and nothing is hooked, as before.
// debug /tmp/msb-sm-simulate-missing: its text "selector" (default), "encoding" or "hook" pretends that kind of difference; "optional": an optional
// row missing (-appLayoutByRemovingItemInLayoutRole:, as on iPadOS 16.2-16.3): the engine stays on and cuts stages back with the leaf instead.
static void DMSMSelfCheck(void) {
    DM_FEATURE_MARK("sm-self-check");
    if (gSMCheckDone) return;
    gSMCheckDone = YES;
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 || !objc_getClass("SBSwitcherChamoisSettings") || !MSBDStageManagerAvailable()) {
        DMLog(@"[smcheck] Stage Manager can't run here: no check, no engine hooks");
        return;
    }
    NSString *simulate = nil;
#if DEBUG
    if (DMTestFlag("/tmp/msb-sm-simulate-missing")) {
        simulate = [[NSString stringWithContentsOfFile:@"/tmp/msb-sm-simulate-missing" encoding:NSUTF8StringEncoding error:nil] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (!simulate.length) simulate = @"selector";
        DMLog([NSString stringWithFormat:@"[smcheck] SIMULATING a changed API (debug): %@", simulate]);
    }
#endif
    CFTimeInterval t0 = CACurrentMediaTime();
    // (which layout engine's rows count: iPadOS 16's SBChamoisOverlappingController or 17's SBContinuousExposeAutoLayoutController, SMEngineAPI.h)
    gSMLayoutGen = DMSMLayoutGenFor(simulate);
    DMLog([NSString stringWithFormat:@"[smcheck] layout engine table: %@", DMSMLayoutName(gSMLayoutGen)]);
    NSUInteger checked = 0;
    NSArray<NSString *> *bad = DMSMCheckAPILive(simulate, &checked);   // (also records the optional rows: DMSMRowPassed, the verdict)
    if (!bad.count) {
        NSArray *before = DMSMHookedIMPs();
        if (DMSMVariantIs("auto layout", "16.0")) %init(SMLayout160);     // (iPadOS 16.0's layout pass and size grid, where the check chose them -- sm-160)
        if (DMSMVariantIs("size grid", "grid object")) %init(SMGrid160);
        if (DMSMVariantIs("size grid", "lists")) %init(SMGridLists);      // (16.1+'s size lists: only where chosen, nothing hooked that is not there)
        %init(SMEngine);
        DMSMHookStripReveal();   // (optional: the recent-stages strip's reveal gesture, held off while our engine runs)
        DMSMDeskInstall();       // (optional: the Home Screen behind the windows, SMDesktop.h -- its own rows; missing = Apple's way, the engine runs)
        if (gSMLayoutGen == 17) {
            DM_FEATURE_MARK("sm-layout-17");
            %init(SMLayout17);
        } else {
            if (DMSMVariantIs("auto layout", "16.1")) %init(SMLayout161);   // (16.1+'s layout pass: only where chosen)
            %init(SMLayout16);
            DMSMHookConstrain16();   // (optional: a window bigger than the stage area keeps its top and left edges inside)
        }
        const char *corner = DMSMCornerRadiusSelector();   // (checked above: one of the two names exists with our signature)
        if (corner && !strcmp(corner, "stageCornerRaddii")) %init(SMCornerRaddii);
        else if (corner) %init(SMCornerRadii);
        bad = DMSMHooksNotInstalled(before, [simulate isEqualToString:@"hook"]);
        if (bad.count) DMLog(@"[smcheck] hooks installed but not all took: the engine stays off (its hooks only ever act for the engine)");
    }
    gSMChecked = checked;
    gSMCheckBad = bad;
    gSMCheckOK = bad.count == 0;
    NSOperatingSystemVersion ov = [NSProcessInfo processInfo].operatingSystemVersion;
    gSMCheckReason = gSMCheckOK ? nil : [NSString stringWithFormat:@"iPadOS %ld.%ld.%ld (%@): %lu of the system methods the engine uses are missing or different",
        (long)ov.majorVersion, (long)ov.minorVersion, (long)ov.patchVersion, MSBDOSBuild() ?: @"?", (unsigned long)bad.count];
    DMSMPublishVerdict(gSMCheckOK, gSMCheckReason, bad);
    if (gSMCheckOK) DMLog([NSString stringWithFormat:@"[smcheck] Stage Manager engine API verified: %lu classes/methods/signatures, hooks installed (%.1f ms; engine picked: %d)",
                          (unsigned long)checked, (CACurrentMediaTime() - t0) * 1000.0, [gEnginePref isEqualToString:@"stagemanager"]]);
    else {
        DMLog([NSString stringWithFormat:@"[smcheck] Stage Manager engine NOT available: %@", gSMCheckReason]);
        for (NSString *l in bad) DMLog([@"[smcheck]   " stringByAppendingString:l]);
    }
    DMSM17DiagSoon();   // (iPadOS 17 with Enable Anyway: the check's result for Report a Problem)
}
static void DMSMEngineInit(void) {
    DMSMSelfCheck();
}
// Where SpringBoard starts without the engine's part (the stock status bar -- also what Automatic Crash Recovery switches to after a crash) the
// verdict was never written, and "not checked" counted as usable: Settings still offered Stage Manager on a build where it crashed (issue #2,
// iPadOS 16.0, stock bar after the crash). The same check, read-only (nothing hooked), so Settings and the root helper know this build.
static void DMSMCheckReadOnly(void) {
    DM_FEATURE_MARK("sm-check-readonly");
    if (gSMCheckDone) return;
    gSMCheckDone = YES;
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 16 || !objc_getClass("SBSwitcherChamoisSettings") || !MSBDStageManagerAvailable()) return;
    gSMLayoutGen = DMSMLayoutGenFor(nil);
    NSUInteger checked = 0;
    NSArray<NSString *> *bad = DMSMCheckAPILive(nil, &checked);
    gSMChecked = checked; gSMCheckBad = bad;
    NSOperatingSystemVersion ov = [NSProcessInfo processInfo].operatingSystemVersion;
    NSString *reason = bad.count ? [NSString stringWithFormat:@"iPadOS %ld.%ld.%ld (%@): %lu of the system methods the engine uses are missing or different",
        (long)ov.majorVersion, (long)ov.minorVersion, (long)ov.patchVersion, MSBDOSBuild() ?: @"?", (unsigned long)bad.count] : nil;
    DMSMPublishVerdict(bad.count == 0, reason, bad);
    DMLog([NSString stringWithFormat:@"[smcheck] read-only check (engine not started here, layout engine table %@): %@", DMSMLayoutName(gSMLayoutGen), reason ?: [NSString stringWithFormat:@"%lu verified", (unsigned long)checked]]);
    DMSM17DiagSoon();
}

// Leaving Stage Manager (another engine takes over): a stage of several windows is a multi-app layout, which iPadOS shows as Split View without
// Stage Manager (Clock opened next to Settings after switching back to Aerial, iPad 2, 28 Sep). Each such stage is cut back to its primary app
// (the switcher model's replaceAppLayout:withAppLayout:), so every app opens on its own again.
void DMSMFlattenStages(NSString *why) {
    // (every call through the checked wrappers: this runs when ANOTHER engine takes over, also where the Stage Manager engine's check failed;
    //  the cut itself, iPadOS 16.4+ or 16.2-16.3: DMSMStageCutToPrimary, SMEngineAPI.h)
    int n = 0;
    for (id al in [DMSMRecentStages() copy]) {
        BOOL unsupported = NO;
        id single = DMSMStageCutToPrimary(al, &unsupported);
        if (single && single != al && DMSMReplaceStage(al, single)) n++;
        static BOOL told;
        if (unsupported && !told) { told = YES; DMLog(@"[smengine] a multi-window stage stays as it is: this iPadOS has no way to cut it back that we know"); }
    }
    if (n) DMLog([NSString stringWithFormat:@"[smengine] %d multi-window stage(s) cut back to single apps (%@)", n, why]);
}
// The app of the front window of the stage on screen (the newest lastInteractionTime); nil on the Home Screen or with no stage.
// (S-1, 1.3.3: inside a tick scope -- the 0.2 s watcher, DMTick, a status bar layout pass -- the answer is worked out once and shared: the
//  Stage Manager engine asked SpringBoard's switcher model for its recent stages several times per tick, from the active app's every caller.
//  Our own changes to the model drop it at once, gDMSMModelChanged; outside a scope it is asked each time as before.)
static NSString *DMSMFrontWindowBundleNow(void);
static BOOL gDMSnapSMFrontKnown = NO; static NSString *gDMSnapSMFront = nil;
static void DMSnapForgetSMFront(void) { gDMSnapSMFrontKnown = NO; gDMSnapSMFront = nil; }
NSString *DMSMFrontWindowBundle(void) {
    if (gDMSnapDepth && gDMSnapSMFrontKnown) return gDMSnapSMFront;
    NSString *b = DMSMFrontWindowBundleNow();
    if (gDMSnapDepth) { gDMSnapSMFront = b; gDMSnapSMFrontKnown = YES; if (!gDMSMModelChanged) gDMSMModelChanged = DMSnapForgetSMFront; }
    return b;
}
static NSString *DMSMFrontWindowBundleNow(void) {
    // (the ACTIVE window: the most recently used stage on any screen -- a window clicked on the TV is the active app, as on a Mac, where every
    //  display's menu bar shows the one active app; iPad-only checks -- Dock, full screen -- use DMSMFrontStage, the iPad's own stage)
    id stage = [DMSMRecentStages() firstObject];
    if (DMSMIsMainIdentity(DMSMStageDisplayIdentity(stage)) && !DMFrontApp()) return nil;   // (the iPad's Home Screen, no TV stage in use)
    NSDictionary *map = DMSMStageItemsMap(stage);
    NSString *best = nil; long newest = LONG_MIN;
    for (id item in map) {
        long t = DMSMAttrTimeOr(map[item], 0);
        if (t > newest) { newest = t; best = DMSMItemBundle(item); }
    }
    return best;
}
// ---- Stage Manager engine helpers (study, 28 Sep) ----
// The window's own "..." menu controller (SBTopAffordanceViewController), found through the view tree of the switcher window by its scene's app.
id DMSMTopAffordanceFor(NSString *bundle) {
    Class c = objc_getClass("SBTopAffordanceViewController");
    if (!c) return nil;
    // (inside the app's own window card first: exact and cheap -- the walk over every window gave up at 4000 views with the TV's second desktop
    //  connected and missed a window behind the front one; it stays only as the fallback)
    UIView *card = bundle ? DMSMCardFor(bundle) : nil;
    if (card) {
        NSMutableArray *todo = [NSMutableArray arrayWithObject:card];
        for (NSUInteger i = 0; i < todo.count && i < 1500; i++) {
            UIView *v = todo[i];
            if ([v.nextResponder isKindOfClass:c]) return v.nextResponder;
            [todo addObjectsFromArray:v.subviews];
        }
    }
    for (UIWindow *w in DMAllWindows()) {
        NSMutableArray *todo = [NSMutableArray arrayWithObject:w];
        for (NSUInteger i = 0; i < todo.count && i < 4000; i++) {
            UIView *v = todo[i];
            UIResponder *r = v.nextResponder;
            if ([r isKindOfClass:c]) {
                id handle = DMCall(r, @"sceneHandle");
                NSString *b = DMCall(DMCall(handle, @"application"), @"bundleIdentifier") ?: DMCall(handle, @"bundleIdentifier");
                if (!bundle || [b isEqualToString:bundle]) return r;
            }
            [todo addObjectsFromArray:v.subviews];
        }
    }
    return nil;
}
// Runs a UIAction the way its menu would (its private handler, with the action itself).
void DMSMRunAction(UIAction *action, id sender) {
    SEL perform = NSSelectorFromString(@"performWithSender:target:");
    if ([action respondsToSelector:perform]) { ((void (*)(id, SEL, id, id))objc_msgSend)(action, perform, sender, nil); return; }
    void (^h)(UIAction *) = nil; @try { h = [action valueForKey:@"handler"]; } @catch (id e) {}
    if (h) h(action);
}
%ctor {
    if (MSBDDiagEnabled()) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(15 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMDiagHooks(); });
    {   // Settings > Mac Status Bar (a separate, minimal entry, alongside the other installed tweaks' own on/off switches): fully off means fully off — not
        // one hook of this file runs, the same as if the tweak were not installed. Checked before %init, so nothing is even hooked yet to undo.
        CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("tweakEnabled"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        BOOL enabled = !v || (CFGetTypeID(v) == CFBooleanGetTypeID() && CFBooleanGetValue(v));
        if (v) CFRelease(v);
        if (!enabled) {   // switched off: Aerial 5.0's own settings (held while it was our engine) go back to the user's
            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMAerial5GiveBackPrefs(@"Mac Status Bar is switched off"); });
            return;
        }
    }
    gStockStored = gStockBar = DMStockBarSwitch();   // "Use Stock Status Bar": decided once, before anything is hooked
    DMStockPublish();
    if (gStockBar) { DMSMCheckReadOnly(); DMSkipLockInit(); DMStockBarStart(); return; }   // only the parts that stay (StockBar.h); the rest below never runs
    // (the status bar hooks go on the classes SpringBoard's bar uses: 15/16 UIKit's, the same as a plain %init; 17+ SystemStatusUI's, DMSBClass)
    %init(_UIStatusBarForegroundView = DMSBClass("_UIStatusBarForegroundView"), _UIStatusBarStringView = DMSBClass("_UIStatusBarStringView"),
          UIStatusBar_Modern = DMSBClass("UIStatusBar_Modern"), _UIStatusBar = DMSBClass("_UIStatusBar"), UIStatusBarWindow = DMSBClass("UIStatusBarWindow"));
    if (!DMCtorSkip("stockvpn")) DMStockVPNInit();
    if (!DMCtorSkip("stockwifi")) DMStockWiFiInit();   // (the Wi-Fi Menu: iOS's own Wi-Fi item can be left out of our bars; before the prefs are read)
    if (!DMCtorSkip("smengine")) DMSMEngineInit();
    DMFinderApplyPref();    // (Finder: its hooks, the Dock's Finder icon -- only while switched on)
    { static int finderPrefToken; notify_register_dispatch("com.besiktasliseba.macstatusbar.finder.pref", &finderPrefToken, dispatch_get_main_queue(), ^(int t) { DMFinderApplyPref(); }); }
    DMPointerPullInit();
    DMCCPresentSeenInit();   // (Control Center seen from its controller too: F13)
    DMSkipLockInit();
    if (!DMCtorSkip("todayoffset")) DMTodayKeepOffsetInit();
    if (!DMCtorSkip("todaynotifications")) DMTNWatchInit();   // (the Today panel's notifications box: when the Cover Sheet's list changes)
#if DEBUG
    DMTNTestInit();   // (tests: our own test notifications)
#endif
    if (!DMCtorSkip("touchfix")) DMTouchFixInit();
#if DEBUG
    gSampleMainThread = mach_thread_self();   // (%ctor runs on the main thread: idlesample_ samples this thread)
    gSampleStackHi = (uintptr_t)pthread_get_stackaddr_np(pthread_self()); gSampleStackLo = gSampleStackHi - pthread_get_stacksize_np(pthread_self());
    if (!DMCtorSkip("debughooks")) %init(DMDebugHooks);
    if (!DMCtorSkip("extdisplaylog")) DMExtDisplayLogInit();
#endif
    if (!DMTestFlag("/tmp/msb-nomedusa") && !DMCtorSkip("medusa")) %init(EngineMedusa);   // (checks the engine itself on every call; kill switch /tmp/msb-nomedusa)
    // Aerial 5.0 reads some of its settings when it sets up its window: the ones our integration needs are written before that, when the loaded
    // Aerial is a tested 5.0 build (3.0 keeps its real method names and has no such settings).
    if (objc_getClass("AerialCore") && objc_getClass("AerialStage") && DMAerialBuildTested() && ![objc_getClass("AerialStage") instancesRespondToSelector:NSSelectorFromString(@"minimizeStage")] && DMWindowingEnabled()) {
        CFPropertyListRef e = CFPreferencesCopyValue(CFSTR("windowEngine"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);   // gEnginePref is not loaded yet here
        NSString *engine = e ? CFBridgingRelease(e) : nil;
        BOOL ios16 = [[NSProcessInfo processInfo] isOperatingSystemAtLeastVersion:(NSOperatingSystemVersion){16, 0, 0}];
        BOOL other = [engine isKindOfClass:[NSString class]] && (([engine isEqualToString:@"milkyway"] && !ios16) || [engine isEqualToString:@"zetsu"]);   // (MilkyWay4 saved on iOS 16 = Aerial runs)
#if DEBUG
        unlink("/tmp/msb-a5-heldoff");   // debug pause of the trigger a5giveback: lasts until the next SpringBoard start
#endif
        if (!other && !DMCtorSkip("a5prefs")) { gA5PrefsState = 1; DMAerial5SwallowPrefs(@"startup, before Aerial sets up its window"); }
    }
    {   // Zetsu / MilkyWay4 picked (a tested build): their settings are held before they load and read them (see DMEnginePrefsWatch)
        CFPropertyListRef e = CFPreferencesCopyValue(CFSTR("windowEngine"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        NSString *engine = e ? CFBridgingRelease(e) : nil;
        if (DMWindowingEnabled() && [engine isKindOfClass:[NSString class]]) {
            if ([engine isEqualToString:@"zetsu"] && DMEngineBuildTested(@"Zetsu")) DMZetsuHoldPrefs(@"startup, before Zetsu reads them");
            if ([engine isEqualToString:@"milkyway"] && DMEngineBuildTested(@"MilkyWay4")) DMMilkyWayHoldPrefs(@"startup, before MilkyWay4 reads them");
        }
    }
    if (!DMCtorSkip("windowingoff")) %init(WindowingOff);   // the default group; MilkyWayGreen is initialised later, when MilkyWay's class exists
#if DEBUG
    {   // is our FBScene hook inside MilkyWay's (installed before it) or outside it? Compare the method's implementation later.
        Method m = class_getInstanceMethod(objc_getClass("FBScene"), NSSelectorFromString(@"updateSettings:withTransitionContext:"));
        IMP mine = m ? method_getImplementation(m) : NULL;
        DMLog([NSString stringWithFormat:@"[order] FBScene updateSettings IMP right after our hook: %p", mine]);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(20 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            Method now = class_getInstanceMethod(objc_getClass("FBScene"), NSSelectorFromString(@"updateSettings:withTransitionContext:"));
            IMP current = now ? method_getImplementation(now) : NULL;
            DMLog([NSString stringWithFormat:@"[order] 20 s later: %p -> %@", current, current == mine ? @"nobody hooked after us (we are the OUTER hook, or MilkyWay hooked before us)" : @"someone hooked after us (we are INNER, as intended)"]);
        });
    }
#endif
    if (!DMCtorSkip("loadprefs")) DMLoadPrefs();
    // DMRealInterfaceOrientation()'s UIDevice fallback (used by the menu/keyboard orientation fixes) needs a genuinely live reading, not whatever
    // SpringBoard's own unrelated subsystems happen to leave [UIDevice currentDevice].orientation at -- without this, that property can return
    // UIDeviceOrientationUnknown depending on what else in-process has (or hasn't) turned the accelerometer feed on. Explicitly starting it
    // ourselves removes that as a variable. Public API, read-only effect (starts a system sensor feed, nothing more).
    if (!DMTestFlag("/tmp/msb-noorientnotes")) [[UIDevice currentDevice] beginGeneratingDeviceOrientationNotifications];   // (debug kill switch: idle-cost test)
    if (!DMCtorSkip("startup")) dispatch_async(dispatch_get_main_queue(), ^{ DMStartStartupWatcher(); });   // as soon as the main run loop is up
#if DEBUG
    {   // debug probe: app lifecycle events sent by the debug build of MixAudio (state = hash of the bundle id)
        static const char *names[] = { "will resign active", "did become active", "did enter background", "will enter foreground", "scene will deactivate", "scene did activate", "scene did enter background", "scene will enter foreground", "audio interruption" };
        for (int i = 0; i < 9; i++) {
            char name[48]; snprintf(name, sizeof name, "com.besiktasliseba.appstate.%d", i + 1);
            int token = 0; const char *what = names[i];
            notify_register_dispatch(name, &token, dispatch_get_main_queue(), ^(int t) {
                if (!DMTestFlag("/tmp/macstatusbar-debug")) return;
                uint64_t state = 0; notify_get_state(t, &state);
                NSString *who = nil;
                for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); uint32_t h = 2166136261u; for (const char *c = b.UTF8String; c && *c; c++) { h ^= (uint8_t)*c; h *= 16777619u; } if (h == (uint32_t)state) who = b; }
                DMLog([NSString stringWithFormat:@"[appstate] %@: %s", who ?: [NSString stringWithFormat:@"(hash %08x)", (uint32_t)state], what]);
            });
        }
    }
#endif
    if (!DMCtorSkip("hooks3s")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMTryHookMilkyWay(0); DMTryHookAerial(0); DMTryHookWindowLaunch(); DMInstallIconMenuFilter(); DMTryHookBigSurCenter(0); DMTryHookZetsu(0); });
    if (!DMCtorSkip("cc")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(14 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMPrewarmControlCenter(0); });
    if (!DMCtorSkip("restore")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(9 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMRestoreWindows(0); });
    if (!DMCtorSkip("menuwin")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(6 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMCreateMenuWindow(); });
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(20 * NSEC_PER_SEC)), dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{ MSBDPackageVersion(MSBD_PACKAGE_ID); });   // (S-2: the Apple menu's installed version, read once off the main thread)
#if DM_LOCK_BYPASS
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMSkipLockTick(0); });
#endif
#if DEBUG
    // DEV AID: /tmp/macstatusbar-orient containing "p" or "r" forces that orientation right after SpringBoard starts (before the menu
    // window is made), which emulates a respring done while the iPad is held in that orientation.
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        NSString *want = [[NSString stringWithContentsOfFile:@"/tmp/macstatusbar-orient" encoding:NSUTF8StringEncoding error:nil] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
        if (!want.length) return;
        id mgr = DMCall(objc_getClass("SBOrientationLockManager"), @"sharedInstance");
        SEL on = NSSelectorFromString(@"enableLockOverrideForReason:forceOrientation:");
        long long o = [want isEqualToString:@"p"] ? 1 : ([want isEqualToString:@"r"] ? 3 : 4);
        DMLog([NSString stringWithFormat:@"[orient] startup override %@ (%lld)", want, o]);
        if ([mgr respondsToSelector:on]) ((void (*)(id, SEL, id, long long))objc_msgSend)(mgr, on, @"macstatusbar-test", o);
    });
#endif
    if (!DMCtorSkip("library")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        NSTimer *libraryWatch = [NSTimer timerWithTimeInterval:0.2 repeats:YES block:^(NSTimer *timer) { DMSyncWindowsForLibrary(); }];
        libraryWatch.tolerance = 0.02;   // (perf step 10: the system may fire it up to 20 ms late, so its wakeup can be shared with others)
        [[NSRunLoop mainRunLoop] addTimer:libraryWatch forMode:NSRunLoopCommonModes];
        DMGateTimer(libraryWatch);
    });
    if (!DMCtorSkip("switcher")) { DMRinger18Init(); DMSwitcherHooksInit(); }   // iOS 16: the App Switcher coordinator (hooks only)
    if (!DMCtorSkip("switcher")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(8 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMStartSwitcherGCTimer(); });
    if (!DMCtorSkip("pointer")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMPointerBridgeStart(); });   // MacPointer (pointeruid): early, the arrow waits for it after a respring
    if (!DMCtorSkip("power")) DMScreenPowerWatch();   // battery: the screen-off gate for our timers (reads a notification state only)
    // Reduce Motion is read live on every animation (MSBReduceMotion); a change is logged here so a test run shows which mode each animation used.
    DMLog([NSString stringWithFormat:@"[motion] Reduce Motion is %@ at start", MSBReduceMotion() ? @"ON: cross-fades" : @"off"]);
    [[NSNotificationCenter defaultCenter] addObserverForName:NSCurrentLocaleDidChangeNotification object:nil queue:[NSOperationQueue mainQueue] usingBlock:^(NSNotification *n) {
        gDMLocaleGen++;   // (the clock and date formats are worked out again: 12/24 hour, region -- at once, not up to a minute later)
        for (UIView *fg in gCopies.allObjects) [fg setNeedsLayout];
        DMLog(@"[clock] region / 12-24 hour setting changed: the clock format is worked out again");
    }];
    [[NSNotificationCenter defaultCenter] addObserverForName:UIAccessibilityReduceMotionStatusDidChangeNotification object:nil queue:[NSOperationQueue mainQueue] usingBlock:^(NSNotification *n) {
        DMLog([NSString stringWithFormat:@"[motion] Reduce Motion turned %@: the next animations %@", MSBReduceMotion() ? @"ON" : @"off", MSBReduceMotion() ? @"cross-fade" : @"move and zoom again"]);
    }];
    if (!DMCtorSkip("banners")) DMBannersInit();   // Mac-style notification banners (hooks only; nothing is asked of SpringBoard here)
    if (!DMCtorSkip("ctxmenus")) DMContextMenusInit();   // macOS-style Haptic Touch menus (UIKit's context menu views; hooks only)
    if (!DMCtorSkip("audio")) dispatch_async(dispatch_get_main_queue(), ^{ DMAudioRepublishSaved(); });   // per-app audio levels (notify state is lost on a respring); on the first main-queue turn, before any app can start playing (audio audit F16: it waited 2 s, and apps played at full volume meanwhile)
    if (!DMCtorSkip("autohide")) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMAutoHideStart(); });   // auto-hiding status bar (off by default)
    { int t = 0; notify_register_dispatch("com.besiktasliseba.macstatusbaranddock.opendownloadsfrom", &t, dispatch_get_main_queue(), ^(int tok) {   // the Dock's "Downloads From…"
        DMOpenSettingsLinkFullScreen(@"prefs:root=DOCK_MAGNIFICATION&path=DOWNLOADS", 0); }); }
    { int t = 0; if (notify_register_check("com.besiktasliseba.macstatusbar.alive", &t) == NOTIFY_STATUS_OK) notify_set_state(t, (uint64_t)getpid()); }   // heartbeat: MacSettings' root helper (sshtoggled) sees Mac Status Bar is running (see its "switched off" check)
    CFNotificationCenterAddObserver(CFNotificationCenterGetDarwinNotifyCenter(), NULL, DMPrefsChanged, MSB_NOTIFY, NULL,
                                    CFNotificationSuspensionBehaviorCoalesce);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2 * NSEC_PER_SEC)),
                   dispatch_get_main_queue(), ^{
#if DEBUG
        if (DMCtorSkip("tick")) {   // (bisect: no tick, but the debug triggers still work)
            NSTimer *t = [NSTimer timerWithTimeInterval:0.5 repeats:YES block:^(NSTimer *timer) { DMCheckTrigger(); }];
            [[NSRunLoop mainRunLoop] addTimer:t forMode:NSRunLoopCommonModes];
            return;
        }
#endif
        DMEnsureLogo(0); DMTick(); });
}
