    if (CACurrentMediaTime() - lastLog > 2.0) { lastLog = CACurrentMediaTime(); DMLog([NSString stringWithFormat:@"[scene] %@: scene %@ stays in the background (%@; something asked for the foreground)", windowed, DMShortSceneID(scene), alive ? @"not the window's scene" : @"ending"]); }
