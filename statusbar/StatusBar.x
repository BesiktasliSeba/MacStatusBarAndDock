// ===== actions ==========================================================
static void DMSaveWindowState(void);
static void DMRespring(void) {
    DMLog(@"[action] respring");
    DMSaveWindowState();   // the windows come back after the respring
    const char *sbreload = "/var/jb/usr/bin/sbreload";
    if (access(sbreload, X_OK) == 0) {
        pid_t pid;
        char *argv[] = { (char *)"sbreload", NULL };
        if (posix_spawn(&pid, sbreload, NULL, NULL, argv, environ) == 0) return;
    }
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    if ([sb respondsToSelector:@selector(_relaunchSpringBoardNow)]) [sb _relaunchSpringBoardNow];
}

// ElleKit (Dopamine's injector) checks for this marker file when SpringBoard is
// spawned; while it exists, SpringBoard tweaks are not injected. ElleKit's own
// alert (tap the status bar) offers the way back out.
static void DMEnterSafeMode(void) {
    BOOL ok = [[NSData data] writeToFile:@"/var/mobile/.eksafemode" atomically:NO];
    DMLog([NSString stringWithFormat:@"[action] enter safe mode, marker written=%d", ok]);
    if (ok) DMRespring();
}

// Our Respring buttons (the Apple menu's, the engine switch's): the VPN warning first when a respring could hang (VPNRespring.h). Safe Mode's
// respring needs none (no tweak loads there, Aerial included).
static UIWindow *gVPNWarnWindow = nil;
static void DMOpenURL(NSString *urlString, NSString *tag);   // (defined below)
// (Safe Mode's marker written: no tweak loads after this respring, Aerial included -- DMEnterSafeMode's respring, which goes through sbreload and
// so through the restart gate, is never held; a held one left the marker behind for whatever respring came next.)
static BOOL DMRespringNeedsVPNWarning(void) { return access("/var/mobile/.eksafemode", F_OK) != 0 && MSBDVPNRisk() && MSBDAerial5WillLoad(); }
static CFTimeInterval gOwnRespringAt = 0;   // (our own respring, already asked about: the restart request sbreload makes for it passes the gate)
static void DMRespringWarnThen(dispatch_block_t go) {   // go: the respring itself (ours, or another's held one)
    void (^close)(void) = ^{ gVPNWarnWindow.hidden = YES; gVPNWarnWindow = nil; };
    UIAlertController *a = gVPNWarnWindow ? nil : MSBDVPNRespringAlert(^{ close(); DMLog(@"[vpnwarn] respring anyway"); go(); },
                                                                       ^{ close(); DMOpenURL(MSBD_VPN_SETTINGS_URL, @"vpn settings (respring warning)"); },
                                                                       ^{ close(); DMLog(@"[vpnwarn] cancelled"); });
    if (!a) { if (!gVPNWarnWindow) go(); return; }
    DMLog([NSString stringWithFormat:@"[vpnwarn] respring held: a VPN %@ and Aerial 5.0 loads", MSBDVPNRisk() == 1 ? @"is on" : @"just went off"]);
    UIWindow *w = MSBDMakeAlertWindow(UIWindowLevelAlert + 10.0);
    gVPNWarnWindow = w;
    [w.rootViewController presentViewController:a animated:YES completion:nil];
    MSBDAlertCloseOnLock(w, ^{ if (gVPNWarnWindow == w) gVPNWarnWindow = nil; });
}
static void DMRespringChecked(void) { DMRespringWarnThen(^{ gOwnRespringAt = CACurrentMediaTime(); DMRespring(); }); }

// Every private call below is checked with respondsToSelector on the CLASS as well as the instance: calling a
// method that does not exist on this iPadOS makes SpringBoard abort (an unguarded +sharedUserAgent did exactly that).
static id DMShared(const char *className, SEL sharedSelector) {
    Class c = objc_getClass(className);
    return (c && [(id)c respondsToSelector:sharedSelector]) ? ((id (*)(id, SEL))objc_msgSend)((id)c, sharedSelector) : nil;
}

static void DMLock(void) {
    SBLockScreenManager *m = DMShared("SBLockScreenManager", @selector(sharedInstance));
    if ([m respondsToSelector:@selector(lockUIFromSource:withOptions:)]) {
        DMLog(@"[action] lock via SBLockScreenManager");
        [m lockUIFromSource:1 withOptions:nil];
        return;
    }
    SBUserAgent *ua = DMShared("SBUserAgent", @selector(sharedUserAgent));
    if ([ua respondsToSelector:@selector(lockAndDimDevice)]) {
        DMLog(@"[action] lock via SBUserAgent");
        [ua lockAndDimDevice];
        return;
    }
    DMLog(@"[action] lock: no known selector available");
}

// "Sleep": lock AND turn the screen off, like pressing the power button. (DMLock leaves the screen on, showing the
// Lock Screen.) Tries the power-button simulation first, then the user agent's lock-and-dim, and only if neither
// exists falls back to a plain lock.
static void DMSleep(void) {
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    SEL press = NSSelectorFromString(@"_simulateLockButtonPress");
    if ([sb respondsToSelector:press]) {
        DMLog(@"[action] sleep via -[SpringBoard _simulateLockButtonPress]");
        ((void (*)(id, SEL))objc_msgSend)(sb, press);
        return;
    }
    SBUserAgent *ua = DMShared("SBUserAgent", @selector(sharedUserAgent));
    if ([ua respondsToSelector:@selector(lockAndDimDevice)]) {
        DMLog(@"[action] sleep via SBUserAgent lockAndDimDevice");
        [ua lockAndDimDevice];
        return;
    }
    DMLog(@"[action] sleep: no known selector, falling back to lock");
    DMLock();
}

static void DMShutDown(void) {
    FBSSystemService *s = [objc_getClass("FBSSystemService") sharedService];
    if ([s respondsToSelector:@selector(shutdown)]) {
        DMLog(@"[action] shut down");
        [s shutdown];
    } else {
        DMLog(@"[action] shut down: -[FBSSystemService shutdown] missing");
    }
}

// openSensitiveURL is a synchronous round trip; on the main thread it froze
// SpringBoard for a moment, so it always runs in the background.
static void DMOpenURL(NSString *urlString, NSString *tag) {
    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
        NSURL *url = [NSURL URLWithString:urlString];
        LSApplicationWorkspace *ws = [objc_getClass("LSApplicationWorkspace") defaultWorkspace];
        BOOL ok = [ws respondsToSelector:@selector(openSensitiveURL:withOptions:)] &&
                  [ws openSensitiveURL:url withOptions:nil];
        DMLog([NSString stringWithFormat:@"[action] %@, opened=%d", tag, ok]);
    });
}

static void DMAbout(void) { DMOpenURL(@"prefs:root=General&path=About", @"about"); }

static void DMOpenApp(NSString *bundleID);   // defined below
static void DMPostAppBridgeAction(NSString *bundleID, NSString *action);   // defined below
// itms-apps://apps.apple.com/updates (and itms-apps://itunes.apple.com/updates, macappstore://showUpdatesPage) have had no working deep link to the
// App Store's own Updates tab since its iOS 13 redesign — they always land on Today instead. MacAppBridge (running inside the App Store itself)
// reaches the real Updates screen a different way: the account/profile avatar in its nav bar opens it, same as a manual tap does, and is found and
// activated directly once the App Store is in front — found by class name, since it is no more exposed to VoiceOver than the tab bar is (ax=0, no
// label). The App Store is opened first (bringing it forward if already running, launching it otherwise), then the bridge action is posted several
// times over a few seconds rather than once: Darwin notifications are not queued, so a post before a cold launch has finished starting up and
// registered for it is simply lost, and MacAppBridge's own retry loop only helps once a post actually lands.
static void DMAppStoreUpdates(void) {
    DMOpenApp(@"com.apple.AppStore");
    NSArray<NSNumber *> *delays = @[@0, @0.4, @0.8, @1.5, @2.5, @4, @6];
    for (NSNumber *d in delays) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(d.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            DMPostAppBridgeAction(@"com.apple.AppStore", @"updates");
        });
    }
}

static id DMProxyForBundle(NSString *bundleID);   // defined with the About <App> panel
// Apps that cannot live in a window: games made for one screen only (Jetpack Joyride on the iPad 2 filled the whole screen inside a Zetsu window, hid
// the status bar, and a long press there led to the 00:50 Safe Mode). They always open full screen, on every engine, like Reminders under Zetsu.
// Read from the app's Info.plist (the ~ipad variant first): a fixed screen axis (landscape only, or portrait only) AND a full-screen game's flags --
// landscape-only with UIRequiresFullScreen or UIStatusBarHidden, or both of those flags. UIRequiresFullScreen alone is NOT enough: SofaScore, the App
// Store, Peacock, Duolingo and Prime Video set it and live in windows fine (surveyed on the iPad 2: this rule picks exactly its 13 full-screen games and
// Measure; WhatsApp sets none of these). Cached per app.
static BOOL DMInfoBool(NSDictionary *info, NSString *key) {
    id v = info[[key stringByAppendingString:@"~ipad"]] ?: info[key];
    return [v respondsToSelector:@selector(boolValue)] && [v boolValue];
}
static BOOL DMAppNeedsFullScreen(NSString *bundleID) {
    if (!bundleID.length) return NO;
#if DEBUG
    {   // test switch: /tmp/msb-fullscreenonly-test holding a bundle id makes that app count as full-screen-only (to see the greyed controls on an app
        // whose status bar shows; the games all hide theirs). Read at most once every 2 s.
        static NSString *testID = nil; static CFTimeInterval readAt = -10;
        if (CACurrentMediaTime() - readAt > 2.0) { readAt = CACurrentMediaTime(); testID = [[NSString stringWithContentsOfFile:@"/tmp/msb-fullscreenonly-test" encoding:NSUTF8StringEncoding error:nil] stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]]; }
        if (testID.length && [testID isEqualToString:bundleID]) return YES;
    }
#endif
    static NSMutableDictionary<NSString *, NSNumber *> *cache;
    if (!cache) cache = [NSMutableDictionary dictionary];
    NSNumber *known = cache[bundleID];
    if (known) return known.boolValue;
    // The Camera app: iPadOS pauses the camera for any app that is not alone on the screen (as in Split View), so in a window it only shows black.
    // Always full screen (2026-09-26). Other apps that use the camera cannot be told apart here (a known limitation in the docs).
    if ([bundleID isEqualToString:@"com.apple.camera"]) { cache[bundleID] = @YES; return YES; }
    NSURL *url = nil; @try { url = [DMProxyForBundle(bundleID) valueForKey:@"bundleURL"]; } @catch (id e) {}
    NSDictionary *info = [url isKindOfClass:[NSURL class]] ? [NSDictionary dictionaryWithContentsOfURL:[url URLByAppendingPathComponent:@"Info.plist"]] : nil;
    if (!info) return NO;   // (not cached: asked again next time)
    id o = info[@"UISupportedInterfaceOrientations~ipad"] ?: info[@"UISupportedInterfaceOrientations"];
    NSArray *orients = [o isKindOfClass:[NSArray class]] ? o : @[];
    BOOL landscapeOnly = orients.count > 0, portraitOnly = orients.count > 0;
    for (id x in orients) {
        NSString *str = [x isKindOfClass:[NSString class]] ? x : @"";
        if (![str containsString:@"Landscape"]) landscapeOnly = NO;
        if (![str containsString:@"Portrait"]) portraitOnly = NO;
    }
    BOOL requiresFull = DMInfoBool(info, @"UIRequiresFullScreen"), barHidden = DMInfoBool(info, @"UIStatusBarHidden");
    // (An app made for iPad multitasking -- Slide Over / Split View: UIRequiresFullScreen off and all four orientations, like YouTube -- is always a
    // window, whether or not it hides the status bar; the rule below can only pick apps with a fixed screen axis.)
    BOOL needs = (landscapeOnly || portraitOnly) && (requiresFull || barHidden) && (landscapeOnly || (requiresFull && barHidden));
    if (DMTestFlag("/tmp/msb-nofullscreenonly")) needs = NO;   // (test switch: the old behaviour)
    cache[bundleID] = @(needs);
    DMLog([NSString stringWithFormat:@"[fullscreenonly] %@: %@ (orientations %lu, landscape only %d, portrait only %d, UIRequiresFullScreen %d, UIStatusBarHidden %d)", bundleID, needs ? @"opens full screen only" : @"can be a window", (unsigned long)orients.count, landscapeOnly, portraitOnly, requiresFull, barHidden]);
    return needs;
}

// Where "Settings…" goes for an app. Third-party apps (App Store, TestFlight, sideloaded, or installed
// from a .deb such as UTM) open with prefs:root=<bundle id>; if the app has no settings page Settings
// simply opens on its main screen. System apps use the identifiers Settings gives them, read from the
// System Apps list on this iPad (a tweak groups them there): the App Store is "STORE", TV is "TVAPP",
// Voice Memos is "VOICE_MEMOS", and so on.
static NSString *DMAppSettingsURL(NSString *bundleID) {
    static NSDictionary *systemSections = nil;
    if (!systemSections) systemSections = @{
        @"com.apple.AppStore": @"STORE",          @"com.apple.iBooks": @"IBOOKS",
        @"com.apple.mobilecal": @"CALENDAR",      @"com.apple.MobileAddressBook": @"CONTACTS",
        @"com.apple.facetime": @"FACETIME",       @"com.apple.gamecenter": @"GAMECENTER",
        @"com.apple.mobilemail": @"MAIL",         @"com.apple.Maps": @"MAPS",
        @"com.apple.measure": @"MEASURE",         @"com.apple.MobileSMS": @"MESSAGES",
        @"com.apple.news": @"NEWS",               @"com.apple.mobilenotes": @"NOTES",
        @"com.apple.reminders": @"REMINDERS",     @"com.apple.mobilesafari": @"SAFARI",
        @"com.apple.shortcuts": @"SHORTCUTS",     @"com.apple.stocks": @"STOCKS",
        @"com.apple.Translate": @"TRANSLATE",     @"com.apple.VoiceMemos": @"VOICE_MEMOS",
        @"com.apple.Music": @"MUSIC",             @"com.apple.tv": @"TVAPP",
    };
    NSString *section = systemSections[bundleID];
    if (section) return [NSString stringWithFormat:@"prefs:root=%@", section];
    // Any other system app (Photos, Camera, Files, Clock, Home, Podcasts ...) has no page of its own in
    // this Settings: open the System Apps list (verified) rather than dropping to General.
    id proxy = DMProxyForBundle(bundleID);
    if ([DMCall(proxy, @"applicationType") isEqualToString:@"System"]) return @"prefs:root=System%20Apps";
    return [NSString stringWithFormat:@"prefs:root=%@", bundleID];
}

static void DMOpenAppSettings(SBApplication *app) {
    NSString *bid = [app bundleIdentifier];
    if (bid) DMOpenURL(DMAppSettingsURL(bid), [NSString stringWithFormat:@"settings for %@", bid]);
}

typedef enum { DMEngineNone = 0, DMEngineMilkyWay, DMEngineAerial, DMEngineZetsu } DMEngine;
static BOOL DMZetsuInstalled(void);
static DMEngine DMActiveEngine(void);
@class AXWindowView;
static UIView *DMStageForBundle(NSString *bundleID);
static NSArray<UIWindow *> *DMZetsuWindows(void);
static NSArray<UIWindow *> *DMZetsuAllWindows(void);
static NSString *DMZetsuWindowBundle(UIWindow *w);
static void DMZetsuClose(UIWindow *w);
static UIWindow *DMZetsuWindowFor(NSString *bundleID);
static void DMZetsuSurface(UIWindow *w);
static const void *kStageClosingKey;   // (defined below)
// Force quit: the process is killed (not just its window closed). A windowed app's window goes first, then the app is terminated a moment later.
static void DMAerialClose(NSString *bundleID);
// The App Switcher's controller. iOS 15: SBMainSwitcherViewController. iOS 16 has no such class any more (so every call below silently did nothing
// there: Force Quit left the cards, the stale-card sweep never ran, DMSwitcherVisible was always NO); its SBMainSwitcherControllerCoordinator has the
// same calls (-recentAppLayouts, -_deleteAppLayoutsMatchingBundleIdentifier:, -isAnySwitcherVisible; checked live with methsearch_ on the iPad 2).
// On 16 the coordinator is taken only if SpringBoard already made it (+sharedInstanceIfExists), so no call of ours ever creates it.
static id DMSwitcherController(void) {
    Class vc = objc_getClass("SBMainSwitcherViewController");
    if (vc) return DMCall(vc, @"sharedInstance");   // iOS 15: unchanged
    Class co = objc_getClass("SBMainSwitcherControllerCoordinator");
    if (!co) return nil;
    SEL ifExists = NSSelectorFromString(@"sharedInstanceIfExists");
    if ([(id)co respondsToSelector:ifExists]) return ((id (*)(id, SEL))objc_msgSend)(co, ifExists);
    return DMCall(co, @"sharedInstance");
}
// ===== Haptic Touch menus and window changes (context-menu crash prevention) ============================================================
// iPad 2 Safe Mode (2026-09-25 00:50): a Haptic Touch menu's dismissal needs the view it came from to still be in its window (UIKit raises in
// -[UIPreviewTarget initWithContainer:...] otherwise; PreviewTargetGuard below turns that into a harmless fade). A window closed, sent full screen or
// force quit -- or a Dock rebuilt by that -- under an open or fading menu took that view out of its window. So those window changes WAIT while any menu
// is up or still fading out: checked every 0.1 s, at most 2 s; then the menu is closed without animation first. (Moves and resizes are not held back:
// they never take a view out of its window.)
// A UIKit context menu is a view controller presented from a view controller of the window it comes from, and it stays in that presentation chain
// until its dismissal has finished.
static UIViewController *DMContextMenuVCInWindow(UIWindow *w) {
    UIViewController *vc = w.rootViewController;
    for (int n = 0; vc && n < 8; n++) {
        UIViewController *p = vc.presentedViewController;
        if (!p || p == vc) break;
        NSString *cn = NSStringFromClass([p class]);
        if ([cn containsString:@"ContextMenu"] || [cn containsString:@"ClickPresentation"]) return p;
        vc = p;
    }
    return nil;
}
static UIViewController *DMAnyContextMenuVC(UIWindow **inWindow) {
    for (UIWindow *w in DMAllWindows()) {
        UIViewController *m = DMContextMenuVCInWindow(w);
        if (m) { if (inWindow) *inWindow = w; return m; }
    }
    return nil;
}
static NSMutableDictionary<NSString *, dispatch_block_t> *gCtxWaiting = nil;
static NSMutableArray<NSString *> *gCtxWaitOrder = nil;
static BOOL gCtxPolling = NO, gCtxFlushing = NO;
static void DMContextMenuPoll(int n) {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        UIWindow *in = nil;
        UIViewController *menu = DMAnyContextMenuVC(&in);
        if (menu && n < 20) { DMContextMenuPoll(n + 1); return; }
        if (menu) {
            DMLog([NSString stringWithFormat:@"[ctxmenu] a menu (%@ in %@) is still up after 2 s: closed without animation first", NSStringFromClass([menu class]), NSStringFromClass([in class])]);
            if (!menu.isBeingDismissed) [menu.presentingViewController dismissViewControllerAnimated:NO completion:nil];
        }
        gCtxPolling = NO;
        NSArray<NSString *> *keys = [gCtxWaitOrder copy]; NSDictionary<NSString *, dispatch_block_t> *blocks = [gCtxWaiting copy];
        [gCtxWaitOrder removeAllObjects]; [gCtxWaiting removeAllObjects];
        DMLog([NSString stringWithFormat:@"[ctxmenu] menu gone after %.1f s: %@ now", (n + 1) * 0.1, [keys componentsJoinedByString:@", "]]);
        gCtxFlushing = YES;
        for (NSString *k in keys) { dispatch_block_t b = blocks[k]; if (b) b(); }
        gCtxFlushing = NO;
    });
}
// YES = held back (`again` runs once the menu is gone; a newer call with the same key replaces a waiting one).
static BOOL DMWaitForContextMenu(NSString *key, dispatch_block_t again) {
    if (gCtxFlushing || !again || DMTestFlag("/tmp/msb-noctxwait")) return NO;
    UIWindow *in = nil;
    UIViewController *menu = DMAnyContextMenuVC(&in);
    if (!menu) return NO;
    if (!gCtxWaiting) { gCtxWaiting = [NSMutableDictionary dictionary]; gCtxWaitOrder = [NSMutableArray array]; }
    if (!gCtxWaiting[key]) [gCtxWaitOrder addObject:key];
    gCtxWaiting[key] = [again copy];
    DMLog([NSString stringWithFormat:@"[ctxmenu] %@ waits: a menu is %@ (%@ in %@)", key, menu.isBeingDismissed ? @"fading out" : @"up", NSStringFromClass([menu class]), NSStringFromClass([in class])]);
    if (!gCtxPolling) { gCtxPolling = YES; DMContextMenuPoll(0); }
    return YES;
}
static NSSet<NSString *> *DMSwitcherBundleIDs(id sw);
static NSSet<NSString *> *DMLiveRunningBundleIDs(void);
static void DMForceQuitBundle(NSString *bundleID) {
    if (!bundleID.length) return;
    if (DMWaitForContextMenu([@"force quit " stringByAppendingString:bundleID], ^{ DMForceQuitBundle(bundleID); })) return;
    BOOL windowed = DMStageForBundle(bundleID) != nil;
    // Zetsu parity: without this, a Zetsu-windowed app's process would be killed with nothing telling Zetsu's own window to go away first --
    // its window (which has no idea its app just died) would be left orphaned on screen. Only the window is closed here, not the app (matching
    // the MilkyWay/Aerial branches below, which are also "close/hide the window" calls, not kills -- the actual kill happens once for
    // everyone a few lines down): -CloseAppWindow: is a real, existing ZetsuAppController method (confirmed via methsearch on a live
    // instance), called on the controller Zetsu itself already created, not something invented here.
    UIWindow *zetsuWindow = nil;
    for (UIWindow *w in DMZetsuAllWindows()) if ([DMZetsuWindowBundle(w) isEqualToString:bundleID]) zetsuWindow = w;   // minimized (hidden) ones too
    if (zetsuWindow) {
        windowed = YES;
        DMLog([NSString stringWithFormat:@"[action] force quit %@: closing its Zetsu window first", bundleID]);
        DMZetsuClose(zetsuWindow);
    }
    DMLog([NSString stringWithFormat:@"[action] force quit %@ (%@)", bundleID, windowed ? @"windowed" : @"full screen"]);
    if (zetsuWindow) {   // already handled above
    } else if (windowed && DMActiveEngine() == DMEngineMilkyWay) {   // MilkyWay: its own close (the red button is redirected to this function, so this is the plain close)
        UIView *w = DMStageForBundle(bundleID);
        if ([w respondsToSelector:NSSelectorFromString(@"closeButtonAction:")]) [(AXWindowView *)w closeButtonAction:nil];
    } else if (windowed) DMAerialClose(bundleID);
    // Stage Manager as the engine: the app's window closed with its own action first -- only that item leaves its stage (deleting the app's
    // layouts took every other window of the stage with it, logic test SM-4) -- and the switcher clean-up below leaves multi-window stages alone.
    BOOL sm = DMSMEngine();
    if (sm && DMSMWindowAction(bundleID, @"close")) windowed = YES;
    else if (sm && DMSMTakeOutOfHiddenStages(bundleID)) windowed = YES;   // (its stage not on screen: its own Close needs the window shown)
    if (sm) DMSMForgetApp(bundleID);   // (its size from before full screen: not brought back after a quit, logic test C5)
    void (^kill)(void) = ^{
    BKSTerminateApplicationForReasonAndReportWithDescription(bundleID, 5, false, @"MacStatusBar - force quit");
    // Same two-step cleanup ForceQuitMenu does: killing the process leaves the
    // app switcher card behind, so delete it (twice, to catch SpringBoard re-adding it).
    void (^remove)(void) = ^{
        id sw = DMSwitcherController();
        if (sm) {   // (a stage that still holds other windows is never deleted: only layouts where the app is alone)
            for (id al in DMCall(DMCall(objc_getClass("SBMainSwitcherControllerCoordinator"), @"sharedInstance"), @"recentAppLayouts")) {
                NSDictionary *m = DMCall(al, @"itemsToLayoutAttributesMap");
                BOOL has = NO; for (id it in m) if ([DMCall(it, @"bundleIdentifier") isEqual:bundleID]) has = YES;
                if (has && m.count > 1) { DMLog([NSString stringWithFormat:@"[action] force quit %@: its stage holds other windows -- left alone", bundleID]); return; }
            }
        }
        if ([sw respondsToSelector:@selector(_deleteAppLayoutsMatchingBundleIdentifier:)])
            ((void (*)(id, SEL, id))objc_msgSend)(sw, @selector(_deleteAppLayoutsMatchingBundleIdentifier:), bundleID);
    };
    dispatch_async(dispatch_get_main_queue(), remove);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.6 * NSEC_PER_SEC)), dispatch_get_main_queue(), remove);
    };
    if (windowed) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)((sm ? 0.45 : 0.15) * NSEC_PER_SEC)), dispatch_get_main_queue(), kill); else kill();
}
static void DMForceQuit(SBApplication *app) { DMForceQuitBundle([app bundleIdentifier]); }


static SBApplication *DMFrontApp(void) {
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    return [sb respondsToSelector:@selector(_accessibilityFrontMostApplication)]
               ? [sb _accessibilityFrontMostApplication] : nil;
}

// "Minimize": send the app to the background (the same as pressing Home) without killing it.
static void DMMinimize(void) {
    SpringBoard *sb = (SpringBoard *)[UIApplication sharedApplication];
    SEL home = NSSelectorFromString(@"_simulateHomeButtonPress");
    if ([sb respondsToSelector:home]) {
        DMLog(@"[action] minimize via -[SpringBoard _simulateHomeButtonPress]");
        ((void (*)(id, SEL))objc_msgSend)(sb, home);
        return;
    }
    // This build's SpringBoard renamed it to take a completion block (confirmed live via methsearch_SpringBoard on this iPad: the plain
    // -_simulateHomeButtonPress is gone, only -_simulateHomeButtonPressWithCompletion: is registered now) -- unrelated to Zetsu/Aerial, just this
    // OS build's API, so the old selector above silently found nothing and fell all the way through. A nil completion is the normal, safe way
    // to call an Apple completion-block API when the result is not needed (every such API checks the block before calling it).
    SEL homeC = NSSelectorFromString(@"_simulateHomeButtonPressWithCompletion:");
    if ([sb respondsToSelector:homeC]) {
        DMLog(@"[action] minimize via -[SpringBoard _simulateHomeButtonPressWithCompletion:]");
        ((void (*)(id, SEL, id))objc_msgSend)(sb, homeC, nil);
        return;
    }
    id ui = nil;
    Class uiClass = objc_getClass("SBUIController");
    SEL shared = NSSelectorFromString(@"sharedInstance");
    if ([uiClass respondsToSelector:shared]) ui = ((id (*)(id, SEL))objc_msgSend)(uiClass, shared);
    for (NSString *name in @[@"clickedMenuButton", @"handleHomeButtonSinglePressUp"]) {
        SEL sel = NSSelectorFromString(name);
        if ([ui respondsToSelector:sel]) {
            DMLog([NSString stringWithFormat:@"[action] minimize via -[SBUIController %@]", name]);
            ((void (*)(id, SEL))objc_msgSend)(ui, sel);
            return;
        }
    }
    // Same rename pattern, this build's SBUIController also wants the front window scene (confirmed via methsearch_SBUIController: only
    // -handleHomeButtonSinglePressUpForWindowScene: and the ...ForWindowScene:withSourceType: variant exist now, not the plain one above).
    SEL sceneSel = NSSelectorFromString(@"handleHomeButtonSinglePressUpForWindowScene:");
    if (ui && [ui respondsToSelector:sceneSel]) {
        id scene = MSBDMainWindowScene();   // (the iPad's scene: with an external display the first scene could be the TV's)
        if ([scene isKindOfClass:[UIWindowScene class]]) {
            DMLog(@"[action] minimize via -[SBUIController handleHomeButtonSinglePressUpForWindowScene:]");
            ((void (*)(id, SEL, id))objc_msgSend)(ui, sceneSel, scene);
            return;
        }
    }
    DMLog(@"[action] minimize: no known selector available");
}

// ---- traffic lights: the actions ------------------------------------------------------------------------------
// Only engine builds we have tested get any integration (2026-09-24; same idea as DMAerialBuildTested): the engine's library FILE is identified by
// the Mach-O UUIDs of its slices (fat or thin), read straight from /var/jb/usr/lib/TweakInject, so it can also be checked in %ctor, before the engine has
// loaded. Any other build (an update we have not tried) runs plain, with none of our window features. To support a new build: test it, then add the UUIDs
// (`dwarfdump --uuid` on the dylib from its deb).
//   Zetsu 1.6.2 and 1.6.6 (Chariz; 1.6.4 rewrote its internals and added "Stage"), MilkyWay4 0.1.1 (akusio; 0.1.0 is older and untested).
static NSSet<NSString *> *DMDylibFileUUIDs(NSString *path) { return MSBDDylibUUIDs(path); }   // (EngineBuilds.h)
static BOOL DMEngineBuildTested(NSString *lib) {
    static NSMutableDictionary<NSString *, NSNumber *> *cache = nil;
    if (!cache) cache = [NSMutableDictionary dictionary];
    if (cache[lib]) return cache[lib].boolValue;
    NSSet *uuids = DMDylibFileUUIDs([NSString stringWithFormat:@"/var/jb/usr/lib/TweakInject/%@.dylib", lib]);
    BOOL ok = uuids.count > 0;
    NSMutableArray *which = [NSMutableArray array];
    for (NSString *u in uuids) { NSString *w = MSBDEngineBuildLabel(lib, u); if (w) [which addObject:w]; else ok = NO; }
    cache[lib] = @(ok);
    DMLog([NSString stringWithFormat:@"[engine] %@ build %@: %@", lib, [[uuids allObjects] componentsJoinedByString:@"/"] ?: @"(no file)", ok ? [NSString stringWithFormat:@"tested (%@), integration allowed", [which componentsJoinedByString:@", "]] : @"NOT a tested build -- it runs on its own, with none of our window features"]);
    return ok;
}
static BOOL DMMilkyWayInstalled(void) { return objc_getClass("AXWindowView") != Nil && DMEngineBuildTested(@"MilkyWay4"); }

// ---- which window engine: MilkyWay or Aerial (never both) ----
// Settings > Mac Status Bar > Window Engine. Both tweaks can be present, but only the chosen one is used; the choice falls back to the other
// one when the chosen tweak is not installed. Automatic (nothing chosen yet) prefers Aerial.
static UIColor *gStatusTextColor = nil;   // the colour the status bar draws its text in (for the keyboard pill)
static CGFloat gCCScale = 0.82;   // Settings > Control Center Size: BigSurCenter's drop-down panel is scaled to this (1 = as it is)
static BOOL gSSHActive = NO;   // the SSH icon is shown in the status bar
static const void *kSSHIconKey = &kSSHIconKey, *kSSHButtonKey = &kSSHButtonKey;
static BOOL gVPNActive = NO;   // the VPN icon is shown in the status bar (bundled with Control Center otherwise, like the WiFi icon)
static NSString *gVPNAppBundleID = nil, *gVPNAppName = nil;   // the app whose tunnel is connected, if it says so (nil: open Settings > VPN instead)
static NSString *gVPNConfigName = nil;   // the connected VPN's own name, as Settings > VPN lists it (the menu's second line)
static NEVPNManager *gVPNManager = nil;   // its configuration (the menu's Disconnect: on demand off, then the connection stopped)
static const void *kVPNIconKey = &kVPNIconKey, *kVPNButtonKey = &kVPNButtonKey;
static void DMRefreshVPNState(void);   // (defined with the watcher)
static void DMVPNDisconnect(NEVPNManager *m);   // (defined with the VPN menu)
#if DEBUG
static NSString *gVPNFakeProvider = nil;   // (tests: vpnfake_<provider id> -- a VPN counts as connected through that provider; vpnfake_off ends it)
#endif
static BOOL gWiFiMenuOn = NO;   // Settings > Status Bar > Wi-Fi Menu (pref wifiMenu; on unless switched off where supported, iPadOS 15/16 only): our own Wi-Fi icon and its menu (WiFiMenu.h)
static const void *kWiFiIconKey = &kWiFiIconKey, *kWiFiButtonKey = &kWiFiButtonKey;
static void DMOpenWiFiMenu(UIButton *btn);   // (defined in WiFiMenu.h)
static void DMWiFiMenuGone(NSString *why);   // (WiFiMenu.h: a menu closed -- its scan stops if it was ours)
static BOOL gShowMuteIcon = YES;   // Settings > Status Bar > Audio > Show Mute Icon (on by default)
static BOOL gRingerMuted = NO;     // the ringer is muted (Silent Mode): the mute icon shows (see DMMuteIconWanted)
static BOOL gMuteIconShown = NO;   // the visible status bar shows it (the keyboard pill then sits left of it, as of the SSH icon)
static const void *kMuteIconKey = &kMuteIconKey;
static const void *kIconsStartKey = &kIconsStartKey, *kIconsRecheckKey = &kIconsRecheckKey;   // (a status bar copy's last status icon start, follow-ups in a row)
static const void *kIconsBornKey = &kIconsBornKey, *kIconsSlowLookKey = &kIconsSlowLookKey;    // (when the copy was first laid out; a slow look is pending)
static CGFloat gStatusIconsLeft = 0.0;   // screen x where the Control Center icons start (0 = not known yet)
static BOOL gTidyKeyboardPill = NO;    // Settings > Keyboard: the keyboard / microphone pill moves to the status bar (experimental: off for new installs)
static NSString *gEnginePref = nil;   // "aerial", "milkyway", "zetsu", "off" (no windows at all) or nil
// Aerial 5.0 (and, per static analysis of its actual binary, likely every build after the 3.0 this integration was built against) renames
// almost its entire custom method surface to a randomized string on every build -- confirmed directly: only the class names themselves and
// two selectors WE CALL (never hook) survive unobfuscated (triggerAerialForBundle:withFrame:, closeAerialForBundle:); everything we HOOK
// (initWithBundleID: -- where our own window-attach setup runs -- minimizeStage, handleResizeBR:, handlePan:, _adjustStageToFitScreenIfNeeded,
// and others) is gone under that name. Our %hook blocks would then install onto the CLASS successfully (Logos only needs objc_getClass to
// find something) but intercept nothing beyond a few standard inherited UIKit selectors (setFrame:, layoutSubviews, ...) that happen to keep
// their real names because overriding them at all requires matching Apple's own spelling -- so Aerial would go on creating windows with
// none of our setup ever running, and something downstream that assumes it did is the likely cause of the Safe Mode crash the owner reported
// picking Aerial with a newer public build installed. This checks a small set of the known-3.0-only selectors (chosen because our own
// %hook/NSSelectorFromString call sites already depend on these exact names, so this is the same lookup they would do, not a new guess)
// and treats Aerial as unusable at all -- not "installed" -- unless every one of them is still there under its real name. Purely read-only:
// respondsToSelector checks, no alloc/init, no calls into anything. DMActiveEngine() (and everything that branches on it, which is every
// Aerial-specific call site in this file) falls back to MilkyWay/None automatically once this returns NO, the same as if Aerial were not
// installed at all -- the owner's own "aerial" preference choice is left exactly as he set it, just not acted on while it would be unsafe to.
// Aerial 5.0 support. Its build obfuscates most custom selectors to random names that change with every build (e.g. minimizeStage became
// "Aerial_lIIIlIIlIlllIlI:" and gained a CGAffineTransform argument), but three things survive and are used here to find each method again:
// the ivar names (unchanged, so KVC on _bundleID / _isMinimized keeps working), the type encodings, and the source order of the methods,
// which the compiler preserves as the order of their code in the binary (so sorting the methods by IMP address recovers it). The few methods
// that keep their real names (touchesBegan:withEvent:, initWithFrame:, layoutSubviews, traitCollectionDidChange:, removeFromSuperview, the
// ...:adjustLeft:adjustRight:adjustTop:adjustBottom: tail, ...) are the anchors. Every rule below was checked against both 3.0 (real names)
// and 5.0 (by the ivars and selectors each method's code references, see the report), and the resolver demands that every role is found
// with the exact expected shape; one miss and Aerial stays switched off, exactly as before -- nothing is ever hooked or called on a guess.
// Purely read-only (method lists, encodings, IMP addresses): no alloc/init, nothing is called.
static int gAerialFlavor = -1;   // -1 not checked yet, 0 unusable, 3 = real (3.0) names, 5 = resolved obfuscated names
static int gA5PrefsState = 0;   // 0 not decided yet, 1 held (Aerial 5.0 is our engine), 2 given back
static void DMAerial5SwallowPrefs(NSString *why);
@interface DMBlockLink : NSObject   // a CADisplayLink that calls a block on every display frame until it returns NO (debug triggers)
@property (nonatomic, copy) BOOL (^block)(void);
@property (nonatomic, strong) CADisplayLink *link;
- (void)start;
@end
@implementation DMBlockLink
- (void)start { self.link = [CADisplayLink displayLinkWithTarget:self selector:@selector(tick:)]; [self.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes]; }
- (void)tick:(CADisplayLink *)l { if (!self.block || !self.block()) { [l invalidate]; self.link = nil; self.block = nil; } }
@end
static const void *kA5ChromeKey, *kA5SeenKey;   // (tentative: defined with the Aerial 5.0 theme; used by the a5burst trigger)
static void DMAerial5GiveBackPrefs(NSString *why);
static NSMutableDictionary<NSString *, NSString *> *gAerialSelMap;   // 3.0 name -> this build's name
static BOOL gAerialMinimizeTakesTransform = NO;   // 5.0: the minimize method is -(void)x:(CGAffineTransform)t
typedef struct { NSString *name; NSString *types; uintptr_t imp; } DMAerialMeth;
static NSArray<NSValue *> *DMAerialSortedMethods(Class cls, const char *imagePath) {
    unsigned n = 0; Method *ms = class_copyMethodList(cls, &n);
    NSMutableArray *out = [NSMutableArray array];
    for (unsigned i = 0; i < n; i++) {
        // arm64e (the M1): IMPs come back PAC-signed, so their raw values carry a signature in the high bits and do not sort by address.
        // Stripping the signature gives the plain code address (a no-op on arm64) -- the source order the resolver relies on.
        IMP imp = (IMP)ptrauth_strip((void *)method_getImplementation(ms[i]), ptrauth_key_function_pointer);
        Dl_info info; if (!dladdr((const void *)imp, &info) || !info.dli_fname || strcmp(info.dli_fname, imagePath) != 0) continue;   // only Aerial's own code
        const char *enc = method_getTypeEncoding(ms[i]);
        NSMutableString *t = [NSMutableString string];
        for (const char *c = enc ? enc : ""; *c; c++) if (*c < '0' || *c > '9') [t appendFormat:@"%c", *c];
        [t replaceOccurrencesOfString:@"{CGRect={CGPoint=dd}{CGSize=dd}}" withString:@"R" options:0 range:NSMakeRange(0, t.length)];
        [out addObject:@[NSStringFromSelector(method_getName(ms[i])), [t copy], @((uintptr_t)imp)]];
    }
    free(ms);
    [out sortUsingComparator:^NSComparisonResult(NSArray *a, NSArray *b) { return [a[2] compare:b[2]]; }];
    return out;
}
static NSInteger DMAerialIndex(NSArray *list, NSString *name) {
    for (NSUInteger i = 0; i < list.count; i++) if ([list[i][0] isEqualToString:name]) return i;
    return -1;
}
static NSString *DMAerialAt(NSArray *list, NSInteger i, NSString *types) {   // the name at that position if its types match, else nil
    if (i < 0 || i >= (NSInteger)list.count) return nil;
    return [list[i][1] isEqualToString:types] ? list[i][0] : nil;
}
static BOOL DMAerialResolveObfuscated(NSMutableArray<NSString *> *missing) {
    Class stage = objc_getClass("AerialStage"), core = objc_getClass("AerialCore");
    Method anchor = stage ? class_getInstanceMethod(stage, @selector(initWithFrame:)) : NULL;
    Dl_info info;
    if (!core || !anchor || !dladdr(ptrauth_strip((const void *)method_getImplementation(anchor), ptrauth_key_function_pointer), &info) || !info.dli_fname || !strstr(info.dli_fname, "Aerial")) { [missing addObject:@"Aerial's image"]; return NO; }
    const char *image = info.dli_fname;
    for (NSString *iv in @[@"_bundleID", @"_isMinimized", @"_hostView", @"_contentView", @"_preMinimizeFrame"]) if (!class_getInstanceVariable(stage, iv.UTF8String)) [missing addObject:iv];
    NSArray *L = DMAerialSortedMethods(stage, image);
    NSMutableDictionary *m = [NSMutableDictionary dictionary];
    #define DM_ROLE(key, expr) do { NSString *v_ = (expr); if (v_ && ![m.allValues containsObject:v_]) m[key] = v_; else [missing addObject:key]; } while (0)
    NSInteger touches = DMAerialIndex(L, @"touchesBegan:withEvent:");
    DM_ROLE(@"_bringStageToFrontIfNeeded", touches == 1 ? DMAerialAt(L, 0, @"v@:") : nil);   // the very first method, before touchesBegan:withEvent:
    NSInteger initFrame = DMAerialIndex(L, @"initWithFrame:"), layout = DMAerialIndex(L, @"layoutSubviews");
    DM_ROLE(@"handlePan:", (initFrame >= 0 && layout == initFrame + 2) ? DMAerialAt(L, initFrame + 1, @"v@:@") : nil);   // the only method between those two
    NSInteger trait = DMAerialIndex(L, @"traitCollectionDidChange:");
    BOOL traitOK = trait >= 0 && DMAerialAt(L, trait + 1, @"v@:@") != nil;   // updateAppearanceForTraitCollection:
    DM_ROLE(@"_adjustStageToFitScreenIfNeeded", traitOK ? DMAerialAt(L, trait + 2, @"v@:") : nil);
    DM_ROLE(@"_saveCurrentStateForOrientation", traitOK ? DMAerialAt(L, trait + 3, @"v@:") : nil);
    NSInteger removeSV = DMAerialIndex(L, @"removeFromSuperview"), simul = DMAerialIndex(L, @"gestureRecognizer:shouldRecognizeSimultaneouslyWithGestureRecognizer:");
    BOOL runOK = removeSV >= 4 && simul == removeSV - 5;   // adjustContentScaleToHost, ensureSceneVisible, finalSceneFallback, removeStageSafely
    DM_ROLE(@"adjustContentScaleToHost", runOK ? DMAerialAt(L, removeSV - 4, @"v@:") : nil);
    DM_ROLE(@"ensureSceneVisible", runOK ? DMAerialAt(L, removeSV - 3, @"v@:") : nil);
    DM_ROLE(@"removeStageSafely", runOK && DMAerialAt(L, removeSV - 2, @"v@:") ? DMAerialAt(L, removeSV - 1, @"v@:") : nil);
    NSString *flex = nil; int flexCount = 0;
    for (NSArray *e in L) if ([e[1] isEqualToString:@"v@:R"]) { flex = e[0]; flexCount++; }
    DM_ROLE(@"_applyFlexDisabledLayoutWithScreenBounds:", flexCount == 1 ? flex : nil);
    NSInteger willEnd = DMAerialIndex(L, @"contextMenuInteraction:willEndForConfiguration:animator:"), menuVisible = -1; int boolCount = 0;
    for (NSUInteger i = 0; i < L.count; i++) if ([L[i][1] isEqualToString:@"B@:"]) { menuVisible = i; boolCount++; }   // isMenuVisible: the only no-argument BOOL
    DM_ROLE(@"handleResizeBR:", (boolCount == 1 && willEnd >= 0 && menuVisible > willEnd) ? DMAerialAt(L, menuVisible + 1, @"v@:@") : nil);
    NSInteger trim = -1;
    for (NSUInteger i = 0; i < L.count; i++) if ([L[i][0] hasSuffix:@":adjustLeft:adjustRight:adjustTop:adjustBottom:"]) trim = (trim == -1) ? (NSInteger)i : -2;
    BOOL trimOK = trim > 3 && DMAerialAt(L, trim - 2, @"v@:@") != nil;   // handleMinimizedTap:
    DM_ROLE(@"restoreFromMinimize", trimOK ? DMAerialAt(L, trim - 1, @"v@:") : nil);
    NSString *minimize = trimOK ? DMAerialAt(L, trim - 3, @"v@:{CGAffineTransform=dddddd}") : nil;
    gAerialMinimizeTakesTransform = minimize != nil;
    if (!minimize && trimOK) minimize = DMAerialAt(L, trim - 3, @"v@:");
    DM_ROLE(@"minimizeStage", minimize);
    // AerialCore (class methods): these kept their later keywords, only the first one is renamed
    NSArray *C = DMAerialSortedMethods(object_getClass(core), image);
    NSString *fg = nil, *bg = nil, *apply = nil, *rehost = nil; int fgN = 0, bgN = 0, applyN = 0, rehostN = 0;
    NSInteger trigger = DMAerialIndex(C, @"triggerAerialForBundle:");
    for (NSUInteger i = 0; i < C.count; i++) {
        NSString *s = C[i][0], *t = C[i][1];
        if ([s hasSuffix:@":foregroundvalue:"] && [t isEqualToString:@"v@:@B"]) { fg = s; fgN++; }
        if ([s hasSuffix:@":forApp:"] && [t isEqualToString:@"v@:B@"]) { bg = s; bgN++; }
        NSString *base = [s componentsSeparatedByString:@":"][0];
        if ([s isEqualToString:[base stringByAppendingString:@":frame:"]] && [t isEqualToString:@"v@:@R"] && DMAerialIndex(C, [base stringByAppendingString:@":frame:force:"]) < 0) { apply = s; applyN++; }
        if ([s isEqualToString:[base stringByAppendingString:@":"]] && [t isEqualToString:@"v@:@"] && trigger >= 0 && (NSInteger)i < trigger) {
            NSInteger c = DMAerialIndex(C, [base stringByAppendingString:@":completion:"]);
            if (c == (NSInteger)i + 1 && [C[c][1] isEqualToString:@"v@:@@?"]) { rehost = s; rehostN++; }
        }
    }
    DM_ROLE(@"setForeground:foregroundvalue:", fgN == 1 ? fg : nil);
    DM_ROLE(@"forceBackgrounded:forApp:", bgN == 1 ? bg : nil);
    DM_ROLE(@"applySceneFrameForBundle:frame:", applyN == 1 ? apply : nil);
    DM_ROLE(@"rehost:", rehostN == 1 ? rehost : nil);
    #undef DM_ROLE
    if (missing.count) return NO;
    gAerialSelMap = m;
    return YES;
}
// The selector this Aerial build uses for what 3.0 called `name` (the name itself on 3.0, or anything not in the map).
static SEL DMAerialSel(NSString *name) {
    NSString *mapped = gAerialSelMap[name];
    return NSSelectorFromString(mapped ?: name);
}
// Debug-only (needs /tmp/macstatusbar-debug): how SpringBoard ends, written straight into our log, since a quiet exit() leaves no crash report.
#include <execinfo.h>
static void DMDeathWrite(const char *what) {
    int fd = open("/tmp/macstatusbar.log", O_WRONLY | O_APPEND | O_CREAT, 0644);
    if (fd < 0) return;
    write(fd, what, strlen(what));
    void *frames[48]; int n = backtrace(frames, 48);
    backtrace_symbols_fd(frames, n, fd);
    close(fd);
}
static void DMDeathSignal(int sig) {
    char msg[96]; snprintf(msg, sizeof msg, "--:--:--.--- [death] SpringBoard got fatal signal %d, backtrace:\n", sig);
    DMDeathWrite(msg);
    signal(sig, SIG_DFL); raise(sig);
}
static void DMDeathExit(void) { DMDeathWrite("--:--:--.--- [death] SpringBoard is calling exit(), backtrace:\n"); }
static void DMInstallDeathLog(void) {
    static BOOL done = NO; if (done || !DMTestFlag("/tmp/macstatusbar-debug")) return; done = YES;
    atexit(DMDeathExit);
    int sigs[] = {SIGABRT, SIGSEGV, SIGBUS, SIGILL, SIGTRAP, SIGFPE, SIGTERM};
    for (unsigned i = 0; i < sizeof sigs / sizeof sigs[0]; i++) signal(sigs[i], DMDeathSignal);
    DMLog(@"[death] exit/signal logging on (debug)");
}
// Only Aerial builds we have actually tested get any integration (2026-09-23): 3.0 (real method names, hooked) and 5.0 (scrambled names,
// driven hook-free). Every 4.x build scrambles its names like 5.0, and 5.0 kills SpringBoard when anything hooks it; our 5.0 path never hooks, but it
// identifies Aerial's scrambled methods by their shape, and on an untested build that could pick a wrong method to call -- on Dopamine a single
// SpringBoard crash already means Safe Mode. So the loaded Aerial.dylib is identified by its Mach-O UUID (both slices of each tested build), and any
// other build, including future ones, runs as plain Aerial with none of our window features until it has been tested and added here.
static NSString *DMAerialImageUUID(void) {
    Dl_info info;
    if (!dladdr((__bridge const void *)objc_getClass("AerialCore"), &info) || !info.dli_fbase) return nil;
    const struct mach_header_64 *mh = (const struct mach_header_64 *)info.dli_fbase;
    if (mh->magic != MH_MAGIC_64) return nil;
    const uint8_t *p = (const uint8_t *)(mh + 1);
    for (uint32_t i = 0; i < mh->ncmds; i++) {
        const struct load_command *lc = (const struct load_command *)p;
        if (lc->cmd == LC_UUID) return [[[NSUUID alloc] initWithUUIDBytes:((const struct uuid_command *)lc)->uuid] UUIDString];
        p += lc->cmdsize;
    }
    return nil;
}
static BOOL DMAerialBuildTested(void) {
    NSString *uuid = DMAerialImageUUID();
    NSString *which = uuid ? MSBDEngineBuildLabel(@"Aerial", uuid) : nil;
    DMLog([NSString stringWithFormat:@"[aerial] loaded Aerial build %@: %@", uuid ?: @"(unknown)", which ? [NSString stringWithFormat:@"tested (%@), integration allowed", which] : @"NOT a tested build -- Aerial runs on its own, with none of our window features"]);
    return which != nil;
}
// Aerial 5.0 crash-loop guard helpers (see DMAerialCompatible). A SpringBoard crash leaves a SpringBoard-*.ips report in CrashReporter (the folder
// belongs to mobile, so SpringBoard can list it) and our Safe Mode tweak's /var/mobile/.eksafemode after a crash.
static BOOL gAerialGuardWaiting = NO;   // the crash-loop guard is still waiting for a possible crash report (first 6 s): no engine acts yet
static BOOL DMSpringBoardCrashedSince(time_t since) {   // (only real crash reports, SpringBoard-<date>.ips, never cpu_resource/wakeups: CrashGuard.h)
    if (access("/var/mobile/.eksafemode", F_OK) == 0) return YES;
    if (MSBDGuardFakeReport() > 0) return YES;   // (test builds: /tmp/msb-fakecrash-report, when it points at us)
    return MSBDGuardCrashes((long)since) > 0;   // (only crashes that point at us, or cannot be judged: another tweak's crash is not counted)
}
static double DMProcessAge(void) {   // seconds since this SpringBoard process started
    struct kinfo_proc kp; size_t len = sizeof kp; int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, getpid()};
    if (sysctl(mib, 4, &kp, &len, NULL, 0) != 0) return 1e9;
    struct timeval now; gettimeofday(&now, NULL);
    return (now.tv_sec - kp.kp_proc.p_starttime.tv_sec) + (now.tv_usec - kp.kp_proc.p_starttime.tv_usec) / 1e6;
}
// iPadOS 17+ (untested versions) and "SpringBoard is still starting" (first 8 s), both asked on every scene update and layout there: cached -- the
// version never changes, and once the start is over it stays over (the age needs a sysctl each time).
static BOOL DMNewOS(void) { static int v = -1; if (v < 0) v = [NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 17; return v; }
// ---- The status bar's classes (1.2.4, issue #5). iPadOS 15/16: SpringBoard's status bar is UIKit's (UIStatusBarWindow > UIStatusBar_Modern >
// _UIStatusBar > _UIStatusBarForegroundView > _UIStatusBarStringView). iPadOS 17 moved it into SystemStatusUI.framework: SBStatusBarWindow >
// STUIStatusBar_Wrapper > STUIStatusBar > STUIStatusBarForegroundView > STUIStatusBarStringView, same shape (UIKit's classes stay, for apps).
// Every status bar class is named here by its UIKit name; DMSBClass gives the class SpringBoard uses. 15/16: always the UIKit class, exactly as
// before -- the SystemStatusUI path only exists on 17+ and only when its classes are there.
static const char *const kDMSBNames[][2] = {
    {"_UIStatusBarForegroundView", "STUIStatusBarForegroundView"},
    {"_UIStatusBarStringView", "STUIStatusBarStringView"},
    {"UIStatusBar_Modern", "STUIStatusBar_Wrapper"},
    {"_UIStatusBar", "STUIStatusBar"},
    {"UIStatusBarWindow", "SBStatusBarWindow"},
    {"_UIStatusBarIndicatorVPNItem", "STUIStatusBarVPNItem"},
    {"_UIStatusBarActivityItem", "STUIStatusBarActivityItem"},
    {"_UIStatusBarPillBackgroundActivityItem", "STUIStatusBarPillBackgroundActivityItem"},
    {"_UIStatusBarWifiItem", "STUIStatusBarWifiItem"},
};
static BOOL DMSBUseSTUI(void) {   // iPadOS 17+ with SystemStatusUI's bar classes present
    static int v = -1;
    if (v >= 0) return v;
    v = 0;
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion < 17) return v;
    if (!objc_getClass("STUIStatusBarForegroundView")) dlopen("/System/Library/PrivateFrameworks/SystemStatusUI.framework/SystemStatusUI", RTLD_LAZY);
    v = objc_getClass("STUIStatusBarForegroundView") && objc_getClass("STUIStatusBar") && objc_getClass("STUIStatusBarStringView") && objc_getClass("STUIStatusBar_Wrapper");
    return v;
}
// The name SpringBoard's bar uses for `uikitName` (the UIKit name itself on 15/16, or when the new class is missing).
static const char *DMSBNameC(const char *uikitName) {
    if (!DMSBUseSTUI()) return uikitName;
    for (size_t i = 0; i < sizeof(kDMSBNames) / sizeof(kDMSBNames[0]); i++)
        if (strcmp(kDMSBNames[i][0], uikitName) == 0) return objc_getClass(kDMSBNames[i][1]) ? kDMSBNames[i][1] : uikitName;
    return uikitName;
}
static Class DMSBClass(const char *uikitName) { return objc_getClass(DMSBNameC(uikitName)); }
static NSString *DMSBName(const char *uikitName) {   // (cached per table entry, no allocation: asked for every view in some layout passes)
    static NSString *cache[sizeof(kDMSBNames) / sizeof(kDMSBNames[0])];
    for (size_t i = 0; i < sizeof(kDMSBNames) / sizeof(kDMSBNames[0]); i++)
        if (strcmp(kDMSBNames[i][0], uikitName) == 0) { if (!cache[i]) cache[i] = @(DMSBNameC(uikitName)); return cache[i]; }
    return @(uikitName);
}
// A class name check: `name` is the class SpringBoard's bar uses for `uikitName` (15/16: exactly the old isEqualToString: test).
static BOOL DMSBIs(NSString *name, const char *uikitName) { return [name isEqualToString:DMSBName(uikitName)]; }
static unsigned gSBItemHooks;   // (diagnostics: which item hook groups went on -- 1 VPN badge, 2 activity spinner, 4 pill, 8 pill 17+, 16 Wi-Fi item)
// For windows only (nothing of ours is called on them): either family's status bar window.
static BOOL DMSBIsBarWindowName(NSString *name) { return [name isEqualToString:@"UIStatusBarWindow"] || (DMSBUseSTUI() && [name isEqualToString:DMSBName("UIStatusBarWindow")]); }
static BOOL DMStarting(void) { static BOOL over = NO; if (over) return NO; if (DMProcessAge() >= 8.0) { over = YES; return NO; } return YES; }
static BOOL DMAerialCompatible(void) {
    if (gAerialFlavor >= 0) return gAerialFlavor != 0;
    Class stage = objc_getClass("AerialStage");
    if (!stage || !objc_getClass("AerialCore")) return NO;   // not loaded (yet): ask again later
    if (!DMAerialBuildTested()) { gAerialFlavor = 0; return NO; }
    NSArray<NSString *> *required = @[@"initWithBundleID:", @"minimizeStage", @"handleResizeBR:", @"handlePan:", @"_adjustStageToFitScreenIfNeeded"];
    BOOL named = YES;
    for (NSString *name in required) if (![stage instancesRespondToSelector:NSSelectorFromString(name)]) { named = NO; break; }
    if (named) { gAerialFlavor = 3; return YES; }
    NSMutableArray<NSString *> *missing = [NSMutableArray array];
    // Crash-loop guard (new code path, and two SpringBoard crashes in a row mean Safe Mode): a marker is written when the 5.0 integration
    // switches on and removed 30 s later. Finding it at startup means the previous SpringBoard ENDED inside that window -- but an ordinary respring
    // (Settings, sbreload, a quick second respring) ends it too, and the old guard then switched the integration off for no reason (Phase 1 finding).
    // So the marker only counts when there is evidence of a real crash since it was written: a SpringBoard crash report newer than the marker, or
    // the Safe Mode file. The crash report is written by ReportCrash a moment after the crash, possibly after this SpringBoard started, so while
    // the marker is there and no evidence has shown up yet, the decision waits until this process is 6 s old (the integration just starts later).
    static const char *kProbation = "/tmp/macstatusbar-aerial5-probation";
    struct stat probation;
    if (stat(kProbation, &probation) == 0) {
        BOOL crashed = DMSpringBoardCrashedSince(probation.st_mtime);
        if (!crashed && DMProcessAge() < 6.0) { gAerialGuardWaiting = YES; return NO; }   // ask again on a later tick
        gAerialGuardWaiting = NO;
        unlink(kProbation);
        if (crashed) {
            gAerialFlavor = 0;
            DMLog(@"[aerial] the previous SpringBoard crashed right after the Aerial 5.0 integration switched on (crash report / Safe Mode found): it stays off for this run (respring to try again)");
            return NO;
        }
        DMLog(@"[aerial] the previous SpringBoard ended within 30 s of switching the Aerial 5.0 integration on, but without a crash (an ordinary respring): integration stays on");
    }
    DMInstallDeathLog();
    if (DMAerialResolveObfuscated(missing)) {
        int fd = open(kProbation, O_CREAT | O_WRONLY, 0644); if (fd >= 0) close(fd);
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(30 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ unlink(kProbation); });
        gAerialFlavor = 5;
        NSMutableArray *pairs = [NSMutableArray array];
        for (NSString *k in [gAerialSelMap.allKeys sortedArrayUsingSelector:@selector(compare:)]) [pairs addObject:[NSString stringWithFormat:@"%@=%@", k, gAerialSelMap[k]]];
        DMLog([NSString stringWithFormat:@"[aerial] obfuscated Aerial build: every role resolved (minimize takes a transform: %d): %@", gAerialMinimizeTakesTransform, [pairs componentsJoinedByString:@" "]]);
        return YES;
    }
    gAerialFlavor = 0;
    DMLog([NSString stringWithFormat:@"[aerial] this Aerial build renamed the methods our integration needs and these could not be identified with certainty: %@ -- Aerial integration stays off rather than hook a guess", [missing componentsJoinedByString:@", "]]);
    return NO;
}
// Opens an app in an Aerial window. On 3.0 our +triggerAerialForBundle:withFrame: hook sends the app its window size before it launches (a cold
// launch that only learns its small size later can hang); 5.0 cannot be hooked, so the size is sent here, before the call, instead.
static void DMSendWindowSize(NSString *bundleID, CGSize size);
static UIPanGestureRecognizer *DMA5AerialDrag(UIView *stage);
static BOOL DMA5DragAllowedAt(UIView *stage, CGPoint p);
static void DMOpenFullScreen(NSString *bundleID);
// Aerial installed but not working (Aerial 5.0 right after a fresh install, before its license check and its own respring: its classes are there, but
// asking it for a window does nothing). Any Aerial window seen in this SpringBoard -- by any path: a tap on an icon, our menus, the stage list, a new
// window's veil -- proves it works (2026-09-26, M1: Photos opened from inside the full-screen Camera got its window, but the check 3 s later did not
// find it, and earlier windows opened by icon taps had never been counted: a false "not active" note). Until then, each window we ask for is checked 3 s later; if none
// came, Aerial counts as not working for the rest of this run: the engine is "none" (apps open full screen, as without our tweak) and that app is
// opened full screen now. The next SpringBoard (Aerial's own respring after activation) tries again.
static BOOL gAerialSeenWindow = NO, gAerialNotWorking = NO;
static BOOL gAerialNotePending = NO;   // (DMCheckAerialNote: tell the user, once per SpringBoard run)
static NSArray<UIView *> *DMAerialStages(void);
static void DMInvalidateEngineCache(void);
static BOOL DMWelcomePref(CFStringRef key);
static void DMWelcomeSetPref(CFStringRef key, CFPropertyListRef value);
// Once Aerial has made a window on this iPad it is activated for good (2026-09-26: once it is seen active on a device it is never
// checked again): that is saved (aerialSeenWorking, with the welcome's other one-time marks) and the 3 s check never runs again.
static void DMAerialMarkWorking(void) {
    gAerialSeenWindow = YES;
    static BOOL saved = NO;
    if (saved || gAerialFlavor != 5) return;   // (the saved mark is about Aerial 5.0's activation only)
    saved = YES;
    if (!DMWelcomePref(CFSTR("aerialSeenWorking"))) { DMWelcomeSetPref(CFSTR("aerialSeenWorking"), kCFBooleanTrue); DMLog(@"[aerial] Aerial made a window: saved as working on this iPad, never checked again"); }
}
static void DMAerialCheckItWorked(NSString *bundleID) {
    if (gAerialFlavor != 5) return;   // (only Aerial 5.0 has an activation; 3.0 always works once loaded)
    if (gAerialSeenWindow || !bundleID.length) return;
    if (DMWelcomePref(CFSTR("aerialSeenWorking"))) { gAerialSeenWindow = YES; return; }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        if (gAerialSeenWindow || gAerialNotWorking) return;
        if (DMStageForBundle(bundleID) || DMAerialStages().count) { DMAerialMarkWorking(); return; }
        gAerialNotWorking = YES;
        gAerialNotePending = YES;
        DMInvalidateEngineCache();
        DMLog([NSString stringWithFormat:@"[aerial] no window came 3 s after asking Aerial for %@ (Aerial not working yet, e.g. not activated): our window engine stays off until the next respring; the app opens full screen", bundleID]);
        if (![[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]) DMOpenFullScreen(bundleID);
    });
}
static void DMAerialTrigger(NSString *bundleID, CGRect frame) {
    if (!DMAppNeedsFullScreen(bundleID)) DMAerialCheckItWorked(bundleID);   // (a full-screen-only app is never asked for, so no window is expected)
    if (DMAppNeedsFullScreen(bundleID)) {
        DMLog([NSString stringWithFormat:@"[fullscreenonly] %@ cannot live in a window: opened full screen instead of an Aerial window", bundleID]);
        dispatch_async(dispatch_get_main_queue(), ^{ DMOpenFullScreen(bundleID); });
        return;
    }
    if (gAerialFlavor == 5 && bundleID.length) DMSendWindowSize(bundleID, CGSizeMake(MAX(0, frame.size.width - 12.0), MAX(0, frame.size.height - 33.0)));   // 5.0: the app sits 6 pt in at the sides, 13 pt below the top and 20 above the bottom (measured live)
    if (DMTestFlag("/tmp/msb-aerial-simdead")) { DMLog(@"[aerial] (test) Aerial not asked: acting as an Aerial that does not work yet"); return; }   // debug: simulates a not-yet-activated Aerial
    ((void (*)(id, SEL, id, CGRect))objc_msgSend)((id)objc_getClass("AerialCore"), NSSelectorFromString(@"triggerAerialForBundle:withFrame:"), bundleID, frame);
    if (gAerialFlavor == 5) {   // style the new window before it is ever drawn in Aerial's own (white) look, then keep at it while it fades in
        extern void DMAerial5WatchNow(void);
        DMAerial5WatchNow();
        DMLog([NSString stringWithFormat:@"[aerial5] %@ triggered: its window %@ right after the call", bundleID, DMStageForBundle(bundleID) ? @"exists (styled before its first frame)" : @"does not exist yet"]);
        for (int i = 1; i <= 40; i++) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(i * 0.016 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMAerial5WatchNow(); });
    }
}
static BOOL DMAerialInstalled(void) { return objc_getClass("AerialCore") != Nil && !gAerialNotWorking && DMAerialCompatible(); }
// Aerial's Control Center toggle ("open new apps as windows"): a plain boolean in Aerial's own preferences, read the same way Aerial reads it.
static BOOL DMAerialToggleOn(void) {
    CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
    Boolean valid = false;
    Boolean on = CFPreferencesGetAppBooleanValue(CFSTR("AerialEnabled"), CFSTR("com.uzra.aerial"), &valid);
    return valid && on;
}
// Settings > Mac Status Bar > Enable Windowing (its own switch, above Window Engine, not one of that picker's choices any more): on by default. An
// existing install that had "Off" picked in the old Window Engine picker (before this switch existed) is honoured the same way, once, so nobody who
// had windowing off gets it back on for free.
// Cached like DMActiveEngine (kept a second, dropped on a preferences change): it read the preferences on every call, and the Stage Manager engine
// asks through DMSMEngine() on every touch event and every window card / grabber layout (logic test 29 Sep, P1).
static int gDMWindowingCache = -1;
static CFTimeInterval gDMWindowingCacheAt = 0;
static BOOL DMWindowingEnabled(void) {
    if (gStockBar) return NO;   // (stock status bar: the engine runs on its own)
    CFTimeInterval now = CACurrentMediaTime();
    if (gDMWindowingCache >= 0 && now - gDMWindowingCacheAt < 1.0) return gDMWindowingCache;
    BOOL on;
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("windowingEnabled"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (v) { on = CFGetTypeID(v) == CFBooleanGetTypeID() ? CFBooleanGetValue(v) : YES; CFRelease(v); }
    else on = ![gEnginePref isEqualToString:@"off"];   // no switch value yet: fall back to the old picker's "Off", if that is what was chosen before
    gDMWindowingCache = on; gDMWindowingCacheAt = now;
    return on;
}
static DMEngine DMActiveEngineUncached(void);
static void DMDotsApply(void);   // (Hide Multitasking Dots: only while an engine runs, defined with DMLoadPrefs)
// Cached: it read the preferences on every one of its ~95 call sites (several per 0.2 s tick). The answer is kept for a second, dropped at once on
// a preferences change (DMPrefsChanged) and whenever one of the things it depends on changes (the crash-loop guard, Aerial's flavour, the engine pick).
static int gDMEngineCache = -1;
static CFTimeInterval gDMEngineCacheAt = 0;
static BOOL gDMEngineCacheGuard = NO; static int gDMEngineCacheFlavor = -1; static __unsafe_unretained NSString *gDMEngineCachePref = nil;
static void DMInvalidateEngineCache(void) { gDMEngineCache = -1; gDMWindowingCache = -1; }
static DMEngine DMActiveEngine(void) {
    CFTimeInterval now = CACurrentMediaTime();
    if (gDMEngineCache >= 0 && now - gDMEngineCacheAt < 1.0 && gDMEngineCacheGuard == gAerialGuardWaiting && gDMEngineCacheFlavor == gAerialFlavor && gDMEngineCachePref == gEnginePref)
        return (DMEngine)gDMEngineCache;
    DMEngine e = DMActiveEngineUncached();
    gDMEngineCache = (int)e; gDMEngineCacheAt = now; gDMEngineCacheGuard = gAerialGuardWaiting; gDMEngineCacheFlavor = gAerialFlavor; gDMEngineCachePref = gEnginePref;
    // The answer can change seconds after the bar's first layout (a quick respring: Aerial's crash-loop guard decides once SpringBoard is 6 s old;
    // or Aerial loads a little later). The bar's "Window" title depends on it, so lay the bars out again when it changes -- it was seen missing
    // for over a minute after a quick respring on the M1 (and the SSH icon sat on top of the airplane icon until the next layout).
    static int lastSeen = -1;
    if (lastSeen >= 0 && lastSeen != (int)e) {
        DMLog([NSString stringWithFormat:@"[engine] active engine changed %d -> %d: status bars laid out again", lastSeen, (int)e]);
        dispatch_async(dispatch_get_main_queue(), ^{ for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout]; DMDotsApply(); });   // (and the dots: DMDotsApply)
    }
    lastSeen = (int)e;
    return e;
}
#include "SMEngineAPI.h"   // (the Stage Manager engine's private API: checked wrappers + the start-up self-check, 2026-09-29)
#include "SMFit.h"         // (where a Stage Manager window may go: sizes in points of their own reference, fitted into the desktop, 3 Oct; Mac test tools/test-smfit.sh)
// ---- Stage Manager as the engine (iPadOS 16+, 2026-09-28, branch stage-manager) ----
// Picked as "stagemanager" in Settings > Window Engine: Apple's own Stage Manager does the windowing (natively on M1/M2 iPads, through TrollPad on
// older ones). None of the third-party engines is loaded (the root helper treats it like windowing off), and for all of their code paths there is NO
// engine (DMActiveEngine() == DMEngineNone): only the Stage Manager parts below run -- Stage Manager kept on, apps opened from the Home Screen and the
// Dock added to the current stage, the traffic lights running the window's own Close / Minimize / Enter Full Screen, the stage below our status bar,
// the recent-stages strip hidden. Notes: Release/docs/stage-manager-engine.md.
NSString *DMSMFrontWindowBundle(void);   // (Stage Manager engine, defined before %ctor)
// A status bar copy inside a Stage Manager window card that fills the screen (native full screen): there it is the top bar.
static BOOL DMSMCardIsFullSize(UIView *card) {   // (a window card as big as the screen: a full-screen app)
    if (!card || !card.window) return NO;
    CGSize scr = card.window.bounds.size, c = card.bounds.size;
    CGFloat longSide = MAX(scr.width, scr.height), shortSide = MIN(scr.width, scr.height);
    return MAX(c.width, c.height) >= longSide - 2.0 && MIN(c.width, c.height) >= shortSide - 2.0;
}
// A status bar copy inside a window card is the menu bar only in the TOP full-screen card: a full-screen app behind another one (both in the stage)
// kept its copy visible, and the clock balancing gave the time to that hidden copy -- the menu bar on screen had no clock.
static BOOL DMSMInFullScreenCard(UIView *v) {
    Class cc = objc_getClass("SBFluidSwitcherItemContainer");
    UIView *card = v;
    while (card && !(cc && [card isKindOfClass:cc])) card = card.superview;
    if (!DMSMCardIsFullSize(card)) return NO;
    NSArray *sibs = card.superview.subviews;
    NSUInteger i = [sibs indexOfObjectIdenticalTo:card];
    for (NSUInteger j = i + 1; i != NSNotFound && j < sibs.count; j++) {
        UIView *o = sibs[j];
        if (cc && [o isKindOfClass:cc] && !o.hidden && o.alpha > 0.01 && DMSMCardIsFullSize(o)) return NO;
    }
    return YES;
}
void DMSMRefreshBars(void);
void DMSMFlattenStages(NSString *why);
// (only once no third-party engine is loaded in this SpringBoard: right after the pick, before the respring that unloads it, the old engine still
// runs -- the two window systems must never run together)
static BOOL DMSMThirdPartyLoaded(void) {
    static CFTimeInterval at = -100; static BOOL loaded = NO;
    if (CACurrentMediaTime() - at < 5.0) return loaded;
    at = CACurrentMediaTime(); loaded = NO;
    for (uint32_t i = 0; i < _dyld_image_count() && !loaded; i++) {
        const char *n = _dyld_get_image_name(i);
        if (n && (strstr(n, "/Aerial.dylib") || strstr(n, "/Zetsu.dylib") || strstr(n, "/MilkyWay4.dylib"))) loaded = YES;
    }
    return loaded;
}
// Picked, possible here and verified -- whether Stage Manager is on right now aside (the watcher switches it on for the engine: DMSMEnginePicked).
static BOOL DMSMEnginePicked(void) {
    static int ios16 = -1;
    if (ios16 < 0) {
        ios16 = [NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 16 && objc_getClass("SBSwitcherChamoisSettings") != nil;
        // (and Stage Manager can really run here: a model that has it, or TrollPad installed -- logic test F6: with TrollPad removed, Stage
        //  Manager stayed "the engine", no engine of ours loaded and nothing had windows; then it counts as not picked. The same file test as
        //  Settings and the root helper (common/StageManagerAvailable.h): whether TrollPad is LOADED can't be asked this early -- it loads after
        //  us, and the first try cached "no" on the iPad 2, 29 Sep 07:22)
        if (ios16 && !MSBDStageManagerAvailable()) {
            ios16 = 0;
            if ([gEnginePref isEqualToString:@"stagemanager"]) DMLog(@"[smengine] Stage Manager is picked but can't run on this iPad (no Stage Manager, no TrollPad): not the engine");
        }
    }
    // (gSMCheckOK: every private class, method and signature the engine uses was found as expected at start, and its hooks went in -- DMSMSelfCheck.
    //  Otherwise it is not the engine: the default engine runs, and Stage Manager is not switched on for it)
    return ios16 && gSMCheckOK && [gEnginePref isEqualToString:@"stagemanager"] && DMWindowingEnabled() && !DMSMThirdPartyLoaded();
}
// The engine acts only while Stage Manager is really on (review: DMSMEngine never looked): before it is switched on for the engine -- the first
// seconds after the pick, Apple's introduction on a first switch-on -- or while the user turned it off (switched back on within 0.4 s), apps
// launch the normal way and none of the engine's hooks rewrites anything in a switcher that is not Stage Manager's.
static int gSMOnNow = -1;   // (Stage Manager on: the watcher's reading, every 0.4 s; -1 = not read yet)
static BOOL DMSMStageManagerOnNow(void);
static BOOL DMSMEngine(void) {
    return DMSMEnginePicked() && DMSMStageManagerOnNow();
}
static DMEngine DMActiveEngineUncached(void) {
    if (!DMWindowingEnabled()) return DMEngineNone;   // windowing switched off (or the stock status bar): every app is full screen
    if (DMSMEngine()) return DMEngineNone;   // (Stage Manager is the engine: no third-party engine, see DMSMEngine)
    BOOL mw = DMMilkyWayInstalled(), ae = DMAerialInstalled();
    // Aerial is installed but this build is not one our integration supports (not on the tested list, or its methods could not be identified):
    // unless another engine was picked explicitly, nothing of ours takes part in windowing, so plain Aerial works exactly as if this tweak were
    // not installed. (Falling back to MilkyWay here sent every launch into a MilkyWay window that never appeared -- seen on the M1 with 5.0.)
    if (!ae && gAerialGuardWaiting) return DMEngineNone;   // Aerial 5.0 crash-loop guard still deciding (a few seconds after a quick respring)
    if (!ae && objc_getClass("AerialCore") && (gAerialFlavor == 0 || gAerialNotWorking) && ![gEnginePref isEqualToString:@"milkyway"] && ![gEnginePref isEqualToString:@"zetsu"]) return DMEngineNone;
    // Zetsu (third engine): used when it is the one picked, or as the very last fallback when neither of the other two is there -- so a
    // setup that picked Aerial or MilkyWay behaves exactly as before, whether Zetsu is installed or not.
    if ([gEnginePref isEqualToString:@"zetsu"]) return DMZetsuInstalled() ? DMEngineZetsu : (ae ? DMEngineAerial : (mw ? DMEngineMilkyWay : DMEngineNone));
    if ([gEnginePref isEqualToString:@"milkyway"]) return mw ? DMEngineMilkyWay : (ae ? DMEngineAerial : (DMZetsuInstalled() ? DMEngineZetsu : DMEngineNone));
    return ae ? DMEngineAerial : (mw ? DMEngineMilkyWay : (DMZetsuInstalled() ? DMEngineZetsu : DMEngineNone));
}
// "Fit to Window" (tile the open windows) is our own switch, for both engines. It is separate from Aerial's Control Center toggle, which only decides whether
// apps opened from the Home Screen / Dock / our menus open as windows at all. The first time it is read and nothing is stored yet, it starts out off
// (every existing setup already has it stored, so nothing changes there).
// Cached (watcher plan step 2): only our own code writes fitToWindow (the Window menu, and nothing in MacSettings or the prefs bundles -- checked);
// the cache is written through here, dropped on a preferences change (DMPrefsChanged), and re-read at least every 10 s as a safety net.
static int gFitCache = -1; static CFTimeInterval gFitCacheAt = 0;
static void DMInvalidateFitCache(void) { gFitCache = -1; }
static void DMSetFitEnabled(BOOL on) {
    gFitCache = on; gFitCacheAt = CACurrentMediaTime();
    CFPreferencesSetValue(CFSTR("fitToWindow"), on ? kCFBooleanTrue : kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
}
static BOOL DMFitEnabled(void) {
    if (gFitCache >= 0 && CACurrentMediaTime() - gFitCacheAt < 10.0) return gFitCache == 1;
    CFPreferencesAppSynchronize(MSB_DOMAIN);
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("fitToWindow"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    if (!v) {   // nothing stored yet: off (the decision for new users; the old seed from Aerial's toggle only served builds that were never public)
        DMSetFitEnabled(NO);
        return NO;
    }
    BOOL on = CFGetTypeID(v) == CFBooleanGetTypeID() && CFBooleanGetValue(v);
    CFRelease(v);
    gFitCache = on; gFitCacheAt = CACurrentMediaTime();
    return on;
}
// "Open Apps as Windows": every launch (Home Screen, Dock, App Library, Spotlight, links, notifications, our menus) opens the app as a window instead of
// full screen. With Aerial it is Aerial's own Control Center toggle (`AerialEnabled`, which by itself only covers taps on icons); MilkyWay has no such
// switch, so it is our own setting there (`openAsWindows`).
static BOOL DMWindowedLaunchOn(void) {
    if (DMSMEngine()) {   // (Stage Manager as the engine: our own switch, ON unless turned off -- Stage Manager opens apps as windows)
        CFPreferencesAppSynchronize(MSB_DOMAIN);
        CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("openAsWindowsStageManager"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        BOOL on = !v || CFGetTypeID(v) != CFBooleanGetTypeID() || CFBooleanGetValue(v);
        if (v) CFRelease(v);
        return on;
    }
    DMEngine e = DMActiveEngine();
    if (e == DMEngineAerial) return DMAerialToggleOn();
    if (e != DMEngineMilkyWay && e != DMEngineZetsu) return NO;   // MilkyWay and Zetsu have no such switch of their own: ours
    CFPreferencesAppSynchronize(MSB_DOMAIN);
    CFPropertyListRef v = CFPreferencesCopyValue(CFSTR("openAsWindows"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    BOOL on = v && CFGetTypeID(v) == CFBooleanGetTypeID() && CFBooleanGetValue(v);
    if (v) CFRelease(v);
    return on;
}
static void DMSetWindowedLaunch(BOOL on) {
    if (DMSMEngine()) {
        CFPreferencesSetValue(CFSTR("openAsWindowsStageManager"), on ? kCFBooleanTrue : kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        return;
    }
    if (DMActiveEngine() == DMEngineAerial) {
        CFPreferencesSetAppValue(CFSTR("AerialEnabled"), on ? kCFBooleanTrue : kCFBooleanFalse, CFSTR("com.uzra.aerial"));
        CFPreferencesAppSynchronize(CFSTR("com.uzra.aerial"));
    } else {
        CFPreferencesSetValue(CFSTR("openAsWindows"), on ? kCFBooleanTrue : kCFBooleanFalse, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    }
}
static UIWindow *DMAerialWindow(void);
static NSArray<UIView *> *DMAerialStages(void);
static NSString *DMStageBundle(UIView *stage);
static BOOL DMStageMinimized(UIView *stage);
static UIView *DMStageForBundle(NSString *bundleID);
static void DMRememberStageFrame(UIView *stage);
static void DMEnforceStageFrame(UIView *stage, NSString *why);

// Bug (reported): opening an app from the App Library as a window left the App Library up over everything. A full-screen launch closes it on
// its own; a windowed launch never goes through that path. So whenever a launch ends in a window (a new one, or an existing one shown again),
// the App Library is dismissed here, with SpringBoard's own call (the same one the `library_0` debug trigger uses).
static BOOL DMLibraryVisible(void);
static UIWindow *DMStatusBarWindow(void);
static void DMDismissLibraryForWindow(NSString *bundleID) {
    if (!DMLibraryVisible()) return;
    id ic = DMCall(objc_getClass("SBIconController"), @"sharedInstance");
    SEL sel = NSSelectorFromString(@"dismissLibraryAnimated:completion:");   // iOS 15
    if ([ic respondsToSelector:sel]) {
        DMLog([NSString stringWithFormat:@"[lights] %@ opened as a window from the App Library: closing the App Library", bundleID]);
        ((void (*)(id, SEL, BOOL, id))objc_msgSend)(ic, sel, YES, nil);
        return;
    }
    // iOS 16: the call above is gone (so a window launch from the App Library left it up, on every engine). The one that closes the App Library the
    // Dock's button opened is -dismissLibraryForIconManager:windowScene:animated: (-dismissLibraryFromOverlayControllerAnimated: does not; both
    // tried live on the iPad 2).
    SEL sel16 = NSSelectorFromString(@"dismissLibraryForIconManager:windowScene:animated:");
    id mgr = DMCall(ic, @"iconManager"); id scene = DMStatusBarWindow().windowScene;
    if (![ic respondsToSelector:sel16] || !mgr || !scene) { DMLog(@"[lights] App Library: no dismiss call found"); return; }
    DMLog([NSString stringWithFormat:@"[lights] %@ opened as a window from the App Library: closing the App Library", bundleID]);
    ((void (*)(id, SEL, id, id, BOOL))objc_msgSend)(ic, sel16, mgr, scene, YES);
}
// Opens the app as a MilkyWay window. MilkyWay hooks +[SBIconView activateShortcut:withBundleIdentifier:forIconView:] and
// reacts to a shortcut item of type "jp.yuri.milkyway3.launchinwindow" (its Home Screen long-press "Launch As Window"), so
// we hand it the same kind of item. Without MilkyWay the stock method would reject it and abort, so it is only called
// when MilkyWay's window class exists. The app must not be in front any more.
static void DMLaunchAsWindow(NSString *bundleID) {
    if (DMAppNeedsFullScreen(bundleID)) {
        DMLog([NSString stringWithFormat:@"[fullscreenonly] %@ cannot live in a window: opened full screen instead of a MilkyWay window", bundleID]);
        dispatch_async(dispatch_get_main_queue(), ^{ DMOpenFullScreen(bundleID); });
        return;
    }
    Class itemClass = objc_getClass("SBSApplicationShortcutItem");
    Class iconClass = objc_getClass("SBIconView");
    SEL activate = NSSelectorFromString(@"activateShortcut:withBundleIdentifier:forIconView:");
    if (!DMMilkyWayInstalled() || !itemClass || ![(id)iconClass respondsToSelector:activate]) { DMLog(@"[lights] launch as window: MilkyWay not available"); return; }
    SBSApplicationShortcutItem *item = [[itemClass alloc] init];
    [item setType:@"jp.yuri.milkyway3.launchinwindow"];
    DMLog([NSString stringWithFormat:@"[lights] launch %@ as window", bundleID]);
    [iconClass activateShortcut:item withBundleIdentifier:bundleID forIconView:nil];
    DMDismissLibraryForWindow(bundleID);
}

@interface UIWindow (DMPrivateEarly)
+ (NSArray *)allWindowsIncludingInternalWindows:(BOOL)internal onlyVisibleWindows:(BOOL)visible;
@end
static void DMOpenFullScreen(NSString *bundleID);
static UIUserInterfaceStyle DMSystemInterfaceStyle(void);

static void DMCollectClassNames(UIView *v, int depth, NSMutableArray *out) {
    [out addObject:NSStringFromClass([v class])];
    if (depth < 9) for (UIView *s in v.subviews) DMCollectClassNames(s, depth + 1, out);
}

// ---- smooth transitions ------------------------------------------------------------------------------------------
// Swapping an app between full screen and a MilkyWay window used to show the Home Screen and a pop-in. A snapshot of the
// screen ("cover") is held over the swap instead, so the change looks continuous:
//   full screen -> window: cover the screen, minimize the app behind it, open the window, then shrink the cover into
//                          the window's spot while the window fades in;
//   window -> full screen: let MilkyWay maximize the window, cover it, swap in the real full-screen app, fade the cover.
// The cover lives in the status bar window: above the app and the Home Screen, below MilkyWay's windows.
static UIView *gCover = nil;

// The cover must live in the real, upright UIStatusBarWindow (screen-sized, level 999). The in-app status bar copy lives in
// SBMainSwitcherWindow, whose bounds are portrait with the content rotated under it: a landscape snapshot put there
// comes out turned a quarter turn.
static UIWindow *DMStatusBarWindow(void) {
    for (UIWindow *w in DMAllWindows())
        if (DMSBIs(NSStringFromClass([w class]), "UIStatusBarWindow") && !w.hidden) return w;
    return nil;
}
static void DMCoverRemove(void) {
    [gCover.layer removeAllAnimations];
    [gCover removeFromSuperview];
    gCover = nil;
}
static void DMCoverShowFor(double hold);
static void DMCoverShow(void) { DMCoverShowFor(3.0); }
static void DMCoverShowFor(double hold) {
    DMCoverRemove();
    UIWindow *w = DMStatusBarWindow();
    UIView *snap = w ? [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO] : nil;
    if (!snap) return;
    DMLog([NSString stringWithFormat:@"[cover] screen bounds %@, host window %@ bounds %@ transform %@, statusBarOrientation %ld, snapshot %@ %@",
           NSStringFromCGRect([UIScreen mainScreen].bounds), NSStringFromClass([w class]), NSStringFromCGRect(w.bounds), NSStringFromCGAffineTransform(w.transform),
           ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation")), NSStringFromClass([snap class]), NSStringFromCGRect(snap.frame)]);
    snap.frame = w.bounds;
    snap.userInteractionEnabled = NO;
    [w addSubview:snap];
    gCover = snap;
    UIView *mine = snap;   // whatever goes wrong, never leave a frozen screen behind
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(hold * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gCover == mine) DMCoverRemove(); });
}
static void DMCoverFadeOut(NSTimeInterval delay) {
    UIView *cover = gCover;
    if (!cover) return;
    [UIView animateWithDuration:0.28 delay:delay options:UIViewAnimationOptionCurveEaseOut animations:^{ cover.alpha = 0.0; }
                     completion:^(BOOL done) { if (gCover == cover) DMCoverRemove(); }];
}

static UIView *DMFindMilkyWayWindow(NSString *bundleID) {
    Class layerClass = objc_getClass("AXPassthroughWindow");
    Class viewClass = objc_getClass("AXWindowView");
    UIWindow *layer = [layerClass respondsToSelector:@selector(sharedInstance)] ? ((id (*)(id, SEL))objc_msgSend)((id)layerClass, @selector(sharedInstance)) : nil;
    for (UIView *v in layer.subviews)
        if (viewClass && [v isKindOfClass:viewClass] && [[(AXWindowView *)v bundleIdentifier] isEqualToString:bundleID]) return v;
    return nil;
}
static void DMWaitFor(BOOL (^condition)(void), int tries, void (^done)(BOOL ok)) {
    if (condition()) { done(YES); return; }
    if (tries <= 0) { done(NO); return; }
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMWaitFor(condition, tries - 1, done); });
}

// ---- MilkyWay windows behind full-screen apps ------------------------------------------------------------------
// MilkyWay's window layer floats at window level 1033, above everything, so its windows covered every full-screen app.
// Now the layer sits just above the Home Screen (below every app window) while an app is full screen, and goes back to
// the front on the Home Screen. The windows and their apps keep running either way; only their stacking changes. They
// come forward over a full-screen app when a new window is opened, or from the app menu's "Show Windows".
static const CGFloat kMilkyWayFrontLevel = 1033.0;
static const CGFloat kMilkyWayBackLevel = -0.5;      // above the Home Screen (-2), below the apps (0 and up)
static BOOL gFlexResize = YES;                       // apps re-lay out to their window's size (Aerial style) instead of MilkyWay scaling a full-screen picture
static BOOL gWindowsBehindApps = YES;                // Settings > Mac Status Bar > Window Buttons
static BOOL gWindowsPinnedForward = NO;              // brought over the current full-screen app on purpose
static BOOL gDockMenuOpen = NO;                      // a Dock icon's Haptic Touch menu is showing
static BOOL gHomeMenuOpen = NO;                      // a Home Screen icon's Haptic Touch menu is showing (the windows fade like for the App Library)
// A full-screen app sitting behind windows still shows through around them; tapping that visible part reclaims the status bar's name and traffic lights
// for it, the same way clicking a partly-covered window's visible edge focuses it on a Mac, even though the windows stay exactly where they are (on
// top). A tap on a window (DMRaiseStageForBundle) gives it back; so does the front app itself changing (a fresh value here is only ever meaningful for
// the app it was set for).
static NSString *gFullScreenActivatedBundle = nil;

static UIWindow *DMMilkyWayLayer(void) {
    Class layerClass = objc_getClass("AXPassthroughWindow");
    return [layerClass respondsToSelector:@selector(sharedInstance)] ? ((id (*)(id, SEL))objc_msgSend)((id)layerClass, @selector(sharedInstance)) : nil;
}
// A window minimized with the orange button stays alive (its app keeps running with all its state) but is hidden.
static const void *kMinimizedKey = &kMinimizedKey;
static BOOL DMWindowMinimized(UIView *window) { return [objc_getAssociatedObject(window, kMinimizedKey) boolValue]; }
static const void *kStageHiddenKey = &kStageHiddenKey;   // an Aerial stage we minimized the MilkyWay way (shrunk toward the Dock and hidden)
static NSUInteger DMMilkyWayWindowCount(void) {   // windows on screen, not the minimized ones
    Class viewClass = objc_getClass("AXWindowView");
    NSUInteger n = 0;
    for (UIView *v in DMMilkyWayLayer().subviews) if (viewClass && [v isKindOfClass:viewClass] && !DMWindowMinimized(v)) n++;
    return n;
}
static NSUInteger DMVisibleWindowCount(void) {   // windowed apps on screen (not minimized), whichever engine, PLUS any Zetsu windows (a
    // separate, independent engine that can have windows open alongside/instead of either of the two above -- counted unconditionally,
    // not gated on DMActiveEngine(), the same reasoning as DMMinimizeAllWindows just above).
    if (DMSMEngine()) return DMSMWindowBundles().count;
    if (DMActiveEngine() == DMEngineZetsu) { NSUInteger z = 0; for (UIView *s in DMAerialStages()) if (!s.hidden && !DMStageMinimized(s)) z++; return z; }
    NSUInteger n = DMZetsuWindows().count;
    if (DMActiveEngine() == DMEngineAerial) { for (UIView *s in DMAerialStages()) if (!s.hidden && !DMStageMinimized(s)) n++; return n; }
    return n + DMMilkyWayWindowCount();
}
// The Dock (and its Haptic Touch menus) live in SBFloatingDockWindow at level 25. While one of its menus is open, the
// windows drop to just under it, so the menu opens in front of them instead of behind.
static const CGFloat kBelowDockLevel = 24.0;
static BOOL DMStageMinimized(UIView *stage);
static UIView *gOverlay;   // (defined below) the status bar menu or dialog that is showing
static CGFloat DMEffectiveAlpha(UIView *v);
static long long gEnvMode = 0;   // the App Switcher's latest environment mode (2 = the switcher is up), from SpringBoard's transition events
// An app that has a window showing is never a full-screen app, even when SpringBoard reports it as the front app (it does while the App Switcher gesture
// runs over a window), so it must not sink the windows behind itself.
static BOOL DMFullScreenAppInFront(void) {
    SBApplication *front = DMFrontApp();
    if (!front) return NO;
    UIView *stage = DMStageForBundle([front bundleIdentifier]);
    return !(stage && !stage.hidden && !DMStageMinimized(stage));
}
static CGFloat gSoftKeyboardH = 0.0;   // how much of the screen SpringBoard's on-screen keyboard covers now (DMPlaceKeyboardPill, every tick)
// Windows brought forward over a full-screen app covered that app's own on-screen keyboard: on iPadOS 15 the keyboard of a full-screen app is drawn
// in the app's own layer, below our window level, so only its bottom row showed under the windows (seen live on the M1). While the full-screen app
// that was tapped last (gFullScreenActivatedBundle, set by a tap on the part of it showing around the windows) has the on-screen keyboard up, the
// windows step behind it; they come forward again as soon as the keyboard goes away.
// Every engine (layering audit F5): the cause is not Aerial 5.0's -- any window layer above the apps covers a full-screen app's keyboard -- and the
// signals are the engine's neither (SpringBoard's keyboard height, the app bridge's tap, DMDesiredWindowLevel, which Zetsu's per-window levels
// follow too, as they do for "Windows Behind Full-Screen Apps"). First seen and tested with Aerial 5.0; each engine has its own debug switch
// (/tmp/msb-typing-off-<aerial3|aerial5|milkyway|zetsu>) so a device test can compare with the old behaviour.
static BOOL DMTypingRuleForEngine(void) {
    switch (DMActiveEngine()) {
        case DMEngineAerial: return gAerialFlavor == 5 ? !DMTestFlag("/tmp/msb-typing-off-aerial5") : !DMTestFlag("/tmp/msb-typing-off-aerial3");
        case DMEngineMilkyWay: return !DMTestFlag("/tmp/msb-typing-off-milkyway");
        case DMEngineZetsu: return !DMTestFlag("/tmp/msb-typing-off-zetsu");
        default: return NO;
    }
}
static BOOL DMFullScreenAppTyping(void) {
    if (!gWindowsPinnedForward || gSoftKeyboardH < 100.0 || !gFullScreenActivatedBundle) return NO;
    if (!DMTypingRuleForEngine()) return NO;
    SBApplication *front = DMFrontApp();
    return front && [gFullScreenActivatedBundle isEqualToString:[front bundleIdentifier]] && DMFullScreenAppInFront();
}
static CGFloat DMDesiredWindowLevel(void) {
    BOOL typing = DMFullScreenAppTyping();
    static BOOL wasTyping = NO;
    if (typing != wasTyping) { wasTyping = typing; DMLog([NSString stringWithFormat:@"[focus] the full-screen app %@ its on-screen keyboard: the windows in front of it %@", typing ? @"brought up" : @"put away", typing ? @"step behind it" : @"come forward again"]); }
    if (typing) return kMilkyWayBackLevel;
    if (!gWindowsBehindApps || gWindowsPinnedForward || !DMFullScreenAppInFront()) {
        if (gDockMenuOpen) return kBelowDockLevel;
        // A status bar menu opens in the window that hosts the status bar (level 999 on the Home Screen, an app-level window inside
        // an app). While it is open the windows drop to just under that window so the menu is not hidden behind them.
        UIWindow *host = gOverlay.window;
        if (host) return MAX(kMilkyWayBackLevel, MIN(kMilkyWayFrontLevel, host.windowLevel - 0.5));
        return kMilkyWayFrontLevel;
    }
    return kMilkyWayBackLevel;
}
// The window that holds every windowed app: MilkyWay's layer or Aerial's window, whichever engine is in use.
static UIWindow *DMWindowLayer(void) { return DMActiveEngine() == DMEngineAerial ? DMAerialWindow() : DMMilkyWayLayer(); }
static void DMZetsuApplyLevels(void);
static CGFloat gLayerLevelWant = -1;   // the level last decided for the window layer (Aerial 5.0's pre-commit check compares with it, DMA5CatchNewStages)
static void DMNativeApplyLevel(void);
static void DMApplyWindowLevel(void) {
    DMNativeApplyLevel();   // (our native windows follow the same rules: under an open menu's window -- called when a menu opens and closes)
    if (DMActiveEngine() == DMEngineZetsu) { DMZetsuApplyLevels(); return; }   // Zetsu: one UIWindow per app, each given its level in turn
    UIWindow *layer = DMWindowLayer();
    if (!layer) return;
    CGFloat want = DMDesiredWindowLevel();
    gLayerLevelWant = want;
    if (layer.windowLevel != want) { layer.windowLevel = want; DMLog([NSString stringWithFormat:@"[lights] windows (%@) moved to level %.1f", DMActiveEngine() == DMEngineAerial ? @"Aerial" : @"MilkyWay", want]); }
}
// The App Library is hosted in the Home Screen window, far below the windows. Like Launchpad on a Mac, it takes over the screen: the windows
// fade away while it is showing (they would sit over its list) and come back when it is dismissed.
static BOOL gWindowsHiddenForLibrary = NO;
static BOOL DMLibraryVisible(void) {
    id mgr = DMCall(DMCall(objc_getClass("SBIconController"), @"sharedInstance"), @"iconManager");
    for (NSString *name in @[@"isOverlayLibraryViewVisible", @"isLibraryViewControllerVisible", @"isMainDisplayLibraryViewVisible"]) {   // (the last: iPadOS 16, where the first two are gone -- the windows stayed over the App Library)
        SEL s = NSSelectorFromString(name);
        if ([mgr respondsToSelector:s] && ((BOOL (*)(id, SEL))objc_msgSend)(mgr, s)) return YES;
    }
    return NO;
}
static void DMWatchLock(void);
static void DMWatchOrientation(void);
static void DMCloseMenuIfOrientationStale(void);
static void DMWatchAudioPlaying(void);
static void DMWatchFitClosures(void);
static void DMPlaceKeyboardPill(void);
static void DMKeepKeyboardFocusOnWindowAfterTurn(void);
static void DMKeyboardFocusFollowsFrontWindow(void);
static BOOL DMSpotlightShown(void);
static void DMWatchFitToggle(void);
static void DMUpdateFocusCatchers(void);
static void DMWatchSofaScore(void);
static void DMWatchZetsu(void);
static void DMWatchBarOverHidingApp(void);   // (with the GameStatusBar hooks, near the end)
static NSString *gBarOverHidingApp = nil;    // the app whose hidden status bar is shown over it right now (GameStatusBar)
static void DMSyncWindowsForLibraryBody(void);
static void DMSyncWindowFade(void);
// ---- performance measurement (watcher plan step 0; measurement only) ----
// /tmp/msb-perf switches the timing on WITHOUT the debug extras that /tmp/macstatusbar-debug turns on inside the timed code (the debug flag still
// implies it). Each section of the two watchers is timed and a summary is logged every 10 s: "[perf] 10 s: <section> avg .. max .. (n ..), ...".
static BOOL DMPerfOn(void) {   // (read once a second)
    static time_t at = 0; static BOOL on = NO; time_t now = time(NULL);
    if (now != at) { at = now; on = DMTestFlag("/tmp/msb-perf") || DMTestFlag("/tmp/macstatusbar-debug"); }
    return on;
}
typedef struct { const char *name; double sum, max; int n; } DMPerfSlot;
static DMPerfSlot gPerf[48]; static int gPerfCount = 0;
static DMPerfSlot *DMPerfSlotFor(const char *name) {
    for (int i = 0; i < gPerfCount; i++) if (gPerf[i].name == name) return &gPerf[i];
    if (gPerfCount < 48) { gPerf[gPerfCount].name = name; return &gPerf[gPerfCount++]; }
    return NULL;
}
#define DM_PERF(label, stmt) do { if (!DMPerfOn()) { stmt; break; } CFTimeInterval _pb = CACurrentMediaTime(); stmt; \
    double _pms = (CACurrentMediaTime() - _pb) * 1000.0; DMPerfSlot *_ps = DMPerfSlotFor(label); if (_ps) { _ps->sum += _pms; _ps->n++; if (_pms > _ps->max) _ps->max = _pms; } } while (0)
static void DMPerfReport(void) {
    static CFTimeInterval last = 0; CFTimeInterval now = CACurrentMediaTime();
    if (!DMPerfOn()) return;
    if (last == 0) { last = now; return; }
    if (now - last < 10.0) return;
    last = now;
    NSMutableString *line = [NSMutableString stringWithFormat:@"[perf] 10 s: snapshot stages %d hit / %d built, windows %d hit / %d built;", gDMSnapHits, gDMSnapMisses, gDMSnapWinHits, gDMSnapWinMisses];
    gDMSnapHits = gDMSnapMisses = gDMSnapWinHits = gDMSnapWinMisses = 0;
    for (int i = 0; i < gPerfCount; i++) if (gPerf[i].n) {
        [line appendFormat:@" %s avg %.2f max %.1f (n %d),", gPerf[i].name, gPerf[i].sum / gPerf[i].n, gPerf[i].max, gPerf[i].n];
        gPerf[i].sum = gPerf[i].max = 0; gPerf[i].n = 0;
    }
    DMLog(line);
}
#if DEBUG
static CFTimeInterval gIdleQuietUntil;
#endif
static void DMSyncWindowsForLibrary(void) {
#if DEBUG
    if (CACurrentMediaTime() < gIdleQuietUntil) return;
#endif
    CFTimeInterval began = CACurrentMediaTime();
    DMSnapBegin();
    DM_PERF("watcher", DMSyncWindowsForLibraryBody());
    DMSnapEnd();
    double ms = (CACurrentMediaTime() - began) * 1000.0;
    if (ms > 3.0 && DMTestFlag("/tmp/macstatusbar-debug")) {   // (rate-limited: on the iPad 2 nearly every tick takes 5-11 ms, and one line per tick grew the log to 90 MB)
        static CFTimeInterval lastPerf = 0; static int slow = 0; static double worst = 0;
        slow++; worst = MAX(worst, ms);
        CFTimeInterval now = CACurrentMediaTime();
        if (ms > 30.0 || now - lastPerf >= 60.0) {
            DMLog([NSString stringWithFormat:@"[perf] 0.2 s watcher took %.1f ms (%d ticks over 3 ms since the last line, worst %.1f ms)", ms, slow, worst]);
            lastPerf = now; slow = 0; worst = 0;
        }
    }
    DMPerfReport();
}
static void DMApplyControlCenterScale(void);
// The App Switcher and the windows. Aerial hides its whole window layer while the switcher is up and shows it again when the switcher goes away, driven by
// SpringBoard's transition events; a gesture that ends some other way can leave the layer hidden for good (the windows are gone, the apps still run, and
// only a respring brought them back). So: when no switcher is showing and the layer is still hidden after a moment, it is shown again. While the debug
// flag exists, every change of the state around it is logged, to have a timeline of a gesture.
static id DMSwitcherController(void);
static BOOL DMSwitcherVisible(void) {
    id sw = DMSwitcherController();
    for (NSString *name in @[@"isAnySwitcherVisible", @"isMainSwitcherVisible"]) {
        SEL sel = NSSelectorFromString(name);
        if ([sw respondsToSelector:sel] && ((BOOL (*)(id, SEL))objc_msgSend)(sw, sel)) return YES;
    }
    return NO;
}
static BOOL DMWindowWorkNeeded(void);
static void DMWatchSwitcher(void) {
    static CFTimeInterval hiddenSince = 0; static NSString *lastState = nil;
    if (DMActiveEngine() != DMEngineAerial) return;
    if (!DMWindowWorkNeeded()) { hiddenSince = 0; return; }   // (no stage: nothing to show again)
    UIWindow *layer = DMWindowLayer();
    if (!layer) return;
    BOOL switcher = DMSwitcherVisible();
    BOOL hiddenNow = layer.hidden || layer.alpha < 0.05;
    BOOL library = gWindowsHiddenForLibrary;
    CFTimeInterval now = CACurrentMediaTime();
    if (DMTestFlag("/tmp/macstatusbar-debug")) {   // (the full line only when the cheap inputs changed)
        static uint64_t lastKey = UINT64_MAX;
        uint64_t key = (uint64_t)switcher | ((uint64_t)layer.hidden << 1) | ((uint64_t)library << 2) | ((uint64_t)llround(layer.alpha * 100) << 3) | ((uint64_t)llround(layer.windowLevel) << 12);
        if (key != lastKey) {
            lastKey = key;
            NSString *state = [NSString stringWithFormat:@"switcher %d, layer hidden %d alpha %.2f level %.1f transform %@, front %@, stages %lu, library %d", switcher, layer.hidden, layer.alpha, layer.windowLevel, NSStringFromCGAffineTransform(layer.transform), [DMFrontApp() bundleIdentifier], (unsigned long)DMAerialStages().count, library];
            if (![state isEqualToString:lastState]) { lastState = state; DMLog([NSString stringWithFormat:@"[switcher] %@", state]); }
        }
    }
    if (!hiddenNow || switcher || library || DMAerialStages().count == 0) { hiddenSince = 0; return; }
    if (hiddenSince == 0) { hiddenSince = now; return; }
    if (now - hiddenSince < 0.3) return;
    hiddenSince = 0;
    DMLog(@"[switcher] the windows were still hidden with no App Switcher showing: showing them again");
    layer.hidden = NO; layer.alpha = 1.0; layer.transform = CGAffineTransformIdentity;
    DMApplyWindowLevel();
}
// ---- Stage Manager is held off while one of our window engines is on ------------------------------------------------------------------------
// iPadOS 16's own Stage Manager (on the iPads that have it, and on older ones through TrollPad, which switches Apple's feature on and keeps its
// setting under its own key) is a second window system: with one of ours running they fight over the same apps. SpringBoard's own switcher
// setting (SBAppSwitcherDefaults chamoisWindowingEnabled -- what Settings and the Control Center button change; TrollPad maps it to its own
// key) is kept off. If it gets switched on (Settings, Control Center) while our engine runs, it is switched off again at once and the user's
// wish is remembered: it goes back on when windowing is switched off, or Mac Status Bar is switched off or removed (here, on the root helper's off
// marker, and in sshtoggled GiveBackStageManager). TrollPad itself stays loaded (its external
// display support is independent of Stage Manager). iOS 15 has no such setting: nothing happens there.
static id DMSwitcherDefaults(void) {
    Class c = objc_getClass("SBDefaults");
    SEL local = NSSelectorFromString(@"localDefaults"), sw = NSSelectorFromString(@"appSwitcherDefaults");
    id d = [c respondsToSelector:local] ? ((id (*)(id, SEL))objc_msgSend)(c, local) : nil;
    return [d respondsToSelector:sw] ? ((id (*)(id, SEL))objc_msgSend)(d, sw) : nil;
}
static BOOL DMSMStageManagerOnNow(void) {
    if (gSMOnNow < 0) {   // (not read yet: asked now; SpringBoard's defaults not there yet this early -- asked again next time, not cached as off)
        id sd = DMSwitcherDefaults();
        SEL get = NSSelectorFromString(@"chamoisWindowingEnabled");
        if (![sd respondsToSelector:get]) return NO;
        gSMOnNow = ((BOOL (*)(id, SEL))objc_msgSend)(sd, get) ? 1 : 0;
    }
    return gSMOnNow == 1;
}
// SpringBoard's own test in its Stage Manager switch handler (-[SBFluidSwitcherViewController _chamoisWindowingUIEnabledDefaultChangeHandler], 16.7.7):
// the iPad switcher's layout state is "application" (unlockedEnvironmentMode 3) -- only then does a switch make a transition. 1 yes, 0 no, -1 not
// readable (the caller asks SpringBoard's front app instead).
static int DMSMSwitcherShowsApp(void) {
    @try {
        id coord = DMSMCoordinator();
        UIWindowScene *scene = MSBDMainWindowScene();
        SEL forScene = NSSelectorFromString(@"switcherControllerForWindowScene:");
        id sc = scene && [coord respondsToSelector:forScene] ? ((id (*)(id, SEL, id))objc_msgSend)(coord, forScene, scene) : DMCall(coord, @"_activeDisplaySwitcherController");
        id state = DMCall(DMCall(DMCall(sc, @"contentViewController"), @"layoutContext"), @"layoutState");
        SEL m = NSSelectorFromString(@"unlockedEnvironmentMode");
        if (state && DMSMSigOK(state, m, DMSMSigTime(), "unlockedEnvironmentMode")) return ((long long (*)(id, SEL))objc_msgSend)(state, m) == 3 ? 1 : 0;
    } @catch (NSException *e) {}
    return -1;
}
static void DMSMInstallOffWait(void);   // (SpringBoard's Stage Manager switch waits while windows would be dropped: below, after the hooks' declarations)
static void DMSMRunWaitingOff(void);
void DMInitStageManagerButtonHook(void);
static void DMStageManagerWatch(void) {
    static CFTimeInterval last = 0, notSince = 0;
    CFTimeInterval now = CACurrentMediaTime();
    if (now - last < 0.4) return;
    last = now;
    DMInitStageManagerButtonHook();
    DMSMInstallOffWait();
    DMSMRunWaitingOff();
    if (DMTestFlag("/tmp/msb-nosmguard")) return;   // (test: Stage Manager together with our engine, the guard down; debug builds only)
    id sd = DMSwitcherDefaults();
    SEL get = NSSelectorFromString(@"chamoisWindowingEnabled"), set = NSSelectorFromString(@"setChamoisWindowingEnabled:");
    if (![sd respondsToSelector:get] || ![sd respondsToSelector:set]) return;
    BOOL on = ((BOOL (*)(id, SEL))objc_msgSend)(sd, get);
    if (gSMOnNow != (int)on) { gSMOnNow = on; DMLog([NSString stringWithFormat:@"[stagemgr] Stage Manager is %@", on ? @"on" : @"off"]); }
    BOOL off = access("/var/jb/var/lib/sshtoggled-engines/msb-off-restored", F_OK) == 0   // (switched off or being removed: given back now, no 10 s wait)
            || access("/var/jb/Library/MobileSubstrate/DynamicLibraries/MacStatusBar.dylib", F_OK) != 0;   // (removed: the postrm deletes that marker, so
                                                      //  the loader's absence says it, as in the engine holds -- the helper's give-back is never undone)
    if (DMSMEnginePicked() && !off) {   // (Stage Manager IS the engine: kept on; turning it off in Control Center / Settings is undone like the hold below.
                                        //  Switched off or removed: not the engine any more -- the give-back below; it was undone here until 1.3.4)
        notSince = 0;
        if (on) DMSMNoteOwnStageUI();   // (its UI is ours for this SpringBoard: SpringBoard's own switch-off of it waits for a safe moment, SMEngineAPI.h)
        // (switched on only once SpringBoard is well up -- never in its first seconds, the review's likeliest Safe Mode cause on a first install --
        //  and only after the self-check passed, which DMSMEnginePicked() includes)
        if (!on && DMProcessAge() < 12.0) return;
        if (!on) {
            // (the way Control Center's own Stage Manager button does it -- decoded on 16.7.7: -[SBContinuousExposeModuleController
            //  setContinuousExposeEnabled:YES] writes SBChamoisWindowingEnabled only once Stage Manager was EVER on; the very first time it writes
            //  SBChamoisWindowingEverEnabled instead, and SpringBoard (-[SBMainSwitcherControllerCoordinator
            //  _chamoisWindowingUIEverEnabledDefaultChangeHandler]) closes Control Center and shows Apple's Stage Manager introduction
            //  (SpringBoardEducation), whose Continue switches it on. We do the same: a first switch-on by us never skips Apple's first-time
            //  path (review (A) option 1: a first install on an iPad that never had Stage Manager on). If it has not come on 45 s later -- the
            //  introduction declined or not there -- the setting is written directly, as before.)
            static CFTimeInterval everAskedAt = 0;
            SEL everGet = NSSelectorFromString(@"chamoisEverEnabled"), everSet = NSSelectorFromString(@"setChamoisEverEnabled:");
            if (!everAskedAt && [sd respondsToSelector:everGet] && [sd respondsToSelector:everSet] && !((BOOL (*)(id, SEL))objc_msgSend)(sd, everGet)) {
                everAskedAt = now;
                ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, everSet, YES);
                CFPreferencesSetValue(CFSTR("stageManagerOnForEngine"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);   // (on for the engine, as below)
                CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
                DMSMNoteOwnStageUI();
                DMLog(@"[smengine] Stage Manager was never on here: Apple's first-time path (its introduction; Continue switches it on)");
                return;
            }
            if (everAskedAt && now - everAskedAt < 45.0) return;   // (Apple's introduction may be up: Stage Manager comes on from its Continue)
            // (a setting that does not stay on -- iPadOS 16.0 keeps Stage Manager off where Apple's feature flag says so -- is written again after a
            //  pause that grows to a minute, not every 0.4 s; 1.3.4 logic test)
            static int notStaying = 0; static CFTimeInterval retryAt = 0;
            if (now < retryAt) return;
            ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, set, YES);
            gSMOnNow = ((BOOL (*)(id, SEL))objc_msgSend)(sd, get) ? 1 : 0;
            if (gSMOnNow != 1) {
                notStaying++;
                retryAt = now + MIN(60.0, 2.0 * notStaying);
                if (notStaying == 3) {
                    DMLog(@"[smengine] Stage Manager does not stay on here: tried again less often now (recorded with the Stage Manager check)");
                    DMSMRecordRuntimeFailure(@"Stage Manager does not stay on (setting written, read back off)");
                }
            } else notStaying = 0;
            // (switched on BY US -- or written, if it did not stay: remembered, so it goes back off when the engine changes, windowing goes off, or we're
            //  switched off/removed -- logic test F5: the hold below took our own "on" for the user's wish and brought Stage Manager back after the engine)
            CFPreferencesSetValue(CFSTR("stageManagerOnForEngine"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMSMNoteOwnStageUI();
            if (gSMOnNow == 1) DMLog(@"[smengine] Stage Manager is the window engine: switched on");
            else if (notStaying < 3) DMLog([NSString stringWithFormat:@"[smengine] Stage Manager is the window engine: switched on, but it reads back off (try %d)", notStaying]);
        }
        // the menu bar follows the front window: laid out again when another window of the stage comes to the front
        DMSMFitTick(NO);   // (Fit to Window: re-tiles only when the set of windows changed)
        static NSString *lastFront = nil;
        NSString *front = DMSMFrontWindowBundle();
        if (!(front == lastFront || [front isEqualToString:lastFront])) {
            lastFront = front;
            for (UIView *fg in gCopies.allObjects) if (fg.window && !fg.window.hidden) [fg setNeedsLayout];
            DMSMRefreshBars();
        }
        return;
    }
    {   // Stage Manager was on only because it was our engine: back off (whatever comes next), and never taken for the user's wish
        CFPropertyListRef mine = CFPreferencesCopyValue(CFSTR("stageManagerOnForEngine"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        if (mine) {
            CFRelease(mine);
            DMSMNoteOwnStageUI();   // (on only for the engine: its UI stays ours after the key goes -- SpringBoard's own switch may still be on its way)
            if (!notSince && !off) notSince = now;
            // (only where SpringBoard's own switch-off makes no transition that drops windows -- SMEngineAPI.h, DMSMEngineOffStep: with three windows in
            //  front it aborted SpringBoard, iPad 2 4 Oct 11:58 -- and the multi-window stages cut back first)
            int shows = DMSMSwitcherShowsApp();
            BOOL appInFront = shows >= 0 ? shows == 1 : DMFrontApp() != nil;
            NSUInteger frontWindows = appInFront ? DMSMStageItemsMap(DMSMFrontStage()).count : 0;
            int step = DMSMEngineOffStep(notSince ? now - notSince : -1, off, on, appInFront, frontWindows);
            static BOOL waitLogged = NO;
            if (step == DMSMOffWait) {
                if (on && appInFront && frontWindows > 1 && (off || now - notSince >= 10.0) && !waitLogged) {
                    waitLogged = YES;
                    DMLog([NSString stringWithFormat:@"[stagemgr] Stage Manager is not the engine any more: it goes off once no app is in front or the stage in front has one window (%lu windows in front now)", (unsigned long)frontWindows]);
                }
                return;
            }
            notSince = 0; waitLogged = NO;
            if (step == DMSMOffNow) {
                DMSMFlattenStages(@"Stage Manager goes back off after being the engine");
                ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, set, NO); on = NO;
                DM_FEATURE_MARK("sm-off-when-safe");
            }
            CFPreferencesSetValue(CFSTR("stageManagerOnForEngine"), NULL, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[stagemgr] Stage Manager is not the engine any more: %@ (it was on only for the engine; %@, %lu window(s) in front)", step == DMSMOffNow ? @"switched back off" : @"already off",
                   appInFront ? @"an app in front" : @"no app in front", (unsigned long)frontWindows]);
        }
    }
    BOOL engine = !off && DMWindowingEnabled() && DMActiveEngine() != DMEngineNone;
    CFPropertyListRef savedRef = CFPreferencesCopyValue(CFSTR("stageManagerUserOn"), MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    BOOL saved = savedRef != NULL; if (savedRef) CFRelease(savedRef);
    if (engine) {
        notSince = 0;
        if (!on) return;
        if (!saved) {
            CFPreferencesSetValue(CFSTR("stageManagerUserOn"), kCFBooleanTrue, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        }
        ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, set, NO);
        DMSMFlattenStages(@"Stage Manager switched off for our window engine");
        DMLog([NSString stringWithFormat:@"[stagemgr] Stage Manager was switched on while our window engine runs: switched off again (now %d); it comes back when windowing is off",
               ((BOOL (*)(id, SEL))objc_msgSend)(sd, get)]);
        return;
    }
    if (!saved) return;
    if (notSince == 0 && !off) { notSince = now; return; }
    if (now - notSince < 10.0 && !off) return;   // (not during start-up, before the engine is known)
    ((void (*)(id, SEL, BOOL))objc_msgSend)(sd, set, YES);
    CFPreferencesSetValue(CFSTR("stageManagerUserOn"), NULL, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
    DMLog(@"[stagemgr] no window engine of ours any more: Stage Manager is back on, as the user had it");
}
// Control Center's Stage Manager button, tapped on while our engine runs: the tap is not passed on (the wish is remembered, as above). Letting it
// through and switching Stage Manager off again at once left the button lit although Stage Manager was off (iPad 2 + TrollPad, 2026-09-25):
// the button draws the state its own tap set and does not follow the setting back. Tapping it off still works.
static BOOL DMStageManagerHeldNow(void) {
    if (DMTestFlag("/tmp/msb-nosmguard")) return NO;
    if (DMSMEngine()) return NO;
    if (!DMWindowingEnabled() || DMActiveEngine() == DMEngineNone) return NO;
    id sd = DMSwitcherDefaults();
    SEL get = NSSelectorFromString(@"chamoisWindowingEnabled");
    return [sd respondsToSelector:get] && !((BOOL (*)(id, SEL))objc_msgSend)(sd, get);
}
static void DMSyncWindowsForLibraryBody(void) {
    DM_PERF("stagemgr", DMStageManagerWatch());
    DM_PERF("dock", DMWatchDockChanges());   // (the Dock changed for good: windows follow its new height, every engine)
    DM_PERF("native", DMNativeTick());   // (native windows: their level follows the engine's windows; kept on screen after a turn)
    DM_PERF("smturn", DMSMWatchTurn());   // (Stage Manager engine: windows keep their layouts, and stay reachable, when the iPad turns)
    DM_PERF("switcher", DMWatchSwitcher());
    DM_PERF("lock", DMWatchLock());
    if (!DMTestFlag("/tmp/macstatusbar-nobsc")) DM_PERF("ccscale", DMApplyControlCenterScale());
    DM_PERF("orient", DMWatchOrientation());
    DM_PERF("menustale", DMCloseMenuIfOrientationStale());   // a menu left open across a real rotation must not keep showing the old turn -- see its own comment
    DM_PERF("audio", DMWatchAudioPlaying());
    DM_PERF("fittoggle", DMWatchFitToggle());
    DM_PERF("fitclosures", DMWatchFitClosures());
    DM_PERF("focuscatch", DMUpdateFocusCatchers());
    DM_PERF("sofa", DMWatchSofaScore());   // SofaScore only: quick relaunch into its phone/iPad layout when its window crosses 700 pt
    DM_PERF("kbpill", DMPlaceKeyboardPill());
    DM_PERF("kbturn", DMKeepKeyboardFocusOnWindowAfterTurn());
    DM_PERF("kbfollow", DMKeyboardFocusFollowsFrontWindow());
    DM_PERF("zetsu", DMWatchZetsu());
    DM_PERF("gamebar", DMWatchBarOverHidingApp());
    DM_PERF("fade", DMSyncWindowFade());
}
// The windows fade away while the App Library shows, and while a Home Screen icon's Haptic Touch menu is open (layering audit F8: that menu lives in
// the Home Screen's own window, level -2, under every window; raising that window would put the whole Home Screen over the windows, and lowering
// the windows below it would put them under the wallpaper, so they step out of the way the App Library's way instead and come back when it closes).
extern BOOL gZetsuHiddenForSwitcherFlag;
static BOOL gMilkyWayHiddenForSwitcher = NO;   // (DMZetsuSwitcherCheck: MilkyWay's layer is faded out for the App Switcher)
static void DMSMDeskSyncFade(void);   // (Stage Manager engine: its windows over the Home Screen, SMDesktop.h)
static BOOL DMSMDeskIsFaded(void);
static void DMSyncWindowFade(void) {
    if (DMSMEngine() || DMSMDeskIsFaded()) {   // (Stage Manager: its window cards, the same triggers; a fade still on when the engine stopped -- an engine
        DMSMDeskSyncFade();                     //  change while the App Library was up -- is given back, 1.3.5 logic test L1)
        if (DMSMEngine()) return;
    }
    BOOL zetsu = DMActiveEngine() == DMEngineZetsu;
    UIWindow *layer = DMWindowLayer();
    if (!layer && !zetsu) return;
    BOOL want = DMLibraryVisible() || gHomeMenuOpen;
    if (want == gWindowsHiddenForLibrary) return;
    // The App Switcher opened from the App Library dismisses the Library: bringing the windows back then faded them in OVER the switcher's cards
    // (Zetsu, iPad 2, 26 Sep; layering audit row 17 / F15). While the switcher shows they stay away; this runs again on the next tick once it is gone.
    if (!want && DMSwitcherVisible()) return;
    gWindowsHiddenForLibrary = want;
    static BOOL fadedForMenu = NO;   // (log only: a closing icon menu was reported as "App Library is gone")
    if (want) fadedForMenu = gHomeMenuOpen;
    DMLog([NSString stringWithFormat:@"[lights] %@ %@: windows %@", (want ? gHomeMenuOpen : fadedForMenu) ? @"Home Screen icon menu" : @"App Library", want ? @"is showing" : @"is gone", want ? @"fade away" : @"come back"]);
    NSArray *faders = zetsu ? DMZetsuAllWindows() : @[layer];   // Zetsu has no single layer: every one of its windows fades
    // (layering audit F15: the App Library going away because the App Switcher came up from it must not bring MilkyWay's / Zetsu's windows back
    // OVER the switcher -- they stayed there at full opacity on the M1, 26 Sep. The switcher check brings them back when the switcher is gone.)
    BOOL switcherHolds = !want && (zetsu ? gZetsuHiddenForSwitcherFlag : (DMActiveEngine() == DMEngineMilkyWay && gMilkyWayHiddenForSwitcher));
    if (switcherHolds) DMLog(@"[lights] ... but the App Switcher is showing: the windows stay faded until it is gone");
    CGFloat alpha = (want || switcherHolds) ? 0.0 : 1.0;
    [UIView animateWithDuration:want ? 0.16 : 0.22 delay:0 options:UIViewAnimationOptionCurveEaseInOut | UIViewAnimationOptionBeginFromCurrentState
                     animations:^{ for (UIView *f in faders) f.alpha = alpha; } completion:nil];
}
// "Bring All to Front" / "Send All to Back" (Window menu): one row, its title and action following which of the two is currently true.
static void DMToggleWindowsForward(void) {
    gWindowsPinnedForward = !gWindowsPinnedForward;
    DMApplyWindowLevel();
}

// Calls a completion block whose signature we don't know at compile time with "success" arguments (nil / YES / nothing).
// Returns NO, without calling it, when the block has an argument shape we don't recognise.
struct DMBlockLiteral { void *isa; int flags; int reserved; void *invoke; void **descriptor; };
static BOOL DMCallCompletion(id block) {
    if (!block) return YES;
    Class blockClass = NSClassFromString(@"NSBlock");
    if (!blockClass || ![block isKindOfClass:blockClass]) return NO;   // (not a block: never called as one)
    struct DMBlockLiteral *b = (__bridge struct DMBlockLiteral *)block;
    if (!(b->flags & (1 << 30))) return NO;   // no signature recorded
    const char *sig = (const char *)b->descriptor[(b->flags & (1 << 25)) ? 4 : 2];
    if (!sig) return NO;
    NSMethodSignature *ms = [NSMethodSignature signatureWithObjCTypes:sig];
    DMLog([NSString stringWithFormat:@"[workspace] completion block signature %s (%lu args)", sig, (unsigned long)ms.numberOfArguments - 1]);
    NSUInteger n = ms.numberOfArguments - 1;   // index 0 is the block itself
    if (n == 0) { ((void (^)(void))block)(); return YES; }
    if (n == 1) {
        const char *type = [ms getArgumentTypeAtIndex:1];
        if (type[0] == '@') { ((void (^)(id))block)(nil); return YES; }
        if (type[0] == 'B' || type[0] == 'c') { ((void (^)(BOOL))block)(YES); return YES; }
    }
    return NO;
}

// ---- the orange button: minimize a MilkyWay window like a native app ----------------------------------------------
// MilkyWay's own orange button only collapses the window to a small title bar that stays on screen. Now the window shrinks
// toward the Dock and is hidden, the app keeps running behind it (still "windowed"), and launching the app again from
// anywhere (Home Screen icon, Dock, Spotlight, a link) brings the same window back instead of opening it full screen.
static BOOL gForceFullScreenLaunch = NO;   // set while we deliberately open an app full screen, so the launch is not turned back into a window
static CGAffineTransform DMMinimizedTransform(UIView *window) {
    CGFloat s = MSBReduceMotion() ? kMSBRMScale : 0.94;   // (Reduce Motion: a fade with only a tiny scale)
    return CGAffineTransformMakeScale(s, s);   // a window fades away where it is (it used to shrink into the Dock, which looked like a launch)
}
static void DMMinimizeWindow(UIView *window) {
    if (DMWindowMinimized(window)) return;
    if (DMWaitForContextMenu([NSString stringWithFormat:@"minimize %p", window], ^{ DMMinimizeWindow(window); })) return;
    objc_setAssociatedObject(window, kMinimizedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    DMLog([NSString stringWithFormat:@"[lights] window of %@ minimized", [(AXWindowView *)window bundleIdentifier]]);
    CGAffineTransform away = DMMinimizedTransform(window);
    MSBAnimate(0.26, 0, 0, UIViewAnimationOptionCurveEaseIn, ^{
        window.transform = away;
        window.alpha = 0.0;
    }, ^(BOOL finished) {
        if (!DMWindowMinimized(window)) return;   // brought back while shrinking
        window.hidden = YES;
        window.transform = CGAffineTransformIdentity;
        window.alpha = 1.0;
        DMApplyWindowLevel();
    });
}
// The same for an Aerial stage. Aerial's own minimize turns the stage into a round app-icon chip that stays on screen; instead the stage
// shrinks toward the Dock and disappears, the app keeps running, and opening the app again brings the same stage back.
static void DMMinimizeStage(UIView *stage) {
    if ([objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) return;
    if (DMWaitForContextMenu([NSString stringWithFormat:@"minimize %p", stage], ^{ DMMinimizeStage(stage); })) return;
    objc_setAssociatedObject(stage, kStageHiddenKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    DMLog(@"[lights] Aerial stage minimized");
    CGAffineTransform away = DMMinimizedTransform(stage);
    MSBAnimate(0.2, 0, 0, UIViewAnimationOptionCurveEaseIn | UIViewAnimationOptionBeginFromCurrentState, ^{
        stage.transform = away;
        stage.alpha = 0.0;
    }, ^(BOOL finished) {
        if (![objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) return;   // brought back while shrinking
        stage.hidden = YES;
        stage.transform = CGAffineTransformIdentity;
        stage.alpha = 1.0;
        DMApplyWindowLevel();
    });
}
static void DMRestoreStage(UIView *stage) {
    if (![objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) return;
    objc_setAssociatedObject(stage, kStageHiddenKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    stage.transform = DMMinimizedTransform(stage);
    stage.alpha = 0.0;
    stage.hidden = NO;
    MSBAnimate(0.26, 0, 0.95, 0, ^{
        stage.transform = CGAffineTransformIdentity;
        stage.alpha = 1.0;
    }, nil);
}
// The app was launched from somewhere: if it has a MilkyWay window, show that (un-minimize it, bring it to the front, and over
// a full-screen app if needed) and report YES so the caller skips the full-screen launch.
static BOOL DMSurfaceWindowForApp(NSString *bundleID) {
    if (gForceFullScreenLaunch || !bundleID.length || DMActiveEngine() == DMEngineNone) return NO;
    if (DMActiveEngine() == DMEngineZetsu) {   // a Zetsu window: shown again if we minimized it, brought to the front (over a full-screen app if needed)
        UIWindow *zw = DMZetsuWindowFor(bundleID);
        if (!zw || [objc_getAssociatedObject(zw, kStageClosingKey) boolValue]) return NO;
        DMLog([NSString stringWithFormat:@"[zetsu] launch of %@ turned into showing its window (minimized %d)", bundleID, DMStageMinimized(zw)]);
        if (DMFrontApp()) gWindowsPinnedForward = YES;
        gFullScreenActivatedBundle = nil;   // (opening an app makes it the status bar's app, as on a Mac, even when its window was already on top)
        DMZetsuSurface(zw);
        DMDismissLibraryForWindow(bundleID);
        return YES;
    }
    if (DMActiveEngine() == DMEngineAerial) {   // an Aerial stage: un-minimize it and bring it to the front (over a full-screen app if needed)
        UIView *stage = DMStageForBundle(bundleID);
        if (!stage) return NO;
        BOOL minimized = DMStageMinimized(stage);
        DMLog([NSString stringWithFormat:@"[lights] launch of %@ turned into showing its Aerial stage (minimized %d)", bundleID, minimized]);
        if (DMFrontApp()) gWindowsPinnedForward = YES;
        gFullScreenActivatedBundle = nil;   // (opening an app makes it the status bar's app, as on a Mac, even when its window was already on top:
        // the full-screen app behind that had reclaimed the bar with a tap kept it, M1 portrait, 26 Sep)
        DMApplyWindowLevel();
        SEL front = DMAerialSel(@"_bringStageToFrontIfNeeded"), restore = DMAerialSel(@"restoreFromMinimize");
        DMEnforceStageFrame(stage, @"a relaunch");   // it comes back exactly where it was put
        if ([objc_getAssociatedObject(stage, kStageHiddenKey) boolValue]) DMRestoreStage(stage);
        else if (minimized && [stage respondsToSelector:restore]) ((void (*)(id, SEL))objc_msgSend)(stage, restore);   // Aerial's own chip
        if ([stage respondsToSelector:front]) ((void (*)(id, SEL))objc_msgSend)(stage, front);
        DMDismissLibraryForWindow(bundleID);
        return YES;
    }
    UIView *window = DMFindMilkyWayWindow(bundleID);
    if (!window) return NO;
    DMDismissLibraryForWindow(bundleID);
    DMLog([NSString stringWithFormat:@"[lights] launch of %@ turned into showing its window (minimized %d)", bundleID, DMWindowMinimized(window)]);
    if (DMFrontApp()) gWindowsPinnedForward = YES;
    gFullScreenActivatedBundle = nil;   // (opening an app makes it the status bar's app, see the Aerial branch above)
    DMApplyWindowLevel();
    [window.superview bringSubviewToFront:window];
    // Bug (reported): Spotify stopped opening as a window at all, even after force quitting it. Its MilkyWay window was still there with the app's scene
    // in it, but hidden without being minimized, so every launch came here, "showed" it, and nothing appeared: only a minimized window was ever
    // brought back. A window that is hidden or faded out for any other reason is now shown again too (and its state logged, to find out what
    // hid it).
    if (!DMWindowMinimized(window) && (window.hidden || window.alpha < 0.05)) {
        DMLog([NSString stringWithFormat:@"[lights] %@'s window was hidden (hidden %d, alpha %.2f, frame %@) without being minimized: showing it", bundleID, window.hidden, window.alpha, NSStringFromCGRect(window.frame)]);
        window.transform = CGAffineTransformIdentity;
        window.alpha = 1.0;
        window.hidden = NO;
    }
    if (DMWindowMinimized(window)) {
        objc_setAssociatedObject(window, kMinimizedKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        window.transform = DMMinimizedTransform(window);
        window.alpha = 0.0;
        window.hidden = NO;
        MSBAnimate(0.30, 0, 0.92, 0, ^{
            window.transform = CGAffineTransformIdentity;
            window.alpha = 1.0;
        }, nil);
    }
    return YES;
}

static BOOL DMWindowedLaunch(NSString *bundleID);
static BOOL DMHasHomeIcon(NSString *bundleID);
static BOOL DMWindowedLaunchEligible(NSString *bundleID);
// MilkyWay opens windows at about half the screen. Open them larger instead: 78% x 80% of the screen, centred (only
// when the window is still at its small default size, so a window the user has resized is never touched).
// Set by the Window menu when a full-screen app is turned into a window: the new window is opened at this frame instead of the
// default large one. CGRectNull when unused.
static CGRect gPendingWindowFrame = {{INFINITY, INFINITY}, {0, 0}};
static BOOL DMEnlargeNewWindow(UIView *window) {
    CGSize screen = [UIScreen mainScreen].bounds.size;
    BOOL pending = !CGRectIsNull(gPendingWindowFrame);
    // (MilkyWay's default place is x 0, y 100. Upside down it keeps its LANDSCAPE default size, 597 wide -- over 60% of the 834 pt portrait width,
    // so the size test alone took it for a big window and left it small and landscape-shaped: M1, MilkyWay4, orientation 2.)
    BOOL atDefault = fabs(window.frame.origin.x) < 1.0 && fabs(window.frame.origin.y - 100.0) < 1.0;
    if (!window || screen.width < 300.0 || (!pending && !atDefault && window.frame.size.width >= screen.width * 0.6)) return NO;
    if (pending && CGRectEqualToRect(window.frame, gPendingWindowFrame)) return NO;
    CGRect big = pending ? gPendingWindowFrame : CGRectMake(round(screen.width * 0.11), 36.0, round(screen.width * 0.78), round(screen.height * 0.80));
    DMLog([NSString stringWithFormat:@"[lights] window enlarged from %@ to %@", NSStringFromCGRect(window.frame), NSStringFromCGRect(big)]);
    window.frame = big;
    [window setNeedsLayout];
    [window layoutIfNeeded];
    return YES;
}

// The cover shrinks (a pure transform, no relayout) into the window's frame while the window fades in.
static void DMShrinkCoverInto(UIView *window) {
    UIView *cover = gCover;
    if (!cover) return;
    if (!window) { DMCoverFadeOut(0.0); return; }
    CGRect full = cover.bounds;
    CGRect target = [window.superview convertRect:window.frame toView:cover.superview];
    CGAffineTransform t = CGAffineTransformMake(target.size.width / full.size.width, 0, 0, target.size.height / full.size.height,
                                                CGRectGetMidX(target) - CGRectGetMidX(full), CGRectGetMidY(target) - CGRectGetMidY(full));
    CGFloat finalAlpha = window.alpha;
    window.alpha = 0.0;
    if (MSBReduceMotion()) {   // Reduce Motion: no zoom into the window's frame; the full-screen picture and the window cross-fade
        [UIView animateWithDuration:kMSBRMDuration delay:0 options:UIViewAnimationOptionCurveEaseInOut animations:^{ window.alpha = finalAlpha > 0.0 ? finalAlpha : 1.0; cover.alpha = 0.0; }
                         completion:^(BOOL done) { if (gCover == cover) DMCoverRemove(); }];
        return;
    }
    cover.clipsToBounds = YES;
    cover.layer.cornerCurve = kCACornerCurveContinuous;
    CGFloat scale = MAX(0.2, MIN(t.a, t.d));
    [UIView animateWithDuration:0.40 delay:0 usingSpringWithDamping:0.9 initialSpringVelocity:0 options:0 animations:^{
        cover.transform = t;
        cover.layer.cornerRadius = kMilkyWayCorner / scale;   // the transform shrinks the radius too
    } completion:nil];
    [UIView animateWithDuration:0.22 delay:0.18 options:UIViewAnimationOptionCurveEaseIn animations:^{ window.alpha = finalAlpha > 0.0 ? finalAlpha : 1.0; cover.alpha = 0.0; }
                     completion:^(BOOL done) { if (gCover == cover) DMCoverRemove(); }];
}

// window -> full screen: a snapshot of the window (clipped from a screen snapshot) grows to fill the screen while the
// window is closed and the app is launched underneath; when the app is up, the snapshot fades away.
static void DMExpandWindowToFullScreen(AXWindowView *window, NSString *bundleID, id sender) {
    if (DMWaitForContextMenu([NSString stringWithFormat:@"full screen %p", window], ^{ DMExpandWindowToFullScreen(window, bundleID, sender); })) return;
    UIWindow *host = DMStatusBarWindow();
    UIView *snap = host ? [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO] : nil;
    if (!snap || !bundleID.length) {   // no way to animate: just swap
        [window closeButtonAction:sender];
        if (bundleID.length) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMOpenFullScreen(bundleID); });
        return;
    }
    DMCoverRemove();
    CGRect full = host.bounds;
    CGRect wf = [window.superview convertRect:window.frame toView:host];
    UIView *container = [[UIView alloc] initWithFrame:wf];
    container.clipsToBounds = YES;
    container.layer.cornerRadius = kMilkyWayCorner;
    container.layer.cornerCurve = kCACornerCurveContinuous;
    container.userInteractionEnabled = NO;
    snap.layer.anchorPoint = CGPointZero;
    snap.frame = CGRectMake(-wf.origin.x, -wf.origin.y, full.size.width, full.size.height);
    [container addSubview:snap];
    [host addSubview:container];
    gCover = container;
    UIView *mine = container;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gCover == mine) DMCoverRemove(); });

    CFTimeInterval start = CACurrentMediaTime();
    CGFloat sx = full.size.width / wf.size.width, sy = full.size.height / wf.size.height;
    // (Reduce Motion: no growth; the window's picture stays where it is and cross-fades to the full-screen app once it is up, DMCoverFadeOut)
    if (!MSBReduceMotion()) [UIView animateWithDuration:0.36 delay:0 usingSpringWithDamping:0.92 initialSpringVelocity:0 options:0 animations:^{
        container.frame = full;
        container.layer.cornerRadius = 0.0;
        snap.transform = CGAffineTransformMake(sx, 0, 0, sy, wf.origin.x * (1.0 - sx), wf.origin.y * (1.0 - sy));
    } completion:nil];

    [window closeButtonAction:sender];   // the window goes away (its app keeps running) ...
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        DMOpenFullScreen(bundleID);      // ... and the app opens full screen under the growing snapshot
        DMWaitFor(^BOOL{ return [[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]; }, 40, ^(BOOL ok) {
            // The app's own launch zoom (with the Home Screen showing through) runs for a moment after it is "in front":
            // keep the snapshot opaque until that has settled, and until the growth is done, then fade it.
            CFTimeInterval growthLeft = 0.38 - (CACurrentMediaTime() - start);
            DMCoverFadeOut(ok ? MAX(0.36, growthLeft) : 0.0);
        });
    });
}

// green on a full-screen app
static void DMSendToWindow(NSString *bundleID);
// ---- the active app: whichever is frontmost, windowed or full screen ---------------------------------------------------
// SpringBoard's own "front app" only knows full-screen apps. When MilkyWay windows are in front of everything (over a full-screen
// app, or alone on the Home Screen) the topmost window's app is the one you are using, so the status bar shows that one.
static UIView *DMTopWindow(void) {   // the frontmost MilkyWay window that is on screen
    Class viewClass = objc_getClass("AXWindowView");
    UIView *top = nil;
    for (UIView *v in DMMilkyWayLayer().subviews)
        if (viewClass && [v isKindOfClass:viewClass] && !DMWindowMinimized(v) && !v.hidden) top = v;
    return top;
}
static SBApplication *DMAppForBundle(NSString *bundleID) {
    Class c = objc_getClass("SBApplicationController");
    SEL shared = NSSelectorFromString(@"sharedInstance");
    id controller = [c respondsToSelector:shared] ? ((id (*)(id, SEL))objc_msgSend)((id)c, shared) : nil;
    SEL lookup = NSSelectorFromString(@"applicationWithBundleIdentifier:");
    return bundleID.length && [controller respondsToSelector:lookup] ? ((id (*)(id, SEL, id))objc_msgSend)(controller, lookup, bundleID) : nil;
}
static UIView *DMTopStage(void);
static NSString *DMStageBundle(UIView *stage);
static BOOL DMWindowsInFront(void) {
    if (DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu) return DMTopStage() != nil && DMDesiredWindowLevel() > 10.0;   // above the apps unless they are behind a full-screen app
    return DMTopWindow() != nil && DMDesiredWindowLevel() > 10.0;
}
static NSString *gPendingFrontBundle = nil;   // a window that was turned into a full-screen app: it is the active app from the moment its window is gone, before SpringBoard reports it
static CFTimeInterval gPendingFrontUntil = 0;
// Windows are considered "in front" for status bar purposes (whose name and traffic lights show) unless the full-screen app behind them was the one
// last tapped — see gFullScreenActivatedBundle above.
static BOOL DMWindowsOwnStatusBar(void) {
    // (Stage Manager as the engine: its front window is a window -- with its own traffic lights, so the menu bar shows none -- unless it is in native
    //  full screen, where the menu bar's lights are its lights, as with every engine)
    if (DMSMEngine()) return DMSMFrontWindowBundle().length > 0 && !DMSMFrontIsFullScreen();   // (a TV window in front: the iPad has no front app of its own)
    if (!DMWindowsInFront()) return NO;
    if (gFullScreenActivatedBundle.length && [gFullScreenActivatedBundle isEqualToString:[DMFrontApp() bundleIdentifier]]) return NO;
    return YES;
}
// ---- Zetsu (a third, independent windowing engine the owner is trying alongside/instead of Aerial/MilkyWay; investigation only so far, see the dev
// notes) -- minimal first-pass integration: recognise a live ZetsuWindow as the active app for status-bar/menu purposes, the same way Aerial's
// and MilkyWay's own windows already are, WITHOUT touching how Zetsu opens/closes its own windows (it does that itself, already working via its
// own Haptic Touch menu item). Read-only: `_app_id` is a real, plain NSString ivar (confirmed via classearch on a live instance), read with KVC
// the same way this file already reads other tweaks' ivars elsewhere; no alloc/init of anything, no hooking Zetsu's own classes.
static NSArray<UIWindow *> *DMZetsuWindows(void) {
    NSMutableArray<UIWindow *> *out = [NSMutableArray array];
    Class c = objc_getClass("ZetsuWindow");
    if (!c) return out;
    for (UIWindow *w in DMAllWindows())
        if ([w isKindOfClass:c] && !w.hidden && w.alpha > 0.05) [out addObject:w];
    return out;
}
static NSString *DMZetsuWindowBundle(UIWindow *w) {
    // Read fresh every time (perf step 6 kept the first answer on the window, but Zetsu may clear _app_id when it closes a window and keep the
    // object; see DMZetsuAllWindows). Still cheap: the Ivar is looked up once per class and read directly, KVC only if there is no such ivar.
    if (!w) return nil;
    static Class ivClass = Nil; static Ivar iv = NULL;
    Class cls = object_getClass(w);
    if (cls != ivClass) {
        ivClass = cls;
        iv = class_getInstanceVariable(cls, "_app_id");
        const char *type = iv ? ivar_getTypeEncoding(iv) : NULL;
        if (!(type && type[0] == '@')) iv = NULL;
    }
    id bid = nil;
    if (iv) bid = object_getIvar(w, iv);
    else @try { bid = [w valueForKey:@"_app_id"]; } @catch (id e) {}
    return [bid isKindOfClass:[NSString class]] ? bid : nil;
}
// Every ZetsuWindow that still exists, INCLUDING hidden/minimized ones (DMZetsuWindows above only lists the ones on screen).
static NSArray<UIWindow *> *DMZetsuAllWindows(void) {
    NSMutableArray<UIWindow *> *out = [NSMutableArray array];
    Class c = objc_getClass("ZetsuWindow");
    if (!c) return out;
    for (UIWindow *w in DMAllWindows())
        if ([w isKindOfClass:c] && !(w.hidden && CGRectIsEmpty(w.bounds)) && DMZetsuWindowBundle(w).length) [out addObject:w];
    // (hidden with a 0 x 0 frame = closed: Zetsu sometimes keeps a closed window, _app_id and all, for a while; it counted as the app's
    // window, so the app's next icon tap did nothing -- iPad 2, Safari. A minimized window is hidden too, but keeps its frame.)
    return out;
}
// Zetsu is loaded into SpringBoard (our code only runs in SpringBoard, so its classes being here means it is loaded here) and is a tested build.
// (1.6.2 also added -getZetsuMenuWindow to SpringBoard; 1.6.4+ no longer does, so that is not checked any more.)
static BOOL DMZetsuInstalled(void) {
    return objc_getClass("ZetsuWindow") != Nil && objc_getClass("ZetsuAppController") != Nil && DMEngineBuildTested(@"Zetsu");
}
// Opens an app in a Zetsu window, through Zetsu's own entry point. Found in Zetsu.dylib's code: Zetsu hooks
// +[SBIconView activateShortcut:withBundleIdentifier:forIconView:] and, for a shortcut item of type "jp.dcsyhi.zetsu" (its Home Screen
// long-press item), posts an in-process NSNotification "ZetsuSwitcher" carrying the bundle ID; its observer builds the window. So this is
// the same call MilkyWay is driven with (DMLaunchAsWindow), just Zetsu's item type: works for any app, no icon on screen needed, and nothing
// of Zetsu's is alloc/init'ed here (Zetsu creates its own window).
// Apps Zetsu cannot host in a window on iPadOS 16: Reminders (a two-scene app) is started in the background by Zetsu, never shows up in the window, is
// killed by the 10 s background-launch watchdog, and both ways out -- leaving the hidden window, or closing it (our old 6 s rescue) -- crashed
// SpringBoard in -[FBSceneMonitor dealloc] (iPad 2, twice; the second time in the cross-test right after an engine switch). So they are never put
// in a Zetsu window: they open full screen, and a respring's window restore skips them.
static BOOL DMZetsuCannotHost(NSString *bundleID) {
    if (DMTestFlag("/tmp/msb-zetsu-allow-reminders")) return NO;   // (test: whether the Lock Screen fix, DMZetsuHoldBackWhileLocked, made it safe)
    return [bundleID isEqualToString:@"com.apple.reminders"];
}
static NSMutableDictionary<NSString *, NSNumber *> *gZetsuOpening;   // bundle ID -> when DMZetsuLaunch asked Zetsu for its window (until it appears)
static void DMZetsuLaunch(NSString *bundleID) {
    if (DMAppNeedsFullScreen(bundleID)) {
        DMLog([NSString stringWithFormat:@"[fullscreenonly] %@ cannot live in a window: opened full screen instead of a Zetsu window", bundleID]);
        dispatch_async(dispatch_get_main_queue(), ^{ DMOpenFullScreen(bundleID); });
        return;
    }
    if (DMZetsuCannotHost(bundleID)) {
        DMLog([NSString stringWithFormat:@"[zetsu] %@ cannot live in a Zetsu window (it crashed SpringBoard): opened full screen instead", bundleID]);
        dispatch_async(dispatch_get_main_queue(), ^{ DMOpenFullScreen(bundleID); });
        return;
    }
    // Zetsu's own "open this app in a window" is an in-process NSNotification "ZetsuSwitcher" whose object is the bundle ID: 1.6.2 posted it from its
    // Home Screen icon shortcut (activateShortcut hook), 1.6.6 from dragging an app out of its app bar (disassembly: [NSNotification
    // notificationWithName:@"ZetsuSwitcher" object:[app bundleIdentifier]] then -postNotification:, and its observers pass -object to
    // -getAppView:). 1.6.4+ has no Home Screen shortcut any more, so the notification is posted directly, the same way Zetsu posts it (works on both).
    // Nothing of Zetsu's is alloc/init'ed or called here: Zetsu's own observer builds the window. (Its "Stage" menu style takes a different path in that
    // observer; Stage is held off while Zetsu is our engine -- DMZetsuHoldPrefs.)
    if (!bundleID.length || !DMZetsuInstalled()) { DMLog(@"[zetsu] launch as window: Zetsu not available"); return; }
    {   // an app that needed the full-screen-first way this session, and is not running now: that way straight away (DMZetsuWarmStart)
        extern NSMutableSet<NSString *> *gZetsuWarmStartApps; extern void DMZetsuWarmStart(NSString *bundleID, NSString *why);
        if ([gZetsuWarmStartApps containsObject:bundleID] && ![DMLiveRunningBundleIDs() containsObject:bundleID] && !DMTestFlag("/tmp/msb-zetsu-nowarmstart")) {
            DMZetsuWarmStart(bundleID, @"it did not come up in a window from the background earlier");
            return;
        }
    }
    // One window at a time per app: a second request while the first window is still being built made Zetsu build TWO windows for the app, and
    // tearing one down crashed SpringBoard (iPad 2, 2026-09-25: Settings opened by hand 0.2 s before the respring's window restore opened it too ->
    // EXC_BAD_ACCESS in FBScene's client-settings KVO, Safe Mode). So a repeat within 4 s, while the app has no Zetsu window yet, is not passed on:
    // the window already on its way is the one (the restore waits for it and puts it at its saved place). The note goes as soon as the window
    // appears (DMZetsuAdopt), so a later relaunch (SofaScore's layout switch) is never held up by it.
    if (!gZetsuOpening) gZetsuOpening = [NSMutableDictionary dictionary];
    CFTimeInterval now = CACurrentMediaTime();
    NSNumber *prev = gZetsuOpening[bundleID];
    if (prev && now - prev.doubleValue < 4.0 && !DMZetsuWindowFor(bundleID) && !DMTestFlag("/tmp/msb-zetsu-nolaunchdedupe")) {
        DMLog([NSString stringWithFormat:@"[zetsu] %@ is already opening in a window (asked %.2f s ago): not asked again", bundleID, now - prev.doubleValue]);
        return;
    }
    gZetsuOpening[bundleID] = @(now);
    DMLog([NSString stringWithFormat:@"[zetsu] launch %@ as a Zetsu window", bundleID]);
    [[NSNotificationCenter defaultCenter] postNotification:[NSNotification notificationWithName:@"ZetsuSwitcher" object:bundleID]];
}
static NSString *DMZetsuDescribe(UIWindow *w) {
    id appCtl = nil; @try { appCtl = [w valueForKey:@"ZetsuApp"]; } @catch (id e) {}
    NSMutableString *s = [NSMutableString stringWithFormat:@"%@ %p frame %@ bounds %@ level %.3f hidden %d alpha %.2f key %d transform %@ superview %@",
        DMZetsuWindowBundle(w), w, NSStringFromCGRect(w.frame), NSStringFromCGRect(w.bounds), w.windowLevel, w.hidden, w.alpha, w.isKeyWindow,
        NSStringFromCGAffineTransform(w.transform), w.superview ? NSStringFromClass([w.superview class]) : @"-"];
    for (NSString *k in @[@"_isReduction", @"_appOrientation", @"_pid", @"_sceneId", @"moveRange", @"kWidth", @"kHeight"]) {
        @try { [s appendFormat:@" %@=%@", k, [w valueForKey:k]]; } @catch (id e) {}
    }
    if (appCtl) for (NSString *k in @[@"window_w", @"window_h", @"_isArea", @"_scalingMode", @"_isOrientation", @"first_showing", @"_front_bundleid"]) {
        @try { [s appendFormat:@" ctl.%@=%@", k, [appCtl valueForKey:k]]; } @catch (id e) {}
    }
    UIView *root = w.rootViewController.view;
    if (root) [s appendFormat:@" root %@ %@", NSStringFromClass([root class]), NSStringFromCGRect(root.frame)];
    UIView *stack = nil; @try { stack = [appCtl valueForKey:@"stack"]; } @catch (id e) {}
    if ([stack isKindOfClass:[UIView class]]) {
        [s appendFormat:@"\n    stack %@ autoresizing-constraints %d", NSStringFromCGRect(stack.frame), stack.translatesAutoresizingMaskIntoConstraints];
        NSMutableArray *all = [NSMutableArray arrayWithArray:stack.constraints];
        if (stack.superview) [all addObjectsFromArray:stack.superview.constraints];
        for (NSLayoutConstraint *c in all) if (c.firstItem == stack || c.secondItem == stack) [s appendFormat:@"\n    constraint %@", c];
    }
    return s;
}

// ==== Zetsu as a window engine (Settings > Window Engine > Zetsu) ====
// Everything here drives Zetsu from OUTSIDE: its windows are plain UIWindows (ZetsuWindow), one per app, each hosting the app's full-screen
// scene scaled into it (ZetsuHost's single subview carries a non-uniform scale transform: host size / full-screen size, measured live). Nothing
// of Zetsu's is alloc/init'ed, and no new hooks are put on Zetsu's classes (the only one is the existing, long-tolerated -didAddSubview: styling
// hook). What is used, and why it is safe:
//  - opening: Zetsu's own Home Screen shortcut type (DMZetsuLaunch);
//  - moving/resizing: the window's frame plus the content scale recomputed with Zetsu's own formula (Zetsu's -ZetsuResizeAction: must never
//    be driven from outside: a scripted pan crashed SpringBoard inside Zetsu's CardShrink);
//  - stacking: Zetsu orders its windows by windowLevel (its tap-to-front, -ZetsuTapView:, sets the tapped app to UIWindowLevelStatusBar+2 and
//    every other to +1, read in its code), so our order is kept as distinct levels in that same band, and a raise Zetsu does itself (a real tap
//    on a title bar) is picked up from the level it set;
//  - minimize: the window is faded and hidden exactly like an Aerial stage (DMMinimizeStage), not Zetsu's own title-bar pill (which only a real
//    tap on the pill can undo);
//  - close: Zetsu's own -CloseAppWindow: on the controller Zetsu created.
static CGRect DMLayoutFrame(NSString *name);
static CGRect DMLayoutFrameInArea(NSString *name, CGRect u, CGSize screen);
static void DMCascadeStage(UIView *stage);
static UIView *DMMakeStageLightsFor(UIView *stage);
static NSMutableDictionary<NSString *, NSValue *> *gLastWindowFrames;   // (defined with the Window menu)
static const void *kStageIntentKey;   // (defined below) where we last put the window
static const void *kStageIntentSizeKey;   // (defined below) the screen size that place is for
static void DMFitGroupForget(NSString *bundleID);
static const void *kStageClosingKey;   // (defined below)
static const CGFloat kZetsuFrontLevel = 1002.0;   // Zetsu's own front level (UIWindowLevelStatusBar + 2): never put its windows higher than Zetsu itself does
static const void *kZetsuLevelKey = &kZetsuLevelKey;     // the level we last gave the window
static const void *kZetsuAdoptedKey = &kZetsuAdoptedKey; // the window has been seen and set up (size, place, tiling) once
static const void *kZetsuAdoptTimeKey = &kZetsuAdoptTimeKey, *kZetsuSurfacedKey = &kZetsuSurfacedKey;
static const void *kZetsuLightsKey = &kZetsuLightsKey;   // our red/yellow/green in its title bar
static NSMutableArray<NSString *> *gZetsuOrder = nil;    // bundle ids, back to front
static BOOL DMIsZetsuWindow(id v) { Class c = objc_getClass("ZetsuWindow"); return c && [v isKindOfClass:c]; }
static id DMZetsuController(UIWindow *w) { id c = nil; @try { c = [w valueForKey:@"ZetsuApp"]; } @catch (id e) {} return c; }
static UIWindow *DMZetsuWindowFor(NSString *bundleID) {
    if (!bundleID.length) return nil;
    for (UIWindow *w in DMZetsuAllWindows()) if ([DMZetsuWindowBundle(w) isEqualToString:bundleID]) return w;
    return nil;
}
// Keeps gZetsuOrder in step with the windows that exist: gone ones leave, new ones go to the front, and a window Zetsu itself raised (a real tap
// on its title bar sets levels outside the ones we gave) goes to the front. No levels are SET here (it runs inside DMAerialStages, which the
// level computation itself uses).
static void DMZetsuSyncOrder(NSArray<UIWindow *> *all) {
    if (!gZetsuOrder) gZetsuOrder = [NSMutableArray array];
    NSMutableDictionary<NSString *, UIWindow *> *by = [NSMutableDictionary dictionary];
    for (UIWindow *w in all) { NSString *b = DMZetsuWindowBundle(w); if (b.length) by[b] = w; }
    for (NSString *b in [gZetsuOrder copy]) if (!by[b]) [gZetsuOrder removeObject:b];
    // Zetsu's own raise (a real tap on a title bar) leaves exactly ONE window strictly above all the others (+2 against +1). Zetsu also puts windows
    // at its front level in other moments (a window becoming visible), which is not a raise: then several share the top level, and our order stays.
    UIWindow *top = nil; CGFloat topLevel = -CGFLOAT_MAX; NSUInteger atTop = 0;
    for (NSString *b in by) {
        UIWindow *w = by[b];
        if (![gZetsuOrder containsObject:b]) { [gZetsuOrder addObject:b]; continue; }
        if (w.windowLevel > topLevel + 0.0001) { top = w; topLevel = w.windowLevel; atTop = 1; }
        else if (fabs(w.windowLevel - topLevel) <= 0.0001) atTop++;
    }
    NSNumber *topMine = top ? objc_getAssociatedObject(top, kZetsuLevelKey) : nil;
    UIWindow *raised = (top && atTop == 1 && by.count > 1 && topMine && fabs(top.windowLevel - topMine.doubleValue) > 0.0001) ? top : nil;
    if (raised) {
        NSString *b = DMZetsuWindowBundle(raised);
        if (![gZetsuOrder.lastObject isEqualToString:b]) { [gZetsuOrder removeObject:b]; [gZetsuOrder addObject:b]; DMLog([NSString stringWithFormat:@"[zetsu] %@ brought to the front by Zetsu (a tap on its title bar)", b]); }
        for (UIWindow *w in all) objc_setAssociatedObject(w, kZetsuLevelKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);   // Zetsu re-levelled them all: ours are stale
    }
}
static NSArray<UIWindow *> *DMZetsuOrdered(void) {
    NSArray<UIWindow *> *all = DMZetsuAllWindows();
    DMZetsuSyncOrder(all);
    return [all sortedArrayUsingComparator:^NSComparisonResult(UIWindow *a, UIWindow *b) {
        NSUInteger ia = [gZetsuOrder indexOfObject:DMZetsuWindowBundle(a)], ib = [gZetsuOrder indexOfObject:DMZetsuWindowBundle(b)];
        return ia < ib ? NSOrderedAscending : (ia > ib ? NSOrderedDescending : NSOrderedSame);
    }];
}
// The windows' levels: the front one at the level every other engine's windows get (DMDesiredWindowLevel: over the apps, under an open status bar
// menu or Dock menu, behind a full-screen app when "Windows Behind Full-Screen Apps" says so), capped at Zetsu's own front level, and each one
// further back 0.01 lower.
static void DMZetsuApplyLevels(void) {
    NSArray<UIWindow *> *ordered = DMZetsuOrdered();
    if (!ordered.count) return;
    CGFloat top = MIN(DMDesiredWindowLevel(), kZetsuFrontLevel);
    for (NSUInteger i = 0; i < ordered.count; i++) {
        UIWindow *w = ordered[i];
        CGFloat want = top - 0.01 * (CGFloat)(ordered.count - 1 - i);
        if (fabs(w.windowLevel - want) > 0.0001) w.windowLevel = want;
        objc_setAssociatedObject(w, kZetsuLevelKey, @(want), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
}
static void DMZetsuFixScale(UIWindow *w);
// Zetsu's own title-bar pill (its minimize) is undone only by a tap on the pill: -ZetsuTapView: is what Zetsu's own tap recognizer on the title
// bar (ZetsuMenu) calls, so it is called here with THAT real recognizer (its view is the real title bar: nothing is faked, unlike the scripted
// pan that crashed Zetsu's resize).
static void DMZetsuTap(UIWindow *w) {
    id ctl = DMZetsuController(w);
    UIView *menu = nil; @try { menu = [ctl valueForKey:@"menu"]; } @catch (id e) {}
    SEL tapSel = NSSelectorFromString(@"ZetsuTapView:");
    if (![menu isKindOfClass:[UIView class]] || ![ctl respondsToSelector:tapSel]) return;
    for (UIGestureRecognizer *g in menu.gestureRecognizers) {
        if (![NSStringFromClass([g class]) isEqualToString:@"UITapGestureRecognizer"]) continue;
        DMLog([NSString stringWithFormat:@"[zetsu] tapping %@'s title bar the way Zetsu's own recognizer does", DMZetsuWindowBundle(w)]);
        ((void (*)(id, SEL, id))objc_msgSend)(ctl, tapSel, g);
        return;
    }
}
static void DMZetsuRaise(UIWindow *w);
static void DMZetsuMove(UIWindow *w, CGRect target, BOOL animated, void (^done)(void));
static CFTimeInterval gZetsuReopenedAt;   // (defined with DMZetsuAfterUnlock)
static void DMZetsuSurface(UIWindow *w) {
    if (!w) return;
    BOOL reduced = NO; @try { reduced = [[w valueForKey:@"_isReduction"] boolValue]; } @catch (id e) {}
    if ([objc_getAssociatedObject(w, kStageHiddenKey) boolValue]) DMRestoreStage(w);
    else if (reduced) {
        DMZetsuTap(w);
        // (Zetsu opens a collapsed window at its own height -- 26 pt taller than where we had put it, seen on the iPad 2 with Safari -- which the
        // watcher then took for a hand resize and dropped the window from Fit's tiles. That change is Zetsu's: the window goes back to its place.)
        gZetsuReopenedAt = CACurrentMediaTime();
        __weak UIWindow *weakW = w;
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            UIWindow *w2 = weakW; NSValue *intent = w2 ? objc_getAssociatedObject(w2, kStageIntentKey) : nil;
            if (!intent || w2.hidden || DMStageMinimized(w2) || [objc_getAssociatedObject(w2, kStageClosingKey) boolValue]) return;
            CGRect want = intent.CGRectValue, f = w2.frame;
            if (fabs(want.size.width - f.size.width) > 2.0 || fabs(want.size.height - f.size.height) > 2.0) {
                DMLog([NSString stringWithFormat:@"[zetsu] %@: opened from Zetsu's collapsed state at %@: back to its place %@", DMZetsuWindowBundle(w2), NSStringFromCGRect(f), NSStringFromCGRect(want)]);
                gZetsuReopenedAt = CACurrentMediaTime();
                DMZetsuMove(w2, want, NO, nil);
            }
        });
    }
    if (!DMStageMinimized(w) && (w.hidden || w.alpha < 0.05) && !gWindowsHiddenForLibrary) { w.transform = CGAffineTransformIdentity; w.alpha = 1.0; w.hidden = NO; }
    DMZetsuRaise(w);
    DMApplyWindowLevel();
    DMZetsuFixScale(w);
}
static void DMZetsuRaise(UIWindow *w) {
    NSString *b = DMZetsuWindowBundle(w);
    if (!b.length) return;
    if (!gZetsuOrder) gZetsuOrder = [NSMutableArray array];
    [gZetsuOrder removeObject:b]; [gZetsuOrder addObject:b];
    DMZetsuApplyLevels();
}
// The app's picture fills the window's content area: Zetsu's own formula (host size / the scene's full-screen size, per axis), applied again after
// every size change we make (Zetsu itself only recomputes it inside its own resize gesture).
// Zetsu's window content (a UIStackView: title bar, app host, bottom bar) is sized by Zetsu to the window size it chose itself and does not
// follow the window's frame, so after we size the window the stack is given the same size: through its own width/height constraints when it
// has them (their constants, the same thing Zetsu sets), else its frame.
static void DMZetsuFitStack(UIWindow *w) {
    UIView *stack = nil; @try { stack = [DMZetsuController(w) valueForKey:@"stack"]; } @catch (id e) {}
    UIView *root = stack.superview;
    if (![stack isKindOfClass:[UIView class]] || !root) return;
    CGSize want = root.bounds.size;
    if (want.width < 60.0 || want.height < 60.0) return;
    if (fabs(stack.frame.size.width - want.width) < 0.5 && fabs(stack.frame.size.height - want.height) < 0.5 && fabs(stack.frame.origin.x) < 0.5 && fabs(stack.frame.origin.y) < 0.5) return;
    BOOL viaConstraints = NO;
    if (!stack.translatesAutoresizingMaskIntoConstraints) {
        NSMutableArray *all = [NSMutableArray arrayWithArray:stack.constraints];
        [all addObjectsFromArray:root.constraints];
        for (NSLayoutConstraint *c in all) {
            if (c.firstItem != stack || c.secondItem != nil) continue;   // a fixed size of the stack itself
            if (c.firstAttribute == NSLayoutAttributeWidth) { c.constant = want.width; viaConstraints = YES; }
            else if (c.firstAttribute == NSLayoutAttributeHeight) { c.constant = want.height; viaConstraints = YES; }
        }
    }
    if (viaConstraints) { [root setNeedsLayout]; [root layoutIfNeeded]; }
    if (!viaConstraints || fabs(stack.frame.size.width - want.width) > 0.5 || fabs(stack.frame.size.height - want.height) > 0.5) stack.frame = CGRectMake(0, 0, want.width, want.height);
    [stack layoutIfNeeded];
}
static NSMutableDictionary<NSString *, NSValue *> *gZetsuFlexFrames;
static id DMSceneForBundle(NSString *bundleID);
static BOOL DMSetSceneFrame(id scene, CGRect frame);
// iPad 2 fix (2026-09-24, "grey bars in Zetsu windows", mostly after a hand resize): the app's picture reaches Zetsu's content view through
// _UIContextLayerHostView views that UIKit makes the size of the PORTRAIT screen (768 x 1024) and that clip (masksToBounds). A flexed window lays the
// app out at the window's size (verified in the app: its UIWindow was 878.5 x 596), so in landscape any window wider than 768 pt had everything past
// 768 pt cut off, and Zetsu's grey host showed through on the right. The layer hosts now always have the content view's size (the app's own size
// when flexed, the full-screen picture's otherwise), so they clip exactly at the window's edge.
static UIUserInterfaceStyle DMSystemInterfaceStyle(void);   // (defined with the menus)
static void DMZetsuFitLayerHosts(UIView *content) {
    if (!content || DMTestFlag("/tmp/msb-zetsu-nohostfit")) return;
    CGRect want = content.bounds;
    Class hostClass = objc_getClass("_UIContextLayerHostView");
    NSMutableArray<UIView *> *q = [NSMutableArray arrayWithArray:content.subviews];
    for (int n = 0; q.count && n < 16; n++) {
        UIView *v = q.firstObject; [q removeObjectAtIndex:0];
        if (hostClass && [v isKindOfClass:hostClass]) {
            if (!CGAffineTransformIsIdentity(v.transform)) continue;   // (a turned or scaled host is not ours to size)
            if (fabs(v.bounds.size.width - want.size.width) > 0.5 || fabs(v.bounds.size.height - want.size.height) > 0.5 || fabs(v.frame.origin.x) > 0.5 || fabs(v.frame.origin.y) > 0.5) {
                CGRect before = v.frame;
                v.frame = CGRectMake(0, 0, want.size.width, want.size.height);
                static int told = 0; if (told++ < 20) DMLog([NSString stringWithFormat:@"[zflex] layer host %@ -> %@ (the window's content)", NSStringFromCGRect(before), NSStringFromCGRect(v.frame)]);
            }
        }
        [q addObjectsFromArray:v.subviews];
    }
}
static void DMZetsuFixScale(UIWindow *w) {
    if (DMStageMinimized(w)) return;
    DMZetsuFitStack(w);
    UIView *host = nil; @try { host = [DMZetsuController(w) valueForKey:@"hosts"]; } @catch (id e) {}
    UIView *content = [host isKindOfClass:[UIView class]] ? host.subviews.firstObject : nil;
    CGSize hs = host.bounds.size, cs = content.bounds.size;
    if (!content || hs.width < 20.0 || hs.height < 20.0 || cs.width < 20.0 || cs.height < 20.0) return;
    NSString *flexB = DMZetsuWindowBundle(w);
    if (flexB.length && !gZetsuFlexFrames[flexB] && !DMTestFlag("/tmp/msb-zetsu-noflex") && ![objc_getAssociatedObject(w, kStageClosingKey) boolValue]) {
        if (!gZetsuFlexFrames) gZetsuFlexFrames = [NSMutableDictionary dictionary];
        CGRect r0 = [host convertRect:host.bounds toCoordinateSpace:w.screen.coordinateSpace];
        gZetsuFlexFrames[flexB] = [NSValue valueWithCGRect:CGRectZero];   // (set for real just below, with the scene update)
        DMLog([NSString stringWithFormat:@"[zflex] %@: laid out at its window's size %@ instead of Zetsu's scaled full-screen picture", flexB, NSStringFromCGSize(r0.size)]);
    }
    if (flexB.length && gZetsuFlexFrames[flexB]) {   // flexed (see DMZetsuFlexSettings): the app is laid out at the content size, shown 1:1
        CGRect r = [host convertRect:host.bounds toCoordinateSpace:w.screen.coordinateSpace];
        if (!CGRectEqualToRect(gZetsuFlexFrames[flexB].CGRectValue, r)) { gZetsuFlexFrames[flexB] = [NSValue valueWithCGRect:r]; id sc = DMSceneForBundle(flexB); if (sc) DMSetSceneFrame(sc, r); }
        if (!CGAffineTransformIsIdentity(content.transform)) content.transform = CGAffineTransformIdentity;
        if (fabs(cs.width - hs.width) > 0.5 || fabs(cs.height - hs.height) > 0.5) content.bounds = CGRectMake(0, 0, hs.width, hs.height);
        CGPoint mid = CGPointMake(hs.width / 2.0, hs.height / 2.0);
        if (fabs(content.center.x - mid.x) > 0.5 || fabs(content.center.y - mid.y) > 0.5) content.center = mid;
        DMZetsuFitLayerHosts(content);
        {   // behind the app: the system background (black in Dark Mode) instead of Zetsu's light grey, so the edge a live resize uncovers before the app
            // catches up (a few pt, for a tenth of a second) blends in
            UIColor *bg = [[UIColor systemBackgroundColor] resolvedColorWithTraitCollection:[UITraitCollection traitCollectionWithUserInterfaceStyle:DMSystemInterfaceStyle()]];
            if (!DMTestFlag("/tmp/msb-zetsu-nohostfit") && ![host.backgroundColor isEqual:bg]) host.backgroundColor = bg;
        }
        return;
    }
    DMZetsuFitLayerHosts(content);
    CGAffineTransform want = CGAffineTransformMakeScale(hs.width / cs.width, hs.height / cs.height);
    CGAffineTransform now = content.transform;
    CGPoint mid = CGPointMake(hs.width / 2.0, hs.height / 2.0);
    if (fabs(now.a - want.a) < 0.0005 && fabs(now.d - want.d) < 0.0005 && fabs(now.b) < 0.0005 && fabs(now.c) < 0.0005 &&
        fabs(content.center.x - mid.x) < 0.5 && fabs(content.center.y - mid.y) < 0.5) return;
    content.transform = want;
    content.center = mid;
}
static void DMZetsuMove(UIWindow *w, CGRect target, BOOL animated, void (^done)(void)) {
    if (!w || CGRectIsNull(target) || CGRectIsEmpty(target)) { if (done) done(); return; }
    extern BOOL gMoveKeepsOrderFlag(void);
    if (!gMoveKeepsOrderFlag()) DMZetsuRaise(w);
    void (^apply)(void) = ^{ w.frame = target; [w layoutIfNeeded]; DMZetsuFixScale(w); };
    void (^finish)(BOOL) = ^(BOOL f) { DMZetsuFixScale(w); DMRememberStageFrame(w); DMSaveWindowState(); if (done) done(); };
    if (!animated) { [UIView performWithoutAnimation:apply]; finish(YES); return; }
    MSBAnimate(0.36, 0, 1.0, UIViewAnimationOptionBeginFromCurrentState | UIViewAnimationOptionAllowUserInteraction, apply, finish);   // (Reduce Motion: a short ease-in-out move)
}
// Closes the Zetsu window (the app keeps running), through Zetsu's own close on the controller it created. Marked as closing first, so the
// scene-foreground veto (DMKeepWindowedApp) lets the app go to the background as Zetsu tears the window down.
static void DMZetsuClose(UIWindow *w) {
    if (!w) return;
    if (DMWaitForContextMenu([NSString stringWithFormat:@"close %p", w], ^{ DMZetsuClose(w); })) return;
    objc_setAssociatedObject(w, kStageClosingKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC); { extern BOOL gFitClosureCheckDue; gFitClosureCheckDue = YES; }
    { NSString *fb = DMZetsuWindowBundle(w); if (fb.length) [gZetsuFlexFrames removeObjectForKey:fb]; }   // the app gets full-screen frames again
    id ctl = DMZetsuController(w);
    SEL closeSel = NSSelectorFromString(@"CloseAppWindow:");
    DMLog([NSString stringWithFormat:@"[zetsu] closing the window of %@", DMZetsuWindowBundle(w)]);
    if ([ctl respondsToSelector:closeSel]) ((void (*)(id, SEL, BOOL))objc_msgSend)(ctl, closeSel, NO);
}
// Window -> full screen (the green light): a snapshot of the window grows to fill the screen while the window closes and the app opens full
// screen underneath (the same transition as MilkyWay's, DMExpandWindowToFullScreen). Zetsu's scene is already full-screen size, so the app
// needs no re-layout.
static void DMZetsuToFullScreen(UIWindow *w) {
    NSString *bundleID = DMZetsuWindowBundle(w);
    if (!w || !bundleID.length) return;
    if (DMWaitForContextMenu([NSString stringWithFormat:@"full screen %p", w], ^{ DMZetsuToFullScreen(w); })) return;
    DMLog([NSString stringWithFormat:@"[zetsu] %@ to full screen", bundleID]);
    UIWindow *host = DMStatusBarWindow();
    UIView *snap = host ? [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO] : nil;
    gPendingFrontBundle = [bundleID copy]; gPendingFrontUntil = CACurrentMediaTime() + 3.0;
    if (!snap) { DMZetsuClose(w); dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.2 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMOpenFullScreen(bundleID); }); return; }
    DMCoverRemove();
    CGRect full = host.bounds;
    CGRect wf = w.frame;
    UIView *container = [[UIView alloc] initWithFrame:wf];
    container.clipsToBounds = YES;
    container.layer.cornerRadius = kMilkyWayCorner;
    container.layer.cornerCurve = kCACornerCurveContinuous;
    container.userInteractionEnabled = NO;
    snap.layer.anchorPoint = CGPointZero;
    snap.frame = CGRectMake(-wf.origin.x, -wf.origin.y, full.size.width, full.size.height);
    [container addSubview:snap];
    [host addSubview:container];
    gCover = container;
    UIView *mine = container;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(3.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gCover == mine) DMCoverRemove(); });
    CFTimeInterval start = CACurrentMediaTime();
    CGFloat sx = full.size.width / wf.size.width, sy = full.size.height / wf.size.height;
    if (!MSBReduceMotion()) [UIView animateWithDuration:0.36 delay:0 usingSpringWithDamping:0.92 initialSpringVelocity:0 options:0 animations:^{   // (Reduce Motion: no growth, a cross-fade once the app is up)
        container.frame = full;
        container.layer.cornerRadius = 0.0;
        snap.transform = CGAffineTransformMake(sx, 0, 0, sy, wf.origin.x * (1.0 - sx), wf.origin.y * (1.0 - sy));
    } completion:nil];
    DMZetsuClose(w);
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.12 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        DMOpenFullScreen(bundleID);
        DMWaitFor(^BOOL{ return [[DMFrontApp() bundleIdentifier] isEqualToString:bundleID]; }, 40, ^(BOOL ok) {
            CFTimeInterval growthLeft = 0.38 - (CACurrentMediaTime() - start);
            DMLog([NSString stringWithFormat:@"[zetsu] %@ %@ full screen", bundleID, ok ? @"is" : @"did NOT come up"]);
            DMCoverFadeOut(ok ? MAX(0.36, growthLeft) : 0.0);
        });
    });
}
// Our red / yellow / green in the window's title bar (Zetsu's ZetsuMenu, top left), the same DMStageLights Aerial windows get; Zetsu's own
// close / minimize / kill buttons in its bottom bar are hidden (they did the same three things, differently); its rotate button stays.
// ---- Zetsu in the Aerial 3.0 look ------------------------------------------------------------------------------------------------------------
// Zetsu's title bar carries the app's name and icon, and a 25 pt bar under the app holds its resize handle (and a rotate button). Like on Aerial
// 3.0: no name or icon in the title bar, no bottom bar -- the app goes down to the window's bottom edge -- and the two bottom corners resize the
// window with our grips (Zetsu's own resize, -ZetsuResizeAction:, must never be driven from outside: it crashed SpringBoard; ours resizes the
// window frame the way DMZetsuMove does, and the app is laid out at the new size, see DMZetsuFlexSettings). Debug: /tmp/msb-zetsu-nomacshape.
static const void *kStageGestureKey;
static UIView *DMMakeResizeGrip(void);
static UIColor *DMResizeGripColor(BOOL dark);
static UIColor *DMResizeGripColorFor(NSString *bundleID, BOOL dark);
@interface DMZetsuGripBox : UIView
@property (nonatomic, weak) UIWindow *zwindow;
@property (nonatomic) BOOL left;
@property (nonatomic) CGRect startFrame;
@property (nonatomic) CGPoint startPoint;
@end
static void DMZetsuFitStack(UIWindow *w);
static void DMZetsuFixScale(UIWindow *w);
static void DMRememberStageFrame(UIView *stage);
static void DMSaveWindowState(void);
// Where the finger went down, in screen space. A pan is only recognized after the finger has moved ~10-15 pt, and UIKit counts the drag from
// there: a Zetsu window's corner (grip) or title bar trailed the finger by that much for the whole drag (M1, iPadOS 15, 26 Sep: a (-50, -70)
// grip drag resized by (-42, -58.5), a (+80, +100) one by (+70.5, +88.5); the translation at recognition is already 0). So the touch-down
// point is noted where the touch begins (the grip box itself; the title bar's DMZetsuTopClamp) and the drag is measured from it, together
// with the window's frame at that moment (Zetsu's own title drag already moves the window a little before ours is recognized: measured from
// the touch-down with the later frame, a (+40, +60) title drag moved it by (+47.5, +71.5)). A point that is old or far away (another touch)
// is not used: the drag is then measured from the recognition point and frame, as before.
static const void *kZetsuTouchDownKey = &kZetsuTouchDownKey;
static const void *kZetsuTouchNowKey = &kZetsuTouchNowKey;
static void DMZetsuNoteTouchDown(UIWindow *w, NSSet<UITouch *> *touches) {
    if (w) objc_setAssociatedObject(w, kZetsuTouchNowKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    UITouch *t = touches.anyObject;
    if (!w || !t || touches.count != 1) { if (w) objc_setAssociatedObject(w, kZetsuTouchDownKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC); return; }
    CGPoint p = [w convertPoint:[t locationInView:w] toCoordinateSpace:w.screen.coordinateSpace];
    objc_setAssociatedObject(w, kZetsuTouchDownKey, @[[NSValue valueWithCGPoint:p], @(CACurrentMediaTime()), [NSValue valueWithCGRect:w.frame]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
// Where the finger is now, in screen space. A pan only reports a move when the finger's point IN THE WINDOW changed; while the window follows the
// finger 1:1, two equal steps in a row look like no move at all, so the pan skipped the last step(s) and the window stopped one step short (iPad 2,
// iOS 16, 26 Sep: title-bar drags of (+40, +60) ended at (+39, +58.5), a left-grip drag of +60 at +58.5; 1.5 pt, every time the last steps were
// equal). The touch itself still gets every move: a watcher recognizer (DMZetsuTouchWatch) notes its screen point, and the pans use that.
static void DMZetsuNoteTouchNow(UIWindow *w, NSSet<UITouch *> *touches) {
    UITouch *t = touches.anyObject;
    if (!w || !t || touches.count != 1) return;
    CGPoint p = [w convertPoint:[t locationInView:w] toCoordinateSpace:w.screen.coordinateSpace];
    objc_setAssociatedObject(w, kZetsuTouchNowKey, @[[NSValue valueWithCGPoint:p], @(CACurrentMediaTime())], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
}
@interface DMZetsuTouchWatch : UIGestureRecognizer <UIGestureRecognizerDelegate>
@end
@implementation DMZetsuTouchWatch   // (only looks: never recognizes, cancels or delays anything; it keeps getting the touch while a pan runs)
- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { DMZetsuNoteTouchNow(self.view.window, touches); }
- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { DMZetsuNoteTouchNow(self.view.window, touches); self.state = UIGestureRecognizerStateFailed; }
- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { self.state = UIGestureRecognizerStateFailed; }
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b { return YES; }
@end
static CGPoint DMZetsuPanPointOnScreen(UIPanGestureRecognizer *g, UIWindow *w) {
    CGPoint p = [w convertPoint:[g locationInView:w] toCoordinateSpace:w.screen.coordinateSpace];
    NSArray *n = objc_getAssociatedObject(w, kZetsuTouchNowKey);
    if (n.count != 2 || CACurrentMediaTime() - [n[1] doubleValue] > 0.5) return p;
    CGPoint q = [n[0] CGPointValue];
    return hypot(q.x - p.x, q.y - p.y) < 30.0 ? q : p;   // (only a step or two apart; anything else is another touch)
}
static CGPoint DMPanDownPointOnScreen(UIPanGestureRecognizer *g, UIWindow *w, CGRect *frame) {   // (*frame: in, the frame now; out, the frame at that point)
    CGPoint now = [w convertPoint:[g locationInView:w] toCoordinateSpace:w.screen.coordinateSpace];
    NSArray *d = objc_getAssociatedObject(w, kZetsuTouchDownKey);
    objc_setAssociatedObject(w, kZetsuTouchDownKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    if (d.count != 3 || CACurrentMediaTime() - [d[1] doubleValue] > 1.5) return now;
    CGPoint down = [d[0] CGPointValue]; CGRect f = [d[2] CGRectValue];
    if (hypot(now.x - down.x, now.y - down.y) >= 60.0 || f.size.width < 50.0 || f.size.height < 50.0) return now;
    if (frame) *frame = f;
    return down;
}
@implementation DMZetsuGripBox
- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { DMZetsuNoteTouchDown(self.window, touches); [super touchesBegan:touches withEvent:event]; }
- (void)pan:(UIPanGestureRecognizer *)g {
    UIWindow *w = self.zwindow;
    if (!w) return;
    CGPoint p = DMZetsuPanPointOnScreen(g, w);
    if (g.state == UIGestureRecognizerStateBegan) {
        CGRect f0 = w.frame; CGPoint p0 = DMPanDownPointOnScreen(g, w, &f0);
        self.startFrame = f0; self.startPoint = p0;
        objc_setAssociatedObject(w, kStageGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMZetsuRaise(w);   // (iPad 2, 2026-09-24: a window resized by its grip stayed behind its neighbours; like macOS, it comes to the front)
        return;
    }
    CGRect s0 = self.startFrame; CGFloat dx = p.x - self.startPoint.x, dy = p.y - self.startPoint.y;
    CGSize sc = w.screen.bounds.size;
    CGFloat minW = 320.0, minH = 260.0;
    CGFloat h = MIN(MAX(minH, s0.size.height + dy), sc.height - s0.origin.y);
    CGRect f;
    if (self.left) { CGFloat nw = MIN(MAX(minW, s0.size.width - dx), CGRectGetMaxX(s0)); f = CGRectMake(CGRectGetMaxX(s0) - nw, s0.origin.y, nw, h); }
    else { CGFloat nw = MIN(MAX(minW, s0.size.width + dx), sc.width - s0.origin.x); f = CGRectMake(s0.origin.x, s0.origin.y, nw, h); }
    [UIView performWithoutAnimation:^{ w.frame = f; [w layoutIfNeeded]; DMZetsuFitStack(w); }];
    {   // (iPad 2, 2026-09-24) the app follows the drag every 0.1 s (the 0.2 s watcher alone left a strip of Zetsu's grey at the moving edge)
        static CFTimeInterval lastFit = 0; CFTimeInterval t = CACurrentMediaTime();
        if (g.state == UIGestureRecognizerStateChanged && t - lastFit >= 0.1) { lastFit = t; DMZetsuFixScale(w); }
    }
    if (g.state == UIGestureRecognizerStateEnded || g.state == UIGestureRecognizerStateCancelled || g.state == UIGestureRecognizerStateFailed) {
        objc_setAssociatedObject(w, kStageGestureKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMZetsuFixScale(w);
        DMRememberStageFrame(w);
        DMFitGroupForget(DMZetsuWindowBundle(w));   // resized by hand: no longer tiled
        DMSaveWindowState();
        DMLog([NSString stringWithFormat:@"[zetsu] %@ resized by hand to %@", DMZetsuWindowBundle(w), NSStringFromCGRect(w.frame)]);
    }
}
@end
// The title bar moves the window with the finger, 1:1 (measured with a real injected drag: Zetsu's own title-bar drag moved the window only ~71% of
// the finger's way -- 28.5 x 86 pt for a 40 x 120 pt drag -- so the window slid away from under the finger). Our pan cancels Zetsu's own touch
// handling once it recognises (cancelsTouchesInView) and places the window from where it started plus the finger's travel on the screen.
@interface DMZetsuBarPan : NSObject
+ (instancetype)shared;
@end
static void DMZetsuRaise(UIWindow *w);
static const void *kZetsuBarPanKey = &kZetsuBarPanKey, *kZetsuBarStartKey = &kZetsuBarStartKey;
@implementation DMZetsuBarPan
+ (instancetype)shared { static DMZetsuBarPan *p; static dispatch_once_t once; dispatch_once(&once, ^{ p = [DMZetsuBarPan new]; }); return p; }
- (void)pan:(UIPanGestureRecognizer *)g {
    UIWindow *w = g.view.window;
    if (!w) return;
    CGPoint p = DMZetsuPanPointOnScreen(g, w);
    if (g.state == UIGestureRecognizerStateBegan) {
        CGRect f0 = w.frame; CGPoint p0 = DMPanDownPointOnScreen(g, w, &f0);
        objc_setAssociatedObject(w, kZetsuBarStartKey, @[[NSValue valueWithCGRect:f0], [NSValue valueWithCGPoint:p0]], OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(w, kStageGestureKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMZetsuRaise(w);
        return;
    }
    NSArray *start = objc_getAssociatedObject(w, kZetsuBarStartKey);
    if (start.count != 2) return;
    CGRect f0 = [start[0] CGRectValue]; CGPoint p0 = [start[1] CGPointValue];
    CGRect f = CGRectOffset(f0, p.x - p0.x, p.y - p0.y);
    f.origin.y = MAX(DMTopLimit(), f.origin.y);   // the title bar never goes above the screen's top edge, nor under the status bar while it shows (23 pt; 0 while it hides itself)
    [UIView performWithoutAnimation:^{ w.frame = f; }];
    if (g.state == UIGestureRecognizerStateEnded || g.state == UIGestureRecognizerStateCancelled || g.state == UIGestureRecognizerStateFailed) {
        objc_setAssociatedObject(w, kStageGestureKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        objc_setAssociatedObject(w, kZetsuBarStartKey, nil, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        DMZetsuFixScale(w);
        DMRememberStageFrame(w);
        DMFitGroupForget(DMZetsuWindowBundle(w));   // moved by hand: no longer tiled
        DMSaveWindowState();
        DMLog([NSString stringWithFormat:@"[zetsu] %@ moved by its title bar to %@", DMZetsuWindowBundle(w), NSStringFromCGRect(w.frame)]);
    }
}
@end
// Zetsu can also move a window by its own touch handling on the title bar (a drag that begins before our pan recognises -- seen right after a
// respring: the window went 9 pt above the top edge, its lights half off-screen, or up over the status bar). This watcher only looks: when a touch on
// the title bar ends with the window above the allowed top (23 pt under the status bar; 0 while the bar hides itself), the window is put back there.
@interface DMZetsuTopClamp : UIGestureRecognizer <UIGestureRecognizerDelegate>
@end
@implementation DMZetsuTopClamp
- (void)touchesBegan:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { DMZetsuNoteTouchDown(self.view.window, touches); }
- (void)touchesMoved:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { DMZetsuNoteTouchNow(self.view.window, touches); }
- (void)touchesEnded:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { DMZetsuNoteTouchNow(self.view.window, touches); [self clamp]; self.state = UIGestureRecognizerStateFailed; }
- (void)touchesCancelled:(NSSet<UITouch *> *)touches withEvent:(UIEvent *)event { [self clamp]; self.state = UIGestureRecognizerStateFailed; }
- (void)clamp {
    UIWindow *w = self.view.window;
    dispatch_async(dispatch_get_main_queue(), ^{   // (after Zetsu's own touch handling has placed it)
        if (!w || w.hidden || [objc_getAssociatedObject(w, kStageGestureKey) boolValue]) return;
        CGFloat top = DMTopLimit();
        if (w.frame.origin.y >= top - 0.5) return;
        CGRect f = w.frame; CGFloat was = f.origin.y; f.origin.y = top;
        DMZetsuMove(w, f, YES, nil);
        DMLog([NSString stringWithFormat:@"[zetsu] %@ was dragged above the top (y %.1f): back to %.0f", DMZetsuWindowBundle(w), was, top]);
    });
}
- (BOOL)gestureRecognizer:(UIGestureRecognizer *)a shouldRecognizeSimultaneouslyWithGestureRecognizer:(UIGestureRecognizer *)b { return YES; }
@end
static const void *kZetsuTopClampKey = &kZetsuTopClampKey;
static const void *kZetsuGripLKey = &kZetsuGripLKey, *kZetsuGripRKey = &kZetsuGripRKey;
static void DMZetsuMacShape(UIWindow *w, UIView *menu, UIView *toolbar) {
    if (DMTestFlag("/tmp/msb-zetsu-nomacshape")) return;
    for (UIView *v in menu.subviews) {   // the app's name and icon: not on a Mac title bar; nor Zetsu's frosted layer (it lightened our bar colour: 110 vs 3.0's 48)
        if ([v isKindOfClass:[UILabel class]] || [v isKindOfClass:[UIVisualEffectView class]] || ([v isMemberOfClass:[UIImageView class]] && v.bounds.size.width < 30.0)) { if (!v.hidden) v.hidden = YES; }
    }
    for (NSLayoutConstraint *c in menu.constraints)   // 24 pt, like Aerial 3.0's title bar (Zetsu's is 25)
        if (c.firstItem == menu && c.secondItem == nil && c.firstAttribute == NSLayoutAttributeHeight && fabs(c.constant - 25.0) < 0.5) c.constant = 24.0;
    if ([toolbar isKindOfClass:[UIView class]] && !toolbar.hidden) toolbar.hidden = YES;   // (an arranged view of Zetsu's stack: the app takes its room)
    if (!objc_getAssociatedObject(menu, kZetsuBarPanKey)) {
        UIPanGestureRecognizer *pan = [[UIPanGestureRecognizer alloc] initWithTarget:[DMZetsuBarPan shared] action:@selector(pan:)];
        pan.maximumNumberOfTouches = 1;
        pan.cancelsTouchesInView = YES;
        [menu addGestureRecognizer:pan];
        objc_setAssociatedObject(menu, kZetsuBarPanKey, pan, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (!objc_getAssociatedObject(menu, kZetsuTopClampKey)) {
        DMZetsuTopClamp *c = [[DMZetsuTopClamp alloc] initWithTarget:nil action:nil];
        c.cancelsTouchesInView = NO; c.delaysTouchesBegan = NO; c.delaysTouchesEnded = NO; c.delegate = c;
        [menu addGestureRecognizer:c];
        objc_setAssociatedObject(menu, kZetsuTopClampKey, c, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    UIView *root = menu.superview.superview;   // window > root > stack > menu
    if (!root) return;
    BOOL dark = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark;
    for (int side = 0; side < 2; side++) {
        const void *key = side == 0 ? kZetsuGripLKey : kZetsuGripRKey;
        DMZetsuGripBox *box = objc_getAssociatedObject(w, key);
        if (!box) {
            box = [[DMZetsuGripBox alloc] initWithFrame:CGRectMake(0, 0, 32.0, 32.0)];
            box.zwindow = w; box.left = side == 0; box.accessibilityIdentifier = @"MSBGrip";
            box.autoresizingMask = UIViewAutoresizingFlexibleTopMargin | (side == 0 ? UIViewAutoresizingFlexibleRightMargin : UIViewAutoresizingFlexibleLeftMargin);
            UIView *g = DMMakeResizeGrip(); g.userInteractionEnabled = NO;
            g.center = CGPointMake(side == 0 ? kMilkyWayCorner : 32.0 - kMilkyWayCorner, 32.0 - kMilkyWayCorner);
            g.transform = CGAffineTransformMakeRotation(side == 0 ? -M_PI_4 : M_PI_4);
            [box addSubview:g];
            [box addGestureRecognizer:[[UIPanGestureRecognizer alloc] initWithTarget:box action:@selector(pan:)]];
            DMZetsuTouchWatch *tw = [[DMZetsuTouchWatch alloc] initWithTarget:nil action:nil];
            tw.cancelsTouchesInView = NO; tw.delaysTouchesBegan = NO; tw.delaysTouchesEnded = NO; tw.delegate = tw;
            [box addGestureRecognizer:tw];
            {   // (the box is clear apart from the grip mark, and the render server hands a touch to the layer that has content there: over the app's
                // corner a drag went to the app -- it scrolled the app instead of resizing, iPad 2, 26 Sep; the whole box now takes its touches)
                SEL opaque = NSSelectorFromString(@"setHitTestsAsOpaque:");
                if ([box.layer respondsToSelector:opaque]) ((void (*)(id, SEL, BOOL))objc_msgSend)(box.layer, opaque, YES);
            }
            objc_setAssociatedObject(w, key, box, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
        }
        if (box.superview != root) [root addSubview:box];
        if (root.subviews.lastObject != box && root.subviews.lastObject != objc_getAssociatedObject(w, side == 0 ? kZetsuGripRKey : kZetsuGripLKey)) [root bringSubviewToFront:box];
        CGSize rs = root.bounds.size;
        CGRect bf = CGRectMake(side == 0 ? 0 : rs.width - 32.0, rs.height - 32.0, 32.0, 32.0);
        if (fabs(box.frame.origin.x - bf.origin.x) > 0.25 || fabs(box.frame.origin.y - bf.origin.y) > 0.25) box.frame = bf;
        UIView *g = box.subviews.firstObject; UIColor *gc = DMResizeGripColorFor(DMZetsuWindowBundle(w), dark);
        if (![g.backgroundColor isEqual:gc]) g.backgroundColor = gc;
    }
}
static void DMZetsuInstallLights(UIWindow *w) {
    id ctl = DMZetsuController(w);
    UIView *menu = nil, *toolbar = nil;
    @try { menu = [ctl valueForKey:@"menu"]; toolbar = [ctl valueForKey:@"toolbar"]; } @catch (id e) {}
    if (![menu isKindOfClass:[UIView class]]) return;
    UIView *lights = objc_getAssociatedObject(w, kZetsuLightsKey);
    if (!lights) {
        lights = DMMakeStageLightsFor(w);
        if (!lights) return;
        objc_setAssociatedObject(w, kZetsuLightsKey, lights, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    }
    if (lights.superview != menu) [menu addSubview:lights];
    lights.frame = CGRectMake(4.0, round((menu.bounds.size.height - lights.bounds.size.height) / 2.0), lights.bounds.size.width, lights.bounds.size.height);
    [menu bringSubviewToFront:lights];
    if ([toolbar isKindOfClass:[UIView class]]) for (NSString *k in @[@"close_menu", @"mini_menu", @"killapp_menu"]) {
        UIView *b = nil; @try { b = [toolbar valueForKey:k]; } @catch (id e) {}
        if ([b isKindOfClass:[UIView class]] && !b.hidden) b.hidden = YES;
    }
    DMZetsuMacShape(w, menu, toolbar);
}
// Full screen -> window (the green button, iPad 2 landscape): Zetsu records the app's orientation from the full-screen app (landscape, 3/4) in the
// window's appOrientation and its controller's isOrientation; our scene settings then put the window's app scene at orientation 1
// (DMPortraitWindowSettings), the app turns, and Zetsu answered that turn ~0.9 s later by resetting the window to its own default size
// (460.8 x 758, off the bottom of the screen), which the watcher then took for a hand resize. A window opened fresh records 1 and never does this.
// So for the window's first 3 s (Zetsu fills these in a moment after the window appears) that record is set to the orientation the scene gets.
// Plain properties; nothing of Zetsu's is called. Off switch: /tmp/msb-zetsu-noorientadopt.
long DMWantedSceneOrientationFor(long current);
static void DMZetsuSyncAppOrientation(UIWindow *w) {
    if (DMTestFlag("/tmp/msb-zetsu-noorientadopt")) return;
    id ctl = DMZetsuController(w);
    long ao = 0, co = 0;
    @try { ao = [[w valueForKey:@"appOrientation"] longValue]; co = [[ctl valueForKey:@"isOrientation"] longValue]; } @catch (id e) { return; }
    if (ao < 1 || ao > 4) return;   // (not recorded yet)
    long want = DMWantedSceneOrientationFor(ao);
    if (want < 1 || want > 4 || (want == ao && (co < 1 || co > 4 || want == co))) return;
    @try { [w setValue:@(want) forKey:@"appOrientation"]; if (co >= 1 && co <= 4) [ctl setValue:@(want) forKey:@"isOrientation"]; } @catch (id e) {}
    DMLog([NSString stringWithFormat:@"[zetsu] %@: Zetsu's record of the app's orientation %ld/%ld -> %ld (what its window scene gets), so Zetsu does not reset the window when the app turns", DMZetsuWindowBundle(w), ao, co, want]);
}
// A Zetsu window seen for the first time: it gets its size and place (Zetsu opens every window at the same small default), joins Fit to Window
// or is kept off the other windows, comes to the front, and the App Library goes away. Called at once from the window's own -didAddSubview:
// (the existing styling hook) and, as a fallback, from the 0.2 s watcher.
static void DMZetsuAdopt(UIWindow *w) {
    if (DMActiveEngine() != DMEngineZetsu || !w || [objc_getAssociatedObject(w, kZetsuAdoptedKey) boolValue]) return;
    NSString *bundleID = DMZetsuWindowBundle(w);
    if (!bundleID.length || !DMZetsuController(w)) return;
    objc_setAssociatedObject(w, kZetsuAdoptedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    objc_setAssociatedObject(w, kZetsuAdoptTimeKey, @(CACurrentMediaTime()), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
    [gZetsuOpening removeObjectForKey:bundleID];   // (its window is here: DMZetsuLaunch's one-at-a-time note goes)
    extern BOOL gRestoringWindowsFlag(void);
    CGRect target = !CGRectIsNull(gPendingWindowFrame) ? gPendingWindowFrame : (gLastWindowFrames[bundleID] ? gLastWindowFrames[bundleID].CGRectValue : DMLayoutFrame(@"center"));
    DMLog([NSString stringWithFormat:@"[zetsu] new window for %@ at %@ -> %@%@", bundleID, NSStringFromCGRect(w.frame), NSStringFromCGRect(target), gRestoringWindowsFlag() ? @" (being restored)" : @""]);
    DMZetsuInstallLights(w);
    DMZetsuSyncAppOrientation(w);
    if (!CGRectIsNull(target) && !gRestoringWindowsFlag()) DMZetsuMove(w, target, NO, nil);
    DMZetsuRaise(w);
    if (DMFrontApp()) { gWindowsPinnedForward = YES; DMLog(@"[zetsu] a new window opened over a full-screen app: windows brought forward"); }
    DMApplyWindowLevel();
    DMDismissLibraryForWindow(bundleID);
    // Placed among the others (Fit to Window, or kept off them) 0.5 s later. A window still minimized then -- the Home press of a warm start
    // (opened full screen first, then into a window) can leave it so for a moment, and it is shown again at ~1.1 s -- is looked at again, up to
    // 2 s (iPad 2, 2026-09-26: Safari came up stacked on Notes with Fit to Window on, and only fell into place when a third app opened).
    __weak UIWindow *weakW = w;
    __block void (^place)(int) = nil;
    void (^placeImpl)(int) = ^(int tries) {
        UIWindow *s = weakW;
        if (!s || [objc_getAssociatedObject(s, kStageClosingKey) boolValue]) { place = nil; return; }
        if (DMStageMinimized(s)) {
            if (tries < 6) { void (^again)(int) = place; dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.25 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ again(tries + 1); }); }
            else place = nil;
            return;
        }
        if (tries) DMLog([NSString stringWithFormat:@"[zetsu] %@: placed among the windows after it was shown again (%d later look%@)", DMZetsuWindowBundle(s), tries, tries == 1 ? @"" : @"s"]);
        DMCascadeStage(s); DMZetsuFixScale(s); DMSaveWindowState();
        place = nil;
    };
    place = placeImpl;
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (place) place(0); });
}
// The App Switcher: Zetsu's windows float above it (level ~1002) and would hide it, so they fade out while it is showing and come back when it
// is gone (Aerial and MilkyWay take their windows out of the way the same way). Called when the switcher starts to appear, and every 0.2 s.
static BOOL DMSwitcherVisible(void);
extern BOOL gZetsuHiddenForSwitcherFlag;
BOOL gZetsuHiddenForSwitcherFlag = NO;
static UIWindow *DMMilkyWayLayer(void);
void DMZetsuSwitcherCheck(BOOL appearing) {
    if (DMSMEngine() || DMSMDeskIsFaded()) {   // (Stage Manager: the App Switcher is drawn in the window its windows faded with -- given back at once)
        DMSMDeskSyncFade();
        if (DMSMEngine()) return;
    }
    if (DMActiveEngine() == DMEngineMilkyWay) {   // MilkyWay (M1, Phase 2b): its window layer (level 1033) stayed over the App Switcher, hiding it
        static CFTimeInterval mwAppearedAt = 0;
        if (appearing) mwAppearedAt = CACurrentMediaTime();
        BOOL want = appearing || DMSwitcherVisible() || CACurrentMediaTime() - mwAppearedAt < 1.0;
        if (want == gMilkyWayHiddenForSwitcher) return;
        gMilkyWayHiddenForSwitcher = want;
        UIWindow *layer = DMMilkyWayLayer();
        DMLog([NSString stringWithFormat:@"[milkyway] App Switcher %@: windows %@", want ? @"showing" : @"gone", want ? @"fade out" : @"come back"]);
        CGFloat alpha = (want || gWindowsHiddenForLibrary) ? 0.0 : 1.0;
        [UIView animateWithDuration:want ? 0.12 : 0.22 delay:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{ layer.alpha = alpha; } completion:nil];
        return;
    }
    if (DMActiveEngine() != DMEngineZetsu) return;
    static CFTimeInterval appearedAt = 0;
    if (appearing) appearedAt = CACurrentMediaTime();
    BOOL want = appearing || DMSwitcherVisible() || CACurrentMediaTime() - appearedAt < 1.0;
    if (want == gZetsuHiddenForSwitcherFlag) return;
    gZetsuHiddenForSwitcherFlag = want;
    NSArray<UIWindow *> *all = DMZetsuAllWindows();
    DMLog([NSString stringWithFormat:@"[zetsu] App Switcher %@: %lu windows %@", want ? @"showing" : @"gone", (unsigned long)all.count, want ? @"fade out" : @"come back"]);
    CGFloat alpha = (want || gWindowsHiddenForLibrary) ? 0.0 : 1.0;
    [UIView animateWithDuration:want ? 0.12 : 0.22 delay:0 options:UIViewAnimationOptionBeginFromCurrentState animations:^{ for (UIWindow *w in all) w.alpha = alpha; } completion:nil];
}
// Locking the iPad makes Zetsu collapse every window into its title-bar pill (its own behaviour, like Aerial's minimize-all on lock, which we
// stop with a hook there; nothing of Zetsu's is hooked for this). After the unlock every window Zetsu collapsed (not one we minimized) is opened
// again the way a tap on its pill does, back to front, so the order is the same as before.
static CFTimeInterval gZetsuReopenedAt = -10;   // when DMZetsuAfterUnlock last reopened windows (their size changes then are Zetsu's, not the user's)
void DMZetsuAfterUnlock(void) {
    if (DMActiveEngine() != DMEngineZetsu) return;
    NSUInteger n = 0;
    for (UIWindow *w in DMZetsuOrdered()) {
        BOOL reduced = NO; @try { reduced = [[w valueForKey:@"_isReduction"] boolValue]; } @catch (id e) {}
        if (!reduced || [objc_getAssociatedObject(w, kStageHiddenKey) boolValue]) continue;
        DMZetsuTap(w); n++;
    }
    if (n) { gZetsuReopenedAt = CACurrentMediaTime(); DMZetsuApplyLevels(); DMLog([NSString stringWithFormat:@"[zetsu] unlocked: %lu windows Zetsu had collapsed on lock opened again", (unsigned long)n]); }
    // Zetsu reopens them at its own default size (461 x 640 on the iPad 2), not where they were: once it has, every one goes back to its place
    // (its tile, or where it was put), without changing which one is in front.
    // (twice: Zetsu can change a reopened window's height again a moment later -- seen on the iPad 2: 608 -> 633.5 pt about 0.4 s after the reopen)
    if (n) for (NSNumber *delay in @[@0.6, @1.6]) dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(delay.doubleValue * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
        extern BOOL gMoveKeepsOrderFlag(void);
        for (UIWindow *w in DMZetsuOrdered()) {
            NSValue *intent = objc_getAssociatedObject(w, kStageIntentKey);
            if (!intent || DMStageMinimized(w) || w.hidden) continue;
            CGRect want = intent.CGRectValue, f = w.frame;
            if (fabs(want.origin.x - f.origin.x) <= 1.0 && fabs(want.origin.y - f.origin.y) <= 1.0 && fabs(want.size.width - f.size.width) <= 1.0 && fabs(want.size.height - f.size.height) <= 1.0) continue;
            DMLog([NSString stringWithFormat:@"[zetsu] %@ back to %@ after the unlock (Zetsu reopened it at %@)", DMZetsuWindowBundle(w), NSStringFromCGRect(want), NSStringFromCGRect(f)]);
            extern void DMSetMoveKeepsOrder(BOOL keep);
            DMSetMoveKeepsOrder(YES); DMZetsuMove(w, want, YES, nil); DMSetMoveKeepsOrder(NO);
        }
    });
}
// Zetsu, the on-screen keyboard (the A1 report, M1 iOS 15): the keyboard of an app in a Zetsu window is drawn by a keyboard layer host
// (_UIKeyboardLayerHostView, a full-screen-sized view) that Zetsu puts INSIDE that app's ZetsuWindow -- and a ZetsuWindow clips to its own frame,
// so the keyboard showed only within the window's width, and after a turn it was cut away completely (a grey patch was left). Zetsu also keeps a
// full-screen window of its own for the keyboard (ZetsuKeyboard, level 1003, above every window, touches pass through it); the host is moved
// there, at that window's full size, so the keyboard spans the screen's bottom edge and covers the windows like on Aerial 3.0 (the rule: no
// keyboard avoidance). Nothing of Zetsu's is called; only the existing view is moved. Kill switch: /tmp/msb-zkb-off.
static CGRect DMUsableArea(void);
static void DMApplyGroupSlots(UIView *fresh);
static unsigned gDMDockGen = 0;   // (bumped when the Dock itself changes: its own apps, its size or gap -- DMWatchDockChanges)
static BOOL DMDockOnScreen(void);
static CGFloat DMDockCenterX(void);
static CGPoint DMScreenToNative(CGPoint s, long orientation, CGSize native);
static long DMRealInterfaceOrientation(void);
static id DMKeyboardHostOwningScene(UIView *host);
static void DMZetsuKeyboardOut(NSString *why) {
    if (DMActiveEngine() != DMEngineZetsu || DMTestFlag("/tmp/msb-zkb-off")) return;
    UIWindow *target = nil;
    NSMutableArray<UIView *> *hosts = [NSMutableArray array];
    NSArray<UIWindow *> *allW = DMAllWindows();
    for (UIWindow *w in allW) if ([NSStringFromClass([w class]) isEqualToString:@"ZetsuKeyboard"]) { target = w; break; }
    if (!target || target.hidden) return;   // (the target first: without it nothing below is used, so the windows' views are not walked)
    for (UIWindow *w in allW) {
        NSString *c = NSStringFromClass([w class]);
        if (![c isEqualToString:@"ZetsuWindow"]) continue;
        NSMutableArray *stack = [NSMutableArray arrayWithObject:w];
        while (stack.count) {
            UIView *v = stack.lastObject; [stack removeLastObject];
            if ([NSStringFromClass([v class]) isEqualToString:@"_UIKeyboardLayerHostView"]) { [hosts addObject:v]; continue; }
            [stack addObjectsFromArray:v.subviews];
        }
    }
    if (!target || target.hidden) return;
    for (UIView *h in hosts) {   // (a borrowed system view: if UIKit refuses the move, it goes back where it was and SpringBoard carries on)
        UIView *oldSuper = h.superview; NSUInteger oldIndex = oldSuper ? [oldSuper.subviews indexOfObject:h] : 0;
        CGRect oldFrame = h.frame; UIViewAutoresizing oldMask = h.autoresizingMask;
        @try {
            [target addSubview:h];
            h.frame = target.bounds;
            h.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
            static int nAtOnce = 0;
            if (![why isEqualToString:@"at once"] || nAtOnce++ < 20) DMLog([NSString stringWithFormat:@"[zetsu] keyboard host moved out of the window into Zetsu's full-screen keyboard window (%@), frame %@", why, NSStringFromCGRect(h.frame)]);
        } @catch (NSException *e) {
            DMLog([NSString stringWithFormat:@"[zetsu] UIKit refused to move the keyboard host (%@: %@): put back", e.name, e.reason]);
            @try {
                if (oldSuper && h.superview != oldSuper) { if (oldIndex < oldSuper.subviews.count) [oldSuper insertSubview:h atIndex:oldIndex]; else [oldSuper addSubview:h]; }
                h.frame = oldFrame; h.autoresizingMask = oldMask;
            } @catch (NSException *e2) { DMLog(@"[zetsu] could not put the keyboard host back either"); }
        }
    }
    // Keyboard Phase (iPad 2, iOS 16): Zetsu makes a NEW keyboard host for the app every time the window is laid out again (every turn, ~5-10 per
    // turn), and each one was moved out here and kept: 29 hosts of Safari's piled up in ZetsuKeyboard after four turns, all "paired". Only the newest
    // host of each app is kept; the older ones (Zetsu no longer uses them) are taken away.
    {
        NSMutableDictionary<NSString *, UIView *> *newest = [NSMutableDictionary dictionary];
        NSMutableArray<UIView *> *stale = [NSMutableArray array];
        for (UIView *h in target.subviews) {
            if (![NSStringFromClass([h class]) isEqualToString:@"_UIKeyboardLayerHostView"]) continue;
            id owner = DMKeyboardHostOwningScene(h);
            NSString *key = owner ? [NSString stringWithFormat:@"%p", owner] : @"?";
            if (newest[key]) [stale addObject:newest[key]];
            newest[key] = h;   // (subviews are in the order they were added: the last one is the newest)
        }
        for (UIView *h in stale) { @try { [h removeFromSuperview]; } @catch (NSException *e) { DMLog([NSString stringWithFormat:@"[zetsu] an old keyboard host could not be taken away (%@)", e.reason]); } }
        if (stale.count) { static int nStale = 0; if (nStale++ < 20) DMLog([NSString stringWithFormat:@"[zetsu] %lu old keyboard host(s) of the same app taken away (%@)", (unsigned long)stale.count, why]); }
    }
    // Upside down (2): Zetsu's keyboard window does not turn to 2 (it stays at 1 -- measured), so the picture is turned by half a turn inside it.
    long want = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"activeInterfaceOrientation"));
    SEL haveSel = NSSelectorFromString(@"_windowInterfaceOrientation");
    long have = [target respondsToSelector:haveSel] ? ((long (*)(id, SEL))objc_msgSend)(target, haveSel) : want;
    CGAffineTransform t = (want == 2 && have == 1) ? CGAffineTransformMakeRotation(M_PI) : CGAffineTransformIdentity;
    // Keyboard Phase: with a hardware keyboard only the app's input bar is in the picture (laid out for a portrait screen, bar at the bottom). In
    // landscape it showed SIDEWAYS at the screen's side edge, and in portrait it sat on the Dock's corner. Like on Aerial (DMFixKeyboardOrientation):
    // the bar is turned upright and, in landscape, shown as a small pill in the middle of the Dock; its bottom edge sits just above the Dock (or 6 pt
    // off the bottom edge when no Dock is showing). Only in this bar-only state -- the on-screen keyboard (no hardware keyboard) is left as it was.
    // (and the ON-SCREEN keyboard in landscape, found on the way: Zetsu's keyboard window is never turned on iOS 16 and the keyboard picture is laid
    // out for a portrait screen, so in landscape the keyboard stood SIDEWAYS in a strip at the side edge -- with or without a hardware keyboard ever
    // attached. It is turned upright and stretched to the screen's width, bottom edge on the screen's bottom edge, like DMFixKeyboardOrientation
    // does for Aerial.)
    {
        CGSize native = target.bounds.size;   // (portrait: the window is never turned)
        CGSize screen = [UIScreen mainScreen].bounds.size;
        long o = DMRealInterfaceOrientation();
        BOOL landscape = (o == 3 || o == 4) && screen.width > screen.height;
        BOOL bar = gKbBarOnly && !DMTestFlag("/tmp/msb-zbar-off");
        BOOL turnKeyboard = !gKbBarOnly && landscape && native.height > native.width && !DMTestFlag("/tmp/msb-zkbturn-off");
        if (have == 1 && (bar || turnKeyboard)) {
            CGFloat aboveDock = 0.0;
            if (bar && DMDockOnScreen()) { CGRect usable = DMUsableArea(); if (!CGRectIsEmpty(usable)) aboveDock = MAX(0.0, screen.height - (CGRectGetMaxY(usable) + 2.0) + 4.0); }
            const CGFloat barMiddle = 314.25, barBottom = 1019.0;   // (measured on Aerial: the same keyboard scene, 768 x 1024)
            CGFloat sx, sy; CGPoint pictureAnchor, screenAnchor;
            if (turnKeyboard) { sx = screen.width / native.width; sy = 1.0; pictureAnchor = CGPointMake(native.width / 2.0, native.height); screenAnchor = CGPointMake(screen.width / 2.0, screen.height); }
            else if (landscape) { sx = sy = 0.62; pictureAnchor = CGPointMake(barMiddle, barBottom); screenAnchor = CGPointMake(DMDockCenterX(), screen.height - MAX(aboveDock, 6.0)); }
            else { sx = sy = 1.0; pictureAnchor = CGPointMake(native.width / 2.0, barBottom); screenAnchor = CGPointMake(screen.width / 2.0, screen.height - (native.height - barBottom) - aboveDock); }
            CGPoint n0 = DMScreenToNative(screenAnchor, o, native);
            CGPoint nx = DMScreenToNative(CGPointMake(screenAnchor.x + 1.0, screenAnchor.y), o, native), ny = DMScreenToNative(CGPointMake(screenAnchor.x, screenAnchor.y + 1.0), o, native);
            CGFloat a = (nx.x - n0.x) * sx, b = (nx.y - n0.y) * sx, c = (ny.x - n0.x) * sy, d = (ny.y - n0.y) * sy;   // picture axes -> native
            CGPoint centre = CGPointMake(native.width / 2.0, native.height / 2.0);
            CGFloat px = pictureAnchor.x - centre.x, py = pictureAnchor.y - centre.y;
            t = CGAffineTransformMake(a, b, c, d, n0.x - centre.x - (a * px + c * py), n0.y - centre.y - (b * px + d * py));
        }
    }
    for (UIView *h in target.subviews) {
        if (![NSStringFromClass([h class]) isEqualToString:@"_UIKeyboardLayerHostView"]) continue;
        if (!CGAffineTransformEqualToTransform(h.transform, t)) { h.transform = t; DMLog([NSString stringWithFormat:@"[zetsu] keyboard picture %@ (screen %ld, keyboard window %ld)", CGAffineTransformIsIdentity(t) ? @"upright" : [NSString stringWithFormat:@"placed (turned / lifted / scaled: %@)", NSStringFromCGAffineTransform(t)], want, have]); }
        CGRect b = target.bounds;
        if (!CGRectEqualToRect(h.bounds, b) || !CGPointEqualToPoint(h.center, CGPointMake(CGRectGetMidX(b), CGRectGetMidY(b)))) { h.bounds = b; h.center = CGPointMake(CGRectGetMidX(b), CGRectGetMidY(b)); }   // (after a turn)
    }
}
// Every 0.2 s (with the other watchers): new windows adopted, lights kept in place, the content scale kept right, the levels kept in order.
static CFTimeInterval gZetsuOrientationChangedAt = -10;   // when the interface orientation last changed (DMWatchZetsu)
// Zetsu's windows turn with the DEVICE (UIKit autorotation of each ZetsuWindow), not with the screen. When the two differ -- a landscape-only
// game full screen with the iPad upright (iPad 2, Jetpack Joyride) -- the windows were drawn upright over a sideways screen, their title bars
// and our status bar pointing different ways. Like Aerial 5.0 on iOS 15 (DMAerial5SyncLayerOrientation): a window whose own orientation is not the
// screen's is turned to the screen's with UIKit's window rotation call. Nothing of Zetsu's is called. Off switch: /tmp/msb-nozetsuorient.
static void DMZetsuSyncOrientation(NSArray<UIWindow *> *all) {
    if (!all.count || DMTestFlag("/tmp/msb-nozetsuorient")) return;
    id app = [UIApplication sharedApplication];
    SEL activeSel = NSSelectorFromString(@"activeInterfaceOrientation"), haveSel = NSSelectorFromString(@"_windowInterfaceOrientation");
    SEL rot4 = NSSelectorFromString(@"_setRotatableViewOrientation:updateStatusBar:duration:force:");
    SEL rot3 = NSSelectorFromString(@"_setRotatableViewOrientation:duration:force:"), busySel = NSSelectorFromString(@"isRotating");
    if (![app respondsToSelector:activeSel]) return;
    long want = ((long (*)(id, SEL))objc_msgSend)(app, activeSel);
    if (want < 1 || want > 4) return;
    for (UIWindow *w in all) {
        if (w.hidden || ![w respondsToSelector:haveSel]) continue;
        long have = ((long (*)(id, SEL))objc_msgSend)(w, haveSel);
        if (have == want || have < 1 || have > 4) continue;
        if ([w respondsToSelector:busySel] && ((BOOL (*)(id, SEL))objc_msgSend)(w, busySel)) continue;   // (UIKit is turning it right now)
        if ([w respondsToSelector:rot4]) ((void (*)(id, SEL, long, BOOL, double, BOOL))objc_msgSend)(w, rot4, want, NO, 0.0, YES);
        else if ([w respondsToSelector:rot3]) ((void (*)(id, SEL, long, double, BOOL))objc_msgSend)(w, rot3, want, 0.0, YES);
        else continue;
        gZetsuOrientationChangedAt = CACurrentMediaTime();   // (Zetsu re-places a turned window: not a hand move, the tiles stay)
        DMLog([NSString stringWithFormat:@"[zetsu] %@: window turned from orientation %ld (the device's) to the screen's %ld (frame now %@)",
               DMZetsuWindowBundle(w), have, want, NSStringFromCGRect(w.frame)]);
    }
}
static void DMWatchZetsu(void) {
    if (DMActiveEngine() == DMEngineMilkyWay) { DMZetsuSwitcherCheck(NO); return; }   // (MilkyWay's App Switcher fade, same check)
    if (DMActiveEngine() != DMEngineZetsu) return;
    {   // (when the interface orientation last changed: see the hand-move check below)
        static long lastO = 0; long o = DMRealInterfaceOrientation();
        if (o != lastO) { if (lastO) gZetsuOrientationChangedAt = CACurrentMediaTime(); lastO = o; }
    }
    // Idle trim (2026-09-25, like Aerial 5.0's): with no Zetsu window (DMWindowWorkNeeded: none for 3 s, so the passes that see the last window go
    // -- its saved state, its switcher fade, its flexed frames -- have run) nothing below has anything to do, and it was ~0.5-0.6 ms per pass on the
    // iPad 2 (the switcher check and the keyboard walk over every window). A new window is seen on the very next pass, as before (the answer is
    // at most 50 ms old). The switcher's own appear call (DMZetsuSwitcherCheck(YES)) is not affected. /tmp/msb-nowindowgate: every pass as before.
    BOOL windowWork = YES;
    DM_PERF("zw-gate", windowWork = DMWindowWorkNeeded());
    if (!windowWork) return;
    DM_PERF("zw-switcher", DMZetsuSwitcherCheck(NO));
    DM_PERF("zw-kbout", DMZetsuKeyboardOut(@"tick"));
    NSArray<UIWindow *> *all = DMZetsuAllWindows();
    DMZetsuSyncOrientation(all);
    for (NSString *fb in [gZetsuFlexFrames allKeys]) {   // a window closed some other way (Zetsu's own close, the app quit): its app is no longer flexed
        UIWindow *fw = DMZetsuWindowFor(fb);
        if (!fw || [objc_getAssociatedObject(fw, kStageClosingKey) boolValue]) { [gZetsuFlexFrames removeObjectForKey:fb]; DMLog([NSString stringWithFormat:@"[zflex] %@: window gone, full-screen frames again", fb]); }
    }
    static NSUInteger lastCount = 0;
    for (UIWindow *w in all) {
        if (![objc_getAssociatedObject(w, kZetsuAdoptedKey) boolValue]) DMZetsuAdopt(w);
        // A window Zetsu keeps hidden because its app never comes up in it: Zetsu starts the app in the BACKGROUND, and Reminders (a two-scene app on
        // the iPad 2) was killed by iOS's 10 s background-launch watchdog again and again, its window never shown -- once, with that app dying under a
        // hidden window, Zetsu itself crashed SpringBoard (-[FBSceneMonitor dealloc] assert) -- and when the window was shown by hand it stayed blank.
        // So a window still hidden 6 s after it opened is closed with Zetsu's own close (the app is not killed) and the app opens full screen instead.
        NSNumber *adoptedAt = objc_getAssociatedObject(w, kZetsuAdoptTimeKey);
        if (adoptedAt && CACurrentMediaTime() - adoptedAt.doubleValue < 3.0) DMZetsuSyncAppOrientation(w);
        if (w.hidden && adoptedAt && !objc_getAssociatedObject(w, kZetsuSurfacedKey) && CACurrentMediaTime() - adoptedAt.doubleValue > 6.0
            && ![objc_getAssociatedObject(w, kStageHiddenKey) boolValue] && ![objc_getAssociatedObject(w, kStageClosingKey) boolValue] && !gWindowsHiddenForLibrary && !gZetsuHiddenForSwitcherFlag) {
            BOOL reduced = NO; @try { reduced = [[w valueForKey:@"_isReduction"] boolValue]; } @catch (id e) {}
            NSString *stuck = DMZetsuWindowBundle(w);
            if (!reduced && stuck.length) {
                objc_setAssociatedObject(w, kZetsuSurfacedKey, @YES, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
                DMLog([NSString stringWithFormat:@"[zetsu] %@: its window never showed its app (6 s): closed, the app opens full screen instead", stuck]);
                DMFitGroupForget(stuck);
                DMZetsuClose(w);
                dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.4 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ DMOpenFullScreen(stuck); });
                continue;
            }
        }
        UIView *lights = objc_getAssociatedObject(w, kZetsuLightsKey);
        BOOL collapsed = DMStageMinimized(w);
        if (lights && lights.hidden != collapsed) lights.hidden = collapsed;   // Zetsu's own pill: its label, not our lights
        if (w.hidden || collapsed || [objc_getAssociatedObject(w, kStageClosingKey) boolValue]) continue;
        DMZetsuInstallLights(w);
        DMZetsuFixScale(w);
        // Moved or resized by hand (Zetsu's own title-bar drag / bottom-bar resize, which nothing of ours sees): once it has settled away from
        // where we last put it, that is its new place, and it is no longer one of Fit to Window's tiles (the same as a hand drag of an Aerial window).
        NSValue *intent = objc_getAssociatedObject(w, kStageIntentKey);
        CGRect f = w.frame;
        f.origin.y -= DMAutoHideShiftOf(w);   // (the auto-hiding status bar's move down is not the user's)
        // (not after a turn of the screen: Zetsu then puts every window back to its own default size in the middle -- seen on the iPad 2 turning
        // back to portrait -- and that is not the user's doing: the windows stay tiled and are arranged for the new shape)
        NSValue *intentSize = objc_getAssociatedObject(w, kStageIntentSizeKey);
        BOOL turned = intentSize && !CGSizeEqualToSize(intentSize.CGSizeValue, [UIScreen mainScreen].bounds.size);
        // iPad 2 fix (2026-09-24): a flip to the OTHER landscape (3 <-> 4) or portrait <-> upside down keeps the screen size, so the test above missed it;
        // Zetsu still put every window back to its default size (460.8 pt wide, stacked), which was read as the user's hand move: the windows were dropped
        // from their tiles and stayed stacked. Any change of the interface orientation in the last 2.5 s is a turn too.
        if (!turned && CACurrentMediaTime() - gZetsuOrientationChangedAt < 2.5) turned = YES;
        // Requirement (2026-09-25): after an unlock Fit's tiles were gone -- Zetsu reopens the windows it collapsed on lock at other sizes, and this watcher
        // took that for a hand resize (untiled) before DMZetsuAfterUnlock put them back. The reopen's first 2.5 s are Zetsu's, not the user's.
        if (!turned && CACurrentMediaTime() - gZetsuReopenedAt < 2.5) turned = YES;
        if (intent && !turned && !w.layer.animationKeys.count && CGRectGetWidth(f) >= 150.0 && CGRectGetHeight(f) >= 150.0) {
            CGRect was = intent.CGRectValue;
            if (fabs(was.origin.x - f.origin.x) > 2.0 || fabs(was.origin.y - f.origin.y) > 2.0 || fabs(was.size.width - f.size.width) > 2.0 || fabs(was.size.height - f.size.height) > 2.0) {
                static NSMutableDictionary<NSString *, NSValue *> *seen; if (!seen) seen = [NSMutableDictionary dictionary];
                NSString *b = DMZetsuWindowBundle(w);
                NSValue *now = [NSValue valueWithCGRect:f];
                if (b.length && [seen[b] isEqualToValue:now]) {   // the same frame on two ticks in a row: the drag is over
                    [seen removeObjectForKey:b];
                    DMLog([NSString stringWithFormat:@"[zetsu] %@ moved by hand %@ -> %@: remembered, no longer tiled", b, NSStringFromCGRect(was), NSStringFromCGRect(f)]);
                    DMRememberStageFrame(w);
                    DMFitGroupForget(b);
                    DMSaveWindowState();
                } else if (b.length) seen[b] = now;
            }
        }
    }
    DMZetsuApplyLevels();
    if (all.count != lastCount) { lastCount = all.count; DMSaveWindowState(); }
}
static SBApplication *DMActiveApp(void) {
    if (DMSMEngine()) {   // (Stage Manager as the engine: the front window of the stage on screen -- the newest interaction)
        NSString *b = DMSMFrontWindowBundle();
        SBApplication *app = b.length ? DMAppForBundle(b) : nil;
        return app ?: DMFrontApp();
    }
    NSArray<UIWindow *> *zetsu = DMActiveEngine() == DMEngineZetsu ? @[] : DMZetsuWindows();   // (Zetsu as the engine: handled with Aerial's rules below)
    if (zetsu.count) {
        NSString *bid = DMZetsuWindowBundle(zetsu.lastObject);   // last in z-order = frontmost; good enough for a first pass (Zetsu split view, two apps at once, is not distinguished yet)
        SBApplication *zapp = bid.length ? DMAppForBundle(bid) : nil;
        if (zapp) return zapp;
    }
    if (DMActiveEngine() == DMEngineAerial || DMActiveEngine() == DMEngineZetsu) {
        UIView *stage = DMWindowsOwnStatusBar() ? DMTopStage() : nil;
        SBApplication *staged = stage ? DMAppForBundle(DMStageBundle(stage)) : nil;
        if (staged) return staged;
        SBApplication *front = DMFrontApp();
        if (front) { if ([[front bundleIdentifier] isEqualToString:gPendingFrontBundle]) gPendingFrontBundle = nil; return front; }
        if (gPendingFrontBundle.length && CACurrentMediaTime() < gPendingFrontUntil) return DMAppForBundle(gPendingFrontBundle);
        return nil;
    }
    UIView *top = DMWindowsOwnStatusBar() ? DMTopWindow() : nil;
    if (top) {
        SBApplication *windowed = DMAppForBundle([(AXWindowView *)top bundleIdentifier]);
        if (windowed) return windowed;
    }
    return DMFrontApp();
}

// Test helper: a pan recogniser with a scripted state and translation, to drive MilkyWay's own resize handler.
@interface DMFakePan : UIPanGestureRecognizer
@property (nonatomic) UIGestureRecognizerState fakeState;
@property (nonatomic) CGPoint fakeTranslation;
@end
@implementation DMFakePan
- (UIGestureRecognizerState)state { return self.fakeState; }
- (CGPoint)translationInView:(UIView *)view { return self.fakeTranslation; }
- (CGPoint)velocityInView:(UIView *)view { return CGPointZero; }
- (CGPoint)locationInView:(UIView *)view {
    CGRect corner = [view isKindOfClass:[UIView class]] ? view.bounds : CGRectZero;
    return CGPointMake(CGRectGetMaxX(corner) + self.fakeTranslation.x, CGRectGetMaxY(corner) + self.fakeTranslation.y);
}
@end
static void DMFakeResize(CGFloat dx, CGFloat dy) {
    UIView *w = DMTopWindow();
    UIView *handle = w ? [w valueForKey:@"sizeChanger"] : nil;
    if (!handle) { DMLog(@"[mw] fake resize: no window/handle"); return; }
    SEL pan = NSSelectorFromString(@"sizeChangePan:");
    DMFakePan *g = [[DMFakePan alloc] init];
    [handle addGestureRecognizer:g];
    DMLog([NSString stringWithFormat:@"[mw] fake resize dx %.0f dy %.0f on window %@", dx, dy, NSStringFromCGRect(w.frame)]);
    g.fakeState = UIGestureRecognizerStateBegan; g.fakeTranslation = CGPointZero;
    ((void (*)(id, SEL, id))objc_msgSend)(w, pan, g);
    for (int i = 1; i <= 4; i++) {
        g.fakeState = UIGestureRecognizerStateChanged; g.fakeTranslation = CGPointMake(dx * i / 4.0, dy * i / 4.0);
        ((void (*)(id, SEL, id))objc_msgSend)(w, pan, g);
    }
    g.fakeState = UIGestureRecognizerStateEnded;
    ((void (*)(id, SEL, id))objc_msgSend)(w, pan, g);
    [handle removeGestureRecognizer:g];
    DMLog([NSString stringWithFormat:@"[mw] fake resize done, window now %@", NSStringFromCGRect(w.frame)]);
}

// Makes the app inside a window really have the window's size, instead of MilkyWay scaling a full-screen picture of it into the
// window (which squeezes or crops it when the window is not screen-shaped). The scene is told the content area's size, in its own
// rotated (portrait) coordinates, and its picture is shown 1:1. The app then lays itself out for that size (a narrow window gets
// the compact layout) and stays sharp.
// Aerial's way of resizing: change the app's FBScene settings frame (the app then lays itself out for that size) and show its picture
// 1:1. MilkyWay hooks -[FBScene updateSettings:withTransitionContext:] and swallows resize requests for windowed apps (found by watching
// the same call with Aerial active, where it is accepted), so our own hook, which is installed BEFORE MilkyWay's (this library loads
// first) and therefore sits inside it, keeps the original implementation: calling that directly skips MilkyWay's hook.
@interface FBScene : NSObject
@end
// A scene held WEAKLY: an app that is force quit and launched again gets a new scene, and the old one is freed. A plain (non-retained)
// pointer to it would dangle and crash SpringBoard the next time it was used.
@interface DMWeakScene : NSObject
@property (nonatomic, weak) id scene;
@end
@implementation DMWeakScene
@end
static NSMutableDictionary<NSString *, DMWeakScene *> *gSceneByID = nil;   // identifier -> the FBScene (weak), collected as updates pass by
static NSMutableDictionary<NSString *, NSNumber *> *gSceneUpdateTime = nil;   // identifier -> when its last settings update went by
// identifier -> the frame DMSetSceneFrame most recently sent for it. Read by the accessibilitySceneFrame override below (Aerial-parity
// fix, see there for the full reasoning); written at the single chokepoint every windowing/un-windowing frame change already goes
// through, so this never needs its own separate set/clear call sites.
static NSMutableDictionary<NSString *, NSValue *> *gAccessibilitySceneFrame = nil;
// ---- which of a windowed app's scenes its window shows (2026-09-25) ----
// Apps that support several scenes (WhatsApp, Notes, Safari) can bring up SEVERAL scenes at once when they start straight into a window (WhatsApp:
// seven, old saved sessions reconnected). The keep-in-the-foreground veto below used to keep every scene whose identifier holds the bundle id, so
// WhatsApp drew into a hidden full-screen scene and its window stayed black; and a scene SpringBoard was tearing down (the app crashing or quitting)
// was pulled back into the foreground, a fight that ended in FrontBoard's assert in -[FBSceneMonitor dealloc] (iPad 2 Safe Mode, 01:30). Now only
// the scene the window actually shows is kept, and never one that is no longer valid or whose process is not running.
static BOOL DMSceneAlive(id scene) {   // still valid, and its app's process is running
    if (!scene) return NO;
    @try {
        SEL valid = NSSelectorFromString(@"isValid");
        if ([scene respondsToSelector:valid] && !((BOOL (*)(id, SEL))objc_msgSend)(scene, valid)) return NO;
        id proc = [scene respondsToSelector:NSSelectorFromString(@"clientProcess")] ? [scene valueForKey:@"clientProcess"] : nil;
        SEL running = NSSelectorFromString(@"isRunning");
        if (proc && [proc respondsToSelector:running] && !((BOOL (*)(id, SEL))objc_msgSend)(proc, running)) return NO;
    } @catch (id e) {}
    return YES;
}
static const void *kStageSceneKey = &kStageSceneKey;
static BOOL DMIsSceneOfBundle(id s, NSString *bundle) {
    if (!s || !bundle.length || ![s respondsToSelector:NSSelectorFromString(@"identifier")] || ![s respondsToSelector:NSSelectorFromString(@"settings")]) return NO;
    NSString *sid = nil; @try { sid = [s valueForKey:@"identifier"]; } @catch (id e) {}
    return [sid isKindOfClass:[NSString class]] && [sid containsString:bundle];
}
// The scene a window (stage) shows: the engine's own property where it has one (Aerial, MilkyWay4), otherwise the scene presentation view inside the
// window (any engine). Remembered on the stage (weakly) while it stays the same live scene. nil = not known.
static id DMStageScene(UIView *stage, NSString *bundle) {
    if (!stage || !bundle.length) return nil;
    DMWeakScene *box = objc_getAssociatedObject(stage, kStageSceneKey);
    if (box.scene && DMIsSceneOfBundle(box.scene, bundle)) return box.scene;
    id found = nil;
    for (NSString *k in @[@"scene", @"_scene"]) { id sc = nil; @try { sc = [stage valueForKey:k]; } @catch (id e) {} if (DMIsSceneOfBundle(sc, bundle)) { found = sc; break; } }
    if (!found) {
        NSMutableArray *queue = [NSMutableArray arrayWithObject:stage]; int seen = 0;
        while (queue.count && seen < 400 && !found) {
            UIView *v = queue.firstObject; [queue removeObjectAtIndex:0]; seen++;
            NSString *cn = NSStringFromClass([v class]);
            if ([cn containsString:@"ScenePresentationView"] || [cn containsString:@"SceneHostView"] || [cn containsString:@"SceneLayerHost"]) {   // (Aerial 5.0: _UISceneLayerHostContainerView)
                for (NSString *k in @[@"scene", @"_scene"]) { id sc = nil; @try { sc = [v valueForKey:k]; } @catch (id e) {} if (DMIsSceneOfBundle(sc, bundle)) { found = sc; break; } }
            }
            [queue addObjectsFromArray:v.subviews];
        }
    }
    if (found) { DMWeakScene *b = [DMWeakScene new]; b.scene = found; objc_setAssociatedObject(stage, kStageSceneKey, b, OBJC_ASSOCIATION_RETAIN_NONATOMIC); }
    return found;
}
static UIView *DMStageForBundle(NSString *bundleID);
// YES: this scene is the one the app's window shows -- or which one it is cannot be told (the window has not shown a scene yet, or the engine's
// window gives no way to find it): then every scene of the app counts, as before. Only a scene that is KNOWN not to be the window's is let go.
// (A guess by the scene's size is not safe: Zetsu's and MilkyWay4's window scenes are full-screen sized -- iPad 2, 02:12: such a guess kept a
// Zetsu window's only scene in the background, the window was closed as empty and the fight that followed tripped FrontBoard's assert.)
static BOOL DMSceneIsStageScene(id scene, NSString *bundle) {
    UIView *stage = DMStageForBundle(bundle);
    if (!stage) return YES;
    id stageScene = DMStageScene(stage, bundle);
    return !stageScene || stageScene == scene;
}
static NSString *DMShortSceneID(id scene) {
    NSString *sid = nil; @try { sid = [scene valueForKey:@"identifier"]; } @catch (id e) {}
    if (![sid isKindOfClass:[NSString class]]) return @"?";
    NSRange dash = [sid rangeOfString:@"-" options:NSBackwardsSearch];
    return dash.location != NSNotFound ? [sid substringFromIndex:dash.location + 1] : sid;
}
// The live scene of an app: the one its window shows when that is known; otherwise, of the scenes seen for the bundle, the one that received an
// update most recently and is still alive.
static id DMSceneForBundle(NSString *bundleID) {
    if (!bundleID.length) return nil;
    { UIView *stage = DMStageForBundle(bundleID); id sc = stage ? DMStageScene(stage, bundleID) : nil; if (sc) return sc; }
    id best = nil; double bestTime = -1.0;
    for (NSString *sid in [gSceneByID allKeys]) {
        if (![sid containsString:bundleID]) continue;
        id scene = gSceneByID[sid].scene;
        if (!scene) { [gSceneByID removeObjectForKey:sid]; continue; }   // gone with its app
        double when = gSceneUpdateTime[sid].doubleValue;
        if (when > bestTime) { best = scene; bestTime = when; }
    }
    return best;
}
// FrontBoard's own list, for an app whose scene our settings hook has not seen yet (iPad 2 / iOS 16: a full-screen app that is starting gets no
// settings update, so the watch below found no scene and waited its whole timeout -- 15 s behind the still picture). The foreground one first.
static id DMFrontBoardSceneForBundle(NSString *bundleID) {
    id mgr = DMCall(objc_getClass("FBSceneManager"), @"sharedInstance");
    SEL q = NSSelectorFromString(@"scenesPassingTest:");
    if (!bundleID.length || ![mgr respondsToSelector:q]) return nil;
    NSString *key = [bundleID stringByAppendingString:@"-"];   // ("sceneID:<bundle>-<UUID>" / "-default")
    id list = nil;
    @try { list = ((id (*)(id, SEL, id))objc_msgSend)(mgr, q, ^BOOL(id sc) { NSString *i = nil; @try { i = [sc valueForKey:@"identifier"]; } @catch (id e) {} return [i isKindOfClass:[NSString class]] && [i containsString:key]; }); } @catch (id e) {}
    if (![list respondsToSelector:@selector(countByEnumeratingWithState:objects:count:)]) return nil;   // (an NSSet on iOS 16)
    id any = nil;
    for (id sc in (id<NSFastEnumeration>)list) { BOOL fg = NO; @try { fg = [[[sc valueForKey:@"settings"] valueForKey:@"foreground"] boolValue]; } @catch (id e) {} if (fg) return sc; any = sc; }
    return any;
}
// "The app has drawn its first frame": FrontBoard's own content state of the app's scene (-[FBScene contentState]; 2 = ready, i.e. the app
// has committed its first frame to the scene's layers). Checked on every display frame (CADisplayLink) from the moment it is asked, so the
// answer comes within one frame of FrontBoard knowing it -- no fixed delay. done(YES) when ready (and the app in front, if asked), done(NO) at
// the timeout. Used by the full-screen-first window launches (WhatsApp) on every engine.
@interface DMDrawnWatch : NSObject
@property (nonatomic, copy) NSString *bundleID;
@property (nonatomic, copy) void (^done)(BOOL ready);
@property (nonatomic, strong) CADisplayLink *link;
@property (nonatomic) CFTimeInterval began, deadline;
@property (nonatomic) long long lastState;
@property (nonatomic) BOOL needFront;
@end
static NSMutableSet<DMDrawnWatch *> *gDrawnWatches;
@implementation DMDrawnWatch
- (void)tick:(CADisplayLink *)l {
    CFTimeInterval now = CACurrentMediaTime();
    // The window's own scene when the app has a window; else FrontBoard's live (foreground first) scene of the app -- not our list's newest, which
    // after a force quit is still the dead process's old scene for up to a second (iPad 2); our list only as the last resort.
    UIView *stage = DMStageForBundle(self.bundleID);
    id scene = stage ? DMStageScene(stage, self.bundleID) : nil;
    BOOL fromFB = NO;
    if (!scene) { scene = DMFrontBoardSceneForBundle(self.bundleID); fromFB = scene != nil; }
    if (!scene) scene = DMSceneForBundle(self.bundleID);
    long long st = -1;
    if (scene && [scene respondsToSelector:@selector(contentState)]) st = ((long long (*)(id, SEL))objc_msgSend)(scene, @selector(contentState));
    if (st != self.lastState) { self.lastState = st; DMLog([NSString stringWithFormat:@"[drawn] %@: scene content state %lld at +%.2f s (%@ %@%@)", self.bundleID, st, now - self.began, scene ? NSStringFromClass([scene class]) : @"no scene", scene ? DMShortSceneID(scene) : @"", fromFB ? @", FrontBoard's list" : @""]); }
    BOOL front = !self.needFront || [[DMFrontApp() bundleIdentifier] isEqualToString:self.bundleID];
    BOOL ready = st >= 2 && front;
    if (!ready && now < self.deadline) return;
    [l invalidate]; self.link = nil;
    void (^done)(BOOL) = self.done; self.done = nil;
    [gDrawnWatches removeObject:self];
    if (done) done(ready);
}
@end
void DMWhenAppDrawn(NSString *bundleID, BOOL needFront, double timeout, void (^done)(BOOL ready)) {
    if (!gDrawnWatches) gDrawnWatches = [NSMutableSet set];
    DMDrawnWatch *w = [DMDrawnWatch new];
    w.bundleID = bundleID; w.done = done; w.needFront = needFront; w.lastState = -2;
    w.began = CACurrentMediaTime(); w.deadline = w.began + timeout;
    [gDrawnWatches addObject:w];
    w.link = [CADisplayLink displayLinkWithTarget:w selector:@selector(tick:)];
    [w.link addToRunLoop:[NSRunLoop mainRunLoop] forMode:NSRunLoopCommonModes];
}
// Turning a full-screen app into a window: Aerial sends the app to the Home Screen first and shows the window about half a second later.
// A picture of the app ("cover") is held over the screen from the moment of the tap, hiding the Home Screen hop; when the window appears,
// the picture shrinks into the window's spot while the window (which holds the same picture until its app has settled) fades in.
static UIColor *gVeilColor = nil;            // fallback colour under the picture
static CFTimeInterval gVeilColorTime = 0;    // when the cover was made
static UIView *gStageCover = nil, *gCoverSnap = nil, *gVeilSnap = nil;
static void DMStageCoverRemove(void) {
    [gStageCover.layer removeAllAnimations];
    [gStageCover removeFromSuperview];
    gStageCover = nil; gCoverSnap = nil;
}
// forEntrance NO: an app is being launched as a window from the Home Screen (or a menu). The cover only hides SpringBoard's own launch
// animation (a white splash zooming up); the new window fades in over it, then it goes.
static void DMStageCoverPrepare(BOOL forEntrance) {
    DMStageCoverRemove();
    UIWindow *host = DMStatusBarWindow();
    UIView *a = host ? [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO] : nil;
    UIView *b = forEntrance && host ? [[UIScreen mainScreen] snapshotViewAfterScreenUpdates:NO] : nil;
    gVeilColor = nil; gVeilSnap = nil;
    if (!a || (forEntrance && !b)) return;
    UIView *cover = [[UIView alloc] initWithFrame:host.bounds];
    cover.clipsToBounds = YES;
    cover.userInteractionEnabled = NO;
    a.layer.anchorPoint = CGPointZero;
    a.frame = CGRectMake(0, 0, host.bounds.size.width, host.bounds.size.height);
    [cover addSubview:a];
    [host insertSubview:cover atIndex:0];   // above the app and the Home Screen, under the status bar itself
    gStageCover = cover; gCoverSnap = a;
    if (forEntrance) {
        gVeilSnap = b;
        gVeilColor = DMSystemInterfaceStyle() == UIUserInterfaceStyleDark ? [UIColor blackColor] : [UIColor whiteColor];
        gVeilColorTime = CACurrentMediaTime();
    }
    UIView *mine = cover;   // whatever goes wrong, never leave a frozen screen behind
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(4.0 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{ if (gStageCover == mine) DMStageCoverRemove(); });
    DMLog(forEntrance ? @"[aerial] cover placed over the screen for the window transition" : @"[aerial] cover placed over the screen for a window launch");
}
// After a window is closed, Aerial keeps pushing the window's old size at the app's scene for a moment (the app then comes up full screen
// but laid out for the window). For a short while every update for that app is turned into a full-screen one.
static NSString *gFullFrameGuardBundle = nil;
static CFTimeInterval gFullFrameGuardUntil = 0;
// Closes an Aerial window. On 3.0 our +closeAerialForBundle: hook arms the full-screen guard; 5.0 cannot be hooked, so it is armed here.
static void DMAerialClose(NSString *bundleID) {
    if (DMWaitForContextMenu([@"close " stringByAppendingString:bundleID ?: @""], ^{ DMAerialClose(bundleID); })) return;
    if (gAerialFlavor == 5 && bundleID.length) { gFullFrameGuardBundle = [bundleID copy]; gFullFrameGuardUntil = CACurrentMediaTime() + 3.0; }
    ((void (*)(id, SEL, id))objc_msgSend)((id)objc_getClass("AerialCore"), NSSelectorFromString(@"closeAerialForBundle:"), bundleID);
}
static CFTimeInterval gLockingUntil;
static NSString *DMStageBundle(UIView *stage);
static NSArray<UIView *> *DMAerialStages(void);
static BOOL DMScreenOnAndUnlocked(void) {
    if (CACurrentMediaTime() < gLockingUntil) return NO;
    // (iPadOS 17+: not while SpringBoard is starting or off the main thread -- the lock screen manager may not be asked then; issue #1, 18.2.1)
    if (DMNewOS() && (![NSThread isMainThread] || DMStarting())) return NO;
    id lock = DMSBManager("SBLockScreenManager");
    if (DMLockUp(lock)) return NO;   // (respondsToSelector-guarded)
    id backlight = DMSBManager("SBBacklightController");
    SEL on = NSSelectorFromString(@"screenIsOn");
    if ([backlight respondsToSelector:on] && !((BOOL (*)(id, SEL))objc_msgSend)(backlight, on)) return NO;
    return YES;
}
static BOOL DMSettingsForeground(id settings) {
    SEL sel = NSSelectorFromString(@"isForeground");
    return [settings respondsToSelector:sel] && ((BOOL (*)(id, SEL))objc_msgSend)(settings, sel);
}
static const void *kStageClosingKey;   // (defined below)
static UIView *DMStageForBundle(NSString *bundleID);
static BOOL DMKeepWindowedApp(id app, NSString *what) {   // is this app a window that must stay in the foreground? (app: a bundle id or an application)
    NSString *bundle = [app isKindOfClass:[NSString class]] ? app : ([app respondsToSelector:@selector(bundleIdentifier)] ? [app bundleIdentifier] : nil);
    UIView *stage = bundle.length ? DMStageForBundle(bundle) : nil;
    if (!stage || [objc_getAssociatedObject(stage, kStageClosingKey) boolValue] || !DMScreenOnAndUnlocked()) return NO;
    if (DMStageMinimized(stage)) return NO;   // (minimized: its app may go to the background, see DMSyncMinimizedScenes)
    if ([bundle isEqualToString:gFullFrameGuardBundle] && CACurrentMediaTime() < gFullFrameGuardUntil) return NO;
    if (DMTestFlag("/tmp/macstatusbar-debug")) {
        NSMutableString *trace = [NSMutableString string]; NSArray *st = [NSThread callStackSymbols];
        for (NSUInteger i = 1; i < st.count && i < 9; i++) [trace appendFormat:@"\n      %@", st[i]];
        DMLog([NSString stringWithFormat:@"[keepfg] %@ of %@ refused (window):%@", what, bundle, trace]);
    }
    return YES;
}
// A window's scene is kept in the foreground when SpringBoard sends it to the background (see below). During some turns of a full-screen
// app (M1, iOS 15: landscape -> upside down with Safari full screen and windows open) SpringBoard does not accept that answer and asks again
// ~125 times a second for 6-9 s; the turn waits for it and the screen stayed landscape. So when one scene is asked more than 10 times within a
// second, the request is let through (the app goes to the background for a moment, the turn completes) and once SpringBoard has been quiet
// for a second the window's app is brought back to the foreground by us. Kill switch for the veto itself: /tmp/msb-nokeepfg.
static NSMutableDictionary<NSString *, NSMutableArray *> *gKeepFgFlood;   // scene id -> [count, window start, last request, yielding]
static BOOL DMSetSceneForeground(id scene);
static BOOL DMKeepFgShouldYield(id scene, NSString *sid, NSString *bundle) {
    if (DMTestFlag("/tmp/msb-nokeepfg")) return YES;
    if (!sid.length) return NO;
    if (!gKeepFgFlood) gKeepFgFlood = [NSMutableDictionary dictionary];
    CFTimeInterval now = CACurrentMediaTime();
    NSMutableArray *e = gKeepFgFlood[sid];
    if (!e) { e = [NSMutableArray arrayWithObjects:@0, @(now), @(now), @NO, nil]; gKeepFgFlood[sid] = e; }
    BOOL yielding = [e[3] boolValue];
    if (yielding && now - [e[2] doubleValue] > 1.0) yielding = NO;   // (a new episode after a quiet second)
    if (now - [e[1] doubleValue] > 1.0) { e[0] = @0; e[1] = @(now); }
    e[0] = @([e[0] intValue] + 1); e[2] = @(now);
    if (!yielding && [e[0] intValue] > 10) {
        yielding = YES;
        DMLog([NSString stringWithFormat:@"[scene] %@: SpringBoard insists on the background (%d requests within a second): let through, the window comes back once it is quiet", bundle, [e[0] intValue]]);
    }
    e[3] = @(yielding);
    if (yielding) {
        __weak id weakScene = scene; NSString *sidCopy = [sid copy], *bundleCopy = [bundle copy];
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.05 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            NSMutableArray *e2 = gKeepFgFlood[sidCopy];
