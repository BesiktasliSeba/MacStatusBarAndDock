    else if ([cmd hasPrefix:@"mpdump_"]) {   // mpdump_<n>: ask MacPointer (in the sandboxed pointeruid, which cannot write files) for debug text n and pull it
        // over Darwin notification states, 512 bytes a page, into /tmp/macpointer.log. n: 1 = pointer classes, 2 = the live pointer view/layer tree.
        int n = [[cmd substringFromIndex:7] intValue];
        dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
            static int tCmd, tLen, tReq, tAck, tBuf[64]; static BOOL ready;
            if (!ready) { ready = YES; notify_register_check("com.besiktasliseba.macpointer.cmdarg", &tCmd); notify_register_check("com.besiktasliseba.macpointer.len", &tLen);
                notify_register_check("com.besiktasliseba.macpointer.pagereq", &tReq); notify_register_check("com.besiktasliseba.macpointer.pageack", &tAck);
                for (int i = 0; i < 64; i++) { char nm[64]; snprintf(nm, sizeof nm, "com.besiktasliseba.macpointer.buf.%d", i); notify_register_check(nm, &tBuf[i]); } }
            notify_set_state(tLen, 0); notify_set_state(tCmd, n); notify_post("com.besiktasliseba.macpointer.cmd");
            uint64_t len = 0; for (int w = 0; w < 100 && !len; w++) { usleep(20000); notify_get_state(tLen, &len); }
            NSMutableData *d = [NSMutableData data];
            for (uint64_t page = 0; page * 512 < len; page++) {
                notify_set_state(tAck, 0); notify_set_state(tReq, page); notify_post("com.besiktasliseba.macpointer.page");
                uint64_t ack = 0; for (int w = 0; w < 200 && ack != page + 1; w++) { usleep(2000); notify_get_state(tAck, &ack); }
                if (ack != page + 1) break;
                for (int i = 0; i < 64 && d.length < len; i++) { uint64_t v = 0; notify_get_state(tBuf[i], &v); [d appendBytes:&v length:MIN((NSUInteger)8, (NSUInteger)(len - d.length))]; }
            }
            [d writeToFile:@"/tmp/macpointer.log" atomically:NO];
            DMLog([NSString stringWithFormat:@"[debug] mpdump %d: %lu of %llu bytes -> /tmp/macpointer.log", n, (unsigned long)d.length, len]);
        });
    }
    else if ([cmd hasPrefix:@"banner_"]) DMBannerDebug([cmd substringFromIndex:7]);   // banner_close / banner_options / banner_hover: that hover button of the banner on screen (real handlers)
    else if ([cmd isEqualToString:@"idletimeout"]) {   // idletimeout: the Auto-Lock time SpringBoard's idle timer really uses (read-only; MacSettings' long Auto-Lock times)
        id coord = DMCall(objc_getClass("SBIdleTimerGlobalCoordinator"), @"sharedInstance");
        id mon = nil;
        for (Class c = [coord class]; c && !mon; c = class_getSuperclass(c)) { unsigned n = 0; Ivar *iv = class_copyIvarList(c, &n);
            for (unsigned i = 0; i < n; i++) { const char *t = ivar_getTypeEncoding(iv[i]); if (t && t[0] == '@') { id v = object_getIvar(coord, iv[i]); if ([v isKindOfClass:objc_getClass("SBIdleTimerGlobalStateMonitor")]) { mon = v; break; } } }
            free(iv); }
        id t = [mon respondsToSelector:@selector(autoLockTimeout)] ? ((id (*)(id, SEL))objc_msgSend)(mon, @selector(autoLockTimeout)) : nil;   // (an NSNumber of seconds)
        BOOL never = [mon respondsToSelector:NSSelectorFromString(@"dontLockEver")] ? ((BOOL (*)(id, SEL))objc_msgSend)(mon, NSSelectorFromString(@"dontLockEver")) : NO;
        DMLog([NSString stringWithFormat:@"[idle] coordinator %@ monitor %@: autoLockTimeout %@ s, dontLockEver %d", coord ? @"yes" : @"no", mon ? @"yes" : @"no", t, never]);
