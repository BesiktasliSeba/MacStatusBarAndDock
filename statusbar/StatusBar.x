    if (stage && DMStageMinimized(stage)) return settings;   // (a minimized window's app goes to the background like any app: its notifications show as banners)
    if (!DMSceneAlive(scene)) { DMLog([NSString stringWithFormat:@"[scene] %@: scene %@ is ending (invalid or its app is not running): not kept", windowed, DMShortSceneID(scene)]); return settings; }
    if (!DMSceneIsStageScene(scene, windowed)) { DMLog([NSString stringWithFormat:@"[scene] %@: scene %@ is not the window's scene, may go to the background", windowed, DMShortSceneID(scene)]); return settings; }
