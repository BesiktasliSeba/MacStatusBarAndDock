            if ([dev respondsToSelector:sel]) ((void (*)(id, SEL, long, BOOL))objc_msgSend)(dev, sel, o, YES);
            DMLog([NSString stringWithFormat:@"[devorient] UIDevice setOrientation %ld (responds %d), before %ld", o, [dev respondsToSelector:sel], before]);
        }
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
            DMLog([NSString stringWithFormat:@"[devorient] after: UIDevice %ld, screen %@, statusBarOrientation %ld, aerial window %@", (long)[UIDevice currentDevice].orientation,
                   NSStringFromCGSize([UIScreen mainScreen].bounds.size), ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation")), NSStringFromCGRect(DMAerialWindow().frame)]);
        });
    }
    else if ([cmd isEqualToString:@"awinorient"]) {   // awinorient: Aerial's window layer -- its UIKit rotation state (getters only)
        UIWindow *w = DMAerialWindow();
        if (!w) { DMLog(@"[awinorient] no Aerial window"); return; }
        NSMutableString *out = [NSMutableString stringWithFormat:@"[awinorient] frame %@ bounds %@ transform %@ root %@", NSStringFromCGRect(w.frame), NSStringFromCGRect(w.bounds), NSStringFromCGAffineTransform(w.transform), NSStringFromClass([w.rootViewController class])];
        for (NSString *g in @[@"interfaceOrientation", @"_windowInterfaceOrientation", @"_toWindowOrientation", @"_fromWindowOrientation", @"_orientationForRootTransform", @"_orientationForViewTransform"]) {
            SEL s = NSSelectorFromString(g); if ([w respondsToSelector:s]) [out appendFormat:@" %@=%ld", g, ((long (*)(id, SEL))objc_msgSend)(w, s)];
        }
