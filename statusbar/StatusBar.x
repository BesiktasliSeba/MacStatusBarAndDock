// "#RGB" or "#RRGGBB" (the # is optional); nil if it isn't a colour.
static UIColor *DMParseHexColor(NSString *text) {
    NSString *h = [[text stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]] uppercaseString];
    if ([h hasPrefix:@"#"]) h = [h substringFromIndex:1];
    if (h.length == 3) {
        NSMutableString *e = [NSMutableString string];
        for (NSUInteger i = 0; i < 3; i++) { unichar c = [h characterAtIndex:i]; [e appendFormat:@"%C%C", c, c]; }
        h = e;
    }
    if (h.length != 6) return nil;
    unsigned int v = 0;
    NSScanner *scanner = [NSScanner scannerWithString:h];
    if (![scanner scanHexInt:&v] || !scanner.isAtEnd) return nil;
    return [UIColor colorWithRed:((v >> 16) & 0xFF) / 255.0 green:((v >> 8) & 0xFF) / 255.0 blue:(v & 0xFF) / 255.0 alpha:1.0];
}


