    }
    else if ([cmd isEqualToString:@"appstates"]) {   // SpringBoard's process state of every windowed app
        for (UIView *s in DMAerialStages()) {
            NSString *bid = DMStageBundle(s);
            id app = ((id (*)(id, SEL, id))objc_msgSend)(DMCall(objc_getClass("SBApplicationController"), @"sharedInstance"), NSSelectorFromString(@"applicationWithBundleIdentifier:"), bid);
            id ps = [app respondsToSelector:NSSelectorFromString(@"processState")] ? DMCall(app, @"processState") : nil;
            DMLog([NSString stringWithFormat:@"[appstate] %@ %@ | %@", bid, ps, [app respondsToSelector:NSSelectorFromString(@"isRunning")] ? @"" : @""]);
        }
        DMLog([NSString stringWithFormat:@"[appstate] front app: %@", [DMFrontApp() bundleIdentifier]]);
    }
    else if ([cmd hasPrefix:@"orient_"]) {   // orient_p / orient_l / orient_r / orient_off: turn the whole interface (rotation-lock override), for testing
        NSString *which = [cmd substringFromIndex:7];
        id mgr = DMCall(objc_getClass("SBOrientationLockManager"), @"sharedInstance");
        long long o = [which isEqualToString:@"p"] ? 1 : ([which isEqualToString:@"r"] ? 3 : 4);
        if ([which isEqualToString:@"off"]) {
            SEL off = NSSelectorFromString(@"disableLockOverrideForReason:");
            DMLog([NSString stringWithFormat:@"[orient] release override: responds %d", [mgr respondsToSelector:off]]);
            if ([mgr respondsToSelector:off]) ((void (*)(id, SEL, id))objc_msgSend)(mgr, off, @"macstatusbar-test");
            else {   // iOS 15.6.1 has no -disableLockOverrideForReason:, only -setLockOverrideEnabled:forReason:
                SEL set = NSSelectorFromString(@"setLockOverrideEnabled:forReason:");
                DMLog([NSString stringWithFormat:@"[orient] release via setLockOverrideEnabled:NO: responds %d", [mgr respondsToSelector:set]]);
                if ([mgr respondsToSelector:set]) ((void (*)(id, SEL, BOOL, id))objc_msgSend)(mgr, set, NO, @"macstatusbar-test");
            }
        } else {
            SEL on = NSSelectorFromString(@"enableLockOverrideForReason:forceOrientation:");
            DMLog([NSString stringWithFormat:@"[orient] force %lld: responds %d", o, [mgr respondsToSelector:on]]);
            if ([mgr respondsToSelector:on]) ((void (*)(id, SEL, id, long long))objc_msgSend)(mgr, on, @"macstatusbar-test", o);
        }
    }
    else if ([cmd isEqualToString:@"orientstate"]) {   // read-only: what SBOrientationLockManager currently thinks (its own succinctDescription plus each individual query method) -- diagnostic only, calls nothing that changes state
        id mgr = DMCall(objc_getClass("SBOrientationLockManager"), @"sharedInstance");
        if (!mgr) { DMLog(@"[orientstate] no SBOrientationLockManager instance"); return; }
        SEL sels[] = { NSSelectorFromString(@"succinctDescription"), NSSelectorFromString(@"description") };
        for (int i = 0; i < 2; i++) if ([mgr respondsToSelector:sels[i]]) DMLog([NSString stringWithFormat:@"[orientstate] %@: %@", NSStringFromSelector(sels[i]), ((id (*)(id, SEL))objc_msgSend)(mgr, sels[i])]);
        NSArray<NSString *> *boolGetters = @[@"lockOverrideEnabled", @"isUserLocked", @"isEffectivelyLocked"];
        for (NSString *g in boolGetters) { SEL s = NSSelectorFromString(g); if ([mgr respondsToSelector:s]) DMLog([NSString stringWithFormat:@"[orientstate] %@ = %d", g, ((BOOL (*)(id, SEL))objc_msgSend)(mgr, s)]); }
        NSArray<NSString *> *intGetters = @[@"effectiveLockedOrientation", @"deviceOrientationAsFarAsAppsAreConcerned", @"userLockOrientation"];
        for (NSString *g in intGetters) { SEL s = NSSelectorFromString(g); if ([mgr respondsToSelector:s]) DMLog([NSString stringWithFormat:@"[orientstate] %@ = %lld", g, ((long long (*)(id, SEL))objc_msgSend)(mgr, s)]); }
        DMLog([NSString stringWithFormat:@"[orientstate] UIScreen bounds %@, statusBarOrientation %ld, DMRealInterfaceOrientation %ld",
               NSStringFromCGSize([UIScreen mainScreen].bounds.size), ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation")), DMRealInterfaceOrientation()]);
        {   // Keyboard Phase: the other readings of the interface orientation, to find one that is right after a respring in landscape
            long aio = [[UIApplication sharedApplication] respondsToSelector:NSSelectorFromString(@"activeInterfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"activeInterfaceOrientation")) : -1;
            NSMutableString *ws = [NSMutableString string];
            for (UIWindow *w in DMAllWindows()) { NSString *c = NSStringFromClass([w class]); if (([c isEqualToString:@"SBHomeScreenWindow"] || DMSBIsBarWindowName(c) || [c isEqualToString:@"SBFloatingDockWindow"]) && w.windowScene) [ws appendFormat:@" %@ scene %ld;", c, (long)w.windowScene.interfaceOrientation]; }
            DMLog([NSString stringWithFormat:@"[orientstate] activeInterfaceOrientation %ld, device %ld,%@", aio, (long)[UIDevice currentDevice].orientation, ws]);
        }
    }
    else if ([cmd hasPrefix:@"sysvol"]) {   // sysvol: read the system volumes; sysvol_<0..1>: set the media volume (tests keep it low); sysvolring_<0..1>: the ringer volume (debug)
        id avsc = DMCall(objc_getClass("AVSystemController"), @"sharedAVSystemController");
        SEL get = NSSelectorFromString(@"getActiveCategoryVolume:andName:"), set = NSSelectorFromString(@"setActiveCategoryVolumeTo:");
        (void)set;
        if ([cmd hasPrefix:@"sysvolring_"] && [avsc respondsToSelector:NSSelectorFromString(@"setVolumeTo:forCategory:")]) ((BOOL (*)(id, SEL, float, NSString *))objc_msgSend)(avsc, NSSelectorFromString(@"setVolumeTo:forCategory:"), [[cmd substringFromIndex:11] floatValue], @"Ringtone");
        SEL setCat = NSSelectorFromString(@"setVolumeTo:forCategory:"), getCat = NSSelectorFromString(@"getVolume:forCategory:");
        if ([cmd hasPrefix:@"sysvol_"] && [avsc respondsToSelector:setCat]) ((BOOL (*)(id, SEL, float, NSString *))objc_msgSend)(avsc, setCat, [[cmd substringFromIndex:7] floatValue], @"Audio/Video");
        float vol = -1, media = -1; NSString *name = nil;
