            while (stack.count) {
                UIView *v = stack.lastObject; [stack removeLastObject]; [stack addObjectsFromArray:v.subviews];
                NSString *cn = NSStringFromClass([v class]);
                if ([cn isEqualToString:@"SBFloatingDockPlatterView"] || [cn isEqualToString:@"SBFloatingDockView"])
                    DMLog([NSString stringWithFormat:@"[orientinfo] %@ frame in dock window %@ (hidden %d)", cn, NSStringFromCGRect([v.superview convertRect:v.frame toView:dw]), v.hidden]);
            }
