    else if ([cmd hasPrefix:@"engine_"]) {   // engine_<aerial|zetsu>: what picking it on our Settings > Window Engine page does with Choicy installed (tests; respring after)
        NSString *engine = [cmd substringFromIndex:7];
        NSDictionary *libs = @{@"aerial": @[@"Aerial"], @"milkyway": @[@"MilkyWay4", @"MilkyWay3SubModule"], @"zetsu": @[@"Zetsu"]};
        if (!libs[engine]) return;
        CFPreferencesSetValue(CFSTR("windowEngine"), (__bridge CFStringRef)engine, MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        CFPreferencesSynchronize(MSB_DOMAIN, kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
        NSMutableArray *keep = [libs[engine] mutableCopy], *deny = [NSMutableArray array];
        for (NSString *e in libs) if (![e isEqualToString:engine]) for (NSString *l in libs[e]) {
            NSString *base = [@"/var/jb/usr/lib/TweakInject" stringByAppendingPathComponent:l];
            if (access([base stringByAppendingString:@".dylib"].UTF8String, F_OK) == 0 || access([base stringByAppendingString:@".disabled"].UTF8String, F_OK) == 0) [deny addObject:l];
        }
        NSString *path = @"/var/jb/var/mobile/Library/Preferences/com.opa334.choicyprefs.plist";
        NSMutableDictionary *prefs = [[NSDictionary dictionaryWithContentsOfFile:path] mutableCopy] ?: [NSMutableDictionary new];
        NSMutableArray *global = [prefs[@"globalDeniedTweaks"] isKindOfClass:[NSArray class]] ? [prefs[@"globalDeniedTweaks"] mutableCopy] : [NSMutableArray new];
        for (NSString *n in deny) if (![global containsObject:n]) [global addObject:n];
        for (NSString *n in keep) [global removeObject:n];
        prefs[@"globalDeniedTweaks"] = global;
        NSMutableDictionary *apps = [prefs[@"appSettings"] isKindOfClass:[NSDictionary class]] ? [prefs[@"appSettings"] mutableCopy] : nil;
        NSMutableDictionary *sb = [apps[@"com.apple.springboard"] isKindOfClass:[NSDictionary class]] ? [apps[@"com.apple.springboard"] mutableCopy] : nil;
        if ([sb[@"customTweakConfigurationEnabled"] boolValue]) {
            NSInteger mode = sb[@"allowDenyMode"] ? [sb[@"allowDenyMode"] integerValue] : 1;
            NSString *listKey = mode == 2 ? @"deniedTweaks" : @"allowedTweaks";
            NSMutableArray *list = [sb[listKey] isKindOfClass:[NSArray class]] ? [sb[listKey] mutableCopy] : [NSMutableArray new];
            NSArray *add = mode == 2 ? ([sb[@"overwriteGlobalTweakConfiguration"] boolValue] ? deny : @[]) : keep, *rem = mode == 2 ? keep : deny;
            for (NSString *n in add) if (![list containsObject:n]) [list addObject:n];
            for (NSString *n in rem) [list removeObject:n];
            sb[listKey] = list; apps[@"com.apple.springboard"] = sb; prefs[@"appSettings"] = apps;
        }
        BOOL ok = [prefs writeToFile:path atomically:YES];
        notify_post("com.opa334.choicyprefs/ReloadPrefs");
        DMLog([NSString stringWithFormat:@"[debug] engine %@ picked: Choicy denies %@ (written %d); respring to switch", engine, [deny componentsJoinedByString:@","], ok]);
    }
    else if ([cmd hasPrefix:@"prefbool_"]) {   // prefbool_<domain>|<key>|<0|1>: write a boolean preference through cfprefsd the way a Settings switch does
        NSArray *q = [[cmd substringFromIndex:9] componentsSeparatedByString:@"|"];
        if (q.count == 3) {
            CFPreferencesSetValue((__bridge CFStringRef)q[1], [q[2] boolValue] ? kCFBooleanTrue : kCFBooleanFalse, (__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            CFPreferencesSynchronize((__bridge CFStringRef)q[0], kCFPreferencesCurrentUser, kCFPreferencesAnyHost);
            DMLog([NSString stringWithFormat:@"[debug] %@ %@ = %d", q[0], q[1], [q[2] boolValue]]);
        }
    }
    else if ([cmd hasPrefix:@"prefstr_"]) {   // prefstr_<domain>|<key>|<text>: write a string preference through cfprefsd the way a Settings picker does
