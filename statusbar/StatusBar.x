            }
        }
    }
    else if ([cmd hasPrefix:@"amangle"]) {   // amangle[_<dx>_<dy>]: shove every window aside (as a screen change might), then run Aerial's fit-to-screen on it
        NSArray *q = [cmd componentsSeparatedByString:@"_"];
        CGFloat dx = q.count > 2 ? [q[1] doubleValue] : 60.0, dy = q.count > 2 ? [q[2] doubleValue] : 40.0;
        for (UIView *s in DMAerialStages()) {
            gStageFrameBypass = YES; s.frame = CGRectOffset(s.frame, dx, dy); gStageFrameBypass = NO;
            DMLog([NSString stringWithFormat:@"[debug] %@ shoved to %@", DMStageBundle(s), NSStringFromCGRect(s.frame)]);
            SEL fit = DMAerialSel(@"_adjustStageToFitScreenIfNeeded");
            if ([s respondsToSelector:fit]) ((void (*)(id, SEL))objc_msgSend)(s, fit);
        }
    }
    else if ([cmd hasPrefix:@"switcher_"]) {   // switcher_<source>: toggle the App Switcher (like the Home gesture / Dock swipe)
