    if (wasLandscape != willLandscape) ((void (*)(id, SEL, CGRect))objc_msgSend)(copy, setFrame, CGRectMake(f.origin.x, f.origin.y, f.size.height, f.size.width));   // (landscape scenes hold their frame with width and height swapped)
    DMLog([NSString stringWithFormat:@"[scene] %@ is a window: orientation %ld -> %ld, frame %@ -> %@", windowed, so, want, NSStringFromCGRect(f), NSStringFromCGRect(((CGRect (*)(id, SEL))objc_msgSend)(copy, frameSel))]);
    return copy;
}
// Safety net (iPad 2, iOS 16, 2026-09-24): when an Aerial 5.0 window collapsed to nothing (its transform became all zeros), Aerial sized the app's scene
// to the collapsed window; SpringBoard's next restart then reconnected to the still-running app, tried to snapshot a scene of size ~0 and hit an
// assertion (-[XBApplicationSnapshot setReferenceSize:]) -- a crash loop into Safe Mode until the apps were killed. So an app scene never gets a
// frame smaller than 50 pt either way: the last sane frame it had is kept instead.
static int gSceneStackLogs = 0;
static int gSceneCreateLogs = 0;   // debug: log who creates the next n FrontBoard scenes (scenecreate_<n>)   // debug: log the caller of the next n scene updates
static int gSwitcherStackLogs = 0;   // debug: log the caller of the next n switcher transition events (swstack_<n>)
static NSMutableDictionary<NSString *, NSValue *> *gSaneSceneFrames;
static id DMSaneSceneSettings(id scene, id settings) {
    SEL frameSel = NSSelectorFromString(@"frame"), setFrameSel = NSSelectorFromString(@"setFrame:");
    if (![settings respondsToSelector:frameSel]) return settings;
    NSString *sid = nil; @try { sid = [scene valueForKey:@"identifier"]; } @catch (id e) {}
    if (![sid hasPrefix:@"sceneID:"]) return settings;
    CGRect f = ((CGRect (*)(id, SEL))objc_msgSend)(settings, frameSel);
    if (!gSaneSceneFrames) gSaneSceneFrames = [NSMutableDictionary dictionary];
    if (f.size.width >= 50.0 && f.size.height >= 50.0 && isfinite(f.size.width) && isfinite(f.size.height)) { gSaneSceneFrames[sid] = [NSValue valueWithCGRect:f]; return settings; }
    NSValue *good = gSaneSceneFrames[sid];
