    else if ([cmd isEqualToString:@"trailtree"]) {   // trailtree: the status icons' container in every status bar copy: its shift and each icon view (class, frame, hidden, alpha), read-only
        for (UIView *fg in gCopies.allObjects) {
            UIView *trailing = objc_getAssociatedObject(fg, kTrailShiftKey);
            if (!trailing || !fg.window || fg.window.hidden) continue;
            NSMutableString *t = [NSMutableString stringWithFormat:@"[trailtree] fg %p width %.0f | trailing %@ frame %@ tx %.1f", fg, fg.bounds.size.width, NSStringFromClass([trailing class]), NSStringFromCGRect(trailing.frame), trailing.transform.tx];
            NSMutableArray *pending = [NSMutableArray arrayWithObject:@[trailing, @0]];
            while (pending.count) {
                NSArray *e = pending.lastObject; [pending removeLastObject];
                UIView *v = e[0]; int d = [e[1] intValue];
                if (v != trailing) [t appendFormat:@"\n  %*s%@ %@ in fg %@ hidden %d alpha %.2f", d * 2, "", NSStringFromClass([v class]), NSStringFromCGRect(v.frame), NSStringFromCGRect([v.superview convertRect:v.frame toView:fg]), v.hidden, v.alpha];
                if (d < 3) for (UIView *c in v.subviews.reverseObjectEnumerator) [pending addObject:@[c, @(d + 1)]];
            }
