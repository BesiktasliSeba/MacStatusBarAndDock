    DMLog([NSString stringWithFormat:@"[scene] %@ is a window: kept in the foreground (%@, scene %@)%@", windowed, path, DMShortSceneID(scene), trace]);
    return copy;
}
// The on-screen keyboard is drawn by the app for ITS interface orientation, so a window's app scene must agree with what the keyboard host is set up for.
//  - iPadOS 16: a window's scene is "portrait" (orientation 1, the frame in landscape dimensions) when Aerial opens it fresh; the keyboard picture is then upright
//    and laid out for a portrait screen, which the keyboard fix knows how to place. An app that was full screen in landscape before it became a window keeps
//    the landscape orientation (3 or 4, frame dimensions swapped): its keyboard picture is laid out for the landscape screen and turned inside its canvas, and
//    it came up sideways or not at all. So on iPadOS 16 a window's scene is always kept at orientation 1.
//  - iPadOS 15: Aerial turns the keyboard host by the scene's orientation (portrait canvas, turned for landscape). That is right while the scene and the
//    screen agree, but a window's scene keeps the orientation it was opened in when the iPad is turned, so its keyboard picture no longer fits (it zoomed
//    out of bounds or disappeared). So on iPadOS 15 a window's scene is put back in line with the screen (portrait or landscape) whenever they differ.
static long DMWantedSceneOrientation(long current) {
    if ([NSProcessInfo processInfo].operatingSystemVersion.majorVersion >= 16) return 1;
    CGSize screen = [UIScreen mainScreen].bounds.size;
    BOOL screenLandscape = screen.width > screen.height, sceneLandscape = current == 3 || current == 4;
    if (current != 1 && !sceneLandscape) return current;   // (an unknown value is left alone)
    if (screenLandscape == sceneLandscape) return current;
    if (!screenLandscape) return 1;
    long o = ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"));
    if (o != 3 && o != 4) { long l = DMLandscapeSide(); o = l ? l : gLastConfidentLandscapeOrientation; }   // (see DMLandscapeSide)
    return o;
}
long DMWantedSceneOrientationFor(long current) { return DMWantedSceneOrientation(current); }   // (for DMZetsuAdopt, above)
static id DMPortraitWindowSettings(id scene, id settings) {
    SEL orientationSel = NSSelectorFromString(@"interfaceOrientation"), setOrientation = NSSelectorFromString(@"setInterfaceOrientation:"), frameSel = NSSelectorFromString(@"frame"), setFrame = NSSelectorFromString(@"setFrame:");
    if (![settings respondsToSelector:orientationSel] || ![settings respondsToSelector:frameSel]) return settings;
    long so = ((long (*)(id, SEL))objc_msgSend)(settings, orientationSel);
    long want = DMWantedSceneOrientation(so);
    if (want == so) return settings;
    NSString *sid = nil; @try { sid = [scene valueForKey:@"identifier"]; } @catch (id e) {}
    if (![sid hasPrefix:@"sceneID:"]) return settings;
    NSString *windowed = nil;
    for (UIView *st in DMAerialStages()) { NSString *b = DMStageBundle(st); if (b.length && [sid containsString:b]) { windowed = b; break; } }
    if (!windowed || ([windowed isEqualToString:gFullFrameGuardBundle] && CACurrentMediaTime() < gFullFrameGuardUntil)) return settings;
    UIView *stage = DMStageForBundle(windowed);
    if (!stage || [objc_getAssociatedObject(stage, kStageClosingKey) boolValue]) return settings;
    id copy = [settings mutableCopy];
    if (![copy respondsToSelector:setOrientation] || ![copy respondsToSelector:setFrame]) return settings;
    CGRect f = ((CGRect (*)(id, SEL))objc_msgSend)(settings, frameSel);
    {   // (a frame that is the whole canvas belongs to a full-screen app or to a reset, not to the window: not touched)
        CGSize sc = [UIScreen mainScreen].bounds.size; CGFloat lo = MIN(sc.width, sc.height), hi = MAX(sc.width, sc.height);
        BOOL canvas = fabs(f.origin.x) < 0.5 && fabs(f.origin.y) < 0.5 && ((fabs(f.size.width - lo) < 0.5 && fabs(f.size.height - hi) < 0.5) || (fabs(f.size.width - hi) < 0.5 && fabs(f.size.height - lo) < 0.5));
