// may come back as before. (The locked-screen case above holds every Zetsu window back; this is the unlocked, general rule.)
static id DMHoldBackUnwantedForeground(id scene, id settings, id context) {
    if (context || ![settings respondsToSelector:NSSelectorFromString(@"isForeground")] || !DMSettingsForeground(settings)) return settings;
    id current = nil; @try { current = [scene valueForKey:@"settings"]; } @catch (id e) {}
    if (!current || DMSettingsForeground(current)) return settings;   // (only a scene SpringBoard has already put in the background)
    NSString *sid = nil; @try { sid = [scene valueForKey:@"identifier"]; } @catch (id e) {}
    if (![sid hasPrefix:@"sceneID:"]) return settings;
    NSString *windowed = nil;
