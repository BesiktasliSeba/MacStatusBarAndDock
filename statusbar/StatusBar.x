            SEL s = NSSelectorFromString(@"sb_updateInterfaceOrientationFromActiveInterfaceOrientation");
            if ([w respondsToSelector:s]) ((void (*)(id, SEL))objc_msgSend)(w, s);
            DMLog([NSString stringWithFormat:@"[awinrot] sb_update... responds %d -> frame %@", [w respondsToSelector:s], NSStringFromCGRect(w.frame)]);
        } else if ([arg hasPrefix:@"r"]) {   // awinrot_r<o>: _setRotatableViewOrientation:o updateStatusBar:NO duration:0.3 force:YES (does not ask -autorotates)
