        id app = [UIApplication sharedApplication];
        if (o >= 1 && o <= 4 && [app respondsToSelector:s]) ((void (*)(id, SEL, long, double, BOOL, BOOL, id))objc_msgSend)(app, s, o, 0.3, YES, NO, @"macstatusbar-test");
        DMLog([NSString stringWithFormat:@"[sbnote] %ld responds %d -> aerial window %@", o, [app respondsToSelector:s], NSStringFromCGRect(DMAerialWindow().frame)]);
    }
    else if ([cmd hasPrefix:@"awinrot"]) {   // awinrot_sb: SpringBoard's own "follow the active interface orientation" on Aerial's window; awinrot_<o>: UIKit _updateToInterfaceOrientation:o duration:0.3 force:YES
        UIWindow *w = DMAerialWindow();
