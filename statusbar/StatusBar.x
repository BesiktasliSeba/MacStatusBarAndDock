    }
    else if ([cmd isEqualToString:@"orientinfo"]) {   // where everything is now
        CGSize s = [UIScreen mainScreen].bounds.size;
        DMLog([NSString stringWithFormat:@"[orientinfo] screen bounds %@, statusBarOrientation %ld, aerial window %@, menu window %@", NSStringFromCGSize(s), ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation")), NSStringFromCGRect(DMAerialWindow().frame), NSStringFromCGRect(gMenuWindow.frame)]);
        DMLog([NSString stringWithFormat:@"[orientinfo] usable area %@", NSStringFromCGRect(DMUsableArea())]);
        if (gMenuWindow) {
            id<UICoordinateSpace> scr = [UIScreen mainScreen].coordinateSpace;
            DMLog([NSString stringWithFormat:@"[orientinfo] menu window transform %@, origin -> screen %@, (100,0) -> screen %@, interfaceOrientation %ld", NSStringFromCGAffineTransform(gMenuWindow.transform),
                   NSStringFromCGPoint([gMenuWindow convertPoint:CGPointZero toCoordinateSpace:scr]), NSStringFromCGPoint([gMenuWindow convertPoint:CGPointMake(100, 0) toCoordinateSpace:scr]),
                   [gMenuWindow respondsToSelector:NSSelectorFromString(@"interfaceOrientation")] ? ((long (*)(id, SEL))objc_msgSend)(gMenuWindow, NSSelectorFromString(@"interfaceOrientation")) : -1L]);
        }
