        uintptr_t a = (uintptr_t)strtoull([[cmd substringFromIndex:5] UTF8String], NULL, 16);
        if (a) DMLog([NSString stringWithFormat:@"[refs] 0x%lx is referenced from:%@", (unsigned long)a, DMRefsTo(a)]);
