                    DMLog([NSString stringWithFormat:@"[orient3] attempt %lu: screen %@ statusBarOrientation %ld", (unsigned long)i, NSStringFromCGSize([UIScreen mainScreen].bounds.size), ((long (*)(id, SEL))objc_msgSend)([UIApplication sharedApplication], NSSelectorFromString(@"statusBarOrientation"))]);
                });
            });
        }
    }
    else if ([cmd hasPrefix:@"kbtf_"]) {   // kbtf_<a>_<d>_<tx>_<ty>: set Aerial's keyboard host transform by hand (touch /tmp/msb-kbfix-off first, or the fixer puts its own back) -- experiment
        NSArray *q = [[cmd substringFromIndex:5] componentsSeparatedByString:@"_"];
        if (q.count < 4) return;
        for (UIWindow *w in DMAllWindows()) {
            if (![NSStringFromClass([w class]) isEqualToString:@"AerialKeyboardWindow"]) continue;
            for (UIView *h in w.subviews) if ([NSStringFromClass([h class]) isEqualToString:@"_UIKeyboardLayerHostView"]) {
