                   [sc isKindOfClass:[UIWindowScene class]] ? [NSString stringWithFormat:@"%p %@", ((UIWindowScene *)sc).screen, NSStringFromCGRect(((UIWindowScene *)sc).screen.bounds)] : @"-"]);
        for (UIView *fg in gCopies.allObjects) {
            UIView *container = DMLeadingContainer(fg); UIView *timeL = container ? DMFirstStringView(container) : nil;
            DMLog([NSString stringWithFormat:@"[extinfo] copy %p in %@ (hidden %d) external %@ alpha %.2f clock suppressed %d time alpha %.2f text %@", fg, NSStringFromClass([fg.window class]), fg.window.hidden,
                   DMExternalScreenOf(fg) ? NSStringFromCGRect(DMExternalScreenOf(fg).bounds) : @"no", DMEffectiveAlpha(fg), [objc_getAssociatedObject(fg, kClockSuppressedKey) boolValue], timeL.alpha,
                   [timeL respondsToSelector:@selector(text)] ? [(id)timeL text] : @"-"]);
        }
        for (UIWindow *w in gExtMenuWindows) DMLog([NSString stringWithFormat:@"[extinfo] external menu window %p %@ hidden %d scene %p overlay here %d", w, NSStringFromCGRect(w.bounds), w.hidden, w.windowScene, gOverlay.window == w]);
        Class ccc = objc_getClass("SBControlCenterController");
        unsigned n = 0; Method *ms = ccc ? class_copyMethodList(ccc, &n) : NULL;
        NSMutableString *sels = [NSMutableString string];
        for (unsigned i = 0; i < n; i++) { NSString *nm = NSStringFromSelector(method_getName(ms[i])); if ([nm rangeOfString:@"cene" options:0].location != NSNotFound || [nm rangeOfString:@"isplay"].location != NSNotFound || [nm hasPrefix:@"present"] || [nm hasPrefix:@"_present"]) [sels appendFormat:@" %@", nm]; }
        if (ms) free(ms);
